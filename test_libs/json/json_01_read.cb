// GUARDS: JSON object and array reads, iteration, dump, and parse acceptance
// FROM: scratch/probe3/j01_index_key.cb scratch/probe3/j02_at_contains.cb scratch/probe3/j04_push_back.cb scratch/probe3/j05_index_int.cb scratch/probe3/j06_get_string.cb scratch/probe3/j07_dump_indent.cb scratch/probe3/j08_iterate.cb scratch/probe3/j10_parse_error.cb
import cpp "nlohmann/json.hpp";
extern int main()
{
    int failures = 0;
    nlohmann.json object = nlohmann.json.parse("{{\"a\":5,\"s\":\"hi\"}}");
    int a = object["a"].get<int>();
    bool has = object.contains("a");
    int at = object.at("a").get<int>();
    std.string s = object["s"].get<std.string>();
    if (a != 5) { printf("FAIL j01: got %d want 5\n", a); failures |= 1; }
    if (!has || at != 5) { printf("FAIL j02: got %d want 5\n", at); failures |= 2; }
    if (s.size() != 2) { printf("FAIL j06: got %d want 2\n", (int)s.size()); failures |= 4; }

    nlohmann.json array = nlohmann.json.array();
    array.push_back(1); array.push_back(2);
    if (array.size() != 2 || !array.is_array()) { printf("FAIL j04: got %d want 2\n", (int)array.size()); failures |= 8; }
    nlohmann.json parsed = nlohmann.json.parse("[10,20,30]");
    int indexed = parsed[1].get<int>();
    if (indexed != 20) { printf("FAIL j05: got %d want 20\n", indexed); failures |= 16; }
    nlohmann.json dump_value = nlohmann.json.parse("[1]");
    std.string dump = dump_value.dump(2);
    if (dump.size() <= 3) { printf("FAIL j07: got %d want >3\n", (int)dump.size()); failures |= 32; }
    nlohmann.json iterable = nlohmann.json.parse("[1,2,3]");
    int sum = 0;
    for (nlohmann.json.iterator it = iterable.begin(); it != iterable.end(); it++) sum = sum + (*it).get<int>();
    if (sum != 6) { printf("FAIL j08: got %d want 6\n", sum); failures |= 64; }
    bool accepted = nlohmann.json.accept("[1,");
    if (accepted) { printf("FAIL j10: got 1 want 0\n"); failures |= 128; }
    if (failures == 0) printf("PASS json_01_read\n");
    return failures;
}
