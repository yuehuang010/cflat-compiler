// GUARDS: C++11 map/multimap/set/multiset: ctor forms, bounds, insert/erase forms, comparisons, node handles
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "functional";
import cpp "map";
import cpp "set";
import cpp "utility";
extern int main()
{
    int failures = 0;
    // map ctor forms, lookup
    std.map<int, int> m = default;
    m.emplace(1, 10); m.emplace(2, 20); m.emplace(3, 30);
    std.map<int, int> m2 = std.map<int, int>(m);
    std.map<int, int> m3 = std.map<int, int>(m.begin(), m.end());
    auto f2 = m.find(2);
    auto f9 = m.find(9);
    if (m.size() != 3 || m2 != m || m3.size() != 3 || m.at(2) != 20 || m[3] != 30 || m.count(4) != 0 || f2->second != 20 || f9 != m.end()) { printf("FAIL map_basic\n"); failures |= 1; }
    auto ins = m.insert(std.pair<int, int>(4, 40));
    auto dup = m.insert(std.pair<int, int>(4, 41));
    m.emplace(5, 50);
    m.try_emplace(5, 99);
    m.insert_or_assign(6, 60);
    m.insert_or_assign(6, 61);
    if (!ins.second || dup.second || m[4] != 40 || m[5] != 50 || m[6] != 61 || m.size() != 6) { printf("FAIL map_insert\n"); failures |= 2; }
    // bounds
    auto lb = m.lower_bound(3);
    auto ub = m.upper_bound(3);
    auto er = m.equal_range(3);
    auto lb7 = m.lower_bound(7);
    if (lb->first != 3 || ub->first != 4 || er.first != lb || er.second != ub || lb7 != m.end()) { printf("FAIL map_bounds\n"); failures |= 4; }
    // hint insert, erase forms
    auto hint = m.insert(m.end(), std.pair<int, int>(7, 70));
    bool er_ok = hint->first == 7 && m.size() == 7;
    i64 n = m.erase(7);
    er_ok = er_ok && n == 1 && m.erase(100) == 0;
    m.erase(m.find(6));
    m.erase(m.lower_bound(4), m.end());
    auto mrb = m.rbegin();
    auto mb = m.begin();
    er_ok = er_ok && m.size() == 3 && mrb->first == 3 && mb->first == 1;
    if (!er_ok) { printf("FAIL map_erase\n"); failures |= 8; }
    // comparisons, key_comp / value_comp
    std.map<int, int> lo = default; lo.emplace(1, 1);
    std.map<int, int> hi = default; hi.emplace(1, 2);
    if (!(lo < hi) || lo == hi) { printf("FAIL map_compare\n"); failures |= 16; }
    // custom comparator
    std.map<int, int, std.greater<int>> gm = default;
    gm.emplace(1, 1); gm.emplace(2, 2); gm.emplace(3, 3);
    auto gb = gm.begin(); auto grb = gm.rbegin();
    if (gb->first != 3 || grb->first != 1) { printf("FAIL map_greater\n"); failures |= 32; }
    // multimap
    std.multimap<int, int> mm = default;
    mm.emplace(1, 4); mm.emplace(1, 5); mm.emplace(2, 6); mm.emplace(1, 7);
    auto mr = mm.equal_range(1);
    int msum = 0;
    for (auto it = mr.first; it != mr.second; it++) msum += it->second;
    i64 mmc = mm.count(1); i64 mms = mm.size();
    i64 mme = mm.erase(1);
    auto mf2 = mm.find(2);
    if (mmc != 3 || msum != 16 || mms != 4 || mme != 3 || mm.size() != 1 || mf2->second != 6) { printf("FAIL multimap\n"); failures |= 64; }
    // set
    std.set<int> s = default;
    s.insert(5); s.insert(1); s.insert(3);
    auto sins = s.insert(3);
    s.insert(7); s.insert(9);
    std.set<int> s2 = std.set<int>(s.begin(), s.end());
    auto sb = s.begin(); auto srb = s.rbegin(); auto slb = s.lower_bound(4); auto sub = s.upper_bound(5); auto sf = s.find(2);
    if (sins.second || s.size() != 5 || *sb != 1 || *srb != 9 || s2 != s || s.count(3) != 1 || *slb != 5 || *sub != 7 || sf != s.end()) { printf("FAIL set\n"); failures |= 128; }
    s.erase(3);
    s.erase(s.begin());
    auto sh = s.insert(s.end(), 11);
    if (s.size() != 4 || *sh != 11) { printf("FAIL set_erase_hint\n"); failures |= 256; }
    // multiset
    std.multiset<int> ms = default;
    ms.insert(2); ms.insert(2); ms.insert(3); ms.insert(2);
    auto msr = ms.equal_range(2);
    int dist = 0;
    for (auto it = msr.first; it != msr.second; it++) dist++;
    ms.erase(ms.find(2));
    i64 mscnt = ms.count(2); i64 mssz = ms.size();
    i64 mser = ms.erase(2);
    if (dist != 3 || mscnt != 2 || mssz != 3 || mser != 2 || ms.size() != 1) { printf("FAIL multiset\n"); failures |= 512; }
    // node handles
    std.map<int, int> nm = default;
    nm.emplace(1, 10); nm.emplace(2, 20); nm.emplace(3, 30);
    auto nh = nm.extract(2);
    bool nh_ok = !nh.empty() && nh.key() == 2 && nh.mapped() == 20 && nm.size() == 2;
    nh.key() = 22;
    nm.insert(move(nh));
    nh_ok = nh_ok && nm.size() == 3 && nm.count(22) == 1 && nm.count(2) == 0 && nm[22] == 20;
    std.map<int, int> src = default;
    src.emplace(50, 5); src.emplace(1, 99);
    nm.merge(src);
    nh_ok = nh_ok && nm.count(50) == 1 && src.size() == 1 && src.count(1) == 1;
    std.multimap<int, int> nmm = default;
    nmm.emplace(1, 1); nmm.emplace(1, 2);
    auto nh2 = nmm.extract(nmm.begin());
    nh_ok = nh_ok && nh2.key() == 1 && nmm.size() == 1;
    std.set<int> ns = default;
    ns.insert(1); ns.insert(2); ns.insert(3);
    auto nh3 = ns.extract(2);
    nh_ok = nh_ok && nh3.value() == 2 && ns.size() == 2 && !ns.contains(2);
    if (!nh_ok) { printf("FAIL node_handles\n"); failures |= 1024; }
    if (failures == 0) printf("PASS std_full_11_associative_containers\n");
    return failures;
}
