// GUARDS: bitset non-const operator[] returns the reference proxy (assign, flip, proxy-to-proxy, ~)
// FROM: internal/plan/std-library-tier2-suite.md (std_full_11_bitset, moved out for Windows MSVC 2026-10-02)
import cpp {"string", "bitset", "functional"};
extern int main()
{
    int failures = 0;
    std.bitset<8> d = default;
    d[2] = true; d[4] = true; d[2].flip(); d[6] = d[4];
    bool bit2 = d[2]; bool bit4 = d[4]; bool bit6 = d[6];
    bool inv = ~d[0];
    if (bit2 || !bit4 || !bit6 || !inv || d.count() != 2 || d.to_ullong() != 80) { printf("FAIL proxy\n"); failures |= 16; }
    if (failures == 0) printf("PASS std_full_11_941_bitset_proxy\n");
    return failures;
}
