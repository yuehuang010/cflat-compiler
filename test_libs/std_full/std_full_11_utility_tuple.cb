// GUARDS: pair piecewise_construct, integer comparison, in_place tags, tuple helpers and comparison
// FROM: internal/plan/std-library-tier2-suite.md
import cpp {"string", "utility", "tuple", "optional", "variant", "any", "compare", "limits"};
extern int main()
{
    int failures = 0;
    std.pair<std.string, int> pw = std.make_pair(std.string("abc"), 7);
    std.pair<int, int> p1 = std.make_pair(1, 2); std.pair<int, int> p2 = std.make_pair(1, 3);
    if (pw.first != "abc" || pw.second != 7 || !(p1 < p2) || p1 == p2 || std.get<0>(p1) != 1 || std.get<1>(p2) != 3)
    { printf("FAIL pair\n"); failures |= 1; }
    u32 one = 1; u32 three = 3; u32 big = std.numeric_limits<u32>.max();
    if (!std.cmp_less(-1, one) || std.cmp_less(one, -1) || !std.cmp_equal(3, three) || std.cmp_equal(-1, big) || !std.cmp_greater(three, -5)
        || !std.cmp_less_equal(1, 1) || !std.cmp_not_equal(1, 2) || !std.cmp_greater_equal(2, 1))
    { printf("FAIL cmp\n"); failures |= 2; }
    u32 huge = 4000000000;
    if (!std.in_range<u8>(200) || std.in_range<u8>(300) || std.in_range<u8>(-1) || !std.in_range<int>(three) || std.in_range<int>(huge))
    { printf("FAIL in_range\n"); failures |= 4; }
    std.optional<std.string> o = std.make_optional(std.string("xxx"));
    std.variant<int, std.string> v = std.string("idx");
    std.variant<int, std.string> v2 = 9;
    std.any an = std.any(std.string("any"));
    if (!o.has_value() || o.value() != "xxx" || v.index() != 1 || std.get<1>(v) != "idx" || v2.index() != 0 || std.get<0>(v2) != 9 || std.any_cast<std.string>(an) != "any")
    { printf("FAIL optional variant any\n"); failures |= 8; }
    int a = 1; int b = 2;
    auto ft = std.forward_as_tuple(a, b);
    std.get<0>(ft) = 10;
    auto cat = std.tuple_cat(std.make_tuple(1, 2.5), std.make_tuple(std.string("s")));
    if (a != 10 || std.tuple_size<std.tuple<int, double, std.string>>.value != 3 || std.get<0>(cat) != 1 || std.get<1>(cat) != 2.5 || std.get<2>(cat) != "s")
    { printf("FAIL forward_as_tuple tuple_cat\n"); failures |= 16; }
    auto made = std.make_from_tuple<std.pair<int, int>>(std.make_tuple(5, 6));
    if (made.first != 5 || made.second != 6) { printf("FAIL make_from_tuple\n"); failures |= 32; }
    bool types = std.is_same_v<std.tuple_element_t<1, std.tuple<int, double, std.string>>, double> && std.tuple_size_v<std.tuple<int, int>> == 2 && std.is_same_v<std.tuple_element_t<2, std.tuple<int, double, std.string>>, std.string>;
    if (!types) { printf("FAIL tuple traits\n"); failures |= 64; }
    std.tuple<int, int> t1 = std.make_tuple(1, 2); std.tuple<int, int> t2 = std.make_tuple(1, 3); std.tuple<int, int> t3 = std.make_tuple(1, 2);
    if (!(t1 < t2) || t1 == t2 || t1 != t3 || !(t1 == t3) || !(t2 > t1))
    { printf("FAIL tuple compare\n"); failures |= 128; }
    int x = 0; int y = 0; std.string s = default;
    int z = 0;
    std.tie(x, z, s) = std.make_tuple(4, 5, std.string("tie"));
    std.tie(y, z) = std.make_tuple(6, 7);
    if (x != 4 || s != "tie" || y != 6) { printf("FAIL tie\n"); failures |= 256; }
    int moved = std.exchange(a, 99);
    int cref = std.as_const(a);
    if (moved != 10 || a != 99 || cref != 99) { printf("FAIL exchange\n"); failures |= 512; }
    if (failures == 0) printf("PASS std_full_11_utility_tuple\n");
    return failures;
}
