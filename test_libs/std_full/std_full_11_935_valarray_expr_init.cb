// GUARDS: declaration initializer from a valarray expression-template result
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "valarray";
extern int main()
{
    int failures = 0;
    int[4] arr = { 4, 1, 3, 2 };
    std.valarray<int> w = std.valarray<int>(&arr[0], 4);
    int two = 2;
    std.valarray<int> x = w * two;
    if (x[0] != 8 || x[3] != 4) { printf("FAIL valarray expr init\n"); failures |= 1; }
    if (failures == 0) printf("PASS std_full_11_935_valarray_expr_init\n");
    return failures;
}
