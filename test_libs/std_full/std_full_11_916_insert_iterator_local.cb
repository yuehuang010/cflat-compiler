// GUARDS: a local std::insert_iterator advances across repeated *ii = v assignments
// FROM: internal/plan/std-library-tier2-suite.md
import cpp {"iterator", "vector"};
extern int main()
{
    int failures = 0;
    std.vector<int> ins = std.vector<int>({1, 4});
    auto ii = std.inserter(ins, ins.begin() + 1);
    *ii = 2; *ii = 3;
    if (ins.size() != 4 || ins[0] != 1 || ins[1] != 2 || ins[2] != 3 || ins[3] != 4) { printf("FAIL insert_iterator_local\n"); failures |= 1; }
    if (failures == 0) printf("PASS std_full_11_916_insert_iterator_local\n");
    return failures;
}
