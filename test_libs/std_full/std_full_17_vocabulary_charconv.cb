// GUARDS: optional/variant/any vocabulary types and floating-point/integer charconv
// FROM: internal/plan/std-library-tier2-suite.md
import cpp {"any", "charconv", "functional", "optional", "string", "string_view", "system_error", "utility", "variant"};
int plus2(int x, int y) { return x + y; }
extern int main()
{
    int failures = 0;
    std.errc inv = std.errc.invalid_argument;
    std.optional<int> a = std.make_optional(5);
    std.optional<int> b = default;
    std.optional<int> c = std.optional<int>();
    if (!a.has_value() || b.has_value() || a.value() != 5 || !(b < a) || !(a > c) || a != std.make_optional(5) || !(c == b) || a.value_or(9) != 5 || b.value_or(9) != 9) { printf("FAIL optional_compare\n"); failures |= 1; }
    b = 8;
    a.swap(b);
    std.swap(a, c);
    if (b.value() != 5 || c.value() != 8 || a.has_value()) { printf("FAIL optional_swap\n"); failures |= 2; }
    b.emplace(77);
    if (b.value() != 77) { printf("FAIL optional_emplace\n"); failures |= 4; }
    std.variant<std.monostate, int, double> v = default;
    if (v.index() != 0 || !std.holds_alternative<std.monostate>(v) || std.variant_size<std.variant<std.monostate, int, double>>.value != 3) { printf("FAIL variant_monostate\n"); failures |= 8; }
    v.emplace<int>(4);
    bool ok = v.index() == 1 && std.get<int>(v) == 4 && std.get_if<double>(&v) == nullptr;
    v = 2.5;
    ok = ok && v.index() == 2 && std.get<double>(v) == 2.5;
    v.emplace<1>(9);
    ok = ok && std.get<1>(v) == 9;
    if (!ok) { printf("FAIL variant_emplace\n"); failures |= 16; }
    std.variant<int> v1 = std.variant<int>(3);
    std.variant<int> v2 = std.variant<int>(4);
    std.function<int(int, int)> sum = std.function<int(int, int)>(plus2);
    int s1 = std.visit(sum, v1, v2);
    int s2 = std.visit(sum, v1, v1);
    if (s1 != 7 || s2 != 6) { printf("FAIL variant_visit2\n"); failures |= 32; }
    std.any an = std.make_any<int>(41);
    bool any_ok = an.has_value() && std.any_cast<int>(an) == 41;
    an.reset();
    any_ok = any_ok && !an.has_value();
    an = std.string("hi");
    any_ok = any_ok && std.any_cast<std.string>(an) == "hi" && std.any_cast<int>(&an) == nullptr;
    if (!any_ok) { printf("FAIL any\n"); failures |= 64; }
    char[64] buf = {};
    char* base = &buf[0];
    char* lim = &buf[63];
    auto r1 = std.to_chars(base, lim, 1.5);
    std.string s_short = std.string(base, r1.ptr);
    auto r2 = std.to_chars(base, lim, 2.25, std.chars_format.fixed, 3);
    std.string s_fixed = std.string(base, r2.ptr);
    auto r3 = std.to_chars(base, lim, 0.5f);
    std.string s_float = std.string(base, r3.ptr);
    if (r1.ec != std.errc() || s_short != "1.5" || s_fixed != "2.250" || s_float != "0.5") { printf("FAIL to_chars_float\n"); failures |= 128; }
    double dv = 0.0;
    std.string num = std.string("3.75xyz");
    char* nb = num.data();
    char* nb_end = nb + num.size();
    auto fr = std.from_chars(nb, nb_end, dv);
    float fv = 0.0f;
    std.string num2 = std.string("-0.5");
    char* n2 = num2.data();
    char* n2_end = n2 + num2.size();
    auto fr2 = std.from_chars(n2, n2_end, fv);
    int iv = 0;
    std.string bad = std.string("xyz");
    char* bp = bad.data();
    char* bp_end = bp + bad.size();
    auto fr3 = std.from_chars(bp, bp_end, iv);
    int hv = 0;
    std.string hex = std.string("ff");
    char* hp = hex.data();
    char* hp_end = hp + hex.size();
    auto fr4 = std.from_chars(hp, hp_end, hv, 16);
    char* stop = fr.ptr;
    if (fr.ec != std.errc() || dv != 3.75 || *stop != 'x' || fr2.ec != std.errc() || fv != -0.5f || fr3.ec != inv || fr4.ec != std.errc() || hv != 255) { printf("FAIL from_chars\n"); failures |= 256; }
    if (failures == 0) printf("PASS std_full_17_vocabulary_charconv\n");
    return failures;
}
