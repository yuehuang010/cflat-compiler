// GUARDS: new_handler round trip, launder, interference sizes, bad_alloc, explicit initializer_list object
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "new";
import cpp "initializer_list";
import cpp "algorithm";
int handler_calls = 0;
void my_handler() { handler_calls++; }
extern int main()
{
    int failures = 0;
    function<void()> old = std.set_new_handler(my_handler);
    function<void()> cur = std.get_new_handler();
    cur();
    std.set_new_handler(old);
    function<void()> restored = std.get_new_handler();
    if (handler_calls != 1 || restored != nullptr) { printf("FAIL new_handler\n"); failures |= 1; }
    int value = 77;
    int* laundered = std.launder(&value);
    if (laundered != &value || *laundered != 77) { printf("FAIL launder\n"); failures |= 2; }
    if (std.hardware_destructive_interference_size < 32 || std.hardware_constructive_interference_size < 16) { printf("FAIL interference size\n"); failures |= 4; }
    std.bad_alloc ba = default; std.bad_array_new_length bl = default;
    if (ba.what() == nullptr || bl.what() == nullptr) { printf("FAIL bad_alloc what\n"); failures |= 8; }
    std.initializer_list<int> il = std.initializer_list<int>({3, 9, 4});
    int sum = 0;
    for (int* it = il.begin(); it != il.end(); it++) sum += *it;
    int* first = std.begin(il);
    if (il.size() != 3 || sum != 16 || *first != 3 || std.end(il) - std.begin(il) != 3 || std.max(il) != 9 || std.min(il) != 3)
    { printf("FAIL initializer_list\n"); failures |= 16; }
    if (failures == 0) printf("PASS std_full_11_new_initializer_list\n");
    return failures;
}
