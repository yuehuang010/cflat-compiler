// GUARDS: valarray scalar operators with a bare integer literal operand (w + 100, w * 3)
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "valarray";
extern int main()
{
    int failures = 0;
    int[4] arr = { 4, 1, 3, 2 };
    std.valarray<int> w = std.valarray<int>(&arr[0], 4);
    std.valarray<int> x = default;
    x = w + 100;
    std.valarray<int> y = default;
    y = w * 3;
    if (x[0] != 104 || x[1] != 101 || x[3] != 102 || y[0] != 12 || y[1] != 3 || y[2] != 9) { printf("FAIL valarray literal scalar\n"); failures |= 1; }
    if (failures == 0) printf("PASS std_full_11_936_valarray_literal_scalar\n");
    return failures;
}
