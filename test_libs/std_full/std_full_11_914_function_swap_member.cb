// GUARDS: std::function::swap member
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "functional";
int twice(int x) { return x * 2; }
int thrice(int x) { return x * 3; }
extern int main()
{
    int failures = 0;
    std.function<int(int)> f1 = twice; std.function<int(int)> f2 = thrice;
    f1.swap(f2);
    if (f1(4) != 12 || f2(4) != 8) { printf("FAIL function::swap\n"); failures |= 1; }
    if (failures == 0) printf("PASS std_full_11_914_function_swap_member\n");
    return failures;
}
