// GUARDS: iterator minus iterator on std::vector and std::deque iterators
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "deque";
import cpp "vector";
extern int main()
{
    int failures = 0;
    std.vector<int> v = std.vector<int>({1, 2, 3});
    auto vb = v.begin(); auto ve = v.end();
    i64 d = ve - vb;
    if (d != 3) { printf("FAIL vector_iterator_difference\n"); failures |= 1; }
    std.deque<int> q = std.deque<int>({1, 2, 3, 4});
    auto qb = q.begin(); auto qe = q.end();
    i64 dq = qe - qb;
    if (dq != 4) { printf("FAIL deque_iterator_difference\n"); failures |= 2; }
    if (failures == 0) printf("PASS std_full_11_918_iterator_difference\n");
    return failures;
}
