// GUARDS: member typedefs of C++ classes named in type position and as template arguments
// FROM: internal/plan/std-library-tier2-suite.md
// DISABLED: internal/issue/p3/cpp-member-typedef-not-nameable.md
import cpp {"iterator", "type_traits", "vector"};
extern int main()
{
    int failures = 0;
    std.vector<int>.value_type x = 5;
    if (x != 5) { printf("FAIL vector_value_type\n"); failures |= 1; }
    bool tr = std.is_same<std.vector<int>.value_type, int>.value;
    if (!tr) { printf("FAIL is_same_value_type\n"); failures |= 2; }
    bool it = std.is_same<std.iterator_traits<std.vector<int>.iterator>.iterator_category, std.random_access_iterator_tag>.value;
    if (!it) { printf("FAIL iterator_traits_category\n"); failures |= 4; }
    if (failures == 0) printf("PASS std_full_11_921_member_typedef\n");
    return failures;
}
