// GUARDS: type_traits categories, properties, operations, relationships, transformations, constants; ratio arithmetic
// FROM: internal/plan/std-library-tier2-suite.md
import cpp {"string", "type_traits", "ratio", "memory", "stdexcept", "vector", "array", "functional", "cstddef"};
extern int main()
{
    int failures = 0;
    bool cat1 = std.is_integral<int>.value && !std.is_integral<double>.value && std.is_floating_point<double>.value && std.is_pointer<int*>.value && !std.is_pointer<int>.value;
    bool cat2 = std.is_enum<std.byte>.value && std.is_class<std.string>.value && !std.is_class<int>.value && std.is_void<void>.value;
    bool cat3 = std.is_arithmetic<float>.value && std.is_fundamental<int>.value;
    bool cat4 = std.is_scalar<std.byte>.value && std.is_compound<std.string>.value && std.is_object<int>.value && std.is_null_pointer<std.nullptr_t>.value && !std.is_function<int>.value;
    if (!cat1 || !cat2 || !cat3 || !cat4) { printf("FAIL categories\n"); failures |= 1; }
    bool pr1 = std.is_trivially_copyable<std.array<int, 3>>.value && std.is_standard_layout<std.array<int, 3>>.value && !std.is_trivially_copyable<std.string>.value;
    bool pr2 = std.is_signed<int>.value && !std.is_signed<u32>.value && std.is_unsigned<u8>.value;
    bool pr3 = std.is_empty<std.true_type>.value && !std.is_empty<std.string>.value && !std.is_final<std.string>.value && std.is_aggregate<std.array<int, 3>>.value;
    bool pr4 = !std.is_abstract<std.string>.value && !std.is_polymorphic<std.string>.value && std.is_polymorphic<std.exception>.value && std.has_virtual_destructor<std.exception>.value;
    if (!pr1 || !pr2 || !pr3 || !pr4) { printf("FAIL properties\n"); failures |= 2; }
    bool op1 = std.is_constructible<std.string, char*>.value && !std.is_constructible<std.string, std.vector<int>>.value && std.is_nothrow_move_constructible<std.string>.value;
    bool op2 = !std.is_copy_constructible<std.unique_ptr<int>>.value && std.is_move_constructible<std.unique_ptr<int>>.value && !std.is_copy_assignable<std.unique_ptr<int>>.value && std.is_move_assignable<std.unique_ptr<int>>.value;
    bool op3 = std.is_default_constructible<std.string>.value && std.is_destructible<std.string>.value && std.is_trivially_destructible<std.array<int, 3>>.value && !std.is_trivially_destructible<std.string>.value;
    bool op4 = std.is_swappable<int>.value && std.is_nothrow_destructible<std.string>.value;
    if (!op1 || !op2 || !op3 || !op4) { printf("FAIL operations\n"); failures |= 4; }
    bool rel1 = std.is_same<int, int>.value && !std.is_same<int, i64>.value && std.is_base_of<std.exception, std.runtime_error>.value && !std.is_base_of<std.runtime_error, std.exception>.value;
    bool rel2 = std.is_convertible<int, double>.value && !std.is_convertible<std.string, int>.value && std.is_convertible<std.runtime_error*, std.exception*>.value && !std.is_convertible<std.exception*, std.runtime_error*>.value;
    bool rel3 = std.is_invocable<std.function<int(int)>, int>.value && !std.is_invocable<std.function<int(int)>, std.string>.value;
    bool rel4 = std.is_same<std.invoke_result_t<std.function<double(int)>, int>, double>.value;
    if (!rel1 || !rel2 || !rel3 || !rel4) { printf("FAIL relationships\n"); failures |= 8; }
    bool tr1 = std.is_same<std.make_unsigned_t<int>, u32>.value;
    bool tr2 = std.is_same<std.make_signed_t<u8>, i8>.value && std.is_same<std.common_type_t<int, double>, double>.value && std.is_same<std.underlying_type_t<std.byte>, u8>.value;
    bool tr3 = std.is_same<std.remove_pointer_t<int*>, int>.value && std.is_same<std.add_pointer_t<int>, int*>.value;
    bool tr5 = std.is_same<std.conditional_t<true, int, i64>, int>.value && std.is_same<std.conditional_t<false, int, i64>, i64>.value && std.is_same<std.enable_if_t<true, i16>, i16>.value;
    if (!tr1 || !tr2 || !tr3 || !tr5) { printf("FAIL transformations\n"); failures |= 16; }
    bool k1 = std.integral_constant<int, 3>.value == 3 && std.bool_constant<true>.value && std.true_type.value && !std.false_type.value;
    bool k2 = !std.is_constant_evaluated() && std.alignment_of<double>.value >= 4;
    bool k3 = std.negation<std.false_type>.value && std.conjunction<std.true_type, std.true_type>.value && !std.disjunction<std.false_type, std.false_type>.value;
    if (!k1 || !k2 || !k3) { printf("FAIL constants\n"); failures |= 32; }
    bool ra1 = std.ratio<1, 3>.num == 1 && std.ratio<1, 3>.den == 3 && std.ratio_add<std.ratio<1, 3>, std.ratio<1, 6>>.num == 1 && std.ratio_add<std.ratio<1, 3>, std.ratio<1, 6>>.den == 2;
    bool ra2 = std.ratio_multiply<std.ratio<2, 3>, std.ratio<3, 4>>.num == 1 && std.ratio_multiply<std.ratio<2, 3>, std.ratio<3, 4>>.den == 2 && std.ratio_subtract<std.ratio<1, 3>, std.ratio<1, 6>>.den == 6;
    bool ra3 = std.ratio_divide<std.ratio<1, 3>, std.ratio<1, 6>>.num == 2 && std.ratio_divide<std.ratio<1, 3>, std.ratio<1, 6>>.den == 1 && std.ratio<4, 6>.num == 2 && std.ratio<4, 6>.den == 3 && std.ratio<-1, 2>.num == -1;
    if (!ra1 || !ra2 || !ra3) { printf("FAIL ratio arithmetic\n"); failures |= 64; }
    bool rc1 = std.ratio_less<std.ratio<1, 6>, std.ratio<1, 3>>.value && !std.ratio_less<std.ratio<1, 3>, std.ratio<1, 6>>.value && std.ratio_equal<std.ratio<2, 4>, std.ratio<1, 2>>.value && std.ratio_greater<std.ratio<1, 3>, std.ratio<1, 6>>.value;
    bool rc2 = std.ratio_less_equal<std.ratio<1, 3>, std.ratio<1, 3>>.value && std.ratio_not_equal<std.ratio<1, 3>, std.ratio<1, 6>>.value && std.ratio_greater_equal<std.ratio<1, 3>, std.ratio<1, 3>>.value;
    if (!rc1 || !rc2) { printf("FAIL ratio comparison\n"); failures |= 128; }
    bool si = std.milli.den == 1000 && std.milli.num == 1 && std.kilo.num == 1000 && std.kilo.den == 1 && std.micro.den == 1000000 && std.mega.num == 1000000 && std.centi.den == 100 && std.deca.num == 10;
    if (!si) { printf("FAIL SI typedefs\n"); failures |= 256; }
    if (failures == 0) printf("PASS std_full_11_type_traits_ratio\n");
    return failures;
}
