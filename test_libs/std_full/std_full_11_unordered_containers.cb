// GUARDS: C++11 unordered_map/set/multimap/multiset: lookup, insert/erase, bucket and load-factor relations, node handles
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "unordered_map";
import cpp "unordered_set";
import cpp "utility";
extern int main()
{
    int failures = 0;
    std.unordered_map<int, int> um = default;
    um.emplace(1, 10); um.emplace(2, 20); um.emplace(3, 30);
    auto f2 = um.find(2);
    auto f9 = um.find(9);
    if (um.size() != 3 || um.at(1) != 10 || um[3] != 30 || um.count(2) != 1 || um.count(9) != 0 || f2->second != 20 || f9 != um.end() || !um.contains(1) || um.contains(5)) { printf("FAIL umap_lookup\n"); failures |= 1; }
    auto ins = um.insert(std.pair<int, int>(4, 40));
    auto dup = um.insert(std.pair<int, int>(4, 41));
    um.emplace(5, 50);
    um.try_emplace(5, 99);
    um.insert_or_assign(6, 60);
    um.insert_or_assign(6, 61);
    if (!ins.second || dup.second || um[4] != 40 || um[5] != 50 || um[6] != 61 || um.size() != 6) { printf("FAIL umap_insert\n"); failures |= 2; }
    auto er = um.equal_range(3);
    int span = 0;
    for (auto it = er.first; it != er.second; it++) span++;
    auto erf = er.first;
    if (span != 1 || erf->first != 3) { printf("FAIL umap_equal_range\n"); failures |= 4; }
    i64 n = um.erase(6);
    if (n != 1 || um.erase(100) != 0 || um.size() != 5) { printf("FAIL umap_erase\n"); failures |= 8; }
    // buckets / load factor relations
    um.reserve(100);
    bool b_ok = um.bucket_count() >= 100 && um.load_factor() > 0.0f && um.load_factor() <= um.max_load_factor() && um.bucket_count() > 0;
    i64 bk = um.bucket(3);
    b_ok = b_ok && bk < um.bucket_count() && um.bucket_size(bk) >= 1 && um.max_load_factor() > 0.0f;
    um.rehash(200);
    b_ok = b_ok && um.bucket_count() >= 200 && um.size() == 5 && um.at(3) == 30;
    um.max_load_factor(0.5f);
    b_ok = b_ok && um.max_load_factor() == 0.5f;
    if (!b_ok) { printf("FAIL umap_buckets\n"); failures |= 16; }
    // node handles / merge
    auto nh = um.extract(2);
    bool nh_ok = !nh.empty() && nh.key() == 2 && nh.mapped() == 20 && um.size() == 4;
    nh.key() = 22;
    um.insert(move(nh));
    nh_ok = nh_ok && um.count(22) == 1 && um.count(2) == 0 && um.size() == 5;
    std.unordered_map<int, int> src = default;
    src.emplace(70, 7); src.emplace(1, 99);
    um.merge(src);
    nh_ok = nh_ok && um.count(70) == 1 && src.size() == 1 && src.count(1) == 1 && um[1] == 10;
    if (!nh_ok) { printf("FAIL umap_nodes\n"); failures |= 32; }
    // unordered_set
    std.unordered_set<int> us = default;
    us.insert(3); us.insert(5); us.insert(7);
    auto uins = us.insert(5);
    us.insert(9);
    auto uf = us.find(7);
    int usum = 0;
    for (auto it = us.begin(); it != us.end(); it++) usum += *it;
    if (uins.second || us.size() != 4 || us.count(3) != 1 || us.count(4) != 0 || *uf != 7 || usum != 24 || !us.contains(9) || us.erase(3) != 1 || us.size() != 3) { printf("FAIL uset\n"); failures |= 64; }
    us.reserve(64);
    if (us.bucket_count() < 64 || us.load_factor() > us.max_load_factor() || us.empty()) { printf("FAIL uset_buckets\n"); failures |= 128; }
    // multi variants
    std.unordered_multimap<int, int> umm = default;
    umm.emplace(1, 4); umm.emplace(1, 5); umm.emplace(2, 6); umm.emplace(1, 7);
    auto mr = umm.equal_range(1);
    int msum = 0; int mcount = 0;
    for (auto it = mr.first; it != mr.second; it++) { msum += it->second; mcount++; }
    if (umm.count(1) != 3 || msum != 16 || mcount != 3 || umm.size() != 4 || umm.erase(1) != 3 || umm.size() != 1) { printf("FAIL umultimap\n"); failures |= 256; }
    std.unordered_multiset<int> ums = default;
    ums.insert(2); ums.insert(2); ums.insert(3); ums.insert(2);
    if (ums.count(2) != 3 || ums.size() != 4 || ums.erase(2) != 3 || ums.size() != 1 || ums.count(3) != 1) { printf("FAIL umultiset\n"); failures |= 512; }
    // comparisons
    std.unordered_map<int, int> ea = default; ea.emplace(1, 1); ea.emplace(2, 2);
    std.unordered_map<int, int> eb = default; eb.emplace(2, 2); eb.emplace(1, 1);
    std.unordered_map<int, int> ec = default; ec.emplace(1, 1);
    std.unordered_set<int> sa = default; sa.insert(1); sa.insert(2);
    std.unordered_set<int> sb = default; sb.insert(2); sb.insert(1);
    if (!(ea == eb) || ea == ec || !(ea != ec) || !(sa == sb)) { printf("FAIL unordered_compare\n"); failures |= 1024; }
    if (failures == 0) printf("PASS std_full_11_unordered_containers\n");
    return failures;
}
