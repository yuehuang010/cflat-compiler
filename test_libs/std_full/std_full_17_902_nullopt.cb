// GUARDS: std::nullopt in construction, comparison and assignment
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "optional";
extern int main()
{
    int failures = 0;
    std.optional<int> a = std.make_optional(5);
    std.optional<int> b = default;
    std.optional<int> c = std.optional<int>(std.nullopt);
    if (b != std.nullopt || a == std.nullopt || !(c == std.nullopt)) { printf("FAIL nullopt_compare\n"); failures |= 1; }
    a = std.nullopt;
    if (a.has_value()) { printf("FAIL nullopt_assign\n"); failures |= 2; }
    if (failures == 0) printf("PASS std_full_17_902_nullopt\n");
    return failures;
}
