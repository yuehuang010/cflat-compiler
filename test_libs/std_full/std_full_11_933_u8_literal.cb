// GUARDS: u8"..." literal as a char8_t const pointer into std::u8string
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "string";
extern int main()
{
    int failures = 0;
    std.u8string b = std.u8string(u8"xyz");
    if (b.size() != 3) { printf("FAIL u8 literal ctor\n"); failures |= 1; }
    if (failures == 0) printf("PASS std_full_11_933_u8_literal\n");
    return failures;
}
