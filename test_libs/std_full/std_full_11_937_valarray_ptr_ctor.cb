// GUARDS: valarray(const T* p, size_t n) copy constructor chosen over the (const T&, n) fill overload
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "valarray";
extern int main()
{
    int failures = 0;
    int[4] arr = { 4, 1, 3, 2 };
    int* p = &arr[0];
    std.valarray<int> w = std.valarray<int>(p, 4);
    if (w[0] != 4 || w[1] != 1 || w[2] != 3 || w[3] != 2) { printf("FAIL valarray ptr ctor\n"); failures |= 1; }
    if (failures == 0) printf("PASS std_full_11_937_valarray_ptr_ctor\n");
    return failures;
}
