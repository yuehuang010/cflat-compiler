// GUARDS: div/ldiv/lldiv/imaxdiv return their anonymous-typedef C structs (div_t etc.)
// FROM: internal/plan/std-library-tier2-suite.md
import cpp "cstdlib";
import cpp "cinttypes";
extern int main()
{
    int failures = 0;
    auto d = std.div(17, 5);
    if (d.quot != 3 || d.rem != 2) { printf("FAIL div\n"); failures |= 1; }
    auto l = std.ldiv(-17, 5);
    if (l.quot != -3 || l.rem != -2) { printf("FAIL ldiv\n"); failures |= 2; }
    auto ll = std.lldiv(100, 7);
    if (ll.quot != 14 || ll.rem != 2) { printf("FAIL lldiv\n"); failures |= 4; }
    auto m = std.imaxdiv(17, 5);
    if (m.quot != 3 || m.rem != 2) { printf("FAIL imaxdiv\n"); failures |= 8; }
    if (failures == 0) printf("PASS std_full_11_910_div_struct_return\n");
    return failures;
}
