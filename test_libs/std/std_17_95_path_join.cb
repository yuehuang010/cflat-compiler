// GUARDS: filesystem path slash join
// FROM: internal/plan/std-library-smoke-suite.md (C++17 coverage map)
import cpp "filesystem";
extern int main()
{
    std.filesystem.path base = std.filesystem.path("dir");
    std.filesystem.path child = base / "file.txt";
    std.string name = child.filename().string();
    if (name != "file.txt") { printf("FAIL path_join\n"); return 1; }
    printf("PASS std_17_95_path_join\n");
    return 0;
}
