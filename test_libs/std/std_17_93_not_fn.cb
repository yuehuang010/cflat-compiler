// GUARDS: std::not_fn wraps a callable and negates its result
// FROM: internal/plan/std-library-smoke-suite.md (C++17 coverage map)
import cpp "functional";
bool is_zero(int x) { return x == 0; }
extern int main()
{
    std.function<bool(int)> zeroFn = std.function<bool(int)>(is_zero);
    auto pred = std.not_fn(zeroFn);
    if (!pred(1) || pred(0)) { printf("FAIL not_fn\n"); return 1; }
    printf("PASS std_17_93_not_fn\n");
    return 0;
}
