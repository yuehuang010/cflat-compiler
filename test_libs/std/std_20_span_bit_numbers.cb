// GUARDS: C++20 span, array, bit operations, midpoint/lerp, ssize, and to_array APIs cross the CFlat boundary
// FROM: internal/plan/std-library-smoke-suite.md (C++20 coverage map)
import cpp "span";
import cpp "vector";
import cpp "bit";
import cpp "cmath";
import cpp "cstdint";
import cpp "numeric";
import cpp "array";
extern int main()
{
    int failures = 0;
    std.vector<int> values = default;
    values.push_back(3); values.push_back(5); values.push_back(7);
    std.span<int> from_vector = std.span<int>(values);
    if (from_vector[1] != 5 || from_vector.subspan(1).size() != 2 || from_vector.first(1)[0] != 3 || from_vector.last(1)[0] != 7) { printf("FAIL span vector\n"); failures |= 1; }
    int[3] fixed = default;
    fixed[0] = 2; fixed[1] = 4; fixed[2] = 6;
    std.span<int> from_array = std.span<int>(&fixed[0], 3);
    if (from_array[2] != 6) { printf("FAIL span fixed array\n"); failures |= 2; }
    if (std.popcount((unsigned int)0x15) != 3 || !std.has_single_bit((unsigned int)8) || std.bit_width((unsigned int)9) != 4 || std.rotl((unsigned int)1, 1) != 2) { printf("FAIL bit operations\n"); failures |= 4; }
    if (std.bit_cast<unsigned int>(1.5f) != 1069547520) { printf("FAIL bit_cast\n"); failures |= 32; }
    if (std.midpoint(2, 8) != 5 || std.lerp(2.0, 6.0, 0.5) != 4.0) { printf("FAIL numbers/numeric\n"); failures |= 8; }
    std.array<char, 4> copied = std.to_array("abc");
    if (copied[2] != 'c' || std.ssize(values) != 3) { printf("FAIL to_array/ssize\n"); failures |= 16; }
    if (failures == 0) printf("PASS std_20_span_bit_numbers\n");
    return failures;
}
