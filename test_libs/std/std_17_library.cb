// GUARDS: C++17 node APIs, call utilities, numeric algorithms, accessors, locks, and sampling
// FROM: internal/plan/std-library-smoke-suite.md (C++17 coverage map)
import cpp {"algorithm", "functional", "map", "mutex", "numeric", "random", "shared_mutex", "tuple", "utility", "vector"};
int twice(int x) { return x * 2; }
int add_values(int x, int y) { return x + y; }
int double_value(int x) { return x * 2; }
int read_const(int value) { return value; }
bool is_zero(int x) { return x == 0; }
extern int main()
{
    int failures = 0;
    std.map<int, int> a = default, b = default;
    a.try_emplace(1, 10); a.insert_or_assign(2, 20);
    auto node = a.extract(1); b.insert(move(node)); b.merge(a);
    auto tup = std.make_tuple(3, 4);
    std.function<int(int, int)> addFn = std.function<int(int, int)>(add_values);
    int applied = std.apply(addFn, tup);
    std.function<int(int)> twiceFn = std.function<int(int)>(twice);
    int invoked = std.invoke(twiceFn, 6);
    int clamped = std.clamp(17, 1, 9);
    int gcdv = std.gcd(42, 30), lcmv = std.lcm(6, 8);
    std.vector<int> values = default;
    values.push_back(1); values.push_back(2); values.push_back(3); values.push_back(4);
    int red = std.reduce(values.begin(), values.end());
    std.function<int(int)> doubleFn = std.function<int(int)>(double_value);
    int tr = std.transform_reduce(values.begin(), values.end(), 0, std.plus<int>(), doubleFn);
    std.vector<int> inc = default, exc = default;
    inc.resize(4); exc.resize(4);
    std.inclusive_scan(values.begin(), values.end(), inc.begin());
    std.exclusive_scan(values.begin(), values.end(), exc.begin(), 0);
    i64 sz = std.size(values); bool empty = std.empty(values);
    auto data_ptr = std.data(values);
    int first = *data_ptr;
    std.mutex m1 = default, m2 = default;
    int lock_state = 0;
    { std.scoped_lock<std.mutex, std.mutex> guard = std.scoped_lock<std.mutex, std.mutex>(m1, m2); lock_state = 1; }
    std.shared_mutex sm = default;
    { std.shared_lock<std.shared_mutex> guard = std.shared_lock<std.shared_mutex>(sm); lock_state = 2; }
    int parsed = 1234;
    int const_value = read_const(std.as_const(parsed));
    std.mt19937 rng = std.mt19937(123);
    std.vector<int> sample = default;
    std.sample(values.begin(), values.end(), std.back_inserter(sample), 2, rng);
    if (b.size() != 2 || b.at(1) != 10 || b.at(2) != 20) { printf("FAIL node_api\n"); failures |= 1; }
    if (applied != 7 || invoked != 12) { printf("FAIL apply_invoke\n"); failures |= 2; }
    if (clamped != 9 || gcdv != 6 || lcmv != 24) { printf("FAIL clamp_gcd_lcm\n"); failures |= 4; }
    if (red != 10 || tr != 20 || inc[3] != 10 || exc[3] != 6) { printf("FAIL numeric_algorithms\n"); failures |= 8; }
    if (sz != 4 || empty || first != 1) { printf("FAIL free_accessors\n"); failures |= 16; }
    if (lock_state != 2) { printf("FAIL locks\n"); failures |= 32; }
    if (const_value != 1234) { printf("FAIL as_const\n"); failures |= 64; }
    if (sample.size() != 2) { printf("FAIL sample size: got %lld want 2\n", sample.size()); failures |= 128; }
    if (failures == 0) printf("PASS std_17_library\n");
    return failures;
}
