// GUARDS: C++20 std::format and chrono calendar, weekday, and time-of-day APIs
// FROM: internal/plan/std-library-smoke-suite.md (C++20 coverage map)
import cpp "format";
import cpp "string";
import cpp "chrono";
extern int main()
{
    int failures = 0;
    std.string formatted = std.format("{{}} {{:4d}} {{:.2f}} {{:>8}}", 7, 12, 1.25, "x");
    if (formatted != "7   12 1.25        x") { printf("FAIL format result: %s\n", formatted.c_str()); failures |= 1; }
    std.chrono.year_month_day date = std.chrono.year_month_day(std.chrono.year(2024), std.chrono.month(2), std.chrono.day(28));
    std.chrono.sys_days after_days = std.chrono.sys_days(date) + std.chrono.days(2);
    std.chrono.year_month_day after = std.chrono.year_month_day(after_days);
    std.chrono.weekday weekday = std.chrono.weekday(std.chrono.sys_days(std.chrono.year_month_day(std.chrono.year(2024), std.chrono.month(1), std.chrono.day(1))));
    std.chrono.hh_mm_ss<std.chrono.seconds> time = std.chrono.hh_mm_ss<std.chrono.seconds>(std.chrono.seconds(7384));
    if (after.day() != std.chrono.day(1) || after.month() != std.chrono.month(3) || weekday.c_encoding() != 1 || time.hours().count() != 2 || time.minutes().count() != 3 || time.seconds().count() != 4) { printf("FAIL chrono fields\n"); failures |= 4; }
    if (failures == 0) printf("PASS std_20_format_chrono\n");
    return failures;
}
