// GUARDS: C++11 algorithms, numeric algorithms, and callable wrappers
// FROM: internal/plan/std-library-smoke-suite.md (C++11 coverage map)
import cpp "algorithm";
import cpp "functional";
import cpp "numeric";
import cpp "vector";
int twice(int x) { return x * 2; }
int plus_three(int x) { return x + 3; }
int plus_one(int x) { return x + 1; }
bool is_three(int x) { return x == 3; }
bool over_two(int x) { return x > 2; }
bool is_even(int x) { return x % 2 == 0; }
bool is_positive(int x) { return x > 0; }
bool is_four(int x) { return x == 4; }
extern int main()
{
    int failures = 0;
    std.vector<int> v = std.vector<int>({4, 1, 3, 2}); std.sort(v.begin(), v.end());
    std.function<bool(int)> pred = std.function<bool(int)>(is_three);
    std.function<bool(int)> count_pred = std.function<bool(int)>(over_two);
    std.function<bool(int)> even_pred = std.function<bool(int)>(is_even);
    auto found = std.find_if(v.begin(), v.end(), pred);
    int found_value = *found;
    int exact = *std.find(v.begin(), v.end(), 2);
    int count = (int)std.count_if(v.begin(), v.end(), count_pred);
    std.vector<int> out = std.vector<int>();
    std.copy_if(v.begin(), v.end(), std.back_inserter(out), even_pred);
    std.transform(v.begin(), v.end(), v.begin(), std.function<int(int)>(plus_one));
    if (found_value != 3 || exact != 2 || count != 2 || out.size() != 2 || out[0] != 2 || out[1] != 4 || v[0] != 2 || !std.is_sorted(v.begin(), v.end()) || std.accumulate(v.begin(), v.end(), 0) != 14 || std.inner_product(v.begin(), v.end(), v.begin(), 0) != 54)
    { printf("FAIL algorithms\n"); failures |= 1; }
    std.vector<int> seq = std.vector<int>({4, 1, 3, 2, 3});
    std.stable_sort(seq.begin(), seq.end());
    int lower = *std.lower_bound(seq.begin(), seq.end(), 3);
    auto mm = std.minmax_element(seq.begin(), seq.end());
    int minv = *mm.first; int maxv = *mm.second;
    std.reverse(seq.begin(), seq.end()); std.rotate(seq.begin(), seq.begin() + 1, seq.end());
    auto unique_end = std.unique(seq.begin(), seq.end());
    std.vector<int> numbers = std.vector<int>({1, 2, 3});
    std.iota(numbers.begin(), numbers.end(), 1);
    if (!std.all_of(numbers.begin(), numbers.end(), std.function<bool(int)>(is_positive)) || !std.any_of(numbers.begin(), numbers.end(), std.function<bool(int)>(is_three)) || !std.none_of(numbers.begin(), numbers.end(), std.function<bool(int)>(is_four)) || lower != 3 || minv != 1 || maxv != 4 || unique_end == seq.begin() || numbers[2] != 3)
    { printf("FAIL algorithm predicates/bounds\n"); failures |= 4; }
    std.function<int(int)> from_free = std.function<int(int)>(twice);
    int referenced = 6; auto wrapped = std.ref(referenced);
    if (from_free(5) != 10 || !std.less<int>()(1, 2) || !std.greater<int>()(2, 1) || wrapped.get() != 6)
    { printf("FAIL functional\n"); failures |= 2; }
    if (failures == 0) printf("PASS std_11_algorithms_functional\n");
    return failures;
}
