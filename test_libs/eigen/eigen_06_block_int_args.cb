// GUARDS: overload choice among member-template instantiations called with int literals
// FROM: scratch/probe3/e10_block.cb
import cpp "Eigen/Dense";
extern int main()
{
    Eigen.Matrix3d m = default; m.setIdentity();
    double s = m.block(0, 0, 2, 2).sum();
    if (s != 2.0) { printf("FAIL block: got %f want 2\n", s); return 1; }
    printf("PASS eigen_06_block_int_args\n");
    return 0;
}
