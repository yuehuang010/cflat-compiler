// GUARDS: torch::data TensorDataset size and Example<Tensor, NoTarget> field access.
// FROM: scratch/ladder/torch/t13.cb
import cpp "torch/torch.h";
extern int printf(const char* fmt, ...);
int leg_t13()
{
    int failures = 0;
    i64[2] d = {4, 2};
    c10.IntArrayRef s = c10.IntArrayRef(&d[0], 2);
    at.Tensor x = torch.randn(s);
    torch.data.datasets.TensorDataset ds = torch.data.datasets.TensorDataset(x);
    i64 n = (i64)ds.size().value();
    torch.data.TensorExample ex = ds.get(1);
    printf("n=%lld ex0=%lld\n", n, ex.data.size(0));
    if (n != 4) { printf("FAIL t13 n: got %lld want 4\n", n); failures++; }
    if (ex.data.size(0) != 2) { printf("FAIL t13 ex0: got %lld want 2\n", ex.data.size(0)); failures++; }
    return failures;
}
extern int main()
{
    int failures = leg_t13();
    if (failures == 0) printf("PASS torch_91_data_example\n");
    return failures;
}
