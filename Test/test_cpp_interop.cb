    std.mutex ctorrefMx = default;
    if (!ctorrefMx.try_lock())                                              return 1962;
    ctorrefMx.unlock();
    bool ctorrefInside = false;
    {
        std.lock_guard<std.mutex> ctorrefG = std.lock_guard<std.mutex>(ctorrefMx);
        ctorrefInside = ctorrefMx.try_lock();
    }
    if (ctorrefInside)                                                      return 1963;
    if (!ctorrefMx.try_lock())                                              return 1964;
    ctorrefMx.unlock();
    bool ctorrefOwns = false;
    {
        std.unique_lock<std.mutex> ctorrefUl = std.unique_lock<std.mutex>(ctorrefMx);
        ctorrefOwns = ctorrefUl.owns_lock();
        ctorrefInside = ctorrefMx.try_lock();
