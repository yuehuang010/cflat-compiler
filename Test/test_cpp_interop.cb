    if (cppi.nsobj.inner.deep != 31) return 3314;
    // ---- assignment into a live nontrivial C++ object from a temporary (3320-3339) ----------
    // cppas.Life counts every special member and its destructor records the payload it saw
    // (last_dtor) then poisons it to -99, so a copy where a move belongs, a second destruction,
    // or a read of a destroyed temporary each change a count or a value.
    {
        cppas.Life a = cppas.Life(3);
        cppas.Life b = cppas.Life(4);
        cppas.Life t = cppas.Life(100);
        int c = 0;
        // Freeze legs (3320-3326): these shapes were refused when the issue was filed and were
        // accepted by 50476d5b; each asserts exactly one move assignment from one temporary,
        // destroyed once after being moved from (last_dtor -1), operands untouched.
        cppas.Life.reset();
        t = a + b;
        if (t.value() != 7 || a.value() != 3 || b.value() != 4 || cppas.Life.ctors != 1
            || cppas.Life.move_assigns != 1 || cppas.Life.copy_assigns != 0
            || cppas.Life.copies != 0 || cppas.Life.moves != 0 || cppas.Life.dtors != 1
            || cppas.Life.last_dtor != -1)
            return 3320;
        cppas.Life.reset();
        t = b - a;
        if (t.value() != 1 || cppas.Life.ctors != 1 || cppas.Life.move_assigns != 1
            || cppas.Life.copy_assigns != 0 || cppas.Life.dtors != 1 || cppas.Life.last_dtor != -1)
            return 3321;
        cppas.Life.reset();
        t = a.twice();
        if (t.value() != 6 || cppas.Life.move_assigns != 1 || cppas.Life.copy_assigns != 0
            || cppas.Life.dtors != 1 || cppas.Life.last_dtor != -1)
            return 3322;
        // A parenthesized name is an lvalue: copy assignment, nothing constructed or destroyed.
        cppas.Life.reset();
        t = (a);
        if (t.value() != 3 || a.value() != 3 || cppas.Life.copy_assigns != 1
            || cppas.Life.move_assigns != 0 || cppas.Life.dtors != 0)
            return 3323;
        // Self-assignment reads both operands before the temporary replaces t.
        cppas.Life.reset();
        t = t + t;
        if (t.value() != 6 || cppas.Life.move_assigns != 1 || cppas.Life.dtors != 1)
            return 3324;
        // A C++ field of a CFlat struct and an array element as the destination.
        CppAssignHost host = { l = cppas.Life(1) };
        cppas.Life[2] cells = default;
        cppas.Life.reset();
        host.l = a + b;
        cells[1] = b - a;
        if (host.l.value() != 7 || cells[1].value() != 1 || cppas.Life.ctors != 2
            || cppas.Life.move_assigns != 2 || cppas.Life.copy_assigns != 0
            || cppas.Life.dtors != 2 || cppas.Life.last_dtor != -1)
            return 3325;
        // A chain: the inner temporary and the outer one are each destroyed exactly once.
        cppas.Life.reset();
        t = a + b + a;
        if (t.value() != 10 || cppas.Life.ctors != 2 || cppas.Life.move_assigns != 1
            || cppas.Life.dtors != 2)
            return 3326;
        // A constructor temporary takes the unmarked-temporary arm: move, never copy, assigned.
        cppas.Life.reset();
        t = cppas.Life(11);
        if (t.value() != 11 || cppas.Life.move_assigns != 1 || cppas.Life.copy_assigns != 0
            || cppas.Life.dtors != 1 || cppas.Life.last_dtor != -1)
            return 3326;
        // A '?:' whose arms are both temporaries joins their slots, so the join looked like an
        // lvalue and was COPY-assigned from (copy_assigns 1, last_dtor 1 on the pre-fix binary).
        cppas.Life.reset();
        t = c > 0 ? a + b : b - a;
        if (t.value() != 1 || cppas.Life.ctors != 1 || cppas.Life.move_assigns != 1
            || cppas.Life.copy_assigns != 0 || cppas.Life.dtors != 1 || cppas.Life.last_dtor != -1)
            return 3327;
        // Two by-value member calls, and a nested '?:' of temporaries: the same join.
        cppas.Life.reset();
        t = c > 0 ? a.twice() : (c == 0 ? b.twice() : a.twice());
        if (t.value() != 8 || cppas.Life.move_assigns != 1 || cppas.Life.copy_assigns != 0
            || cppas.Life.dtors != 1 || cppas.Life.last_dtor != -1)
            return 3328;
        // A released destination is CONSTRUCTED from the join: a move construction, not a copy
        // (copies 1 on the pre-fix binary).
        _ = move t;
        cppas.Life.reset();
        t = c > 0 ? a + b : b - a;
        if (t.value() != 1 || cppas.Life.moves != 1 || cppas.Life.copies != 0
            || cppas.Life.dtors != 1 || cppas.Life.last_dtor != -1)
            return 3329;
        // In a loop: one temporary per iteration, each destroyed once.
        cppas.Life.reset();
        for (int i = 0; i < 3; i++) { t = i > 1 ? a + b : b - a; }
        if (t.value() != 7 || cppas.Life.ctors != 3 || cppas.Life.move_assigns != 3
            || cppas.Life.copy_assigns != 0 || cppas.Life.dtors != 3)
            return 3330;
    }
    // Scope exit after assignment: every object constructed is destroyed exactly once.
    cppas.Life.reset();
    {
        cppas.Life a = cppas.Life(3);
        cppas.Life t = cppas.Life(100);
