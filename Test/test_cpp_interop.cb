int T93ThrowBrace(int a) { static t93s.Once g{a}; return g.get(); }
// T93: an explicit-type static initialized by a C++ constructor call (or a ternary of them) is built
// in place: clang makes 1 object, 0 copies, 0 moves; ok() == 1 proves the object sits in its slot.
int T93TrkExplicit(int a) { static t93s.Trk g = t93s.Trk(a); return g.ok() * 100 + g.get(); }
int T93TrkTernary(bool c, int x, int y)
{
    static t93s.Trk g = c ? t93s.Trk(x) : t93s.Trk(y);
    return g.ok() * 100 + g.get();
}
// T226: a static local copies an lvalue source once (a ternary picks one arm), slices a derived
