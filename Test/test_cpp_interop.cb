    // ---- a C++ reference return and a derived pointer at a RETURN statement (3370-3389) ----
    // Pre-fix 3370-3373 and 3379 failed to COMPILE ("cannot return this value: its type does not
    // match"), 3374, 3375 and 3380 were refused as an 'alias' escape, and 3376 / 3381 handed over
    // Both's address unadjusted (rv read Left's lv). 3377 (primary base, offset 0) and 3378 (null
    // stays null through the adjust) are accept-set controls that passed before.
    {
        cppi.RefCell* rc = RrCell();
        rc.v = 773;                              // aliases the static cell, not a copy
        if (cppi.ref_cell().v != 773)                                        return 3370;
        if (RrCellConst() != rc || RrCellConst().v != 773)                   return 3371;
        RrHolder rrh = default;
        rrh.box.c.v = 5;
        cppi.RefCell* held = RrHeld(&rrh);
        held.v = 6;
        if (rrh.box.c.v != 6)                                                return 3372;
        if (RrHeldConst(&rrh) != held)                                       return 3373;
        cpppoly.Shape* rrs = RrShapeFromRef();
        if (rrs.area() != 50 || rrs.tag != 2)                                return 3374;
        // Right is Both's NON-primary base: the returned pointer must be 16 bytes in, and the
        // virtual call through Right's vtable must reach Both::r (rv + 2000).
        cpppoly.Right* rrr = RrRightFromRef();
        if (rrr.rv != 44 || rrr.r() != 2044)                                 return 3375;
        cpppoly.Right* rrp = RrRightFromPtr(&cpppoly.both_ref());
        if (rrp != rrr || rrp.r() != 2044)                                   return 3376;
        if (RrShapeFromPtr(&cpppoly.circle_ref()).area() != 50)              return 3377;
        if (RrRightFromPtr(nullptr) != nullptr)                              return 3378;
        // The return leaves a block with a C++ destructor pending; it runs exactly once.
        int rrCircleDtors = cpppoly.circle_dtors();
        if (RrNested(1) != rc || cpppoly.circle_dtors() != rrCircleDtors + 1) return 3379;
        function<cpppoly.Right*()> rrLam = () => cpppoly.both_ref();
        if (rrLam() != rrr)                                                  return 3380;
        // A derived pointer passed to a CFlat function's base-pointer parameter is adjusted too.
        if (RrReadRight(&cpppoly.both_ref()) != 44)                          return 3381;
        // The brace-init and field-default stores are the same conversion. Pre-fix 3382 stored
        // the loaded RefCell bits as the pointer, 3383 / 3385 stored Both's address unadjusted,
        // and 3384's field default was refused at compile time (the struct value met a pointer).
        cpppoly.Both* rrBoth = &cpppoly.both_ref();
