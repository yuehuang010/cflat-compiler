int CppTemporaryRefCases()
{
    cppref.Ex refBindLvalue = cppref.Ex(5);
    if (cppref.take_ref(refBindLvalue) != 6 || refBindLvalue.v != 6)          return 3390;
    if (cppref.take_cref(cppref.Ex(5)) != 1005)                              return 3391;
    if (cppref.take_rref(cppref.Ex(5)) != 2005)                              return 3392;
    if (cppref.choose_cref(cppref.Ex(5)) != 205)                             return 3393;
    cppref.Ex refPickLvalue = cppref.Ex(5);
    if (cppref.choose_rref(cppref.Ex(5)) != 405
        || cppref.choose_rref(refPickLvalue) != 306 || refPickLvalue.v != 6) return 3394;
    ExFieldHolder refField = default;
    if (cppref.take_ref(refField.ex) != 6 || refField.ex.v != 6)             return 3395;
    if (cppref.take_ref(cppref.ref_ex()) != 71 || cppref.ref_ex().v != 71)  return 3396;
    return 0;
}

