    if (cppu_chain_a.helper4() != 13) return 1896;
    if (cppu_cyc_a.helper6() != 19) return 1897;
    if (cppu_cyc_b.helper5() != 17) return 1898;
    if (cppu_self.via_using7() != 123) return 1899;

