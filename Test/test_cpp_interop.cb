int EscFreedOnUnwind(int x) { return (new cppon.Esc(3))->get() + cppunw.thrower(x); }
int EscKeptOnUnwind(int x) { return (new cppon.Esc(3))->keep() + cppunw.thrower(x); }


int memrank_native(int x) { return 3612; }
int memrank_native(double x) { return 0; }

// A CFlat body for a C name core relies on (legs 3286-3287): core's toLong binds to it here.
int unwAtollArm = 0;
extern i64 atoll(const char* str)
{
    if (unwAtollArm > 0) cppunw.thrower(unwAtollArm);
    i64 v = 0;
    for (int i = 0; str[i] >= '0' && str[i] <= '9'; i++) v = v * 10 + (i64)(str[i] - '0');
    return v;
}
int UnwCoreOverridden(int x)
{
    cppunw.Tr t = cppunw.Tr(1);
    string s = "42";
    unwAtollArm = x;
    int v = (int)s.toLong();
    unwAtollArm = 0;
    return v;
}

