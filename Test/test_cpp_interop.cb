        // borrow of the old object keeps it alive (the release is withheld when an alias of the
        // old block can reach the reassignment): `first` stays readable and deletable, a swap
        // through a temporary keeps both objects. A release there would be a use-after-free.
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        {
            RpS* a = new RpS();
            RpS* b = new RpS();
            b.v = 9;
            got = RpParam(a, b);
            RpS* p = new RpS();
            p.v = 5;
            RpS* first = p;
            p = new RpS();
            got = got + first.v;
            delete first;
            RpS* s = new RpS();
            RpS* t = new RpS();
            s.v = 1;
            t.v = 2;
            RpS* tmp = s;
            s = t;
            t = tmp;
            got = got * 100 + s.v * 10 + t.v;
            mid = rpDtors;
        }
