        heapBase = (int)HeapAudit.reportLeaks();
        // A pointer stored into a struct field is shared: the reassignment releases nothing and
        // the field keeps reading the old object, which leaks as the pre-existing field-escape
        // leak (+1); scope exit frees the new one. Pre-fix neither was freed (+2).
        rpDtors = 0;
        {
            RpH h;
            RpS* p = new RpS();
            p.v = 11;
            h.ptr = p;
            p = new RpS();
            got = h.ptr.v;
            mid = rpDtors;
        }
        if (got != 11 || mid != 0 || rpDtors != 1 || (int)HeapAudit.reportLeaks() != heapBase + 1)
