        vrDtors = 0;
        {
            VrS[] n = default;
            n = new VrS[2];
            VrS[] w = new VrS[3];
            VrS[] m = move w;
            w = new VrS[1];
            VrS[] d = new VrS[4];
            d = default;
            mid = vrDtors;
        }
