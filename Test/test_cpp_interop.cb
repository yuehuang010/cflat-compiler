        // adopted `new` was not taken (SIGABRT).
        vrDtors = 0;
        {
            VrS[3] fa;
            VrS[] x = fa;
            if (vrZero > 0) x = new VrS[2];
            mid = vrDtors;
        }
        if (mid != 0 || vrDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3413;
        vrDtors = 0;
        {
            VrS[3] fa;
            VrS[] x = fa;
            if (vrZero > 0) x = new VrS[2];
            x = new VrS[4];
            VrS[] o = new VrS[1];
            VrS[] b = new VrS[2];
            if (vrZero > 0) o = b;
            o = new VrS[5];                                           // releases the S[1] block
            mid = vrDtors;
        }
        if (mid != 1 || vrDtors != 15 || (int)HeapAudit.reportLeaks() != heapBase) return 3414;

        // Early return, break, a move-returning call and a '?:' of two `new` blocks.
        vrDtors = 0;
        got = VrEarly(1) + VrEarly(0);
        if (got != 15 || vrDtors != 11 || (int)HeapAudit.reportLeaks() != heapBase) return 3415;
        vrDtors = 0;
        { VrS[] v = new VrS[1]; for (int i = 0; i < 5; i++) { v = new VrS[2]; if (i == 2) break; }
          mid = vrDtors; }
        if (mid != 5 || vrDtors != 7 || (int)HeapAudit.reportLeaks() != heapBase) return 3416;
        vrDtors = 0;
        { VrS[] v = VrMake(3); v = VrMake(2); v = vrZero > 0 ? new VrS[1] : new VrS[4]; mid = vrDtors; }
        if (mid != 5 || vrDtors != 9 || (int)HeapAudit.reportLeaks() != heapBase) return 3417;

        // A C++ exception after the reassignment: the old block was already released, the new
        // one is freed by the unwind cleanup; global new[] and delete[] balance (see above).
        cppunw.reset();
        cppon.reset();
