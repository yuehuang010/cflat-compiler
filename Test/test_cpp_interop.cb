    int* cipP = &cipK;
    const int* cipC = &cipK;
    int[2] cipA = { 3, 4 };
    if (cppexp.conv_ip_val(&cipK) != 107 || cppexp.conv_ip_val(cipP) != 107)   return 2266;
    if (cppexp.conv_ip_val(cipC) != 107 || cppexp.conv_ip_val(&cipA[1]) != 104) return 2267;
    if (cppexp.conv_ip_two(&cipK, cipP) != 77)                                 return 2268;
    char* cipS = "abcde";
    if (cppexp.conv_cp_val(cipS) != 5)                                         return 2269;
