    if (clsfieldSelf.bk.b != 8 || clsfieldSelf.bk.owner == nullptr) return 1846;

    cppf.HoldsSpec clsfieldSpec = default;                     // field of a specialization
    if (clsfieldSpec.h.v != 6 || clsfieldSpec.tail != 1) return 1847;
    clsfieldSpec.h.v = 8;
    if (clsfieldSpec.h.get() != 8) return 1847;
    cppf.HoldsAlias clsfieldAlias = default;                   // same specialization via an alias
    if (clsfieldAlias.a.v != 13 || clsfieldAlias.tail != 2) return 1848;
