        if (ctorrefSSize != 11) return 7123;
        i64 ctorrefPDiff = 20;
        cppcr.PDiffRef ctorrefPDiffObj = cppcr.PDiffRef(ctorrefPDiff);
        if (ctorrefPDiff != 21) return 7124;
        u64 ctorrefSize = 40;
        cppcr.SizeRef ctorrefSizeObj = cppcr.SizeRef(ctorrefSize);
        if (ctorrefSize != 41) return 7126;
