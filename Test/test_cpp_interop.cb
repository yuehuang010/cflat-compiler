}
int EscNonThrowingArg(int x) { int r = cppon.escThrow(new cppon.Esc(x), 0); return r; }
cppon.Esc* EscReturnSelf(int x) { return (new cppon.Esc(x))->self(); }
int* EscReturnFieldAddr(int x) { return &(new cppon.Esc(x))->v; }
int EscThrowingKeepArg(int x) { return cppon.escThrowKeep(new cppon.Esc(x), x + 5); }

