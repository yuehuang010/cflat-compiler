            return 3420;
    }
    int refResult = CppTemporaryRefCases();
    if (refResult != 0) return refResult;

    // Character literal identity crosses each C++ overload boundary as char.
    std.string literalBase = std.string("hi");
    std.string literalAdded = literalBase + 'x';
    if (literalAdded != std.string("hix") || cppsop.stropTail(literalAdded) != 120) return 3450;

    // A pointer operand binds the `const CharT*` overload, never the `CharT` one: the pre-fix
    // binary spelled `char* p` as `char` and failed module verification (size 3 = char overload).
    std.string sppBase = "ab";
    char* sppP = "cd";
    const char* sppCp = "cd";
    char[8] sppArr = "cd";
    char[4] sppBuf = "xy";
    char** sppPp = &sppP;
    std.string sppOther = "cd";
    char sppC = 'x';
    std.string sppPlusP = sppBase + sppP;
    if (sppPlusP.size() != 4 || sppPlusP[3] != 'd')                     return 7700;
    std.string sppPlusCp = sppBase + sppCp;
    if (sppPlusCp.size() != 4 || sppPlusCp[3] != 'd')                   return 7701;
    std.string sppPlusArr = sppBase + sppArr;
    if (sppPlusArr.size() != 4 || sppPlusArr[3] != 'd')                 return 7702;
    std.string sppPlusCstr = sppBase + sppOther.c_str();
    if (sppPlusCstr.size() != 4 || sppPlusCstr[3] != 'd')               return 7703;
    std.string sppPlusAddr = sppBase + &sppBuf[1];
    if (sppPlusAddr.size() != 3 || sppPlusAddr[2] != 'y')               return 7704;
    std.string sppPlusDeref = sppBase + *sppPp;
    if (sppPlusDeref.size() != 4 || sppPlusDeref[3] != 'd')             return 7705;
    char* sppSame = "ab";
    if (!(sppBase == sppSame) || sppBase == sppP || !(sppBase != sppP)) return 7706;
    if (!(sppBase < sppP) || sppBase >= sppP || !(sppBase <= sppSame))  return 7707;
    // Accept-set: a `char` operand keeps the `CharT` overload.
    std.string sppPlusC = sppBase + sppC;
    if (sppPlusC.size() != 3 || sppPlusC[2] != 'x')                     return 7708;
    sppBase += sppP;
    if (sppBase.size() != 4 || sppBase[3] != 'd')                       return 7709;

    // Pointer operand depth: a `char[4][4]` row decays to `char*`, a `?:` over `char*` arms stays
    // `char*`, and an enum class operand keeps its enum type beside an `int` overload.
    char[4][4] pdRows = default;
    pdRows[1][0] = (char)99;
    pdRows[1][1] = (char)100;
    cppsopd.Tally pdT;
    pdT.v = 200;
    if (pdT - pdRows[1] != 100101)                                      return 7800;
    std.string pdS = "ab";
    std.string pdRow = pdS + pdRows[1];
    if (pdRow.size() != 4 || pdRow[3] != 'd')                           return 7801;
    char* pdA = "cd";
    char* pdB = "efg";
    bool pdPickA = pdRow.size() == 4;
    std.string pdJoin = pdS + (pdPickA ? pdA : pdB);
    if (pdJoin.size() != 4 || pdJoin[3] != 'd')                         return 7802;
    cppsopd.Pick pdE = cppsopd.Pick.B;
    if (pdT + pdE != 220 || pdT + cppsopd.Pick.A != 210)                return 7803;

    // This free template also pins the existing int-literal rule.
    if (cppsop.typeCodeOf('x') != 1 || cppsop.typeCodeOf(5) != 7) return 3451;

    std.string literalAppended = std.string("a");
    literalAppended += 'x';
    if (literalAppended != std.string("ax")) return 3452;

    std.string literalMembers = std.string("abc");
    literalMembers.push_back('x');
    if ((int)literalMembers.find('x') != 3 || cppsop.stropTail(literalMembers) != 120) return 3453;

    std.string literalConstructed = std.string(3, 'x');
    if ((int)literalConstructed.size() != 3 || cppsop.stropTail(literalConstructed) != 120) return 3454;

    cppsop.LiteralCtor literalCtor = cppsop.LiteralCtor('x');
    if (literalCtor.code != 1) return 3455;

    cppsop.LiteralMember literalMember = default;
    literalMember.push_back('x');
    if (literalMember.pick('x') != 1 || literalMember.find('x') != 1
        || literalMember.value != 120) return 3456;

    cppsop.LiteralOps literalOps = default;
    cppsop.LiteralOps literalSum = literalOps + 'x';
    literalOps += 'x';
    if (literalSum.value != 1 || literalOps.value != 1 || !(literalOps == 'x')) return 3457;

    std.vector<char> literalVector = default;
    literalVector.push_back('x');
    auto literalBox = cppsop.LiteralBox('x');
    if ((int)literalVector[0] != 120 || (int)literalVector.size() != 1
        || literalBox.code != 1) return 3458;

    if (cppsop.typeCodeOf(L'x') != 14 || cppsop.typeCodeOf(u'x') != 13
        || cppsop.typeCodeOf(U'x') != 17) return 3459;

    // ---- A plain T* local releases the object it owned on reassignment (3430-3449) ----------
    // Pre-fix owner-ness was a walk-order compile-time bit: the old object leaked (every `mid`
    // below read 0), and a pointer that borrowed on the path taken freed that address at exit.
    {
        int heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        int mid = 0;
        int got = 0;
        { RpS* p = new RpS(); p = new RpS(); mid = rpDtors; }
        if (mid != 1 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase) return 3430;
        // A C++ class with class-scope operator new / delete: the old object goes through it.
        cppon.reset();
        { cppon.Cls* p = new cppon.Cls(1); p = new cppon.Cls(2); mid = cppon.clsDel(); got = p->get(); }
        if (mid != 1 || got != 2 || cppon.clsDel() != 2 || cppon.dtors() != 2 || cppon.live() != 0)
            return 3431;
        // Conditional owner, branch NOT taken: scope exit must not free the stack local's address
        // (pre-fix SIGABRT), for a CFlat struct and a C++ class.
        rpDtors = 0;
        { RpS x; RpS* q = &x; if (vrZero > 0) q = new RpS(); got = q.v; mid = rpDtors; }
        if (got != 7 || mid != 0 || rpDtors != 1 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3432;
        cppon.reset();
        { cppon.Cls x = cppon.Cls(3); cppon.Cls* q = &x; if (vrZero > 0) q = new cppon.Cls(4);
          got = q->get(); }
        if (got != 3 || cppon.dtors() != 1 || cppon.clsDel() != 0 || cppon.live() != 0) return 3433;
        // Conditional owner, branch taken, then reassigned: the taken block is released.
        rpDtors = 0;
        { RpS x; RpS* q = &x; if (vrZero == 0) q = new RpS(); q = new RpS(); mid = rpDtors; }
        if (mid != 1 || rpDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3434;
        // `p = &x` after p owned: the old object goes, then p borrows (pre-fix: freed &x, SIGABRT).
        rpDtors = 0;
        { RpS x; x.v = 5; RpS* p = new RpS(); p = &x; mid = rpDtors; got = p.v; }
        if (mid != 1 || got != 5 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3435;
        cppon.reset();
        { cppon.Cls x = cppon.Cls(3); cppon.Cls* p = new cppon.Cls(1); p = &x; mid = cppon.clsDel(); }
        if (mid != 1 || cppon.dtors() != 2 || cppon.live() != 0) return 3436;
        // `p = move q` and `p = q` (an owning q is moved by the plain store): p's old object goes,
        // p frees q's object exactly once.
        rpDtors = 0;
        bool qNull = false;
        { RpS* p = new RpS(); RpS* q = new RpS(); q.v = 9; p = move q; mid = rpDtors; qNull = q == nullptr;
          got = p.v; }
        if (mid != 1 || !qNull || got != 9 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3437;
        rpDtors = 0;
        { RpS* p = new RpS(); RpS* q = new RpS(); q.v = 9; p = q; mid = rpDtors; got = p.v; }
        if (mid != 1 || got != 9 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3438;
        // Accept-set, passes on both binaries: `delete p; p = new` and `p = nullptr` after a
        // delete release nothing twice.
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        { RpS* p = new RpS(); delete p; p = new RpS(); mid = rpDtors; RpS* d = new RpS(); delete d;
          d = nullptr; }
        if (mid != 1 || rpDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3439;
        // A loop, break, early return, a move-returning call and `p = nullptr`.
        rpDtors = 0;
        { RpS* p = new RpS(); for (int i = 0; i < 4; i++) p = new RpS(); mid = rpDtors; }
        if (mid != 4 || rpDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3440;
        rpDtors = 0;
        { RpS* p = new RpS(); for (int i = 0; i < 5; i++) { p = new RpS(); if (i == 2) break; }
          mid = rpDtors; }
        if (mid != 3 || rpDtors != 4 || (int)HeapAudit.reportLeaks() != heapBase) return 3441;
        rpDtors = 0;
        got = RpEarly(1) + RpEarly(0);
        if (got != 15 || rpDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3442;
        rpDtors = 0;
        { RpS* p = RpMake(1); p = RpMake(2); mid = rpDtors; got = p.v; RpS* n = new RpS(); n = nullptr; }
        if (mid != 1 || got != 2 || rpDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3443;
        // A C++ exception after the reassignment: the old object was released, the new one is
        // freed by the unwind cleanup.
        rpDtors = 0;
        if (cppunw.guarded(RpUnwind, 5) != -5 || rpDtors != 2
            || (int)HeapAudit.reportLeaks() != heapBase) return 3444;
        // A primitive pointee is freed too.
        { int* ip = new int(3); ip = new int(4); got = *ip; }
        if (got != 4 || (int)HeapAudit.reportLeaks() != heapBase) return 3445;

