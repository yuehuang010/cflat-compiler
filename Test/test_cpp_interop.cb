    cppcr.ConstIntRef ctorrefCi = cppcr.ConstIntRef(5);
    if (ctorrefCi.seen != 5)                                                return 1967;
    cppcr.ConstIntRef ctorrefCi2 = cppcr.ConstIntRef(300);
    if (ctorrefCi2.seen != 300)                                             return 1968;
