            std.shared_ptr<M78Leaf> fromArrow = bp->p;
            if ((int)seed.use_count() != 4)             return 1695;
            if (fromArrow->value != 6)                  return 1696;
        }
        if ((int)seed.use_count() != 3)                 return 1697;
        std.shared_ptr<M78Leaf>* pp = &box.p;
        {
            std.shared_ptr<M78Leaf> fromDeref = *pp;
            if ((int)seed.use_count() != 4)             return 1698;
            if (fromDeref->forward(3) != 18)            return 1699;
        }
        std.vector<std.shared_ptr<M78Leaf>> vec = default;
        vec.push_back(seed);
        if ((int)seed.use_count() != 4)                 return 1700;
        {
            std.shared_ptr<M78Leaf> fromElem = vec[0];
            if ((int)seed.use_count() != 5)             return 1701;
            if (fromElem->value != 6)                   return 1702;
        }
        if ((int)seed.use_count() != 4)                 return 1703;
        // A HEAP (non-SSO) string field: the pre-fix bitwise copy aliased the buffer and the
        // local's destructor freed it, so the field read back below aborted in free().
        std.string m90long = std.string("abcdefghijklmnopqrstuvwxyz0123456789");
        box.s = m90long;
        {
            std.string fromField = box.s;
            if ((int)fromField.size() != 36)            return 1704;
        }
        if ((int)box.s.size() != 36)                    return 1705;
        if (cppt.m78_pick_string(box.s) != 56)          return 1706;
    }
    if (cppt.module_dtors() != 1)                       return 1707;

    // A namespace-scope C++ object as the initializer. Kept last: the global holds its leaf for
    // the rest of the program, so it must not be inside the destructor count above.
    m90global = std.make_shared<M78Leaf>(9);
    if ((int)m90global.use_count() != 1)                return 1708;
    {
        std.shared_ptr<M78Leaf> fromGlobal = m90global;
        if ((int)m90global.use_count() != 2)            return 1709;
        if (fromGlobal->forward(2) != 18)               return 1709;
    }

    // ---- Section M91: namespaces whose every declaration names a std:: specialization ------
    // Binding such a signature is deferred to first use; the namespace must be registered
    // anyway, or the call reports "Undefined variable <ns>" and the whole API is unreachable.
    std.string m91s = std.string("abcd");
    if (nsstd_param.lens(m91s) != 4) return 1710;
    std.string m91r = nsstd_ret.makes("abcde");
    if ((int)m91r.size() != 5) return 1711;
    std.vector<int> m91v = default;
    m91v.push_back(1);
    m91v.push_back(2);
    if (nsstd_vec.usevec(m91v) != 22) return 1712;
    if (nsstd_outer.inner.lens(m91s) != 5) return 1713;
    // Control: nsstd_mix holds one std-free declaration, which registered it even pre-fix.
    if (nsstd_mix.lens(m91s) != 11) return 1714;
    if (nsstd_mix.plain(5) != 7) return 1715;

    // ---- Section M93: class-scope `static const` folded from its in-class initializer ----
    // Every leg below reads a member with NO out-of-line definition except Defined/Linked;
    // before the fold each of these reported "'k' does not name a value here".
    if (cppi.m93.InClass.k != 41)                   return 1750;
    if (cppi.m93.InClass.ku != 4000000001)          return 1751;
    if (cppi.m93.InClass.kll != 9000000000)         return 1752;
    if (cppi.m93.InClass.kb != true)                return 1753;
    if (cppi.m93.InClass.kc != 'Q')                 return 1754;
    if ((int)cppi.m93.InClass.ke != 8)              return 1755;
    if (cppi.m93.InClass.kse != cppi.m93.Scoped.SB) return 1756;

    if (cppi.m93.Chained.base != 10)                return 1757;
    if (cppi.m93.Chained.derived != 15)             return 1758;
    if (cppi.m93.Outer.Inner.k != 47)               return 1759;
    if (cppi.m93.Defined.k != 46)                   return 1760;

    // Neighbours that bound before the fold - constexpr, inline const, and a declaration
    // whose only initializer is the out-of-line definition (read through its real symbol).
    if (cppi.m93.Cexpr.k != 44)                     return 1761;
    if (cppi.m93.InlineConst.k != 45)               return 1762;
    if (cppi.m93.Linked.k != 43)                    return 1763;

    // A folded member is usable where a constant expression is required.
    int[cppi.m93.InClass.k] m93arr = default;
    m93arr[cppi.m93.InClass.k - 1] = 12;
    if (m93arr[40] != 12)                           return 1764;

    int m93sel = 41;
    switch (m93sel)
    {
        case cppi.m93.InClass.k: break;
        default: return 1765;
    }

    // The folded constant carries no storage, so the record keeps its single field.
    cppi.m93.WithField m93wf = default;
    m93wf.v = 3;
    if (cppi.m93.WithField.cap != 49)               return 1766;
    if (m93wf.v != 3)                               return 1767;
    if (sizeof(cppi.m93.WithField) != sizeof(int))  return 1768;

    // ---- Section M92: qualified C++ class-template constructor temporaries (1730-1749) ---
    if (m92_take_box(cppt.Box<int>(9)) != 9) return 1730;
    if (cppt.take_box_arg(cppt.Box<int>(10)) != 10) return 1731;
    cppt.CtorTempSink m92sink = default;
    if (m92sink.take(cppt.Box<int>(11)) != 12) return 1732;
    if (cppt.make_box(cppt.Box<int>(12)).get().get() != 12) return 1733;
    if (m92sink.take_any(cppt.Box<int>(13)) != 15) return 1734;
    if (m92_return_box(14).get() != 14) return 1735;
    std.optional<int> m92assigned = default;
    m92assigned = std.optional<int>(16);
    if (!m92assigned.has_value() || m92assigned.value() != 16) return 1736;
    if (m92_take_box(cppt.Box<int>()) != 0) return 1737;
    if (m92_take_pair(cppt.CtorPair<int>(16, 17)) != 33) return 1738;
    if (m92_take_nested(cppt.Box<cppt.Box<int>>(cppt.Box<int>(18))) != 18) return 1739;
    if (m92_take_nested2(cppt.Box<cppt.Box<cppt.Box<int>>>(
            cppt.Box<cppt.Box<int>>(cppt.Box<int>(19)))) != 19) return 1740;
    cppi.impl_detail.Payload m92payload = default;
    if (m92_take_payload(cppt.Box<cppi.impl_detail.Payload>(m92payload)) != 3) return 1741;
    cppt.Box<cppi.impl_detail.Payload> m92payloadBox =
        cppt.Box<cppi.impl_detail.Payload>(m92payload);
    if (m92payloadBox.get().get() != 3) return 1742;
    cppt.Box<cppt.Box<int>> m92nestedDecl =
        cppt.Box<cppt.Box<int>>(cppt.Box<int>(20));
    if (m92nestedDecl.get().get() != 20) return 1743;
    if (m92_take_nested(cppt.Box<cppt.Box<int>>(cppt.Box<int>(21))) != 21) return 1744;
    if (cppt.take_box_arg(cppt.Box<int>(22)) != 22) return 1745;
    cppt.Box<double> m92double = cppt.Box<double>(2.5);
    if (m92double.get() != 2.5) return 1746;
    cppt.Box<int> m92decl = cppt.Box<int>(23);
    if (m92decl.get() != 23) return 1747;
    if (cppt.make_box(cppt.Box<int>()).get().get() != 0) return 1748;
    if (m92_return_box(24).get() != 24) return 1749;

    // ---- Section M95: static members of a C++ class TEMPLATE (1810-1829) ----------------
    // Every leg goes through the qualified-specialization spelling `cppt.M95Stat<T>.member`.
    // PRE-FIX (532e7bd0): each of these fails name lookup with
    // "'M95Stat' is not a member of namespace 'cppt'."
    cppt.M95Stat<int> m95declared = default;
    if (m95declared.x != 0) return 1810;
    if (cppt.M95Stat<int>.rank() != 7) return 1811;              // static method, 0 args
    if (cppt.M95Stat<int>.twice(5) != 10) return 1812;           // 1 arg
    if (cppt.M95Stat<int>.combine(4, 3) != 43) return 1813;      // 2 args
    // No `M95Stat<double>` is declared anywhere: the static call alone instantiates it.
    if (cppt.M95Stat<double>.rank() != 7) return 1814;
    if (cppt.M95Stat<double>.twice(2.5) != 5.0) return 1815;
    if (cppt.M95Stat<double>.combine(4.0, 3.0) != 43.0) return 1816;
    // Static DATA member: read, write, and per-specialization storage.
    if (cppt.M95Stat<int>.counter != 0) return 1817;
    cppt.M95Stat<int>.counter = 9;
    if (cppt.M95Stat<int>.counter != 9) return 1818;
    if (cppt.M95Stat<float>.counter != 0) return 1819;
    if (cppt.M95Stat<int>.kTag != 41) return 1820;               // static constexpr member
    // Specialization over a user C++ class, and over another specialization.
    cppt.M95Payload m95payload = cppt.M95Payload(6);
    if (cppt.M95Wrap<cppt.M95Payload>.rank() != 3) return 1821;
    if (cppt.M95Wrap<cppt.M95Payload>.score(m95payload) != 11) return 1822;
    if (cppt.M95Nest<cppt.M95Stat<int>>.depth() != 2) return 1823;
    if (cppt.M95Nest<cppt.M95Stat<int>>.fromInner(m95declared) != 1) return 1824;
    // Call positions: as a C++ call argument, as a plain assignment statement.
    if (cppt.m95_take(cppt.M95Stat<int>.rank()) != 1007) return 1825;
    int m95assigned = cppt.M95Stat<int>.combine(1, 2);
    if (m95assigned != 12) return 1826;
    // The same spelling inside a CFlat generic body, on the body's own T.
    if (m95TwiceStatic<int>(5) != 10) return 1827;
    if (m95TwiceStatic<double>(1.5) != 3.0) return 1828;
    if (m95RankStatic<float>() != 7) return 1829;
    // ---- Section M94: a string LITERAL as a C++ operator operand (1790-1805) --------------
    // Pre-fix every literal leg below reported "no overload of 'operator...' matches the given
    // arguments" with the matching char* candidate listed, because the literal was wrapped as a
    // CFlat 'string' before the candidates were ranked.
    std.string m94s = std.string("hello");
    m94s += " world";
    if ((int)m94s.size() != 11) return 1790;
    m94s += "!";
    if ((int)m94s.size() != 12) return 1791;

    // Both a char* and a std::string overload are declared: C++ picks char* for a literal.
    cppsop.Acc m94a = cppsop.Acc();
    m94a += "hello";
    if (m94a.tag() != 1) return 1792;
    if (m94a.n() != 5) return 1793;
    // Control: a CHAR literal keeps selecting the 'char' leg, before and after the fix.
    m94a += 'z';
    if (m94a.tag() != 3) return 1794;
    if (m94a.n() != 6) return 1795;

    cppsop.CharOnly m94c = cppsop.CharOnly();
    m94c += "abc";
    if (m94c.n() != 3) return 1796;
    if (!(m94c == "xyz")) return 1797;
    if (m94c == "ab") return 1798;

    // FREE operators: the literal on the right, then on the left (the +100 leg proves which
    // free overload ran rather than an operand swap).
    cppsop.Free m94f = cppsop.Free();
    cppsop.Free m94g = m94f + "hello";
    if (m94g.n() != 5) return 1799;
    if (!(m94g == "world")) return 1800;
    cppsop.Free m94h = "hello" + m94f;
    if (m94h.n() != 105) return 1801;

    // Controls that behaved identically pre-fix: a char* local, a literal std.map key, and
    // the CFlat-native string operators the literal wrap exists for.
    char* m94p = " world";
    std.string m94s2 = std.string("hello");
    m94s2 += m94p;
    if ((int)m94s2.size() != 11) return 1802;

    std.map<std.string, int> m94m = std.map<std.string, int>();
    m94m["k"] = 5;
    if (m94m["k"] != 5) return 1803;

    string m94cs = "ab";
    m94cs += "cd";
    if (m94cs.length() != 4) return 1804;
    if (m94cs != "abcd") return 1805;

    return 0;
}
