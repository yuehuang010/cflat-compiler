        // ---- An adopted block answers to aliases of the slot it came from (3460-3469) ----------
        // `kp` borrows a's block before `b = a` / `b = move a` hands it to b: b's later
        // reassignment or scope exit must not free it under kp (pre-fix: freed, use-after-free
        // read). The block leaks (+1) instead. Chained `q = p = new` is out of scope here.
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        { RpS* a = new RpS(); a.v = 5; RpS* kp = a; RpS* b = nullptr; b = a; b = new RpS();
          mid = rpDtors; got = kp.v; }
        if (mid != 0 || got != 5 || rpDtors != 1 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3460;
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        { RpS* a = new RpS(); a.v = 5; RpS* kp = a; { RpS* b = nullptr; b = a; } mid = rpDtors;
          got = kp.v; }
        if (mid != 0 || got != 5 || rpDtors != 0 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3461;
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        { RpS* a = new RpS(); a.v = 5; RpS* kp = a; RpS* b = new RpS(); b = move a; b = new RpS();
          mid = rpDtors; got = kp.v; }
        if (mid != 1 || got != 5 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3462;
        // An aliased owner reassigned to a BORROWED heap pointer gives up ownership: scope exit
        // frees a's block once (through a) and leaks p's first block (+1); pre-fix p kept its
        // owns-flag and freed a's block a second time.
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        { RpS* a = new RpS(); a.v = 5; RpS* b = a; RpS* p = new RpS(); RpS* c = p; p = b;
          mid = rpDtors; got = c.v + p.v; }
        if (mid != 0 || got != 12 || rpDtors != 1 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3463;
        // A borrow whose owner no longer holds the block is never adopted: after a swap through
        // `tmp` (3464) or a move of the owner (3465) the block may still be read through the
        // borrow or freed by its new holder, so it leaks (+1) (pre-fix: freed under tmp / b).
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        { RpS* s = new RpS(); s.v = 5; RpS* t = new RpS(); t.v = 6; RpS* tmp = s; s = t; t = tmp;
          t = new RpS(); mid = rpDtors; got = tmp.v; }
        if (mid != 0 || got != 5 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3464;
