    // A move-only class (copy assignment deleted) takes a '?:' of temporaries into a RELEASED
    // destination by move construction; the pre-fix binary refused it as a copy.
    {
        cppas.MoveOnly a = cppas.MoveOnly(3);
        cppas.MoveOnly t = cppas.MoveOnly(100);
        int c = 1;
        cppas.MoveOnly.move_assigns = 0;
        t = a + a;
        if (t.value() != 6 || cppas.MoveOnly.move_assigns != 1) return 3333;
        _ = move t;
        t = c > 0 ? a + a : a + a + a;
        if (t.value() != 6 || a.value() != 3) return 3334;
        t = move a;
        if (t.value() != 3 || cppas.MoveOnly.move_assigns != 2) return 3335;
    }
    // std.string: operator result, literal operand, parenthesized name, member call, '?:' of
    // temporaries and self-assignment, all past the small-string buffer.
    {
        std.string a = std.string("a long string well past the small buffer");
        std.string b = std.string(" and a long tail");
        std.string t = std.string("an old long value that must be released!!");
        int c = 0;
        t = a + b;
        if (t.size() != 56 || a.size() != 40 || b.size() != 16) return 3336;
        t = (b);
        if (t.size() != 16 || b.size() != 16) return 3337;
        t = c > 0 ? a + b : b + a;
        if (t.size() != 56 || t.substr(0, 4) != std.string(" and")) return 3338;
        t = t + t;
        if (t.size() != 112 || t.substr(56, 4) != std.string(" and")) return 3339;
    }

    // ---- Class-scope operator new / delete, and `new T[n]` of a C++ class (3350-3368) ----------
    // `new T` / `delete p` call the class's own operator new / delete (inherited through a base,
    // the sized delete given sizeof(T)); `new T[n]` pairs ::operator new[] (or the class's
    // operator new[]) with the matching delete[] on every free site. Pre-fix every single object
    // went through the GLOBAL operator new / delete, and every array block came from CFlat's
    // operator new but was freed through the C++ single-object delete (heap_audit: one leak).
    {
        cppunw.reset();
        cppon.reset();
        int heapBase = (int)HeapAudit.reportLeaks();
        cppon.Cls* onA = new cppon.Cls(5);
        int onV = onA->get();
        delete onA;
        if (onV != 5 || cppon.clsNew() != 1 || cppon.clsDel() != 1 || cppunw.news() != 0
            || cppunw.deletes() != 0 || cppon.live() != 0) return 3350;
        cppon.reset();
        if (OnUniqueCls(6) != 6 || cppon.clsNew() != 1 || cppon.clsDel() != 1
            || cppunw.news() != 0 || cppon.live() != 0) return 3351;      // unique T* scope exit
        cppon.reset();
        if (OnUniqueLib(8) != 8 || cppon.clsNew() != 1 || cppon.clsDel() != 1
            || cppunw.news() != 0 || cppon.live() != 0) return 3352;      // unique<T> (unique.cb)
        cppon.reset();
        cppon.Sized* onS = new cppon.Sized(9);
        onV = onS->get();
        delete onS;
        if (onV != 9 || cppon.clsNew() != 1 || cppon.clsDel() != 1 || cppunw.news() != 0)
            return 3353;                                                  // sized: n == sizeof
        cppon.reset();
        cppon.ClsDerived* onD = new cppon.ClsDerived(4);
        onV = onD->get();
        delete onD;
        if (onV != 4 || cppon.clsNew() != 1 || cppon.clsDel() != 1 || cppunw.news() != 0)
            return 3354;                                                  // inherited operators
        cppon.reset();
        cppon.Poly* onP = new cppon.PolyDerived(5);                       // deleting destructor
        onV = onP->get();
        delete onP;
        if (onV != 10 || cppon.clsNew() != 1 || cppon.clsDel() != 1 || cppunw.news() != 0
            || cppon.dtors() != 2 || cppon.live() != 0) return 3355;
        // A throwing constructor frees the block through the class's delete, not the global one.
        cppon.reset();
        if (cppunw.guarded(OnClsCtorThrows, 3) != -3 || cppon.clsNew() != 1
            || cppon.clsDel() != 1 || cppunw.deletes() != 0 || cppon.live() != 0) return 3356;

        // Arrays: every leg asserts the ::operator new[] / delete[] pair, no single-object free,
        // and no CFlat block left behind.
        cppunw.reset();
        cppon.reset();
        cppon.Plain[] onArr = new cppon.Plain[3];
        onV = onArr[0].get() + onArr[2].get();
        delete onArr;
        if (onV != 14 || cppunw.newArrs() != 1 || cppunw.deleteArrs() != 1 || cppunw.deletes() != 0
            || cppon.dtors() != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3357;
        cppunw.reset();
        cppon.reset();
        cppon.Plain* onRt = new cppon.Plain[onArrN];                      // runtime n, `delete p`
        onV = onRt[3].get();
        delete onRt;
        if (onV != 7 || cppunw.newArrs() != 1 || cppunw.deleteArrs() != 1 || cppunw.deletes() != 0
            || cppon.dtors() != 4 || (int)HeapAudit.reportLeaks() != heapBase) return 3358;
        cppunw.reset();
        cppon.reset();
        cppon.Plain* onSz = new cppon.Plain[3];
        delete[3] onSz;
        bool onSizedOk = cppunw.newArrs() == 1 && cppunw.deleteArrs() == 1 && cppon.dtors() == 3;
        cppunw.reset();
        cppon.reset();
        cppon.Plain* onRaw = new cppon.Plain[2];
        delete[_] onRaw;                                                  // frees, runs no dtor
        if (!onSizedOk || cppunw.newArrs() != 1 || cppunw.deleteArrs() != 1 || cppunw.deletes() != 0
            || cppon.dtors() != 0 || (int)HeapAudit.reportLeaks() != heapBase) return 3359;
        cppunw.reset();
        cppon.reset();
        if (OnViewScope(1) != 8 || cppunw.newArrs() != 1 || cppunw.deleteArrs() != 1
            || cppon.dtors() != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3360;
        // `new Cls[n]` looks up operator new[] only: the class's operator new never applies.
        cppunw.reset();
        cppon.reset();
        cppon.Cls[] onCa = new cppon.Cls[2];
        onV = onCa[1].get();
        delete onCa;
        if (onV != 7 || cppon.clsNew() != 0 || cppon.clsDel() != 0 || cppunw.newArrs() != 1
            || cppunw.deleteArrs() != 1 || cppon.dtors() != 2) return 3361;
        // The class's own operator new[] / sized delete[] (size = n * sizeof).
        cppunw.reset();
        cppon.reset();
        cppon.Arr[] onAa = new cppon.Arr[3];
        onV = onAa[2].get();
        delete onAa;
        if (onV != 3 || cppon.clsNewArr() != 1 || cppon.clsDelArr() != 1 || cppon.clsNew() != 0
            || cppunw.newArrs() != 0 || cppon.dtors() != 3) return 3362;
        // A polymorphic element array: n destructors, never element 0's deleting destructor.
        cppunw.reset();
        cppon.reset();
        cppon.Poly[] onPa = new cppon.Poly[2];
        onV = onPa[1].get();
        delete onPa;
        if (onV != 1 || cppon.clsDel() != 0 || cppunw.deleteArrs() != 1 || cppon.dtors() != 2
            || cppon.live() != 0) return 3363;
        // Over-aligned element: the aligned ::operator new[] / delete[] pair.
        cppon.reset();
        cppon.Wide[] onW = new cppon.Wide[3];
        onV = onW[2].get();
        delete onW;
        if (onV != 6 || cppon.dtors() != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3364;
        // A throwing element constructor frees the block through ::operator delete[] (UnwArrNew).
        cppunw.reset();
        if (cppunw.guarded(UnwArrNew, 5) != -5 || cppunw.dtors() != 3 || cppunw.newArrs() != 1
            || cppunw.deleteArrs() != 1 || cppunw.deletes() != 0) return 3365;
        // A TRIVIAL class (no user constructor) with class operators: the class new and delete,
        // and the block still reads zeroed as CFlat's own `new` storage does.
        cppon.reset();
        cppon.Triv* onT = new cppon.Triv;
        onV = onT->a + onT->b;
        delete onT;
        if (onV != 0 || cppon.clsNew() != 1 || cppon.clsDel() != 1) return 3366;

        // A runtime delete count destroys every polymorphic element before one array free.
        cppunw.reset();
        cppon.reset();
        cppon.Poly* onPr = new cppon.Poly[onArrN];
        delete onPr;
        if (cppon.dtors() != onArrN || cppon.live() != 0 || cppon.clsNew() != 0
            || cppon.clsDel() != 0 || cppon.clsNewArr() != 0 || cppon.clsDelArr() != 0
            || cppunw.newArrs() != 1 || cppunw.deleteArrs() != 1 || cppunw.deletes() != 0)
            return 3368;

    }

    // By-value C++ last-use identity: counts include the transfer into each CFlat helper.
    {
        cpptw.reset_counts();
        int observed = lu_no_shadow(cpptw.Twin(7));
        if (observed != 7 || cpptw.packed_counts() != 23) return 3340;
    }
    {
        cpptw.reset_counts();
        int observed = lu_loop(cpptw.Twin(7));
        if (observed != 14 || cpptw.packed_counts() != 214) return 3341;
    }
    {
        cpptw.reset_counts();
        int observed = lu_lambda(cpptw.Twin(7));
        if (observed != 14 || cpptw.packed_counts() != 124) return 3342;
    }
    {
        cpptw.reset_counts();
        int observed = lu_shadow_alias(cpptw.Twin(7));
        if (observed != 107 || cpptw.packed_counts() != 125) return 3343;
    }
    {
        cpptw.reset_counts();
        int observed = lu_after_block(cpptw.Twin(7));
        if (observed != 114 || cpptw.packed_counts() != 226) return 3344;
    }
    {
        cpptw.reset_counts();
        int observed = lu_with_global(cpptw.Twin(7));
        if (observed != 37 || cpptw.packed_counts() != 23) return 3345;
    }
    {
        cpptw.reset_counts();
        int observed = lu_prefix(cpptw.Twin(7), cpptw.Twin(8));
        if (observed != 807 || cpptw.packed_counts() != 46) return 3346;
    }
    {
        cpptw.reset_counts();
        int observed = lu_double_call(cpptw.Twin(7));
        if (observed != 14 || cpptw.packed_counts() != 124) return 3347;
    }
    {
        cpptw.reset_counts();
        int observed = lu_plain_local();
        if (observed != 100 || cpptw.packed_counts() != 102) return 3348;
    }
    {
        cpptw.reset_counts();
        int observed = lu_shadow_exact(cpptw.Twin(7));
        if (observed != 57 || cpptw.packed_counts() != 125) return 3349;
    }

    // ---- a C++ reference return and a derived pointer at a RETURN statement (3370-3389) ----
    // Pre-fix 3370-3373 and 3379 failed to COMPILE ("cannot return this value: its type does not
    // match"), 3374, 3375 and 3380 were refused as an 'alias' escape, and 3376 / 3381 handed over
    // Both's address unadjusted (rv read Left's lv). 3377 (primary base, offset 0) and 3378 (null
    // stays null through the adjust) are accept-set controls that passed before.
    {
        cppi.RefCell* rc = RrCell();
        rc.v = 773;                              // aliases the static cell, not a copy
        if (cppi.ref_cell().v != 773)                                        return 3370;
        if (RrCellConst() != rc || RrCellConst().v != 773)                   return 3371;
        RrHolder rrh = default;
        rrh.box.c.v = 5;
        cppi.RefCell* held = RrHeld(&rrh);
        held.v = 6;
        if (rrh.box.c.v != 6)                                                return 3372;
        if (RrHeldConst(&rrh) != held)                                       return 3373;
        cpppoly.Shape* rrs = RrShapeFromRef();
        if (rrs.area() != 50 || rrs.tag != 2)                                return 3374;
        // Right is Both's NON-primary base: the returned pointer must be 16 bytes in, and the
        // virtual call through Right's vtable must reach Both::r (rv + 2000).
        cpppoly.Right* rrr = RrRightFromRef();
        if (rrr.rv != 44 || rrr.r() != 2044)                                 return 3375;
        cpppoly.Right* rrp = RrRightFromPtr(&cpppoly.both_ref());
        if (rrp != rrr || rrp.r() != 2044)                                   return 3376;
        if (RrShapeFromPtr(&cpppoly.circle_ref()).area() != 50)              return 3377;
        if (RrRightFromPtr(nullptr) != nullptr)                              return 3378;
        // The return leaves a block with a C++ destructor pending; it runs exactly once.
        int rrCircleDtors = cpppoly.circle_dtors();
        if (RrNested(1) != rc || cpppoly.circle_dtors() != rrCircleDtors + 1) return 3379;
        function<cpppoly.Right*()> rrLam = () => cpppoly.both_ref();
        if (rrLam() != rrr)                                                  return 3380;
        // A derived pointer passed to a CFlat function's base-pointer parameter is adjusted too.
        if (RrReadRight(&cpppoly.both_ref()) != 44)                          return 3381;
        // The brace-init and field-default stores are the same conversion. Pre-fix 3382 stored
        // the loaded RefCell bits as the pointer, 3383 / 3385 stored Both's address unadjusted,
        // and 3384's field default was refused at compile time (the struct value met a pointer).
        cpppoly.Both* rrBoth = &cpppoly.both_ref();
        RrSlots rrSlots = { c = cppi.ref_cell(), r = rrBoth };
        if (rrSlots.c != rc)                                                 return 3382;
        if (rrSlots.r.rv != 44 || rrSlots.r != rrr)                          return 3383;
        RrDefaults rrDefaults = default;
        if (rrDefaults.c != rc)                                              return 3384;
        if (rrDefaults.r.rv != 44 || rrDefaults.r.r() != 2044)               return 3385;
    }
    // ---- C++ temporary binding to reference parameters (3390-3399) -----------------------------
    // Keep the added locals in a helper frame so the existing unwind tests keep their frame shape.
    // ---- Reassigning an owning array view releases the old block (3400-3420) ------------------
    // Pre-fix the view store overwrote the slot and nothing ever destroyed or freed the first
    // block: every `mid` count below read 0 and HeapAudit kept one live block per reassignment.
    {
        int heapBase = (int)HeapAudit.reportLeaks();
        vrDtors = 0;
        int mid = 0;
        { VrS[] v = new VrS[3]; v = new VrS[2]; mid = vrDtors; }
        if (mid != 3 || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3400;
        // C++ class elements free through ::operator delete[], never the single-object delete.
        cppunw.reset();
        cppon.reset();
        int midDel = 0;
        { cppon.Plain[] v = new cppon.Plain[3]; v = new cppon.Plain[2]; mid = cppon.dtors();
          midDel = cppunw.deleteArrs(); }
        if (mid != 3 || midDel != 1 || cppon.dtors() != 5 || cppunw.deleteArrs() != 2
            || cppunw.deletes() != 0 || cppon.live() != 0) return 3401;
        // The class's own operator delete[] (sized: a whole number of elements, else +100).
        cppon.reset();
        { cppon.Arr[] v = new cppon.Arr[3]; v = new cppon.Arr[2]; mid = cppon.clsDelArr(); }
        if (mid != 1 || cppon.clsDelArr() != 2 || cppon.dtors() != 5 || cppon.live() != 0) return 3402;
        // Polymorphic elements: n destructors, never element 0's deleting destructor.
        cppunw.reset();
        cppon.reset();
        { cppon.Poly[] v = new cppon.Poly[3]; v = new cppon.Poly[2]; mid = cppon.dtors(); }
        if (mid != 3 || cppon.clsDel() != 0 || cppunw.deleteArrs() != 2 || cppon.live() != 0)
            return 3403;
        // Over-aligned element: the aligned delete[] pair.
        cppon.reset();
        { cppon.Wide[] v = new cppon.Wide[3]; v = new cppon.Wide[2]; mid = cppon.dtors(); }
        if (mid != 3 || cppon.live() != 0 || (int)HeapAudit.reportLeaks() != heapBase) return 3404;

        // `v = move w`: v's old block goes, w is nulled, and v frees w's block exactly once.
        vrDtors = 0;
        bool wNull = false;
        { VrS[] v = new VrS[3]; VrS[] w = new VrS[2]; v = move w; mid = vrDtors; wNull = w == nullptr; }
        if (mid != 3 || !wNull || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3405;
        cppunw.reset();
        cppon.reset();
        { cppon.Plain[] v = new cppon.Plain[3]; cppon.Plain[] w = new cppon.Plain[2]; v = move w;
          mid = cppon.dtors(); }
        if (mid != 3 || cppon.dtors() != 5 || cppunw.deleteArrs() != 2 || cppon.live() != 0)
            return 3406;
        // Accept-set, passes on both binaries: `v = v` keeps the live block and releases nothing.
        heapBase = (int)HeapAudit.reportLeaks();
        vrDtors = 0;
        int v0 = 0;
        { VrS[] v = new VrS[3]; v = v; mid = vrDtors; v0 = v[2].v; }
        if (mid != 0 || v0 != 7 || vrDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3407;

        // A loop releases on every iteration (CFlat struct, then a C++ class).
        vrDtors = 0;
        { VrS[] v = new VrS[1]; for (int i = 0; i < 4; i++) v = new VrS[2]; mid = vrDtors; }
        if (mid != 7 || vrDtors != 9 || (int)HeapAudit.reportLeaks() != heapBase) return 3408;
        cppunw.reset();
        cppon.reset();
        { cppon.Plain[] v = new cppon.Plain[1]; for (int i = 0; i < 4; i++) v = new cppon.Plain[2];
          mid = cppon.dtors(); midDel = cppunw.deleteArrs(); }
        if (mid != 7 || midDel != 4 || cppunw.deleteArrs() != 5 || cppon.live() != 0) return 3409;

        // A null / `default` / moved-from old view frees nothing; `v = default` releases the block.
        vrDtors = 0;
        {
            VrS[] n = default;
            n = new VrS[2];
            VrS[] w = new VrS[3];
            VrS[] m = move w;
            w = new VrS[1];
            VrS[] d = new VrS[4];
            d = default;
            mid = vrDtors;
        }
        if (mid != 4 || vrDtors != 10 || (int)HeapAudit.reportLeaks() != heapBase) return 3410;

        // Accept-set, passes on both binaries: borrowed views release nothing - a `T[]` parameter
        // and a local bound to another view.
        heapBase = (int)HeapAudit.reportLeaks();
        vrDtors = 0;
        int got = 0;
        {
            VrS[] a = new VrS[3];
            VrS[] b = new VrS[2];
            b[0].v = 9;
            got = VrParam(a, b);
            VrS[] x = a;
            x = b;
            got = got + x[0].v;
            mid = vrDtors;
        }
        if (got != 18 || mid != 0 || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3411;
        // `v = w` from an OWNING view without `move`: v's block goes and v borrows w's.
        // Pre-fix v kept its ownership and freed w's block a second time (SIGTRAP).
        vrDtors = 0;
        { VrS[] v = new VrS[3]; VrS[] w = new VrS[2]; v = w; mid = vrDtors; }
        if (mid != 3 || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3412;

        // A view that holds a FIXED array on the path taken is never freed, at the reassignment
        // or at scope exit. Pre-fix the scope exit freed the stack array when the branch that
        // adopted `new` was not taken (SIGABRT).
        vrDtors = 0;
        {
            VrS[3] fa;
            VrS[] x = fa;
            if (vrZero > 0) x = new VrS[2];
            mid = vrDtors;
        }
        if (mid != 0 || vrDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3413;
        vrDtors = 0;
        {
            VrS[3] fa;
            VrS[] x = fa;
            if (vrZero > 0) x = new VrS[2];
            x = new VrS[4];
            VrS[] o = new VrS[1];
            VrS[] b = new VrS[2];
            if (vrZero > 0) o = b;
            o = new VrS[5];                                           // releases the S[1] block
            mid = vrDtors;
        }
        if (mid != 1 || vrDtors != 15 || (int)HeapAudit.reportLeaks() != heapBase) return 3414;

        // Early return, break, a move-returning call and a '?:' of two `new` blocks.
        vrDtors = 0;
        got = VrEarly(1) + VrEarly(0);
        if (got != 15 || vrDtors != 11 || (int)HeapAudit.reportLeaks() != heapBase) return 3415;
        vrDtors = 0;
        { VrS[] v = new VrS[1]; for (int i = 0; i < 5; i++) { v = new VrS[2]; if (i == 2) break; }
          mid = vrDtors; }
        if (mid != 5 || vrDtors != 7 || (int)HeapAudit.reportLeaks() != heapBase) return 3416;
        vrDtors = 0;
        { VrS[] v = VrMake(3); v = VrMake(2); v = vrZero > 0 ? new VrS[1] : new VrS[4]; mid = vrDtors; }
        if (mid != 5 || vrDtors != 9 || (int)HeapAudit.reportLeaks() != heapBase) return 3417;

        // A C++ exception after the reassignment: the old block was already released, the new
        // one is freed by the unwind cleanup - through ::operator delete[] both times.
        cppunw.reset();
        cppon.reset();
        if (cppunw.guarded(VrUnwind, 5) != -5 || cppon.dtors() != 5 || cppunw.deleteArrs() != 2
            || cppon.live() != 0 || cppunw.live() != 0) return 3418;

        // Primitive and string element views: the old block is freed (string buffers included).
        { int[] p = new int[3]; p = new int[2]; string[] s = new string[2]; s[0] = "abc".copy();
          s = new string[3]; }
        if ((int)HeapAudit.reportLeaks() != heapBase) return 3419;

        // A view stored into a struct field keeps its block alive for the field: the reassignment
        // releases nothing and scope exit frees only the new block. The escaped block is still the
        // pre-existing field-escape leak (+1). Pre-fix HEAD freed it under the field (UAF, 2 read).
        vrDtors = 0;
        int held = 0;
        {
            VrH h;
            VrS[] v = new VrS[3];
            v[0].v = 11;
            h.items = v;
            v = new VrS[2];
            held = h.items[0].v;
            mid = vrDtors;
        }
