    if (t27ptr.arithmetic_value(e << 2) != 104) return 4;
    if (t27ptr.arithmetic_value(le >> 1) != 300) return 5;
    return 0;
}

// SRCTYPE round 4: free C++ operators take the sizeof / bitwise identity of their operand.
// Expected values are clang++ -std=c++20 results for the same expressions.
int srctypeRound4Legs()
{
    t27ptr.ArithmeticX x = default;
    ulong ul = 6; long l = 3; uint u = 6; long l2 = 5; char ch = 3; bool bo = true;
    t27ptr.T58Long le = t27ptr.T58LA;
    t27ptr.T58Plain e = t27ptr.T58A;
    long op4 = (ul | 1) - x;
    if (op4 != 807) return 27301;
    if const (__WINDOWS__)
    {
        // LLP64: size_t is unsigned long long, so long and unsigned long tie (clang-cl: ambiguous).
        expect_error("no overload of 't27ptr.operator-' matches the given arguments") {
            long op5w = sizeof(int) - x;
        }
        expect_error("no overload of 't27ptr.operator*' matches the given arguments") {
            long op7w = x * sizeof(int);
        }
    }
    else
    {
        long op5 = sizeof(int) - x;
        if (op5 != 804) return 27302;
        long op7 = x * sizeof(int);
        if (op7 != 1004) return 27303;
    }
    // size_t is unsigned long on LP64 (code 4), unsigned long long on LLP64 (code 14); u ^ l is
    // long on LP64 (code 3) but unsigned long on LLP64, where long cannot hold every unsigned.
    int sizeCode = 4;
    int xorCode = 3;
    if const (__WINDOWS__) { sizeCode = 14; xorCode = 4; }
    // Auto locals keep the C++ identity of their source when they reach a C++ template.
    auto q1 = sizeof(int);
    if (t27ptr.arithmetic_value(q1) != sizeCode * 100 + 4) return 27304;
    auto q2 = l << 1;
    if (t27ptr.arithmetic_value(q2) != 306) return 27305;
    auto q3 = u ^ l;
    if (t27ptr.arithmetic_value(q3) != xorCode * 100 + 5) return 27306;
    auto q4 = l & ul;
    if (t27ptr.arithmetic_value(q4) != 402) return 27307;
    auto q5 = sizeof(long) + 1;
    if (t27ptr.arithmetic_value(q5) != sizeCode * 100 + (int)sizeof(long) + 1) return 27308;
    auto q6 = ul | 1;
    if (t27ptr.arithmetic_value(q6) != 407) return 27309;
    auto q7 = l + 1;
    if (t27ptr.arithmetic_value(q7) != 304) return 27310;
    auto q8 = ch + ch;
    if (t27ptr.arithmetic_value(q8) != 106) return 27311;
    auto q9 = bo ? l : l2;
    if (t27ptr.arithmetic_value(q9) != 303) return 27312;
    auto q10 = le | 1;
    if (t27ptr.arithmetic_value(q10) != 301) return 27313;
    auto q11 = e << 2;
    if (t27ptr.arithmetic_value(q11) != 104) return 27314;
    auto q12 = alignof(long);
    if (t27ptr.arithmetic_value(q12) != sizeCode * 100 + (int)alignof(long)) return 27315;
    // SRCTYPE round 5: the same locals bind a C++ `T&&` as the identity lvalue (clang oracle).
    auto r1 = sizeof(int);
    if (t27ptr.arithmetic_value_ref(r1) != (20 + sizeCode) * 100 + 4) return 27316;
    auto r2 = l << 1;
    if (t27ptr.arithmetic_value_ref(r2) != 2306) return 27317;
    auto r3 = u ^ l;
    if (t27ptr.arithmetic_value_ref(r3) != (20 + xorCode) * 100 + 5) return 27318;
    if (t27ptr.arithmetic_bump_ref(r1) != (20 + sizeCode) * 100 + 5 || r1 != 5) return 27319;
    // CVAMB: clang-accepted siblings of a reference and a by-value overload (fixtures in cpp_mix11_ctor.hpp).
    // A const& / && overload wins only where clang gives it a binding the by-value one lacks.
    CvaV cvaLv = 1;
    const CvaV cvaCv = 2;
    CvaD cvaDv = 3;
    CvaM cvaMo = 4;
    if (cva_b(cvaCv) != 2 || cva_b(CvaV(6)) != 2) return 69101;
    if (cva_b(move cvaLv) != 2) return 69102;
    CvaV cvaLv2 = 7;
    if (cva_c(cvaLv2) != 2 || cva_c(cvaDv) != 2) return 69103;
    if (cva_d(cvaLv2) != 1 || cva_d(cvaCv) != 1 || cva_d(CvaV(6)) != 2) return 69104;
    CvaV cvaLv3 = 8;
    if (cva_d(move cvaLv3) != 2) return 69105;
    CvaV cvaLv4 = 9;
    if (cva_e(cvaLv4, 1) != 1 || cva_f(cvaLv4, 1) != 2) return 69107;
    if (cva_g(cvaLv4) != 1 || cva_g(CvaV(6)) != 1 || cva_g(cvaDv) != 3) return 69108;
    if (cva_h(cvaLv4) != 2 || cva_h(cvaDv) != 3) return 69109;
    if (cvaMo.mb(cvaCv) != 2 || cvaMo.mb(CvaV(6)) != 2) return 69110;
    if (cvaMo.mb(move cvaLv4) != 2) return 69111;
    // Fixed-array brace sinks select the same constructors as std::move in C++20.
    cppi.xv_reset();
    {
        cppi.XvTrivialTemplate arrSrc = cppi.XvTrivialTemplate(9);
        cppi.XvTrivialTemplate* arrSrcPtr = &arrSrc;
        cppi.XvTrivialTemplate[1] arrDst = {move arrSrc};
        if (arrDst[0].v != 109 || arrSrcPtr->v != -1 || cppi.xv_move_count() != 1) return 70421;
    }
    cppi.xv_reset();
    {
        cppi.XvExplicitMove arrSrc = cppi.XvExplicitMove(9);
        cppi.XvExplicitMove* arrSrcPtr = &arrSrc;
        cppi.XvExplicitMove[1] arrDst = {move arrSrc};
        if (arrDst[0].v != 19 || arrSrcPtr->v != 9 || cppi.xv_copy_count() != 1
            || cppi.xv_move_count() != 0) return 70422;
    }
    // Clang++ -std=c++20: lvalue binds U = XvTrivialTemplate&, so the forwarding ctor runs.
    cppi.xv_reset();
    {
        cppi.XvTrivialTemplate src = cppi.XvTrivialTemplate(9);
        cppi.XvTrivialTemplate* srcPtr = &src;
        cppi.XvTrivialTemplate[1] dst = {src};
        if (dst[0].v != 109 || srcPtr->v != -1 || cppi.xv_move_count() != 1) return 70423;
    }
    // Count/get selects get(int); the ADL case still calls its free begin/end pair.
    rangeadl_counted.reset();
    int rangeadlCountSum = 0;
    {
        rangeadl_counted.Counted counted = rangeadl_counted.Counted();
        for (int value in counted) rangeadlCountSum += value;
    }
    if (rangeadlCountSum != 6 || rangeadl_counted.int_get_calls() != 3
        || rangeadl_counted.unsigned_get_calls() != 0 || rangeadl_counted.born() != 1
        || rangeadl_counted.died() != rangeadl_counted.born()) return 71201;
    rangeadl_adl.reset();
    int rangeadlAdlSum = 0;
    {
        rangeadl_adl.AdlRange adl = rangeadl_adl.AdlRange();
        for (int value in adl) rangeadlAdlSum += value;
    }
    if (rangeadlAdlSum != 13 || rangeadl_adl.begin_calls() != 1
        || rangeadl_adl.end_calls() != 1 || rangeadl_adl.born() != 1
        || rangeadl_adl.died() != rangeadl_adl.born()) return 71202;
    // Hidden friends in an enclosing record are associated for a nested range type.
    int rangeadlNestedPlainSum = 0;
    {
        rangeadl_nested.PlainOuter.Inner nested = rangeadl_nested.PlainOuter.Inner();
        for (int value in nested) rangeadlNestedPlainSum += value;
    }
    if (rangeadlNestedPlainSum != 3) return 71203;
    // The enclosing-record lookup also sees hidden friend function templates.
    int rangeadlNestedTemplateSum = 0;
    {
        rangeadl_nested.TemplateOuter.Inner nested = rangeadl_nested.TemplateOuter.Inner();
        for (int value in nested) rangeadlNestedTemplateSum += value;
    }
    if (rangeadlNestedTemplateSum != 9) return 71204;
    // A global-namespace enclosing record is associated for a nested range type.
    int rangeadlGlobalNestedSum = 0;
    {
        RangeAdlGlobalOuter.Inner nested = RangeAdlGlobalOuter.Inner();
        for (int value in nested) rangeadlGlobalNestedSum += value;
    }
    if (rangeadlGlobalNestedSum != 3) return 71205;
    return 0;
}
