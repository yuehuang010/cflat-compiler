        // new is hidden. A throwing constructor frees through the base's class delete (no own delete).
        t320New = 0;
        cppon.reset();
        T320D* t320a = new T320D(4);
        if (t320a->z != 4 || t320New != 1 || cppon.clsNew() != 0) return 3367;
        delete t320a;
        if (cppon.clsDel() != 1) return 3397;
        t320New = 0;
        cppon.reset();
        T320D* t320b = new T320D();
        delete t320b;
        if (t320New != 1 || cppon.clsNew() != 0 || cppon.clsDel() != 1) return 3369;
        t320New = 0;
        cppon.reset();
        if (cppunw.guarded(T320Throw, 1) != -7 || t320New != 1 || cppon.clsNew() != 0
            || cppon.clsDel() != 1) return 3386;
        t320New = 0;
        cppon.reset();
        T320D* t320c = new T320D;
        delete t320c;
        if (t320New != 1 || cppon.clsNew() != 0 || cppon.clsDel() != 1) return 3389;
        // T320: E's own operator delete frees the block it was given; the base's new allocated it.
        t320Del = 0;
        cppon.reset();
        T320E* t320e = new T320E(3);
        if (t320e->z != 3 || cppon.clsNew() != 1) return 3387;
        delete t320e;
        if (t320Del != 1 || cppon.clsDel() != 0) return 3398;
        t320Del = 0;
        cppon.reset();
        if (cppunw.guarded(T320EThrow, 1) != -7 || t320Del != 1 || cppon.clsNew() != 1
