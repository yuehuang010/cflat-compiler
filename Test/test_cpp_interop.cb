    //   `(*h.p).get()`  -> compiler SIGTRAP (exit 133), no diagnostic: void* has no sized pointee
    //   `h.p->get()`    -> "the function 'p' is not known." - 'p' fell through to a free-fn lookup
    //   `h.p->v`        -> "Undefined variable v." - the chain lost its receiver entirely
    // Each leg below therefore fails on master either by trap or by refusing to compile, and
    // asserts the VALUE the C++ side sees.
    cppi.ptrmem.Leaf pmLeaf = default;
    pmLeaf.v = 7;
    cppi.ptrmem.Poly pmBase = default;
    cppi.ptrmem.Holder pmH = cppi.ptrmem.Holder(&pmLeaf, &pmBase);

    // The three spellings of a call through the pointer member. `.` forwards through a pointer
    // per the operator-dot ruling, so all three mean the same call.
    if ((*pmH.p).get() != 7)                                                return 2000;
    if (pmH.p->get() != 7)                                                  return 2001;
    if (pmH.p.get() != 7)                                                   return 2002;
    if (pmH.p?.get() != 7)                                                  return 2003;
    if ((pmH.p)->get() != 7)                                                return 2004;
    // The by-value member is the anchor: it chained before the fix and must still chain.
    if (pmH.byval.get() != 7)                                               return 2005;

    // Data-member read through the pointer member, and a WRITE that the C++ side reads back.
    if (pmH.p->v != 7)                                                      return 2006;
    if (pmH.p.v != 7)                                                       return 2007;
    pmH.p->v = 9;
    if (cppi.ptrmem.read_leaf(pmH.p) != 9 || pmLeaf.v != 9)                    return 2008;
    pmH.p->set(7);
    if (pmLeaf.v != 7)                                                      return 2009;
    // Subscript on the pointer member (index 0 is the pointee itself).
    if (pmH.p[0].v != 7)                                                    return 2010;

    // A const-qualified pointee and a REFERENCE member reach the same path.
    if (pmH.cp->get() != 7 || pmH.cp.get() != 7)                               return 2011;
    if (pmH.r.get() != 7 || pmH.r->get() != 7)                                 return 2012;

    // VIRTUAL dispatch through a pointer member: the derived override must run, so a leg that
    // resolved statically to Poly::who would answer 1 for both.
    cppi.ptrmem.Holder pmHd = cppi.ptrmem.Holder(&pmLeaf, cppi.ptrmem.make_derived());
    if (pmHd.poly->who() != 2)                                              return 2013;
    if (pmH.poly->who() != 1)                                               return 2014;

    // Chained hops: a pointer member whose pointee has its own pointer member, the holder
    // reached through a CFlat pointer, and the holder returned BY REFERENCE from C++.
    cppi.ptrmem.Outer pmO = cppi.ptrmem.Outer(&pmH);
    if (pmO.h->p->get() != 7)                                               return 2015;
    cppi.ptrmem.Holder* pmHp = &pmH;
    if (pmHp->p->get() != 7)                                                return 2016;
    if (cppi.ptrmem.holder_ref().p->get() != 61)                               return 2017;

    // Collision axis: a free function named 'p' is in scope (see the file-scope declaration).
    // The MEMBER must win; pre-fix this leg reported "no overload of 'p' matches" instead.
    if (pmH.p->get() != 7 || p(1) != 101)                                      return 2018;

    // Accept-set anchor: the CFlat-struct holder of the same pointer type worked pre-fix and
    // must be unchanged, in all three spellings.
    PtrMemCflatHolder pmCf = default;
    pmCf.p = pmH.p;
    if (pmCf.p->get() != 7 || pmCf.p.get() != 7 || (*pmCf.p).get() != 7)       return 2019;
    // A pointer LOCAL bound off the member (the spelling that already worked) still works.
    cppi.ptrmem.Leaf* pmLocal = pmH.p;
    if (pmLocal->get() != 7)                                                return 2020;
    // Reseating the pointer member retargets the call.
    cppi.ptrmem.Leaf pmOther = default;
    pmOther.v = 3;
    pmH.p = &pmOther;
    if (pmH.p->get() != 3 || pmLeaf.v != 7)                                    return 2021;

    // ---- a CFlat scalar bound to a `const T&` parameter of a FREE function -----------------
    // The free-function binding path keeps a C++ reference parameter in the pointer-ABI shape
    // (Pointer + IsAlias), so ParameterIsAliasByPointer is false for it and the member path's
    // materialization never ran. An argument WITH storage of the exact width was handed over
    // (legs 1990) and everything else either segfaulted on an `inttoptr` of the value or was
    // refused by overload resolution.

    // No address at all: a literal was refused ("no overload ... matches").
    if (cppi.crefscalar.take_cint(41) != 42)                                   return 1980;
    // A FOLDED constant: `inttoptr (i64 41 to ptr)`, then exit 139.
    if (cppi.crefscalar.take_cint(cppi.crefscalar.Folded.k) != 42)             return 1981;
    // A scoped-enum constant through an explicit cast: same `inttoptr`, exit 139.
    if (cppi.crefscalar.take_cint((int)cppi.crefscalar.Scoped.Nine) != 10)     return 1982;
    // An arithmetic expression: `inttoptr i64 %sum`, exit 139.
    int crefBase = 40;
    if (cppi.crefscalar.take_cint(crefBase + 1) != 42)                         return 1983;
    // A NARROWER lvalue: refused, because only the identical spelling scored. The temporary
    // must hold the referent's width - a 1-byte buffer read back as `int` is garbage.
    char crefNarrow = 41;
    if (cppi.crefscalar.take_cint(crefNarrow) != 42)                           return 1984;
    // `const bool&` from a literal: refused (arg=i1, param=bool*).
    if (cppi.crefscalar.take_cbool(true) != 5)                                 return 1985;
    // `const double&` from a floating literal: refused.
    if (cppi.crefscalar.take_cdouble(21.0) != 42)                              return 1986;
    // `const long long&` from an int literal: refused, though the by-value spelling took it.
    if (cppi.crefscalar.take_clonglong(40) != 42)                              return 1987;

    // The ADDRESS the callee receives, not just the value: an exact-width lvalue must hand over
    // its OWN slot (no copy), and a literal must get a temporary that is a different object.
    int crefOwn = 41;
    u64 crefOwnAddr = (u64)(&crefOwn);
    if (cppi.crefscalar.addr_cint(crefOwn) != crefOwnAddr)                     return 1988;
    if (cppi.crefscalar.addr_cint(41) == crefOwnAddr)                          return 1989;

    // Accept-set anchors - these all bound correctly before the change and must not regress:
    // an exact-width local, a `const` local, an unscoped enum constant (which has a global
    // slot), a `bool` local, a `double` local, and a `const T&` whose T is a CLASS.
    const int crefConst = 41;
    bool crefBool = true;
    double crefDbl = 21.0;
    cppi.crefscalar.Box crefBox = default;
    crefBox.v = 42;
    if (cppi.crefscalar.take_cint(crefOwn) != 42
        || cppi.crefscalar.take_cint(crefConst) != 42
        || cppi.crefscalar.take_cint(cppi.crefscalar.PlainSeven) != 8
        || cppi.crefscalar.take_cbool(crefBool) != 5
        || cppi.crefscalar.take_cdouble(crefDbl) != 42
        || cppi.crefscalar.take_cbox(crefBox) != 45)                           return 1990;
    // A NON-const `int&` keeps taking an addressable lvalue and writing through it.
    int crefWrite = 41;
    if (cppi.crefscalar.take_ncint(crefWrite) != 42 || crefWrite != 42)        return 1991;

    // Two `const T&` candidates of different referent WIDTHS in one overload set. A reference
    // parameter has no integer identity of its own, so the referent supplies it: `const int&`
    // is identity-exact for an `int` and beats the `const long long&` widening, in BOTH
    // declaration orders. Before this ranking, declaration order decided - rk2 (`const int&`
    // first) returned the long long leg's 4041 for every int-shaped argument, while rk3 (the
    // same pair declared the other way) happened to return 3041.
    char crefRankChar = 41;
    i64 crefRankWide = 41;
    if (cppi.crefscalar.rk2(41) != 3041 || cppi.crefscalar.rk3(41) != 3041)    return 1992;
    if (cppi.crefscalar.rk2(crefRankChar) != 3041
        || cppi.crefscalar.rk3(crefRankChar) != 3041)                          return 1993;
    if (cppi.crefscalar.rk2(cppi.crefscalar.src_int()) != 3041
        || cppi.crefscalar.rk3(cppi.crefscalar.src_int()) != 3041)             return 1994;
    // The wide argument must still pick the wide referent - the ranking re-ranks, never widens.
    if (cppi.crefscalar.rk2(crefRankWide) != 4041
        || cppi.crefscalar.rk3(crefRankWide) != 4041)                          return 1995;

    // The referent identity ranks const-ref candidates against EACH OTHER; it must not make one
    // a PERFECT match. An exact by-value overload scores 0 and still wins - feeding the identity
    // through without this made `mixv(41)` ambiguous between `int` and `const int&`.
    if (cppi.crefscalar.mixv(41) != 1041)                                      return 1996;
    // A true `T&&` arm also scores 0, so a literal keeps binding the MOVE leg, not the copy -
    // choosing `const int&` here would silently pick a copy over a move.
    if (cppi.crefscalar.mixr(41) != 241)                                       return 1997;
    // RULING: a const-ref materialization is strictly WORSE than a by-value or rvalue-ref bind
    // at the SAME conversion, so it never wins a tie and CFlat keeps master's by-value pick
    // instead of C++'s ambiguity. A `char` local promotes to `int` for both candidates; feeding
    // the referent identity without the penalty made this pair ambiguous.
    char crefMixChar = 41;
    if (cppi.crefscalar.mixv(crefMixChar) != 1041)                             return 1998;
    // A FLOATING referent has no integer identity, so only the materialization tie-break can
    // order this pair - and it must give the same answer in both declaration orders.
    if (cppi.crefscalar.dv(21.0) != 1021 || cppi.crefscalar.dw(21.0) != 1021)  return 1999;
    // Ranking still runs FIRST: an identity-exact `const int&` beats a by-value `long long`
    // that would have to widen the literal, in both orders. Master picked the widening only
    // because the const-ref candidate did not bind at all.
    if (cppi.crefscalar.lv(41) != 2041 || cppi.crefscalar.lw(41) != 2041)      return 2022;
    // `move` is how CFlat spells "bind the rvalue-ref leg" for a named local; the move leg wins.
    int crefMixMove = 41;
    if (cppi.crefscalar.mixr(move crefMixMove) != 241)                         return 2023;

    // ---- M103: file-scope globals of a C++ class (2150-2199) ------------------------------------
    // Total constructor count over every global declared above: 1 + 1 + 1 + 1 + 3 + 4 + 1 + 1 = 13
    // GTrk/GPoly constructions. Pre-fix this read 0 - none of them was ever constructed. The
    // counters are private to the global section and are never reset(), so the count survives
    // every reset() the earlier sections do.
    if (cppa.gctor_count() != 13)                                              return 2150;
    // The constructor's invariant (v = 7) is what a zeroinitializer destroys; each spelling is
    // asserted separately because each reaches a different declarator arm.
    if (gclsSingle.v != 7)                                                     return 2151;
    if (gclsBare.v != 7)                                                       return 2152;
    if (gclsBrace.v != 7)                                                      return 2153;
    if (gclsStatic.v != 7)                                                     return 2154;
    if (GctNS.gclsNs.v != 7)                                                   return 2155;
    // Global ARRAY: every element, not just the first, and through both dimensions.
    if (gclsArr3[0].v != 7 || gclsArr3[1].v != 7 || gclsArr3[2].v != 7)        return 2156;
    if (gclsArr22[0][0].v != 7 || gclsArr22[1][1].v != 7)                      return 2157;
    // A virtual call on the global: pre-fix the vptr was zero and this segfaulted.
    cppa.GPoly* gclsPolyP = &gclsPoly;
    if (gclsPoly.v != 5 || gclsPolyP.kind() != 11)                             return 2158;
    /*
     * ORDER, on the GSeq globals' own counter. Three constructions: the one in the IMPORTED
     * module cpp_interop_globals.cb records 1, then this file's two record 2 and 3. So an
     * imported module's globals are constructed before the importing module's, and within a
     * module in declaration order. Pre-fix all three read 0; on 1b082dc9 (which registered one
     * llvm.global_ctors entry per module and let the loader pick the order) the AOT image ran
     * this file's entry FIRST and gave 3/1/2, while --run gave 1/2/3 - the two disagreed.
     */
    if (gclsImportedSeqIndex() != 1)                                           return 2159;
    if (gclsSeqA.v != 2 || gclsSeqB.v != 3)                                     return 2162;
    /*
     * ORDER against CLANG's own initializers: gclsProbe's constructor reads the header-defined
     * namespace-scope C++ static cppa.g_reg, which Clang initializes from the companion module's
     * own llvm.global_ctors entry. Every such entry now runs before any cflat one, from a single
     * driver, so this reads 4242 under BOTH an AOT image and --run. Pre-fix it read 0 on both;
     * on 1b082dc9 it read 4242 under AOT and 0 under --run.
     */
    if (gclsProbe.saw != 4242 || cppa.g_reg.magic != 4242)                      return 2160;
    // RULING: globals are NOT destroyed at exit, so nothing has run a destructor by now. This
    // also fails if a global_dtors/atexit entry were ever added.
    if (cppa.gdtor_count() != 0)                                               return 2161;

    // ---- C++ FREE OPERATOR TEMPLATES ------------------------------------------------------
    // libc++ declares every basic_string binary operator as a free FUNCTION TEMPLATE over
    // basic_string<CharT, Traits, Alloc>. Pre-fix none was published or instantiated for a
    // concrete operand pair, so every leg here failed to compile: "no operator 'X' for type
    // 'std.string'", or "no overload of 'operator+' matches the given arguments" when the left
    // operand was a literal.
    std.string fopA = std.string("hello");
    std.string fopB = std.string(" world");
    std.string fopCat = fopA + fopB;
    char* fopCatP = fopCat.c_str();
    if ((int)fopCat.size() != 11)                                              return 2100;
    if (fopCatP[0] != 'h' || fopCatP[5] != ' ' || fopCatP[10] != 'd')          return 2101;
    // A string LITERAL on either side reaches the `const CharT*` overloads of the same template.
    std.string fopRight = fopA + " there";
    char* fopRightP = fopRight.c_str();
    if ((int)fopRight.size() != 11 || fopRightP[5] != ' ' || fopRightP[10] != 'e') return 2102;
    std.string fopLeft = "say " + fopA;
    char* fopLeftP = fopLeft.c_str();
    if ((int)fopLeft.size() != 9 || fopLeftP[0] != 's' || fopLeftP[4] != 'h')  return 2103;
    // Equality, both operand orders and both answers.
    std.string fopSame = std.string("hello");
    if (!(fopA == fopSame) || fopA == fopB)                                    return 2104;
    if (fopA != fopSame || !(fopA != fopB))                                    return 2105;
    if (!(fopA == "hello") || fopA == "hellp")                                 return 2106;
    if (!("hello" == fopA) || "hellp" == fopA)                                 return 2107;
    // The four relational operators. libc++ at C++20 declares only == and <=> for basic_string,
    // so these are the REWRITTEN forms; the ordering arrives as a one-byte blob and is read by
    // the spaceship rewrite. "hello" < " world" is false - ' ' (32) sorts below 'h' (104).
    if (!(fopB < fopA) || fopA < fopB)                                         return 2108;
    if (!(fopA > fopB) || fopB > fopA)                                         return 2109;
    if (!(fopB <= fopA) || !(fopA <= fopSame) || fopA <= fopB)                 return 2110;
    if (!(fopA >= fopB) || !(fopA >= fopSame) || fopB >= fopA)                 return 2111;
    // The result of the operator used as a CONDITION, and passed to a C++ function.
    int fopIf = 0;
    if (fopA + fopB == std.string("hello world")) { fopIf = 7; }
    if (fopIf != 7)                                                            return 2112;
    std.string fopNum1 = std.string("1");
    std.string fopNum2 = std.string("2");
    if (std.stoi(fopNum1 + fopNum2) != 12)                                     return 2113;
    // The compound MEMBER operator was already bound; it must stay bound (pre-fix: 5 / 4).
    std.string fopPlusEq = std.string("hi");
    fopPlusEq += " ho";
    if ((int)fopPlusEq.size() != 5)                                            return 2114;
    std.string fopPlusEq2 = std.string("hi");
    fopPlusEq2 += fopNum1;
    if ((int)fopPlusEq2.size() != 3)                                           return 2115;

    // The same binding on a class template in a header the fixture owns, so the path is not
    // std::string specific. Each cppfop operator adds its own tag to the result, so a leg tells
    // WHICH overload C++ selected inside the generated wrapper.
    cppfop.Box<int> fopBoxA = cppfop.Box<int>(10);
    cppfop.Box<int> fopBoxB = cppfop.Box<int>(4);
    if ((fopBoxA + fopBoxB).v() != 15)                                         return 2116;
    if ((fopBoxA - fopBoxB).v() != 10)                                         return 2117;
    // A SCALAR operand on either side, requested AFTER the class/class pair above: a wrapper is
    // keyed on the operand pair, so the class/class one must not answer for these (it did while
    // the wrapper registered under the shared "cppfop.operator+" name, returning tag 1).
    if ((fopBoxA + 4).v() != 16)                                               return 2118;
    if ((4 + fopBoxA).v() != 17)                                               return 2119;
    // A second specialization of the same class template gets its own wrapper.
    cppfop.Box<i64> fopBoxW = cppfop.Box<i64>(100);
    cppfop.Box<i64> fopBoxX = cppfop.Box<i64>(7);
    if ((int)(fopBoxW + fopBoxX).v() != 108 || (int)(fopBoxW - fopBoxX).v() != 97) return 2120;
    if (fopBoxA == fopBoxB || !(fopBoxA == cppfop.Box<int>(10)))               return 2121;
    if (!(fopBoxA != fopBoxB) || fopBoxA != cppfop.Box<int>(10))               return 2122;
    if (fopBoxA < fopBoxB || !(fopBoxB < fopBoxA))                             return 2123;
    if (!(fopBoxA > fopBoxB) || fopBoxB > fopBoxA)                             return 2124;
    if (fopBoxA <= fopBoxB || !(fopBoxB <= fopBoxA))                           return 2125;
    if (!(fopBoxA >= fopBoxB) || fopBoxB >= fopBoxA)                           return 2126;
    // cppfop.Ord declares ONLY == and <=> as free templates: != and the four relational
    // operators exist for it solely as C++20 rewrites over the instantiated <=>.
    cppfop.Ord<int> fopOrdA = cppfop.Ord<int>(3);
    cppfop.Ord<int> fopOrdB = cppfop.Ord<int>(9);
    if (!(fopOrdA == cppfop.Ord<int>(3)) || fopOrdA == fopOrdB)                return 2127;
    if (!(fopOrdA != fopOrdB) || fopOrdA != cppfop.Ord<int>(3))                return 2128;
    if (!(fopOrdA < fopOrdB) || fopOrdB < fopOrdA)                             return 2129;
    if (fopOrdA > fopOrdB || !(fopOrdB > fopOrdA))                             return 2130;
    if (!(fopOrdA <= fopOrdB) || fopOrdB <= fopOrdA)                           return 2131;
    if (fopOrdA >= fopOrdB || !(fopOrdB >= fopOrdA))                           return 2132;
    // The operator result ASSIGNED into a live object of the same class.
    cppfop.Box<int> fopAssign = cppfop.Box<int>(0);
    fopAssign = fopBoxA + fopBoxB;
    if (fopAssign.v() != 15)                                                   return 2133;
    // ACCEPT SET: NON-template free operators bound before this change and are untouched by it.
    cppfop.Nt fopNtA = cppfop.Nt(5);
    cppfop.Nt fopNtB = cppfop.Nt(6);
    if ((fopNtA + fopNtB).n() != 21)                                           return 2134;
    if (fopNtA == fopNtB || !(fopNtA == cppfop.Nt(5)))                         return 2135;
    if (!(fopNtA < fopNtB) || fopNtB < fopNtA)                                 return 2136;

    // ---- M104: `explicit` C++ constructors at a call argument (2200-2249) ----------------------
    // Pre-fix every SPELLED leg below already passed; they are the frozen accept set for the
    // rejection added in err_cpp_explicit_ctor.cb, which is where the discrimination lives.
    // The spelled form of an explicit constructor stays legal at every argument position.
    if (cppexp.take_ex(cppexp.Ex(5)) != 5)                                     return 2200;
    if (cppexp.take_ex_cref(cppexp.Ex(5)) != 5)                                return 2201;
    if (cppexp.take_ex_rref(cppexp.Ex(5)) != 5)                                return 2202;
    cppexp.ExHost excHost = cppexp.ExHost(3);
    if (excHost.member_take(cppexp.Ex(5)) != 8)                                return 2203;
    if (cppexp.ExHost.static_take(cppexp.Ex(5)) != 50)                         return 2204;
    if (cppexp.take_ex_two(cppexp.Ex(5), 2) != 7)                              return 2205;
    // An explicit ctor with a DEFAULTED second parameter, spelled with one and with two args.
    if (cppexp.take_exdef(cppexp.ExDef(5)) != 12)                              return 2206;
    if (cppexp.take_exdef(cppexp.ExDef(5, 1)) != 6)                            return 2207;
    // A class with BOTH an explicit and a non-explicit constructor: each spelled form picks its
    // own arity, so a collapse onto one of them is visible in the value.
    if (cppexp.take_both(cppexp.Both(5)) != 5)                                 return 2208;
    if (cppexp.take_both(cppexp.Both(1, 2)) != 102)                            return 2209;
    // A free operator's OPERAND, spelled.
    cppexp.Ex excNine = cppexp.Ex(9);
    if (excNine - cppexp.Ex(5) != 4)                                           return 2210;
    // A C++ CONSTRUCTOR parameter of class type, spelled.
    cppexp.ExOwner excOwner = cppexp.ExOwner(cppexp.Ex(5));
    if (excOwner.v != 6)                                                       return 2211;
    // An `explicit` COPY constructor still copies: the declaration copy runs it (+1000), and
    // the class binds to a const-reference parameter unchanged.
    cppexp.ExCopy excCopy = cppexp.ExCopy(5);
    cppexp.ExCopy excCopy2 = excCopy;
    if (excCopy2.v != 1005 || cppexp.take_excopy_cref(excCopy) != 5)           return 2212;
    // ACCEPT SET: a NON-explicit converting constructor is still offered at every parameter
    // kind C++ allows - by value, by const reference, by rvalue reference, and through a C++
    // constructor's own parameter. Each function tags its result, so a wrong leg is visible.
    if (cppexp.opt_by_value(0.5) != 50)                                        return 2213;
    if (cppexp.opt_by_cref(0.5) != 51)                                         return 2214;
    if (cppexp.opt_by_rref(0.5) != 52)                                         return 2215;
    cppexp.OptOwner excOptOwner = cppexp.OptOwner(0.5);
    if (excOptOwner.v != 57)                                                   return 2216;
    std.vector<int> excParams = default;
    excParams.push_back(1);
    cppexp.Optim excOptim = cppexp.Optim(excParams, 0.5);
    if (excOptim.v != 1050)                                                    return 2217;
    cppexp.OptimCref excOptimCref = cppexp.OptimCref(excParams, 0.5);
    if (excOptimCref.v != 2050)                                                return 2218;
    cppexp.Options excOpt = cppexp.Options(0.9);
    if (excOpt - 0.5 != 40)                                                    return 2219;
    // ACCEPT SET for the non-const-reference half of the rule: a NAMED Options lvalue binds to a
    // non-const `Options&` parameter, free and member, exactly as before. Only the CONVERSION of
    // a bare double into such a parameter is refused (err_cpp_explicit_ctor.cb).
    cppexp.Options excLref = cppexp.Options(0.5);
    if (cppexp.opt_by_lref(excLref) != 53)                                     return 2221;
    cppexp.OptHost excOptHost = cppexp.OptHost(4);
    if (excOptHost.member_lref(excLref) != 54)                                 return 2222;
