    if (sizeof(cppref.RefHolder) != cppref.size_ref_holder())   return 1857;
    if (sizeof(cppref.RefDerived) != cppref.size_ref_derived()) return 1858;
    if (sizeof(cppref.TRef<int>) != cppref.size_tref_int())     return 1859;

    cppref.Val refmemV = default; refmemV.a = 3; refmemV.b = 4;
    cppref.ClassRef refmemCr = cppref.ClassRef(&refmemV);      // reference to a CLASS
    if (refmemCr.sum() != 7)                            return 1860;

    int refmemC = 11;
    cppref.ConstRef refmemConst = cppref.ConstRef(&refmemC);   // reference to a const int
    if (refmemConst.get() != 11)                        return 1861;

    int refmemRv = 13;
    cppref.RvalRef refmemRr = cppref.RvalRef(&refmemRv);       // RVALUE reference member
    if (refmemRr.get() != 13)                           return 1862;

    int refmemT = 17;
    int* refmemTp = &refmemT;
    cppref.PtrRef refmemPr = cppref.PtrRef(&refmemTp);         // reference to a POINTER
    if (refmemPr.get() != 17)                           return 1863;

    // ACCEPT SET: RefDerived has a base, so it took the FLATTENED field walk and already bound
    // before the fix. These three legs pin that the flatten path is unchanged.
    int refmemB = 19;
    cppref.RefDerived refmemDer = cppref.RefDerived(&refmemB, 3);   // reference member in a BASE
    if (refmemDer.total() != 22)                        return 1864;
    if (refmemDer.extra != 3 || *refmemDer.r != 19)        return 1865;
    if (refmemDer.base_get() != 19)                     return 1866;

    int refmemG = 21;
    cppref.TRef<int> refmemTr = cppref.TRef<int>(&refmemG);    // class TEMPLATE with a `T&` member
    if (refmemTr.get() != 21)                           return 1867;
    refmemTr.set(23);
    if (refmemG != 23)                                  return 1868;

    int refmemE1 = 4; int refmemE2 = 6;                                    // array of such records
    cppref.RefHolder[2] refmemArr = { cppref.RefHolder(&refmemE1), cppref.RefHolder(&refmemE2) };
    if (refmemArr[0].get() != 4 || refmemArr[1].get() != 6) return 1869;

    // ---- a C++ field whose type is a CLASS ------------------------------------------------------
    // Pre-fix every leg below failed to COMPILE ("Undefined variable ..." / "no overload of
    // ... matches the given arguments"), because the field was laid out as opaque bytes.
    cppf.Named clsfieldNamed = default;                        // accept-set: named top-level class
    if (clsfieldNamed.pl.p != 3) return 1830;
    if (clsfieldNamed.pl.dbl() != 6) return 1831;
    if (clsfieldNamed.get() != 3) return 1832;

    cppf.Outer clsfieldOuter = default;                        // nested member class, by value
    if (clsfieldOuter.in.x != 21 || clsfieldOuter.tail != 1) return 1833;
    if (clsfieldOuter.in.twice() != 42) return 1834;
    clsfieldOuter.in.x = 4;
    if (clsfieldOuter.in.twice() != 8) return 1835;
    cppf.Outer.Inner clsfieldInner = default;                  // the nested class on its own
