struct LdInteropBox<T> { T value = default; };
T ldInteropIdentity<T>(T value) { return value; }

int testLongDoubleNativeInterop()
{
    // Native long double has double's representation and its own C++ type identity.
    long double ldWords = 1.5;
    longdouble ldAlias = 2.25;
    long double ldSum = ldWords + ldAlias;
    long double ldMixed = ldSum + 1.0f + 1;
    if (ldSum != 3.75 || ldMixed != 5.75) return 3500;
    if (!(ldWords < ldAlias) || !(ldAlias > 2.0)) return 3501;
    long double ldDoubleMix = ldWords + 2.0;
    if (ldDoubleMix != 3.5 || !(ldWords < 2.0) || !(ldWords < 2.0f)
        || !(ldWords < 2)) return 3507;
    double ldAsDouble = ldWords;
    long double ldFromDouble = ldAsDouble;
    if (ldAsDouble != 1.5 || ldFromDouble != 1.5) return 3502;
    tuple<long double, int> ldTuple = default;
    ldTuple.item_0 = 2.5;
    ldTuple.item_1 = 7;
    simd<long double, 4> ldSimd = 2.5;
    list<long double> ldList = default;
    ldList.add(3.5);
    if (ldTuple.item_0 != 2.5 || ldTuple.item_1 != 7 || ldSimd[2] != 2.5
        || ldList.get(0) != 3.5) return 3508;
    LdInteropBox<long double> ldBox = default;
    ldBox.value = ldInteropIdentity<longdouble>(3.25);
    if (ldInteropRoundTrip(2.75) != 2.75 || ldBox.value != 3.25) return 3509;
    if (strcmp(typeof(ldWords), "long double") != 0
        || strcmp(typeof(ldAlias), "long double") != 0
        || strcmp(typeof(cppi.ld_add(ldWords, ldAlias)), "long double") != 0) return 3503;
    if (cppsop.typeCodeOf(ldWords) != 19 || cppsop.typeCodeOf(ldAlias) != 19) return 3504;
    if (cppi.ld_add(ldWords, ldAlias) != 3.75) return 3505;
    auto ldReturned = cppi.ld_add(1.25, 2.5);
    if (typeof(ldReturned) != "long double" || cppsop.typeCodeOf(ldReturned) != 19) return 3506;
    return 0;
}

