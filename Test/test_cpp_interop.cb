        cppon.Plain* onSz = new cppon.Plain[3];
        delete[3] onSz;
        bool onSizedOk = cppunw.newArrs() == cppunw.deleteArrs() && cppon.dtors() == 3;
        cppunw.reset();
        cppon.reset();
        cppon.Plain* onRaw = new cppon.Plain[2];
        delete[_] onRaw;                                                  // frees, runs no dtor
        if (!onSizedOk || cppunw.newArrs() != cppunw.deleteArrs() || cppunw.deletes() != 0
            || cppon.dtors() != 0 || (int)HeapAudit.reportLeaks() != heapBase) return 3359;
        cppunw.reset();
        cppon.reset();
        if (OnViewScope(1) != 8 || cppunw.newArrs() != cppunw.deleteArrs()
            || cppon.dtors() != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3360;
        // `new Cls[n]` looks up operator new[] only: the class's operator new never applies.
        cppunw.reset();
        cppon.reset();
        cppon.Cls[] onCa = new cppon.Cls[2];
        onV = onCa[1].get();
        delete onCa;
        if (onV != 7 || cppon.clsNew() != 0 || cppon.clsDel() != 0
            || cppunw.newArrs() != cppunw.deleteArrs() || cppon.dtors() != 2) return 3361;
        // The class's own operator new[] / sized delete[] (size = n * sizeof).
        cppunw.reset();
        cppon.reset();
        cppon.Arr[] onAa = new cppon.Arr[3];
        onV = onAa[2].get();
        delete onAa;
        if (onV != 3 || cppon.clsNewArr() != 1 || cppon.clsDelArr() != 1 || cppon.clsNew() != 0
            || cppunw.newArrs() != 0 || cppon.dtors() != 3) return 3362;
        // A polymorphic element array: n destructors, never element 0's deleting destructor.
        cppunw.reset();
        cppon.reset();
        cppon.Poly[] onPa = new cppon.Poly[2];
        onV = onPa[1].get();
        delete onPa;
        if (onV != 1 || cppon.clsDel() != 0 || cppunw.newArrs() != cppunw.deleteArrs() || cppon.dtors() != 2
            || cppon.live() != 0) return 3363;
