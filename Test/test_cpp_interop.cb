// T93: a static local whose C++ initializer throws stays incomplete, so the next entry retries it.
int T93ThrowAuto(int a) { static auto g = t93s.Once(a); return g.get(); }
int T93ThrowExplicit(int a) { static t93s.Once g = t93s.Once(a); return g.get(); }
