    if (virtS.area() != 49)                        return 430;   // Square::area, side 7
    cpppoly.destroy(virtS);                        // released on the C++ side
    if (cpppoly.square_dtors() != 1)             return 431;

    // Object constructed BY CFLAT on the stack: the C++ constructor writes the vptr, so the same
    // virtual dispatch works, and scope exit runs the derived destructor.
    cpppoly.reset_poly_counts();
    {
        cpppoly.Circle virtStack = default;
        if (virtStack.radius != 5)                 return 432;
        if (virtStack.tag != 2)                    return 433;
        // Shape::plain is INHERITED: it is registered on Circle too, with `this` retyped.
        if (virtStack.plain() != 102)              return 452;
        if (virtStack.area() != 50)                return 453;   // Circle's own override, direct
        cpppoly.Shape* virtBase = &virtStack;
        if (virtBase.area() != 50)                 return 434;
        if (virtBase.tag != 2)                     return 435;
    }
    if (cpppoly.circle_dtors() != 1)             return 436;
    if (cpppoly.shape_dtors() != 1)              return 437;

    // Object constructed BY CFLAT on the heap, then released through a BASE pointer.
    cpppoly.reset_poly_counts();
    cpppoly.Square* virtHeap = new cpppoly.Square();
    if (virtHeap.area() != 49)                     return 438;
    cpppoly.Shape* virtHeapBase = move virtHeap;
    if (virtHeapBase.area() != 49)                 return 439;
    delete virtHeapBase;
    if (cpppoly.square_dtors() != 1)             return 440;
    if (cpppoly.shape_dtors() != 1)              return 441;

    // MULTIPLE inheritance. Right is the NON-PRIMARY base of Both, at byte 16, so every
    // Both -> Right crossing must add 16; reading rv is what proves it happened.
    cpppoly.Both virtB = default;
    if (virtB.lv != 33)                            return 442;   // inherited from Left
    if (virtB.rv != 44)                            return 443;   // inherited from Right
    if (virtB.both_only() != 77)                   return 444;
    if (virtB.l() != 1033)                         return 445;   // Both::l overrides Left::l
    if (virtB.r() != 2044)                         return 446;   // Both::r overrides Right::r
    // C++ side takes a Right* and reads rv: wrong adjustment would hand it Left's storage.
    if (cpppoly.read_right(&virtB) != 44)          return 447;
    // C++ side dispatches virtually on that same adjusted pointer and lands on Both::r.
    if (cpppoly.call_right(&virtB) != 2044)        return 448;
    // The adjustment also happens on a STORE, so a saved base pointer is already correct.
    cpppoly.Right* virtR = &virtB;
    if (cpppoly.read_right(virtR) != 44)           return 449;
    if (virtR.rv != 44)                            return 450;
    if (virtR.r() != 2044)                         return 451;   // virtual, through Right's vtable
    // An override of a NON-PRIMARY base virtual, reached through a DERIVED pointer: the slot
    // must come from Both's own vtable (unadjusted this), not from Right's.
    cpppoly.Both* virtBp = &virtB;
    if (virtBp.r() != 2044)                        return 452;
    if (virtBp.l() != 1033)                        return 453;
    if (virtBp.both_only() != 77)                  return 454;

    // ---- class names containing a declarator keyword --------------------------------------------
    // "constant" contains "const" and "classBase" contains "class". Both are NON-PRIMARY bases
    // of QualNames, so a lost class identity shows up as a missing base adjustment.
    cpppoly.QualNames* virtQ = cpppoly.make_qual();
    if (cpppoly.read_constant(virtQ) != 66)        return 455;
    if (cpppoly.read_class_base(virtQ) != 77)      return 456;
    if (virtQ.cv != 66)                            return 457;
    if (virtQ.bv != 77)                            return 458;
    if (virtQ.l() != 3055)                         return 459;   // override of Left::l
    cpppoly.destroy_qual(virtQ);

    // ---- virtual members reached through a clang thunk ------------------------------------------
    /*
     * Under the MS ABI a member introduced by a NON-PRIMARY base sits in a vfptr at a non-zero
     * offset and one reached through a VIRTUAL base sits in a vfptr found through the vbtable;
     * MicrosoftVTableContext reports both as locations cflat cannot index. Most such members are
     * still reachable through the record of the base that DECLARES them, with `this` adjusted -
     * the guard legs below pin that path down, including its exact resource cost, because the
     * fix must not displace it. Two cases have no such fallback and are what the thunk exists
     * for: a DESTRUCTOR (only ever looked up on the class itself) and a COVARIANT return (whose
     * fallback hands back an unadjusted pointer, so it is wrong rather than merely slower).
     *
     * The shapes are TEMPLATE specializations on purpose: a directly named class with virtual
     * bases is refused at layout, so a specialization - held as a sized blob - is the only
     * spelling whose members reach the vtable-slot gate at all.
     */
    // Built on the C++ side: cflat cannot construct a class with virtual bases, and what is
    // under test here is the dispatch into one, not the construction of one.
    cpppoly.TwoSlots<int>* thunk = cpppoly.make_two_slots();
    // GUARD legs: these bind through the declaring base's record and already worked. They are
    // here so a wider thunk trigger, which would displace that path, fails loudly.
    if (cpppoly.read_slot(thunk) != 33)            return 1000;
    if (cpppoly.read_second(thunk) != 44)          return 1001;
    if (thunk.primary() != 1033)                   return 1002;   // primary vfptr, direct slot call
    if (thunk.second() != 2044)                    return 1003;   // non-primary vfptr
    if (thunk.second_add(3, 4) != 78)              return 1004;   // 44 + 3*10 + 4
    if (thunk.second_pure() != 3044)               return 1005;   // pure virtual, overridden

    // GUARD: a by-value class argument costs exactly one copy on BOTH vfptrs. A thunk in this
    // position would add a forwarding move and its destruction, and these counts would change.
    {
        cpppoly.SlotVal thunkV = cpppoly.SlotVal(5);
        cpppoly.reset_slot_counts();
        if (thunk.primary_val(thunkV) != 48)         return 1006;   // 33 + 5*3, primary vfptr
        if (cpppoly.slot_copies() != 1)          return 1007;
        if (cpppoly.slot_moves() != 0)           return 1008;
        if (cpppoly.slot_dtors() != 1)           return 1009;
        cpppoly.reset_slot_counts();
        if (thunk.second_val(thunkV) != 54)          return 1010;   // 44 + 5*2, non-primary vfptr
        if (cpppoly.slot_copies() != 1)          return 1011;
        if (cpppoly.slot_moves() != 0)           return 1012;
        if (cpppoly.slot_dtors() != 1)           return 1013;
    }

    // GUARD: a class RETURN by value is elided straight into the caller's local, on either path.
    cpppoly.reset_slot_counts();
    {
        cpppoly.SlotVal thunkR = thunk.second_ret();
        if (thunkR.v != 49)                        return 1014;   // 44 + 5
        if (cpppoly.slot_ctors() != 1)           return 1015;
        if (cpppoly.slot_copies() != 0)          return 1016;
        if (cpppoly.slot_moves() != 0)           return 1017;
        if (cpppoly.slot_dtors() != 0)           return 1018;
    }
    if (cpppoly.slot_dtors() != 1)               return 1019;
    cpppoly.destroy_two_slots(thunk);

    /*
     * COVARIANT return. The source read is a guard; the clone return and Slot read are independent
     * PRE discriminators for the unadjusted covariant result.
     */
    cpppoly.CloneDer<int>* thunkC = cpppoly.make_clone_der();
    // GUARD: PRE probe passed (exit 0); proves the source CloneDer value is valid.
    if (cpppoly.read_clone(thunkC) != 77)          return 1020;
    cpppoly.CloneDer<int>* thunkC2 = thunkC.clone();
    // DISCRIMINATOR: PRE probe exits 1021 at this read; the covariant result is unadjusted.
    if (cpppoly.read_clone(thunkC2) != 78)         return 1021;
    // DISCRIMINATOR: PRE probe exits 1022 at this read; the same result misses the Slot subobject.
    if (cpppoly.read_slot(thunkC2) != 66)          return 1022;
    cpppoly.destroy_clone(thunkC2);
    cpppoly.destroy_clone(thunkC);

    /*
     * VIRTUAL base. The t() and u() arms are independent PRE guards for existing fallback paths.
     * delete is a PRE discriminator: it leaves vbase_dtors at 0 without the destructor thunk.
     */
    cpppoly.VBaseUse<int>* thunkV2 = cpppoly.make_vbase_use();
    // GUARD: PRE probe passed (exit 0); protects the virtual-base method fallback.
    if (thunkV2.t() != 107)                        return 1023;
    // GUARD: PRE probe passed (exit 0); protects the derived-class virtual call.
    if (thunkV2.u() != 9)                          return 1024;
    cpppoly.reset_vbase_dtors();
    delete thunkV2;
    // DISCRIMINATOR: PRE probe exits 1025; delete leaves vbase_dtors at 0 without the thunk.
    if (cpppoly.vbase_dtors() != 1)              return 1025;

    /*
     * VIRTUAL-BASE CONSTRUCTION. Each constructor of such a class binds to a clang-emitted
     * placement-new thunk, so clang - not cflat - passes the implicit most-derived flag / VTT.
     * Legs marked DISCRIMINATOR are refused outright by the pre-fix binary ("has no default
     * constructor cflat can call"); the GUARD legs are the accept-set the on-demand
     * variadic-constructor wrapper already served and that must keep working.
     */
    // DISCRIMINATOR: PRE binary refuses this declaration; the dtor count proves one object.
    cpppoly.reset_vbase_dtors();
    {
        cpppoly.VBaseUse<int> thunkD = default;
        if (thunkD.t() != 107)                     return 1026;   // 7 + 100, through the vbase
        if (thunkD.u() != 9)                       return 1027;
    }
    if (cpppoly.vbase_dtors() != 1)              return 1028;

    // GUARD: an explicit-argument constructor already worked through the wrapper path.
    cpppoly.reset_vbase_dtors();
    {
        cpppoly.VBaseArgs<int> thunkA = cpppoly.VBaseArgs<int>(5);
        if (thunkA.a() != 5)                       return 1029;
        if (thunkA.t() != 107)                     return 1030;
        cpppoly.VBaseArgs<int> thunkA2 = cpppoly.VBaseArgs<int>(11, 12);
        if (thunkA2.t() != 111)                    return 1031;
        if (thunkA2.a() != 12)                     return 1032;
    }
    if (cpppoly.vbase_dtors() != 2)              return 1033;

    // DISCRIMINATOR: the DEFAULT constructor of a class that also declares others.
    cpppoly.reset_vbase_dtors();
    {
        cpppoly.VBaseArgs<int> thunkA3 = default;
        if (thunkA3.a() != 1)                      return 1034;
    }
    if (cpppoly.vbase_dtors() != 1)              return 1035;

    // DISCRIMINATOR: TWO virtual bases. Both vbase subobjects must be reachable and adjusted.
    cpppoly.reset_vbase_dtors();
    {
        cpppoly.VBaseDiamond<int> thunkDm = default;
        if (thunkDm.t() != 13)                     return 1036;   // 3 + 10, first virtual base
        if (thunkDm.s() != 24)                     return 1037;   // 4 + 20, second virtual base
        if (thunkDm.d() != 5)                      return 1038;
        cpppoly.VBaseDiamond<int> thunkDm2 = cpppoly.VBaseDiamond<int>(9);
        if (thunkDm2.d() != 9)                     return 1039;
    }
    if (cpppoly.vbase_dtors() != 2)              return 1040;

    // DISCRIMINATOR: a class DERIVING from one with virtual bases. The most-derived flag is 1
    // for the complete object only, so the vbase is initialized exactly once.
    cpppoly.reset_vbase_dtors();
    {
        cpppoly.VBaseDer<int> thunkDr = default;
        if (thunkDr.t() != 102)                    return 1041;   // tv = 2, +100
        if (thunkDr.a() != 1003)                   return 1042;   // av = 3, +1000
    }
    if (cpppoly.vbase_dtors() != 2)              return 1043;   // ~VBaseDer then ~VBaseArgs

    // DISCRIMINATOR: the HEAP spelling. PRE binary reports "has no constructor taking 1
    // argument(s)" - the `new` site has no wrapper fallback, only the bound constructor list.
    cpppoly.reset_vbase_dtors();
    cpppoly.VBaseArgs<int>* thunkH = new cpppoly.VBaseArgs<int>(5);
    if (thunkH.a() != 5)                           return 1044;
    delete thunkH;
    if (cpppoly.vbase_dtors() != 1)              return 1045;

    // DISCRIMINATOR: as a CFlat struct FIELD. The PRE binary compiles this and segfaults on the
    // first member call, because the field is left unconstructed.
    cpppoly.reset_vbase_dtors();
    {
        ThunkHolder thunkF = default;
        if (thunkF.a.t() != 107)                   return 1046;
        if (thunkF.a.a() != 1)                     return 1047;
    }
    if (cpppoly.vbase_dtors() != 1)              return 1048;

    // ---- header-only C++ (definition emission) --------------------------------------------------
    // Inline free function, and one that calls another inline function: 5*3 + 5*3 = 30.
    if (cppinl.helper(5) != 15)                  return 460;
    if (cppinl.twice(5) != 30)                   return 461;
    // Static local inside an inline body: the guard variable and the slot are emitted too.
    if (cppinl.next_id() != 101)                 return 462;
    if (cppinl.next_id() != 102)                 return 463;
    // Same inline code reached through the SECOND import group: one linked definition, so the
    // static local above keeps counting rather than starting over.
    if (cppinl2.twice_plus(5) != 31)             return 464;
    if (cppinl.next_id() != 103)                 return 465;

    // All-inline nontrivial class. The counters are inline static data members, so reading them
    // proves the companion module supplied their storage as well as the constructor body.
    cppinl.Box.reset();
    {
        cppinl.Box inlB = cppinl.Box(4);
        inlB.add(6);
        if (inlB.get() != 10)                     return 466;
        if (inlB.scaled() != 30)                  return 467;   // inline method calling an inline fn
        if (cppinl.Box.ctors != 1)               return 468;
        if (cppinl.Box.dtors != 0)               return 469;
    }
    if (cppinl.Box.dtors != 1)                   return 470;    // destructor ran exactly once

    // All-inline VIRTUAL hierarchy: no key function exists anywhere, so the vtable itself comes
    // from the companion module. Dispatch through a base pointer is the assertion.
    cppinl.Base.reset_dtors();
    {
        cppinl.Derived inlD = cppinl.Derived(5);
        if (inlD.area() != 25)                    return 471;    // own override, direct call
        if (inlD.plain() != 3)                    return 472;    // inherited inline method
        cppinl.Base* inlBase = &inlD;
        if (inlBase.area() != 25)                 return 473;    // virtual, through the vtable
        if (inlBase.tag_ != 2)                    return 474;    // base field set by Base's ctor
    }
    if (cppinl.Base.derived_dtors != 1)          return 475;
    if (cppinl.Base.base_dtors != 1)             return 476;

    // Heap object released through a BASE pointer: the deleting destructor slot of an emitted
    // vtable, so the derived destructor chain runs.
    cppinl.Base.reset_dtors();
    cppinl.Derived* inlHeap = new cppinl.Derived(3);
    cppinl.Base* inlHeapBase = move inlHeap;
    if (inlHeapBase.area() != 9)                  return 477;
    delete inlHeapBase;
    if (cppinl.Base.derived_dtors != 1)          return 478;
    if (cppinl.Base.base_dtors != 1)             return 479;

    // ---- C++ rvalue-reference parameters --------------------------------------------------------
    cppi.reset_counts();
    {
        cppi.Tracked rvrefT = cppi.make_tracked(4);
        if (cppi.take_either(rvrefT) != 1)         return 550;
        if (cppi.copy_count() != 0)              return 551;
        if (cppi.move_count() != 0)              return 552;
    }
    if (cppi.dtor_count() != 1)                  return 553;

    cppi.reset_counts();
    {
        cppi.Tracked rvrefT = cppi.make_tracked(5);
        if (cppi.take_either(move rvrefT) != 2)    return 554;
        if (cppi.copy_count() != 0)              return 555;
        if (cppi.move_count() != 1)              return 556;
    }
    if (cppi.dtor_count() != 2)                  return 557;

    cppi.reset_counts();
    {
        if (cppi.take_either(cppi.make_tracked(5)) != 2) return 558;
        if (cppi.move_count() != 1)              return 559;
        if (cppi.dtor_count() != 2)              return 560;
    }
    if (cppi.dtor_count() != 2)                  return 561;

    cppi.reset_counts();
    {
        cppi.Tracked rvrefT = cppi.make_tracked(6);
        if (cppi.take_rvalue(move rvrefT) != 6)    return 562;
        if (cppi.dtor_count() != 1)              return 563;
    }
    if (cppi.dtor_count() != 2)                  return 564;

    cppi.reset_counts();
    {
        cppi.Tracked rvrefT = cppi.make_tracked(7);
        if (cppi.take_rvalue(move rvrefT) != 7)    return 565;
        rvrefT = cppi.make_tracked(8);
        if (rvrefT.value() != 8)                   return 566;
    }
    if (cppi.dtor_count() != 3)                  return 567;

    cppi.reset_counts();
    {
        cppi.Sink rvrefSink = default;
        cppi.Tracked rvrefT = cppi.make_tracked(9);
        if (rvrefSink.put(rvrefT) != 1)              return 568;
        if (rvrefSink.put(move rvrefT) != 2)        return 569;
        if (cppi.copy_count() != 0)              return 570;
        if (cppi.move_count() != 0)              return 571;
    }
    if (cppi.dtor_count() != 1)                  return 572;

    // `move p` on a T* binds the T&& leg with the POINTEE's address (the pointer value, never
    // the slot holding it); the heap object is still destroyed and freed at scope exit.
    cppi.reset_counts();
    {
        cppi.Tracked* rvrefP = new cppi.Tracked(10);
        if (cppi.take_either(rvrefP) != 1)         return 573;
        if (cppi.take_either(move rvrefP) != 2)    return 574;
        if (cppi.move_count() != 1)              return 575;
        if (cppi.dtor_count() != 1)              return 576;   // the callee's moved-to local
    }
    if (cppi.dtor_count() != 2)                  return 577;   // plus the heap object

    cppi.reset_counts();
    {
        cppi.Tracked* rvrefRaw = new cppi.Tracked(12);
        if (cppi.take_either(*rvrefRaw) != 1)              return 703;
        if (cppi.copy_count() != 0)                     return 704;
        if (cppi.move_count() != 0)                     return 705;
        delete rvrefRaw;
    }

    cppi.IntVec aliasVec = default;
    aliasVec.push_back(1);
    aliasVec.push_back(2);
    if (aliasVec.size() != 2)                       return 645;
    if (cppi.take_intvec(aliasVec) != 2)            return 646;
    cppi.Vec<double> recVec = default;
    recVec.push_back(1.5);
    if (recVec.size() != 1)                         return 657;

    i128 recWide = cppi.wide_add((i128)18446744073709551616, (i128)7);
    if (recWide != (i128)18446744073709551623) return 647;

    cppi.Counter recCounter = cppi.Counter(3);
    if (recCounter.get() != 3) return 648;
    cppi.DefaultCtorCounter recDefault = default;
    if (recDefault.get() != 37) return 649;
    cppi.Counter recLeft = cppi.Counter(3);
    cppi.Counter recRight = cppi.Counter(4);
    if ((recLeft <= recRight) != true) return 650;
    if ((recRight >= recLeft) != true) return 651;
    if (recRight % 3 != 1) return 652;
    if (recLeft << 2 != 12) return 653;
    if ((recRight & 3) != 0) return 654;
    if ((-recLeft).get() != -3) return 655;
    recLeft += 5;
    if (recLeft.get() != 8) return 656;

    if (cppi.counter_add(15, 3) != 18)             return 638;
    if (cppi.counter_le(15, 12) != 0)              return 639;
    if (cppi.counter_ge(15, 12) != 1)              return 640;
    if (cppi.counter_mod(15, 13) != 2)             return 641;
    if (cppi.counter_shift(15, 1) != 30)           return 642;
    if (cppi.counter_bitand(15, 7) != 7)           return 643;
    if (cppi.counter_neg(15) != -15)               return 644;

    // ---- C++ ++/--, dereference, arrow forwarding and bool --------------------------------------
    cppi.Cursor incdecCursor = cppi.Cursor(10);
    incdecCursor++;
    if (incdecCursor.pos != 11)                        return 707;
    incdecCursor--;
    if (incdecCursor.pos != 10)                        return 708;

    cppi.reset_counts();
    {
        std.unique_ptr<cppi.Tracked> incdecU = cppi.make_tracked_ptr(21);
        if ((*incdecU).payload != 21)                  return 709;
        incdecU.payload = 22;
        if (incdecU.payload != 22)                     return 710;
        cppi.Tracked* incdecUraw = incdecU.get();
        if (incdecUraw == nullptr || incdecUraw.payload != 22) return 711;
        if (!incdecU)                                  return 712;
        bool incdecUb = (bool)incdecU;
        if (!incdecUb)                                 return 713;
    }
    if (cppi.dtor_count() != 1)                     return 714;

    cppi.reset_counts();
    {
        std.shared_ptr<cppi.Tracked> incdecS = cppi.make_tracked_shared(31);
        if ((*incdecS).payload != 31)                  return 715;
        incdecS.payload = 32;
        if (incdecS.payload != 32)                     return 716;
        cppi.Tracked* incdecSraw = incdecS.get();
        if (incdecSraw == nullptr || incdecSraw.payload != 32) return 717;
        if (!incdecS)                                  return 718;
        bool incdecSb = (bool)incdecS;
        if (!incdecSb)                                 return 719;
        incdecS.reset();
        if (cppi.dtor_count() != 1)                 return 720;
    }

    cppi.Truthy incdecFalse = cppi.Truthy(0);
    if (incdecFalse)                                   return 721;
    bool incdecNeg = !incdecFalse;
    if (!incdecNeg)                                    return 722;
    cppi.Truthy incdecTrue = cppi.Truthy(1);
    if (!incdecTrue)                                   return 723;
    bool incdecTruth = (bool)incdecTrue;
    if (!incdecTruth)                                  return 724;

    // ---- C++ operator(), unary ~, and conversion operators --------------------------------------
    // A member operator() is CFlat's call spelling on the value AND on a pointer to it, with
    // the overload picked by arity and by parameter type.
    cppi.Functor opcallF = cppi.Functor(10);
    if (opcallF(5) != 15)                              return 725;
    if (opcallF(5, 7) != 22)                           return 726;
    if (opcallF(0.5) < 10.99 || opcallF(0.5) > 11.01)     return 727;
    cppi.Functor* opcallFp = &opcallF;
    if (opcallFp(5) != 15)                             return 728;
    if (opcallFp(5, 7) != 22)                          return 729;

    // Arity-0 member operators bind to CFlat's unary hooks.
    cppi.Mask opcallM = cppi.Mask(12);
    if (~opcallM != -13)                               return 730;
    if (-opcallM != -12)                               return 731;
    if (+opcallM != 112)                               return 732;
    cppi.Mask* opcallMp = &opcallM;
    if (~(*opcallMp) != -13)                           return 733;

    // Conversion operators bind at an EXPLICIT cast only; explicit and non-explicit alike.
    cppi.Convertible opcallC = cppi.Convertible(41);
    if ((int)opcallC != 42)                            return 734;
    double opcallD = (double)opcallC;
    if (opcallD < 41.24 || opcallD > 41.26)               return 735;
    u8 opcallB = (u8)opcallC;
    if ((int)opcallB != 43)                            return 736;
    cppi.Convertible* opcallCp = &opcallC;
    if ((int)(*opcallCp) != 42)                        return 737;

    // A conversion whose target has no cflat spelling (pointer to member) is refused per
    // member; the class itself still binds and its ordinary members keep working.
    cppi.ConvRefused opcallR = cppi.ConvRefused(1);
    if (opcallR.get() != 4)                            return 738;
    cppi.ConvDeleted opcallDel = cppi.ConvDeleted(1);
    if (opcallDel.get() != 5)                          return 739;

    // cppi.AbiRefusedCallback returns a class whose layout CFlat cannot reproduce,
    // so its ABI plan is refused. The refusal is per callback type: the neighbour declared right
    // after it in the same header is still bound and callable.
    if (cppi.abi_neighbour(7) != 107)               return 792;

    // 'long*' binds the 'const long long*' constructor parameter: same width, same
    // signedness, same pointer ABI. c10::IntArrayRef is constructed exactly this way.
    // cflat's `long` is target-native: 32 bits on Windows, where only a 64-bit pointee binds.
    if const (__WINDOWS__)
    {
        i64 cbplanValue = 17;
        cppi.PointerCount* cbplan = new cppi.PointerCount(&cbplanValue, 1);
        if (cbplan.first() != 17)                      return 793;
        delete cbplan;
    }
    else
    {
        long cbplanValue = 17;
        cppi.PointerCount* cbplan = new cppi.PointerCount(&cbplanValue, 1);
        if (cbplan.first() != 17)                      return 793;
        delete cbplan;
    }

