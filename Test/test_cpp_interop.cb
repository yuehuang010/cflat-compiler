    int expectedResult = (x & 1) == 0 ? 0 : -1;
    bool valid = result == expectedResult && T260KeptField != nullptr && cppon.live() == 1
        && cppon.clsNew() == 1 && cppon.clsDel() == 0 && cppon.dtors() == 0;
    if (valid) valid = *T260KeptField == expectedValue;
    if (T260KeptField != nullptr && cppon.live() == 1)
    {
        cppon.Esc* kept = (cppon.Esc*)T260KeptField;
        T260KeptField = nullptr;
        delete kept;
    }
    return valid && cppon.live() == 0 && cppon.clsDel() == 1 && cppon.dtors() == 1;
}

