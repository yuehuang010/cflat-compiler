    cppi.reset_counts();
    {
        cppi.TrackedHolder* mviHolder = new cppi.TrackedHolder(7527);
        { auto x = move mviHolder->t; if (x.value() != 7527) return 7527; }
        if (cppi.move_count() != 1 || cppi.dtor_count() != 1) return 7528;
