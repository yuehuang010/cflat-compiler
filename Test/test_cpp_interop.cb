// End-to-end C++-interop coverage. Each section exercises one path of the C++ interop
// pipeline; on failure the section's exit code identifies which one regressed.
//   Trivially copyable C++ records by value - layout (size, alignment, packed,
//     over-aligned) checked against the C++ side's own sizeof/alignof, then round trips
//     through every AArch64 arrangement clang picks: coerced small integer, two-eightbyte,
//     HFA in float registers, indirect + sret.
//   C++ class members - instance methods (const and mutating, with arguments), static
//     methods, static data member reads, dispatch through a pointer receiver, the
//     const-overload ruling (an lvalue picks the non-const leg), and qualified scoped-enum
//     spellings. Access control and polymorphism are covered by Test/errors/err_cpp_*.cb.
//   C++ inheritance and VIRTUAL dispatch - polymorphic classes laid out from clang (vptr
//     slot + base subobjects), virtual calls through the vtable slot ItaniumVTableContext
//     assigned, virtual destructor via the Itanium deleting-destructor slot, and multiple
//     inheritance with a non-primary base whose `this` must be adjusted.
//   C++ NONTRIVIAL class lifetime - construction into the declared slot (`T(args)`),
//     copy/move construction, copy/move assignment, exactly-once destruction on normal
//     exit, nested scopes, early return, break and continue, nontrivial by-value arguments
//     (copy and move) and by-value returns constructed straight into the local, plus
//     new/delete and `unique T*` through the C++ operators. Every assertion is an EXACT
//     instrumented count, so an extra copy or a missed destructor fails here.
//   `new T(args)` on trivially-copyable imported C++ classes - ordinary, template,
//     constrained-template, enable_if, explicit-exact and default constructors, plus
//     a class-typed member. Deleted and narrowing constructors are pinned in err_cpp tests.
//   HEADER-ONLY C++ - inline free functions (including one that calls another, and one with
//     a static local), an all-inline nontrivial class, inline static data members as
//     lifetime counters, and an all-inline VIRTUAL hierarchy with no key function. Nothing
//     here has an out-of-line symbol, so every assertion also proves clang's definition
//     emission landed in the linked image. Two import groups cover the same code, so a
//     duplicate definition would fail the link instead of merging by ODR.
//   C++ interop via `import cpp` - namespaced/overloaded declarations.
//   C++ operator(), unary ~, and conversion operators bound by mangled linkage name,
//     reference params and returns as pointers, extern "C" bare linkage, nested namespaces,
//     widening and narrow-unsigned round trips, scoped-enum params, records by pointer.
//     Primitives and bare pointers only.
//   A refused callback ABI plan does not abort the header import.
//   A constructor binds a primitive pointer spelled as a CFlat synonym.
//   A default-argument wrapper for a function returning a record.
//   An unreferenced inline body calling an undefined symbol is dropped before the link; its
//     inline neighbour still binds and runs.
//   Member default-argument wrappers for const instance and static methods, including
//     full-argument and omitted-default calls.
//   An opaque union field preserves the size/alignment of an unrequested class-template
//     specialization when the enclosing record is returned.
//   Free C++ operator overloads are found through the operand namespace, including a nested
//     namespace, and compound assignment falls back to '+'.
//   A C++ reference return bound to a CFlat pointer local with no '&', in the declaration and
//     the assignment form, and proven to alias the referent rather than a copy.
//   Fixed-array pointer ABI, bool and class-typed member defaults, record conversion
//     through an initializer_list wrapper, and a class const-reference return copied into a
//     local.
//   The full C++ operator grid. cppi.Ops carries every MEMBER form (binary, compound,
//     unary, subscript, call, conversion, <=> and the relational operators C++20 rewrites
//     from it, && and ||), and cppi.opsfree.FreeOps the same list as FREE functions, plus
//     the reversed candidates (`int == Ops`, `RevOther == Rev`), `*`/`->` forwarding, and
//     `OpsSink << FreeOps`, whose left operand lives in another namespace.
//   Virtual members whose vtable SLOT cflat cannot name, and the CONSTRUCTION of a class
//     with virtual bases through a placement-new thunk. The covariant return and
//     virtual-base destructor use clang-synthesized thunks; adjacent guards pin the
//     existing base-record fallback and exact by-value resource counts.
//   Implicit scalar-to-class reference conversion, chained nontrivial class return
//     receivers, member reference arguments/defaults, and RAII.
//   C++ exceptions caught at the `program` boundary, including a two-frame CFlat call chain
//     and a normal program run afterward.
//   Namespace-scope C++ OBJECTS - out-of-line extern scalars, class-typed objects and const
//     ones, nested and inline namespaces, a global-scope object, header-only constants that
//     need their own storage, and a write through a mutable one.
//     Test/errors/err_cpp_namespace_const_assign.cb covers the rejected writes.
//   Imported mixed-type C++ bitfields follow Itanium allocation units; overflow still
//     splits, short/int and bool/int use the widest unit, and same-type runs preserve their
//     existing layout.
//   Unnamed zero-width C++ bitfields close an allocation unit under both same-type and
//     mixed-type neighbours; fields and sizeof agree with C++.
//   Class-scope `static const` with an in-class initializer and no out-of-line definition -
//     folded by value across int/unsigned/long long/bool/char/plain and scoped enum, a
//     chained initializer, a nested class, a member that also has an out-of-line
//     definition, use as an array bound and a switch case, and the constexpr /
//     inline-const / out-of-line neighbours that already bound.
//   C++ scoped-enum identity in free/member overload matching, converting constructors,
//     references, explicit casts, templates, and measured preservation of unscoped enum
//     conversions.
//   N/A (diagnostic-only) - explicit C++ forwarding-reference template arguments reject
//     lvalues with the CFlat rvalue-reference message; Test/errors/err_cpp_explicit_template_forwarding_lvalue.cb.
//   C++ REFERENCE data members - a `T&` / `T&&` / `T*&` member bound as a pointer field
//     (layout, by-value return and argument, direct construction, reads through the
//     referent), in a base class, in a class template specialization, and in an array
//     element. Reseating the field is refused;
//     Test/errors/err_cpp_reference_member_reseat.cb pins the message.
//   A C++ exception unwinding THROUGH CFlat frames up to a C++ catch: every destructor each
//     frame owes (C++ locals and fields, CFlat ~T(), unique<T>, by-value argument temps,
//     full-expression temps, drop-flagged locals, loop and nested-block locals, sink params)
//     runs exactly once, and a local whose initializer throws is never destroyed.
//   Throwing C++ constructors, copy/move assignment and operator new (bad_alloc) in such a
//     frame; partial construction of a CFlat struct (built fields destroyed, the rest and the
//     struct not), `new` freeing its block when the ctor throws, and string / closure / pointer
//     temporaries released at the throw unless already handed to a sink parameter (3178-3198).
//   Partial construction of ARRAYS (local `= default` / `{}` / positional / short tail, 2-D,
//     the runtime-loop walk, `new T[n]` constant and runtime, CFlat element types, array fields,
//     the synthesized copy), of `class` / `program` / `[cpp] struct` fields, and interface
//     method calls as invokes (3261-3281).
//   An `extern` CFlat function called before its body is emitted, around core helpers that stay
//     plain calls (3282-3285); a core helper whose C callee the program defines stays an invoke
//     (3286-3287).
// `import cpp` selects C++ mode; the extension is irrelevant (the fixture header is a plain
// .h). The header supplies the declarations, the .cpp is compiled by the host C++ driver
// and linked in. Both are needed: the header alone has no definitions, and the source alone
// would not exercise the header-extraction path.
//   A C++ field whose type is a CLASS - a nested member class (one and two levels, an array
//     of them, a pointer to one, and one pointing back at its owner), a class-template
//     specialization spelled directly and through an alias, a specialization over the
//     owner's own nested class, and one whose template has a nontrivial destructor that the
//     owner's destruction must run. Each of these was embedded as opaque bytes, so every
//     member access failed.
//   A C++ CONSTRUCTOR parameter declared `T&` binds the ARGUMENT's address. Every argument
//     shape (a named local, `*ptr`, a CFlat struct field, an array element, `new T(*p)`), a
//     `const T&` given an lvalue and a prvalue temporary, a reference DATA MEMBER that must
//     alias the argument, a scalar `int&` parameter, a NON-COPYABLE referent, and
//     std.lock_guard / std.unique_lock over a CFlat-owned std.mutex proved by try_lock.
//     Each leg asserts the referent's value AFTER the constructed object was destroyed.
//     Every one of them received a bitwise `%ctor.refarg` stack COPY, so the ctor's writes
//     were lost and the dtor wrote through a dangling pointer.
//   Array ELEMENTS of a C++ class are default-CONSTRUCTED - `T[N] a = default;`, no
//     initializer, `= {}`, two dimensions, a nontrivial ctor with a TRIVIAL dtor, a
//     polymorphic element called virtually, a CFlat struct field of array type, `new T[n]`
//     at constant and runtime extent, a SHORT positional list whose unlisted tail must
//     still be constructed, a per-element brace list (plain and polymorphic), and a struct
//     field whose array default is a non-empty brace list. ONE code per SHAPE: each leg
//     folds the constructor count, the constructor's own invariant and the matching
//     destructor count under a single code. A fully trivial element keeps the whole-array
//     zeroinitializer. Test/errors/err_cpp_array_no_default_ctor.cb pins the
//     deleted-default-constructor refusal, including through the brace and short-tail
//     spellings.
//   C++ using-directives. A directive whose nominated namespace is NESTED INSIDE the
//     nominating one (one level and two, plus the member reached through it) rewrote its own
//     output forever and hung the compiler; the accept set around it - sibling nomination, a
//     two-hop chain, a cycle resolved from both ends, and a namespace nominating itself -
//     must still resolve. Test/errors/err_cpp_usingns_unknown.cb pins the diagnostic for a
//     name that exists through no directive.
//   C++ FREE OPERATOR TEMPLATES. libc++ declares every std.string binary operator as a free
//     function template over basic_string, so none was published or instantiated for concrete
//     operands: `+ == != < > <= >=` are covered for string/string, string/literal and
//     literal/string, with the result used as an initializer, as a condition, as a C++ call
//     argument and read back byte-wise. cpp_interop_freeoptpl.h repeats the shape in a header
//     the fixture owns (a class template with tagged free operator templates, a second one
//     declaring only == and <=> so the relational forms are C++20 rewrites, two
//     specializations, and a plain class with NON-template free operators as the accept set).
//   C++ STANDARD STREAMS (3200-3211). ostringstream/stringstream/ofstream/ifstream/cout through
//     `<<` and `>>` chains, bound as clang-resolved infix expressions (members, free templates,
//     ADL, derived-to-base) including name operands (std.endl, std.cout), plus the link of every
//     inline libc++ body they reach and basic_ios members reached through the virtual base.
//   The default C++ import standard is c++20 (`__cplusplus == 202002L`, 3212).
//   Core list<T> stores trivially-copyable imported C++ classes with user constructors through
//     add/get/remove/iteration/clear, direct and C++ typedef-alias spellings, and generic function and
//     struct instantiations; no-ctor classes, a CFlat holder field, arrays, unique, and a
//     nontrivial C++ class pin the neighbouring paths (codes 3230-3241).
//   C++ callback parameters (3290-3302): matching named functions through typedef and inline
//     signatures, a C++ callback return, static method bridge, constructor and member params,
//     std::function, void callbacks, nullptr, and literal 0.
//   Out-of-line C++ static data member definitions stay class-scoped (3310-3319), including a
//     template specialization; bare member names are not registered as CFlat globals.
//   Assignment INTO a live nontrivial C++ object from a temporary (3320-3339): operator
//     results (free and member), a parenthesized name, by-value member and free calls, a
//     C++ field and array element as the destination, self-assignment, and a '?:' of two
//     temporaries, which must MOVE-assign (or move-construct into a released destination).
//     Test/errors/err_cpp_move_only_lvalue_assign.cb pins the move-only lvalue refusal.
//   Class-scope allocation functions (3350-3368): `new T` / `delete p` of a C++ class with a
//     class-level operator new / delete (own, inherited, sized, through unique T* and unique<T>,
//     the deleting destructor, a throwing constructor, a trivial class), and `new T[n]` of a C++
//     class allocated and freed through the SAME family - ::operator new[] / delete[] or the
//     class's own - on `delete`, `delete[n]`, `delete[_]`, scope exit and unwind.
//   By-value C++ parameter last-use identity (3340-3349): only the parameter slot moves;
//     shadow locals copy, a later outer use stays last, and loop/lambda/prefix/repeated-arg
//     neighbours retain their measured behavior.
//   A C++ reference return and a derived pointer convert at a RETURN statement exactly as at a
//     declaration or assignment (3370-3389): C& and const C& to C*, a receiver held in a CFlat
//     struct field, single and non-primary base adjust, a pending destructor, a lambda body, a
//     CFlat base-pointer parameter, and the brace-init and field-default stores.
//     Test/errors/err_cpp_ref_return_escape.cb pins the refusals.
//   C++ temporary binding to reference parameters (3390-3399): non-const `T&` rejects direct,
//     moved, returned and operator-result temporaries; named lvalues, `const T&`, `T&&`, overload
//     selection, CFlat C++ fields and C++ reference returns retain their value-category rules.
//   Reassigning an owning array view (3400-3420) destroys and frees the block it held - element
//     destructors over the OLD count, then the element type's paired delete (CFlat struct, C++
//     class with global / class / aligned operator delete[]) - for `new`, `move`, move-returning
//     calls, `default`, loops, early return, break and unwind; null, self and borrowed views
//     release nothing, and a view that holds a fixed array on the path taken is never freed.
//     A view stored into a struct field (3420) is shared: reassigning the local frees only the new
//     block at scope exit and leaves the field's block readable.
//   C++ class diagnostic names (basic, nested, pointer-element, and plain namespaced forms)
//     are pinned in Test/errors/err_cpp_diag_display_names.cb.
//   Character literals keep their C++ identity through free operators, member calls,
//     constructors and class-template deduction. `L`, `u` and `U` spell wchar, char16_t and
//     char32_t; numeric literals and native overloads keep their measured behavior (3450-3459).
//   A plain T* local carries the same runtime owns-flag as a view (3430-3449): reassignment
//     releases the old object (CFlat struct, C++ class with its class operator delete, primitive),
//     a conditionally taken new never frees a stack address, `p = &x` releases then borrows, and
//     a reassignment an alias of the old block can reach (a local borrow, a field store, a
//     retaining call) releases nothing - for plain pointers and views alike.
//   A block adopted from another local slot (`b = a`, `b = move a`) is never freed while an alias
//     of that source slot taken before the transfer may still read it; it leaks instead
//     (3460-3462). An aliased owner reassigned to a borrowed pointer disowns (3463).
//     A borrow whose owner no longer holds the block (swap through a temporary, moved owner)
//     is never adopted; the block leaks (3464-3465).
//   `unique Base*` adopts a C++ pointer adjusted to its base subobject, retains virtual dispatch,
//     and invokes exactly one destructor for locals, returns, and fields (3470-3479).
//   Derived C++ pointers are adjusted per arm before conditional joins, including indirect calls
//     and C++ reference results passed to base-pointer parameters (3480-3489).
//   A postfix member call wins over an enclosing same-named free function for C++ classes,
//     CFlat structs and generic structs, while a C++ free-function receiver fallback remains
//     available when the receiver has no member of that name (3490-3499).
//   Native long double aliases retain C++ identity over the supported 64-bit representation
//     through declarations, aggregates, generics, arithmetic, reflection and C++ deduction (3500-3509).
//   C++ proxy prvalue assignment and binary operands, including vector<bool> write-through,
//     readback, comparison, logical conversion, and truth-value forms (3520-3538).
//   C++ reference-result conditional joins preserve selected-object identity at declarations,
//     assignments, arguments, base conversions, and nested conditionals (3550-3559).
//   C++ reference-result return gates agree across `&`, argument roots, pointer fields, and
//     conditional returns, while alias returns retain their override (3560-3569).
//   Variadic and inherited C++ constructors preserve mutable lvalue references without copies
//     across variadic reference packs and mixed by-value arguments (3580-3583).
//   Lazy std::function fields support closure identity, invocation and pointer receivers
//     for zero-argument and parameterized signatures (3590-3594).
//   Statement temporaries of a C++ `new` (3595-3599): an unclaimed owning C++ pointer is released
//     at end of full expression wherever a CFlat struct's is, through the paired class operator
//     delete, the global pair or the deleting destructor; retained and alias results are kept.
//   Owning temporaries passed to list<T*>.add are retained by the emitted slot store (3600-3601).
//   C++ class pointers keep pointer semantics through generic storage (3602-3605): borrowed
//     list/dictionary values are not destroyed, unique list values are, and Box<T> stores T*.

import cpp "library/cpp_interop_basic.h";
import cpp "library/cpp_interop_demand_fail.h";
import cpp "library/cpp_interop_anon.h";
import cpp "library/cpp_interop_explicit.h";
import cpp "library/cpp_interop_refgate.h";
import cpp "library/cpp_interop_basic.cpp";
import cpp "library/cpp_interop_member_shadow.h";
import cpp "library/cpp_interop_twin.h";
import cpp "library/cpp_interop_lastuse.h";
import cpp "library/cpp_interop_demand_fail.h";
// Inheritance and virtual dispatch. Definitions are out-of-line on purpose - every
// virtual function needs a real symbol and the vtable needs a key function.
import cpp "library/cpp_interop_poly.h";
import cpp "library/cpp_interop_poly.cpp";
// HEADER-ONLY C++ - no .cpp anywhere. Every definition is inline in the header, so
// clang CodeGen has to emit the bodies, vtables and inline statics into the companion module.
// The second header re-includes the first from a DIFFERENT import group, which is the
// duplicate-definition (ODR merge) check.
import cpp "library/cpp_interop_inline.h";
import cpp "library/cpp_interop_inline_again.h";
import cpp "library/cpp_inline_static_a.hpp";
import cpp "library/cpp_inline_static_b.hpp";
// The `T&` constructor-parameter checks lock a CFlat-owned std.mutex through std.lock_guard / std.unique_lock.
import cpp "mutex";
import cpp "library/cpp_interop_throw.h";
import cpp "library/cpp_interop_scoped_enum.h";
// C++ REFERENCE data members - bound as pointer fields, never reseatable.
import cpp "library/cpp_interop_ref_member.h";
import cpp "library/cpp_interop_field.h";
// Array elements of a C++ class.
import cpp "library/cpp_interop_arrayelem.h";
import "library/cpp_interop_globals.cb";
// Using-directives, including ones nominating a namespace nested in the nominator.
import cpp "library/cpp_interop_usingns.h";
// The same using-declarations again from a second header: same entity, no conflict.
import cpp "library/cpp_interop_usingns_again.h";
// Forward/definition, template redeclaration, and specialization forms accepted by clang.
// Separate lines: a grouped import registers one file and never reaches the conflict check.
import cpp "library/cpp_interop_c2_accept_a.h";
import cpp "library/cpp_interop_c2_accept_b.h";
// Importing the exact same header twice must retain the existing entity.
import cpp "library/cpp_interop_c2_repeat.h";
import cpp "library/cpp_interop_c2_repeat.h";
// A C++ CONSTRUCTOR parameter declared `T&` binds the argument's address.
import cpp "library/cpp_interop_ctorref.h";
import cpp "library/cpp_interop_varctor.h";
import cpp "library/cpp_interop_freeoptpl.h";
// `explicit` constructors are not implicit conversions at a call argument; the non-explicit
// converting constructor in the same header is the accept set. Rejections: err_cpp_explicit_ctor.cb.
import cpp "library/cpp_interop_explicit.h";
import cpp "string";
import cpp "vector";
// std.format bodies reach libc++ inline variables and ctor-initializer callees (legs 7400-7403).
import cpp "format";
import cpp "library/cpp_interop_strop.h";
import "list.cb";
import "dictionary.cb";
import "thread.cb";
import "malloc_allocator.cb";
import "unique.cb";
// Instrumented counters for a C++ exception unwinding through CFlat frames. The .cpp replaces the
// global operator new/delete with counting ones; heap_audit counts CFlat string/closure/`new` blocks.
import cpp "library/cpp_interop_unwind.h";
import cpp "library/cpp_interop_unwind.cpp";
// Class-scope operator new / delete / new[] / delete[] (legs 3350-3368).
import cpp "library/cpp_interop_opnew.h";
import "diagnostic/heap_audit.cb";
// Standard streams: one grouped std import (stringstream is not visible through a user header alone).
import cpp {"sstream", "fstream", "iostream", "iomanip"};
import cpp "library/cpp_interop_stream.h";
import cpp "library/cpp_interop_list.h";
// Assignment into a live object from a temporary: instrumented, header-only.
import cpp "library/cpp_interop_assign.h";
import cpp "library/cpp_interop_proxy_assign.h";
import cpp "library/cpp_interop_refbinding.h";
import cpp "library/cpp_interop_opaque_return.hpp";

int cppListTakeValue = 0;
void take<T>(list<T>* values, int expectedCount)
{
    if (values->count() == expectedCount && expectedCount > 0)
        cppListTakeValue = values->get(0).value;
}
struct CppListBox<T> { list<T> values; };
struct NewTempBox<T> { T value; };
struct CppListHolder { cpplist.Plain item = default; int tag = 0; };
struct CppResultHolder { cppexp.cppresult.Result<cppexp.cppresult.Middle> item = default; };
struct CppResultBox<T> { T item = default; };
struct CppListValue { int value = 0; };
struct CppAssignHost { cppas.Life l = cppas.Life(1); std.string s; };
struct CppTallyHost { cppas.Tally t = default; };
struct CppAssignRouteHost { cppas.AssignRouteTrivial item; };
cppas.AssignRouteTrivial cppAssignRouteGlobal = default;
cppas.Tally cppAssignTallyGlobal = default;
cppas.AssignRouteNontrivial cppAssignNontrivialGlobal = default;
cppas.AssignRouteByValue cppAssignByValueGlobal = default;
cppas.AssignRouteOther cppAssignOtherGlobal = default;
cppas.AssignRouteOtherRef cppAssignOtherRefGlobal = default;
cppas.AssignRouteRegister cppAssignRegisterGlobal = default;
cppas.AssignRoutePair16 cppAssignPair16Global = default;
cppas.AssignRoutePairDouble cppAssignPairDoubleGlobal = default;
cppas.AssignRouteLarge cppAssignLargeGlobal = default;
cppas.AssignRouteVoid cppAssignVoidGlobal = default;
cppas.AssignRouteScalarReturn cppAssignScalarReturnGlobal = default;
cppas.AssignRouteRegister cppAssignRegisterReturn()
{
    return (cppAssignRegisterGlobal = 7);
}
import cpp "library/cpp_interop_fnptr.h";
import cpp "library/cpp_interop_cglobals.h";
import cpp "library/c_macro_helpers.h";
import cpp "cstdint";
int cppcg_add(int a, int b) { return a + b; }

// A C++ exception unwinding THROUGH CFlat frames (the C++ `guarded` catch sits above them): every
// destructor each frame owes runs exactly once and the catch still sees the thrown value.
int unwOwnDtors = 0;
struct UnwOwn
{
    int v = 0;
    ~UnwOwn() { unwOwnDtors = unwOwnDtors + 1; }
};
struct UnwHolder
{
    int v = 0;
    cppunw.Tr t = default;
};
// A lent named closure that C++ moves into a returned holder: the holder owns a clone of the env.
cppi.ClosureHolder ClosureEscapeMaker()
{
    int k = 40;
    Lambda<int(int)> f = (int x) => { k++; return k + x; };
    return cppi.move_hold(f);
}
int UnwOneFrame(int x)
{
    cppunw.Tr t = default;
    return cppunw.thrower(x);
}
int UnwInner(int x)
{
    cppunw.Tr b = cppunw.Tr(2);
    return cppunw.thrower(x);
}
int UnwTwoFrames(int x)
{
    cppunw.Tr a = cppunw.Tr(1);
    return UnwInner(x) + 1;
}
int UnwCflatOwning(int x)
{
    UnwOwn o = default;
    o.v = x;
    return cppunw.thrower(x);
}
int UnwUnique(int x)
{
    unique<UnwOwn> p = unique<UnwOwn>(new UnwOwn());
    return cppunw.thrower(x);
}
int UnwCppField(int x)
{
    UnwHolder h = default;
    return cppunw.thrower(x);
}
int UnwDeclAfter(int x)
{
    cppunw.Tr a = default;
    int r = cppunw.thrower(x);
    cppunw.Tr late = cppunw.Tr(9);
    return r + late.get();
}
int pftArgumentValue = 1;
int PftStatement(int x) { return cppunw.thrower(pftArgumentValue++); }
int PftAnd(int x) { return x > 0 && cppunw.thrower(pftArgumentValue++) > 0; }
int PftConditional(int x) { return x > 0 ? cppunw.thrower(pftArgumentValue++) : 0; }
int PftInner(int v) { return cppunw.thrower(v); }
int PftIdentity(int v) { return v; }
int PftNested(int x) { return PftIdentity(PftInner(pftArgumentValue++)); }
int PftSafe(int x) { return PftIdentity(pftArgumentValue++); }
struct PftMethodHost { int m(int v) { return cppunw.thrower(v); } };
int PftMethod(int x) { PftMethodHost o; return o.m(pftArgumentValue++); }
int PftConstructor(int x) { cppunw.Tx t = cppunw.Tx(pftArgumentValue++); return t.get(); }
int PftSret(int x) { cppunw.Tr t = cppunw.makeTr(pftArgumentValue++); return t.get(); }
int PftDecrement(int x) { return cppunw.thrower(pftArgumentValue--); }
int pftEnclosingValue = 1;
int PftObserveEnclosing(int v)
{
