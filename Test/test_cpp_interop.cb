    // Before the fix every leg below except the RefDerived ones failed to COMPILE: a reference
    // member set a layout refusal, so the record was laid out with no fields at all.
    int refmemX = 5;
    cppref.RefHolder refmemH = cppref.make_ref(&refmemX);      // by-value return of the record
