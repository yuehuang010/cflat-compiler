int t161Legs()
{
    // T161: out-of-line variadic members (declared in the class, defined outside it) bind like their
    // in-class siblings: scalar tails take default promotions, sret returns work. Static, const,
    // template-member and overload-set siblings included; an aggregate in the tail is still refused.
    t161.Out t161Out = t161.Out();
    T161Big t161Big = t161Out.f_int(9, 17);
    if (t161Big.a != 9 || t161Big.b != 17 || t161Big.d != 4) return 3977;
    t161Big = t161Out.f_float(9, (float)2.5);
    if (t161Big.b != 5) return 3978;
    t161Big = t161Out.f_char(9, (char)17);
    if (t161Big.b != 17) return 3979;
    t161Big = t161Out.f_short(9, (short)17);
    if (t161Big.b != 17) return 3980;
    int t161V = 17;
    t161Big = t161Out.f_ptr(9, &t161V);
    if (t161Big.b != 17) return 3981;
    t161Big = t161Out.zero(9);
    if (t161Big.a != 9 || t161Big.b != 0 || t161Big.c != 3) return 3982;
    t161Big = t161Out.mix(9, (i64)11, 5, 2.5);
    if (t161Big.b != 11 || t161Big.c != 12 || t161Big.d != 5) return 3983;
    t161Big = t161Out.cmix(9, 2.5);
    if (t161Big.b != 5 || t161Big.c != 7 || t161Big.d != 6) return 3984;
    t161Big = t161.Out.s_mix(9, 17);
    if (t161Big.a != 9 || t161Big.b != 17 || t161Big.c != 5) return 3985;
    if (t161Out.ov(3, (i64)4) != 304 || t161Out.ov(3, 4, 5) != 7) return 3986;
    t161.Tpl<int> t161Tpl = t161.Tpl<int>();
    t161Big = t161Tpl.m(9, 17);
    if (t161Big.a != 9 || t161Big.b != 17 || t161Big.d != 8) return 3987;
    T161Big t161Agg = {a = 1, b = 2, c = 3, d = 4};
    T161Big t161AggRet = t161.Out.s_agg(9, t161Agg);
    if (t161AggRet.a != 9 || t161AggRet.b != 1 || t161AggRet.c != 2 || t161AggRet.d != 7)
        return 4112;
    // Out-of-line cppi.Variadic::sum (cpp_interop_basic.cpp) is reached and returns its count.
    cppi.Variadic t161Vs = cppi.Variadic();
    if (t161Vs.sum(5, 1, 2, 3) != 5) return 3988;
    // A VIRTUAL variadic member takes the default promotions before the vtable call: float widens
    // to double, char/short/bool to int (clang: 15457). Through a base pointer and a base reference.
    t161.VBase* t161Vb = t161.vbase();
    if (t161Vb.vf(2, 3, (float)2.5, (char)4, (short)5, true) != 15457) return 3989;
    if (t161ViaRef(*t161Vb) != 15457) return 3990;
    return 0;
}

