    {
        CppListHolder holder;
        holder.item.value = 17;
        holder.item.marker = 3;
        holder.tag = 4;
        list<CppListHolder> holders;
        holders.add(holder);
        if (holders[0].item.value != 17 || holders[0].tag != 4) return 3236;

        cpplist.countedCtorCalls = 0;
        list<cpplist.Counted> genericValues;
        genericValues.add(cpplist.Counted(23));
        cppListTakeValue = 0;
        take<cpplist.Counted>(&genericValues, 1);
        CppListBox<cpplist.Counted> box;
        box.values.add(cpplist.Counted(31));
