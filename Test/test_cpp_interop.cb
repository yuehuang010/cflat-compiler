        heapBase = (int)HeapAudit.reportLeaks();
        // The same alias rule for an array view: a local borrow of the old block withholds the
        // release (pre-fix the view freed it under `t` - a use-after-free read; now it leaks, +1).
        vrDtors = 0;
        { VrS[] v = new VrS[3]; v[0].v = 5; VrS[] t = v; v = new VrS[2]; got = t[0].v; mid = vrDtors; }
        if (got != 5 || mid != 0 || vrDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase + 1)
