    cppa.Trk* arrelemI = new cppa.Trk[2];                     // CONSTANT extent: unrolled
    arrelemOk = 0;
    if (cppa.ctor_count() == 2 && arrelemI[0].v == 7 && arrelemI[1].v == 7) arrelemOk = 1;
    delete arrelemI;
    if (arrelemOk != 1 || cppa.dtor_count() != 2) return 1878;

