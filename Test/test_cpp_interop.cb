    opgridFr = opgridFa - opgridFb;
    if (opgridFr.value != 7)                            return 950;
    opgridFr = opgridFa * opgridFb;
    if (opgridFr.value != 60)                           return 951;
    opgridFr = opgridFa / opgridFb;
    if (opgridFr.value != 2)                            return 952;
    opgridFr = opgridFa % opgridFb;
