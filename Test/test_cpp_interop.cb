extern int strcmp(const char* a, const char* b);
int my_inc_cb(int x) { return x + 1; }

int m7_cb_add(int a, int b) { return a + b; }
int m7_cb_twice(int x) { return x * 2; }
int m7_cb_mixed_out(cppi.Mixed m, char** out) { *out = "callback-out"; return m.i + (int)m.d; }
cppi.Mixed m7_cb_mixed(cppi.Mixed m) { m.d = m.d + 1.0; m.i = m.i + 1; return m; }
cppi.Large m7_cb_large(cppi.Large v)
{
    v.x = v.x + 1; v.y = v.y + 1; v.z = v.z + 1; return v;
}
cppi.Hfa m7_cb_hfa(cppi.Hfa v)
{
    v.a = v.a + 1.0f; v.b = v.b + 1.0f; v.c = v.c + 1.0f; v.d = v.d + 1.0f; return v;
}
int m7_cb_visit(cppi.Tracked* t, void* ctx)
{
    int* state = (int*)ctx;
    if (cppi.dtor_count() != 0) state[1] = 1;
    state[0] = state[0] + 1;
    return t.value();
}


static bool near(double actual, double expected, double tol)
{
    double diff = actual - expected;
    if (diff < 0.0) { diff = -diff; }
    return diff <= tol;
}

// M5 helpers. Each holds a nontrivial C++ local and leaves through a DIFFERENT exit edge, so
// the counters below prove the existing cleanup paths (not a second mechanism) destroy it.
int m5_early_return(int k)
{
    cppi.Tracked t = cppi.Tracked(k);
    if (k > 0) return t.value();
    return -1;
}

// M8 helper: the SAME specialization `cppt.Box<int>` a second function also declares. One
// registration and one emitted symbol have to serve both, or the link fails on a duplicate.
int m8_second_use(int v)
{
    cppt.Box<int> b = cppt.Box<int>(v);
    return b.get() + b[0];
}

int m92_take_box(cppt.Box<int> value) { return value.get(); }
int m92_take_pair(cppt.CtorPair<int> value) { return value.first() + value.second(); }
int m92_take_nested(cppt.Box<cppt.Box<int>> value) { return value.get().get(); }
int m92_take_nested2(cppt.Box<cppt.Box<cppt.Box<int>>> value) { return value.get().get().get(); }
int m92_take_payload(cppt.Box<cppi.impl_detail.Payload> value) { return value.get().get(); }
cppt.Box<int> m92_return_box(int value) { return cppt.Box<int>(value); }

// M95 helpers: the qualified C++ specialization spelling formed from a CFlat generic's own T.
T m95TwiceStatic<T>(T value) { return cppt.M95Stat<T>.twice(value); }
int m95RankStatic<T>() { return cppt.M95Stat<T>.rank(); }

// M9 helper: a std.string built and read in a second function - the specialization is requested
// once for the whole compilation, not once per use site.
int m9_second_use()
{
    std.string s = std.string("abcd");
    return (int)s.size();
}

