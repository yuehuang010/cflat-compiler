}
int ObAliasParam(alias cppas.ObSelf p) { if (p) return 1; return 2; }
// T231: a CFlat function's by-value parameter of a C++ class (leg 3587).
int t231_cfl_takes(cppbv.Cnt x) { return x.v; }
// T235: a prvalue first and a throwing callee / throwing later argument (legs 3691-3692).
int T235Throw(int x) { return cppbv.pairThrow(cppbv.make(x), cppbv.Cnt(x * 100)); }
int T235Later(int x) { return cppbv.pair(cppbv.make(x), cppbv.Cnt(cppbv.boomArg(x))); }
int ObPtrParam(cppas.ObSelf* p) { if (*p) return 1; return 2; }
int* EscTernFieldAddr(int x) { return x > 0 ? &(new cppon.Esc(x))->v : nullptr; }
int* EscLaunderedFieldAddr(int x) { return (int*)(long)&(new cppon.Esc(x))->v; }
// Value * 100 + frees so far: a temp freed before the read shows up in the low digits.
int EscReadAndFrees(int* p) { return *p * 100 + cppon.clsDel(); }
int EscReadRefAndFrees(EscAddrRef r) { return *r.p * 100 + cppon.clsDel(); }

int EscGenericReturn<T>(int x) { return (new T(x))->get(); }
int EscGenericKeep<T>(int x) { return (new T(x))->keep(); }
int EscDirectReturn(int x) { return (new cppon.Esc(x))->get(); }
int EscThrowingArg(int x) { return cppon.escThrow(new cppon.Esc(x), x + 5); }
