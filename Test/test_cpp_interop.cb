        || ctorrefConstSignedCharObj.same((void*)&ctorrefChar)) return 7128;
    char ctorrefOverloadChar = 8;
    cppcr.RefOverload ctorrefOverload = cppcr.RefOverload(ctorrefOverloadChar);
    if (ctorrefOverload.chosen != 2 || ctorrefOverloadChar != 8) return 7129;
    // Overload set with a non-const `long&`: an rvalue picks `const long&` (pre-fix refused
