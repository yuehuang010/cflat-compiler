    }
    if (arrelemOk != 1 || cppa.dtor_count() != 2) return 1871;

    cppa.reset();
    arrelemOk = 0;
    {
        cppa.Trk[2] arrelemC = {};                            // empty-brace value initialization
        if (cppa.ctor_count() == 2 && arrelemC[0].v == 7 && arrelemC[1].v == 7) arrelemOk = 1;
    }
    if (arrelemOk != 1 || cppa.dtor_count() != 2) return 1872;

    cppa.reset();
    arrelemOk = 0;
    {
        cppa.Trk[2][2] arrelemD = default;                    // every inner dimension counts
        if (cppa.ctor_count() == 4 && arrelemD[0][0].v == 7 && arrelemD[1][1].v == 7) arrelemOk = 1;
    }
    if (arrelemOk != 1 || cppa.dtor_count() != 4) return 1873;

