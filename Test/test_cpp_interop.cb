    {
        cpptw.reset_counts();
        int observed = lu_no_shadow(cpptw.Twin(7));
        if (observed != 7 || cpptw.packed_counts() != 12) return 3340;
    }
    {
        cpptw.reset_counts();
        int observed = lu_loop(cpptw.Twin(7));
        if (observed != 14 || cpptw.packed_counts() != 203) return 3341;
    }
    {
        cpptw.reset_counts();
        int observed = lu_lambda(cpptw.Twin(7));
        if (observed != 14 || cpptw.packed_counts() != 113) return 3342;
    }
    {
        cpptw.reset_counts();
        int observed = lu_shadow_alias(cpptw.Twin(7));
        if (observed != 107 || cpptw.packed_counts() != 114) return 3343;
    }
    {
        cpptw.reset_counts();
        int observed = lu_after_block(cpptw.Twin(7));
