        vrDtors = 0;
        int held = 0;
        {
            VrH h;
            VrS[] v = new VrS[3];
            v[0].v = 11;
            h.items = v;
            v = new VrS[2];
            held = h.items[0].v;
            mid = vrDtors;
        }
