    refmemH.set(7);
    if (refmemX != 7)                                   return 1851;
    if (*refmemH.r != 7)                                return 1852;   // the field IS the pointer
    *refmemH.r = 9;                                                     // store to the REFERENT
    if (refmemX != 9 || refmemH.get() != 9)                return 1853;
    int* refmemP = refmemH.r;                                              // read the field as T*
    if (*refmemP != 9)                                  return 1854;

    cppref.RefHolder refmemD = cppref.RefHolder(&refmemX);     // direct construction
    if (refmemD.get() != 9)                             return 1855;
    if (cppref.take_ref(refmemD) != 9)                  return 1856;    // by-value argument

