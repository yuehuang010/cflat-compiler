int CppTemporaryRefCases()
{
    cppref.Ex refBindLvalue = cppref.Ex(5);
    if (cppref.take_ref(refBindLvalue) != 6 || refBindLvalue.v != 6)          return 3390;
    if (cppref.take_cref(cppref.Ex(5)) != 1005)                              return 3391;
    if (cppref.take_rref(cppref.Ex(5)) != 2005)                              return 3392;
    if (cppref.choose_cref(cppref.Ex(5)) != 205)                             return 3393;
    cppref.Ex refPickLvalue = cppref.Ex(5);
    if (cppref.choose_rref(cppref.Ex(5)) != 405
        || cppref.choose_rref(refPickLvalue) != 306 || refPickLvalue.v != 6) return 3394;
    // clang++ -std=c++20: const prvalues retain const; the template deduces const CvCtorSource.
    cppref.CvCtorConstRef constPrvalueCref = cppref.CvCtorConstRef(cppref.make_const_ctor_source());
    if (constPrvalueCref.which != 11) return 3397;
    cppref.CvCtorByValue constPrvalueByValue = cppref.CvCtorByValue(cppref.make_const_ctor_source());
    if (constPrvalueByValue.which != 12) return 3398;
    cppref.CvCtorConstRRef constPrvalueConstRref = cppref.CvCtorConstRRef(cppref.make_const_ctor_source());
    if (constPrvalueConstRref.which != 14) return 3399;
    cppref.CvCtorPair constPrvaluePair = cppref.CvCtorPair(cppref.make_const_ctor_source());
    if (constPrvaluePair.which != 16) return 3400;
    cppref.CvCtorTemplate constPrvalueTemplate = cppref.CvCtorTemplate(cppref.make_const_ctor_source());
    if (constPrvalueTemplate.which != 17) return 3401;
    cppref.CvCtorRRef mutablePrvalueRref = cppref.CvCtorRRef(cppref.make_ctor_source());
    if (mutablePrvalueRref.which != 13) return 3402;
    ExFieldHolder refField = default;
    if (cppref.take_ref(refField.ex) != 6 || refField.ex.v != 6)             return 3395;
    if (cppref.take_ref(cppref.ref_ex()) != 71 || cppref.ref_ex().v != 71)  return 3396;
    return 0;
}

