            || cppunw.newArrs() != cppunw.deleteArrs() || cppon.live() != 0 || cppunw.live() != 0) return 3418;

        // Primitive and string element views: the old block is freed (string buffers included).
        { int[] p = new int[3]; p = new int[2]; string[] s = new string[2]; s[0] = "abc".copy();
          s = new string[3]; }
        if ((int)HeapAudit.reportLeaks() != heapBase) return 3419;

