    // Section M29. cppi.calls_missing_symbol is an inline body whose callee is declared and
    // never defined; nothing here calls it, so it must not reach the linker. Its neighbour,
    // an ordinary inline function, is called and must run.
    if (cppi.missing_symbol_neighbour(5) != 16)     return 795;

    // Section M30. Both member forms omit a non-constant default through a generated wrapper;
    // the full calls prove the original member remains selected for the complete arity.
    cppi.DefaultArgs m30args = default;
    if (m30args.scaled(3, 4) != 34)                 return 796;
    if (m30args.scaled(3) != 39)                    return 797;
    if (cppi.DefaultArgs.static_scaled(3, 4) != 304) return 798;
    if (cppi.DefaultArgs.static_scaled(3) != 309)   return 799;

    // Section M31. The sibling field must remain readable after a by-value return whose union
    // contains an opaque, over-aligned template specialization.
    cppi.LayoutHolder m31layout = cppi.make_layout_holder(37);
    if (m31layout.sibling != 37)                    return 800;

    // Section M32. Free operators are ordinary C++ functions, so lookup must use the namespace
    // of the class operand rather than the member-operator table.
    cppi.FreeArithmetic m32a = default;
    cppi.FreeArithmetic m32b = default;
    m32a.value = 2;
    m32b.value = 3;
    cppi.FreeArithmetic m32sum = m32a + m32b;
    if (m32sum.value != 5)                           return 801;
    if (!(m32a == m32a))                             return 802;
    if (m32a == m32b)                               return 803;
    m32a += m32b;
    if (m32a.value != 5)                             return 804;
    cppi.freeops.FreeArithmetic m32nestedA = default;
    cppi.freeops.FreeArithmetic m32nestedB = default;
    m32nestedA.value = 4;
    m32nestedB.value = 6;
    cppi.freeops.FreeArithmetic m32nestedSum = m32nestedA + m32nestedB;
    if (m32nestedSum.value != 10)                   return 805;
    if (!(m32nestedA == m32nestedA))                 return 806;
    // ---- Section M33: C++ interop ladder rung 4 mechanisms (807-812) -------------------
    if const (__WINDOWS__)
    {
        i64[2] m33dims = {17, 18};   // LLP64: `long` is 32 bits, the pointee must be 64
        cppi.PointerCount* m33pointer = new cppi.PointerCount(&m33dims[0], 2);
        if (m33pointer.first() != 17)               return 807;
        delete m33pointer;
    }
    else
    {
        long[2] m33dims = {17, 18};
        cppi.PointerCount* m33pointer = new cppi.PointerCount(&m33dims[0], 2);
        if (m33pointer.first() != 17)               return 807;
        delete m33pointer;
    }

    cppi.DefaultArgs m33args = default;
    if (m33args.bool_scaled() != 1)                 return 808;
    if (m33args.bool_scaled(false) != -1)           return 809;

    if (cppi.DefaultArgs.multi_defaults() != 0)    return 810;

    if (m33args.brace_sum({1, 2, 3}) != 6)        return 811;

    cppi.Tracked m33tracked = cppi.tracked_ref();
    if (m33tracked.value() != 812)                  return 812;

    // Section M40. The C++ operator grid: every form C++ allows, once. Ops declares the member
    // spellings, cppi.opsfree.FreeOps the free ones. `<` `>` `<=` `>=` exist on neither class as
    // themselves - C++20 REWRITES them from operator<=>, which is what these check.
    cppi.Ops m40a = default;
    cppi.Ops m40b = default;
    m40a.value = 12;
    m40b.value = 5;
    cppi.Ops m40r = m40a + m40b;
    if (m40r.value != 17)                            return 900;
    m40r = m40a - m40b;
    if (m40r.value != 7)                             return 901;
    m40r = m40a * m40b;
    if (m40r.value != 60)                            return 902;
    m40r = m40a / m40b;
    if (m40r.value != 2)                             return 903;
    m40r = m40a % m40b;
    if (m40r.value != 2)                             return 904;
    m40r = m40a & m40b;
    if (m40r.value != 4)                             return 905;
    m40r = m40a | m40b;
    if (m40r.value != 13)                            return 906;
    m40r = m40a ^ m40b;
    if (m40r.value != 9)                             return 907;
    m40r = m40a << m40b;
    if (m40r.value != 384)                           return 908;
    m40r = m40a >> m40b;
    if (m40r.value != 0)                             return 909;

    if (!(m40a == m40a))                             return 910;
    if (!(m40a != m40b))                             return 911;
    if (!(m40b < m40a))                              return 912;
    if (!(m40a > m40b))                              return 913;
    if (!(m40b <= m40a))                             return 914;
    if (!(m40a >= m40b))                             return 915;
    if (m40a < m40b)                                 return 916;
    if (!(m40a <= m40a))                             return 917;

    cppi.Ops m40c = default;
    m40c.value = 12;
    m40c += m40b;
    if (m40c.value != 17)                            return 918;
    m40c -= m40b;
    if (m40c.value != 12)                            return 919;
    m40c *= m40b;
    if (m40c.value != 60)                            return 920;
    m40c /= m40b;
    if (m40c.value != 12)                            return 921;
    m40c %= m40b;
    if (m40c.value != 2)                             return 922;
    m40c.value = 12;
    m40c &= m40b;
    if (m40c.value != 4)                             return 923;
    m40c |= m40b;
    if (m40c.value != 5)                             return 924;
    m40c ^= m40b;
    if (m40c.value != 0)                             return 925;
    m40c.value = 12;
    m40c <<= m40b;
    if (m40c.value != 384)                           return 926;
    m40c >>= m40b;
    if (m40c.value != 12)                            return 927;

    // An overloaded && / || is an ordinary call in C++ too: both operands are evaluated.
    if (!(m40a && m40b))                             return 928;
    if (!(m40a || m40b))                             return 929;

    m40r = -m40a;
    if (m40r.value != -12)                           return 930;
    m40r = +m40a;
    if (m40r.value != 12)                            return 931;
    if (!m40a)                                       return 932;
    m40r = ~m40a;
    if (m40r.value != -13)                           return 933;
    // CFlat spells only the postfix form; it binds C++'s PREFIX operator++ (the standing ruling).
    m40c.value = 12;
    m40c++;
    if (m40c.value != 13)                            return 934;
    m40c--;
    if (m40c.value != 12)                            return 935;

    m40a[1] = 7;
    if (m40a[1] != 7)                                return 936;
    if (m40a(  ) != 12)                              return 937;
    if (m40a(3) != 15)                               return 938;
    if (m40a(3, 4) != 24)                            return 939;

    if (!(bool)m40a)                                 return 940;
    if ((int)m40a != 12)                             return 941;
    if ((double)m40a != 12.5)                        return 942;

    // Scalar comparisons: the member takes the int on the right, the free function on the left.
    // The free one adds 1 to the class operand, so only the chosen overload can produce these.
    if (!(m40a == 12))                               return 943;
    if (!(13 == m40a))                               return 944;
    if (13 != m40a)                                  return 945;

    // Reversed MEMBER ==: only cppi.Rev declares one, against cppi.RevOther.
    cppi.Rev m40rev = default;
    cppi.RevOther m40other = default;
    m40rev.value = 3;
    m40other.value = 3;
    if (!(m40other == m40rev))                       return 946;

    // Unary * and -> both forward to the pointed-at object.
    cppi.OpsBox m40box = default;
    m40box.target = &m40a;
    cppi.Ops m40deref = *m40box;
    if (m40deref.value != 12)                        return 947;
    if (m40box.value != 12)                          return 948;

    cppi.opsfree.FreeOps m40fa = default;
    cppi.opsfree.FreeOps m40fb = default;
    m40fa.value = 12;
    m40fb.value = 5;
    cppi.opsfree.FreeOps m40fr = m40fa + m40fb;
    if (m40fr.value != 17)                           return 949;
    m40fr = m40fa - m40fb;
    if (m40fr.value != 7)                            return 950;
    m40fr = m40fa * m40fb;
    if (m40fr.value != 60)                           return 951;
    m40fr = m40fa / m40fb;
    if (m40fr.value != 2)                            return 952;
    m40fr = m40fa % m40fb;
    if (m40fr.value != 2)                            return 953;
    m40fr = m40fa & m40fb;
    if (m40fr.value != 4)                            return 954;
    m40fr = m40fa | m40fb;
    if (m40fr.value != 13)                           return 955;
    m40fr = m40fa ^ m40fb;
    if (m40fr.value != 9)                            return 956;
    m40fr = m40fa << m40fb;
    if (m40fr.value != 384)                          return 957;
    m40fr = m40fa >> m40fb;
    if (m40fr.value != 0)                            return 958;
    if (!(m40fa && m40fb))                           return 959;
    if (!(m40fa || m40fb))                           return 960;

    if (!(m40fa == m40fa))                           return 961;
    if (!(m40fa != m40fb))                           return 962;
    if (!(m40fb < m40fa))                            return 963;
    if (!(m40fa > m40fb))                            return 964;
    if (!(m40fb <= m40fa))                           return 965;
    if (!(m40fa >= m40fb))                           return 966;

    cppi.opsfree.FreeOps m40fc = default;
    m40fc.value = 12;
    m40fc += m40fb;
    if (m40fc.value != 17)                           return 967;
    m40fc -= m40fb;
    if (m40fc.value != 12)                           return 968;
    m40fc *= m40fb;
    if (m40fc.value != 60)                           return 969;
    m40fc /= m40fb;
    if (m40fc.value != 12)                           return 970;
    m40fc %= m40fb;
    if (m40fc.value != 2)                            return 971;
    m40fc.value = 12;
    m40fc &= m40fb;
    if (m40fc.value != 4)                            return 972;
    m40fc |= m40fb;
    if (m40fc.value != 5)                            return 973;
    m40fc ^= m40fb;
    if (m40fc.value != 0)                            return 974;
    m40fc.value = 12;
    m40fc <<= m40fb;
    if (m40fc.value != 384)                          return 975;
    m40fc >>= m40fb;
    if (m40fc.value != 12)                           return 976;

    m40fr = -m40fa;
    if (m40fr.value != -12)                          return 977;
    m40fr = +m40fa;
    if (m40fr.value != 12)                           return 978;
    if (!m40fa)                                      return 979;
    m40fr = ~m40fa;
    if (m40fr.value != -13)                          return 980;
    m40fc.value = 12;
    m40fc++;
    if (m40fc.value != 13)                           return 981;
    m40fc--;
    if (m40fc.value != 12)                           return 982;

    // The left operand is cppi.OpsSink, a class from the ENCLOSING namespace: the free
    // operator<< is reachable only through the RIGHT operand's namespace.
    cppi.OpsSink m40sink = default;
    m40sink.total = 1;
    m40sink << m40fa;
    if (m40sink.total != 13)                         return 983;

    // ---- Section M36: C++ rvalue receivers, bool bitfields, and inherited variadic constructors
    // (820-823) -------------------------------------------------------------------------------
    if (cppt.make_box(9).get() != 9)                  return 820;
    cppt.BoolBits m36bits = default;
    m36bits.ready = true;
    if (!m36bits.ready)                                return 821;
    m36bits.mode = true;
    if (!m36bits.mode)                                 return 822;
    cppt.InheritedCtorHolder m36holder = cppt.InheritedCtorHolder(5, 7);
    if (m36holder.get() != 12)                         return 823;
    // ---- Section M34: C++ interop ladder rung 5 mechanisms (813-819) -------------------
    double m34scalar = 2.5;
    int m34integer = 3;
    double m34boxValue = 3.5;
    double m34extra = 1.5;
    if (cppi.scalar_ref(m34scalar) != 2.5)         return 813;
    if (cppi.scalar_ref(m34integer) != 3.0)        return 814;
    if (cppi.make_scalar_box(m34boxValue).value() != 3.5) return 815;
    cppi.ScalarOps m34ops = default;
    if (m34ops.add(m34scalar) != 3.5)              return 816;
    if (m34ops.add(m34integer, m34extra) != 4.5)   return 817;
    cppi.reset_counts();
    int m34value = 0;
    {
        cppi.Tracked m34tracked = cppi.make_tracked(4);
        m34value = m34tracked.value();
    }
    if (m34value != 4)                             return 818;
    if (cppi.ctor_count() != 1 || cppi.dtor_count() != 1) return 819;

    return 0;
}
