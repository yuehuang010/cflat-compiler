        cppon.reset();
        { cppon.Wide[] v = new cppon.Wide[3]; v = new cppon.Wide[2]; mid = cppon.dtors(); }
        if (mid != 3 || cppon.live() != 0 || (int)HeapAudit.reportLeaks() != heapBase) return 3404;

        // `v = move w`: v's old block goes, w is nulled, and v frees w's block exactly once.
        vrDtors = 0;
        bool wNull = false;
        { VrS[] v = new VrS[3]; VrS[] w = new VrS[2]; v = move w; mid = vrDtors; wNull = w == nullptr; }
        if (mid != 3 || !wNull || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3405;
        cppunw.reset();
        cppon.reset();
        { cppon.Plain[] v = new cppon.Plain[3]; cppon.Plain[] w = new cppon.Plain[2]; v = move w;
          mid = cppon.dtors(); }
        if (mid != 3 || cppon.dtors() != 5 || cppunw.newArrs() != cppunw.deleteArrs() || cppon.live() != 0)
            return 3406;
        // Accept-set, passes on both binaries: `v = v` keeps the live block and releases nothing.
        heapBase = (int)HeapAudit.reportLeaks();
        vrDtors = 0;
        int v0 = 0;
        { VrS[] v = new VrS[3]; v = v; mid = vrDtors; v0 = v[2].v; }
        if (mid != 0 || v0 != 7 || vrDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3407;

        // A loop releases on every iteration (CFlat struct, then a C++ class).
        vrDtors = 0;
        { VrS[] v = new VrS[1]; for (int i = 0; i < 4; i++) v = new VrS[2]; mid = vrDtors; }
        if (mid != 7 || vrDtors != 9 || (int)HeapAudit.reportLeaks() != heapBase) return 3408;
        cppunw.reset();
        cppon.reset();
        { cppon.Plain[] v = new cppon.Plain[1]; for (int i = 0; i < 4; i++) v = new cppon.Plain[2];
          mid = cppon.dtors(); }
        if (mid != 7 || cppunw.newArrs() != cppunw.deleteArrs() || cppon.live() != 0) return 3409;

