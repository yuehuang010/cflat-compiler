    if (cppu_nest.helper() != 7) return 1891;
    if (cppu_nest.via_using() != 17) return 1892;
    if (cppu_deep.mid.inner.helper2() != 9) return 1893;
    if (cppu_deep.via_using2() != 29) return 1894;
