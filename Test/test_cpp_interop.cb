    if (thkU.mutu(ctorrefInt) != 4 || ctorrefInt != 4)                      return 7101;
    uint ctorrefUint = 4;
    if (thkU.muti(ctorrefUint) != 4 || ctorrefUint != 4)                    return 7102;
    ulong ctorrefUlong = 4;
    if (thkU.mutll(ctorrefUlong) != 4 || ctorrefUlong != 4)                 return 7103;
    long ctorrefAddrLong = 4;
    if (thkU.addrll(ctorrefAddrLong, (void*)&ctorrefAddrLong) != 0)         return 7104;
    uint ctorrefAddrUint = 4;
    if (thkU.addri(ctorrefAddrUint, (void*)&ctorrefAddrUint) != 0)          return 7105;
    long ctorrefDirectSource = 4;
    cppcr.PlainConstLLRef ctorrefDirect = cppcr.PlainConstLLRef(ctorrefDirectSource);
