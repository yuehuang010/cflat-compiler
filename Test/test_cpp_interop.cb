    cppf.Deep clsfieldDeep = default;                          // two levels of nesting
    if (clsfieldDeep.md.m != 9) return 1837;
    if (clsfieldDeep.md.lf.l != 7) return 1838;
    if (clsfieldDeep.md.lf.inc() != 8) return 1839;

    cppf.ArrHost clsfieldArr = default;                        // fixed array of a nested class
