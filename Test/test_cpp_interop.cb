    if (cppu_shadow_nominator.own_function() != 3050)                         return 3050;
    if (cppu_shadow_nominator.SameClass.answer() != 3051)                      return 3051;
    if (cppu_shadow_nominator.own_variable != 3052)                            return 3052;
    if (cppu_shadow_nominator.nested.own_nested_function() != 3053)            return 3053;
    // A nominated member remains reachable through the nominator, including below the
    // colliding nested namespace.
    if (cppu_shadow_nominator.nominated_function() != 3054
