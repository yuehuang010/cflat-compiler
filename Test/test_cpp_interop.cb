    // ---- a C++ reference return and a derived pointer at a RETURN statement (3370-3389) ----
    // Pre-fix 3370-3373 and 3379 failed to COMPILE ("cannot return this value: its type does not
    // match"), 3374, 3375 and 3380 were refused as an 'alias' escape, and 3376 / 3381 handed over
    // Both's address unadjusted (rv read Left's lv). 3377 (primary base, offset 0) and 3378 (null
    // stays null through the adjust) are accept-set controls that passed before.
    {
        cppi.RefCell* rc = RrCell();
        rc.v = 773;                              // aliases the static cell, not a copy
        if (cppi.ref_cell().v != 773)                                        return 3370;
        if (RrCellConst() != rc || RrCellConst().v != 773)                   return 3371;
        RrHolder rrh = default;
        rrh.box.c.v = 5;
        cppi.RefCell* held = RrHeld(&rrh);
        held.v = 6;
        if (rrh.box.c.v != 6)                                                return 3372;
        if (RrHeldConst(&rrh) != held)                                       return 3373;
        cpppoly.Shape* rrs = RrShapeFromRef();
        if (rrs.area() != 50 || rrs.tag != 2)                                return 3374;
        // Right is Both's NON-primary base: the returned pointer must be 16 bytes in, and the
        // virtual call through Right's vtable must reach Both::r (rv + 2000).
        cpppoly.Right* rrr = RrRightFromRef();
        if (rrr.rv != 44 || rrr.r() != 2044)                                 return 3375;
        cpppoly.Right* rrp = RrRightFromPtr(&cpppoly.both_ref());
        if (rrp != rrr || rrp.r() != 2044)                                   return 3376;
        if (RrShapeFromPtr(&cpppoly.circle_ref()).area() != 50)              return 3377;
        if (RrRightFromPtr(nullptr) != nullptr)                              return 3378;
        // The return leaves a block with a C++ destructor pending; it runs exactly once.
        int rrCircleDtors = cpppoly.circle_dtors();
        if (RrNested(1) != rc || cpppoly.circle_dtors() != rrCircleDtors + 1) return 3379;
        function<cpppoly.Right*()> rrLam = () => cpppoly.both_ref();
        if (rrLam() != rrr)                                                  return 3380;
        // A derived pointer passed to a CFlat function's base-pointer parameter is adjusted too.
        if (RrReadRight(&cpppoly.both_ref()) != 44)                          return 3381;
        // The brace-init and field-default stores are the same conversion. Pre-fix 3382 stored
        // the loaded RefCell bits as the pointer, 3383 / 3385 stored Both's address unadjusted,
        // and 3384's field default was refused at compile time (the struct value met a pointer).
        cpppoly.Both* rrBoth = &cpppoly.both_ref();
        RrSlots rrSlots = { c = cppi.ref_cell(), r = rrBoth };
        if (rrSlots.c != rc)                                                 return 3382;
        if (rrSlots.r.rv != 44 || rrSlots.r != rrr)                          return 3383;
        RrDefaults rrDefaults = default;
        if (rrDefaults.c != rc)                                              return 3384;
        if (rrDefaults.r.rv != 44 || rrDefaults.r.r() != 2044)               return 3385;
    }
    // ---- C++ temporary binding to reference parameters (3390-3399) -----------------------------
    // Keep the added locals in a helper frame so the existing unwind tests keep their frame shape.
    // ---- Reassigning an owning array view releases the old block (3400-3420) ------------------
    // Pre-fix the view store overwrote the slot and nothing ever destroyed or freed the first
    // block: every `mid` count below read 0 and HeapAudit kept one live block per reassignment.
    {
        int heapBase = (int)HeapAudit.reportLeaks();
        vrDtors = 0;
        int mid = 0;
        { VrS[] v = new VrS[3]; v = new VrS[2]; mid = vrDtors; }
        if (mid != 3 || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3400;
        // C++ class elements free through ::operator delete[], never the single-object delete.
        cppunw.reset();
        cppon.reset();
        { cppon.Plain[] v = new cppon.Plain[3]; v = new cppon.Plain[2]; mid = cppon.dtors(); }
        if (mid != 3 || cppon.dtors() != 5 || cppunw.newArrs() != cppunw.deleteArrs()
            || cppunw.deletes() != 0 || cppon.live() != 0) return 3401;
        // The class's own operator delete[] (sized: a whole number of elements, else +100).
        cppon.reset();
        { cppon.Arr[] v = new cppon.Arr[3]; v = new cppon.Arr[2]; mid = cppon.clsDelArr(); }
        if (mid != 1 || cppon.clsDelArr() != 2 || cppon.dtors() != 5 || cppon.live() != 0) return 3402;
        // Polymorphic elements: n destructors, never element 0's deleting destructor.
        cppunw.reset();
        cppon.reset();
        { cppon.Poly[] v = new cppon.Poly[3]; v = new cppon.Poly[2]; mid = cppon.dtors(); }
        if (mid != 3 || cppon.clsDel() != 0 || cppunw.newArrs() != cppunw.deleteArrs() || cppon.live() != 0)
            return 3403;
        // Over-aligned element: the aligned delete[] pair.
        cppon.reset();
        { cppon.Wide[] v = new cppon.Wide[3]; v = new cppon.Wide[2]; mid = cppon.dtors(); }
        if (mid != 3 || cppon.live() != 0 || (int)HeapAudit.reportLeaks() != heapBase) return 3404;

        // `v = move w`: v's old block goes, w is nulled, and v frees w's block exactly once.
        vrDtors = 0;
        bool wNull = false;
        { VrS[] v = new VrS[3]; VrS[] w = new VrS[2]; v = move w; mid = vrDtors; wNull = w == nullptr; }
        if (mid != 3 || !wNull || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3405;
        cppunw.reset();
        cppon.reset();
        { cppon.Plain[] v = new cppon.Plain[3]; cppon.Plain[] w = new cppon.Plain[2]; v = move w;
          mid = cppon.dtors(); }
        if (mid != 3 || cppon.dtors() != 5 || cppunw.newArrs() != cppunw.deleteArrs() || cppon.live() != 0)
            return 3406;
        // Accept-set, passes on both binaries: `v = v` keeps the live block and releases nothing.
        heapBase = (int)HeapAudit.reportLeaks();
        vrDtors = 0;
        int v0 = 0;
        { VrS[] v = new VrS[3]; v = v; mid = vrDtors; v0 = v[2].v; }
        if (mid != 0 || v0 != 7 || vrDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3407;

        // A loop releases on every iteration (CFlat struct, then a C++ class).
        vrDtors = 0;
        { VrS[] v = new VrS[1]; for (int i = 0; i < 4; i++) v = new VrS[2]; mid = vrDtors; }
        if (mid != 7 || vrDtors != 9 || (int)HeapAudit.reportLeaks() != heapBase) return 3408;
        cppunw.reset();
        cppon.reset();
        { cppon.Plain[] v = new cppon.Plain[1]; for (int i = 0; i < 4; i++) v = new cppon.Plain[2];
          mid = cppon.dtors(); }
        if (mid != 7 || cppunw.newArrs() != cppunw.deleteArrs() || cppon.live() != 0) return 3409;

        // A null / `default` / moved-from old view frees nothing; `v = default` releases the block.
        vrDtors = 0;
        {
            VrS[] n = default;
            n = new VrS[2];
            VrS[] w = new VrS[3];
            VrS[] m = move w;
            w = new VrS[1];
            VrS[] d = new VrS[4];
            d = default;
            mid = vrDtors;
        }
        if (mid != 4 || vrDtors != 10 || (int)HeapAudit.reportLeaks() != heapBase) return 3410;

        // Accept-set, passes on both binaries: borrowed views release nothing - a `T[]` parameter
        // and a local bound to another view.
        heapBase = (int)HeapAudit.reportLeaks();
        vrDtors = 0;
        int got = 0;
        {
            VrS[] a = new VrS[3];
            VrS[] b = new VrS[2];
            b[0].v = 9;
            got = VrParam(a, b);
            VrS[] x = a;
            x = b;
            got = got + x[0].v;
            mid = vrDtors;
        }
        if (got != 18 || mid != 0 || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3411;
        // `v = w` from an OWNING view without `move`: v's block goes and v borrows w's.
        // Pre-fix v kept its ownership and freed w's block a second time (SIGTRAP).
        vrDtors = 0;
        { VrS[] v = new VrS[3]; VrS[] w = new VrS[2]; v = w; mid = vrDtors; }
        if (mid != 3 || vrDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3412;

        // A view that holds a FIXED array on the path taken is never freed, at the reassignment
        // or at scope exit. Pre-fix the scope exit freed the stack array when the branch that
        // adopted `new` was not taken (SIGABRT).
        vrDtors = 0;
        {
            VrS[3] fa;
            VrS[] x = fa;
            if (vrZero > 0) x = new VrS[2];
            mid = vrDtors;
        }
        if (mid != 0 || vrDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3413;
        vrDtors = 0;
        {
            VrS[3] fa;
            VrS[] x = fa;
            if (vrZero > 0) x = new VrS[2];
            x = new VrS[4];
            VrS[] o = new VrS[1];
            VrS[] b = new VrS[2];
            if (vrZero > 0) o = b;
            o = new VrS[5];                                           // releases the S[1] block
            mid = vrDtors;
        }
        if (mid != 1 || vrDtors != 15 || (int)HeapAudit.reportLeaks() != heapBase) return 3414;

        // Early return, break, a move-returning call and a '?:' of two `new` blocks.
        vrDtors = 0;
        got = VrEarly(1) + VrEarly(0);
        if (got != 15 || vrDtors != 11 || (int)HeapAudit.reportLeaks() != heapBase) return 3415;
        vrDtors = 0;
        { VrS[] v = new VrS[1]; for (int i = 0; i < 5; i++) { v = new VrS[2]; if (i == 2) break; }
          mid = vrDtors; }
        if (mid != 5 || vrDtors != 7 || (int)HeapAudit.reportLeaks() != heapBase) return 3416;
        vrDtors = 0;
        { VrS[] v = VrMake(3); v = VrMake(2); v = vrZero > 0 ? new VrS[1] : new VrS[4]; mid = vrDtors; }
        if (mid != 5 || vrDtors != 9 || (int)HeapAudit.reportLeaks() != heapBase) return 3417;

        // A C++ exception after the reassignment: the old block was already released, the new
        // one is freed by the unwind cleanup; global new[] and delete[] balance (see above).
        cppunw.reset();
        cppon.reset();
        if (cppunw.guarded(VrUnwind, 5) != -5 || cppon.dtors() != 5
            || cppunw.newArrs() != cppunw.deleteArrs() || cppon.live() != 0 || cppunw.live() != 0) return 3418;

        // Primitive and string element views: the old block is freed (string buffers included).
        { int[] p = new int[3]; p = new int[2]; string[] s = new string[2]; s[0] = "abc".copy();
          s = new string[3]; }
        if ((int)HeapAudit.reportLeaks() != heapBase) return 3419;

        // A view stored into a struct field keeps its block alive for the field: the reassignment
        // releases nothing and scope exit frees only the new block. The escaped block is still the
        // pre-existing field-escape leak (+1). Pre-fix HEAD freed it under the field (UAF, 2 read).
        vrDtors = 0;
        int held = 0;
        {
            VrH h;
            VrS[] v = new VrS[3];
            v[0].v = 11;
            h.items = v;
            v = new VrS[2];
            held = h.items[0].v;
            mid = vrDtors;
        }
        if (held != 11 || mid != 0 || vrDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3420;
    }
    int refResult = CppTemporaryRefCases();
    if (refResult != 0) return refResult;
    int dtorOrderResult = CppDtorOrderCases();
    if (dtorOrderResult != 0) return dtorOrderResult;

    // Character literal identity crosses each C++ overload boundary as char.
    std.string literalBase = std.string("hi");
    std.string literalAdded = literalBase + 'x';
    if (literalAdded != std.string("hix") || cppsop.stropTail(literalAdded) != 120) return 3450;

    // A pointer operand binds the `const CharT*` overload, never the `CharT` one: the pre-fix
    // binary spelled `char* p` as `char` and failed module verification (size 3 = char overload).
    std.string sppBase = "ab";
    char[3] sppPBuf = "cd";
    char* sppP = sppPBuf;
    const char* sppCp = "cd";
    char[8] sppArr = "cd";
    char[4] sppBuf = "xy";
    char** sppPp = &sppP;
    std.string sppOther = "cd";
    char sppC = 'x';
    std.string sppPlusP = sppBase + sppP;
    if (sppPlusP.size() != 4 || sppPlusP[3] != 'd')                     return 7700;
    std.string sppPlusCp = sppBase + sppCp;
    if (sppPlusCp.size() != 4 || sppPlusCp[3] != 'd')                   return 7701;
    std.string sppPlusArr = sppBase + sppArr;
    if (sppPlusArr.size() != 4 || sppPlusArr[3] != 'd')                 return 7702;
    std.string sppPlusCstr = sppBase + sppOther.c_str();
    if (sppPlusCstr.size() != 4 || sppPlusCstr[3] != 'd')               return 7703;
    std.string sppPlusAddr = sppBase + &sppBuf[1];
    if (sppPlusAddr.size() != 3 || sppPlusAddr[2] != 'y')               return 7704;
    std.string sppPlusDeref = sppBase + *sppPp;
    if (sppPlusDeref.size() != 4 || sppPlusDeref[3] != 'd')             return 7705;
    char[3] sppSameBuf = "ab";
    char* sppSame = sppSameBuf;
    if (!(sppBase == sppSame) || sppBase == sppP || !(sppBase != sppP)) return 7706;
    if (!(sppBase < sppP) || sppBase >= sppP || !(sppBase <= sppSame))  return 7707;
    // Accept-set: a `char` operand keeps the `CharT` overload.
    std.string sppPlusC = sppBase + sppC;
    if (sppPlusC.size() != 3 || sppPlusC[2] != 'x')                     return 7708;
    sppBase += sppP;
    if (sppBase.size() != 4 || sppBase[3] != 'd')                       return 7709;

    // Pointer operand depth: a `char[4][4]` row decays to `char*`, a `?:` over `char*` arms stays
    // `char*`, and an enum class operand keeps its enum type beside an `int` overload.
    char[4][4] pdRows = default;
    pdRows[1][0] = (char)99;
    pdRows[1][1] = (char)100;
    cppsopd.Tally pdT;
    pdT.v = 200;
    if (pdT - pdRows[1] != 100101)                                      return 7800;
    std.string pdS = "ab";
    std.string pdRow = pdS + pdRows[1];
    if (pdRow.size() != 4 || pdRow[3] != 'd')                           return 7801;
    char[3] pdABuf = "cd";
    char* pdA = pdABuf;
    char[4] pdBBuf = "efg";
    char* pdB = pdBBuf;
    bool pdPickA = pdRow.size() == 4;
    std.string pdJoin = pdS + (pdPickA ? pdA : pdB);
    if (pdJoin.size() != 4 || pdJoin[3] != 'd')                         return 7802;
    cppsopd.Pick pdE = cppsopd.Pick.B;
    if (pdT + pdE != 220 || pdT + cppsopd.Pick.A != 210)                return 7803;

    // This free template also pins the existing int-literal rule.
    if (cppsop.typeCodeOf('x') != 1 || cppsop.typeCodeOf(5) != 7) return 3451;

    std.string literalAppended = std.string("a");
    literalAppended += 'x';
    if (literalAppended != std.string("ax")) return 3452;

    std.string literalMembers = std.string("abc");
    literalMembers.push_back('x');
    if ((int)literalMembers.find('x') != 3 || cppsop.stropTail(literalMembers) != 120) return 3453;

    std.string literalConstructed = std.string(3, 'x');
    if ((int)literalConstructed.size() != 3 || cppsop.stropTail(literalConstructed) != 120) return 3454;

    cppsop.LiteralCtor literalCtor = cppsop.LiteralCtor('x');
    if (literalCtor.code != 1) return 3455;

    cppsop.LiteralMember literalMember = default;
    literalMember.push_back('x');
    if (literalMember.pick('x') != 1 || literalMember.find('x') != 1
        || literalMember.value != 120) return 3456;

    cppsop.LiteralOps literalOps = default;
    cppsop.LiteralOps literalSum = literalOps + 'x';
    literalOps += 'x';
    if (literalSum.value != 1 || literalOps.value != 1 || !(literalOps == 'x')) return 3457;

    std.vector<char> literalVector = default;
    literalVector.push_back('x');
    auto literalBox = cppsop.LiteralBox('x');
    if ((int)literalVector[0] != 120 || (int)literalVector.size() != 1
        || literalBox.code != 1) return 3458;

    if (cppsop.typeCodeOf(L'x') != 14 || cppsop.typeCodeOf(u'x') != 13
        || cppsop.typeCodeOf(U'x') != 17) return 3459;

    // ---- A plain T* local releases the object it owned on reassignment (3430-3449) ----------
    // Pre-fix owner-ness was a walk-order compile-time bit: the old object leaked (every `mid`
    // below read 0), and a pointer that borrowed on the path taken freed that address at exit.
    {
        int heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        int mid = 0;
        int got = 0;
        { RpS* p = new RpS(); p = new RpS(); mid = rpDtors; }
        if (mid != 1 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase) return 3430;
        // A C++ class with class-scope operator new / delete: the old object goes through it.
        cppon.reset();
        { cppon.Cls* p = new cppon.Cls(1); p = new cppon.Cls(2); mid = cppon.clsDel(); got = p->get(); }
        if (mid != 1 || got != 2 || cppon.clsDel() != 2 || cppon.dtors() != 2 || cppon.live() != 0)
            return 3431;
        // Conditional owner, branch NOT taken: scope exit must not free the stack local's address
        // (pre-fix SIGABRT), for a CFlat struct and a C++ class.
        rpDtors = 0;
        { RpS x; RpS* q = &x; if (vrZero > 0) q = new RpS(); got = q.v; mid = rpDtors; }
        if (got != 7 || mid != 0 || rpDtors != 1 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3432;
        cppon.reset();
        { cppon.Cls x = cppon.Cls(3); cppon.Cls* q = &x; if (vrZero > 0) q = new cppon.Cls(4);
          got = q->get(); }
        if (got != 3 || cppon.dtors() != 1 || cppon.clsDel() != 0 || cppon.live() != 0) return 3433;
        // Conditional owner, branch taken, then reassigned: the taken block is released.
        rpDtors = 0;
        { RpS x; RpS* q = &x; if (vrZero == 0) q = new RpS(); q = new RpS(); mid = rpDtors; }
        if (mid != 1 || rpDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3434;
        // `p = &x` after p owned: the old object goes, then p borrows (pre-fix: freed &x, SIGABRT).
        rpDtors = 0;
        { RpS x; x.v = 5; RpS* p = new RpS(); p = &x; mid = rpDtors; got = p.v; }
        if (mid != 1 || got != 5 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3435;
        cppon.reset();
        { cppon.Cls x = cppon.Cls(3); cppon.Cls* p = new cppon.Cls(1); p = &x; mid = cppon.clsDel(); }
        if (mid != 1 || cppon.dtors() != 2 || cppon.live() != 0) return 3436;
        // `p = move q` and `p = q` (an owning q is moved by the plain store): p's old object goes,
        // p frees q's object exactly once.
        rpDtors = 0;
        bool qNull = false;
        { RpS* p = new RpS(); RpS* q = new RpS(); q.v = 9; p = move q; mid = rpDtors; qNull = q == nullptr;
          got = p.v; }
        if (mid != 1 || !qNull || got != 9 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3437;
        rpDtors = 0;
        { RpS* p = new RpS(); RpS* q = new RpS(); q.v = 9; p = q; mid = rpDtors; got = p.v; }
        if (mid != 1 || got != 9 || rpDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3438;
        // Accept-set, passes on both binaries: `delete p; p = new` and `p = nullptr` after a
        // delete release nothing twice.
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        { RpS* p = new RpS(); delete p; p = new RpS(); mid = rpDtors; RpS* d = new RpS(); delete d;
          d = nullptr; }
        if (mid != 1 || rpDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase) return 3439;
        // A loop, break, early return, a move-returning call and `p = nullptr`.
        rpDtors = 0;
        { RpS* p = new RpS(); for (int i = 0; i < 4; i++) p = new RpS(); mid = rpDtors; }
        if (mid != 4 || rpDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3440;
        rpDtors = 0;
        { RpS* p = new RpS(); for (int i = 0; i < 5; i++) { p = new RpS(); if (i == 2) break; }
          mid = rpDtors; }
        if (mid != 3 || rpDtors != 4 || (int)HeapAudit.reportLeaks() != heapBase) return 3441;
        rpDtors = 0;
        got = RpEarly(1) + RpEarly(0);
        if (got != 15 || rpDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase) return 3442;
        rpDtors = 0;
        { RpS* p = RpMake(1); p = RpMake(2); mid = rpDtors; got = p.v; RpS* n = new RpS(); n = nullptr; }
        if (mid != 1 || got != 2 || rpDtors != 3 || (int)HeapAudit.reportLeaks() != heapBase)
            return 3443;
        // A C++ exception after the reassignment: the old object was released, the new one is
        // freed by the unwind cleanup.
        rpDtors = 0;
        if (cppunw.guarded(RpUnwind, 5) != -5 || rpDtors != 2
            || (int)HeapAudit.reportLeaks() != heapBase) return 3444;
        // A primitive pointee is freed too.
        { int* ip = new int(3); ip = new int(4); got = *ip; }
        if (got != 4 || (int)HeapAudit.reportLeaks() != heapBase) return 3445;

        // Accept-set, passes on both binaries: a borrowed parameter never releases, and a local
        // borrow of the old object keeps it alive (the release is withheld when an alias of the
        // old block can reach the reassignment): `first` stays readable and deletable, a swap
        // through a temporary keeps both objects. A release there would be a use-after-free.
        heapBase = (int)HeapAudit.reportLeaks();
        rpDtors = 0;
        {
            RpS* a = new RpS();
            RpS* b = new RpS();
            b.v = 9;
            got = RpParam(a, b);
            RpS* p = new RpS();
            p.v = 5;
            RpS* first = p;
            p = new RpS();
            got = got + first.v;
            delete first;
            RpS* s = new RpS();
            RpS* t = new RpS();
            s.v = 1;
            t.v = 2;
            RpS* tmp = s;
            s = t;
            t = tmp;
            got = got * 100 + s.v * 10 + t.v;
            mid = rpDtors;
        }
        // The swap orphans s's first object (release withheld under tmp): it leaks, never adopted.
        if (got != 1421 || mid != 1 || rpDtors != 5 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3446;
        heapBase = (int)HeapAudit.reportLeaks();
        // A pointer stored into a struct field is shared: the reassignment releases nothing and
        // the field keeps reading the old object, which leaks as the pre-existing field-escape
        // leak (+1); scope exit frees the new one. Pre-fix neither was freed (+2).
        rpDtors = 0;
        {
            RpH h;
            RpS* p = new RpS();
            p.v = 11;
            h.ptr = p;
            p = new RpS();
            got = h.ptr.v;
            mid = rpDtors;
        }
        if (got != 11 || mid != 0 || rpDtors != 1 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3447;
        heapBase = (int)HeapAudit.reportLeaks();
        // The same alias rule for an array view: a local borrow of the old block withholds the
        // release (pre-fix the view freed it under `t` - a use-after-free read; now it leaks, +1).
        vrDtors = 0;
        { VrS[] v = new VrS[3]; v[0].v = 5; VrS[] t = v; v = new VrS[2]; got = t[0].v; mid = vrDtors; }
        if (got != 5 || mid != 0 || vrDtors != 2 || (int)HeapAudit.reportLeaks() != heapBase + 1)
            return 3448;

        // ---- An adopted block answers to aliases of the slot it came from (3460-3469) ----------
        // `kp` borrows a's block before `b = a` / `b = move a` hands it to b: b's later
        // reassignment or scope exit must not free it under kp (pre-fix: freed, use-after-free
        // read). The block leaks (+1) instead. Chained `q = p = new` is out of scope here.
