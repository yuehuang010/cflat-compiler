    if (t300DoubleReturn.value != 105 || t300.takeDouble(t300Source) != 105) return 30001;
    t300.IntCtor t300IntCast = (int)t300Source;
    if (t300IntCast.value != 15) return 30002;
    t300.Pick t300PickCast = (int)t300Source;
    if (t300PickCast.value != 75) return 30003;
    t300.BoolCtor t300BoolCopy = t300Source;
    if (t300BoolCopy.value != 41) return 30004;

    // Same-width C++ scalar spellings still require a fresh conversion temporary.
    long ctorrefLong = 4;
    if (thkU.mutll(ctorrefLong) != 4 || ctorrefLong != 4)                   return 7100;
    int ctorrefInt = 4;
    if (thkU.mutu(ctorrefInt) != 4 || ctorrefInt != 4)                      return 7101;
    uint ctorrefUint = 4;
    if (thkU.muti(ctorrefUint) != 4 || ctorrefUint != 4)                    return 7102;
    ulong ctorrefUlong = 4;
    if (thkU.mutll(ctorrefUlong) != 4 || ctorrefUlong != 4)                 return 7103;
    long ctorrefAddrLong = 4;
    if (thkU.addrll(ctorrefAddrLong, (void*)&ctorrefAddrLong) != 0)         return 7104;
    uint ctorrefAddrUint = 4;
    if (thkU.addri(ctorrefAddrUint, (void*)&ctorrefAddrUint) != 0)          return 7105;
    long ctorrefDirectSource = 4;
    cppcr.PlainConstLLRef ctorrefDirect = cppcr.PlainConstLLRef(ctorrefDirectSource);
    if (ctorrefDirect.same((void*)&ctorrefDirectSource) != 0)              return 7106;

    // A braced list into a C++ constructor thunk is backed by a CALLER-frame array that lives to
    // the end of the full-expression (clang: 4 63 52 2.5 69 37). Pre-fix the thunk built the list
    // itself, so each kept view read its dead, clobbered frame.
    long brcA = 3;
    long brcB = 5;
    if (thkU.arr(cppcr.ThkArr<long>({4, 5})) != 4)                          return 7150;
    if (cppcr.brc_il(cppcr.BrcIl({4, 9, 6})) != 63)                         return 7151;
    if (cppcr.brc_il(cppcr.BrcIl({brcA, brcB})) != 52)                      return 7152;
    if (cppcr.brc_ild(cppcr.BrcIlD({1.5, 2.5})) != 2.5)                     return 7153;
    if (cppcr.brc_two(cppcr.BrcTwo(1, {6, 8})) != 69)                       return 7154;
    if (cppcr.brc_two(cppcr.BrcTwo(2, {brcA, brcB})) != 37)                 return 7155;
    // Overloads differing only in element type resolve like clang (21 72 31 21 17 41); the
    // first backing fix refused every such set as "several ... overloads".
    int brcI = 3;
    double brcD = 2.5;
    if (cppcr.brc_picka(cppcr.BrcPickA({1, 2})) != 21)                      return 7156;
    if (cppcr.brc_picka(cppcr.BrcPickA({brcA + 4, brcA + 4})) != 72)        return 7157;
    if (cppcr.brc_picka(cppcr.BrcPickA({brcI, brcI})) != 31)                return 7158;
    if (cppcr.brc_pickl(cppcr.BrcPickL({1, 2})) != 21)                      return 7159;
    if (cppcr.brc_pickl(cppcr.BrcPickL({brcD, 1.5})) != 17)                 return 7160;
    if (cppcr.brc_pickl(cppcr.BrcPickL({brcI, 4})) != 41)                   return 7161;
    // Ranking covers the whole call, not the brace alone (clang: 2/1, 1/3, 1/4).
    cppcr.BrcRank brcRankL = cppcr.BrcRank(brcA, {1});
    if (brcRankL.which != 2 || brcRankL.first != 1)                        return 7162;
    cppcr.BrcRank brcRankI = cppcr.BrcRank(brcI, {3});
    if (brcRankI.which != 1 || brcRankI.first != 3)                        return 7163;
    cppcr.BrcRank brcRankLit = cppcr.BrcRank(5, {4});
    if (brcRankLit.which != 1 || brcRankLit.first != 4)                    return 7164;
    // A string literal / nullptr argument beside the list is ranked, not refused (clang: 1, 2).
    cppcr.BrcRankS brcRankStr = cppcr.BrcRankS("x", {1});
    if (brcRankStr.which != 1)                                             return 7165;
    cppcr.BrcRankS brcRankNull = cppcr.BrcRankS(nullptr, {brcD});
    if (brcRankNull.which != 2)                                            return 7166;
    // A member constructor template beside the list constructor (clang: 51, 22); the first
    // backing fix spelled its parameter as clang's internal 'type-parameter-0-0'.
    cppcr.BrcTpl<long> brcTplU = cppcr.BrcTpl<long>(brcA, {brcA, brcB});
    if (brcTplU.probe() != 51)                                             return 7167;
    cppcr.BrcTpl<long> brcTplD = cppcr.BrcTpl<long>(1, {brcD, 2.5});
    if (brcTplD.probe() != 22)                                             return 7168;
    // The remaining shapes are caller-backed too (clang values below). An inherited list ctor
    // (`using Base::Base`) already took the backed path (63, 52).
    if (cppcr.brc_il(cppcr.BrcIlInh({4, 9, 6})) != 63)                      return 7169;
    if (cppcr.BrcTplInh<long>({brcA, brcB}).probe() != 52)                  return 7170;
    // A list reaching a CLASS parameter through that class's own initializer_list ctor: the
    // thunk built the view's list itself, so the kept view read -7 garbage (32, 73, 152, 52).
    // 7172 also pins the mixed `{long, long, int}` list, refused before as "one type".
    int brcOwnerMade = cppcr.brc_owner_made;
    int brcOwnerGone = cppcr.brc_owner_gone;
    if (cppcr.BrcOwner({2, 3}).probe() != 32)                               return 7171;
    if (cppcr.BrcOwner({brcA, brcB, 7}).probe() != 73)                      return 7172;
    if (cppcr.BrcOwnerA(1, {brcA, brcB}).probe() != 152)                    return 7173;
    {
        cppcr.BrcOwner brcOwnDecl = cppcr.BrcOwner({brcA, brcB});
        if (brcOwnDecl.probe() != 52)                                      return 7174;
    }
    // Each owner constructed once and destroyed once (clang: 2 made, 2 gone for 7171-7172).
    if (cppcr.brc_owner_made - brcOwnerMade != 3
        || cppcr.brc_owner_gone - brcOwnerGone != 3)                       return 7185;
    // Function-call lists whose view the callee returns or keeps (clang: 32 42 46 35 35 93 12);
    // the brace wrapper built them inside its thunk. 7176 is the mixed `{v, v + 1}` list.
    if (cppcr.brc_read(cppcr.brc_keep({2, 3})) != 32)                       return 7175;
    if (cppcr.brc_read_a(cppcr.brc_keep_a({brcA, brcA + 1})) != 42)         return 7176;
    if (cppcr.brc_read_p(cppcr.brc_first({4, 6})) != 46)                    return 7177;
    if (cppcr.brc_read_p(cppcr.brc_first_r({brcA, brcB})) != 35)            return 7178;
    if (cppcr.brc_read_p(cppcr.brc_first_rr({brcA, brcB})) != 35)           return 7179;
    cppcr.BrcKeeper brcKeeper = cppcr.BrcKeeper(0);
    brcKeeper.set({brcA, brcB, 9});
    if (brcKeeper.probe() != 93)                                           return 7180;
    if (cppcr.brc_read_a(cppcr.BrcKeeper.skeep({6, 1})) != 12)              return 7181;
    // An `initializer_list&&` constructor binds the backed list (clang: 35); it was refused.
    if (cppcr.BrcOwnerR({brcA, brcB}).probe() != 35)                        return 7182;
    // A non-type (K) or pack ctor template beside the list ctors is ranked (clang: 1, 2 1); the
    // selector spelled `value-parameter-0-0` / skipped the pack and refused both.
    if (cppcr.BrcNt<long>(1, {2, 3}).which != 1)                            return 7183;
    if (cppcr.BrcPack<long>({brcA, brcB}).which != 2
        || cppcr.BrcPack<long>({2.5, 1.5}).which != 1)                      return 7184;
    long brcPackLong = 5;
    if (cppcr.BrcPackConstRef<long>({2, 3}, brcPackLong).which != 2)      return 7299;
    // Forwarding and non-const lvalue packs stay refused until generated wrappers can preserve
    // their category; const A&... remains rankable from its declared parameter pattern.
    int brcPackArg = 5;
    expect_error("passes an argument into a parameter pack") {
        cppcr.BrcPackFwd<long>({2, 3}, brcPackArg);
    }
    expect_error("passes an argument into a parameter pack") {
        cppcr.BrcPackFwd<long>({2, 3}, 5);
    }
    // The A&... pack cannot bind this temporary; clang picks the long overload.
    expect_error("passes an argument into a parameter pack") {
        cppcr.BrcPackLRef<long>({2, 3}, 5);
    }
    // clang picks the pair<U, A>... template (2); refused, never the silent sibling pick (1).
    expect_error("passes an argument into a parameter pack") {
        auto brcPair = cppcr.brc_pack_pair();
        cppcr.BrcPackPair<long>({2, 3}, 7, brcPair);
    }
    expect_error("passes an argument into a parameter pack") {
        auto brcArr = cppcr.brc_pack_arr();
        cppcr.BrcPackArr<long>({2, 3}, brcArr);
    }
    // Integer literals into a backed double list, and a copying list (clang: 12, 23).
    if (cppcr.brc_ild_sum({1, 2}) != 12.0 || cppcr.brc_vec({2, 3}) != 23)   return 7186;
    // Brace backing in loop and ternary control flow stays in the caller entry block. The nested
    // call keeps the view and clobbers its own frame before reading (clang: 156, 32, 42).
    long brcLoopBacking = 0;
    for (long brcI = 1; brcI <= 3; brcI += 1)
        brcLoopBacking += cppcr.brc_read_a(cppcr.brc_keep_a({brcA + brcI, brcB}));
    if (brcLoopBacking != 156)                                             return 7187;
    long brcTernaryThen = 1 ? cppcr.brc_read_a(cppcr.brc_keep_a({2, 3}))
                            : cppcr.brc_read_a(cppcr.brc_keep_a({4, 4}));
    long brcTernaryElse = 0 ? cppcr.brc_read_a(cppcr.brc_keep_a({2, 3}))
                            : cppcr.brc_read_a(cppcr.brc_keep_a({4, 4}));
    if (brcTernaryThen != 32 || brcTernaryElse != 42)                     return 7188;
    if (cppcr.brc_two_sum({1, 2}, {3, 4}) != 1234)                         return 7189;
    // Function-template initializer_list deduction keeps its array in the CFlat caller frame.
    if (cppcr.brc_read_p(cppcr.brc_template_keep({brcA, brcB})) != 35)     return 7220;
    if (cppcr.brc_read_one(cppcr.brc_template_keep({brcB})) != 5)         return 7221;
    if (cppcr.brc_template_copy({brcA, brcB}) != 35
        || cppcr.brc_template_copy({2, 3}) != 23
        || cppcr.brc_template_copy({brcB}) != 55)                          return 7222;
    cppcr.BrcTemplateElement brcTplElemA = cppcr.BrcTemplateElement(4);
    cppcr.BrcTemplateElement brcTplElemB = cppcr.BrcTemplateElement(6);
    int brcTplElemMade = cppcr.brc_template_element_made();
    int brcTplElemGone = cppcr.brc_template_element_gone();
    int brcTplElemValue = cppcr.brc_template_class_read(
        cppcr.brc_template_keep({brcTplElemA, brcTplElemB}));
    if (brcTplElemValue != 46
        || cppcr.brc_template_element_made() - brcTplElemMade != 2
        || cppcr.brc_template_element_gone() - brcTplElemGone != 2)         return 7226;
    if (cppcr.brc_template_class_copy({brcTplElemA, brcTplElemB}) != 46)  return 7228;
    int brcConvertSourceMade = cppcr.brc_convert_source_made();
    int brcConvertSourceGone = cppcr.brc_convert_source_gone();
    int brcConvertTargetMade = cppcr.brc_convert_target_made();
    int brcConvertTargetGone = cppcr.brc_convert_target_gone();
    int brcConvertKeep = 0;
    {
        brcConvertKeep = cppcr.brc_convert_read(cppcr.brc_convert_keep({
            cppcr.BrcConvertSource(4), cppcr.BrcConvertSource(6)}));
    }
    if (brcConvertKeep != 156
        || cppcr.brc_convert_source_made() - brcConvertSourceMade != 2
        || cppcr.brc_convert_source_gone() - brcConvertSourceGone != 2
        || cppcr.brc_convert_target_made() - brcConvertTargetMade != 2
        || cppcr.brc_convert_target_gone() - brcConvertTargetGone != 2)      return 7223;
    brcConvertSourceMade = cppcr.brc_convert_source_made();
    brcConvertSourceGone = cppcr.brc_convert_source_gone();
    brcConvertTargetMade = cppcr.brc_convert_target_made();
    brcConvertTargetGone = cppcr.brc_convert_target_gone();
    int brcConvertCopy = 0;
    {
        brcConvertCopy = cppcr.brc_convert_copy({cppcr.BrcConvertSource(4),
                                                  cppcr.BrcConvertSource(6)});
    }
    if (brcConvertCopy != 16
        || cppcr.brc_convert_source_made() - brcConvertSourceMade != 2
        || cppcr.brc_convert_source_gone() - brcConvertSourceGone != 2
        || cppcr.brc_convert_target_made() - brcConvertTargetMade != 2
        || cppcr.brc_convert_target_gone() - brcConvertTargetGone != 2)  return 7224;
    brcConvertSourceMade = cppcr.brc_convert_source_made();
    brcConvertSourceGone = cppcr.brc_convert_source_gone();
    brcConvertTargetMade = cppcr.brc_convert_target_made();
    brcConvertTargetGone = cppcr.brc_convert_target_gone();
    int brcConvertOne = 0;
    {
        brcConvertOne = cppcr.brc_convert_read_one(cppcr.brc_convert_keep({
            cppcr.BrcConvertSource(7)}));
    }
    if (brcConvertOne != 17
        || cppcr.brc_convert_source_made() - brcConvertSourceMade != 1
        || cppcr.brc_convert_source_gone() - brcConvertSourceGone != 1
        || cppcr.brc_convert_target_made() - brcConvertTargetMade != 1
        || cppcr.brc_convert_target_gone() - brcConvertTargetGone != 1)   return 7229;
    if (cppcr.BrcPack<long>({2, 3}, 5).which != 2)                         return 7225;
    if (cppcr.BrcPackView<long>({2, 3}, 5).probe() != 25
        || cppcr.BrcPackCopy<long>({2, 3}, 5).probe() != 23
        || cppcr.BrcPackView<long>({2}, 5).probe_one() != 4
        || cppcr.BrcPackCopy<long>({2}, 5).probe() != 2)                  return 7227;
    // Different class list targets collide as cache neighbours; clang: 225 in either order.
    if (cppcr.brc_two_diff({1, 2}, {1.5, 2.5}) != 225)                    return 7190;
    if (cppcr.brc_two_diff_rev({1.5, 2.5}, {1, 2}) != 225)                return 7191;
    // Same class template with different arguments; clang: 1217 in either order.
    if (cppcr.brc_two_tpl({1, 2}, {1.5, 2.5}) != 1217)                    return 7192;
    if (cppcr.brc_two_tpl_rev({1.5, 2.5}, {1, 2}) != 1217)                return 7193;

    // A C++ reference RETURN binds a CFlat pointer with no '&': the call's result already IS the
    // referent's address. 1970-1972 (no '&') failed to COMPILE before, with a message that printed
    // the destination's pointer type as if it were the right-hand side's; 1973 is the accept leg
    // for the '&' spelling, which always worked.
    cppi.Tracked* refretTracked = cppi.tracked_ref();
    if (refretTracked.value() != 812)                                       return 1970;
    cppi.RefCell* refretCell = cppi.ref_cell();
    refretCell.v = 771;
    // The pointer aliases the static cell, so the next call sees the write; a copy would read 770.
    if (cppi.ref_cell().v != 771)                                           return 1971;
    cppi.RefCell* refretAssign = &cppi.ref_cell();
    refretAssign = cppi.ref_cell();          // the plain-assignment twin of the declaration form
    refretAssign.v = 772;
    if (cppi.ref_cell().v != 772 || refretCell.v != 772)                     return 1972;
    // The '&' spelling stays available and yields the same address.
    cppi.RefCell* refretAmp = &cppi.ref_cell();
    if (refretAmp != refretCell)                                            return 1973;

    // ---- A member call / field read through a POINTER-typed C++ data member ----------------
    // Pre-fix a C++ field spelled `Leaf*` mapped to an opaque void* (clang writes the class name
    // with no struct/union keyword, which the pointee recovery keyed on), so the deref that
    // continues the chain never happened. Discriminators, all measured on master:
    //   `(*h.p).get()`  -> compiler SIGTRAP (exit 133), no diagnostic: void* has no sized pointee
    //   `h.p->get()`    -> "the function 'p' is not known." - 'p' fell through to a free-fn lookup
    //   `h.p->v`        -> "Undefined variable v." - the chain lost its receiver entirely
    // Each leg below therefore fails on master either by trap or by refusing to compile, and
    // asserts the VALUE the C++ side sees.
    cppi.ptrmem.Leaf pmLeaf = default;
    pmLeaf.v = 7;
    cppi.ptrmem.Poly pmBase = default;
    cppi.ptrmem.Holder pmH = cppi.ptrmem.Holder(&pmLeaf, &pmBase);

    // The three spellings of a call through the pointer member. `.` forwards through a pointer
    // per the operator-dot ruling, so all three mean the same call.
    if ((*pmH.p).get() != 7)                                                return 2000;
    if (pmH.p->get() != 7)                                                  return 2001;
    if (pmH.p.get() != 7)                                                   return 2002;
    if (pmH.p?.get() != 7)                                                  return 2003;
    if ((pmH.p)->get() != 7)                                                return 2004;
    // The by-value member is the anchor: it chained before the fix and must still chain.
    if (pmH.byval.get() != 7)                                               return 2005;

    // Data-member read through the pointer member, and a WRITE that the C++ side reads back.
    if (pmH.p->v != 7)                                                      return 2006;
    if (pmH.p.v != 7)                                                       return 2007;
    pmH.p->v = 9;
    if (cppi.ptrmem.read_leaf(pmH.p) != 9 || pmLeaf.v != 9)                    return 2008;
    pmH.p->set(7);
    if (pmLeaf.v != 7)                                                      return 2009;
    // Subscript on the pointer member (index 0 is the pointee itself).
    if (pmH.p[0].v != 7)                                                    return 2010;

    // A const-qualified pointee and a REFERENCE member reach the same path.
    if (pmH.cp->get() != 7 || pmH.cp.get() != 7)                               return 2011;
    if (pmH.r.get() != 7 || pmH.r->get() != 7)                                 return 2012;

    // VIRTUAL dispatch through a pointer member: the derived override must run, so a leg that
    // resolved statically to Poly::who would answer 1 for both.
    cppi.ptrmem.Holder pmHd = cppi.ptrmem.Holder(&pmLeaf, cppi.ptrmem.make_derived());
    if (pmHd.poly->who() != 2)                                              return 2013;
    if (pmH.poly->who() != 1)                                               return 2014;

    // Chained hops: a pointer member whose pointee has its own pointer member, the holder
    // reached through a CFlat pointer, and the holder returned BY REFERENCE from C++.
    cppi.ptrmem.Outer pmO = cppi.ptrmem.Outer(&pmH);
    if (pmO.h->p->get() != 7)                                               return 2015;
    cppi.ptrmem.Holder* pmHp = &pmH;
    if (pmHp->p->get() != 7)                                                return 2016;
    if (cppi.ptrmem.holder_ref().p->get() != 61)                               return 2017;

    // Collision axis: a free function named 'p' is in scope (see the file-scope declaration).
    // The MEMBER must win; pre-fix this leg reported "no overload of 'p' matches" instead.
    if (pmH.p->get() != 7 || p(1) != 101)                                      return 2018;

    // Accept-set anchor: the CFlat-struct holder of the same pointer type worked pre-fix and
    // must be unchanged, in all three spellings.
    PtrMemCflatHolder pmCf = default;
    pmCf.p = pmH.p;
    if (pmCf.p->get() != 7 || pmCf.p.get() != 7 || (*pmCf.p).get() != 7)       return 2019;
    // A pointer LOCAL bound off the member (the spelling that already worked) still works.
    cppi.ptrmem.Leaf* pmLocal = pmH.p;
    if (pmLocal->get() != 7)                                                return 2020;
    // Reseating the pointer member retargets the call.
    cppi.ptrmem.Leaf pmOther = default;
    pmOther.v = 3;
    pmH.p = &pmOther;
    if (pmH.p->get() != 3 || pmLeaf.v != 7)                                    return 2021;

    // ---- a CFlat scalar bound to a `const T&` parameter of a FREE function -----------------
    // The free-function binding path keeps a C++ reference parameter in the pointer-ABI shape
    // (Pointer + IsAlias), so ParameterIsAliasByPointer is false for it and the member path's
    // materialization never ran. An argument WITH storage of the exact width was handed over
    // (legs 1990) and everything else either segfaulted on an `inttoptr` of the value or was
    // refused by overload resolution.

    // No address at all: a literal was refused ("no overload ... matches").
    if (cppi.crefscalar.take_cint(41) != 42)                                   return 1980;
    // A FOLDED constant: `inttoptr (i64 41 to ptr)`, then exit 139.
    if (cppi.crefscalar.take_cint(cppi.crefscalar.Folded.k) != 42)             return 1981;
    // A scoped-enum constant through an explicit cast: same `inttoptr`, exit 139.
    if (cppi.crefscalar.take_cint((int)cppi.crefscalar.Scoped.Nine) != 10)     return 1982;
    // An arithmetic expression: `inttoptr i64 %sum`, exit 139.
    int crefBase = 40;
    if (cppi.crefscalar.take_cint(crefBase + 1) != 42)                         return 1983;
    // A NARROWER lvalue: refused, because only the identical spelling scored. The temporary
    // must hold the referent's width - a 1-byte buffer read back as `int` is garbage.
    char crefNarrow = 41;
    if (cppi.crefscalar.take_cint(crefNarrow) != 42)                           return 1984;
    // `const bool&` from a literal: refused (arg=i1, param=bool*).
    if (cppi.crefscalar.take_cbool(true) != 5)                                 return 1985;
    // `const double&` from a floating literal: refused.
    if (cppi.crefscalar.take_cdouble(21.0) != 42)                              return 1986;
    // `const long long&` from an int literal: refused, though the by-value spelling took it.
    if (cppi.crefscalar.take_clonglong(40) != 42)                              return 1987;

    // The ADDRESS the callee receives, not just the value: an exact-width lvalue must hand over
    // its OWN slot (no copy), and a literal must get a temporary that is a different object.
    int crefOwn = 41;
    u64 crefOwnAddr = (u64)(&crefOwn);
    if (cppi.crefscalar.addr_cint(crefOwn) != crefOwnAddr)                     return 1988;
    if (cppi.crefscalar.addr_cint(41) == crefOwnAddr)                          return 1989;

    // Accept-set anchors - these all bound correctly before the change and must not regress:
    // an exact-width local, a `const` local, an unscoped enum constant (which has a global
    // slot), a `bool` local, a `double` local, and a `const T&` whose T is a CLASS.
    const int crefConst = 41;
    bool crefBool = true;
    double crefDbl = 21.0;
    cppi.crefscalar.Box crefBox = default;
    crefBox.v = 42;
    if (cppi.crefscalar.take_cint(crefOwn) != 42
        || cppi.crefscalar.take_cint(crefConst) != 42
        || cppi.crefscalar.take_cint(cppi.crefscalar.PlainSeven) != 8
        || cppi.crefscalar.take_cbool(crefBool) != 5
        || cppi.crefscalar.take_cdouble(crefDbl) != 42
        || cppi.crefscalar.take_cbox(crefBox) != 45)                           return 1990;
    // A NON-const `int&` keeps taking an addressable lvalue and writing through it.
    int crefWrite = 41;
    if (cppi.crefscalar.take_ncint(crefWrite) != 42 || crefWrite != 42)        return 1991;

    // Two `const T&` candidates of different referent WIDTHS in one overload set. A reference
    // parameter has no integer identity of its own, so the referent supplies it: `const int&`
    // is identity-exact for an `int` and beats the `const long long&` widening, in BOTH
    // declaration orders. Before this ranking, declaration order decided - rk2 (`const int&`
    // first) returned the long long leg's 4041 for every int-shaped argument, while rk3 (the
    // same pair declared the other way) happened to return 3041.
    char crefRankChar = 41;
    i64 crefRankWide = 41;
    if (cppi.crefscalar.rk2(41) != 3041 || cppi.crefscalar.rk3(41) != 3041)    return 1992;
    if (cppi.crefscalar.rk2(crefRankChar) != 3041
        || cppi.crefscalar.rk3(crefRankChar) != 3041)                          return 1993;
