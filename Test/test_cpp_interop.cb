// Sections M8-M9 call libc++ members that carry no noexcept specification. Following clang,
// such calls are allowed by default (an escaping exception terminates the program);
// Test/errors/err_cpp_template_may_throw.cb proves the opt-in --cpp-strict-noexcept gate.

// End-to-end C++-interop coverage. Each section exercises one path of the C++ interop
// pipeline; on failure the section's exit code identifies which one regressed.

//   Section M3 (290-322): C++ trivially copyable records by value - layout (size, alignment,
//                       packed, over-aligned) checked against the C++ side's own sizeof/alignof,
//                       then round trips through every AArch64 arrangement clang picks: coerced
//                       small integer, two-eightbyte, HFA in float registers, indirect + sret.
//   Section M4 (330-349): C++ class members - instance methods (const and mutating, with
//                       arguments), static methods, static data member reads, dispatch through
//                       a pointer receiver, the const-overload ruling (an lvalue picks the
//                       non-const leg), and qualified scoped-enum spellings. Access control and
//                       polymorphism are covered by Test/errors/err_cpp_*.cb.
//   Section M6 (420-459): C++ inheritance and VIRTUAL dispatch - polymorphic classes laid out
//                       from clang (vptr slot + base subobjects), virtual calls through the
//                       vtable slot ItaniumVTableContext assigned, virtual destructor via the
//                       Itanium deleting-destructor slot, and multiple inheritance with a
//                       non-primary base whose `this` must be adjusted.
//   Section M5 (350-399): C++ NONTRIVIAL class lifetime - construction into the declared slot
//                       (`T(args)`), copy/move construction, copy/move assignment, exactly-once
//                       destruction on normal exit, nested scopes, early return, break and
//                       continue, nontrivial by-value arguments (copy and move) and by-value
//                       returns constructed straight into the local, plus new/delete and
//                       `unique T*` through the C++ operators. Every assertion is an EXACT
//                       instrumented count, so an extra copy or a missed destructor fails here.
//   Section M7 (460-479): HEADER-ONLY C++ - inline free functions (including one that calls
//                       another, and one with a static local), an all-inline nontrivial class,
//                       inline static data members as lifetime counters, and an all-inline
//                       VIRTUAL hierarchy with no key function. Nothing here has an out-of-line
//                       symbol, so every assertion also proves clang's definition emission
//                       landed in the linked image. Two import groups cover the same code, so a
//                       duplicate definition would fail the link instead of merging by ODR.
//   Section M8 (480-499): C++ CLASS TEMPLATES instantiated from CFlat - `cppt.Box<int>` and
//                       `cppt.Box<double>` from one header-only pattern (constructor, get/set,
//                       operator[] bound to the index expression, operator==), a per-
//                       specialization static counter, a specialization over a nontrivial C++
//                       class whose DEFAULTED destructor still has to run, and the same
//                       specialization named in two functions (one registration, one symbol).
//   Section M9 (500-529): libc++ through the same path - std.vector<int>, std.vector<double>,
//                       std.string, and the nested std.vector<std.string>, plus element
//                       destruction counted for std.vector<cppi.Tracked>.
//   Section M10 (530-549, 578-585): review follow-ups - a specialization whose element type is a POINTER
//                       (std.vector<char*>), where every member signature that names the container
//                       itself carries an inner '*' that the type mapper must not strip, and a
//                       `move` argument to a libc++ member.
//   Section M (270-289): C++ interop via `import cpp` - namespaced/overloaded declarations
//   Section M19 (725-739): C++ operator(), unary ~, and conversion operators
//                       bound by mangled linkage name, reference params and returns
//                       as pointers, extern "C" bare linkage, nested namespaces,
//                       widening and narrow-unsigned round trips, scoped-enum params,
//                       records by pointer. Primitives and bare pointers only.
//   Section M21 (766-775): C++ lazy aliases, unnamed nested enums, nullptr defaults,
//                       exact constructor ranking, and member signatures that request
//                       nested std::string specializations.
//   Section M22 (774-781): C++ function-template deduction wrappers for free functions,
//                       static and instance members, class returns, string literals, and
//                       explicit type arguments.
//   Section M23 (782-786): C++ brace-list arguments through initializer_list, a class
//                       constructor from a brace list, a class parameter, and an explicit
//                       function-template specialization.
//   Section M24 (787)    : dependent function-pointer ABI types in an uninstantiated template.
//   Section M25 (788-791): C++ header-walk implicit and defaulted special members - local
//                       destruction, copy/move construction, and a defaulted destructor.
//   Section M26 (792)    : a refused callback ABI plan does not abort the header import.
//   Section M27 (793)    : a constructor binds a primitive pointer spelled as a CFlat synonym.
//   Section M28 (794)    : a default-argument wrapper for a function returning a record.
//   Section M29 (795)    : an unreferenced inline body calling an undefined symbol is dropped
//                       before the link; its inline neighbour still binds and runs.
//   Section M30 (796-799): member default-argument wrappers for const instance and static
//                       methods, including full-argument and omitted-default calls.
//   Section M31 (800)    : an opaque union field preserves the size/alignment of an unrequested
//                       class-template specialization when the enclosing record is returned.
//   Section M32 (801-806): free C++ operator overloads are found through the operand namespace,
//                       including a nested namespace, and compound assignment falls back to '+'.
//   Section M33 (807-812): fixed-array pointer ABI, bool and class-typed member defaults,
//                       record conversion through an initializer_list wrapper, and a class
//                       const-reference return copied into a local.
//   Section M40 (900-982): the full C++ operator grid. cppi.Ops carries every MEMBER form
//                       (binary, compound, unary, subscript, call, conversion, <=> and the
//                       relational operators C++20 rewrites from it, && and ||), and
//                       cppi.opsfree.FreeOps the same list as FREE functions, plus the reversed
//                       candidates (`int == Ops`, `RevOther == Rev`), `*`/`->` forwarding, and
//                       `OpsSink << FreeOps`, whose left operand lives in another namespace.
//   Section M36 (820-823): C++ rvalue receiver lifetime handoff, bool bitfield packing, and
//                       inherited constructors forwarded through operator->.
//   Section M41 (1000-1048): virtual members whose vtable SLOT cflat cannot name, and the
//                       CONSTRUCTION of a class with virtual bases through a placement-new thunk.
//                       The fixed
//                       covariant return and virtual-base destructor use clang-synthesized thunks;
//                       adjacent guards pin the existing base-record fallback and exact by-value
//                       resource counts.
//   Section M34 (813-819): implicit scalar-to-class reference conversion, chained nontrivial
//                       class return receivers, member reference arguments/defaults, and RAII.
//   Section M43 (1060-1069): constructors declared over DEPENDENT typedefs (the c10::IListRef
//                       shape): clang only offers the dependent pattern, which the extractor now
//                       retains so the class is still constructible.
//   Section M46 (1080-1089): C++ member default wrappers with a leading long literal, comparing
//                       optional and plain trailing parameters.
//   Section M47 (1100-1109): a variadic constructor template called with named LOCALS in the
//                       `T x = T(a, b)` declaration form (the torch::nn::Sequential shape).
//   Section M45 (1090-1099): a refused member with a default-argument wrapper retries once its
//                       class-typed parameter is registered, at full and reduced arity.
//   Section M48 (1110-1119): public fields of a requested class-template specialization remain
//                       addressable through a specialization alias, even beside a same-named
//                       namespace.
//   Section M49 (1120-1129): an inferred unique_ptr returned from a C++ loader-shaped function
//                       moves its nontrivial sret result, including a by-value Dataset and a
//                       defaulted size_t-converting options class.
//   Section M51 (1140-1149): a namespace-scope C++ alias whose default template argument
//                       canonicalizes differently still names the vector element identity.
//   Section M52 (1150-1159): an inherited CRTP member template with a dependent return type and
//                       a transform that has only an implicit default constructor.
//   Section M54 (1170-1179): canonical spelling of a dependent CRTP member-template return whose
//                       template argument is a namespace-local alias, plus retrying a by-value
//                       transform apply_batch after its vector element is registered.
//   Section M57 (1200-1209): homogeneous C++ class brace arguments materialized as contiguous
//                       copies/moves for std::vector and pointer-pair SpanOf parameters.
//   Section M53 (1160-1169): auto locals move-construct nontrivial C++ sret returns before the
//                       temporary is nulled, both directly and through operator-> forwarding.
//   Section M50 (1130-1139): namespace-scope C++ using-directives resolve free functions, types,
//                       and function templates through a lookup-time namespace fallback.
//   Section M55 (1180-1189): a nontrivial C++ class built from `call() * s` and `(a + s) * t`
//                       moves the outermost operator result into the local; temporaries destroyed.
//   Section M58 (1210-1219): NON-TYPE template arguments on C++ function templates -
//                       `cppt.nth_of<0>(v)`, `box.slot<3>()`, mixed `cppt.scaled<3, int>(5)`, and
//                       `std.get<0>/<1>` on a std::tuple returned by value.
//   Section M59 (1220-1229): members inherited from a class-template-specialization base -
//                       a CRTP NormBase<D, Derived> whose members only get a body when the
//                       specialization is ODR-used, reached from plain derived classes and
//                       through a holder's operator->.
//   Section M56 (1190-1199): namespace-scope C++ constexpr variables retain their qualified
//                       names and declared enum/bool/integer types as compile-time constants.
//   Section M60 (1230-1239): C++ constructor temporaries are receivers for member calls, chained
//                       member calls, fields, declaration initializers, and const-reference args.
//   Section M61 (1240-1249): nested std::tuple returns through auto and explicit locals, nested
//                       std.get calls, a defaulted optional tuple parameter, and RAII cleanup.
//   Section M62 (1250-1259): C++ string literals and foreign class values use converting
//                       constructors at by-value call arguments; chained calls preserve references
//                       and destroy argument temporaries exactly once.
//   Section M63 (1260-1269): sibling class-template-specialization bases keep their own layout,
//                       inherited members, operator->, and inherited constructors.
//   Section M64 (1270-1279): brace overloads at parameter indices 1 and 2, defaulted and explicit
//                       options, and derived-to-base references/pointers through a two-level public
//                       hierarchy with a non-primary base and virtual dispatch.
//   Section M65 (1280-1289): a class-template specialization's nested Item keeps the enclosing
//                       specialization identity for reference-returning operator[] and front(),
//                       including two specializations in one function and a nontrivial value type.
//   Section M66 (1290-1299): heterogeneous C++ brace elements convert into one initializer_list
//                       element class, including a namespace-level using-directive re-export and
//                       destruction of the materialized nontrivial elements.
//   Section M67 (1300-1309): namespace-scope floating constexpr values retain float/double types,
//                       long double narrows to CFlat double, and all values remain usable in
//                       arithmetic, comparisons, and C++ function arguments.

//   Section M68 (1310-1319): nontrivial C++ class declaration locals initialized from call/call
//                       and constructor/constructor ternaries, with both branch outcomes and
//                       live-count cleanup; a ternary of temporaries as a call argument.
//   Section M71 (1340-1349): a parenthesized ternary used as the condition of a class-declaration
//                       ternary, with both outcomes and live-count cleanup.
//   Section M70 (1330-1339): named lvalues in class brace lists stay intact, brace temporaries
//                       are destroyed per full expression in a loop, converting constructors
//                       balance by-value and local materialization, and T(args) works for a
//                       no-standard-include aggregate with two-argument initialization.
//   Section M69 (1320-1329): one shared C++ foreign identity for positive/negative non-type
//                       template bases and unsigned-char ArrayRef-like bases, including inherited
//                       members and derived-to-base free-function conversions.
//   Section M72 (1350-1359): canonical C++ primitive identities for unsigned long, size_t,
//                       unsigned, long double, and a std::vector<size_t>-style round trip.
//   Section M73 (1360-1399): CFlat-defined no-base [cpp] structs - fields, layout, structors,
//                       ownership, move, nesting, methods, static methods, and ctor edges.
//   Section M74 (1400-1439): CFlat-defined derived [cpp] structs - one C++ base, construction,
//                       overrides, virtual dispatch, protected access, and diagnostics.
//   Section M75 (1440-1459): C++ struct return adoption, destructor counts, and closure rows.
//   Section M76 (1460-1479): C++ class-template specializations as [cpp] struct bases,
//                       including base initializers, virtual dispatch, move cleanup, and fields.
//   Section M77 (1480-1499): C++ by-value return temporaries and inherited member-template lookup,
//                       including constructor and sret returns, nested returns, unrelated temps,
//                       and implicit/explicit receiver spellings.
//   Section M78 (1500-1553): std::make_shared/std::shared_ptr of CFlat-defined [cpp] structs,
//                       generated constructors/destructors, virtual dispatch, conversions,
//                       recursive template arguments, incomplete ordering, move ownership,
//                       promotion, receiver sret, member-template overloads, and ref/value rank.
//   Section M79 (1554-1557): C++ exceptions caught at the `program` boundary, including a
//                       two-frame CFlat call chain and a normal program run afterward.
//   Section M80 (1560-1575): generic CFlat-defined [cpp] structs - one C++ class per
//                       instantiation, dependent C++ base initializers, override dispatch,
//                       destructor counts, move construction, and a no-base field generic.
//   Section M83 (1576-1580): a class-template specialization named through a GLOBAL-scope C++
//                       alias or typedef - both spellings reach one record.
//   Section M85 (1600-1614): namespace-scope C++ OBJECTS - out-of-line extern scalars,
//                       class-typed objects and const ones, nested and inline namespaces, a
//                       global-scope object, header-only constants that need their own storage,
//                       and a write through a mutable one. Test/errors/err_cpp_namespace_const_
//                       assign.cb covers the rejected writes.
//   Section M87 (1660-1678): imported mixed-type C++ bitfields follow Itanium allocation units;
//                       overflow still splits, short/int and bool/int use the widest unit, and
//                       same-type runs preserve their existing layout.
//   Section M89 (1680-1685): unnamed zero-width C++ bitfields close an allocation unit under
//                       both same-type and mixed-type neighbours; fields and sizeof agree with C++.
//   Section M90 (1690-1709): initializing a local of a NONTRIVIAL C++ class from an lvalue that
//                       is not a bare identifier - a dot field, an arrow field, a dereference,
//                       a namespace-scope object and a vector element - must copy-CONSTRUCT.
//                       Every leg reads a refcount or a heap string the source still owns, so a
//                       bitwise store (the pre-fix lowering) shows up as a low use_count and a
//                       double release.
//   Section M84 (1590-1599): a CLASS-typed subscript index - a named std.string lvalue as a
//                       std.map key (incremented twice, and not moved from), the same key
//                       through find/count, a struct field and a dereferenced pointer as
//                       keys, a user-header C++ class key, and a CFlat-native operator[]
//                       whose index parameter is a struct.
//   Section M93 (1750-1768): class-scope `static const` with an in-class initializer and no
//                       out-of-line definition - folded by value across int/unsigned/long long/
//                       bool/char/plain and scoped enum, a chained initializer, a nested class,
//                       a member that also has an out-of-line definition, use as an array bound
//                       and a switch case, and the constexpr / inline-const / out-of-line
//                       neighbours that already bound.
//   Section M82 (1615-1638): C++ scoped-enum identity in free/member overload matching,
//                       converting constructors, references, explicit casts, templates, and
//                       measured preservation of unscoped enum conversions.
//   Section M81 (1640-1658): C++ member ref-qualifiers preserve lvalue/rvalue receiver
//                       selection for assignment, fields, dereferences, elements, calls,
//                       temporaries, explicit move, and null-conditional forwarding.
//   Section M94 (1790-1805): a CFlat string LITERAL as the operand of a C++ operator - it is
//                       the 'char*' it lowers to, not a CFlat 'string', so it binds
//                       'operator+=(const char*)' on std.string and on a user class, picks the
//                       char* leg over the std::string one, reaches a free operator on either
//                       side of the class operand, and still refuses a 'char' parameter
//                       (Test/errors/err_cpp_string_literal_operator_char.cb). The char* local,
//                       std.map literal key, char literal and CFlat-native string legs are
//                       controls that behaved identically before the fix.
//   Section M91 (1710-1715): a C++ namespace whose declarations ALL name a std:: specialization
//                       (parameter, return by value, nested namespace) is registered even
//                       though binding those signatures is deferred to first use; nsstd_mix is
//                       the control that one std-free declaration already registered.
//   Section M92 (1730-1749): qualified C++ class-template constructor temporaries in CFlat
//                       call arguments, C++ free/member calls, returns, assignment RHS,
//                       zero/two-argument constructors, nested specializations, and user types.
//   Section M95 (1810-1829): STATIC members of a C++ class TEMPLATE reached through the
//                       qualified specialization spelling - static methods with 0/1/2
//                       arguments, a static data member read and written, a static
//                       constexpr member, specializations over a primitive, a user C++
//                       class and another specialization, the call in statement / argument
//                       / condition position, a specialization instantiated ONLY by the
//                       static call, and the spelling inside a CFlat generic body.
// Section M: C++ interop - `import cpp` selects C++ mode; the extension is irrelevant (the
// fixture header is a plain .h). The header supplies the declarations, the .cpp is compiled
// by the host C++ driver and linked in. Both are needed: the header alone has no
// definitions, and the source alone would not exercise the header-extraction path.
import cpp "library/cpp_interop_basic.h" cache;
import cpp "library/cpp_interop_basic.cpp" cache;
// Section M6: inheritance and virtual dispatch. Definitions are out-of-line on purpose - every
// virtual function needs a real symbol and the vtable needs a key function.
import cpp "library/cpp_interop_poly.h" cache;
import cpp "library/cpp_interop_poly.cpp" cache;
// Section M7: HEADER-ONLY C++ - no .cpp anywhere. Every definition is inline in the header, so
// clang CodeGen has to emit the bodies, vtables and inline statics into the companion module.
// The second header re-includes the first from a DIFFERENT import group, which is the
// duplicate-definition (ODR merge) check.
import cpp "library/cpp_interop_inline.h" cache;
import cpp "library/cpp_interop_inline_again.h" cache;
// Section M8: one header-only CLASS TEMPLATE pattern. No specialization has a symbol anywhere
// until a CFlat declaration asks for one, so every M8 assertion also proves the instantiation
// path emitted the bodies. Section M9 needs no fixture at all - the libc++ headers are the
// fixture, reached by the SYSTEM header spelling below.
import cpp "library/cpp_interop_tpl.h" cache;
import cpp "library/cpp_interop_by_value.h" cache;
import cpp "vector" cache;
import cpp "tuple" cache;
import cpp "mutex" cache;
import cpp "chrono" cache;
import cpp "string" cache;
import cpp "map" cache;
import cpp "functional" cache;
import cpp "library/cpp_interop_throw.h" cache;
import cpp "library/cpp_interop_scoped_enum.h" cache;
import cpp "library/cpp_interop_nsstd.h" cache;
import cpp "library/cpp_interop_strop.h" cache;
import "list.cb";
import "thread.cb";
import "malloc_allocator.cb";

