    // before the fold each of these reported "'k' does not name a value here".
    if (cppi.statconst.InClass.k != 41)                   return 1750;
    if (cppi.statconst.InClass.ku != 4000000001)          return 1751;
    if (cppi.statconst.InClass.kll != 9000000000)         return 1752;
    if (cppi.statconst.InClass.kb != true)                return 1753;
    if (cppi.statconst.InClass.kc != 'Q')                 return 1754;
    if ((int)cppi.statconst.InClass.ke != 8)              return 1755;
    if (cppi.statconst.InClass.kse != cppi.statconst.Scoped.SB) return 1756;

