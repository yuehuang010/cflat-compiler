    if (cppa.ctor_count() == 4 && arrelemH[0].v == 7 && arrelemH[3].v == 7) arrelemOk = 1;
    delete arrelemH;
    if (arrelemOk != 1 || cppa.dtor_count() != 4) return 1877;

