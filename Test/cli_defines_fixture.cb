// Fixture for the CLI -D regression driven by test.sh / test.bat. Deliberately not named
// test_*.cb: it only compiles when the driver supplies CLI_DEF_ON, CLI_DEF_LEVEL and
// CLI_DEF_TAG. Covers a define as an if const condition, as an ordinary value, and as a
// compile-time constant inside generic code.

// A define is a constant everywhere a constant is legal, including a global initializer.
int gScaled = CLI_DEF_LEVEL * 2;
const int CLI_CONST_LANES = 16;

// Generic groundwork: a define sizes a fixed array member of a generic struct, so the
// monomorphized shell is built from it in the ForwardRefScanner pass.
struct Buf<T, int N>
{
    T[N] items = default;
    int count;

    void add(T v)
    {
        if (count < N) { items[count] = v; count = count + 1; }
    }

    int cap() { return N; }
};

struct Wrap<T, int N>
{
    Buf<T, N> b = default;
    int cap() { return b.cap(); }
};

struct MemberSelect<T, int N>
{
    if const (N == 8)
    {
        int selected = 80;
    }
    else
    {
        int selected = 40;
    }

    int get() { return selected; }
};

int value<T, int N>() { return N; }

// Generic groundwork: a define selects which arm a generic body specializes to, the same
// mechanism is_pointer(T) / is_unique(T) use.
T pick<T>(T a, T b)
{
    if const (CLI_DEF_ON)
    {
        return a;
    }
    else
    {
        return b;
    }
}

extern int main()
{
    if const (CLI_DEF_ON)
    {
        printf("mode=on level=%d tag=%s\n", CLI_DEF_LEVEL, CLI_DEF_TAG);
    }
    else
    {
        printf("mode=off level=%d tag=%s\n", CLI_DEF_LEVEL, CLI_DEF_TAG);
    }

    // Define as a value: local fixed-array bound, loop bound, and arithmetic.
    int[CLI_DEF_LEVEL] local;
    int sum = 0;
    for (int i = 0; i < CLI_DEF_LEVEL; i++)
    {
        local[i] = i;
        sum = sum + local[i];
    }
    printf("value sum=%d scaled=%d\n", sum, gScaled);

    Buf<int, 8> b = default;
    Buf<int, CAP * 2> c = default;
    // A BARE identifier value argument - a -D define and a file-scope const int global. This is
    // the spelling the manual leads with, and it was dead in both passes until the folder
    // learned to accept a bare genericIdentifier node.
    Buf<int, CAP> bare = default;
    Buf<int, CLI_CONST_LANES> konst = default;
    b.add(3);
    b.add(4);
    printf("generic cap=%d alias=%d count=%d pick=%d\n", b.cap(), c.cap(), b.count, pick<int>(10, 20));

    MemberSelect<int, 8> memberSelect = default;
    Wrap<int, 8> wrapped = default;
    printf("value bare=%d constarg=%d\n", bare.cap(), konst.cap());
    printf("value member=%d function=%d negative=%d nested=%d\n",
           memberSelect.get(), value<int, 8>(), value<int, -1>(), wrapped.cap());

    simd<float, CLI_SIMD_LANES> defineLanes = 3.0;
    simd<float, CLI_CONST_LANES> constLanes = 4.0;
    printf("simd define=%d const=%d\n", (int)defineLanes[0], (int)constLanes[0]);
    return 0;
}
