// Declaration errors: missing returns, enums, generics, interfaces, overloads

int add(int a, int b) { return a + b; }

struct Point
{
    int x = 0;
    int y = 0;
};

interface IGreet
{
    int greet();
};

expect_error("missing a return statement") {
    int test_missing_return(int x)
    {
        int y = x * 2;
    }
}

expect_error("missing return statement") {
    int test_lambda_missing_return()
    {
        function<int(int)> f = (int x) => { int y = x + 1; };
        return 0;
    }
}

expect_error("enum value must be a constant integer expression") {
    enum BadEnum : int { A = 1, B = "hello" };
}

expect_error("from a value of type 'T115LocalDiagnostic'") {
    int t115_local_enum_diagnostic()
    {
        enum T115LocalDiagnostic : int { Value = 1 };
        T115LocalDiagnostic local = T115LocalDiagnostic.Value;
        int* pointer = local;
        return 0;
    }
}

expect_error("'A' is not a member of namespace 'E'") {
    int t115_unavailable_enum<T>(T x) { return (int)E.A + (int)x; }
    int trigger_t115_unavailable_enum()
    {
        enum E : int { A = 10 };
        return t115_unavailable_enum<int>(0);
    }
}

expect_error("Generic type parameter must be an identifier, not a built-in type") {
    struct Box<int> { int value = 0; };
}

struct BareGeneric<T> { T value = default; };
expect_error("is a generic type; type arguments are required") {
    int test_bare_generic_name()
    {
        BareGeneric value = default;
        return 0;
    }
}

struct EmptyArgField<T> { T value = default; };
expect_error("is a generic type; type arguments are required") {
    struct BareGenericFieldUse { EmptyArgField<> value = default; };
}

struct EmptyArgLocal<T> { T value = default; };
expect_error("is a generic type; type arguments are required") {
    int test_empty_generic_type()
    {
        EmptyArgLocal<> value = default;
        return 0;
    }
}

struct PlainTypeArgProbe { int value = 0; };
expect_error("is not a generic type") {
    int test_empty_plain_type_arg()
    {
        PlainTypeArgProbe<> value = default;
        return 0;
    }
}

expect_error("is not a generic type") {
    int take_empty_plain_type_arg(PlainTypeArgProbe<>* value) { return 0; }
}

expect_error("generic definition needs at least one type parameter") {
    struct EmptyGenericStruct<> { int value = 0; };
}

expect_error("generic definition needs at least one type parameter") {
    interface EmptyGenericInterface<> { int f(); };
}

expect_error("generic definition needs at least one type parameter") {
    int emptyGenericFunction<>() { return 0; }
}

expect_error("generic definition needs at least one type parameter") {
    struct EmptyGenericMethodDefinitionProbe { int m<>() { return 0; } };
}

expect_error("generic function 'm' expects 1 type argument(s), but the call provides 0") {
    struct EmptyGenericMethodProbe { int m<T>(T value) { return 0; } };
    int test_empty_generic_method_call()
    {
        EmptyGenericMethodProbe value = default;
        return value.m<>(1);
    }
}

expect_error("does not implement") {
    class Foo : IGreet
    {
        int x = 0;
    };
}

expect_error("named argument") {
    int test_named_arg_mismatch()
    {
        int result = add(z: 1, b: 2);
        return result;
    }
}

expect_error("no overload of 'operator string'") {
    int test_operator_string_missing()
    {
        Point p;
        p.x = 1;
        p.y = 2;
        string s = operator string(p);
        return 0;
    }
}

struct T75NoCharCtor
{
    int value = 0;
};

expect_error("cannot store a pointer value into struct storage") {
    void t75LiteralCastWithoutCharCtor()
    {
        T75NoCharCtor value = (T75NoCharCtor)"abc";
    }
}

expect_error("cannot store a pointer value into struct storage") {
    void t75PointerCastWithoutCharCtor()
    {
        (const char)* source = "abc";
        T75NoCharCtor value = (T75NoCharCtor)source;
    }
}

// A raw-pointer left operand with a struct right operand and no matching overload used to
// fall through to the builtin comparison and emit a malformed icmp (ptr vs struct).
expect_error("no overload of 'operator==' matches operands 'Point*' and 'Point'") {
    int test_ptr_vs_struct_no_overload()
    {
        Point p;
        Point* pp = &p;
        if (pp == p) { return 1; }
        return 0;
    }
}

// A null literal against a non-string struct keeps the pointer-vs-struct diagnostic.
struct NullCmpFoo { int v = default; };
expect_error("no overload of 'operator==' matches operands 'pointer' and 'NullCmpFoo'") {
    int test_nullptr_vs_plain_struct()
    {
        NullCmpFoo f = default;
        if (nullptr == f) { return 1; }
        return 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_lt_rhs_local()
    {
        string value = "x";
        return value < nullptr ? 1 : 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_ge_lhs_local()
    {
        string value = "x";
        return nullptr >= value ? 1 : 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_eq_rhs_local()
    {
        string value = "x";
        return value == nullptr ? 1 : 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_eq_lhs_local()
    {
        string value = "x";
        return nullptr == value ? 1 : 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_ne_rhs_local()
    {
        string value = "x";
        return value != nullptr ? 1 : 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_ne_lhs_local()
    {
        string value = "x";
        return nullptr != value ? 1 : 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strIsNullish(string value) { return value == nullptr ? 1 : 0; }
}

struct StrNullFieldHolder { string value = "x"; };
expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_field()
    {
        StrNullFieldHolder holder = default;
        return holder.value == nullptr ? 1 : 0;
    }
}

string strNullCallResult() { return "x"; }
expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_call_result()
    {
        return strNullCallResult() != nullptr ? 1 : 0;
    }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_generic<T>(T value) { return value == nullptr ? 1 : 0; }
    int strnull_generic_trigger() { return strnull_generic<string>("x"); }
}

expect_error("a 'string' is a value type and cannot be compared to nullptr") {
    int strnull_parenthesized_null()
    {
        string value = "x";
        return (nullptr) != value ? 1 : 0;
    }
}

// A failed declaration inside expect_error must not leave a dead shell that shadows the valid
// outer type in the same namespace.
namespace ExpectOuter { struct ExpectItem { int value = 9; }; }
namespace ExpectScope
{
    expect_error("nullable '?' is not allowed on primitive type 'int'") {
        struct ExpectItem { int? bad = 0; };
    }
    int useOuterItem()
    {
        ExpectOuter.ExpectItem item = default;
        return item.value;
    }
}

extern int main()
{
    return 0;
}

// Two definitions of ONE overload slot. Before this was diagnosed the first body silently won and
// the second was unreachable, so all three legs below compiled and ran the wrong one. The
// discriminator is the source LINE: a file processed twice (as the primary input and as its own
// import) re-attaches the same body at the same line and must stay silent, which is why the plain
// duplicate needs its own leg rather than being assumed to follow from the spelling cases.
expect_error("redefinition of 'dupExact'") {
    int dupExact(int x) { return 100 + x; }
    int dupExact(int x) { return 200 + x; }
}

// `int` and `i32` name one type (doc/LANGUAGE.md), so these are the same parameter list. They used
// to coexist AND pick each other's arguments: `dupSpelling(1)` reached the `i32` body while an
// `i32` variable reached the `int` one.
expect_error("redefinition of 'dupSpelling'") {
    int dupSpelling(int x) { return 100 + x; }
    int dupSpelling(i32 x) { return 200 + x; }
}

// The same identity has to hold INSIDE a function-pointer signature, which reaches the mangled
// name through a different path (ToUniqueString's funcptr arm, not its scalar arm).
expect_error("redefinition of 'dupSigSpelling'") {
    int dupSigSpelling(function<int(int)> f) { return 1000 + f(1); }
    int dupSigSpelling(function<i32(i32)> f) { return 2000 + f(1); }
}

/*
 * A REPEAT extern declaration whose signature disagrees with the one already bound to that
 * linkage name used to return silently as a "repeat declaration under the same lookup name",
 * so the second spelling was dropped and its calls bound the first. Core declares
 * `extern void exit(int status);`, so `exit(300)` through this u8 respelling passed i32 and
 * exited 44 - the declared u8 was never scored and the no-implicit-narrowing ruling was
 * bypassed by spelling.
 */
// The expectation also pins the EXISTING signature: without it the message could not tell the
// user which declaration it is disagreeing with.
// The tail is pinned too: it is what separates the generic arm from the file-I/O arm below,
// which must NOT ride along on an unrelated collision.
expect_error("conflicting declaration of extern 'exit': the linkage name is already declared as 'void(int)', but this declaration is 'void(u8)'. Rename your extern, or call the existing one.") {
    extern void exit(u8 c);
}

// Same hole through a core extern that has a BODY (cruntime's putchar(int)) rather than a
// bare prototype - a different registration path to the same linkage name.
expect_error("conflicting declaration of extern 'putchar': the linkage name is already declared as 'int(int)', but this declaration is 'int(u8)'") {
    extern int putchar(u8 c);
}

// A bare user extern colliding with a NAMESPACED core extern (os.windows.WriteFile, whose
// linkage name is the bare WriteFile). The core symbol lives under its namespace in the
// function table, so the existing signature has to be found by linkage name, not by lookup
// name - this leg is what proves that search reaches a namespaced owner.
// Windows-only: os.windows.cb is imported by os.cb only under __WIN64__/__WIN32__, so off
// Windows there is no existing WriteFile to collide with and the expectation never fires.
if const (__WINDOWS__) {
expect_error("conflicting declaration of extern 'WriteFile': the linkage name is already declared as 'int(void*, char*, int, int*, void*)'") {
    extern u32 WriteFile(void* h, void* buf, u64 n, void* written, void* ov);
}
}

// The file-I/O remedy is a separate message, emitted only for the stdio names os.windows
// republishes. Every other collision above must NOT carry it.
expect_error("conflicting declaration of extern 'fopen': the linkage name is already declared as 'void*(char*, char*)', but this declaration is 'int(int)'. Rename your extern, or call the existing one - for file I/O use os.windows.fopen/fread/fwrite/fclose.") {
    extern int fopen(int x);
}

namespace t458NativePlain
{
    struct Plain { int value = 0; };
    expect_error("is not a generic type") { Plain<> global = default; }
    expect_error("is not a generic type") {
        struct Holder { Plain<> field = default; };
    }
    expect_error("is not a generic type") {
        int local() { Plain<> value = default; return 0; }
    }
    expect_error("is not a generic type") { int take(Plain<>* value) { return 0; } }
    expect_error("is not a generic type") { Plain<>* give() { return nullptr; } }
}
expect_error("is not a generic type") {
    t458NativePlain.Plain<> qualified = default;
}
