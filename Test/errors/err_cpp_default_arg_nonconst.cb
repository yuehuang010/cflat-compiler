import cpp "cpp_interop_basic.h";
import cpp "cpp_t22_constrained_members.hpp";

extern int main()
{
    expect_error("call to 'cppi.PrivateDefaultArg.call' omits parameter 'value' whose default argument is not a constant expression") {
        cppi.PrivateDefaultArg.call();
    }
    cppi.DefaultRankOnly value = cppi.DefaultRankOnly();
    expect_error("ambiguous call to 'cppi.default_rank'") {
        cppi.default_rank(value);
    }
    cppi.DefaultRankHost host = cppi.DefaultRankHost();
    expect_error("ambiguous call to 'rank'") {
        host.rank(value);
    }
    cppi.DefaultRankTemplateOnly box = cppi.DefaultRankTemplateOnly();
    expect_error("ambiguous call to 'rank'") {
        box.rank(value);
    }
    // Unordered constrained twins: a call that selects the full-arity forwarder is clang's ambiguity.
    if const (!__WINDOWS__)
    {
        expect_error("clang: call to member function 'pick' is ambiguous") {
            cflat_t22.UnorderedDefault<int> unordered = default;
            int selected = unordered.pick(5);
        }
    }
    return 0;
}
