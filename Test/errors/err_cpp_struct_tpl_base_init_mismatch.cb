import cpp "cpp_interop_tpl.h";

expect_error("base initializer names 'cppt.tplbase.Holder<double>' but the base class is 'cppt.tplbase.Holder<int>'") {
    struct Bad : cppt.tplbase.Holder<int>
    {
        Bad(int value) : cppt.tplbase.Holder<double>(value) { }
    };
}

extern int main() { return 0; }
