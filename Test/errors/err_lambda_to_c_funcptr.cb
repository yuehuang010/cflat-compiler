// A CFlat closure (lambda or `function<>` variable) is a 16-byte {code, env} fat pointer; a C
// function pointer is a bare code address with no env slot. Handing a closure across the C ABI
// would drop the captured state and crash at runtime, so the compiler must reject it. The
// supported form is passing a non-capturing named function directly.

// A single captured variable: the diagnostic names it exactly.
expect_error("this lambda captured 1 variable [bias]") {
    extern void qsort(void* base, u64 num, u64 size, function<int(void*, void*)> cmp);

    int sortFour()
    {
        int[4] a = {3, 1, 2, 0};
        int bias = 1;
        // Capturing lambda passed where C wants a bare function pointer - rejected.
        qsort(&a[0], 4u, 4u, (void* x, void* y) => {
            int* ix = (int*)x; int* iy = (int*)y;
            return (*ix - *iy) * bias;
        });
        return a[0];
    }
}

// The same rule holds through a virtual (interface) slot, positionally and by name: the thin
// `function<>` parameter is still a bare code pointer, so a capturing lambda is rejected there
// with the same diagnostic rather than reaching the LLVM verifier.
expect_error("this lambda captured 1 variable [factor]") {
    interface IFnErr { void run(function<int(int)> fn); };
    class FnErrImpl : IFnErr { void run(function<int(int)> fn) { printf("%d\n", fn(5)); } };

    void callIfacePositional()
    {
        FnErrImpl impl;
        IFnErr io = impl;
        int factor = 4;
        io.run((int x) => { return x * factor; });
    }
}

expect_error("this lambda captured 1 variable [scale]") {
    interface IFnErrNamed { void run(function<int(int)> fn); };
    class FnErrNamedImpl : IFnErrNamed { void run(function<int(int)> fn) { printf("%d\n", fn(5)); } };

    void callIfaceNamed()
    {
        FnErrNamedImpl impl;
        IFnErrNamed io = impl;
        int scale = 4;
        io.run(fn: (int x) => { return x * scale; });
    }
}

// More than 5 captures: the diagnostic lists the first 5 and summarizes the remainder.
expect_error("this lambda captured 7 variables [c0, c1, c2, c3, c4, ... (and 2 more)]") {
    extern void qsort(void* base, u64 num, u64 size, function<int(void*, void*)> cmp);

    int sortSeven()
    {
        int[2] a = {1, 0};
        int c0 = 0; int c1 = 1; int c2 = 2; int c3 = 3;
        int c4 = 4; int c5 = 5; int c6 = 6;
        qsort(&a[0], 2u, 4u, (void* x, void* y) => {
            int* ix = (int*)x; int* iy = (int*)y;
            return (*ix - *iy) + c0 + c1 + c2 + c3 + c4 + c5 + c6;
        });
        return a[0];
    }
}

// The same rule on a GENERIC-substituted THIN field. `Box<function<int(int)>>.item` is the same
// bare code pointer as a spelled `function<int(int)>` field, so a capturing lambda assigned to it
// must be refused with the SAME diagnostic rather than silently dropping the env. Pre-fix this
// shape reported "cannot cast an aggregate value - a fixed array decays to a pointer..." (the
// generic field had a struct backing), which named neither the capture nor the closure rule.
expect_error("it captured 1 variable [bias2]") {
    struct LcfBox<T> { T item = default; };

    void capturingLambdaIntoThinGenericField()
    {
        LcfBox<function<int(int)>> b = default;
        int bias2 = 7;
        b.item = (int x) => x + bias2;
    }
}

// Same rule through the BRACE-INIT spelling, which is a different emission path (EmitOneFieldInit,
// not the `=` assignment). Pre-fix the brace path applied NO thin/fat conversion at all, so this
// landed in the module verifier with no source location - on the plain field too. The generic
// spelling is used here because it is the one the closure-element work touched.
expect_error("it captured 1 variable [bias3]") {
    struct LcfBraceBox<T> { T item = default; };

    void capturingLambdaBraceInitIntoThinField()
    {
        int bias3 = 7;
        LcfBraceBox<function<int(int)>> b = { item = (int x) => x + bias3 };
    }
}
