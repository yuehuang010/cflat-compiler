// [immovable] (T90) F3: a bare stack<Node> declaration of an immovable element is refused by the container
// itself (a compile_error in the core stack relocating method), named at the declaration. File-scope
// expectation: the core error is deferred past the scoped form, so the declaration sits in main.
import "stack.cb";
[immovable] struct Node { int x = 0; int hash() { return x; } bool operator==(alias Node o) { return x == o.x; } };
expect_error("stack<T>: element type is [immovable]");
extern int main() { stack<Node> v; return 0; }
