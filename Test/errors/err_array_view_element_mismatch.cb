// A view indexes by its own ELEMENT, so binding one to a destination whose element differs
// strides and loads with the wrong shape. Before: the binding doors checked view-ness only,
// so 'B<int*[]> b; b.p = intView;' compiled silently (element stride 4 over an array of
// pointers) and the generic 'W<T[]>.v = T*[]' spelling died as a raw module-verifier dump.

struct AvmBox<T> { T v = default; };
struct AvmPtrBox<T> { T* p = default; };
struct AvmPlain { int[] v = default; };
struct AvmFoo { int a = default; };
struct AvmBar { int b = default; };
interface AvmIface { int area(); };
struct AvmIfaceHolder { int[] view = default; };

int avmTakeIntIface(int[] d) { return d[0]; }

expect_error("cannot return an array view of 'AvmIface' from a function whose return element is 'int'") {
    int[] avmReturnIface(AvmIface[] q) { return q; }
}

// Return leg: the declared element is 'int', the returned view's element is 'int*'.
expect_error("cannot return an array view of 'int*' from a function whose return element is 'int'") {
    int[] avmReturnStar(int*[] q) { return q; }
}

// An interface view element carries ONE interface's fat pointer, and no rebox is emitted per
// element, so any other interface (parent or child) dispatches through the wrong vtable.
interface AvmIfaceB { int perimeter(); };
interface AvmIfaceChild : AvmIface { int extra(); };
class AvmImpl : AvmIface { int s = default; int area() { return s * s; } };
struct AvmIfaceBHolder { AvmIfaceB[] v = default; };

expect_error("cannot return an array view of 'AvmIface' from a function whose return element is 'AvmIfaceB'") {
    AvmIfaceB[] avmReturnCrossIface(AvmIface[] q) { return q; }
}

// Widening a CHILD interface view to its parent is the same hole: the elements hold the child
// vtable, which only accidentally shares a prefix with the parent's (and not for a 2nd parent).
expect_error("cannot return an array view of 'AvmIfaceChild' from a function whose return element is 'AvmIface'") {
    AvmIface[] avmReturnChildIface(AvmIfaceChild[] q) { return q; }
}

// A '?:' join of two views is a bare thin pointer, so the join must carry its arms' element or
// every binding door below judges an unnamed value and accepts silently.
expect_error("cannot return an array view of 'u8' from a function whose return element is 'int'") {
    int[] avmReturnTernary(u8[] a, u8[] b, bool c) { return c ? a : b; }
}

expect_error("cannot return an array view of 'AvmIface' from a function whose return element is 'AvmIfaceB'") {
    AvmIfaceB[] avmReturnTernaryIface(AvmIface[] a, AvmIface[] b, bool c) { return c ? a : b; }
}

// Arms that disagree on the element have no common element to hand a door, so the join itself
// is the error - there is no destination whose element could make both arms right.
expect_error("cannot join an array view of 'int' with an array view of 'u8' in a '?:'") {
    int[] avmJoinDisagree(int[] a, u8[] b, bool c) { int[] r = c ? a : b; return r; }
}

// A '?:' ARM that reads a struct FIELD names no local slot, so it used to stay unnamed, nothing
// was stamped on the join and every door took its unnamed escape. A field's element lives on the
// field's own declaration; these legs all compiled clean before that recovery existed.
struct AvmU8Holder { u8[] v = default; };
struct AvmU8Outer { AvmU8Holder inner = default; };
struct AvmIfaceViewHolder { AvmIface[] v = default; };

expect_error("cannot return an array view of 'u8' from a function whose return element is 'int'") {
    int[] avmReturnFieldArm(AvmU8Holder h, u8[] b, bool c) { return c ? h.v : b; }
}

// A field read off a CALL RESULT never reaches memory - it is an aggregate extract, not a GEP -
// and a '?.' merge drops the field GEP before the arm is judged. Both used to escape.
AvmU8Holder avmMakeU8Holder(u8[] b) { AvmU8Holder h = default; h.v = b; return h; }
AvmU8Outer avmMakeU8Outer(u8[] b) { AvmU8Outer o = default; o.inner.v = b; return o; }

int avmTakeInt(int[] d) { return d[1]; }

extern int main()
{
    int one = 1; int two = 2;
    int*[2] cells; cells[0] = &one; cells[1] = &two;
    int*[] pview = cells;

    int[3] store; store[0] = 10; store[1] = 20; store[2] = 30;
    int[] iview = store;

    AvmIface[] avmIfaceView = new AvmIface[1];

    // Interface view source: declaration initializer.
    expect_error("cannot bind an array view of 'AvmIface' to a destination of 'int'") {
        int[] avmIfaceDecl = avmIfaceView;
    }

    // Interface view source: field store.
    expect_error("cannot bind an array view of 'AvmIface' to a destination of 'int'") {
        AvmIfaceHolder avmIfaceHolder = default;
        avmIfaceHolder.view = avmIfaceView;
    }

    // Interface view source: call argument.
    expect_error("cannot pass an array view of 'AvmIface' as parameter 'd' of 'avmTakeIntIface', whose element is 'int'") {
        int avmIfaceResult = avmTakeIntIface(avmIfaceView);
    }

    // Cross-interface view: declaration initializer.
    expect_error("cannot bind an array view of 'AvmIface' to a destination of 'AvmIfaceB'") {
        AvmIfaceB[] avmCrossDecl = avmIfaceView;
    }

    // Cross-interface view: field store.
    expect_error("cannot bind an array view of 'AvmIface' to a destination of 'AvmIfaceB'") {
        AvmIfaceBHolder avmCrossHolder = default;
        avmCrossHolder.v = avmIfaceView;
    }

    // Narrowing a PARENT interface view to a child: the parent vtable has no child slot.
    expect_error("cannot bind an array view of 'AvmIface' to a destination of 'AvmIfaceChild'") {
        AvmIfaceChild[] avmNarrowed = avmIfaceView;
    }

    // A CLASS view is a run of objects, not of fat pointers - dispatching through it faults.
    expect_error("cannot bind an array view of 'AvmImpl' to a destination of 'AvmIface'") {
        AvmImpl[2] avmImpls; avmImpls[0].s = 3;
        AvmImpl[] avmImplView = avmImpls;
        AvmIface[] avmBoxedView = avmImplView;
    }

    // Declaration initializer: element 'int*' into element 'int'.
    expect_error("cannot bind an array view of 'int*' to a destination of 'int'") {
        int[] avmDeclInit = pview;
    }

    // Reassignment of an existing view local.
    expect_error("cannot bind an array view of 'int*' to a destination of 'int'") {
        int[] avmAssign = iview;
        avmAssign = pview;
    }

    // Field store into a non-generic 'int[]' field.
    expect_error("cannot bind an array view of 'int*' to a destination of 'int'") {
        AvmPlain avmPlain = default;
        avmPlain.v = pview;
    }

    // Field store into a generic view field 'AvmBox<int[]>.v'.
    expect_error("cannot bind an array view of 'int*' to a destination of 'int'") {
        AvmBox<int[]> avmBox = default;
        avmBox.v = pview;
    }

    // Repro A: 'T*' with T bound to 'int*[]' decays to the element pointer 'int**', so an
    // 'int[]' view (element 'int') is one pointer level short of the destination element.
    // The destination here is a PLAIN POINTER (decayed from T*), not a view - role-specific wording.
    expect_error("cannot bind an array view of 'int' to a plain pointer whose pointee is 'int*'") {
        AvmPtrBox<int*[]> avmPtrBox = default;
        avmPtrBox.p = iview;
    }

    // Filed spelling: a plain-pointer declaration initializer bound from a view whose element
    // is a pointer type - the destination must not read as if it were itself a view.
    expect_error("cannot bind an array view of 'int*' to a plain pointer whose pointee is 'u8'") {
        u8* avmRawFromPtrView = pview;
    }

    // A struct element is its own type: 'AvmFoo[]' is not an 'AvmBar[]' even at equal layout.
    expect_error("cannot bind an array view of 'AvmFoo' to a destination of 'AvmBar'") {
        AvmFoo[2] avmFoos; avmFoos[0].a = 1; avmFoos[1].a = 2;
        AvmFoo[] avmFooView = avmFoos;
        AvmBar[] avmBarView = avmFooView;
    }

    // Differing element WIDTH: a 'u8[]' view read as 'int[]' strides by 4 over bytes.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        u8[4] avmBytes; avmBytes[0] = 1; avmBytes[1] = 2; avmBytes[2] = 3; avmBytes[3] = 4;
        u8[] avmByteView = avmBytes;
        int[] avmWide = avmByteView;
    }

    // Declaration leg fed by a '?:' join of two same-element views.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        u8[4] avmJoinBytes; avmJoinBytes[0] = 1;
        u8[] avmJoinLeft = avmJoinBytes;
        u8[] avmJoinRight = avmJoinBytes;
        bool avmJoinPick = avmJoinBytes[0] == 1;
        int[] avmJoinDecl = avmJoinPick ? avmJoinLeft : avmJoinRight;
    }

    // Same join, interface elements: the arms agree on 'AvmIface', the destination does not.
    expect_error("cannot bind an array view of 'AvmIface' to a destination of 'AvmIfaceB'") {
        AvmIface[] avmJoinIfaceRight = new AvmIface[1];
        bool avmJoinIfacePick = avmJoinIfaceRight != nullptr;
        AvmIfaceB[] avmJoinIfaceDecl = avmJoinIfacePick ? avmIfaceView : avmJoinIfaceRight;
    }

    // Call-argument leg, element name axis: the message names the FUNCTION, then its element.
    expect_error("cannot pass an array view of 'u8' as parameter 'd' of 'avmTakeInt', whose element is 'int'") {
        u8[4] avmArgBytes; avmArgBytes[0] = 9;
        u8[] avmArgView = avmArgBytes;
        int avmArgResult = avmTakeInt(avmArgView);
    }

    // Same joins, but the ARM is a struct FIELD read rather than a local slot.
    u8[4] avmFieldBytes; avmFieldBytes[0] = 1;
    u8[] avmFieldSrc = avmFieldBytes;
    bool avmFieldPick = avmFieldBytes[0] == 1;

    // Declaration door, arm read through a struct VALUE.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        AvmU8Holder avmFieldHolder = default;
        avmFieldHolder.v = avmFieldSrc;
        int[] avmFieldDecl = avmFieldPick ? avmFieldHolder.v : avmFieldSrc;
    }

    // Assignment door, arm read through a POINTER to the struct.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        AvmU8Holder avmFieldPtrHolder = default;
        avmFieldPtrHolder.v = avmFieldSrc;
        AvmU8Holder* avmFieldPtr = &avmFieldPtrHolder;
        int[] avmFieldAssigned = default;
        avmFieldAssigned = avmFieldPick ? avmFieldPtr.v : avmFieldSrc;
    }

    // Field-store door, arm read through a NESTED field path.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        AvmU8Outer avmFieldOuter = default;
        avmFieldOuter.inner.v = avmFieldSrc;
        AvmIfaceHolder avmFieldStore = default;
        avmFieldStore.view = avmFieldPick ? avmFieldOuter.inner.v : avmFieldSrc;
    }

    // Call-argument door, arm read through a generic INSTANTIATION's field.
    expect_error("cannot pass an array view of 'u8' as parameter 'd' of 'avmTakeInt'") {
        AvmBox<u8[]> avmFieldBox = default;
        avmFieldBox.v = avmFieldSrc;
        int avmFieldCall = avmTakeInt(avmFieldPick ? avmFieldBox.v : avmFieldSrc);
    }

    // Interface elements: the field arm names 'AvmIface', the destination wants 'AvmIfaceB'.
    expect_error("cannot bind an array view of 'AvmIface' to a destination of 'AvmIfaceB'") {
        AvmIfaceViewHolder avmFieldIface = default;
        avmFieldIface.v = avmIfaceView;
        AvmIfaceB[] avmFieldIfaceDecl = avmFieldPick ? avmFieldIface.v : avmIfaceView;
    }

    // Declaration door, arm read off a by-VALUE call result.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        int[] avmFieldCallValue = avmFieldPick ? avmMakeU8Holder(avmFieldSrc).v : avmFieldSrc;
    }

    // Assignment door, arm read off a NESTED field of a by-value call result.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        int[] avmFieldCallNested = default;
        avmFieldCallNested = avmFieldPick ? avmMakeU8Outer(avmFieldSrc).inner.v : avmFieldSrc;
    }

    // Declaration door, arm read through a NULL-SAFE '?.' access.
    expect_error("cannot bind an array view of 'u8' to a destination of 'int'") {
        AvmU8Holder avmFieldNcHolder = default;
        avmFieldNcHolder.v = avmFieldSrc;
        AvmU8Holder* avmFieldNcPtr = &avmFieldNcHolder;
        int[] avmFieldNcDecl = avmFieldPick ? avmFieldNcPtr?.v : avmFieldSrc;
    }

    // Call-argument door, arm read through a NULL-SAFE access into a nested field.
    expect_error("cannot pass an array view of 'u8' as parameter 'd' of 'avmTakeInt'") {
        AvmU8Outer avmFieldNcOuter = default;
        avmFieldNcOuter.inner.v = avmFieldSrc;
        AvmU8Outer* avmFieldNcOuterPtr = &avmFieldNcOuter;
        int avmFieldNcCall = avmTakeInt(
            avmFieldPick ? avmFieldNcOuterPtr?.inner.v : avmFieldSrc);
    }

    // The two arms themselves disagree once the field arm is named, so the JOIN is the error
    // site - this pins that site's own wording, not a door's.
    expect_error("cannot join an array view of 'u8' with an array view of 'int' in a '?:'") {
        AvmU8Holder avmFieldDisagree = default;
        avmFieldDisagree.v = avmFieldSrc;
        int[] avmFieldOther = iview;
        int[] avmFieldJoin = avmFieldPick ? avmFieldDisagree.v : avmFieldOther;
    }

    return 0;
}
