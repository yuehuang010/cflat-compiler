// A char[N] buffer is stack storage. Wrapping its address in string borrows that storage, so
// the string may stay in the current frame but may not escape into a longer-lived string slot.
import "string.cb";
import "list.cb";

struct StackStringHolder { string s = default; };
string gStackString = default;
string stackBorrowFlowMake() { return "owned"; }

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void stackStringFieldThroughPointer() {
        char[16] buf = "field";
        StackStringHolder* h = new StackStringHolder();
        h->s = &buf[0];
        delete h;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void stackStringFieldThroughLocalStruct() {
        char[16] buf = "field";
        StackStringHolder h = default;
        h.s = &buf[1];
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void stackStringFieldBraceInit() {
        char[16] buf = "field";
        StackStringHolder h = { s = &buf[0] };
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void stackStringGlobalFromDecay() {
        char[16] buf = "global";
        gStackString = buf;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string stackStringReturn() {
        char[16] buf = "return";
        return &buf[0];
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void stackStringOutParameter(string* out) {
        char[16] buf = "out";
        char* p = &buf[0];
        *out = p;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void stackStringOuterLocal() {
        string outer = default;
        {
            char[16] buf = "inner";
            outer = &buf[0];
        }
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string ternaryMovedStackReturnTrue(bool choose) {
        char[8] buf = {'h', 'i', 0};
        string borrowed = (string)buf;
        string owned = "o" + "k";
        return choose ? move borrowed : move owned;
    }
}
expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string ternaryMovedStackReturnFalse(bool choose) {
        char[8] buf = {'h', 'i', 0};
        string borrowed = (string)buf;
        string owned = "o" + "k";
        return choose ? move owned : move borrowed;
    }
}
expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string movedStackReturn() {
        char[8] buf = {'h', 'i', 0};
        string borrowed = (string)buf;
        return move borrowed;
    }
}
expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void ternaryMovedStackGlobalStore(bool choose) {
        char[8] buf = {'h', 'i', 0};
        string borrowed = (string)buf;
        string owned = "o" + "k";
        gStackString = choose ? move borrowed : move owned;
    }
}
expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void ternaryMovedStackFieldStore(StackStringHolder* holder, bool choose) {
        char[8] buf = {'h', 'i', 0};
        string borrowed = (string)buf;
        string owned = "o" + "k";
        holder->s = choose ? move borrowed : move owned;
    }
}
expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void ternaryMovedStackOutParameter(string* out, bool choose) {
        char[8] buf = {'h', 'i', 0};
        string borrowed = (string)buf;
        string owned = "o" + "k";
        *out = choose ? move borrowed : move owned;
    }
}

// list<string>.add is intentionally absent from the rejects: its value insertion path copies
// a borrowed string, as pinned by testStringStackBufferSources in test_list_ownership.cb.

struct StackCharSource { char[8] bytes = default; };
struct StackStringViewHolder { string_view s = default; };
string_view gStackStringView = default;
char[8] strretgateGlobalViewBytes = {'g', 'l', 'o', 'b', 'a', 'l', 0, 0};

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string_view strretgate_local_view_ternary_return() {
        bool chooseStack = true;
        char[8] buf = {'b', 'u', 'f', 0, 0, 0, 0, 0};
        return chooseStack
            ? string_view(buf, 3)
            : string_view(strretgateGlobalViewBytes, 3);
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void strretgate_local_view_ternary_global_store() {
        bool chooseStack = true;
        char[8] buf = {'b', 'u', 'f', 0, 0, 0, 0, 0};
        gStackStringView = chooseStack
            ? string_view(buf, 3)
            : string_view(strretgateGlobalViewBytes, 3);
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void strretgate_local_view_ternary_param_field(StackStringViewHolder* holder) {
        bool chooseStack = true;
        char[8] buf = {'b', 'u', 'f', 0, 0, 0, 0, 0};
        holder->s = chooseStack
            ? string_view(buf, 3)
            : string_view(strretgateGlobalViewBytes, 3);
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void strretgate_local_view_ternary_out_param(string_view* output) {
        bool chooseStack = true;
        char[8] buf = {'b', 'u', 'f', 0, 0, 0, 0, 0};
        *output = chooseStack
            ? string_view(buf, 3)
            : string_view(strretgateGlobalViewBytes, 3);
    }
}

// STRRETGATE matrix legs: every borrowed cast / constructor form must be rejected at each
// existing escape sink for a local array and for an array field rooted in a local struct.

expect_error("cannot store a string borrowed from stack buffer") {
    string strretgate_local_array_cast_bare_return() { char[8] buf = {'h', 'i', 0}; return (string)buf; }
}

expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_local_array_cast_bare_global_store() { char[8] buf = {'h', 'i', 0}; gStackString = (string)buf; }
}

expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_local_array_cast_bare_param_field(StackStringHolder* h) { char[8] buf = {'h', 'i', 0}; h->s = (string)buf; }
}

expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_local_array_cast_bare_out_param(string* out) { char[8] buf = {'h', 'i', 0}; *out = (string)buf; }
}

expect_error("cannot store a string borrowed from stack buffer") {
    string strretgate_local_array_cast_parenthesized_return() { char[8] buf = {'h', 'i', 0}; return (string)(buf); }
}

expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_local_array_cast_parenthesized_global_store() { char[8] buf = {'h', 'i', 0}; gStackString = (string)(buf); }
}

expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_local_array_cast_parenthesized_param_field(StackStringHolder* h) { char[8] buf = {'h', 'i', 0}; h->s = (string)(buf); }
}

expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_local_array_cast_parenthesized_out_param(string* out) { char[8] buf = {'h', 'i', 0}; *out = (string)(buf); }
}

expect_error("cannot store a string borrowed from stack buffer") {
    string strretgate_local_array_functional_one_return() { char[8] buf = {'h', 'i', 0}; return string(buf); }
}

expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_local_array_functional_one_global_store() { char[8] buf = {'h', 'i', 0}; gStackString = string(buf); }
