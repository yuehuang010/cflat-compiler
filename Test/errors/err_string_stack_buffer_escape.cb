// Named intermediate values keep the same stack root until an escape sink consumes them.
expect_error("cannot store a string borrowed from stack buffer") {
    string strretgate_cast_bare_named_return() {
        char[8] buf = {'h', 'i', 0}; string value = (string)buf; return value;
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string strretgate_functional_two_named_return() {
        char[8] buf = {'h', 'i', 0}; string value = string(buf, 2); return value;
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string_view strretgate_string_view_named_return() {
        char[8] buf = {'h', 'i', 0}; string_view value = string_view(buf, 2); return value;
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string_view strretgate_struct_field_view_named_return() {
        StackCharSource p = default; p.bytes[0] = 'h'; p.bytes[1] = 'i'; p.bytes[2] = 0;
        string_view value = string_view(p.bytes, 2); return value;
    }
}

// Assignment expressions carry the borrow of the value stored by the inner assignment.
expect_error("cannot store a string borrowed from stack buffer") {
    string_view strretgate_assignment_view_return() {
        char[8] buf = {'h', 'i', 0}; string_view value = default;
        return value = string_view(buf, 2);
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string strretgate_assignment_cast_return() {
        char[8] buf = {'h', 'i', 0}; string value = default;
        return value = (string)buf;
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string strretgate_assignment_constructor_return() {
        char[8] buf = {'h', 'i', 0}; string value = default;
        return value = string(buf);
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string_view strretgate_assignment_named_return() {
        char[8] buf = {'h', 'i', 0};
        string_view source = string_view(buf, 2); string_view value = default;
        return value = source;
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string_view strretgate_assignment_initializer_then_return() {
        char[8] buf = {'h', 'i', 0}; string_view inner = default;
        string_view saved = inner = string_view(buf, 2);
        return saved;
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string_view strretgate_assignment_chained_return() {
        char[8] buf = {'h', 'i', 0};
        string_view first = default; string_view second = default;
        return first = second = string_view(buf, 2);
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    string_view strretgate_assignment_local_field() {
        char[8] buf = {'h', 'i', 0}; string_view value = default;
        StackStringViewHolder holder = default;
        return holder.s = value = string_view(buf, 2);
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_assignment_brace_field_init() {
        char[8] buf = {'h', 'i', 0}; string_view inner = default;
        StackStringViewHolder holder = { s = inner = string_view(buf, 2) };
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_assignment_inner_to_outer_local() {
        string_view outer = default;
        { char[8] buf = {'h', 'i', 0}; string_view inner = default;
          outer = inner = string_view(buf, 2); }
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_assignment_global_store() {
        char[8] buf = {'h', 'i', 0}; string_view value = default;
        gStackStringView = value = string_view(buf, 2);
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_assignment_out_parameter(string_view* output) {
        char[8] buf = {'h', 'i', 0}; string_view value = default;
        *output = value = string_view(buf, 2);
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_assignment_long_lived_field(StackStringViewHolder* holder) {
        char[8] buf = {'h', 'i', 0}; string_view value = default;
        holder->s = value = string_view(buf, 2);
    }
}


// Brace initialization shares the same field escape gate as assignment.
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_bare_cast_field_init() {
        char[8] buf = {'h', 'i', 0}; StackStringHolder h = { s = (string)buf };
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_two_arg_string_field_init() {
        char[8] buf = {'h', 'i', 0}; StackStringHolder h = { s = string(buf, 2) };
    }
}
expect_error("cannot store a string borrowed from stack buffer") {
    void strretgate_string_view_field_init() {
        char[8] buf = {'h', 'i', 0}; StackStringViewHolder h = { s = string_view(buf, 2) };
    }
}

extern int main() { return 0; }

// Same-type cast wrappers keep the borrow fact until the ordinary return gate runs.
expect_error("cannot store a string borrowed from stack buffer 'bytes'") {
    string stackStringIdentityCastReturn() {
        char[4] bytes = {'c', 'a', 't', 0};
        string borrowed = string(bytes);
        return (string)borrowed;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'bytes'") {
    string stackStringIdentityFunctionalReturn() {
        char[4] bytes = {'c', 'a', 't', 0};
        string borrowed = string(bytes);
        return string(borrowed);
    }
}

// Flow-sensitive assignment joins retain any stack-buffer borrow that reaches an escape.

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string borrowflow_if_no_else_assign_literal_return_s(int c) {
        char[8] buf = {'h', 'i', 0};
        string s = (string)buf;
        if (c != 0) { s = "owned"; }
        return s;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void borrowflow_if_no_else_assign_literal_store_global(int c) {
        char[8] buf = {'h', 'i', 0};
        string s = (string)buf;
        if (c != 0) { s = "owned"; }
        gStackString = s;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void borrowflow_if_no_else_assign_literal_store_field_param(StackStringHolder* holder, int c) {
        char[8] buf = {'h', 'i', 0};
        string s = (string)buf;
        if (c != 0) { s = "owned"; }
        holder->s = s;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string borrowflow_if_no_else_assign_default_return_s(int c) {
        char[8] buf = {'h', 'i', 0};
        string s = (string)buf;
        if (c != 0) { s = default; }
        return s;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void borrowflow_if_no_else_assign_default_store_global(int c) {
        char[8] buf = {'h', 'i', 0};
        string s = (string)buf;
        if (c != 0) { s = default; }
        gStackString = s;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    void borrowflow_if_no_else_assign_default_store_field_param(StackStringHolder* holder, int c) {
        char[8] buf = {'h', 'i', 0};
        string s = (string)buf;
        if (c != 0) { s = default; }
        holder->s = s;
    }
}

expect_error("cannot store a string borrowed from stack buffer 'buf'") {
    string borrowflow_if_no_else_assign_mk_return_s(int c) {
        char[8] buf = {'h', 'i', 0};
        string s = (string)buf;
        if (c != 0) { s = stackBorrowFlowMake(); }
        return s;
