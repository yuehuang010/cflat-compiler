// 'delete' of an interface box whose object a DIFFERENT owner already frees. Every leg below
// COMPILED before this guard and aborted at runtime with no diagnostic at all (exit 139 as
// written, because each leg reads the box back after the free).
//
// Each leg names its interface local DIFFERENTLY and each expect_error pins that name, so the
// substring proves WHICH leg fired and no leg can be satisfied by another's diagnostic. Verified
// by mutation: breaking any single expectation in this file makes the whole file exit 1, so every
// leg is self-proving even though they share one file.
//
// POLARITY. The rejection needs a POSITIVE proof that some other owner frees the object, taken at
// the BOXING site while the source binding is still in hand: either the binding frees it itself at
// scope exit (IsOwning), or it is an established borrow - a non-move pointer parameter, a `unique`
// field, an `alias` return, a container-owned element. "Ownership was not transferred here" is NOT
// such a proof and must never be used as one: it is also false for a local that received its `new`
// in a LATER statement, and that local is the box's ONLY owner, so deleting the box is correct.
// The must-still-work half is the delete_box_* / delete_borrowed_box_* legs in Test/test_move.cb.
//
// The plain COPY of an OWNING LOCAL (`CircleB* b = c;` and its `alias` spelling) was recorded here
// as an accepted gap. It is CLOSED: the DECLARATION now records the aliasing that no later site
// could reconstruct - BorrowsOwningLocal plus the source's SLOT - and the raw and boxed spellings
// reject the same set (the copyOfOwner* legs below). It stays a POSITIVE proof: the source must
// still be a LIVE owner at the delete, so reassigning either end retires it (Test/test_move.cb's
// delete_copy_owner_reassign_* legs). A late-assigned local, a global, an `alias`/`move` return
// result and a container element are not owning locals and stay accepted, exactly as before.

interface IShapeB { int area(); };
class CircleB : IShapeB { int r = 0; int area() { return r * r; } ~CircleB() {} };

bool identityBoolB(bool b) { return b; }

// A borrowed pointer PARAMETER: the caller owns it and frees it after the call returns.
expect_error("cannot delete interface 'sParam'") {
    int borrowParam(CircleB* p)
    {
        IShapeB sParam = p;
        delete sParam;
        return sParam.area();
    }
}

// The ASSIGNMENT STATEMENT spelling - a different code path from the declaration initializer. The
// 'nullptr' declaration is deliberately NEUTRAL: a null box owns nothing, so it must neither arm
// the rejection nor poison the local before the real binding runs.
expect_error("cannot delete interface 'sAssign'") {
    int borrowAssign(CircleB* p)
    {
        IShapeB sAssign = nullptr;
        sAssign = p;
        delete sAssign;
        return sAssign.area();
    }
}

// A PARENTHESIZED source. Parentheses erase the source binding and have twice defeated a guard in
// this exact area, so the proof falls back to the boxed VALUE's slot.
expect_error("cannot delete interface 'sParen'") {
    int borrowParen(CircleB* p)
    {
        IShapeB sParen = (p);
        delete sParen;
        return sParen.area();
    }
}

// The 'as' CAST spelling. It reaches the shared boxing helper through GenerateSafeCast rather than
// the declaration initializer, so it needs its own leg.
expect_error("cannot delete interface 'sAsCast'") {
    int borrowAsCast(CircleB* p)
    {
        IShapeB sAsCast = p as IShapeB;
        delete sAsCast;
        return sAsCast.area();
    }
}

// Inside a GENERIC. The box is created during monomorphization, where the source is the
// instantiated template's own parameter, so the proof has to survive substitution.
struct BoxOfB<T>
{
    int take(T p)
    {
        IShapeB sGeneric = p;
        delete sGeneric;
        return sGeneric.area();
    }
};

expect_error("cannot delete interface 'sGeneric'") {
    int borrowGeneric(CircleB* p)
    {
        BoxOfB<CircleB*> b;
        return b.take(p);
    }
}

// A 'unique' FIELD read. The field's SYNTHESIZED destructor frees it, so the box is a second
// owner. This is a field-specific proof and is asked BEFORE the direct-binding test. A PLAIN
// 'CircleB* h' field carries no such proof and is therefore ACCEPTED - not proven safe: a holder
// whose hand-written destructor frees the same field still double-frees, identically on master,
// and is an open gap. Test/test_move.cb's delete_box_plain_field_read leg pins the accept side.
class HolderB { unique CircleB* h = default; };

expect_error("cannot delete interface 'sUniqueField'") {
    int borrowUniqueField(HolderB* hh)
    {
        IShapeB sUniqueField = hh.h;
        delete sUniqueField;
        return sUniqueField.area();
    }
}

// The '?:' JOIN. A join into a plain interface local is a BORROW BY DESIGN (a per-arm ownership
// transfer at the boxing site was tried, measured and reverted - it trades this double free for a
// use-after-null; see the fix/iface-boxing design record). BOTH arms here are owning locals that
// free at scope exit, so the join is proven on every path; a MIXED join is deliberately accepted.
// The diagnostic names BOTH arms, because which arm is taken is a runtime choice.
expect_error("cannot delete interface 'sTernary'") {
    int borrowTernary()
    {
        CircleB* a = new CircleB();
        CircleB* b = new CircleB();
        IShapeB sTernary = identityBoolB(true) ? a : b;
        delete sTernary;
        return sTernary.area();
    }
}

// The '??' spelling of the same join. It lowers through a SLOT rather than a phi, so it reaches
// the boxing helper by a different route and needs its own leg.
expect_error("cannot delete interface 'sCoalesce'") {
    int borrowCoalesce()
    {
        CircleB* a = new CircleB();
        CircleB* b = new CircleB();
        IShapeB sCoalesce = a ?? b;
        delete sCoalesce;
        return sCoalesce.area();
    }
}

// A CONTAINER-owned element, bound by DECLARATION. The list's destructor frees every element, so
// the box is a second owner. This clause of the proof (BorrowsOwnedElement) had NO leg at all in
// this file or in Test/test_move.cb, which is how the ordering defect the next leg pins got in.
// The diagnostic names the CONTAINER, never the local holding the borrow.
expect_error("cannot delete interface 'sElemDecl'") {
    int borrowElemDecl()
    {
        list<unique CircleB*> le;
        le.add(new CircleB());
        CircleB* e = le.get(0);
        IShapeB sElemDecl = e;
        delete sElemDecl;
        return sElemDecl.area();
    }
}

// The same element borrow acquired by ASSIGNMENT. This is the ORDER leg: the `=` sets PointerRebound
// and SetVariableBorrowsOwnedElement re-establishes the element fact on that very same store, so a
// predicate asking PointerRebound first retires a fact that is FRESHER than the bit retiring it.
// It compiled and double-freed (exit 134) until BorrowsOwnedElement was moved above the retirement.
// `nullptr` initializes, so the local is never owning and the IsOwning clause cannot reach the leg.
expect_error("cannot delete interface 'sElemAssign'") {
    int borrowElemAssign()
    {
        list<unique CircleB*> lf;
        lf.add(new CircleB());
        CircleB* g = nullptr;
        g = lf.get(0);
        IShapeB sElemAssign = g;
        delete sElemAssign;
        return sElemAssign.area();
    }
}

// `p = q` between two borrowed PARAMETERS. `p` is STILL a borrow after the store, so retiring its
// facts unconditionally laundered a double free that the identical program without the store
// rejects. The proof is PROPAGATED from the RHS binding, and the diagnostic names 'q' - the binding
// the value actually came from - not the LHS's own declaration origin.
expect_error("cannot delete interface 'sPropagated'") {
    int borrowPropagated(CircleB* p, CircleB* q)
    {
        p = q;
        IShapeB sPropagated = p;
        delete sPropagated;
        return sPropagated.area();
    }
}

// A one-hop COPY of a borrowed parameter. The raw `delete b;` on this binding has always been
// rejected ("it aliases borrowed parameter 'p'"); boxing it was an accepted LAUNDERING of exactly
// that, on the identical binding, and ran to a double free. The two spellings now agree, and it is
// the reassignment retirement above - not dropping IsBorrowed - that keeps `b = new CircleB();`
// before the box accepted (Test/test_move.cb's delete_box_hop_reassigned_* legs).
expect_error("cannot delete interface 'sHop'") {
    int borrowHop(CircleB* p)
    {
        CircleB* b = p;
        IShapeB sHop = b;
        delete sHop;
        return sHop.area();
    }
}

// `??=` between two borrowed PARAMETERS. `??=` is a JOIN - afterwards the binding holds either its
// OLD referent (arm not taken) or the RHS's - so the fact survives exactly when BOTH sides prove an
// owner, and the diagnostic must name both because which arm ran is a runtime choice. Retiring
// unconditionally here laundered a double free that the raw `delete p;` on the same binding rejects.
// The accept side of the same rule is delete_box_coalesce_* in Test/test_move.cb; taking the RHS
// alone instead would false-reject the sole-owner-LHS leg there.
expect_error("cannot delete interface 'sCoalesceJoin'") {
    int borrowCoalesceJoin(CircleB* p, CircleB* q)
    {
        p ??= q;
        IShapeB sCoalesceJoin = p;
        delete sCoalesceJoin;
        return sCoalesceJoin.area();
    }
}

// The join with two DIFFERENT kinds of proof: a container element on the left, a borrowed parameter
// on the right. Pins that the rendered owner is the JOIN and not just the first clause to match -
// the element clause is asked first and would otherwise name the container alone.
expect_error("cannot delete interface 'sCoalesceElemJoin' - it boxes an object that its container or 'q'") {
    int borrowCoalesceElemJoin(CircleB* q)
    {
        list<unique CircleB*> lh;
        lh.add(nullptr);
        CircleB* eh = lh.get(0);
        eh ??= q;
        IShapeB sCoalesceElemJoin = eh;
        delete sCoalesceElemJoin;
        return sCoalesceElemJoin.area();
    }
}

// The same join with a CAST on the RHS. A cast erases the source binding's storage, so the
// binding-based owner derivation returns nothing and the join went EMPTY - which retired the proof
// and laundered exactly the double free the leg above rejects. The owner is recovered from the
// boxed VALUE's slot instead. The accept side is delete_box_coalesce_cast_* in Test/test_move.cb.
expect_error("cannot delete interface 'sCoalesceCast' - it boxes an object that 'p' or 'q'") {
    int borrowCoalesceCast(CircleB* p, CircleB* q)
    {
        p ??= (CircleB*)q;
        IShapeB sCoalesceCast = p;
        delete sCoalesceCast;
        return sCoalesceCast.area();
    }
}

// A plain COPY of an OWNING LOCAL. The source frees the pointee at its own scope exit, so the copy
// owns nothing. This is the RAW spelling; the boxed twin is two legs below. The origin is recovered
// from the source's SLOT, so the diagnostic names 'cOwner' and never the copy holding it.
expect_error("cannot delete 'bCopy' - it copies 'cOwner'") {
    int copyOfOwnerRaw()
    {
        CircleB* cOwner = new CircleB();
        CircleB* bCopy = cOwner;
        delete bCopy;
        return bCopy->area();
    }
}

// The `alias` DECLARATION spelling of the same copy. `alias` is NOT what arms this - the SOURCE
// being a live owning local is - so `alias T* e = makeT();` off an `alias`/`move` RETURN stays
// accepted (delete_box_alias_return_owner_* in Test/test_move.cb), where the delete is the ONLY
// release and rejecting it would leak.
expect_error("cannot delete 'bAliasCopy' - it copies 'cAliasOwner'") {
    int copyOfOwnerAliasDecl()
    {
        CircleB* cAliasOwner = new CircleB();
        alias CircleB* bAliasCopy = cAliasOwner;
        delete bAliasCopy;
        return bAliasCopy->area();
    }
}

// The BOXED spelling. The raw guard and the boxing proof must reject the same set or boxing
// launders what `delete bBoxCopy;` rejects - the failure the sHop leg above was written for.
expect_error("cannot delete interface 'sOwnCopy' - it boxes an object that 'cBoxOwner' already frees") {
    int copyOfOwnerBoxed()
    {
        CircleB* cBoxOwner = new CircleB();
        CircleB* bBoxCopy = cBoxOwner;
        IShapeB sOwnCopy = bBoxCopy;
        delete sOwnCopy;
        return sOwnCopy.area();
    }
}

// TWO hops (`d = b = c`). The fact is carried across the second declaration from the first copy's
// recorded slot, so the diagnostic still names the real owner and not the intermediate copy.
expect_error("cannot delete 'dHopCopy' - it copies 'cHopOwner'") {
    int copyOfOwnerTwoHops()
    {
        CircleB* cHopOwner = new CircleB();
        CircleB* bHopCopy = cHopOwner;
        CircleB* dHopCopy = bHopCopy;
        delete dHopCopy;
        return dHopCopy->area();
    }
}

// A ONE-HOP copy of a container-ELEMENT borrow. The direct `delete eSrc;` spelling already
// rejected; the decl-init clause read IsBorrowOfUniqueElement off the accessor RESULT, so exactly
// one hop through a plain local defeated it. The fact is now carried off the source BINDING too.
// Retirement is COPY-end only here: the container owns the element whatever the source local is
// later pointed at, which is why rebinding `eSrc` does not retire it (unlike an owning-local copy).
expect_error("cannot delete 'bElemCopy' - it borrows an element that its container owns") {
    int copyOfElemBorrow()
    {
        list<unique CircleB*> lElem;
        lElem.add(new CircleB());
        CircleB* eSrc = lElem.get(0);
        CircleB* bElemCopy = eSrc;
        delete bElemCopy;
        return 1;
    }
}

// The BOXED twin of that copy. The raw guard and the boxing proof read the same propagated fact,
// so boxing cannot launder what `delete bElemBox;` rejects.
expect_error("cannot delete interface 'sElemCopy' - it boxes an object that its container already frees") {
    int copyOfElemBorrowBoxed()
    {
        list<unique CircleB*> lBox;
        lBox.add(new CircleB());
        CircleB* eBox = lBox.get(0);
        CircleB* bElemBox = eBox;
        IShapeB sElemCopy = bElemBox;
        delete sElemCopy;
        return 1;
    }
}

// `move` off a copy of an owning local. `delete bMoveCopy;` was already rejected while
// `CircleB* dAdopt = move bMoveCopy;` compiled and adopted ownership the copy never had - the two
// spellings of one mistake disagreed. The move guard now reads the SAME proof as the delete guard.
expect_error("cannot 'move' 'bMoveCopy' - it copies 'cMoveOwner'") {
    int moveOffCopyOfOwner()
    {
        CircleB* cMoveOwner = new CircleB();
        CircleB* bMoveCopy = cMoveOwner;
        CircleB* dAdopt = move bMoveCopy;
        return dAdopt->area();
    }
}

// `move` off a container-element borrow, in its DIRECT spelling: moving the borrow never clears
// the container's slot, so the container's destructor still frees the pointee.
expect_error("cannot 'move' 'eMoveSrc' - it borrows an element its container owns") {
    int moveOffElemBorrow()
    {
        list<unique CircleB*> lMove;
        lMove.add(new CircleB());
        CircleB* eMoveSrc = lMove.get(0);
        CircleB* dElemAdopt = move eMoveSrc;
        return dElemAdopt->area();
    }
}

// A '?:' JOIN bound to a POINTER local. The DIRECT boxed spelling was already rejected because the
// join boxes per arm with each arm's binding still in hand; routing it through a pointer local
// first erased that. BOTH-ARMS rule: every non-null arm must prove another owner, so the mixed
// `cJoin : new CircleB()` shape stays ACCEPTED (join_owner_new_* in Test/test_move.cb).
expect_error("cannot delete 'bJoined' - every arm of the join it was bound from") {
    int deleteJoinOfOwner()
    {
        CircleB* cJoinOwner = new CircleB();
        CircleB* bJoined = identityBoolB(true) ? cJoinOwner : cJoinOwner;
        delete bJoined;
        return 1;
    }
}

// The same join reached by ASSIGNMENT rather than declaration. The proof is recorded by the '='
// that rebound the local, and is retired by any later plain '=' that proves nothing.
expect_error("cannot delete 'pJoinAssigned' - every arm of the join it was bound from") {
    int deleteJoinAssigned()
    {
        CircleB* cAssignOwner = new CircleB();
        CircleB* pJoinAssigned = nullptr;
        pJoinAssigned = identityBoolB(true) ? cAssignOwner : cAssignOwner;
        delete pJoinAssigned;
        return 1;
    }
}

extern int main()
{
    return 0;
}
