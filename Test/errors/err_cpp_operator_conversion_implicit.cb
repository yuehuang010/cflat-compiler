// A conversion cflat refused to bind reports its recorded refusal at the cast instead of
// claiming it was never declared. (An IMPLICIT C++ conversion operator now binds at an
// initializer too - cppi.Convertible's `operator int` is a value leg in
// Test/test_cpp_interop_template.cb; only an `explicit` one is cast-and-condition only,
// which Test/errors/err_cpp_proxy_conversion.cb pins.)
import cpp "cpp_interop_basic.h";
import cpp "cpp_interop_assign.h";

int obRankIntOrDouble(int v) { return 1; }
int obRankIntOrDouble(double v) { return 2; }
int obRankLongOrDouble(long v) { return 1; }
int obRankLongOrDouble(double v) { return 2; }

extern int main()
{
    expect_error("member 'operator float' of C++ class 'cppi.ConvDeleted' is deleted") {
        cppi.ConvDeleted d = cppi.ConvDeleted(1);
        float g = (float)d;
    }
    // A call reachable only through a conversion operator whose generated wrapper clang
    // refuses names that refusal in the "no overload" error, not only under -v.
    expect_error("implicit argument conversion refused: clang rejected the call through") {
        cppi.UdcParser udcP = default;
        cppi.UdcStr udcS = default;
        auto udcR = udcP.p(udcS);
    }
    expect_error("is ambiguous:") {
        cppas.ObRank p = default;
        u32 u = p;
    }
    expect_error("is ambiguous:") {
        cppas.ObRank q = default;
        double d = q;
    }
    expect_error("is ambiguous:") {
        cppas.ObRank q = default;
        i64 v = q;
    }
    expect_error("is ambiguous:") {
        cppas.ObRankIntLong q = default;
        u32 v = q;
    }
    expect_error("is ambiguous:") {
        cppas.ObRankBoolChar q = default;
        int v = q;
    }
    expect_error("ambiguous") {
        cppas.ObRank q = default;
        int v = obRankIntOrDouble(q);
    }
    expect_error("ambiguous") {
        cppas.ObRankBoolChar q = default;
        int v = obRankIntOrDouble(q);
    }
    expect_error("ambiguous") {
        cppas.ObRankFloatInt q = default;
        int v = obRankLongOrDouble(q);
    }
    return 0;
}
