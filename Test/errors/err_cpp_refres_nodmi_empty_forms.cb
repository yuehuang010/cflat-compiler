import cpp "cpp_interop_refres_array.hpp";

extern int main()
{
    int x = 10; int y = 20;
    expect_error("reference member must be initialized") {
        cpprefres.Pair[1] emptyArray = {};
    }
    expect_error("reference member must be initialized") {
        cpprefres.Pair[2] explicitEmpty = { { x, y, 1 }, {} };
    }
    return 0;
}
