import cpp "cpp_interop_fnptr.h";
int wrong_params(double x) { return (int)x; }
extern int main()
{
    expect_error("function-pointer signature mismatch: parameter takes 'int(int)' but function 'wrong_params' has 'int(double)'") {
        cppfnptr.callback_call(wrong_params, 1);
    }
    return 0;
}
