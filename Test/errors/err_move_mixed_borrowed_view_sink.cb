expect_error("the view may be borrowed on a runtime path") {
    void loopReownThenIf(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        int i = 0;
        while (i < argc - 1) { v = new T377MoveView[1]; i++; }
        if (argc > 5) { t377MoveViewRead(v); } else { t377MoveViewRead(v); }
        t377MoveViewSink(move v);
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void loopReownThenOneArm(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        int i = 0;
        while (i < argc - 1) { v = new T377MoveView[1]; i++; }
        if (argc > 5) { t377MoveViewRead(v); }
        t377MoveViewSink(move v);
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void switchLoopReownThenIf(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        switch (argc) {
        case 1: {
            int i = 0;
            while (i < 0) { v = new T377MoveView[1]; i++; }
            break;
        }
        default:
            v = new T377MoveView[2];
            break;
        }
        if (argc > 5) { t377MoveViewRead(v); } else { t377MoveViewRead(v); }
        t377MoveViewSink(move v);
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void rangeForReownThenIf(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        int[] xs = new int[argc - 1];
        for (int x in xs) { v = new T377MoveView[1]; }
        if (argc > 5) { t377MoveViewRead(v); } else { t377MoveViewRead(v); }
        t377MoveViewSink(move v);
    }
}

