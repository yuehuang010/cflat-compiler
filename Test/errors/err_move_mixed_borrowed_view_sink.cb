expect_error("the view may be borrowed on a runtime path") {
    void loopSinkThenNestedMixedRejoin(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] u = new T377MoveView[1];
        for (int i = 0; i < 2; i++)
        {
            t377MoveViewSink(move u);
            u = new T377MoveView[1];
            for (int j = 0; j < 1; j++) { u = c ? new T377MoveView[2] : w; }
        }
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void loopNestedSinkThenMixedRejoin(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] u = new T377MoveView[1];
        for (int i = 0; i < 2; i++)
        {
            for (int j = 0; j < 1; j++)
            {
                t377MoveViewSink(move u);
                u = new T377MoveView[1];
            }
            u = c ? new T377MoveView[2] : w;
        }
    }
}
