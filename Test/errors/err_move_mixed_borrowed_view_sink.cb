    void reownThenLoopJoinThenIf(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        v = new T377MoveView[1];
        int i = 0;
        while (i < argc - 1) { v = argc > 3 ? new T377MoveView[2] : w; i++; }
        if (argc > 5) { t377MoveViewRead(v); } else { t377MoveViewRead(v); }
        t377MoveViewSink(move v);
    }
}

