        for (int i = 4294967296; i != 0; i++) { q = &b; }
        t377MoveViewSink(move q->hs[0].view);
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void countedLoopOctalBound(bool c)
    {
        T377MoveView[] w = new T377MoveView[2];
        T387ArrayFieldHolder a = default;
        a.hs[0].view = c ? new T377MoveView[1] : w;
        T387ArrayFieldHolder b = default;
        b.hs[0].view = new T377MoveView[1];
        T387ArrayFieldHolder* q = &a;
        for (int i = 9; i < 010; i++) { q = &b; }
        t377MoveViewSink(move q->hs[0].view);
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void aliasCopyOfShadow(bool c)
    {
        T377MoveView[] w = new T377MoveView[2];
        T387ArrayFieldHolder a = default;
        a.hs[0].view = c ? new T377MoveView[1] : w;
        T387ArrayFieldHolder b = default;
        b.hs[0].view = new T377MoveView[1];
        T387ArrayFieldHolder* q = &a;
        T387ArrayFieldHolder* r = &a;
        T387ArrayFieldHolder** x = &q;
        { T387ArrayFieldHolder** x = &r; T387ArrayFieldHolder** y = x; *y = &b; }
        t377MoveViewSink(move q->hs[0].view);
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void aliasCopyConditional(bool c)
    {
        T377MoveView[] w = new T377MoveView[2];
        T387ArrayFieldHolder a = default;
        a.hs[0].view = c ? new T377MoveView[1] : w;
        T387ArrayFieldHolder b = default;
        b.hs[0].view = new T377MoveView[1];
        T387ArrayFieldHolder* q = &a;
        T387ArrayFieldHolder* r = &a;
        T387ArrayFieldHolder** x = &q;
        T387ArrayFieldHolder** y = x ? &r : &r;
        *y = &b;
        t377MoveViewSink(move q->hs[0].view);
    }
}

// A view field may own its buffer: `move p->view` into a move sink is a transfer, refused through a borrow.
expect_error("cannot 'move' field 'T387FieldHolder.view' through borrowed parameter 'p'") {
    void t531SinkThroughBorrow(T387FieldHolder* p)
    {
        t377MoveViewSink(move p->view);
    }
}

// An explicit `move` of the local copy into a sink is refused: the local holds a borrowed view.
expect_error("cannot 'move' field 'T387FieldHolder.view' through borrowed parameter 'p'") {
    void t531LocalThenSink(T387FieldHolder* p)
    {
        T377MoveView[] r = move p->view;
        t377MoveViewSink(move r);
    }
}
