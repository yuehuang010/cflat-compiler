class T377MoveView { int id = 0; };
void t377MoveViewSink(move T377MoveView[] p) { }
int t377MoveViewRead(T377MoveView[] p) { return p[0].id; }
struct T387FieldHolder { T377MoveView[] view = default; };
struct T387ArrayFieldHolder { T387FieldHolder hs[2]; };
T377MoveView[] t387GlobalView = default;

expect_error("the view may be borrowed on a runtime path") {
    void declMixedView(bool c)
    {
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        t377MoveViewSink(move v);
    }
}

expect_error("the view may be borrowed on a runtime path") {
    void declMixedViewImplicitSink(bool c)
    {
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        t377MoveViewSink(v);
    }
}

