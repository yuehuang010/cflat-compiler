    void noJoinBeforeLoopReownThenJoin(int argc)
    {
        bool c = argc > 1;
        T377MoveView[] w = new T377MoveView[3];
        T377MoveView[] v = c ? new T377MoveView[2] : w;
        T377MoveView[] y = new T377MoveView[1];
        y = new T377MoveView[1];
        int i = 0;
        while (i < argc - 1) { y = argc > 3 ? new T377MoveView[2] : w; i++; }
        if (argc > 5) { t377MoveViewRead(y); } else { t377MoveViewRead(y); }
        t377MoveViewSink(move y);
    }
}

