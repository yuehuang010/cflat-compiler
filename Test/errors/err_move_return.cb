// Tests that returning a non-owned expression from a move T* function is a compile-time error.

struct Widget { int id = 0; };

move Widget* borrowLeak(Widget* w)
{
    expect_error("function declares 'move' return type but returned expression is not owned") {
        return w;
    }
    return nullptr;
}

// The same rule when the returned expression is a BORROW-returning CALL that merely evaluated a
// `new` in its ARGUMENT list. The allocation is the argument's, not the result's, so the function
// hands back a pointer it does not own. This used to compile silently: the `new` set the sticky
// lastOwningResult channel and the return check read it instead of the returned value.
Widget* g_heldWidget = nullptr;
Widget* retainSecond(Widget* a, Widget* b) { g_heldWidget = b; return a; }

move Widget* argNewLeak(Widget* w)
{
    expect_error("function declares 'move' return type but returned expression is not owned") {
        return retainSecond(w, new Widget());
    }
    return nullptr;
}

// A `move` RETURN type is an explicit ownership contract, but `move` of a BORROWED pointer
// parameter owns nothing: it nulls only this frame's copy while the caller still owns the pointee,
// so the caller's result and the caller's own binding both free it. `move w` sets the same sticky
// ownership channel a real transfer does, so the check above passes it - the ledger's borrow
// provenance is what discriminates. Measured a silent abort before this rejection existed.
move Widget* borrowMoveLeak(Widget* w)
{
    expect_error("moves a value that only borrows through parameter 'w'") {
        return move w;
    }
    return nullptr;
}

// One hop out: the copy carries the borrow, so the same rejection must fire off `b`, not just `w`.
move Widget* borrowMoveCopyLeak(Widget* w)
{
    expect_error("moves a value that only borrows through parameter 'w'") {
        Widget* b = w;
        return move b;
    }
    return nullptr;
}

// Sanity: a `move` parameter really does own its pointee, so forwarding it stays legal.
move Widget* forwardOwned(move Widget* w)
{
    return move w;
}

extern int main() { return 0; }
