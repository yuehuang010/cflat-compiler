// Deleting a borrowed (non-move) parameter is an error - the caller may own
// the pointer and will free it on scope exit, causing a double-free.

struct Node { int value = 0; };

// non-move pointer param: caller may own it, cannot delete here
expect_error("cannot delete borrowed parameter 'n'") {
    void badDelete(Node* n) { delete n; }
}

// The PARENTHESIZED spelling. The parenthesized primary dropped the operand's borrow origin, so
// this compiled and double-freed (rc 134) while the bare twin above was already this rejection.
expect_error("cannot delete borrowed parameter 'n'") {
    void badDeleteParen(Node* n) { delete (n); }
}

// move param: ownership transferred - delete is valid
void goodDelete(move Node* n) { delete n; }

// The `move` param under the same wrapper stays legal - the peel must not turn an owner into a
// borrow. Its value/resource legs are wcp_delete_paren_* in Test/test_move.cb.
void goodDeleteParen(move Node* n) { delete (n); }

// T207 sibling: a raw local that held an owned `new` and was then rebound to a borrowed parameter
// still carried the owned bit, so `delete` freed the caller's object. The borrowing store retires it.
expect_error("cannot delete 'raw' - it aliases borrowed parameter 'n'") {
    void t207DeleteAfterBorrow(Node* n) { Node* raw = new Node; raw = n; delete raw; }
}

extern int main() { return 0; }
