// A spelling that merely CONTAINS `std::function<` is not a std::function: only a TOP-LEVEL one
// binds as the std.function specialization. Binding `std::vector<std::function<int(int)>>` as the
// inner std::function passed a callable where a vector was expected (silent wrong value) or crashed
// on the return. The member parameter and both returns now bind as the vector itself, so a callable
// is refused where the vector is expected and the vector is refused where a callable is.
// The last leg pins that a `std::function&&` CONSTRUCTOR parameter is refused by CFlat's own
// overload matching, not by an LLVM module verifier failure.
import cpp "functional";
import cpp "cpp_interop_stdfn.h";

int nested_twice(int x) { return x * 2; }

extern int main()
{
    expect_error("no viable conversion from 'std::function<int (int)>' to 'std::vector") {
        cppfn.NestedHolder h = cppfn.NestedHolder();
        int r = h.take_vec(std.function<int(int)>(nested_twice));
    }
    expect_error("cannot initialize C++ class 'std.function<int(int)>' from this expression") {
        std.function<int(int)> f = cppfn.vec_of_fn();
    }
    expect_error("cannot initialize C++ class 'std.function<int(int)>' from this expression") {
        cppfn.NestedHolder h2 = cppfn.NestedHolder();
        std.function<int(int)> g = h2.get_vec();
    }
    // The FREE-parameter position of the same shape. It used to bind as the inner std::function
    // and hand a callable where a vector was expected; it now binds as the vector by value.
    expect_error("no viable conversion from 'std::function<int (int)>' to 'std::vector") {
        int rv = cppfn.take_vec_free(std.function<int(int)>(nested_twice));
    }
    return 0;
}
