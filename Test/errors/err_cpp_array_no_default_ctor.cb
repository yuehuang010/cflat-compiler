// Every element of a C++-class array is default-CONSTRUCTED, so a class whose default constructor
// is deleted has no array form at all. Pre-fix the declaration compiled to zeroed bytes and then
// destroyed elements that had never been constructed.
import cpp "cpp_interop_arrayelem.h";
import cpp "cpp_t135_field_brace.hpp";

// T136: a class with neither a default nor an initializer_list constructor has no empty-brace array
// form either. The global `= {}` refusal is immediate, so a scoped block works at file scope.
expect_error("C++ class 't135.IntOnly' has no default constructor cflat can call") {
    t135.IntOnly[2] gNeitherEmpty = {};
}

expect_error("C++ class 'cppa.NoDef' has no default constructor cflat can call (it is deleted)");
cppa.NoDef[2] badGlobal;

extern int main()
{
    expect_error("C++ class 'cppa.NoDef' has no default constructor cflat can call (it is deleted), so an array of it cannot be default-initialized") {
        cppa.NoDef[2] bad = default;
    }
    expect_error("so an array of it cannot be default-initialized") {
        cppa.NoDef[2] bad2;
    }
    // T136: the local `{}`-element spelling of the same neither class is refused as well.
    expect_error("so an array of it cannot be default-initialized") {
        t135.IntOnly[2] lNeitherArr = { {}, {} };
    }
    // The per-element brace list and the unlisted TAIL of a short positional list construct too,
    // so each must refuse here rather than zero-fill. Both are separate emission sites.
    expect_error("so an array of it cannot be default-initialized") {
        cppa.NoDef[3] bad3 = { {v=1} };
    }
    // T88: every default-construction door refuses a private trivial default constructor.
    expect_error("so an array of it cannot be default-initialized") {
        cppa.PrivTriv[2] badPrivLocalArr;
    }
    expect_error("so an array of it cannot be default-initialized") {
        cppa.PrivTriv[] badPrivNewArr = new cppa.PrivTriv[2];
    }
    expect_error("a 'static' local of it cannot be constructed") {
        static cppa.ProtTriv badProtStatic;
    }
    expect_error("has no default constructor cflat can call") {
        cppa.PrivTriv badPrivBraced = {};
    }
    expect_error("has no default constructor cflat can call") {
        cppa.PrivUser badPrivUserLocal;
    }
    expect_error("has ambiguous default construction") {
        cppa.PrivDefArg badAmbiguous;
    }
    // Accept set: the remedy the message names must compile and run.
    cppa.NoDef*[2] ok = default;
    ok[0] = new cppa.NoDef(3);
    if (ok[0].v != 3) return 1;
    delete ok[0];
    return 0;
}
