// A `unique` field-to-field copy between two ARRAY ELEMENTS gives one pointee two owners, and
// used to compile clean and abort at teardown (exit 134) with no diagnostic at all. The
// receiver-identity fields the self-assign discriminator consults (FieldName, CallerName) name
// the CONTAINER for an element access - `arr[0].slot` and `arr[1].slot` both report caller
// "arr" and field "slot" - so the whole field-store guard stack was suppressed as a no-op
// self-assign. The reject now fires only when the two lvalues are PROVABLY different slots
// (same address root, all-constant offsets, offsets differ), so a runtime subscript keeps
// compiling; those must-still-work shapes are value-asserted in
// Test/test_move.cb::testUniqueArrayElementFieldStore.
//
// Discriminator for every leg below: the message names the ELEMENT spelling of the source
// ('arr[1].slot', not 'arr.slot'). That spelling is produced only by the new element arm, and
// the pre-fix binary emitted no diagnostic whatsoever for any of these files.
struct Node { int v = 0; };

struct Holder { unique Node* slot = nullptr; };

struct Box<T> { T t = default; };

struct Inner { Holder[2] h = default; };

struct Outer { Holder[2] arr = default; };

Holder[2] gArr = default;

// The filed spelling: a plain local array, two constant indices.
expect_error("cannot store unique field 'arr[1].slot' into unique field 'Holder.slot'") {
    void elemToElem()
    {
        Holder[2] arr = default;
        arr[0].slot = new Node();
        arr[1].slot = new Node();
        arr[0].slot = arr[1].slot;
    }
}

// The GENERIC-SUBSTITUTED spelling: ownership comes from the `unique Node*` type argument
// (IsUniqueTypeArg), never a written `unique`, and reaches the same element receiver.
expect_error("cannot store unique field 'arr[1].t' into unique field 'Box__unique_Nodeptr.t'") {
    void genericElemToElem()
    {
        Box<unique Node*>[2] arr = default;
        arr[0].t = new Node();
        arr[1].t = new Node();
        arr[0].t = arr[1].t;
    }
}

// NESTED arrays: the element chain is two GEPs deep, so the offset proof has to flatten the
// whole chain rather than look at one index.
expect_error("cannot store unique field 'arr[0].h[1].slot' into unique field 'Holder.slot'") {
    void nestedElemToElem()
    {
        Inner[2] arr = default;
        arr[0].h[0].slot = new Node();
        arr[0].h[1].slot = new Node();
        arr[0].h[0].slot = arr[0].h[1].slot;
    }
}

// An array that is a FIELD of another struct - the root is the outer local, one struct GEP up.
expect_error("cannot store unique field 'o.arr[1].slot' into unique field 'Holder.slot'") {
    void fieldArrayElemToElem()
    {
        Outer o = default;
        o.arr[0].slot = new Node();
        o.arr[1].slot = new Node();
        o.arr[0].slot = o.arr[1].slot;
    }
}

// An array reached through a POINTER: each access re-loads the base, so the two roots are
// distinct LoadInsts and the proof has to show the two loads read the same address unchanged.
expect_error("cannot store unique field 'p->arr[1].slot' into unique field 'Holder.slot'") {
    void ptrArrayElemToElem()
    {
        Outer o = default;
        Outer* p = &o;
        p->arr[0].slot = new Node();
        p->arr[1].slot = new Node();
        p->arr[0].slot = p->arr[1].slot;
    }
}

// An array VIEW - same re-loaded-base shape as the pointer case, through 'T[]'.
expect_error("cannot store unique field 'v[1].slot' into unique field 'Holder.slot'") {
    void viewElemToElem()
    {
        Holder[2] arr = default;
        Holder[] v = arr;
        v[0].slot = new Node();
        v[1].slot = new Node();
        v[0].slot = v[1].slot;
    }
}

// A GLOBAL array: the root is a GlobalVariable rather than an alloca. This one never aborted,
// because a global ARRAY ELEMENT's synthesized destructor does not run at teardown (a global
// NAMED struct's does - measured), so it aliased silently and only a reject can catch it.
expect_error("cannot store unique field 'gArr[1].slot' into unique field 'Holder.slot'") {
    void globalArrayElemToElem()
    {
        gArr[0].slot = new Node();
        gArr[1].slot = new Node();
        gArr[0].slot = gArr[1].slot;
    }
}

extern int main()
{
    return 0;
}
