import cpp "cpp_interop_basic.h";
import cpp "vector";
import cpp "cpp_interop_nest.h";

extern int main()
{
    expect_error("'cppi.unsupported_param' was not bound: parameter 'value' has unsupported C++ type '_Float16'") {
        cppi.unsupported_param(1);
    }
    /*
     * A `T ***const &` parameter binds at depth 3 (the reference is one folded level), so a
     * depth-2 argument is refused by the exact-depth check. Live tripwire against a relaxation
     * that stops counting stars.
     */
    expect_error("no overload of 'cppi.ptr_depth3_ref_param' matches the given arguments") {
        cppi.PtrDepthOwner pdOwner = default;
        cppi.PtrDepthOwner* pdP1 = &pdOwner;
        cppi.PtrDepthOwner** pdP2 = &pdP1;
        cppi.ptr_depth3_ref_param(pdP2);
    }
    // A refusal names the class in WRITABLE source: the CFlat identity of a specialization is
    // the mangled key 'std.vector$.p$.p$nest.Cell', which master printed verbatim. data() returns
    // 'nest::Cell ***' and binds now, so the name is pinned on a wrong-depth assignment instead.
    expect_error("cannot assign to C++ class 'std.vector<nest.Cell**>' from this expression") {
        std.vector<nest.Cell**> pdVec = default;
        pdVec = 7;
    }
    expect_error("no overload of 'nest.rpr_rank_single_cell_shallow' matches the given arguments") {
        nest.Cell* rprP = new nest.Cell(1, 2);
        nest.Cell** rprPP = &rprP;
        nest.rpr_rank_single_cell_shallow(rprPP);
    }
    expect_error("no overload of 'nest.rpr_rank_single_cell_deep' matches the given arguments") {
        nest.Cell* rprP = new nest.Cell(1, 2);
        nest.rpr_rank_single_cell_deep(rprP);
    }
    expect_error("no overload of 'nest.rpr_rank_single_cell_shallow_const' matches the given arguments") {
        nest.Cell* rprP = new nest.Cell(1, 2);
        nest.Cell** rprPP = &rprP;
        nest.rpr_rank_single_cell_shallow_const(rprPP);
    }
    expect_error("no overload of 'nest.rpr_rank_single_cell_deep_const' matches the given arguments") {
        nest.Cell* rprP = new nest.Cell(1, 2);
        nest.rpr_rank_single_cell_deep_const(rprP);
    }
    expect_error("no overload of 'nest.rpr_rank_single_int_shallow' matches the given arguments") {
        int rprV = 1;
        int* rprP = &rprV;
        int** rprPP = &rprP;
        nest.rpr_rank_single_int_shallow(rprPP);
    }
    expect_error("no overload of 'nest.rpr_rank_single_int_deep' matches the given arguments") {
        int rprV = 1;
        int* rprP = &rprV;
        nest.rpr_rank_single_int_deep(rprP);
    }
    expect_error("no overload of 'nest.rpr_rank_single_int_shallow_const' matches the given arguments") {
        int rprV = 1;
        int* rprP = &rprV;
        int** rprPP = &rprP;
        nest.rpr_rank_single_int_shallow_const(rprPP);
    }
    expect_error("no overload of 'nest.rpr_rank_single_int_deep_const' matches the given arguments") {
        int rprV = 1;
        int* rprP = &rprV;
        nest.rpr_rank_single_int_deep_const(rprP);
    }
    return 0;
}
