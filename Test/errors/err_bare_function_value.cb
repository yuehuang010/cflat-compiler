// Bare un-called function reference used as a value: 'Math.PI' (a function in
// disguise) must not silently bitcast to a scalar or crash arithmetic codegen.
// Regression for the forgot-the-parens bug: 'double pi = Math.PI;' compiled
// silently (function address bitcast to a denormal double) and
// 'Math.sin(nullary() * 0.5)' tripped an LLVM assert inside fmul.

import "math.cb";
import "string.cb";

double nullary() { return 3.14; }

struct P { int v = 0; int getv() { return this->v; } };

interface IShape { int area(); };

class Sq : IShape
{
    int s = 0;
    int area() { return this->s * this->s; }
};

// Scalar conversion path (CreateCast): declaration initializer.
expect_error("is a function used as a value") {
    int test_decl()
    {
        double pi = nullary;
        return 0;
    }
}

// Arithmetic path (CreateOperation): function reference inside an expression.
expect_error("is a function used as a value") {
    int test_arith()
    {
        double x = nullary * 0.5;
        return 0;
    }
}

// Namespace-qualified function reference, the original customer repro shape.
expect_error("is a function used as a value") {
    int test_namespace_qualified()
    {
        double s = Math.sin * 2.0;
        return 0;
    }
}

// Member access that NAMES a method without '()'. Used to return an empty
// NamedVariable that every caller dereferenced -> raw SIGSEGV, no diagnostic.
expect_error("'getv' is a method of 'P'") {
    int test_struct_method_no_parens()
    {
        P p = default;
        return (int)p.getv;
    }
}

// Same shape on a core type - 'length' is a method of string, not a field.
expect_error("'length' is a method of 'string'") {
    int test_string_method_no_parens()
    {
        string t = "lit";
        return (int)t.length;
    }
}

// Interface receiver: the method name resolves through the vtable contract, not
// a field, and went down the same crashing path.
expect_error("'area' is a method of 'IShape'") {
    int test_interface_method_no_parens()
    {
        Sq* q = new Sq();
        IShape i = q;
        return (int)i.area;
    }
}

// Discarded expression statement: no cast to crash on, but the method name was
// silently dropped instead of diagnosed.
expect_error("'getv' is a method of 'P'") {
    int test_method_no_parens_discarded()
    {
        P p = default;
        p.getv;
        return 0;
    }
}

// Primitive UFCS receiver: the base value stayed live and the method name was
// silently dropped, so '(int)n.toString' compiled to just 'n'.
expect_error("'toString' is a method of 'int'") {
    int test_primitive_ufcs_no_parens()
    {
        int n = 5;
        return (int)n.toString;
    }
}

// A function name that merely CONTAINS '__' must be quoted VERBATIM. The generic-instantiation
// unmangling here is gated on the instantiation registry; gating it on a bare '__' occurrence
// instead rewrote 'dunder__name' to 'dunder<name>' and libc's '__error' to '<error>', neither of
// which is source text of any kind. The message must therefore name 'dunder__name' exactly, and
// the remedy it advises ('dunder__name()') must be the spelling the user actually wrote.
double dunder__name() { return 2.5; }

// Scalar conversion path (CreateCast).
expect_error("'dunder__name' is a function used as a value - did you mean 'dunder__name()'?") {
    int test_dunder_name_decl()
    {
        double d = dunder__name;
        return 0;
    }
}

// Arithmetic path (CreateOperation) - the other RejectBareFunctionValue caller.
expect_error("'dunder__name' is a function used as a value - did you mean 'dunder__name()'?") {
    int test_dunder_name_arith()
    {
        double d = dunder__name * 0.5;
        return 0;
    }
}

// The other side of that gate: a REAL generic instantiation must still be spelled back as
// source. Its functionTable key is the mangled 'bfvGid__i32'; quoting the key raw would print
// a name no user wrote and advise 'bfvGid__i32()'. (The type argument is rendered canonically,
// so 'int' comes back as 'i32' - that spelling compiles and names the same instantiation.)
T bfvGid<T>(T x) { return x; }

expect_error("'bfvGid<i32>' is a function used as a value - did you mean 'bfvGid<i32>()'?") {
    int test_generic_instantiation_as_scalar()
    {
        long v = (long)bfvGid<int>;
        return 0;
    }
}

extern int main()
{
    return 0;
}
