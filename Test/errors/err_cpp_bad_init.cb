// A foreign nontrivial C++ local is CONSTRUCTED into its slot, so only the construction forms are
// accepted as initializers. An arbitrary expression has no constructor to bind and must not fall
// back to a byte-wise store.
import cpp "cpp_interop_basic.h";

extern int main()
{
    expect_error("cannot initialize C++ class 'cppi.Tracked' from this expression") {
        cppi.Tracked bad = cppi.add(1, 2);
    }
    // An explicit-only constructor template never converts an expression template implicitly.
    cppi_expr.Vec3 exprA = cppi_expr.Vec3(1.0, 2.0, 3.0);
    expect_error("cannot initialize C++ class 'cppi_expr.ExplicitVec3' from this expression") {
        cppi_expr.ExplicitVec3 initExplicit = exprA + exprA;
    }
    expect_error("cannot initialize C++ class 'cppi_expr.ExplicitVec3' from this expression") {
        cppi_expr.ExplicitVec3 staticExplicit = cppi_expr.Vec3.Ones();
    }
    expect_error("cannot assign to C++ class 'cppi_expr.ExplicitVec3' from this expression") {
        cppi_expr.ExplicitVec3 assignExplicit = cppi_expr.ExplicitVec3(exprA + exprA);
        assignExplicit = exprA + exprA;
    }
    // Constructing a polymorphic class template instantiates every virtual body (the vtable uses them);
    // an invalid one is a compile-time error at the construction site, never a link failure.
    expect_error("clang: failed to instantiate 't172::InvalidVirtual<int>::bad'") {
        t172.InvalidVirtual<int> invalidVirtual = default;
    }
    expect_error("clang: failed to instantiate 't172::InvalidVirtual<int>::bad'") {
        t172.InvalidVirtualDerived<int> invalidDerived = default;
    }
    expect_error("clang: failed to instantiate 't172::InvalidDtorBase<int>::~InvalidDtorBase'") {
        t172.DtorDerived<int> dtorDerived = default;
    }
    return 0;
}
