import "list.cb";

// Two destructor bodies for the same type on ONE source line used to crash the compiler
// nondeterministically (SIGSEGV/SIGTRAP/SIGABRT mix, zero output, no diagnostic): the second
// ~S() reused the already-defined function via CreateFunctionDefinition's own early return,
// which pushes no function scope, and the destructor path walked on regardless, emitting a
// second body into the terminated function and then popping a stackNamedVariable frame that was
// never pushed. DiagnoseDuplicateFunctionBody cannot catch this shape: it deliberately yields
// when the recorded origin line equals the new line, which is exactly the same-line case.
// ParseDestructorDefinition and ParseProgramDestructorDefinition now check
// OverloadSlotIsDefined() before CreateFunctionDefinition and report a located "redefinition"
// error instead - a destructor body can never be compiler-synthesized, so an occupied slot here
// is always a genuine user duplicate.

// struct, same line
expect_error("redefinition of '~SDupStruct'")
{
    struct SDupStruct { int a; ~SDupStruct() { } ~SDupStruct() { } };
}

// class, same line
expect_error("redefinition of '~SDupClass'")
{
    class SDupClass { int a; ~SDupClass() { } ~SDupClass() { } };
}

// Three destructor bodies on one line - still exactly one diagnostic (LogError throws), naming
// the second definition's clash with the first.
expect_error("redefinition of '~SDupThree'")
{
    struct SDupThree { int a; ~SDupThree() { } ~SDupThree() { } ~SDupThree() { } };
}

// The two-line spelling already diagnosed via DiagnoseDuplicateFunctionBody before this fix;
// the new same-line check must not change its wording or double-report it.
expect_error("redefinition of '~SDupTwoLine'")
{
    struct SDupTwoLine {
        int a;
        ~SDupTwoLine() { }
        ~SDupTwoLine() { }
    };
}

// A type with duplicate destructors that is never instantiated must still be diagnosed at
// definition time - the crash this replaces happened during compilation, not at instantiation.
expect_error("redefinition of '~SDupUnused'")
{
    struct SDupUnused { int a; ~SDupUnused() { } ~SDupUnused() { } };
}

// program's own destructor emitter (ParseProgramDestructorDefinition) has the identical guard.
expect_error("redefinition of '~PDupProgram'")
{
    program PDupProgram {
        int a = 0;

        int main(move list<string> args) {
            return a;
        }

        ~PDupProgram() { } ~PDupProgram() { }
    };
}

// A single legitimate destructor must keep compiling normally - control leg, no expect_error:
// if the new guard ever false-rejected an ordinary one-destructor type, this block alone would
// fail the file.
struct SSingleDtor { int a; ~SSingleDtor() { a = 0; } };

extern int main()
{
    SSingleDtor s;
    s.a = 1;
    return 0;
}
