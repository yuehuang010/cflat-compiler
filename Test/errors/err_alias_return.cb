// Returning an `alias` (borrow) value from a non-`alias` function. list.get is
// declared `alias` - the element stays owned by the list, so the returned value
// borrows the list's buffer. Handing it back from a plain (non-alias) function
// would give the caller a value whose always-run destructor frees a buffer the
// list still owns (double-free). Steer is 'alias' on the function, or '.copy()'.
import "string.cb";
import "list.cb";

struct Token { string text = default; };

alias string frameArrayString()
{
    string[2] dst;
    dst[0] = "ab" + "cd";
    expect_error("cannot return an 'alias' string value");
    return dst[0];
}

alias string frameWholeString()
{
    string s = "ab" + "cd";
    expect_error("cannot return an 'alias' string value");
    return s;
}

struct AliasStringBox { string s = default; };
alias string frameFieldString()
{
    AliasStringBox b = default;
    b.s = "ab" + "cd";
    expect_error("cannot return an 'alias' string value");
    return b.s;
}

Token firstToken(list<Token> toks)
{
    expect_error("cannot return an 'alias' value");
    return toks.get(0);                // alias borrow escaping via a non-alias return
}

// Same escape one level in: a field of a DECLARED alias local. The field path root is the
// alias local, which is not on its own a licence to hand an owning value out - the returned
// Inner would destruct a pointee the caller's Outer still owns (double free).
class AliasNode { int id = default; };
class Inner { unique AliasNode* item = nullptr; };
class Outer { Inner slot = default; alias Outer self() { return *this; } };
Inner stealSlot(Outer* w)
{
    alias Outer k = w->self();
    expect_error("cannot return an 'alias' value");
    return k.slot;
}

extern int main()
{
    return 0;
}

// A non-pointer `alias T` PARAMETER is passed as a pointer to the CALLER's object, and a
// function-pointer type has no spelling for that - an indirect call would hand the callee
// the value itself and it would read it as an address. Both doors are closed: a declared
// `function<>`/`Lambda<>` binding, and a `function<>` parameter fed the name at a call.
struct AliasParamRow { int value = default; };
int aliasParamTaker(alias AliasParamRow r) { return r.value; }

expect_error("cannot be used as a function pointer") {
    void aliasParamFnBind()
    {
        function<int(AliasParamRow)> fp = aliasParamTaker;
    }
}

expect_error("cannot be used as a function pointer") {
    int aliasParamCallThru(function<int(AliasParamRow)> g, AliasParamRow r) { return g(r); }
    int aliasParamFnArg()
    {
        AliasParamRow r;
        return aliasParamCallThru(aliasParamTaker, r);
    }
}

expect_error("cannot be used as a function pointer") {
    function<int(AliasParamRow)> aliasParamFnReturn() { return aliasParamTaker; }
}

expect_error("cannot be used as a function pointer") {
    struct AliasParamHolder { function<int(AliasParamRow)> f = nullptr; };
    void aliasParamFnField()
    {
        AliasParamHolder h;
        h.f = aliasParamTaker;
    }
}

expect_error("cannot be used as a function pointer") {
    void aliasParamLambdaBind()
    {
        Lambda<int(AliasParamRow)> lam = aliasParamTaker;
    }
}

// ACCEPT-SET: the rejection is scoped to a BY-VALUE `alias` parameter. A plain by-value
// parameter and an `alias T*` parameter both keep their existing representation, so both
// still bind to a function pointer. These must compile.
int plainParamTaker(AliasParamRow r)        { return r.value; }
int aliasPtrParamTaker(alias AliasParamRow* r) { return r->value; }
int aliasParamAcceptSet()
{
    function<int(AliasParamRow)>  a = plainParamTaker;
    function<int(AliasParamRow*)> b = aliasPtrParamTaker;
    AliasParamRow r;
    return a(r) + b(&r);
}

struct AliasReturnProbe
{
    unique<int> value = default;
    int get() { return value.get() == nullptr ? 0 : *value; }
};
AliasReturnProbe aliasReturnProbeMake(int value)
{
    AliasReturnProbe result;
    result.value = new int(value);
    return result;
}
AliasReturnProbe aliasReturnProbePick(AliasReturnProbe a, AliasReturnProbe b, bool first)
{
    if (first) return a;
    return b;
}
void aliasReturnProbeSink(move AliasReturnProbe value) { }

expect_error("cannot return an 'alias' value 'x'") {
    AliasReturnProbe aliasReturnLocalPickedNamed()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), true);
        return x;
    }
}

expect_error("cannot return an 'alias' value 'x'") {
    AliasReturnProbe aliasReturnLocalPickedTemp()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), false);
        return x;
    }
}

expect_error("cannot 'move' the 'alias' value 'x'") {
    void aliasReturnMovePickedNamed()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), true);
        aliasReturnProbeSink(move x);
    }
}

expect_error("cannot 'move' the 'alias' value 'x'") {
    void aliasReturnMovePickedTemp()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), false);
        aliasReturnProbeSink(move x);
    }
}

expect_error("cannot store an 'alias' value 'x' into an owning variable") {
    void aliasReturnStoreLocal()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe y = aliasReturnProbeMake(0);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), true);
        y = x;
    }
}

expect_error("cannot store an 'alias' value 'aliasReturnProbePick' into an owning parameter") {
    void aliasReturnDirectSink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        aliasReturnProbeSink(aliasReturnProbePick(a, aliasReturnProbeMake(3), true));
    }
}

expect_error("cannot store an 'alias' value 'aliasReturnProbePick' into an owning parameter") {
    void aliasReturnNamedDirectSink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe b = aliasReturnProbeMake(2);
        aliasReturnProbeSink(aliasReturnProbePick(a, b, true));
    }
}

expect_error("cannot store an 'alias' value") {
    void aliasReturnListSink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        list<AliasReturnProbe> values;
        values.add(aliasReturnProbePick(a, aliasReturnProbeMake(3), true));
    }
}

expect_error("cannot store an 'alias' value 'aliasReturnProbePick' into an owning parameter") {
    void aliasReturnNamedListSink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe b = aliasReturnProbeMake(2);
        list<AliasReturnProbe> values;
        values.add(aliasReturnProbePick(a, b, true));
    }
}

expect_error("cannot store an 'alias' value 'aliasReturnProbePick' into an owning array element") {
    void aliasReturnArrayTempStore()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe[2] values;
        values[0] = aliasReturnProbePick(a, aliasReturnProbeMake(3), false);
    }
}

expect_error("cannot store an 'alias' value 'aliasReturnProbePick' into an owning array element") {
    void aliasReturnArrayNamedStore()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe b = aliasReturnProbeMake(2);
        AliasReturnProbe[2] values;
        values[0] = aliasReturnProbePick(a, b, true);
    }
}

expect_error("cannot store an 'alias' value 'y' into an owning parameter") {
    void aliasReturnChainedSink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), false);
        AliasReturnProbe y = x;
        aliasReturnProbeSink(y);
    }
}

expect_error("cannot store an 'alias' value 'y'") {
    void aliasReturnChainedListSink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), false);
        AliasReturnProbe y = x;
        list<AliasReturnProbe> values;
        values.add(y);
    }
}

struct AliasReturnPicker
{
    int k = 0;
    AliasReturnProbe pick(AliasReturnProbe a, AliasReturnProbe b) { if (k > 0) return a; return b; }
};

expect_error("cannot store an 'alias' value 'pick' into an owning parameter") {
    void aliasReturnMethodSink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnPicker p;
        aliasReturnProbeSink(p.pick(a, aliasReturnProbeMake(4)));
    }
}

// A rebind on only one path leaves the alias borrow standing.
expect_error("cannot store an 'alias' value 'x' into an owning parameter") {
    void aliasReturnConditionalRebindSink(bool c)
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe x = aliasReturnProbePick(a, aliasReturnProbeMake(3), false);
        if (c) x = aliasReturnProbeMake(5);
        aliasReturnProbeSink(x);
    }
}

// A C-ABI `extern` definition owns its by-value param, so a named argument is moved into it.
extern AliasReturnProbe aliasReturnExternPass(AliasReturnProbe w) { return w; }
expect_error("use of moved variable 'a'") {
    int aliasReturnExternNamedReadAfter()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe r = aliasReturnExternPass(a);
        return r.get() + a.get();
    }
}

// A named-only alias-return result bound to a local is still an alias: an owning sink refuses it.
expect_error("cannot store an 'alias' value 'x' into an owning parameter") {
    void aliasReturnNamedOnlySink()
    {
        AliasReturnProbe a = aliasReturnProbeMake(1);
        AliasReturnProbe b = aliasReturnProbeMake(2);
        AliasReturnProbe x = aliasReturnProbePick(a, b, true);
        aliasReturnProbeSink(x);
    }
}

// The `extern` definition destroys its owning by-value param, which only a direct call hands
// over, so every function-value door is closed.
extern int aliasReturnExternTake(AliasReturnProbe w) { return w.get(); }

expect_error("cannot be used as a function pointer") {
    void aliasReturnExternFnBind()
    {
        function<int(AliasReturnProbe)> fp = aliasReturnExternTake;
    }
}

expect_error("cannot be used as a function pointer") {
    int aliasReturnExternCallThru(function<int(AliasReturnProbe)> g) { return g(aliasReturnProbeMake(1)); }
    int aliasReturnExternFnArg() { return aliasReturnExternCallThru(aliasReturnExternTake); }
}

expect_error("cannot be used as a function pointer") {
    function<int(AliasReturnProbe)> aliasReturnExternFnReturn() { return aliasReturnExternTake; }
}

expect_error("cannot be used as a function pointer") {
    struct AliasReturnExternHolder { function<int(AliasReturnProbe)> f = nullptr; };
    void aliasReturnExternFnField()
    {
        AliasReturnExternHolder h;
        h.f = aliasReturnExternTake;
    }
}

expect_error("cannot be used as a function pointer") {
    void aliasReturnExternLambdaBind()
    {
        Lambda<int(AliasReturnProbe)> lam = aliasReturnExternTake;
    }
}
