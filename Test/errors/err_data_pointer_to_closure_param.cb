import "function.cb";
import "list.cb";

// A fat `Lambda<>` parameter reached through a VIRTUAL slot widens a named function or a
// `function<>` value into a {code, null} closure. Under opaque pointers every data pointer has
// the same LLVM type as a code pointer, so the widen must gate on argument PROVENANCE: without
// it a `void*` / `int*` / `char*` lands in the code slot and is then CALLED (SIGSEGV/SIGBUS at
// runtime). These reject at compile time instead, naming the parameter.

expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    interface IClosureArg { int lam(Lambda<int(int)> f); };
    class ClosureArgImpl : IClosureArg { int lam(Lambda<int(int)> f) { return f(5); } };

    int passVoidPointer()
    {
        ClosureArgImpl impl;
        IClosureArg io = impl;
        int q = 1;
        void* vp = &q;
        return io.lam(vp);
    }
}

expect_error("only a named function, a 'function<>' value or a lambda converts to a closure") {
    interface IClosureArg2 { int lam(Lambda<int(int)> f); };
    class ClosureArgImpl2 : IClosureArg2 { int lam(Lambda<int(int)> f) { return f(5); } };

    int passIntPointer()
    {
        ClosureArgImpl2 impl;
        IClosureArg2 io = impl;
        int q = 1;
        int* ip = &q;
        return io.lam(ip);
    }
}

// Same hole on the DIRECT (non-virtual) call path: `CreateOverloadedFunctionCall` widened any
// pointer into the fat closure's CODE slot. Both call spellings now share one gate
// (WidenToClosureFatChecked), so the accept set cannot drift between them.

expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    class ClosureArgDirect { int lam(Lambda<int(int)> f) { return f(5); } };

    int passVoidPointerDirect()
    {
        ClosureArgDirect d;
        int q = 1;
        void* vp = &q;
        return d.lam(vp);
    }
}

expect_error("only a named function, a 'function<>' value or a lambda converts to a closure") {
    class ClosureArgDirect2 { int lam(Lambda<int(int)> f) { return f(5); } };

    int passIntPointerDirect()
    {
        ClosureArgDirect2 d;
        int q = 1;
        int* ip = &q;
        return d.lam(ip);
    }
}

// Virtual dispatch used to take the lone same-arity vtable slot on ARITY alone and then lower
// each argument by bit pattern - an 'int' became `inttoptr` in a closure code slot and was
// CALLED. Both slot-picking arms now reject a PROVABLE mismatch (a scalar can never be code).
// Gating on "the scorer found no match" would instead false-reject legal code: the scorer has
// no int->floating-point rule, so its silence is absence of a rule, not proof of mismatch.

expect_error("no method of 'IClosureIntArg.lam' matches the given arguments") {
    interface IClosureIntArg { int lam(function<int(int)> f); };
    class ClosureIntArgImpl : IClosureIntArg { int lam(function<int(int)> f) { return f(5); } };

    int passIntLiteral()
    {
        ClosureIntArgImpl impl;
        IClosureIntArg io = impl;
        return io.lam(7);
    }
}

// The lone-slot arm above is not the only one. With TWO same-arity candidates the arity filter
// leaves both, the scorer ranks neither, and the resolver falls through to a historical
// "take the first slot" arm that was ungated - so one extra overload turned the clean error
// above back into a silent miscompile (exit 138). Both arms now share one gate.
//
// The second overload must have the SAME arity as the first, or the arity filter leaves a
// single candidate and this exercises the lone-slot arm above instead of the fallback.

expect_error("no method of 'IClosureTwoSlot.lam' matches the given arguments") {
    interface IClosureTwoSlot
    {
        int lam(function<int(int)> f);
        int lam(double d);
    };
    class ClosureTwoSlotImpl : IClosureTwoSlot
    {
        int lam(function<int(int)> f) { return f(5); }
        int lam(double d) { return (int)d + 100; }
    };

    int passIntLiteralTwoSlot()
    {
        ClosureTwoSlotImpl impl;
        IClosureTwoSlot io = impl;
        return io.lam(3);
    }
}

// The gate must stay one-sided. An int argument to a floating-point interface parameter is NOT
// a provable mismatch: the overload scorer has no int->floating-point rule, so an earlier
// revision that gated on "the scorer found no match" rejected this. Compiling is the whole
// assertion - files here are compiled, never run - so a future allowlist cannot silently
// re-break it.

interface IFpParam { int absorb(double d); };
class FpParamImpl : IFpParam { int absorb(double d) { return (int)d; } };

int acceptIntIntoFpParam()
{
    FpParamImpl impl;
    IFpParam io = impl;
    int n = 3;
    return io.absorb(n);
}

// The THIN (`function<>`) parameter arm of the same hole. A thin slot takes a BARE code address,
// so the argument is bitcast straight in and then CALLED (exit 139, no diagnostic). The fat gate
// above never ran for it: a thin parameter never widens to a {code, env} struct. Both arms now
// share one provenance predicate (ArgumentIsProvablyDataPointer) applied at the thin lowering
// sites, so all four combinations of {direct, virtual} x {thin, fat} keep ONE accept set.
// Both legs pin "'function<>' parameter", which is the ONLY part of the message the fat gate
// does not also emit - its tail ("a data pointer would be called as code") is shared verbatim.

expect_error("cannot pass a non-function pointer value to 'function<>' parameter 'f'") {
    class ThinArgDirect { int lam(function<int(int)> f) { return f(5); } };

    int passVoidPointerThinDirect()
    {
        ThinArgDirect d;
        int q = 1;
        void* vp = &q;
        return d.lam(vp);
    }
}

expect_error("to 'function<>' parameter 'f'") {
    interface IThinArg { int lam(function<int(int)> f); };
    class ThinArgImpl : IThinArg { int lam(function<int(int)> f) { return f(5); } };

    int passIntPointerThinVirtual()
    {
        ThinArgImpl impl;
        IThinArg io = impl;
        int q = 1;
        int* ip = &q;
        return io.lam(ip);
    }
}

// A function pointer of a DIFFERENT signature bound the parameter and was called through it -
// `dd` invoked as `int(int)`, printing a silent wrong value at exit 0. Two signatures that BOTH
// resolve and DIFFER at the same indirection shape are proof and are rejected; an absent or
// unresolved signature (an unsubstituted generic) is not proof and still binds.
//
// Each leg declares TWO overloads of the SAME arity on purpose. With distinct arities the arity
// filter leaves a single candidate and the direct call never reaches the overload SCORER (and
// the virtual call takes the lone-slot arm), so a one-overload leg would pass without ever
// exercising the code these pin.

expect_error("no overload of 'lam' matches the given arguments") {
    double sigMismatchFn(double x) { return x + 1000.0; }

    class SigDirect
    {
        int lam(function<int(int)> f) { return f(5); }
        int lam(double d)             { return (int)d + 100; }
    };

    int passWrongSignatureDirect()
    {
        SigDirect d;
        function<double(double)> g = sigMismatchFn;
        return d.lam(g);
    }
}

expect_error("no method of 'ISigSlot.lam' matches the given arguments") {
    double sigMismatchFn2(double x) { return x + 1000.0; }

    interface ISigSlot
    {
        int lam(function<int(int)> f);
        int lam(double d);
    };
    class SigSlotImpl : ISigSlot
    {
        int lam(function<int(int)> f) { return f(5); }
        int lam(double d)             { return (int)d + 100; }
    };

    int passWrongSignatureVirtual()
    {
        SigSlotImpl impl;
        ISigSlot io = impl;
        function<double(double)> g = sigMismatchFn2;
        return io.lam(g);
    }
}

// The proof above was originally on coarse type CLASSES ('i' integer / 'f' floating point /
// 'p' pointer / 'v' void), so every mismatch WITHIN a class stayed invisible and the callee was
// still called at the wrong type. It is now on canonical COMPONENTS - width, signedness, pointee
// identity, aggregate-vs-scalar - and each leg below is one axis that class comparison could not
// see. Every one compiled and ran silently at exit 0 before this change.
//
// Same construction rule as the two legs above: TWO overloads of the SAME arity, so the arity
// filter leaves both and the overload SCORER is what decides. A single overload would exercise
// the single-candidate path instead and prove nothing about the scorer.

// Floating-point WIDTH. Same SHAPE as the class-level leg above; 'float' and 'double' are one
// class, so this printed d=0 with no diagnostic.
expect_error("no overload of 'lamW' matches the given arguments") {
    float fpWidthFn(float x) { return x + 1.5f; }

    class SigFpWidth
    {
        int lamW(function<double(double)> f) { return (int)f(2.0); }
        int lamW(int n)                      { return 200 + n; }
    };

    int passFpWidth()
    {
        SigFpWidth d;
        function<float(float)> g = fpWidthFn;
        return d.lamW(g);
    }
}

// POINTEE type - the memory-unsafe axis. 'Circle*' and 'Square*' are one class under opaque
// pointers, so 'onCircleP' read c->area past the end of a 4-byte Square and exited 0.
// Both struct names are unique here; the 'lamZ' leg below covers the colliding case, which must
// reach the SAME verdict - an unrelated same-named struct never changes an answer.
expect_error("no overload of 'lamP' matches the given arguments") {
    struct CircleP { int r = default; double area = default; };
    struct SquareP { int side = default; };
    void onCircleP(CircleP* c) { int unused = c->r + (int)c->area; }

    class SigPointee
    {
        int lamP(function<void(SquareP*)> f) { SquareP s; s.side = 77; f(&s); return 7; }
        int lamP(double d)                   { return 200 + (int)d; }
    };

    int passWrongPointee()
    {
        SigPointee d;
        function<void(CircleP*)> g = onCircleP;
        return d.lamP(g);
    }
}

// The pointee proof must not be DEFEATABLE by an unrelated declaration. A signature stores the
// raw source spelling, so 'SquareZ' alone cannot say which registered struct it means. An earlier
// revision resolved the spelling to a single key and treated "more than one candidate" as
// unknown-so-bind - which meant the one line below, a struct nobody references, silently disarmed
// the leg above and let 'onCircleZ' read past a 4-byte object again (exit 0, area=0.000000).
// The comparator now compares CANDIDATE SETS and rejects when they are DISJOINT, so an extra
// same-named struct cannot change any verdict.
//
// THE 'namespace ZzUnrelated' DECLARATION BELOW IS LOAD-BEARING. Deleting it does not break this
// test - it makes it stop testing what it was written for. Keep it, and keep it unreferenced.
expect_error("no overload of 'lamZ' matches the given arguments") {
    namespace ZzUnrelated { struct SquareZ { int unrelated = default; }; }

    struct CircleZ { int r = default; double area = default; };
    struct SquareZ { int side = default; };
    void onCircleZ(CircleZ* c) { int unused = c->r + (int)c->area; }

    class SigCollide
    {
        int lamZ(function<void(SquareZ*)> f) { SquareZ s; s.side = 3; f(&s); return 5; }
        int lamZ(double d)                   { return 700 + (int)d; }
    };

    int passCollidingPointee()
    {
        SigCollide d;
        function<void(CircleZ*)> g = onCircleZ;
        return d.lamZ(g);
    }
}

// Integer WIDTH. 'i8' and 'i64' were one class, so an i8 callee invoked through an i64 pointer
// printed 705032705. SIGNEDNESS is deliberately NOT an axis here: `u32(u32)` and `i32(i32)` lower
// to the same llvm::FunctionType, so a signedness-only difference must BIND - the positive legs
// for that are in Test/test_function_ptr.cb ("u32/int crossing", "char*/u8* crossing").
// The 'lamU' leg below differs in WIDTH too (u64 vs i32); it is not a signedness test.
expect_error("no overload of 'lamI' matches the given arguments") {
    i8 narrowFn(i8 x) { return (i8)(x + 1); }

    class SigIntWidth
    {
        int lamI(function<i64(i64)> f) { return (int)f(5000000000); }
        int lamI(double d)             { return 200 + (int)d; }
    };

    int passNarrowIntoWide()
    {
        SigIntWidth d;
        function<i8(i8)> g = narrowFn;
        return d.lamI(g);
    }
}

expect_error("no overload of 'lamU' matches the given arguments") {
    u64 unsignedFn(u64 x) { return x + 1; }

    class SigSignedness
    {
        int lamU(function<i32(i32)> f) { return f(-4); }
        int lamU(double d)             { return 200 + (int)d; }
    };

    int passUnsignedIntoSigned()
    {
        SigSignedness d;
        function<u64(u64)> g = unsignedFn;
        return d.lamU(g);
    }
}

// AGGREGATE. A struct component used to make the WHOLE signature unresolvable (one unknown
// component abandoned the comparison), so a struct-taking callee bound an 'int' slot and was
// handed 9 as a two-field Pt. Components are now judged one at a time, so an unknown component
// no longer launders a KNOWN mismatch elsewhere in the same signature.
expect_error("no overload of 'lamA' matches the given arguments") {
    struct PtA { int x = default; int y = default; };
    void onPtA(PtA p) { int unused = p.x + p.y; }

    class SigAggregate
    {
        int lamA(function<void(int)> f) { f(9); return 7; }
        int lamA(double d)              { return 200 + (int)d; }
    };

    int passStructIntoIntSlot()
    {
        SigAggregate d;
        function<void(PtA)> g = onPtA;
        return d.lamA(g);
    }
}

// `bool` is its OWN component, not an integer: it lowers to an `i1` return
// (`define internal i1 @_isPos_bool_int_(i32)`), so a bool callee entered through an `int(int)`
// pointer reads undefined bits above bit 0. Master happened to print the right answer for a
// 0/1 result, which is exactly the kind of luck this proof exists to stop relying on.
expect_error("no overload of 'lamB' matches the given arguments") {
    bool boolFn(int x) { return x > 0; }

    class SigBool
    {
        int lamB(function<int(int)> f) { return f(5); }
        int lamB(double d)             { return 200 + (int)d; }
    };

    int passBoolIntoInt()
    {
        SigBool d;
        function<bool(int)> g = boolFn;
        return d.lamB(g);
    }
}

// The VIRTUAL arm of the same axis (ArgumentProvablyMismatchesParameter, reached through the
// interface slot resolver). Two same-arity slots, so this pins the multi-candidate fallback.
expect_error("no method of 'ISigPointee.lamV' matches the given arguments") {
    struct CircleV { int r = default; double area = default; };
    struct SquareV { int side = default; };
    void onCircleV(CircleV* c) { int unused = c->r + (int)c->area; }

    interface ISigPointee
    {
        int lamV(function<void(SquareV*)> f);
        int lamV(double d);
    };
    class SigPointeeImpl : ISigPointee
    {
        int lamV(function<void(SquareV*)> f) { SquareV s; s.side = 77; f(&s); return 7; }
        int lamV(double d)                   { return 200 + (int)d; }
    };

    int passWrongPointeeVirtual()
    {
        SigPointeeImpl impl;
        ISigPointee io = impl;
        function<void(CircleV*)> g = onCircleV;
        return io.lamV(g);
    }
}

// The interface LONE-SLOT arm - one slot only, so the arity filter leaves a single candidate and
// the multi-candidate fallback above is never reached. Discriminator: exactly one 'lamL'.
expect_error("no method of 'ISigLone.lamL' matches the given arguments") {
    float fpLoneFn(float x) { return x + 1.5f; }

    interface ISigLone { int lamL(function<double(double)> f); };
    class SigLoneImpl : ISigLone { int lamL(function<double(double)> f) { return (int)f(2.0); } };

    int passFpWidthLoneSlot()
    {
        SigLoneImpl impl;
        ISigLone io = impl;
        function<float(float)> g = fpLoneFn;
        return io.lamL(g);
    }
}

// The SINGLE-CANDIDATE direct path - one overload, so the scorer's multi-candidate ranking never
// runs. Discriminator: exactly one 'lamS'. This is the path round 1 of an earlier attempt broke.
expect_error("no overload of 'lamS' matches the given arguments") {
    float fpSingleFn(float x) { return x + 1.5f; }

    class SigSingle { int lamS(function<double(double)> f) { return (int)f(2.0); } };

    int passFpWidthSingleCandidate()
    {
        SigSingle d;
        function<float(float)> g = fpSingleFn;
        return d.lamS(g);
    }
}

// `move` is part of a function-pointer TYPE, so a fat parameter that TAKES OWNERSHIP cannot be
// bound by a function whose own parameter only borrows - the callee would be handed a pointer it
// must free and does not. This rejection lives in the same fat-argument arm as the gates above,
// behind the guard that decides whether a bare function NAME re-resolves at all, so deleting
// that lookup drops the diagnostic with nothing else to notice. The positive halves - a
// `move`-matching overload still binds, and re-resolution picks it over the borrow sibling -
// are value legs in Test/test_function_ptr.cb.
//
// Distinct from err_funcptr_move_mismatch.cb, which pins a DIFFERENT diagnostic ("'move'
// modifiers of function pointer signature") raised on the ASSIGNMENT path.

expect_error("has no overload matching the 'move' modifiers required by parameter 'f'") {
    struct MoveModMismatch { int value = 0; };

    // Only a BORROW overload exists, so nothing in the set matches the destination's `move`.
    int borrowsOnly(MoveModMismatch* p) { return p->value; }

    int takesMoveClosure(Lambda<int(move MoveModMismatch*)> f)
    {
        MoveModMismatch* q = new MoveModMismatch();
        q->value = 7;
        return f(q);
    }

    int passBorrowIntoMoveClosure()
    {
        return takesMoveClosure(borrowsOnly);
    }
}

// A GENERIC INSTANTIATION pointee whose type argument changes the LAYOUT. The mangled key is
// ABI-canonicalized before comparison, so `SigBoxE<i32>` and `SigBoxE<u32>` - and `<int>`/`<i32>`,
// and `<long>`/`<i64>` on an LP64 target - are ONE key and still bind (value legs in
// Test/test_function_ptr.cb). `double` is a different lowered type, not a different spelling of
// the same one, so this one must still be caught: `onBoxDoubleE` writes 8 bytes of double into
// the 4-byte object the slot allocated.
//
// This is the leg that proves the canonicalization is a NARROWING of the reject set and not its
// removal. If it ever starts passing, the generic-pointee proof has been lost entirely.

expect_error("function-pointer signature mismatch") {
    struct SigBoxE<T> { T v = default; };

    void onBoxDoubleE(SigBoxE<double>* b) { b->v = 51.0; }

    int runBoxE(function<void(SigBoxE<i32>*)> f) { SigBoxE<i32> q = default; f(&q); return (int)q.v; }
    int runBoxE(double d)                        { return 700 + (int)d; }

    int passWrongGenericPointee()
    {
        function<void(SigBoxE<double>*)> g = onBoxDoubleE;
        return runBoxE(g);
    }
}

// POINTER DEPTH. `ParseDeclarationSpecifiers` recorded only "is a pointer", so `int**` and `int*`
// were one signature component: `function<void(int**)>` bound a `void(int*)` slot and the callee
// dereferenced the slot's `int` VALUE as a pointer - SIGSEGV, exit 139, no diagnostic, on master
// too. FuncPtrParam.PointerDepth counts the stars and the comparator rejects when both sides
// recorded one and they differ. A depth of 0 means NOT RECORDED and still proves nothing, so
// every producer that cannot count stars (C interop, WinRT, synthesized signatures) keeps binding.
expect_error("function-pointer signature mismatch") {
    void takesIntPtrPtr(int** pp) { **pp = 42; }

    int runIntPtr(function<void(int*)> f) { int v = 7; f(&v); return v; }
    int runIntPtr(double d)               { return 700 + (int)d; }

    int passDeeperPointer()
    {
        function<void(int**)> g = takesIntPtrPtr;
        return runIntPtr(g);
    }
}

// The DECLARATION site. GetFunctionForFuncPtr selected on name, arity and `move` flags and then
// returned its candidate unconditionally, so the destination's declared component types never
// participated. All three legs below compiled and ran on master. A prefix-arity callback is NOT
// rejected here - see the "declaration-site prefix arity" value leg in Test/test_function_ptr.cb.

// Silent WRONG VALUE: `dd` was entered as an int(int), so its double argument was garbage and its
// double return was truncated. Printed s2=5, exit 0.
expect_error("cannot bind function 'declRetDiff'") {
    double declRetDiff(double x) { return x + 1000.0; }

    int bindWrongReturn()
    {
        function<int(int)> g = declRetDiff;
        return g(5);
    }
}

// Memory-unsafe: the callee reads `area` past the end of the 4-byte object the caller allocated.
// Printed `c r=77 area=0.000000`, exit 0.
expect_error("cannot bind function 'declTouchWide'") {
    struct DeclNarrow { int side = default; };
    struct DeclWide   { int r = default; double area = default; };

    void declTouchWide(DeclWide* c) { c->area = 1.0; }

    int bindWiderPointee()
    {
        function<void(DeclNarrow*)> g = declTouchWide;
        DeclNarrow s;
        g(&s);
        return 0;
    }
}

// Memory-unsafe: SIGSEGV. The callee dereferences the slot's `int` VALUE as a pointer.
expect_error("cannot bind function 'declDeepPtr'") {
    void declDeepPtr(int** pp) { **pp = 42; }

    int bindDeeperPointer()
    {
        function<void(int*)> g = declDeepPtr;
        int v = 7;
        g(&v);
        return v;
    }
}

// Struct spellings whose candidate SETS INTERSECT. The 'lamZ' leg above covers the DISJOINT half;
// this is the residual. A signature records the raw source spelling, so the bare `PtI` slot below
// - written at global scope - reached the comparator as a set of {PtI, NsI.PtI} and the argument's
// {NsI.PtI} intersected it, proving nothing. `touchNsI` then wrote 12 bytes into a 4-byte element
// and clobbered both neighbours: measured neigh=2333 instead of 20030, exit 0, no diagnostic.
//
// Each signature component now also records the key its DECLARING SCOPE resolves it to, which
// narrows a set the key is already a member of. The must-still-bind mirror (a bare spelling inside
// a namespace, argument spelled qualified) is the "namespace-ambiguous pointee binds" value leg in
// Test/test_function_ptr.cb - a fix that records the wrong key breaks that leg first.
//
// Same construction rule as the legs above: TWO overloads of the SAME arity, so the arity filter
// leaves both and the overload SCORER is what decides.
expect_error("no overload of 'runGlobalI' matches the given arguments") {
    struct PtI { int a = default; };
    namespace NsI
    {
        struct PtI { int a = default; int b = default; int c = default; };
        void touchNsI(PtI* p) { p->a = 1; p->b = 2; p->c = 333; }
    }

    int runGlobalI(function<void(PtI*)> f)
    {
        PtI[3] arr = default;
        f(&arr[0]);
        return arr[1].a * 1000 + arr[2].a;
    }
    int runGlobalI(double d) { return 700 + (int)d; }

    int passIntersectingPointee()
    {
        return runGlobalI(NsI.touchNsI);
    }
}

// A candidate refuted on its SIGNATURE used to REBIND onto a same-arity sibling that absorbs any
// pointer, so the call ran silently instead of erroring: this printed rb=999, exit 0. Rejecting in
// the overload scorer is a PREFERENCE verdict, so the refuted funcptr candidate simply lost to the
// `void*` one. A function-pointer / closure VALUE no longer converts to a `void*` parameter at all
// (ISO C has no function-to-object-pointer conversion either). The two halves that must KEEP
// working - a matching signature still beating the void* sibling, and a real DATA pointer still
// binding it - are value legs in Test/test_function_ptr.cb.
expect_error("no overload of 'rebindReject' matches the given arguments") {
    double rebindRejectOther(double x) { return x + 1000.0; }

    int rebindReject(function<int(int)> f) { return f(5); }
    int rebindReject(void* p)              { return 999; }

    int passMismatchedIntoVoidSibling()
    {
        function<double(double)> w = rebindRejectOther;
        return rebindReject(w);
    }
}

// The residue of the leg above, one parameter type over. The `void*` gate was keyed on the
// pointee NAME, so a refuted funcptr candidate simply rebound onto the next pointer-absorbing
// sibling instead: a `Rec*` one took the code address and `r->a = 11` wrote through it (SIGBUS,
// exit 138, no diagnostic), and an `int*` one was silent because the callee never dereferenced.
// Under opaque pointers CompareUpconvert cannot tell a code pointer from a data pointer, so the
// gate is now on the ARGUMENT being code and applies to every data-pointer parameter.
//
// Same construction rule as the legs above: TWO overloads of the SAME arity, so the arity filter
// leaves both and the overload SCORER is what decides. Each pins the new per-candidate line,
// which names the sibling that absorbed the value - the generic "no overload" header alone does
// not distinguish this from the signature refutation that precedes it.

expect_error("parameter 0 is a data type ('RecRb*') and the argument is a function-pointer") {
    struct RecRb { int a = default; int b = default; };

    double rebindStructOther(double x) { return x + 1000.0; }

    int rebindStruct(function<int(int)> f) { return f(5); }
    int rebindStruct(RecRb* r)             { r->a = 11; r->b = 22; return r->a + r->b; }

    int passMismatchedIntoStructSibling()
    {
        function<double(double)> w = rebindStructOther;
        return rebindStruct(w);
    }
}

expect_error("parameter 0 is a data type ('int*') and the argument is a function-pointer") {
    double rebindIntOther(double x) { return x + 1000.0; }

    int rebindInt(function<int(int)> f) { return f(5); }
    int rebindInt(int* p)               { return 888; }

    int passMismatchedIntoIntSibling()
    {
        function<double(double)> w = rebindIntOther;
        return rebindInt(w);
    }
}

// `string` is not a pointer parameter, so it is reached by a different acceptance - the implicit
// char* -> string coercion - and needs the same gate. It lowered to
// `call %string @"_operator string_string_charPtr_"(ptr @_rebindStrOther_double_double_)`, i.e.
// the callee's machine code read as a NUL-terminated buffer.
expect_error("parameter 0 is a data type ('string') and the argument is a function-pointer") {
    double rebindStrOther(double x) { return x + 1000.0; }

    int rebindStr(function<int(int)> f) { return f(5); }
    int rebindStr(string s)             { return 500 + (int)s.length(); }

    int passMismatchedIntoStringSibling()
    {
        function<double(double)> w = rebindStrOther;
        return rebindStr(w);
    }
}

// The gate is NOT "the funcptr candidate lost": with no funcptr overload in the set at all, the
// pointer parameter still must not absorb a code value. Discriminator: exactly one 'rebindOnly',
// so the arity filter leaves a single candidate and the multi-candidate ranking never runs.
expect_error("parameter 0 is a data type ('RecRo*') and the argument is a function-pointer") {
    struct RecRo { int a = default; int b = default; };

    double rebindOnlyOther(double x) { return x + 1000.0; }

    int rebindOnly(RecRo* r) { r->a = 11; r->b = 22; return r->a + r->b; }

    int passCodeIntoLoneDataPointer()
    {
        function<double(double)> w = rebindOnlyOther;
        return rebindOnly(w);
    }
}

// The VARIADIC arm of the same gate. A variadic candidate is taken as a fallback without any
// per-argument scoring at all - `if (candidate.Variadic) { possibleResult = pair; continue; }` -
// so neither this gate nor the `void*` one it was widened from ever ran for it, and
// `lam(Rec*, ...)` absorbed the code address exactly as its non-variadic sibling used to (exit
// 138, no diagnostic, on master AND on the first cut of this fix). Only the DECLARED parameters
// are judged; the `...` tail keeps binding, which is what `printf("%p", fn)` needs.
//
// Discriminator: the absorbing candidate is `Variadic`, so it is refused in the variadic
// short-circuit and never reaches the per-argument loop the legs above pin.

expect_error("parameter 0 is a data type ('RecVa*') and the argument is a function-pointer") {
    struct RecVa { int a = default; int b = default; };

    double rebindVarOther(double x) { return x + 1000.0; }

    int rebindVar(function<int(int)> f) { return f(5); }
    int rebindVar(RecVa* r, ...)        { r->a = 11; r->b = 22; return r->a + r->b; }

    int passMismatchedIntoVariadicSibling()
    {
        function<double(double)> w = rebindVarOther;
        return rebindVar(w);
    }
}

// The same with no funcptr overload in the set at all - a LONE variadic data-pointer candidate.
expect_error("parameter 0 is a data type ('RecVo*') and the argument is a function-pointer") {
    struct RecVo { int a = default; int b = default; };

    double rebindVarOnlyOther(double x) { return x + 1000.0; }

    int rebindVarOnly(RecVo* r, ...) { r->a = 11; r->b = 22; return r->a + r->b; }

    int passCodeIntoLoneVariadicDataPointer()
    {
        function<double(double)> w = rebindVarOnlyOther;
        return rebindVarOnly(w);
    }
}

// The `void*` spelling of the same hole. It was NOT closed by the gate this file's `rebindReject`
// leg pins - it printed 901 on master and on the first cut of this fix - so it is the oracle's own
// variadic hole rather than a widening of it.
expect_error("parameter 0 is a data type ('void*') and the argument is a function-pointer") {
    double rebindVarVoidOther(double x) { return x + 1000.0; }

    int rebindVarVoid(function<int(int)> f) { return f(5); }
    int rebindVarVoid(void* p, ...)         { return 901; }

    int passMismatchedIntoVariadicVoidSibling()
    {
        function<double(double)> w = rebindVarVoidOther;
        return rebindVarVoid(w);
    }
}

// A DECLARED SCALAR parameter of a variadic candidate. `ParameterStoresData` answers false for a
// non-pointer scalar, so the variadic gate let the code address through into an i32 slot and the
// failure surfaced as a raw LLVM verifier fatal - `Call parameter type does not match function
// signature!`, `call i32 (i32, ...) @_lamScalarVar_i32_i32_(ptr %0)` - identical on 904f026 and on
// the first cut of this fix. The variadic arm now asks whether the parameter ACCEPTS code rather
// than whether it stores data, which subsumes the pointer/string question and adds this cell.
//
// Discriminator: the absorbing candidate is `Variadic`, and its parameter is not a pointer, so
// neither the non-variadic scorer sites nor the pointer half of the gate can be what refused. The
// non-variadic twin `lamScalarPlain(int n)` already rejected cleanly and is left alone; the pinned
// wording is the non-pointer one, which no other leg in this file emits.
expect_error("parameter 0 has type 'int' and the argument is a function-pointer or closure VALUE") {
    double lamScalarVarOther(double x) { return x + 1000.0; }

    int lamScalarVar(int n, ...) { return 700 + n; }

    int passCodeIntoVariadicScalar()
    {
        function<double(double)> w = lamScalarVarOther;
        return lamScalarVar(w);
    }
}

// A FAT `Lambda<T>` value into a variadic data pointer. The variadic gate REFUSED this on the
// first cut of the fix (904f026 compiles it and the callee writes through the fat pointer), but
// the explanation loop required an empty-TypeName argument for every candidate - a requirement
// that belongs to the two non-variadic scorer sites - so this cell was rejected with no line
// naming the cause. The loop's shape requirement is now per-arm.
//
// Discriminator: `__closure_fat_ptr` is a NON-empty TypeName, the one shape the empty-TypeName
// requirement excluded; every other reject leg in this file passes a thin `function<>` value.
expect_error("parameter 0 is a data type ('RecFatVa*') and the argument is a function-pointer") {
    struct RecFatVa { int a = default; int b = default; };

    int lamFatVar(RecFatVa* r, ...) { r->a = 11; r->b = 22; return r->a + r->b; }

    int passFatValueIntoVariadicDataPointer()
    {
        Lambda<double(double)> w = (double x) => { return x + 1.0; };
        return lamFatVar(w);
    }
}

// -----------------------------------------------------------------------------
// The STORE side of the same defect class. Everything above judges an ARGUMENT against a
// parameter inside the overload scorer. A declarator initializer, an assignment (which also
// carries the field, element and global stores) and a `return` are separate lowering paths that
// the scorer never sees, so a code VALUE reached a data pointer through them and was written
// through: exit 138, no diagnostic, on 6e9ab46. The gate is the same two predicates read from the
// DESTINATION side (CodeValueIntoDataDestination).
//
// Discriminator for every leg below: the destination is a plain slot, not a call argument, so no
// overload set exists and none of the scorer legs above can be what refuses. The wording pinned
// here ("cannot initialize/assign/return a function-pointer or closure VALUE into data type") is
// emitted only by the three store sites and by no other diagnostic in the compiler.

// Declarator initializer - the filed repro.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'StoreRejRec*'") {
    struct StoreRejRec { int a = default; int b = default; };
    double storeRejInit(double x) { return x + 1000.0; }

    int storeIntoDeclInit()
    {
        function<double(double)> w = storeRejInit;
        StoreRejRec* r = w;
        r->a = 11;
        return r->a;
    }
}

// Plain assignment to an existing pointer local.
expect_error("cannot assign a function-pointer or closure VALUE into data type 'StoreRejRec2*'") {
    struct StoreRejRec2 { int a = default; int b = default; };
    double storeRejAssign(double x) { return x + 1000.0; }

    int storeIntoAssign()
    {
        function<double(double)> w = storeRejAssign;
        StoreRejRec2* r = nullptr;
        r = w;
        r->a = 11;
        return r->a;
    }
}

// `return` - the destination is the function's declared return type, read from
// currentFunctionReturnTV rather than from a NamedVariable, so it is its own site.
expect_error("cannot return a function-pointer or closure VALUE into data type 'StoreRejRec3*'") {
    struct StoreRejRec3 { int a = default; int b = default; };
    double storeRejRet(double x) { return x + 1000.0; }

    StoreRejRec3* storeIntoReturn()
    {
        function<double(double)> w = storeRejRet;
        return w;
    }
}

// A struct FIELD store through the `=` operator. It reaches the ASSIGNMENT site with the field's
// own type, so that one site covers this spelling - and ONLY this spelling. The brace, field-
// default and parameter-default spellings of the same store are separate lowering paths with their
// own legs further down; `b.p = w` being rejected proved nothing about any of them, and all four
// were live after the assignment gate landed.
expect_error("cannot assign a function-pointer or closure VALUE into data type 'StoreRejRec4*'") {
    struct StoreRejRec4 { int a = default; int b = default; };
    struct StoreRejBox { StoreRejRec4* p = default; };
    double storeRejField(double x) { return x + 1000.0; }

    int storeIntoField()
    {
        function<double(double)> w = storeRejField;
        StoreRejBox b = default;
        b.p = w;
        b.p->a = 11;
        return b.p->a;
    }
}

// A fixed-array ELEMENT store: the destination is a GEP, not an alloca.
expect_error("cannot assign a function-pointer or closure VALUE into data type 'StoreRejRec5*'") {
    struct StoreRejRec5 { int a = default; int b = default; };
    double storeRejElem(double x) { return x + 1000.0; }

    int storeIntoArrayElement()
    {
        function<double(double)> w = storeRejElem;
        StoreRejRec5*[4] arr = default;
        arr[0] = w;
        arr[0]->a = 11;
        return arr[0]->a;
    }
}

// A `void*` destination. The argument side already rejects a code VALUE into a `void*` parameter
// (the tightening ratified by fix/funcptr-close); the store side accepted it until now, so the
// two spellings of the same rule disagreed.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'void*'") {
    double storeRejVoid(double x) { return x + 1000.0; }

    int storeIntoVoidPointer()
    {
        function<double(double)> w = storeRejVoid;
        void* v = w;
        return v == nullptr ? 0 : 1;
    }
}

// A `string` destination. Not a pointer, but reached by the implicit char* -> string coercion,
// which lowers the code address as a NUL-terminated buffer. The message drops the cast advice
// here, because '(string)' of a raw value is itself rejected - a rejection's guidance has to be
// true where it fires.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'string'") {
    double storeRejStr(double x) { return x + 1000.0; }

    int storeIntoString()
    {
        function<double(double)> w = storeRejStr;
        string s = w;
        return (int)s.length();
    }
}

// A BARE NAMED FUNCTION straight into a data pointer - no `function<>` local in between, so the
// evidence is `Primary` being an llvm::Function rather than a recorded signature.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'StoreRejRec6*'") {
    struct StoreRejRec6 { int a = default; int b = default; };
    double storeRejNamed(double x) { return x + 1000.0; }

    int storeNamedFunctionIntoPointer()
    {
        StoreRejRec6* r = storeRejNamed;
        r->a = 11;
        return r->a;
    }
}

// The `using` ALIAS spelling of the destination. A fix has been half-done along this exact axis
// before (the direct branch fixed, the alias branch left live), so it is pinned separately.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'StoreRejRec7*'") {
    struct StoreRejRec7 { int a = default; int b = default; };
    using StoreRejAlias = StoreRejRec7*;
    double storeRejAliasFn(double x) { return x + 1000.0; }

    int storeIntoAliasedPointer()
    {
        function<double(double)> w = storeRejAliasFn;
        StoreRejAlias r = w;
        r->a = 11;
        return r->a;
    }
}

// Compound `+=` is a DIFFERENT question and gets its own wording: the code address is consumed as
// an INTEGER OFFSET (`ptrtoint` of the callee, added to the pointer), forging an address that is
// neither the function nor the original pointee. Verified from --no-opt IR on 6e9ab46:
//   %2 = ptrtoint ptr %1 to i64   %3 = ptrtoint ptr %0 to i64   ...   store ptr %4, ptr %r
expect_error("as the right operand of '+=' on data type 'StoreRejRec8*' - a code address is not an offset") {
    struct StoreRejRec8 { int a = default; int b = default; };
    double storeRejOffset(double x) { return x + 1000.0; }

    int storeCodeValueAsPointerOffset()
    {
        function<double(double)> w = storeRejOffset;
        StoreRejRec8* r = nullptr;
        r += w;
        return r == nullptr ? 0 : 1;
    }
}

// ---------------------------------------------------------------------------
// The AGGREGATE and DEFAULT store spellings. None of these reach the declarator, assignment or
// return sites, so all four were still exit 138 with no diagnostic after those three gates landed
// - the syntax axis, not the type axis. Each is a distinct lowering path:
//   brace field init  -> EmitOneFieldInit         ('= {f=v}', bare '{f=v}', 'new T {f=v}')
//   array aggregate   -> EmitPositionalFixedArrayInit / EmitArrayViewInferredInit / global twin
//   field default     -> the five default-constructor emitters
//   parameter default -> the omitted-argument forwarding wrapper
//
// Discriminator for all of them: no assignment operator and no declarator initializer is written,
// so neither of those gates can be what refuses; the wording ("brace-initialize" /
// "default-initialize", naming the field, element or parameter) is emitted only by these sites.

expect_error("cannot brace-initialize a function-pointer or closure VALUE into field 'BraceHolder.p' of data type 'BraceRec*'") {
    struct BraceRec { int a = default; int b = default; };
    struct BraceHolder { BraceRec* p = default; int n = default; };
    double braceRo(double x) { return x + 1000.0; }

    int storeIntoBraceField()
    {
        function<double(double)> w = braceRo;
        BraceHolder h = { p = w, n = 3 };
        h.p->a = 11;
        return h.p->a;
    }
}

// The BARE-brace spelling of the same declaration. A previous fix in this repo gated only the
// '= {...}' form and left this one live, because the brace token sits on the declarator instead
// of on an initializer - that is exactly the hole this leg exists to pin.
expect_error("cannot brace-initialize a function-pointer or closure VALUE into field 'BareHolder.p' of data type 'BareRec*'") {
    struct BareRec { int a = default; int b = default; };
    struct BareHolder { BareRec* p = default; int n = default; };
    double bareRo(double x) { return x + 1000.0; }

    int storeIntoBareBraceField()
    {
        function<double(double)> w = bareRo;
        BareHolder h { p = w, n = 3 };
        h.p->a = 11;
        return h.p->a;
    }
}

// The 'new T { ... }' spelling: a heap destination rather than a stack one.
expect_error("cannot brace-initialize a function-pointer or closure VALUE into field 'NewHolder.p' of data type 'NewRec*'") {
    struct NewRec { int a = default; int b = default; };
    struct NewHolder { NewRec* p = default; int n = default; };
    double newRo(double x) { return x + 1000.0; }

    int storeIntoNewBraceField()
    {
        function<double(double)> w = newRo;
        NewHolder* h = new NewHolder { p = w, n = 3 };
        h->p->a = 11;
        return h->p->a;
    }
}

// A positional fixed-array aggregate. The destination is the ELEMENT type, which is derived from
// the array's star count (Pointer + ElemPointer) - deriving it from ElemPointer alone, as the
// array-VIEW path does, silently disarms the guard for every 'T*[N]'.
expect_error("cannot brace-initialize a function-pointer or closure VALUE into element 0 of 'arr' of data type 'ArrRec*'") {
    struct ArrRec { int a = default; int b = default; };
    double arrRo(double x) { return x + 1000.0; }

    int storeIntoArrayAggregate()
    {
        function<double(double)> w = arrRo;
        ArrRec*[2] arr = { w, w };
        arr[0]->a = 11;
        return arr[0]->a;
    }
}

// The 'T**' element spelling, which also proves the diagnostic renders the FULL pointer depth: a
// message naming 'ArrRec2*' would be describing a type the source never wrote.
expect_error("into element 0 of 'arr' of data type 'ArrRec2**' - code does not convert to a data pointer; write an explicit '(ArrRec2**)' cast") {
    struct ArrRec2 { int a = default; int b = default; };
    double arrRo2(double x) { return x + 1000.0; }

    int storeIntoPointerToPointerElement()
    {
        function<double(double)> w = arrRo2;
        ArrRec2**[2] arr = { w, w };
        return arr[0] == nullptr ? 0 : 1;
    }
}

// A struct field DEFAULT initializer - no declaration and no braces at the use site at all.
expect_error("cannot default-initialize a function-pointer or closure VALUE into field 'DefH.p' of data type 'DefRec*'") {
    struct DefRec { int a = default; int b = default; };
    double defRo(double x) { return x + 1000.0; }
    struct DefH { DefRec* p = defRo; };

    int storeIntoFieldDefault()
    {
        DefH h = default;
        h.p->a = 11;
        return h.p->a;
    }
}

// The CLASS twin of the field default. Struct and class have SEPARATE default-constructor
// emitters (five in total across the declaration kinds), and gating only the struct ones left
// this spelling reproducing - measured, not assumed.
expect_error("cannot default-initialize a function-pointer or closure VALUE into field 'DefC.p' of data type 'DefRec2*'") {
    struct DefRec2 { int a = default; int b = default; };
    double defRo2(double x) { return x + 1000.0; }
    class DefC { DefRec2* p = defRo2; };

    int storeIntoClassFieldDefault()
    {
        DefC h = default;
        h.p->a = 11;
        return h.p->a;
    }
}

// A PARAMETER default value: the slot is filled by the omitted-argument forwarding wrapper, which
// is neither a field nor a declarator.
expect_error("cannot default-initialize a function-pointer or closure VALUE into parameter 'p' of data type 'ParamRec*'") {
    struct ParamRec { int a = default; int b = default; };
    double paramRo(double x) { return x + 1000.0; }

    int takesDefaulted(ParamRec* p = paramRo) { p->a = 11; return p->a; }

    int storeIntoParameterDefault()
    {
        return takesDefaulted();
    }
}

// An ARRAY-VIEW destination gets NO cast advice, because no cast reaches it: '(int*)w' then fails
// the view's own "cannot bind a raw pointer 'T*' to an array-view" check and '(int[])w' is refused
// outright. Both were measured before the advice was dropped. The leg pins the ABSENCE by pinning
// the message's end - a rejection must not send the user into a second error.
expect_error("into data type 'int[]' - code does not convert to a data pointer") {
    double viewRo(double x) { return x + 1000.0; }

    int storeIntoArrayView()
    {
        function<double(double)> w = viewRo;
        int[] v = w;
        return v == nullptr ? 0 : 1;
    }
}

// A COMPOUND operator on a non-pointer destination. 'string +=' is concatenation, not pointer
// arithmetic, so the offset wording that is true for 'Rec* +=' would be false here. On the merge
// base this spelling reached the LLVM verifier as "GEP indexes must be integers" with no source
// location, so this also satisfies the rule that a diagnosed LLVM failure becomes a real error.
expect_error("as the right operand of '+=' on data type 'string' - a code address is not a value of that type") {
    double strOpRo(double x) { return x + 1000.0; }

    int storeCodeValueIntoStringConcat()
    {
        function<double(double)> w = strOpRo;
        string s = "x";
        s += w;
        return (int)s.length();
    }
}

// The GLOBAL fixed-array aggregate. Its elements are folded to LLVM constants inside a throwaway
// function with the builder redirected, so the reject is RECORDED and raised after the builder
// state is restored - LogErrorContext throws, and unwinding from inside that loop would leave the
// insert point in the temp function. Same wording as the local twin; the discriminator is that no
// function body encloses it.
expect_error("cannot brace-initialize a function-pointer or closure VALUE into element 0 of 'gArrReject' of data type 'GlobRec*'") {
    struct GlobRec { int a = default; int b = default; };
    double globRo(double x) { return x + 1000.0; }
    GlobRec*[2] gArrReject = { globRo, globRo };
}

// The length-inferred ARRAY-VIEW aggregate (EmitArrayViewInferredInit). Its live spelling is a
// `string` element, NOT a pointer one: `Rec*[] v = {w, w}` never reaches this gate - the
// pre-existing "a fixed array is not assignable from a pointer" fires first, identically on both
// binaries - so a pointer leg here would pass for the wrong reason and pin nothing.
//
// On the merge base this is a SILENT MISCOMPILE, not a crash: exit 0, length() reads 1, .data()
// prints empty. Established from --no-opt IR rather than the probe value - the element store is
// `store %string %1, ptr %arrview_elem` with %1 wrapping @_ro_double_double_, the callee's machine
// code read as a NUL-terminated buffer.
//
// Discriminator: `string` is not a pointer, so the pointer half of the gate cannot be what refused,
// and the message carries no cast advice (there is no '(string)' of a raw value) - the only other
// leg with that shape names a declarator, not an element.
expect_error("cannot brace-initialize a function-pointer or closure VALUE into element 0 of 'v' of data type 'string'") {
    double viewStrRo(double x) { return x + 1000.0; }

    int storeIntoStringArrayViewElement()
    {
        function<double(double)> w = viewStrRo;
        string[] v = { w, w };
        return (int)v[0].length();
    }
}

/*
 * A '?:' / '??' JOIN erases the source evidence every gate above reads: the '?:' spelling is a PHI
 * and the '??' spelling a load out of a slot, and neither carries a TypeName, a recorded signature
 * or an llvm::Function Primary. On the merge base every leg below compiled with NO diagnostic and
 * ran to exit 138 (a code address written through as a data pointer). The gates now resolve a join
 * through the per-value code ledger, so all three - argument, store and return - see it again.
 *
 * Discriminator for every leg: the bare spelling of the same store is already diagnosed, so what
 * these pin is the JOIN wrapper. Each one is mutation-tested by deleting the RegisterCodeValue
 * call - the whole family reverts to compiling.
 */
struct JoinRec { int a = default; int b = default; };
double joinRo(double x) { return x + 1000.0; }
double joinR2(double x) { return x + 2000.0; }
int joinLam(JoinRec* p) { p->a = 11; return p->a; }

// The DECLARATOR, both join spellings. '??' arms are unrecoverable from the IR, so this leg is the
// one that proves the nullCoalesceJoins_ ledger (not the PHI walk) answers.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int ternaryIntoDataPointer(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        JoinRec* r = c > 0 ? w : n;
        return r->a;
    }
}

expect_error("cannot initialize a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int nullCoalesceIntoDataPointer()
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        JoinRec* r = n ?? w;
        return r->a;
    }
}

/*
 * The ARGUMENT gate - the leg that shows this is not a store-side defect. `joinLam(w)` has been
 * diagnosed since the code VALUE stopped converting to a data parameter; wrapping the same value
 * in a join made it bind again. Discriminator: the pinned text is the per-CANDIDATE line of the
 * overload dump, which only the code-value arm of the scorer emits, and the single candidate has
 * the matching arity so no other arm can claim the refusal.
 */
expect_error("parameter 0 is a data type ('JoinRec*') and the argument is a function-pointer or closure VALUE") {
    int ternaryAsDataArgument(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        return joinLam(c > 0 ? w : n);
    }
}

expect_error("parameter 0 is a data type ('JoinRec*') and the argument is a function-pointer or closure VALUE") {
    int nullCoalesceAsDataArgument()
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        return joinLam(n ?? w);
    }
}

// The RETURN leg, against the declared return type.
expect_error("cannot return a function-pointer or closure VALUE into data type 'JoinRec*'") {
    JoinRec* returnTernaryAsDataPointer(int c, function<double(double)> w, JoinRec* n)
    {
        return c > 0 ? w : n;
    }
}

// The ASSIGNMENT leg ('=' also carries the field, element and global stores).
expect_error("cannot assign a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int assignTernaryIntoDataPointer(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* r = nullptr;
        r = c > 0 ? w : nullptr;
        return r->a;
    }
}

// The SYNTAX-axis sites: a brace field initializer, a fixed-array element, a struct field DEFAULT
// and a parameter DEFAULT are four separate lowering paths, reached by none of the three above.
expect_error("cannot brace-initialize a function-pointer or closure VALUE into field 'JoinHolder.p'") {
    struct JoinHolder { JoinRec* p = default; int n = default; };

    int braceInitFromTernary(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        JoinHolder h = { p = c > 0 ? w : n, n = 3 };
        return h.p->a;
    }
}

expect_error("cannot brace-initialize a function-pointer or closure VALUE into element 0 of 'a'") {
    int arrayElementFromTernary(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        JoinRec*[2] a = { c > 0 ? w : n, n };
        return a[0]->a;
    }
}

expect_error("cannot default-initialize a function-pointer or closure VALUE into field 'JoinDef.p'") {
    function<double(double)> gJoinW = joinRo;
    struct JoinDef { JoinRec* p = gJoinW ?? nullptr; };
}

expect_error("cannot default-initialize a function-pointer or closure VALUE into parameter 'p'") {
    function<double(double)> gJoinW2 = joinRo;
    int paramDefaultFromJoin(JoinRec* p = gJoinW2 ?? nullptr) { return p->a; }
}

// A NESTED join and a join-of-joins: the resolution walks arms recursively, so a code value buried
// one level down is still found. Discriminator: the outer join's own arms are both plain pointers.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int nestedTernaryIntoDataPointer(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        JoinRec* r = c > 0 ? (c > 1 ? w : n) : n;
        return r->a;
    }
}

expect_error("cannot initialize a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int joinOfJoinIntoDataPointer(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        JoinRec* r = (c > 0 ? w : n) ?? n;
        return r->a;
    }
}

// A bare function NAME as an arm carries no ledger entry at all - it arrives as an llvm::Function,
// which the arm walk recognizes directly. Discriminator: no read of a `function<>` local happens.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int functionNameArmIntoDataPointer(int c)
    {
        JoinRec* n = nullptr;
        JoinRec* r = c > 0 ? joinRo : n;
        return r->a;
    }
}

// A join of TWO code arms into a data pointer: neither arm is a legal source, and the resolution
// answering on the FIRST one must not depend on the other being data.
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int bothArmsCodeIntoDataPointer(int c)
    {
        function<double(double)> w = joinRo;
        function<double(double)> w2 = joinR2;
        JoinRec* r = c > 0 ? w : w2;
        return r->a;
    }
}

/*
 * `void*` through a join. Ratified separately from the crashing legs: this one does NOT crash on
 * the merge base (exit 0, the address is simply stored), and it is the join spelling of the rule
 * that a code VALUE does not convert to a `void*` destination - already an error for the bare
 * store and for a `void*` parameter. The two spellings of one rule now agree.
 */
expect_error("cannot initialize a function-pointer or closure VALUE into data type 'void*'") {
    int ternaryIntoVoidPointer(int c)
    {
        function<double(double)> w = joinRo;
        void* n = nullptr;
        void* v = c > 0 ? w : n;
        return v == nullptr ? 0 : 1;
    }
}

/*
 * The one join arm that CONSUMES the evidence instead of erasing it: when the other arm is a
 * `string`, the arm harmonizer wraps the code pointer as a NUL-terminated buffer, so the join
 * delivers a `string` VALUE and no downstream gate has a pointer left to question. On the merge
 * base this is a SILENT MISCOMPILE (exit 0, an empty string), not a crash. It is refused at the
 * harmonizer instead, which is why its wording is the arm one rather than the store one.
 */
expect_error("cannot convert a function-pointer or closure VALUE in a '?:' arm to 'string'") {
    int ternaryStringArmFromCode(int c)
    {
        function<double(double)> w = joinRo;
        string s = "hi";
        string picked = c > 0 ? w : s;
        return (int)picked.length();
    }
}

/*
 * '??=' is a SEPARATE store path from '=': it emits its own compare/branch/store and returns
 * before the plain-'=' gate ever runs, and it parses its RHS through the lean VALUE path, which
 * discards the NamedVariable that gate reads. On the merge base `r ??= w;` compiled clean and
 * exited 138 while the bare `r = w;` was already diagnosed - so the two spellings of one store
 * disagreed. Discriminator: the pinned wording is the ASSIGN role, and the leg uses '??=', whose
 * store the '=' site never sees.
 */
expect_error("cannot assign a function-pointer or closure VALUE into data type 'JoinRec*'") {
    int nullAssignCodeIntoDataPointer()
    {
        function<double(double)> w = joinRo;
        JoinRec* r = nullptr;
        r ??= w;
        return r->a;
    }
}

expect_error("cannot assign a function-pointer or closure VALUE into data type 'void*'") {
    int nullAssignCodeIntoVoidPointer()
    {
        function<double(double)> w = joinRo;
        void* v = nullptr;
        v ??= w;
        return v == nullptr ? 0 : 1;
    }
}

/*
 * A join argument scored against an overload SET where EVERY candidate is a data parameter. The
 * code-value rule is read by the scorer's refute arm, so this is the shape where it moves overload
 * resolution: on the merge base the call silently selected `g(void*)` and stored a code address
 * there. It is refused now, with a per-candidate line for BOTH candidates - and that pair is the
 * discriminator, since a single-candidate leg cannot show the whole set was refuted rather than
 * one candidate simply losing. The sibling set that CONTAINS a `function<>` candidate still binds
 * it, unchanged on both binaries; its accept leg is cvj_overload_set_binds_funcptr.
 */
expect_error("[_joinOv_i32_U8Ptr_] parameter 0 is a data type ('void*') and the argument is a function-pointer or closure VALUE") {
    int joinOv(JoinRec* p) { return 1; }
    int joinOv(void* p) { return 2; }

    int joinArgumentAgainstAllDataOverloadSet(int c)
    {
        function<double(double)> w = joinRo;
        JoinRec* n = nullptr;
        return joinOv(c > 0 ? w : n);
    }
}

/*
 * THE JOIN MIRROR. `WidenToClosureFatChecked` gates on argument PROVENANCE and rejects only what
 * is PROVABLY data, which is the correct polarity - but a '?:' / '??' join carries no declared
 * facts at all, so on the merge base every leg below COMPILED CLEAN and exited 139 at runtime: a
 * data pointer landed in the fat closure's CODE slot and was called. The bare spelling of each was
 * already diagnosed, which is what makes these join defects rather than plain holes.
 *
 * The resolution ledgers values proven to be DATA and asks the join whether EVERY arm is proven
 * data (a null arm is neutral). Discriminator for these legs: every arm is proven data, so the
 * mixed joins in testDataJoinClosureAccepts (one code arm) stay accepted while these are refused.
 */
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djApplyFatTern(Lambda<int(int)> f) { return f(5); }

    int ternaryDataJoinIntoClosureParam(int c)
    {
        int q = 1;
        void* vp = &q;
        void* vq = nullptr;
        return djApplyFatTern(c > 0 ? vp : vq);
    }
}

expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djApplyFatCoal(Lambda<int(int)> f) { return f(5); }

    int nullCoalesceDataJoinIntoClosureParam()
    {
        int q = 1;
        void* vp = &q;
        void* vq = nullptr;
        return djApplyFatCoal(vq ?? vp);
    }
}

// The METHOD-call spelling of the same join - a different lowering path to the one gate.
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    class DjRejectBox { int lam(Lambda<int(int)> f) { return f(5); } };

    int methodDataJoinIntoClosureParam(int c)
    {
        DjRejectBox d;
        int q = 1;
        void* vp = &q;
        void* vq = nullptr;
        return d.lam(c > 0 ? vp : vq);
    }
}

// VIRTUAL dispatch (LowerByValueArg) - the second half of the one shared accept set.
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    interface IDjReject { int lam(Lambda<int(int)> f); };
    class DjRejectImpl : IDjReject { int lam(Lambda<int(int)> f) { return f(5); } };

    int virtualDataJoinIntoClosureParam(int c)
    {
        DjRejectImpl impl;
        IDjReject io = impl;
        int q = 1;
        void* vp = &q;
        void* vq = nullptr;
        return io.lam(c > 0 ? vp : vq);
    }
}

// A NESTED join: the inner '?:' is itself an arm, so the walk has to recurse to prove all-data.
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djApplyFatNested(Lambda<int(int)> f) { return f(5); }

    int nestedDataJoinIntoClosureParam(int c)
    {
        int q = 1;
        void* vp = &q;
        void* vq = nullptr;
        void* vr = &q;
        return djApplyFatNested(c > 0 ? (c > 1 ? vp : vq) : vr);
    }
}

// A literal `nullptr` arm is NEUTRAL, not proof of code: null can never be called either, so a
// data-plus-null join is still refused. The all-null join has no proven arm and is not refused.
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djApplyFatNull(Lambda<int(int)> f) { return f(5); }

    int dataPlusNullJoinIntoClosureParam(int c)
    {
        int q = 1;
        void* vp = &q;
        return djApplyFatNull(c > 0 ? vp : nullptr);
    }
}

// A `void*` PARAMETER is proven data by its declared type exactly as a local is - the bare
// spelling of this leg was already diagnosed on the merge base, the join spelling was not.
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djApplyFatParam(Lambda<int(int)> f) { return f(5); }

    int paramDataJoinIntoClosureParam(void* u, int c)
    {
        int q = 1;
        void* vp = &q;
        return djApplyFatParam(c > 0 ? u : vp);
    }
}

// The SECOND argument position, with a legal closure in the first: the gate runs per argument.
expect_error("cannot pass a non-function pointer value to closure parameter 'g'") {
    int djApply2(Lambda<int(int)> f, Lambda<int(int)> g) { return f(5) + g(6); }

    int secondPositionDataJoinIntoClosureParam(int c)
    {
        int q = 1;
        void* vp = &q;
        void* vq = nullptr;
        Lambda<int(int)> good = (int x) => { return x + 1; };
        return djApply2(good, c > 0 ? vp : vq);
    }
}

// The THIN `function<>` sibling shares the one provenance predicate, so the join resolution has to
// reach it too or the two parameter flavours drift into different accept sets.
expect_error("cannot pass a non-function pointer value to 'function<>' parameter 'f'") {
    int djApplyThinRej(function<int(int)> f) { return f(5); }

    int ternaryDataJoinIntoThinParam(int c)
    {
        int q = 1;
        void* vp = &q;
        void* vq = nullptr;
        return djApplyThinRej(c > 0 ? vp : vq);
    }
}

/*
 * The ARM-SPELLING axis. The ledger records at the one read site, so a struct FIELD and a
 * fixed-array ELEMENT arm are proven data exactly as a local is - the same axis the code-value
 * accept legs (cvj_tern_field_arm / cvj_tern_elem_arm) cover from the other side. Both compiled
 * clean and exited 139 on the merge base.
 */
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    struct DjFieldBox { void* p = default; void* q = default; };
    int djApplyFatField(Lambda<int(int)> f) { return f(5); }

    int fieldArmDataJoinIntoClosureParam(int c)
    {
        int z = 1;
        DjFieldBox b = default;
        b.p = &z;
        return djApplyFatField(c > 0 ? b.p : b.q);
    }
}

expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djApplyFatElem(Lambda<int(int)> f) { return f(5); }

    int elementArmDataJoinIntoClosureParam(int c)
    {
        int z = 1;
        void*[2] arr = default;
        arr[0] = &z;
        return djApplyFatElem(c > 0 ? arr[0] : arr[1]);
    }
}

/*
 * A RATIFIED TIGHTENING, not a closed hole: these three ran CORRECTLY on the merge base. A `void*`
 * that happens to hold a code address is proven DATA by its declared type, so a join of such
 * values is refused - and refusing it is what makes the join spelling agree with the bare one,
 * which was already rejected on the merge base (`void* fp = (void*)hInc; applyL(fp);` is a hard
 * error on BOTH binaries). The remedy is the escape hatch the message now names, exercised as
 * an accept leg: cast to the thin `function<>`, over the whole join (dj_cast_over_join) or per arm
 * (dj_cast_in_each_arm). Discriminator: the arms are declared `void*`, so nothing at the call site
 * distinguishes them from the memory-unsafe legs above - which is exactly why they are refused.
 */
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djTightenInc(int x) { return x + 1; }
    int djApplyFatTighten(Lambda<int(int)> f) { return f(5); }

    int voidPointerHoldingCodeJoinedIntoClosureParam(int c)
    {
        void* fp = (void*)djTightenInc;
        void* fq = (void*)djTightenInc;
        return djApplyFatTighten(c > 0 ? fp : fq);
    }
}

// The same tightening reached through a CALL RESULT arm and a DEREFERENCE arm - both are proven
// data by their declared return / pointee type, and both ran correctly on the merge base.
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djTightenInc2(int x) { return x + 1; }
    void* djMakeVoid() { return (void*)djTightenInc2; }
    int djApplyFatTighten2(Lambda<int(int)> f) { return f(5); }

    int callResultArmJoinedIntoClosureParam(int c)
    {
        void* vp = (void*)djTightenInc2;
        return djApplyFatTighten2(c > 0 ? djMakeVoid() : vp);
    }
}

expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djTightenInc3(int x) { return x + 1; }
    int djApplyFatTighten3(Lambda<int(int)> f) { return f(5); }

    int dereferenceArmJoinedIntoClosureParam(int c)
    {
        void* vp = (void*)djTightenInc3;
        void** pp = &vp;
        return djApplyFatTighten3(c > 0 ? *pp : vp);
    }
}

/*
 * THE MIRROR LAUNDER MUST NOT KEY ON A SHARED CONSTANT. `(function<>)nullptr` casts the ONE shared
 * ConstantPointerNull, so recording the cast SOURCE let an unrelated join's null arm in the same
 * statement read as user-asserted code and re-opened the widen - the same hazard that makes
 * codeValueDataCasts_ statement-scoped, in the opposite direction. The register site now refuses
 * shared constants outright (null and llvm::Function), which is structural rather than scoped.
 * Discriminator: the cast is on a DIFFERENT argument from the join, so only a launder keyed on the
 * shared null can connect them; the same statement with a non-null-arm join was already refused.
 */
expect_error("cannot pass a non-function pointer value to closure parameter 'g'") {
    int djApply2Null(Lambda<int(int)> f, Lambda<int(int)> g) { return f(5) + g(6); }

    int nullCastLaundersUnrelatedJoinNullArm(int c)
    {
        int z = 1;
        void* vp = &z;
        return djApply2Null((function<int(int)>)nullptr, c > 0 ? vp : nullptr);
    }
}

// The same shared-null hazard reached from INSIDE the join: a `(function<>)nullptr` ARM must not
// launder the join it sits in. The other arm is proven data, so the program calls either null or a
// data pointer and never a function - null arms stay NEUTRAL by design and cannot rescue it.
expect_error("cannot pass a non-function pointer value to closure parameter 'f'") {
    int djApplyFatNullArm(Lambda<int(int)> f) { return f(5); }

    int castNullArmDoesNotLaunderTheJoin(int c)
    {
        int z = 1;
        void* vp = &z;
        return djApplyFatNullArm(c > 0 ? (function<int(int)>)nullptr : vp);
    }
}

/*
 * The same gate on a GENERIC instantiation over a closure type. A `list<Lambda<>>` element and a
 * substituted `Box<Lambda<>>` field are the same fat {code, env} slot as a spelled parameter, so a
 * data pointer must be refused there too. Both spellings pre-dated any gate: they died in the
 * module verifier with NO source location ("Call parameter type does not match function
 * signature!"), so the diagnostic below is what proves the gate now runs on the encoded element.
 * Discriminator: the message names the real destination ('value' for the container's add, the
 * qualified field for the store) - the verifier dump named neither.
 */
expect_error("cannot pass a non-function pointer value to closure parameter 'value'") {
    int dpgcQ = 3;

    void dataPointerIntoFatContainer()
    {
        list<Lambda<int(int)>> fns;
        void* vp = &dpgcQ;
        fns.add(vp);
    }
}

// A field STORE reaches the same provenance gate as an argument pass, so the message must name
// the field it stores into - not call the struct variable a "parameter".
expect_error("cannot store a 'void*' value into closure field 'gb.item'") {
    struct DpgcBox<T> { T item = default; };
    int dpgcQ2 = 3;

    void dataPointerIntoFatGenericField()
    {
        DpgcBox<Lambda<int(int)>> gb = default;
        void* vp = &dpgcQ2;
        gb.item = vp;
    }
}

// THIN element, same shape: `list<function<>>` used to WRAP any pointer into its element slot
// without asking where it came from, so this compiled and called a data address as code.
expect_error("cannot pass a non-function pointer value to 'function<>' parameter 'value'") {
    int dpgcQ3 = 3;

    void dataPointerIntoThinContainer()
    {
        list<function<int(int)>> fns;
        void* vp = &dpgcQ3;
        fns.add(vp);
    }
}
