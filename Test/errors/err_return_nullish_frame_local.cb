struct T423FrameStruct { int f = 0; };

expect_error("cannot return the address of a '??' arm: it points into this function's own frame") {
    int* t423NullishScalar(int* q)
    {
        int n = 5;
        return q ?? &n;
    }
}

expect_error("cannot return the address of a '??' arm: it points into this function's own frame") {
    int* t423NullishArray(int* q)
    {
        int[2] arr = {5, 6};
        return q ?? &arr[0];
    }
}

expect_error("cannot return the address of a '??' arm: it points into this function's own frame") {
    int* t423NullishField(int* q)
    {
        T423FrameStruct s = default;
        return q ?? &s.f;
    }
}

expect_error("cannot return the address of a '??' arm: it points into this function's own frame") {
    int* t423NullishNested(int* a, int* b)
    {
        int n = 5;
        return a ?? (b ?? &n);
    }
}

expect_error("cannot return the address of a '??' arm: it points into this function's own frame") {
    int* t423Mixed(bool c, int* q, int* r)
    {
        int n = 5;
        return c ? q : (r ?? &n);
    }
}

extern int main() { return 0; }
