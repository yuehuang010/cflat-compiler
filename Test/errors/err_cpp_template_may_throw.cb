// libc++ members carry no noexcept specification, so calling one hits the SAME gate every other
// potentially-throwing C++ function hits under --cpp-strict-noexcept (this file's .flags
// sidecar): cflat emits no landing pads. Without the flag the call is allowed, as in clang.
import cpp "vector";

expect_error("may throw - C++ exceptions are not supported yet") {
    extern int main()
    {
        std.vector<int> v = default;
        v.push_back(1);
        return (int)v.size();
    }
}
