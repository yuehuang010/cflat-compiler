// A C-imported record without a layout registers as an unsized opaque shell. Declaring one
// by value must be a clean diagnostic, not an LLVM module-verification failure.
//
// _PROC_THREAD_ATTRIBUTE_LIST (winbase.h) is only ever forward-declared, so it stays unsized -
// exactly the incomplete-layout path this test guards. (Earlier targets now import fine:
// SERVICE_CUSTOM_SYSTEM_STATE_CHANGE_DATA_ITEM, whose anonymous typedef'd union member lays out
// since anonymous typedef records are emitted; RETRIEVAL_POINTERS_BUFFER.Extents[1] - see
// Test/test_windows.cb - and userCLIPFORMAT, laid out since records are ordered nested-first.)
import "windows.h";

extern int main()
{
    expect_error("is incomplete here (its layout is not available at this point)");
    _PROC_THREAD_ATTRIBUTE_LIST rec = default;
}
