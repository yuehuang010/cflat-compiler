// All six lock/sync primitives own OS state through a mutable `void*` slot and
// release it from a hand-written destructor. The non-trivial destructor suppresses
// memberwise copy, while `mutex b = a;` still MOVES and leaves one owner.

import "mutex.cb";
import "rwlock.cb";
import "event.cb";
import "semaphore.cb";
import "barrier.cb";

expect_error("cannot copy 'mutex': it has a non-trivial destructor") {
    void testMutexCopy() {
        mutex a;
        mutex b = a.copy();
    }
}

expect_error("cannot copy 'condvar': it has a non-trivial destructor") {
    void testCondvarCopy() {
        condvar a;
        condvar b = a.copy();
    }
}

expect_error("cannot copy 'rwlock': it has a non-trivial destructor") {
    void testRwlockCopy() {
        rwlock a;
        rwlock b = a.copy();
    }
}

expect_error("cannot copy 'event': it has a non-trivial destructor") {
    void testEventCopy() {
        event a;
        event b = a.copy();
    }
}

expect_error("cannot copy 'semaphore': it has a non-trivial destructor") {
    void testSemaphoreCopy() {
        semaphore a;
        semaphore b = a.copy();
    }
}

expect_error("cannot copy 'barrier': it has a non-trivial destructor") {
    void testBarrierCopy() {
        barrier a;
        barrier b = a.copy();
    }
}

extern int main()
{
    return 0;
}
