import cpp "../library/cpp_t110_varlink.hpp";

// A non-trivial C++ class in the `...` tail remains conditionally-supported and is refused.
int main()
{
    T204Nontrivial value = T204Nontrivial();
    expect_error("cannot pass non-trivial C++ class") {
        int r = t204_nontrivial(3, value);
    }
    return 0;
}
