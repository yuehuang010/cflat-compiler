// Mandatory nodiscard: a call whose RETURN type is owned must not be dropped in a discard
// position - the returned heap object would never be consumed. Detection is by value identity of
// the full-expression result, so paren/ternary wrappers are covered and an owned value passed on
// (argument, delete, bind, return) is not flagged. `_ = expr` is the explicit-discard opt-out.
// Each block below is compiled on its own and must raise the exact message substring.

// Owned POINTER return discarded (the real leak class).
expect_error("owning return value of 'makePtr' must not be discarded") {
    class R1 { int id = default; };
    move R1* makePtr() { return new R1; }
    void useIt() { makePtr(); }
}

// Paren-wrapped discard is still caught (a paren is a transparent wrapper).
expect_error("owning return value of 'makePtr2' must not be discarded") {
    class R2 { int id = default; };
    move R2* makePtr2() { return new R2; }
    void useIt2() { ((makePtr2())); }
}

// Ternary discard is caught (both arms are owning returns; the select carries the ownership).
expect_error("owning return value of 'makePtr3' must not be discarded") {
    class R3 { int id = default; };
    move R3* makePtr3() { return new R3; }
    void useIt3(bool c) { c ? makePtr3() : makePtr3(); }
}

// A MIXED ternary (one owning arm, one live borrow) is still DETECTED even though the caller
// deliberately does not free it: releasing that join would destroy whatever the phi selected,
// so detection and release are separate ledgers. See PropagateTernaryOwnership.
expect_error("owning return value of 'makePtr6' must not be discarded") {
    class R6 { int id = default; };
    move R6* makePtr6() { return new R6; }
    R6* g_borrowed6 = nullptr;
    void useIt6(bool c) { c ? makePtr6() : g_borrowed6; }
}

// The mirrored form: the owning arm is the FALSE arm, so either-arm detection is exercised.
expect_error("owning return value of 'makePtr7' must not be discarded") {
    class R7 { int id = default; };
    move R7* makePtr7() { return new R7; }
    R7* g_borrowed7 = nullptr;
    void useIt7(bool c) { c ? g_borrowed7 : makePtr7(); }
}

// A NESTED mixed ternary discarded: the inner join is release-SUPPRESSED, and suppression must
// not silence the check - detection rides the join outward even though no free is emitted.
expect_error("owning return value of 'makePtr8' must not be discarded") {
    class R8 { int id = default; };
    move R8* makePtr8() { return new R8; }
    R8* g_borrowed8 = nullptr;
    void useIt8(bool a, bool b) { a ? (b ? makePtr8() : g_borrowed8) : nullptr; }
}

// Owned STRING return discarded (uniform policy - strings error too, not only pointers).
expect_error("owning return value of 'makeStr' must not be discarded") {
    move string makeStr() { string s = "x"; return s.copy(); }
    void useIt4() { makeStr(); }
}

// A bare owning-return call in for-INIT position is a discard too (a for-init DECLARATION,
// `for (int i = 0; ...)`, is unaffected - only a bare owning-call expression errors).
expect_error("owning return value of 'makePtr5' must not be discarded") {
    class R5 { int id = default; };
    move R5* makePtr5() { return new R5; }
    void useIt5() { int i = 0; for (makePtr5(); i < 0; i = i + 1) { } }
}

// A VOID lambda's `=> expr` body is a DISCARD position too, so the same check runs there. Pre-fix
// the arm emitted a return into the void invoker and this shape died in the module verifier.
expect_error("owning return value of 'makePtr9' must not be discarded") {
    class R9 { int id = default; };
    move R9* makePtr9() { return new R9; }
    void useIt9() { Lambda<void()> g = () => makePtr9(); g(); }
}

// The explicit discard remedy is also valid in a lambda expression body, with or without an
// extra pair of parentheses around the assignment.
class R11 { int id = default; };
move R11* makePtr11() { return new R11; }
void useIt11() {
    Lambda<void()> a = () => _ = makePtr11();
    Lambda<void()> b = () => (_ = makePtr11());
    a();
    b();
}

// Indirect calls preserve the bound function's owning return metadata.
expect_error("owning return value of 'f' must not be discarded") {
    class R10 { int id = default; };
    move R10* makePtr10() { return new R10; }
    void useIt10() { function<R10*()> f = makePtr10; f(); }
}
