import "unique.cb";

struct TupsafeTupleOwner { int value = 0; ~TupsafeTupleOwner() { } };
struct TupsafeTupleHolder { unique<TupsafeTupleOwner> a = default; };
struct TupsafeRawTupleHolder { unique TupsafeTupleOwner* a = default; };
struct TupsafeBorrowedTupleHolder { TupsafeTupleOwner* p = default; };
unique<TupsafeTupleOwner> tupsafeGlobalTupleOwner = default;
TupsafeTupleOwner* tupsafeBorrowedTupleGlobal = default;
int tupsafeTakeUniqueTuple((unique<TupsafeTupleOwner>, int) value) { return value.item_1; }
int tupsafeTakeUniquePair((unique<TupsafeTupleOwner>, unique<TupsafeTupleOwner>) value) { return 0; }
int tupsafeTakeUniqueScalar(unique<TupsafeTupleOwner> value) { return value->value; }
int tupsafeTakeRawUniqueTuple((unique TupsafeTupleOwner*, int) value) { return value.item_1; }

expect_error("cannot initialize unique<TupsafeTupleOwner> 'x' from borrowed value 'u' - the source still owns it; use 'new', a 'move' expression, or a move-returning call") {
    void tupsafeScalarUniqueCopy()
    {
        unique<TupsafeTupleOwner> u = new TupsafeTupleOwner();
        unique<TupsafeTupleOwner> x = u;
    }
}

expect_error("cannot initialize unique<TupsafeTupleOwner> 'item_0' from borrowed value 'u' - the source still owns it; use 'new', a 'move' expression, or a move-returning call") {
    void tupsafeTupleUniqueCopy()
    {
        unique<TupsafeTupleOwner> u = new TupsafeTupleOwner();
        (unique<TupsafeTupleOwner>, int) tuple = (u, 4);
    }
}

expect_error("cannot initialize unique<TupsafeTupleOwner> 'item_0' from borrowed value 'p' - the source still owns it; use 'new', a 'move' expression, or a move-returning call") {
    int tupsafeTupleUniqueParam(unique<TupsafeTupleOwner> p)
    {
        (unique<TupsafeTupleOwner>, int) tuple = (p, 4);
        return tuple.item_1;
    }
}

expect_error("use of moved variable 'u'") {
    void tupsafeDuplicateTupleUniqueLocal()
    {
        unique<TupsafeTupleOwner> u = new TupsafeTupleOwner();
        (unique<TupsafeTupleOwner>, unique<TupsafeTupleOwner>) tuple = default;
        tuple = (u, u);
    }
}

expect_error("use of moved variable 'u'") {
    void tupsafeTupleUniqueArgumentConsumesSource()
    {
        unique<TupsafeTupleOwner> u = new TupsafeTupleOwner();
        tupsafeTakeUniqueTuple((u, 4));
        unique<TupsafeTupleOwner> after = u;
    }
}

expect_error("use of moved variable 'u'") {
    void tupsafeTupleRawUniqueArgumentConsumesSource()
    {
        unique TupsafeTupleOwner* u = new TupsafeTupleOwner();
        tupsafeTakeRawUniqueTuple((u, 4));
        unique TupsafeTupleOwner* after = u;
    }
}

expect_error("use of moved variable 'holder.a'") {
    void tupsafeDuplicateTupleUniqueField()
    {
        TupsafeTupleHolder holder = default;
        holder.a = new TupsafeTupleOwner();
        (unique<TupsafeTupleOwner>, unique<TupsafeTupleOwner>) tuple = default;
        tuple = (holder.a, holder.a);
    }
}

expect_error("use of moved variable 'u'") {
    void tupsafeDuplicateTupleUniqueCallWithMove()
    {
        unique<TupsafeTupleOwner> u = new TupsafeTupleOwner();
        tupsafeTakeUniquePair((u, move u));
    }
}

expect_error("use of moved variable 'u'") {
    void tupsafeDuplicateTupleUniqueAssignWithMove()
    {
        unique<TupsafeTupleOwner> u = new TupsafeTupleOwner();
        (unique<TupsafeTupleOwner>, unique<TupsafeTupleOwner>) tuple = default;
        tuple = (u, move u);
    }
}

expect_error("cannot initialize unique<TupsafeTupleOwner> from borrowed value 'p'") {
    void tupsafeTupleRawUniqueBorrow()
    {
        TupsafeTupleOwner value = default;
        TupsafeTupleOwner* p = &value;
        (unique TupsafeTupleOwner*, int) tuple = (p, 4);
    }
}

expect_error("cannot consume owning value 'tupsafeGlobalTupleOwner' out of storage that outlives this function") {
    void tupsafeGlobalTupleCall()
    {
        tupsafeGlobalTupleOwner = new TupsafeTupleOwner();
        tupsafeTakeUniqueTuple((tupsafeGlobalTupleOwner, 4));
    }
}

expect_error("cannot consume owning value 'owner' out of storage that outlives this function") {
    void tupsafeStaticTupleCall()
    {
        static unique<TupsafeTupleOwner> owner = default;
        owner = new TupsafeTupleOwner();
        tupsafeTakeUniqueTuple((owner, 4));
    }
}

expect_error("cannot consume owning value 'tupsafeGlobalTupleOwner' out of storage that outlives this function") {
    void tupsafeGlobalTupleAssignment()
    {
        tupsafeGlobalTupleOwner = new TupsafeTupleOwner();
        (unique<TupsafeTupleOwner>, int) tuple = default;
        tuple = (tupsafeGlobalTupleOwner, 4);
    }
}

expect_error("cannot consume owning value 'owner' out of storage that outlives this function") {
    void tupsafeStaticScalarCall()
    {
        static unique<TupsafeTupleOwner> owner = default;
        owner = new TupsafeTupleOwner();
        tupsafeTakeUniqueScalar(owner);
    }
}

expect_error("use of moved variable 'u'") {
    void tupsafeDuplicateTupleRawUniqueLocal()
    {
        unique TupsafeTupleOwner* u = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, unique TupsafeTupleOwner*) tuple = default;
        tuple = (u, u);
    }
}

expect_error("use of moved variable 'holder.a'") {
    void tupsafeDuplicateTupleRawUniqueField()
    {
        TupsafeRawTupleHolder holder = default;
        holder.a = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, unique TupsafeTupleOwner*) tuple = default;
        tuple = (holder.a, holder.a);
    }
}

// TUPOWN2 r2: every conditional joins a local owner with a borrowed pointer source.
// The tuple slot must reject the whole join, independent of the condition.
expect_error("borrowed value") {
    void tupsafeTupleMixedParamDeclaration(TupsafeTupleOwner* p, bool choose)
    {
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, int) tuple = (choose ? r : p, 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleMixedFieldDeclaration(bool choose)
    {
        TupsafeBorrowedTupleHolder holder = default;
        holder.p = new TupsafeTupleOwner();
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, int) tuple = (choose ? r : holder.p, 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleMixedGlobalDeclaration(bool choose)
    {
        tupsafeBorrowedTupleGlobal = new TupsafeTupleOwner();
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, int) tuple = (choose ? r : tupsafeBorrowedTupleGlobal, 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleMixedParamAssignment(TupsafeTupleOwner* p, bool choose)
    {
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, int) tuple = default;
        tuple = (choose ? r : p, 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleMixedFieldAssignment(bool choose)
    {
        TupsafeBorrowedTupleHolder holder = default;
        holder.p = new TupsafeTupleOwner();
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, int) tuple = default;
        tuple = (choose ? r : holder.p, 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleMixedGlobalAssignment(bool choose)
    {
        tupsafeBorrowedTupleGlobal = new TupsafeTupleOwner();
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        (unique TupsafeTupleOwner*, int) tuple = default;
        tuple = (choose ? r : tupsafeBorrowedTupleGlobal, 4);
    }
}

expect_error("borrowed value") {
    (unique TupsafeTupleOwner*, int) tupsafeTupleMixedParamReturn(
        TupsafeTupleOwner* p, bool choose)
    {
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        return (choose ? r : p, 4);
    }
}

expect_error("borrowed value") {
    (unique TupsafeTupleOwner*, int) tupsafeTupleMixedFieldReturn(
        TupsafeBorrowedTupleHolder holder, bool choose)
    {
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        return (choose ? r : holder.p, 4);
    }
}

expect_error("borrowed value") {
    (unique TupsafeTupleOwner*, int) tupsafeTupleMixedGlobalReturn(bool choose)
    {
        TupsafeTupleOwner* r = new TupsafeTupleOwner();
        return (choose ? r : tupsafeBorrowedTupleGlobal, 4);
    }
}

// COALBORROW: tuple elements use the same all-arm ownership rule as declarations.
expect_error("borrowed value") {
    void tupsafeUniqueCoalesceParamDecl(TupsafeTupleOwner* p)
    {
        unique TupsafeTupleOwner* t = p ?? new TupsafeTupleOwner();
    }
}

expect_error("borrowed value") {
    void tupsafeUniqueCoalesceFieldDecl(TupsafeBorrowedTupleHolder holder)
    {
        unique TupsafeTupleOwner* t = holder.p ?? new TupsafeTupleOwner();
    }
}

expect_error("borrowed value") {
    void tupsafeUniqueCoalesceGlobalDecl()
    {
        unique TupsafeTupleOwner* t =
            tupsafeBorrowedTupleGlobal ?? new TupsafeTupleOwner();
    }
}

expect_error("borrowed value") {
    void tupsafeUniqueCoalesceRawLocalDecl(TupsafeTupleOwner* p)
    {
        TupsafeTupleOwner* q = p;
        unique TupsafeTupleOwner* t = q ?? new TupsafeTupleOwner();
    }
}

expect_error("borrowed value") {
    void tupsafeUniqueCoalesceParamAssign(TupsafeTupleOwner* p)
    {
        unique TupsafeTupleOwner* t = nullptr;
        t = p ?? new TupsafeTupleOwner();
    }
}

expect_error("borrowed value") {
    void tupsafeUniqueCoalesceFieldAssign(TupsafeBorrowedTupleHolder holder)
    {
        unique TupsafeTupleOwner* t = nullptr;
        t = holder.p ?? new TupsafeTupleOwner();
    }
}

expect_error("borrowed value") {
    void tupsafeUniqueCoalesceGlobalAssign()
    {
        unique TupsafeTupleOwner* t = nullptr;
        t = tupsafeBorrowedTupleGlobal ?? new TupsafeTupleOwner();
    }
}

expect_error("borrowed value") {
    void tupsafeUniqueCoalesceRawLocalAssign(TupsafeTupleOwner* p)
    {
        TupsafeTupleOwner* q = p;
        unique TupsafeTupleOwner* t = nullptr;
        t = q ?? new TupsafeTupleOwner();
    }
}

void tupsafeUniqueCoalesceSink(move TupsafeTupleOwner* p) { }

expect_error("cannot move borrowed") {
    void tupsafeUniqueCoalesceFieldSink(TupsafeBorrowedTupleHolder holder)
    {
        tupsafeUniqueCoalesceSink(holder.p ?? new TupsafeTupleOwner());
    }
}

expect_error("cannot move borrowed") {
    void tupsafeUniqueCoalesceGlobalSink()
    {
        tupsafeUniqueCoalesceSink(
            tupsafeBorrowedTupleGlobal ?? new TupsafeTupleOwner());
    }
}

expect_error("borrowed value") {
    void tupsafeTupleCoalesceParam(TupsafeTupleOwner* p)
    {
        (unique TupsafeTupleOwner*, int) tuple = (p ?? new TupsafeTupleOwner(), 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleCoalesceField(TupsafeBorrowedTupleHolder holder)
    {
        (unique TupsafeTupleOwner*, int) tuple = (holder.p ?? new TupsafeTupleOwner(), 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleCoalesceGlobal()
    {
        (unique TupsafeTupleOwner*, int) tuple =
            (tupsafeBorrowedTupleGlobal ?? new TupsafeTupleOwner(), 4);
    }
}

expect_error("borrowed value") {
    void tupsafeTupleCoalesceRawLocal(TupsafeTupleOwner* p)
    {
        TupsafeTupleOwner* q = p;
        (unique TupsafeTupleOwner*, int) tuple = (q ?? new TupsafeTupleOwner(), 4);
    }
}

expect_error("cannot initialize unique") {
    struct TupsafeImplicitThisCoalesceHolder
    {
        TupsafeTupleOwner* p = default;
        void reject()
        {
            unique TupsafeTupleOwner* t = p ?? new TupsafeTupleOwner();
        }
    };
}

expect_error("allocates a value") {
    void tupsafeUniqueCoalesceExplicitMoveParamDecl(TupsafeTupleOwner* p)
    {
        unique TupsafeTupleOwner* t = move p ?? new TupsafeTupleOwner();
    }
}

expect_error("cannot move borrowed parameter 'p'") {
    void tupsafeUniqueCoalesceExplicitMoveSink(TupsafeTupleOwner* p)
    {
        tupsafeUniqueCoalesceSink(move p ?? new TupsafeTupleOwner());
    }
}

expect_error("cannot initialize unique") {
    void tupsafeUniqueCoalesceUniqueLocalDecl()
    {
        unique TupsafeTupleOwner* u = new TupsafeTupleOwner();
        unique TupsafeTupleOwner* t = u ?? new TupsafeTupleOwner();
    }
}

expect_error("cannot initialize unique") {
    void tupsafeUniqueCoalesceUniqueFieldDecl()
    {
        TupsafeRawTupleHolder h = default;
        h.a = new TupsafeTupleOwner();
        unique TupsafeTupleOwner* t = h.a ?? new TupsafeTupleOwner();
    }
}

expect_error("cannot initialize unique") {
    void tupsafeUniqueCoalesceOwnedMoveParamDecl(move TupsafeTupleOwner* p)
    {
        unique TupsafeTupleOwner* t = p ?? new TupsafeTupleOwner();
    }
}

expect_error("'??' operands differ in ownership") {
    void tupsafeUniqueCoalesceMixedMoveParamDiagnostic(TupsafeTupleOwner* p)
    {
        unique TupsafeTupleOwner* t = move p ?? new TupsafeTupleOwner();
    }
}

expect_error("cannot move borrowed field 'this.p'") {
    struct TupsafeThisFieldCoalesceSink
    {
        TupsafeTupleOwner* p = default;
        void reject() { tupsafeUniqueCoalesceSink(p ?? new TupsafeTupleOwner()); }
    };
}
