// Storing an owning field extracted from an `alias` (borrow) by-value temp into a longer-lived slot
// must be rejected: a borrow accessor's temp does not own the field buffer (the list still owns it),
// so a shallow copy into a second owner double-frees at teardown. The fix is '.copy()'. A `move`/plain
// OWNING return instead does an implied move (the temp owns the field) - see test_collection_leaks.cb.
// (Under the three-form model a plain non-move return is OWNING; only `alias` is a borrow.)
import "string.cb";
import "list.cb";

struct Tok { string text = default; };
struct Box { string slot = default; };
struct GenericField<T> { string slot = default; };
bool gRuntimePick = false;
bool RuntimePick() { return gRuntimePick; }

alias string ReturnAliasString(alias string value) { return value; }

extern int main()
{
    list<Tok> toks = default;
    Tok t = default; t.text = "x" + "y"; toks.add(t);
    expect_error("taken from a temporary");
    Box b = default;
    b.slot = toks.get(0).text;       // REJECTED - field of an alias borrow, use .copy()
}

// Direct alias-string element stores are the sibling path that used to bypass
// the field-of-temporary guard. Keep each leg in its own expect_error scope.
expect_error("taken from a temporary") {
    void directStringElementStore() {
        list<string> fields;
        fields.add("x");
        Box b = default;
        b.slot = fields.get(0);
    }
}

expect_error("cannot store an 'alias' string local") {
    void namedAliasStringStore() {
        list<string> fields;
        fields.add("x");
        alias string a = fields.get(0);
        Box b = default;
        b.slot = a;
    }
}

expect_error("taken from a temporary") {
    void aliasFunctionResultStore() {
        list<string> fields;
        fields.add("x");
        Box b = default;
        b.slot = ReturnAliasString(fields.get(0));
    }
}

expect_error("taken from a temporary") {
    void genericStructFieldStore() {
        list<string> fields;
        fields.add("x");
        GenericField<int> b = default;
        b.slot = fields.get(0);
    }
}

expect_error("taken from a temporary") {
    void ternaryStringElementStore() {
        list<string> fields;
        fields.add("left");
        fields.add("right");
        Box b = default;
        b.slot = RuntimePick() ? fields.get(0) : fields.get(1);
    }
}

// The local-binding guard must see the same temporary-field provenance after a ?: join.
// RuntimePick keeps both arms live in the generated control flow; this is not a constant-folded
// acceptance probe.
expect_error("taken from a temporary") {
    void ternaryStringLocalBinding() {
        list<Tok> fields;
        Tok left = default; left.text = "left"; fields.add(left);
        Tok right = default; right.text = "right"; fields.add(right);
        string d = RuntimePick() ? fields.get(0).text : fields.get(1).text;
        printf("%s", d.data());
    }
}

expect_error("taken from a temporary") {
    void braceStringElementStore() {
        list<string> fields;
        fields.add("x");
        Box b = { slot = fields.get(0) };
    }
}

expect_error("taken from a temporary") {
    void indexedStringElementStore() {
        list<string> fields;
        fields.add("x");
        Box b = default;
        b.slot = fields[0];
    }
}

expect_error("taken from a temporary") {
    void pointerStringElementStore() {
        list<string> fields;
        fields.add("x");
        Box* b = new Box;
        b->slot = fields.get(0);
        delete b;
    }
}

struct NestedBox { Box inner = default; };

expect_error("taken from a temporary") {
    void nestedStringElementStore() {
        list<string> fields;
        fields.add("x");
        NestedBox b = default;
        b.inner.slot = fields.get(0);
    }
}

expect_error("taken from a temporary") {
    struct MethodBox {
        Box inner = default;
        void set() {
            list<string> fields;
            fields.add("x");
            inner.slot = fields.get(0);
        }
    };
    void methodStringElementStore() {
        MethodBox b = default;
        b.set();
    }
}
