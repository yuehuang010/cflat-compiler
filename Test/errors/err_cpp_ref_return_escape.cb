// A C++ reference return converts to a BORROWED pointer at a return statement. The refusals:
// an owning `unique C*` return, a reference into a frame-local receiver, and a private base.
import cpp "cpp_interop_basic.h";
import cpp "cpp_interop_refgate.h";
import cpp "cpp_interop_ref_member.h";
import cpp "cpp_interop_refctx_global.h";

int g = 5;

expect_error("cannot return borrowed value 'cppi.ref_cell' as 'std.unique_ptr<cppi.RefCell>'") {
    unique cppi.RefCell* RrOwned() { return cppi.ref_cell(); }
}
expect_error("cannot return the C++ reference result of 'b.get()' as 'cppi.RefCell*': its receiver in 'b.get()' refers into a local object") {
    cppi.RefCell* RrLocalReceiver() { cppi.RefBox b = default; return b.get(); }
}
expect_error("cannot convert 'cppi.PrivBoxDerived*' to 'cppi.BaseBox<int>*' for the return value: 'cppi.BaseBox<int>' is not a PUBLIC base of 'cppi.PrivBoxDerived'") {
    cppi.BaseBox<int>* RrPrivateBase(cppi.PrivBoxDerived* p) { return p; }
}

// Prefix refuses this `&` spelling through R1; the post-fix diagnostic must identify the local receiver.
expect_error("cannot return the C++ reference result of '&b.get()' as 'cppi.RefCell*': its receiver in '&b.get()' refers into a local object") {
    cppi.RefCell* RrLocalReceiverAddress() {
        cppi.RefBox b = default;
        return &b.get();
    }
}

// Prefix accepts this local reference argument; the new gate must name its frame root.
expect_error("cannot return the C++ reference result of 'cpprefgate.local_ref(local)' as 'cpprefgate.C*': its argument #0 in 'cpprefgate.local_ref(local)' refers into a local object") {
    cpprefgate.C* RgFrameArgument() {
        cpprefgate.C local = { v = 53 };
        return cpprefgate.local_ref(local);
    }
}
// Prefix reports generic R1 for this join; the return gate must name its local argument arm.
expect_error("cannot return the C++ reference result of 'c?cpprefgate.local_ref(local):cpprefgate.cell()' as 'cpprefgate.C*': its argument #0 in 'c?cpprefgate.local_ref(local):cpprefgate.cell()' refers into a local object") {
    cpprefgate.C* RgFrameTernary(bool c) {
        cpprefgate.C local = { v = 59 };
        return c ? cpprefgate.local_ref(local) : cpprefgate.cell();
    }
}

// A nested reference-result call: the outer argument is the inner call, rooted in `local`.
expect_error("its argument #0 in 'cpprefgate.local_ref(cpprefgate.local_ref(local))' refers into a local object") {
    cpprefgate.C* RgFrameNested() {
        cpprefgate.C local = { v = 61 };
        return cpprefgate.local_ref(cpprefgate.local_ref(local));
    }
}

expect_error("cannot bind to a local or temporary value") {
    cppref.BraceRefInner RefctxReturnShadowLocal() {
        int g = 7;
        return { r = g, v = 1, d = 0.0 };
    }
}
expect_error("cannot bind to a local or temporary value") {
    cppref.BraceRefInner RefctxReturnShadowParameter(int g) {
        return { g, 1, 0.0 };
    }
}
expect_error("cannot bind to a local or temporary value") {
    struct RefctxReturnLocalField { int g = default; };
    cppref.BraceRefInner RefctxReturnLocalFieldValue() {
        RefctxReturnLocalField h = default;
        h.g = 8;
        return { r = h.g, v = 1, d = 0.0 };
    }
}
expect_error("cannot bind to a local or temporary value") {
    cppref.BraceRefInner RefctxReturnTernary(bool c) {
        int local = 7;
        return { r = c ? g : local, v = 1, d = 0.0 };
    }
}
expect_error("cannot bind to a local or temporary value") {
    cppref.BraceRefInner RefctxReturnInnerAlias(alias int p) {
        int local = 7;
        { alias int p = local; return { r = p, v = 1, d = 0.0 }; }
    }
}
expect_error("lifetime cannot be proven to outlive the function") {
    cppref.BraceRefInner RefctxReturnPointerDeref(int* p) {
        return { r = *p, v = 1, d = 0.0 };
    }
}

expect_error("cannot bind to a non-program-lifetime source");
cpprefctxg.CR RefctxGlobalAggregateTemporary = { p = cpprefctxg.mkp(), k = 1 };

expect_error("field default: reference member 'r' must bind to program-lifetime storage") {
    struct RefctxSelfRefDefault {
        int v = 5;
        cppref.BraceRefInner item = { r = v, v = 1, d = 0.0 };
    };
    int RefctxSelfRefDefaultProbe() {
        RefctxSelfRefDefault value = default;
        value.v = 9;
        return value.item.r;
    }
}
expect_error("field default: reference member 'r' must bind to program-lifetime storage") {
    struct RefctxSelfRefReturn {
        int v = 5;
        cppref.BraceRefInner item = { r = v, v = 1, d = 0.0 };
    };
    RefctxSelfRefReturn RefctxSelfRefReturnProbe() {
        RefctxSelfRefReturn value = default;
        value.v = 8;
        return value;
    }
}

expect_error("cannot return C++ aggregate 'cppref.BraceRefInner': reference member 'r' cannot bind to a local or temporary value") {
    cppref.BraceRefInner RefctxReturnLocalDesignated() {
        int value = 31;
        return { r = value, v = 1, d = 0.0 };
    }
}
expect_error("cannot return C++ aggregate 'cppref.BraceRefInner': reference member 'r' cannot bind to a local or temporary value") {
    cppref.BraceRefInner RefctxReturnLocalPositional() {
        int value = 32;
        return { value, 1, 0.0 };
    }
}
expect_error("cannot return C++ aggregate 'cppref.BraceConstRef': reference member 'r' cannot bind to a local or temporary value") {
    cppref.BraceConstRef RefctxReturnConstLocalDesignated() {
        int value = 33;
        return { r = value };
    }
}
expect_error("cannot return C++ aggregate 'cppref.BraceConstRef': reference member 'r' cannot bind to a local or temporary value") {
    cppref.BraceConstRef RefctxReturnConstLocalPositional() {
        int value = 34;
        return { value };
    }
}
expect_error("cannot return C++ aggregate 'cppref.BraceRvalRef': reference member 'r' cannot bind to a local or temporary value") {
    cppref.BraceRvalRef RefctxReturnRvalTemporaryDesignated() {
        return { r = 35 };
    }
}
expect_error("cannot return C++ aggregate 'cppref.BraceRvalRef': reference member 'r' cannot bind to a local or temporary value") {
    cppref.BraceRvalRef RefctxReturnRvalTemporaryPositional() {
        return { 36 };
    }
}

// A frame-rooted C++ reference arm stays refused when its pointer joins a C pointer.
expect_error("refers into a local object that is destroyed when the function returns") {
    cpprefgate.C* RrJoinLocal(cpprefgate.C* p)
    {
        cpprefgate.C lc = { v = 3 };
        return p ?? &cpprefgate.local_ref(lc);
    }
}

// A frame-rooted C++ reference arm keeps the join an alias: it must stay refused in every form.
expect_error("cannot return an 'alias' value") {
    cpprefgate.C* RrTernaryLocalA(cpprefgate.C* p)
    {
        cpprefgate.C lc = { v = 3 };
        return p != nullptr ? p : &cpprefgate.local_ref(lc);
    }
}
expect_error("cannot return an 'alias' value") {
    cpprefgate.C* RrTernaryLocalB(cpprefgate.C* p, bool c)
    {
        cpprefgate.C lc = { v = 3 };
        return c ? &cpprefgate.local_ref(lc) : p;
    }
}
struct RrJoinHolder { cpprefgate.C* r = default; };
expect_error("cannot store an 'alias' value") {
    void RrJoinFieldStore(RrJoinHolder* h, cpprefgate.C* p)
    {
        cpprefgate.C lc = { v = 3 };
        h->r = p ?? &cpprefgate.local_ref(lc);
    }
}
expect_error("cannot return an 'alias' value") {
    cpprefgate.C* RrJoinViaPointer(cpprefgate.C* p)
    {
        cpprefgate.C lc = { v = 3 };
        cpprefgate.C* q = &lc;
        return p ?? &cpprefgate.local_ref(*q);
    }
}

// A global pointer passed by reference reaches a local through the callee: the join stays an alias.
import cpp "cpp_interop_refptr.h";
refptr.C* refptrGlobal = nullptr;
expect_error("cannot return an 'alias' value") {
    refptr.C* RrDerefGlobalLocal(refptr.C* p)
    {
        refptr.C lc = { v = 3 };
        refptrGlobal = &lc;
        return p ?? &refptr.deref(refptrGlobal);
    }
}

extern int main()
{
    return 0;
}
