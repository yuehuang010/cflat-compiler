// Struct brace-init is named-only ({field = value}); a positional element is rejected.
struct Point { int x = default; int y = default; };

// A struct FIELD's own default brace list runs through the same named-only field-init path
// (it used to be discarded entirely, so a positional element silently produced zeros).
expect_error("positional initializers are not supported for struct type") {
    struct PosFieldDefault { Point p = {1, 2}; };
}

extern int main()
{
    expect_error("positional initializers are not supported for struct type");
    Point p = {1, 2};
    return 0;
}
