import cpp "cpp_interop_tpl.h";

extern int main()
{
    expect_error("&&-qualified and cannot be called on an lvalue receiver") {
        cppt.RefQualMethods value = default;
        value.onlyR();
    }

    expect_error("&-qualified and cannot be called on an rvalue receiver") {
        cppt.refqual_make_methods(1).onlyL();
    }

    expect_error("&-qualified and cannot be called on an rvalue receiver") {
        cppt.RefQualMethods(1).onlyL();
    }
    return 0;
}
