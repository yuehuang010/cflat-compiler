import "list.cb";

// Const phase 7 (plan cflat-const.md R6 A, #14): `const` directly on a generic type argument is
// refused at every site a type argument is spelled; pointee const inside it stays legal.
struct C07G<T> { T v = default; };
int c07Id<T>(T v) { return 0; }
using C07CI = const int;
using C07CP = const int*;
using C07VP = (const int)*;

expect_error("'const' is not allowed on a generic type argument") {
    using C07ListAlias = list<const int>;
}
expect_error("'const' is not allowed on a generic type argument") {
    struct C07Holder { list<const int> items; };
}
expect_error("'const' is not allowed on a generic type argument") {
    int c07Take(list<const int>* l) { return 0; }
}
expect_error("'const' is not allowed on a generic type argument") {
    C07G<const int> c07Make() { C07G<const int> g; return g; }
}
expect_error("'const' is not allowed on a generic type argument") {
    struct C07Decl<const T> { T v = default; };
}
expect_error("'const' is not allowed on a generic type argument") {
    int c07DeclFn<const T>(T v) { return 0; }
}

extern int main()
{
    void* raw = nullptr;
    expect_error("'const' is not allowed on a generic type argument") { list<const int> a; }
    expect_error("'const' is not allowed on a generic type argument") { C07G<const int*> g; }
    expect_error("'const' is not allowed on a generic type argument") { c07Id<const int>(3); }
    expect_error("'const' is not allowed on a generic type argument") { auto p = new C07G<const int>(); }
    expect_error("'const' is not allowed on a generic type argument") { list<list<const int>> n; }
    expect_error("'const' is not allowed on a generic type argument") { C07G<C07CI> c1; }
    expect_error("'const' is not allowed on a generic type argument") { C07G<C07CP> c2; }
    expect_error("'const' is not allowed on a generic type argument") { C07G<(const int)> c3; }
    expect_error("'const' is not allowed on a generic type argument") { C07G<const(int*)> c4; }
    expect_error("'const' is not allowed on a generic type argument") { using L = list<const int>; L l; }
    expect_error("'const' is not allowed on a generic type argument") { auto c = (list<const int>*)raw; }
    expect_error("'const' is not allowed on a generic type argument") { int s = (int)sizeof(list<const int>); }
    // Legal: the const is on the pointee.
    C07G<(const char)*> ok1;
    C07G<const(int)*> ok2;
    C07G<C07VP> ok3;
    C07G<C07CI*> ok4;
    return 0;
}

// Round 2: an aggregate `using A = T;` keeps the argument's pointee const, so a write through
// the aliased field is refused (it compiled clean when the alias dropped the const depth).
struct C07AliasCell<T> { using A = T; A v = default; };
int c07AliasWrite()
{
    int n = 7;
    C07AliasCell<(const int)*> h;
    h.v = &n;
    expect_error("cannot assign to '*h.v': it is reached through a pointer to const");
    *h.v = 9;
    return n;
}

// `(const E)[]` is its own instantiation (ruling 2026-10-19): element const is enforced in the
// body for explicit and deduced arguments, and through a generic struct's field. Each template
// is instantiated only with a const view, so the expectation sits in its body.
void c07ViewWrite<T>(T v)
{
    expect_error("cannot assign to 'v[0]': it is reached through a pointer to const ('v')") { v[0] = 1; }
}
void c07ViewWriteD<T>(T v)
{
    expect_error("cannot assign to 'v[0]': it is reached through a pointer to const ('v')") { v[0] = 1; }
}
void c07ViewWriteM<T>(T v)
{
    expect_error("cannot assign to 'v[0]': it is reached through a pointer to const ('v')") { v[0] = 1; }
}
struct C07ViewHold<T> { T v; };
int c07ViewCalls()
{
    int[2] a = {1, 2};
    (const int)[] cv = a;
    int[] mv = a;
    c07ViewWrite<(const int)[]>(cv);
    c07ViewWriteD(cv);
    c07ViewWriteM<(const int)[]>(mv);
    return a[0];
}
int c07ViewField()
{
    int[2] a = {1, 2};
    (const int)[] cv = a;
    C07ViewHold<(const int)[]> h = { v = cv };
    expect_error("cannot assign to 'h.v[0]'");
    h.v[0] = 5;
    return a[0];
}

int c07DirectViewElementWrite()
{
    int[2] a = {1, 2};
    (const int)[] cv = a;
    expect_error("cannot assign to 'cv[0]': it is reached through a pointer to const");
    cv[0] = 5;
    return a[0];
}

int c07WholeWordViewReseat()
{
    int[2] a = {1, 2};
    int[2] b = {3, 4};
    const int[] w = a;
    expect_error("cannot assign to 'w': it is declared const");
    w = b;
    return w[0];
}

int c07ParenthesizedElementWrite()
{
    int[2] a = {1, 2};
    const (int)[] cv = a;
    expect_error("cannot assign to 'cv[0]': it is reached through a pointer to const");
    cv[0] = 5;
    return a[0];
}

int c07ConstViewDiscard()
{
    int[2] a = {1, 2};
    (const int)[] cv = a;
    expect_error("conversion discards const");
    int[] bad = cv;
    return bad[0];
}
