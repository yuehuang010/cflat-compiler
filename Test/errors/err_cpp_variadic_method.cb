import cpp "cpp_interop_basic.h";

// An out-of-line variadic member takes its scalar tail like clang, but an aggregate in the `...`
// tail is still refused at the call (same rule as err_cpp_variadic_aggregate.cb).
struct VariadicPod { int a; int b; };

extern int main()
{
    cppi.Variadic* v = nullptr;
    VariadicPod p = {a = 3, b = 4};
    expect_error("cannot pass aggregate value of type 'VariadicPod' to the variadic") {
        int r = v.sum(1, p);
    }
    return 0;
}
