import cpp "valarray";

extern int main()
{
    std.valarray<int> w = std.valarray<int>(1);
    w[0] = 4;
    std.valarray<int> result = default;
    expect_error("C++ operator+ cannot take a 'double' operand for its 'const int&' parameter") {
        result = w + 2.5;
    }
    long long wide = 100;
    expect_error("C++ operator+ cannot take a 'i64' operand for its 'const int&' parameter: integer narrowing") {
        result = w + wide;
    }
    std.valarray<double> d = std.valarray<double>(1);
    std.valarray<double> dresult = default;
    int count = 2;
    expect_error("C++ operator* cannot take a 'int' operand for its 'const double&' parameter: an int <-> floating conversion") {
        dresult = d * count;
    }
    expect_error("C++ operator* cannot take a 'int' operand for its 'const double&' parameter") {
        dresult = d * 2;
    }
    std.valarray<short> s = std.valarray<short>(1);
    std.valarray<short> sresult = default;
    expect_error("C++ operator+ cannot take a 'int' operand for its 'const short&' parameter: integer narrowing") {
        sresult = s + 70000;
    }
    return 0;
}
