// A '?:' whose arms disagree on ownership of an owning-value struct is rejected: adopting the
// join double-frees the borrow arm's owner, borrowing it leaks the owning arm's temporary.
import "list.cb";
import "function.cb";

struct MixNode { int v = 3; };
struct MixOwn { string name = "abc"; unique MixNode* n = new MixNode(); list<int> xs = default; };

MixOwn MixMake() { MixOwn r = default; r.n->v = 7; return r; }
void MixTake(MixOwn o) { printf("take %d\n", o.n->v); }

extern int main(int argc, char** argv)
{
    bool h = argc > 1;
    MixOwn other = default; other.n->v = 9;
    MixOwn other2 = default; other2.n->v = 11;

    // (a) borrow arm first, owning call second.
    expect_error("'?:' arms differ in ownership: 'MixMake()' is an owning value and 'other' is a borrow of an existing value. Either 'move' the borrowed side into a fresh value so both arms own, or make both arms borrows.") {
        MixOwn a = h ? other : MixMake();
    }

    // (b) owning call first, borrow arm second.
    expect_error("'?:' arms differ in ownership: 'MixMake()' is an owning value and 'other' is a borrow of an existing value.") {
        MixOwn b = h ? MixMake() : other;
    }

    // (c) 'default' is an owning temporary just like a call result.
    expect_error("'?:' arms differ in ownership: 'default' is an owning value and 'other' is a borrow of an existing value.") {
        MixOwn c = h ? other : default;
    }

    // (d) same join in ARGUMENT position - rejected at the join, so every destination reports it.
    expect_error("'?:' arms differ in ownership: 'MixMake()' is an owning value and 'other' is a borrow of an existing value.") {
        MixTake(h ? other : MixMake());
    }

    // (e) nested: the INNER join is the mixed one and is the one reported.
    expect_error("'?:' arms differ in ownership: 'MixMake()' is an owning value and 'other' is a borrow of an existing value.") {
        MixOwn d = h ? other : (h ? MixMake() : other);
    }

    // (f) The arm text is the ORIGINAL SOURCE SLICE, not the whitespace-stripped parse-tree text:
    // a spaced borrow arm is quoted back verbatim. On e4e493a this printed '(other)' and the leg
    // failed to raise.
    expect_error("'( other )' is a borrow of an existing value") {
        MixOwn wsp = h ? MixMake() : ( other );
    }

    // ACCEPT: an INDIRECT call returning an owning-value struct BY VALUE owns exactly as a direct
    // call does, so mixing it with a direct owning call is an all-owning join, and a join of two
    // of them is adopted and freed once. Both were rejected on e4e493a (no accepted spelling -
    // even 'move lf()' was rejected); the both-indirect join silently leaked. Destructor counts
    // are asserted in Test/test_move.cb testOwningStructTernaryJoin.
    Lambda<MixOwn()> lf = () => { MixOwn r = default; r.n->v = 13; return r; };
    MixOwn i1 = h ? lf() : MixMake();
    printf("i1 %d\n", i1.n->v);
    MixOwn i2 = h ? lf() : lf();
    printf("i2 %d\n", i2.n->v);
    function<MixOwn()> fp = MixMake;
    MixOwn i3 = h ? fp() : MixMake();
    printf("i3 %d\n", i3.n->v);
    MixOwn i4 = h ? fp() : fp();
    printf("i4 %d\n", i4.n->v);

    // ACCEPT: both arms owning temporaries.
    MixOwn e = h ? MixMake() : MixMake();
    printf("e %d\n", e.n->v);

    // ACCEPT: both arms borrows, read only.
    MixOwn f = h ? other : other2;
    printf("f %d\n", f.n->v);

    // ACCEPT: 'move' makes the borrowed side owning, so both arms own.
    MixOwn g = h ? move other : MixMake();
    printf("g %d\n", g.n->v);

    printf("done %d\n", other2.n->v);
    return 0;
}

// The POINTER sibling of the same rule (issue p3/mixed-owning-borrow-pointer-ternary-join-leaks-
// new-arm). Measured pre-fix on every shape below: the allocating arm ran, no destructor fired,
// and `leaks --atExit` reported 16 leaked bytes. Both sides must be PROVEN - the borrow arm here
// is a local declared from `&stack`, which can never own; a `T* p = new T();` local is an owner
// and stays accepted (Test/test_move.cb join_owner_new_value).
struct PtrJoinNode { int v = 3; };
move PtrJoinNode* ptrJoinMake() { return new PtrJoinNode(); }
int ptrJoinUse(PtrJoinNode* a) { return a->v; }
struct PtrJoinHolder { PtrJoinNode* n = nullptr; };

int runPointerTernaryJoinRejects(bool c)
{
    PtrJoinNode stack = default;
    PtrJoinNode* borrowed = &stack;

    // (p1) filed repro: borrow arm first, `new` second.
    expect_error("'?:' arms differ in ownership: 'new PtrJoinNode()' allocates a value the join cannot own and 'borrowed' is a borrow of an existing value, so the allocating arm leaks whenever it is taken. Either 'move' the borrowed side into a fresh value so both arms own, or allocate into a named owner before the '?:' and make both arms borrows.") {
        PtrJoinNode* p1 = c ? borrowed : new PtrJoinNode();
    }

    // (p2) arms swapped - the rule is symmetric.
    expect_error("'new PtrJoinNode()' allocates a value the join cannot own and 'borrowed' is a borrow") {
        PtrJoinNode* p2 = c ? new PtrJoinNode() : borrowed;
    }

    // (p3) a move-returning CALL is the owning side just as `new` is.
    expect_error("'ptrJoinMake()' allocates a value the join cannot own and 'borrowed' is a borrow") {
        PtrJoinNode* p3 = c ? borrowed : ptrJoinMake();
    }

    // (p4) an explicit `move` of an owner is the owning side.
    expect_error("'move owner' allocates a value the join cannot own and 'borrowed' is a borrow") {
        unique PtrJoinNode* owner = new PtrJoinNode();
        PtrJoinNode* p4 = c ? move owner : borrowed;
    }

    // (p5) a direct `&stack` arm, with no intervening binding, is proven the same way.
    expect_error("'&stack' is a borrow of an existing value") {
        PtrJoinNode* p5 = c ? &stack : new PtrJoinNode();
    }

    // (p6) NESTED: the inner join is the mixed one and is the one reported.
    expect_error("'new PtrJoinNode()' allocates a value the join cannot own and 'borrowed' is a borrow") {
        PtrJoinNode* p6 = c ? borrowed : (c ? borrowed : new PtrJoinNode());
    }

    // (p7) ARGUMENT position - rejected at the join, so every destination reports it.
    expect_error("'new PtrJoinNode()' allocates a value the join cannot own and 'borrowed' is a borrow") {
        int n7 = ptrJoinUse(c ? borrowed : new PtrJoinNode());
    }

    // (p8) FIELD store destination.
    expect_error("'new PtrJoinNode()' allocates a value the join cannot own and 'borrowed' is a borrow") {
        PtrJoinHolder h8 = default;
        h8.n = c ? borrowed : new PtrJoinNode();
    }

    return 0;
}

// (p9) a pointer PARAMETER is a borrow by declaration, so it proves the borrow side too.
expect_error("'new PtrJoinNode()' allocates a value the join cannot own and 'param' is a borrow") {
    int ptrJoinFromParam(PtrJoinNode* param, bool cc)
    {
        PtrJoinNode* p9 = cc ? param : new PtrJoinNode();
        return p9->v;
    }
}

// (p10) RETURN position: a bare-pointer return smuggled the `new` past the owning-return check
// because the join hid it. dtor count was 0 on the allocating path pre-fix.
PtrJoinNode gPtrJoinStack = default;
expect_error("'new PtrJoinNode()' allocates a value the join cannot own and '&gPtrJoinStack' is a borrow") {
    PtrJoinNode* ptrJoinPick(bool c) { return c ? &gPtrJoinStack : new PtrJoinNode(); }
}

// (p11) REASSIGNMENT destination. Test/test_move.cb used to accept this shape and assert that the
// join merely borrowed (unique_reassign_mixed_join_*); the allocating arm leaked whenever it was
// taken, so the leg moved here when the pointer rule was widened.
expect_error("allocates a value the join cannot own and 'live' is a borrow of an existing value") {
    int ptrJoinReassign(bool c)
    {
        unique PtrJoinNode* owner = new PtrJoinNode();
        PtrJoinNode* live = owner;
        PtrJoinNode* b = nullptr;
        b = c ? ptrJoinMake() : live;
        return b->v;
    }
}

// (p12) a `move` of a BORROWED parameter transfers nothing, so it is the BORROW side of the join,
// not the owning one. Test/test_move.cb used to accept this (ternary_borrowed_move_mixed_join_*)
// and let the result borrow, which leaked the allocating arm whenever it was taken.
expect_error("'ptrJoinMake()' allocates a value the join cannot own and 'move borrowed' is a borrow") {
    int ptrJoinBorrowedMove(PtrJoinNode* borrowed, bool c)
    {
        PtrJoinNode* v = c ? move borrowed : ptrJoinMake();
        return v->v;
    }
}

// (p13) `unique` FIELD store destination of the borrowed-move join, and (p14) the brace-init store
// path, which is a separate door (EmitOneFieldInit). Both used to accept and let the field own
// whichever arm ran - on the borrow path that adopts the caller's still-live pointee.
struct PtrJoinUniqueBox { unique PtrJoinNode* item = nullptr; };

expect_error("'ptrJoinMake()' allocates a value the join cannot own and 'move borrowed' is a borrow") {
    void ptrJoinBorrowedMoveIntoField(PtrJoinUniqueBox* box, PtrJoinNode* borrowed, bool c)
    {
        box->item = c ? move borrowed : ptrJoinMake();
    }
}

expect_error("'ptrJoinMake()' allocates a value the join cannot own and 'move borrowed' is a borrow") {
    int ptrJoinBorrowedMoveBraceInit(PtrJoinNode* borrowed, bool c)
    {
        PtrJoinUniqueBox box = { item = c ? move borrowed : ptrJoinMake() };
        return box.item != nullptr ? 1 : 0;
    }
}
