expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    class T522Self
    {
        Thing* p = default;
        IThing keepAlias()
        {
            Thing* t = new Thing();
            Thing* alias = t;
            p = alias;
            return p;
        }
    };
}

// Round 2: a correlated branch whose condition storage escapes may change between the tests.
void t522Zero(int* p) { *p = 0; }
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522BranchConditionCallWrite(int k)
    {
        Thing x = default;
        IThing i = t522Global;
        if (k == 99) i = &x;
        t522Zero(&k);
        if (k == 99) i = t522Global;
        return i;
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522BranchConditionAliasWrite(int k)
    {
        Thing x = default;
        IThing i = t522Global;
        int* kp = &k;
        if (k == 99) i = &x;
        *kp = 0;
        if (k == 99) i = t522Global;
        return i;
    }
}

// Indirect calls returning an interface borrow their arguments / captures too.
expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522IndirectInterfaceResult()
    {
        Thing* t = new Thing();
        function<IThing(Thing*)> fp = t522Wrap;
        return fp(t);
    }
}

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522ClosureInterfaceResult()
    {
        Thing* t = new Thing();
        Lambda<IThing()> l = () => { return t; };
        return l();
    }
}

// An interface-returning callee defined below: decided once its body is emitted.
IThing t522WrapLater(Thing* p);
expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522InterfaceForwardLater()
    {
        Thing* t = new Thing();
        return t522WrapLater(t);
    }
}

IThing t522WrapLater(Thing* p) { return p; }

// Round 3: element and copied holders keep the frame borrow of what they hold; a nested later
// call counts when the outer summary keeps its argument; mutual recursion forwarding a parameter.
Thing* t522HolderField(T522Holder* h) { return h->p; }
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522ArrayHolderLocal()
    {
        Thing x = default;
        T522Holder[2] a = default;
        a[1].p = &x;
        return t522HolderField(&a[1]);
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522CopiedHolderLocal()
    {
        Thing x = default;
        T522Holder a = default;
        a.p = &x;
        T522Holder b = a;
        return t522HolderField(&b);
    }
}

Thing* t522SlotForwardLater(Thing* p);
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522SlotForwardThroughLaterCall()
    {
        Thing x = default;
        return t522SlotForwardLater(&x);
    }
}

Thing* t522KeepLater(Thing* p);
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522NestedLaterKept()
    {
        Thing x = default;
        return t522KeepLater(t522KeepLater(&x));
    }
}

Thing* t522MutualA(Thing* p, int k);
Thing* t522MutualB(Thing* p, int k);
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522MutualForward()
    {
        Thing x = default;
        return t522MutualA(&x, 2);
    }
}

// Round 4: a struct relayed through a call or reassigned after the copy, a variable index that may
// select the local, a struct argument lent to an unknown callee, a callee that writes through its
// parameter before reading it, and a read past the pointed-to object.
T522Holder t522RelayHolder(T522Holder h) { return h; }
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522RelayedHolderLocal()
    {
        Thing x = default;
        T522Holder a = default;
        a.p = &x;
        T522Holder b = t522RelayHolder(a);
        return t522HolderField(&b);
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522CopyReassignedLocal()
    {
        Thing x = default;
        T522Holder a = default;
        a.p = t522Global;
        T522Holder b = a;
        b.p = &x;
        return t522HolderField(&b);
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522VariableElementMixed(int k)
    {
        Thing x = default;
        T522Holder[2] a = default;
        a[0].p = t522Global;
        a[1].p = &x;
        return t522HolderField(&a[k]);
    }
}

IThing t522FromHolder(T522Holder a) { T522Holder b = a; return t522HolderField(&b); }
expect_error("as interface 'IThing'") {
    IThing t522HolderArgumentLocal()
    {
        Thing x = default;
        T522Holder a = default;
        a.p = &x;
        return t522FromHolder(a);
    }
}

Thing* t522WriteThenRead(T522Holder* h, Thing* q) { h->p = q; return h->p; }
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522CalleeWritesHolder()
    {
        Thing x = default;
        T522Holder h = default;
        h.p = t522Global;
        return t522WriteThenRead(&h, &x);
    }
}

Thing* t522SecondHolderField(T522Holder* h) { return h[1].p; }
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522ReadPastObject()
    {
        Thing x = default;
        T522Holder[2] a = default;
        a[0].p = t522Global;
        a[1].p = &x;
        return t522SecondHolderField(&a[0]);
    }
}

Thing* t522SlotForwardLater(Thing* p) { Thing* q = p; return t522Idt(q); }
Thing* t522KeepLater(Thing* p) { return t522Idt(p); }
Thing* t522MutualA(Thing* p, int k) { if (k == 0) return p; return t522MutualB(p, k - 1); }
Thing* t522MutualB(Thing* p, int k) { if (k == 0) return p; return t522MutualA(p, k - 1); }

Thing* t522ForwardLater(Thing* p) { return t522Idt(p); }

// Round 5 type narrowing keeps an argument whose type reaches an implementer of the returned
// interface: a local struct holding a pointer to one (or an interface field), through an unknown
// recursive summary and through a function<>.
interface IT522Tree { int value(); list<IT522Tree>* t522Kids(); };
class T522Tree : IT522Tree
{
    int n = 0;
    list<IT522Tree>* ks = nullptr;
    int value() { return n; }
    list<IT522Tree>* t522Kids() { return ks; }
};
struct T522TreeBox { T522Tree* p = default; };
struct T522TreeSlot { IT522Tree i = default; };
expect_error("cannot return a local value as interface 'IT522Tree'") {
    IT522Tree t522FindByBox(IT522Tree node, T522TreeBox b, int d)
    {
        if (d == 0) return b.p;
        list<IT522Tree>* kids = node.t522Kids();
        if (kids != nullptr)
        {
            int i = 0;
            while (i < kids.count())
            {
                IT522Tree c = kids.get(i);
                T522Tree local = default;
                T522TreeBox nb = default;
                nb.p = &local;
                IT522Tree r = t522FindByBox(c, nb, d - 1);
                if (r != nullptr) return r;
                i++;
            }
        }
        return nullptr;
    }
}

expect_error("cannot return a local value as interface 'IT522Tree'") {
    IT522Tree t522FindBySlot(IT522Tree node, T522TreeSlot b, int d)
    {
        if (d == 0) return b.i;
        list<IT522Tree>* kids = node.t522Kids();
        if (kids != nullptr)
        {
            int i = 0;
            while (i < kids.count())
            {
                IT522Tree c = kids.get(i);
                T522Tree local = default;
                T522TreeSlot nb = default;
                nb.i = &local;
                IT522Tree r = t522FindBySlot(c, nb, d - 1);
                if (r != nullptr) return r;
                i++;
            }
        }
        return nullptr;
    }
}

IT522Tree t522BoxPick(IT522Tree node, T522TreeBox b) { if (b.p != nullptr) return b.p; return node; }
expect_error("cannot return a local value as interface 'IT522Tree'") {
    IT522Tree t522BoxThroughFunction(IT522Tree node)
    {
        T522Tree local = default;
        T522TreeBox nb = default;
        nb.p = &local;
        function<IT522Tree(IT522Tree, T522TreeBox)> f = t522BoxPick;
        return f(node, nb);
    }
}

// Round 6: a closure lends what its environment captured - as a call argument (indirect and
// recursive callees), and an interface-typed capture; a struct result of an indirect call whose
// struct argument travels in its C ABI form holds what that argument held.
IThing t522PickLambda(Lambda<IThing()> l) { return l(); }
IThing t522RecLambda(Lambda<IThing()> l, int n) { if (n > 0) return t522RecLambda(l, n - 1); return l(); }
T522Holder t522Relay(T522Holder a) { return a; }
Thing* t522HolderPOf(T522Holder* h) { return h->p; }
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522ClosureArgumentLocal()
    {
        Thing x = default;
        Thing* h = &x;
        Lambda<IThing()> l = () => { return h; };
        function<IThing(Lambda<IThing()>)> fp = t522PickLambda;
        return fp(l);
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522ClosureArgumentRecursive()
    {
        Thing x = default;
        Thing* h = &x;
        Lambda<IThing()> l = () => { return h; };
        return t522RecLambda(l, 1);
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522ClosureInterfaceCapture()
    {
        Thing x = default;
        IThing h = &x;
        Lambda<IThing()> l = () => { return h; };
        return l();
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522IndirectRelayLocal()
    {
        Thing x = default;
        T522Holder a = default;
        a.p = &x;
        function<T522Holder(T522Holder)> fp = t522Relay;
        T522Holder b = fp(a);
        return t522HolderPOf(&b);
    }
}

// Round 7: a closure capturing a closure over a local lends the inner closure's captures.
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522NestedClosureLocal()
    {
        Thing x = default;
        Thing* h = &x;
        Lambda<IThing()> inner = () => { return h; };
        Lambda<IThing()> outer = () => { return inner(); };
        return outer();
    }
}

// Round 8: calling a copy of a closure over a local (also after the source is reassigned), and an
// sret struct result of an indirect call whose C-ABI-form argument held a local.
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522ClosureCopyLocal()
    {
        Thing x = default;
        Thing* px = &x;
        Lambda<IThing()> a = () => { return px; };
        Lambda<IThing()> b = a;
        return b();
    }
}

expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522ClosureCopySourceReassignedLocal()
    {
        Thing x = default;
        Thing* px = &x;
        Thing* pg = t522Global;
        Lambda<IThing()> a = () => { return px; };
        Lambda<IThing()> b = a;
        a = () => { return pg; };
        return b();
    }
}

struct T522Big { Thing* p = default; long a = default; long b = default; };
T522Big t522WrapHolder(T522Holder h) { T522Big r = default; r.p = h.p; return r; }
Thing* t522BigP(T522Big* b) { return b->p; }
expect_error("as interface 'IThing' - the interface fat pointer would dangle once this function returns") {
    IThing t522SretCoercedLocal()
    {
        Thing x = default;
        T522Holder a = default;
        a.p = &x;
        function<T522Big(T522Holder)> fp = t522WrapHolder;
        T522Big b = fp(a);
        return t522BigP(&b);
    }
}

// Round 9: a provenance walk that runs out of its step budget (each of 128 arguments re-walks the
