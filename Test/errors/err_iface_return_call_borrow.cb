struct T522Chain { T522Holder* h = default; };
expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522HeapChainSlot()
    {
        Thing* t = new Thing();
        Thing* alias = t;
        T522Chain* c = new T522Chain();
        c->h = new T522Holder();
        c->h->p = alias;
        return c->h->p;
    }
}

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522ParameterObjectSlot(T522Holder* h)
    {
        Thing* t = new Thing();
        Thing* alias = t;
        h->p = alias;
        return h->p;
    }
