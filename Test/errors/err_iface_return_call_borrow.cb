// Interface return of a non-owning call result or a slot written indirectly (T522, Rust lifetime
// elision): a call result borrows every pointer argument and the receiver unless the callee summary
// narrows it (a global, a fresh 'move' result, one forwarded parameter). A frame alias stored into
// a heap object, written through a derived address, or handed to a call that may write it carries
// the frame borrow. Accepted controls live in test_interface.cb (testInterfaceReturnCallBorrowAcceptSet).
import "unique.cb";
import "list.cb";
import "function.cb";
interface IThing { int value(); };

class Thing : IThing
{
    int n = 0;
    int value() { return n; }
};

struct T522Holder { Thing* p = default; void noop() { } Thing* getP() { return p; } };
struct T522Passer { int z = 0; Thing* pass(Thing* p) { return p; } };
T522Passer t522Passer = default;
T522Holder* t522GlobalHolder = nullptr;
Thing* t522Global = nullptr;
Thing* t522Idt(Thing* p) { return p; }
Thing* t522Forward(Thing* p) { return t522Idt(p); }
Thing* t522ForwardLater(Thing* p);
Thing* t522Pick(Thing* a, Thing* b) { if (a == nullptr) return b; return a; }
Thing* t522Rec(Thing* p, int k) { if (k == 0) return p; return t522Rec(p, k - 1); }
T* t522Gid<T>(T* p) { return p; }
IThing t522Wrap(Thing* p) { return p; }
void t522Touch(T522Holder* h) { }
void t522SetSlot(Thing** pp, Thing* x) { *pp = x; }

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522IdentityOfOwner()
    {
        Thing* t = new Thing();
        return t522Idt(t);
    }
}

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522UniqueGet()
    {
        unique<Thing> u = new Thing();
        return u.get();
    }
}

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522UniqueGetAlias()
    {
        unique<Thing> u = new Thing();
        Thing* b = u.get();
        return b;
    }
}

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522LambdaCapture()
    {
        Thing* t = new Thing();
        Lambda<Thing*()> l = () => { return t; };
        return l();
    }
}

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522ForwardingCall()
    {
        Thing* t = new Thing();
        return t522Forward(t);
    }
}

expect_error("cannot return a borrow of a local owner as interface 'IThing'") {
    IThing t522ForwardingCallDefinedLater()
    {
        Thing* t = new Thing();
        return t522ForwardLater(t);
    }
}

