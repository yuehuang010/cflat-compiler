// Round 10: a lambda's environment is caller memory, but the body's own write of a frame address
// into a capture (`px = &y;`) before reading it back is a local, as for a pointer parameter.
Thing t522EnvGlobal = default;
expect_error("cannot return local value 'Thing' as interface 'IThing'") {
    IThing t522EnvWriteLocal()
    {
        Thing* px = &t522EnvGlobal;
        Lambda<IThing()> l = () => { Thing y = default; px = &y; return px; };
        return l();
    }
}

// Round 11: a second capture puts `px` at a non-zero field of the environment; the env never owns
// a pointer capture, so the body's `px = &y;` still decides (a read of another capture first, or
// a store under a branch on a capture).
expect_error("cannot return local value 'Thing' as interface 'IThing'") {
    IThing t522EnvTwoCaptureLocal()
    {
        Thing* px = &t522EnvGlobal;
        int k = 1;
        Lambda<IThing()> l = () => { Thing y = default; int z = k; px = &y; if (z > 5) return &t522EnvGlobal; return px; };
        return l();
    }
}

expect_error("cannot return local value 'Thing' as interface 'IThing'") {
    IThing t522EnvBranchStoreLocal()
    {
        Thing* px = &t522EnvGlobal;
        int k = 1;
        Lambda<IThing()> l = () => { Thing y = default; if (k == 1) px = &y; return px; };
        return l();
    }
}

// Round 12: a by-value struct through a function<> thunk is passed as a hidden pointer to a copy;
// the copy is not the borrow, but a frame address its field holds still is.
struct T522WideHold { int a = 1; int b = 2; int c = 3; int d = 4; int e = 5; Thing* p = default; };
IThing t522HoldWideThing(T522WideHold w) { return w.p; }
expect_error("cannot return a local value as interface 'IThing'") {
    IThing t522FunctionWideHeldLocal()
    {
        Thing loc = default;
        T522WideHold w = default;
        w.p = &loc;
        function<IThing(T522WideHold)> f = t522HoldWideThing;
        return f(w);
    }
}

extern int main()
{
    return 0;
}
