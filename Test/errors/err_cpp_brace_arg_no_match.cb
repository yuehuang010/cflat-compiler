// Grouped C++ import with a clause: the group form accepts cache/lib/define like the single form.
import cpp { "cpp_interop_tpl.h", "vector" } cache;

expect_error("no instantiation of C++ function template 'cppt.twice' accepts these argument types") {
    extern int main()
    {
        return (int)cppt.twice({1, 2});
    }
}
