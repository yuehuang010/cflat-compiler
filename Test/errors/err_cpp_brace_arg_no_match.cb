// Grouped C++ import: the group form accepts lib/define clauses like the single form.
import cpp { "cpp_interop_tpl.h", "vector" };
import cpp "cpp_interop_ctorref.h";
import cpp "cpp_t63_brace_decl.hpp";

expect_error("no instantiation of C++ function template 'cppt.twice' accepts these argument types") {
    extern int main()
    {
        return (int)cppt.twice({1, 2});
    }
}

// An empty braced list provides no T for initializer_list<T> deduction (clang rejects it too).
expect_error("no instantiation of C++ function template 'cppcr.brc_template_copy' accepts these argument types") {
    int empty_template_probe()
    {
        return cppcr.brc_template_copy({});
    }
}

// A braced list backed in the caller frame still obeys C++ narrowing: a non-constant long
// into std::initializer_list<double> is ill-formed, as clang rejects it.
expect_error("brace-list element 1 of 'cppcr.BrcIlD' narrows to the C++ constructor's 'double'") {
    double narrow_probe(long a, long b)
    {
        cppcr.BrcIlD d = cppcr.BrcIlD({a, b});
        return d.d[0];
    }
}

// A function-call list backed in the caller frame obeys the same rule (clang: double -> long).
expect_error("brace-list element 2 of 'cppcr.brc_keep' narrows to the C++ parameter's 'long'") {
    long narrow_call_probe(long a)
    {
        return cppcr.brc_keep({a, 2.5}).n;
    }
}

// A copying (non-backed) list names the element and target too; it read "no overload ... matches".
expect_error("brace-list element 1 of 'cppcr.brc_vec' narrows to the C++ parameter's 'int'") {
    long narrow_copy_probe(i64 a)
    {
        return cppcr.brc_vec({a, 2});
    }
}

// Same-width unsigned -> int is narrowing in a C++ list (clang rejects it too).
expect_error("brace-list element 1 of 'cppcr.brc_vec' narrows to the C++ parameter's 'int'") {
    long narrow_unsigned_probe(uint u)
    {
        return cppcr.brc_vec({u, 2});
    }
}

// C++ never deduces a template parameter from a default argument (clang: no viable constructor).
expect_error("no C++ constructor of 'cppcr.BrcDfOnly<long>' accepts this brace list: a template parameter named only by a default argument is never deduced") {
    int default_deduce_probe()
    {
        return cppcr.BrcDfOnly<long>({2, 3}).which;
    }
}

// A declaration brace list obeys C++ list-init narrowing (clang -Wc++11-narrowing is an error).
expect_error("C++ brace constructor call 'std.vector<int>' does not match (clang: type 'double' cannot be narrowed") {
    int decl_double_probe()
    {
        std.vector<int> v{1.7, 2};
        return v[0];
    }
}

// i64, not long: CFlat long is 32-bit on Windows, where long -> int does not narrow.
expect_error("non-constant-expression cannot be narrowed from type") {
    int decl_long_variable_probe(i64 l)
    {
        std.vector<int> v{l, 2};
        return v[0];
    }
}

// A constant element narrows only when its value does not fit (70000 into short).
expect_error("constant expression evaluates to 70000 which cannot be narrowed") {
    int decl_constant_probe()
    {
        std.vector<short> v{70000, 2};
        return v[0];
    }
}

expect_error("constant expression evaluates to 5000000000 which cannot be narrowed") {
    int decl_long_literal_probe()
    {
        std.vector<int> v{5000000000L};
        return v[0];
    }
}

// `T v = {..}` is copy-list-init: an explicit selected constructor is refused (direct `T v{..}` is not).
expect_error("chosen constructor is explicit in copy-initialization") {
    int decl_copy_list_explicit_probe()
    {
        t63.ExplicitOnly e = {2, 5};
        return e.first;
    }
}
