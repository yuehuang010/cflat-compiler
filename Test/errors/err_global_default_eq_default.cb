// T524: a non-folding native global default is refused.
// Spelling 2 of 3: `= default`. Siblings: err_global_default_not_constant.cb, err_global_default_empty_brace.cb.
const char* gRefPtr = "rt";
struct RefStr { string s = gRefPtr; int n = 1; };
expect_error("must be constructed in main or made foldable");
RefStr gRefDefault = default;

extern int main()
{
    return gRefDefault.n;
}
