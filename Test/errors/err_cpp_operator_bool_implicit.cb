// libc++ declares unique_ptr's `operator bool` EXPLICIT, so it participates in a condition and
// an explicit cast but not in an implicit conversion. An IMPLICIT C++ `operator bool` (the
// std::vector<bool> element proxy) does convert here - Test/test_cpp_interop_template.cb covers it.
import cpp "cpp_interop_basic.h";

extern int main()
{
    expect_error("to 'bool': it is not a scalar and declares no implicit 'operator bool'") {
        std.unique_ptr<cppi.Tracked> p = cppi.make_tracked_ptr(1);
        bool b = p;
    }
    return 0;
}
