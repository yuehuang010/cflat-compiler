// Tests that using a variable after it has been moved is a compile-time error.

struct MoveResource { int id = 0; };
void MoveResource(MoveResource* self) { self->id = 0; }
void consume(move MoveResource* r) { delete r; }

struct Holder { MoveResource* item = nullptr; };
void Holder(Holder* self) {}

// Dereference-of-explicitly-moved-pointer coverage. Explicit 'move' of a thin `unique`
// pointer/interface local nulls it but, by design, leaves it plain-readable (a == nullptr,
// passing it along, etc. stay legal - see test_move.cb's explicit_move_local_* cases); only a
// DEREFERENCE ('->'/'.'/'*'/'[]') of the moved-out source is rejected. A same-block deref is
// rejected inline; a cross-block one (conditional move, loop-carried) by the MAY-null fixpoint
// at end-of-body, unless a dominating null guard narrows it back to non-null.
struct UniqueThing { int v = 0; int get() { return v; } };
interface IUniqueThing { int get(); };
class UniqueIfaceThing : IUniqueThing { int v = 0; int get() { return v; } };

// use after move - assign move param to struct field, then read param again
expect_error("use of moved variable 'child'") {
    void storeAndRead(Holder* h, move MoveResource* child)
    {
        h->item = child;
        int y = child->id;
    }
}

// use after move - move param assigned to a field in each branch, read after the if/else
expect_error("use of moved variable 'child2'") {
    void storeAndReadBranched(Holder* h, Holder* h2, move MoveResource* child2)
    {
        if (1) { h->item = child2; } else { h2->item = child2; }
        int y = child2->id;
    }
}

// X4 Part 2: moving a struct FIELD marks only that field, not the whole base.
// Moving the SAME field twice must still error (the field's buffer was transferred).
struct Tree { Tree* left = nullptr; Tree* right = nullptr; };
void consumeTree(move Tree* t) { if (t != nullptr) delete t; }

expect_error("use of moved variable 'root.left'") {
    void moveFieldTwice(Tree* root)
    {
        consumeTree(root->left);
        consumeTree(root->left);   // same field moved twice -> error
    }
}

// Cross-block dereference of an explicitly-moved thin `unique` pointer local. The move is in
// one branch and the (unguarded) deref is after the merge, so the same-block guard cannot see
// it; the MAY-null fixpoint over the function's CFG reports it at end-of-body instead. A
// dominating null guard would narrow it back to non-null - see test_move.cb's narrowing legs.
expect_error("dereference of moved variable 'cb1'") {
    int condMoveThenDeref(int n)
    {
        unique UniqueThing* cb1 = new UniqueThing();
        if (n > 100) { unique UniqueThing* cb2 = move cb1; }
        return cb1->v;
    }
}

// Loop-carried: iteration 1 dereferences what iteration 0 moved out (via the back-edge).
expect_error("dereference of moved variable 'lc1'") {
    int loopCarriedMoveThenDeref()
    {
        unique UniqueThing* lc1 = new UniqueThing();
        unique UniqueThing* lc2 = nullptr;
        int total = 0;
        for (int i = 0; i < 2; i++)
        {
            total = total + lc1->v;
            if (lc2 == nullptr) { lc2 = move lc1; }
        }
        return total;
    }
}

// Same cross-block shape on a `unique <interface>` local: the moved-from interface is nulled but
// plain-readable, so the unguarded dispatch after the merge is caught by the MAY-null fixpoint.
// The guarded spelling (`if (ci1 != nullptr)`) compiles - see test_move.cb's interface leg.
expect_error("dereference of moved variable 'ci1'") {
    int condMoveThenDerefIface(int n)
    {
        unique IUniqueThing ci1 = new UniqueIfaceThing();
        if (n > 100) { unique IUniqueThing ci2 = move ci1; }
        return ci1.get();
    }
}

// Loop-carried move of a `unique <interface>` local: iteration 1 dereferences what iteration 0
// moved out (via the back-edge) - the interface counterpart of the thin-pointer `lc1` leg above.
expect_error("dereference of moved variable 'lc1i'") {
    int loopCarriedMoveThenDerefIface()
    {
        unique IUniqueThing lc1i = new UniqueIfaceThing();
        unique IUniqueThing lc2i = nullptr;
        int total = 0;
        for (int i = 0; i < 2; i++)
        {
            total = total + lc1i.get();
            if (lc2i == nullptr) { lc2i = move lc1i; }
        }
        return total;
    }
}

// Move in BOTH branches of an if/else, then an unguarded deref after the merge: every path is
// moved, so this is strictly worse than the single-branch `ci1` leg above and must still error.
expect_error("dereference of moved variable 'bi1'") {
    int bothBranchesMoveThenDerefIface(int n)
    {
        unique IUniqueThing bi1 = new UniqueIfaceThing();
        if (n > 100) { unique IUniqueThing bi2 = move bi1; } else { unique IUniqueThing bi3 = move bi1; }
        return bi1.get();
    }
}

// An unrelated guard (on a DIFFERENT variable) does not narrow `wg1`: the deref below is still
// unconditional relative to the move, so it must error exactly as the unguarded form does - the
// fixpoint is name-keyed, not silenced by an arbitrary nearby branch.
expect_error("dereference of moved variable 'wg1'") {
    int wrongVarGuardIface(int n, IUniqueThing other)
    {
        unique IUniqueThing wg1 = new UniqueIfaceThing();
        if (n > 100) { unique IUniqueThing wg2 = move wg1; }
        if (other != nullptr) { }
        return wg1.get();
    }
}

// Reading a moved field must still error.
expect_error("use of moved variable 'root.left'") {
    void readMovedField(Tree* root)
    {
        consumeTree(root->left);
        Tree* alias = root->left;  // read of moved field -> error
    }
}

// A '?:' whose arms MIX an owning interface value and a LIVE borrow. An interface value is a
// {vtable, data} fat pointer - a struct - so the join used to take the either-arm rule and let
// the allocating arm stamp it owning whichever arm ran. The `unique` receiver then destroyed the
// borrow arm's box and its real owner destroyed it again (use-after-free, then abort). Which arm
// runs is not knowable, so the join owns nothing an owning receiver may free: reject it, exactly
// as the thin-pointer spelling is rejected (Test/errors/err_unique_borrow_into_unique.cb).
move IUniqueThing makeUniqueIface() { return new UniqueIfaceThing(); }

expect_error("cannot initialize unique 'mixedIface' from a borrowed value") {
    int mixedIfaceJoinIntoUnique(bool c)
    {
        unique IUniqueThing ifaceOwner = new UniqueIfaceThing();
        IUniqueThing borrowedIface = ifaceOwner;
        unique IUniqueThing mixedIface = c ? makeUniqueIface() : borrowedIface;
        return mixedIface.get();
    }
}

// Same mixed join, spelled as an ASSIGNMENT to an already-declared unique interface local rather
// than a decl-initializer. The assign-form reject has its own wording (LValue assignment path).
expect_error("cannot assign a borrowed value to unique interface 'mixedIfaceAssign'") {
    int mixedIfaceJoinIntoUniqueAssign(bool c)
    {
        unique IUniqueThing ifaceOwnerA = new UniqueIfaceThing();
        IUniqueThing borrowedIfaceA = ifaceOwnerA;
        unique IUniqueThing mixedIfaceAssign = nullptr;
        mixedIfaceAssign = c ? makeUniqueIface() : borrowedIfaceA;
        return mixedIfaceAssign.get();
    }
}

// A BORROWED THIN-POINTER arm joined into an interface slot. A plain receiver only borrows the
// mixed join (see test_move.cb's iface_ternary_thin_* legs), but a `unique` receiver must own
// what it frees, so this spelling stays rejected exactly like the fat-pointer one above.
expect_error("cannot initialize unique 'thinBorrowIntoUnique' from a borrowed value") {
    int thinBorrowArmIntoUnique(bool c)
    {
        unique UniqueIfaceThing* thinOwner = new UniqueIfaceThing();
        unique IUniqueThing thinBorrowIntoUnique = c ? new UniqueIfaceThing() : thinOwner;
        return thinBorrowIntoUnique.get();
    }
}

struct IfaceArmHolder { UniqueIfaceThing* p = default; };
void IfaceArmHolder(IfaceArmHolder* self) {}
UniqueIfaceThing* gIfaceArmPtr = default;

/*
 * An arm whose concrete class cannot be recovered. Boxing an arm needs its class to pick a
 * vtable; a local or parameter supplies it from its declared type, but a FIELD or GLOBAL arm
 * does not, and the upcast used to bail and leave a raw `ptr` bitcast into the fat struct -
 * invalid IR caught only by module verification, with no source location. Diagnose it instead.
 */
expect_error("cannot convert '?:' arm to interface 'IUniqueThing': the arm's concrete class cannot be determined") {
    int fieldArmIntoIface(bool c)
    {
        unique UniqueIfaceThing* fieldOwner = new UniqueIfaceThing();
        IfaceArmHolder fh;
        fh.p = fieldOwner;
        IUniqueThing fieldArm = c ? new UniqueIfaceThing() : fh.p;
        return fieldArm.get();
    }
}

expect_error("cannot convert '?:' arm to interface 'IUniqueThing': the arm's concrete class cannot be determined") {
    int globalArmIntoIface(bool c)
    {
        IUniqueThing globalArm = c ? new UniqueIfaceThing() : gIfaceArmPtr;
        return globalArm.get();
    }
}

extern int main()
{
    // use after move - pass to another call
    expect_error("use of moved variable 'r'") {
        MoveResource* r = new MoveResource();
        consume(r);
        consume(r);
    }

    // use after move - field read
    expect_error("use of moved variable 'r2'") {
        MoveResource* r2 = new MoveResource();
        consume(r2);
        int x = r2->id;
    }

    // Dereference (field access) of an explicitly-moved thin `unique` pointer local. A plain
    // read of the same moved-out local (ut == nullptr) stays legal; only the '->' deref errors.
    expect_error("dereference of moved variable 'ut'") {
        unique UniqueThing* ut = new UniqueThing();
        unique UniqueThing* ut2 = move ut;
        int y = ut->v;
    }

    // Dereference via a method-receiver call is rejected identically to a field access.
    expect_error("dereference of moved variable 'ut3'") {
        unique UniqueThing* ut3 = new UniqueThing();
        unique UniqueThing* ut4 = move ut3;
        int y = ut3->get();
    }

    // Same for a `unique <interface>` local.
    expect_error("dereference of moved variable 'ui'") {
        unique IUniqueThing ui = new UniqueIfaceThing();
        unique IUniqueThing ui2 = move ui;
        int y = ui.get();
    }

    // Explicit `*` dereference of an explicitly-moved thin `unique` pointer local.
    expect_error("dereference of moved variable 'ut5'") {
        unique UniqueThing* ut5 = new UniqueThing();
        unique UniqueThing* ut6 = move ut5;
        UniqueThing star = *ut5;
    }

    // Index dereference ('[]') of an explicitly-moved thin `unique` pointer local.
    expect_error("dereference of moved variable 'ut7'") {
        unique int* ut7 = new int[4];
        unique int* ut8 = move ut7;
        int idx = ut7[0];
    }

    // Exception-safety of the '?:' arm-lowering suppression (suppressExplicitNullDerefGuard_):
    // an error thrown WHILE lowering a ternary arm must not leak the suppression past the error
    // (RAII, not manual increment/decrement) - otherwise this later, unrelated same-block deref
    // would be silently un-guarded for the rest of the compile.
    expect_error("Undefined variable undefined_symbol_xyz.") {
        int bogus = 1 ? undefined_symbol_xyz : 2;
    }
    unique UniqueThing* ut9 = new UniqueThing();
    unique UniqueThing* ut10 = move ut9;
    expect_error("dereference of moved variable 'ut9'") {
        int y = ut9->v;
    }

    // use after move - move happens inside an if, read happens after the if
    expect_error("use of moved variable 'r3'") {
        MoveResource* r3 = new MoveResource();
        if (1) consume(r3);
        consume(r3);
    }

    // use after move - move happens inside an else, read happens after the if/else
    expect_error("use of moved variable 'r4'") {
        MoveResource* r4 = new MoveResource();
        if (0) { } else { consume(r4); }
        consume(r4);
    }

    return 0;
}
