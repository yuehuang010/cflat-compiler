// Tests that using a variable after it has been moved is a compile-time error.

struct MoveResource { int id = 0; };
void MoveResource(MoveResource* self) { self->id = 0; }
void consume(move MoveResource* r) { delete r; }

struct Holder { MoveResource* item = nullptr; };
void Holder(Holder* self) {}

// An owning value struct, for the fixed-array-element store below.
struct ArrElemBox { unique MoveResource* item = nullptr; };
struct ArrElemNest { ArrElemBox inner = default; };

// A by-value owning PARAMETER used as a positional brace element is consumed by the callee, so
// the owning-sink inference must make it a sink and the CALLER must surrender its argument. Both
// brace spellings, plus the assignment spelling that is the oracle for them.
void bpsBraceParam(ArrElemBox p)     { ArrElemBox[2] d = { p }; }
void bpsBraceBareParam(ArrElemBox p) { ArrElemBox[2] d { p }; }
void bpsAssignParam(ArrElemBox p)    { ArrElemBox[2] d; d[0] = p; }

// The same four consuming stores with a PARENTHESIZED source. The collectors that feed the
// inference are text-based, so `(p)` used to spell "(p)", match no parameter, and leave the
// caller holding a value the callee had already consumed (rc 134 instead of this rejection).
void pcsBraceParam(ArrElemBox p)  { ArrElemBox[2] d = { (p) }; }
void pcsAssignParam(ArrElemBox p) { ArrElemBox[2] d; d[0] = ((p)); }
void pcsDeclParam(ArrElemBox p)   { ArrElemBox o = (((p))); }
void pcsMoveParam(ArrElemBox p)   { ArrElemBox o = move (p); }

// Dereference-of-explicitly-moved-pointer coverage. Explicit 'move' of a thin `unique`
// pointer/interface local nulls it but, by design, leaves it plain-readable (a == nullptr,
// passing it along, etc. stay legal - see test_move.cb's explicit_move_local_* cases); only a
// DEREFERENCE ('->'/'.'/'*'/'[]') of the moved-out source is rejected. A same-block deref is
// rejected inline; a cross-block one (conditional move, loop-carried) by the MAY-null fixpoint
// at end-of-body, unless a dominating null guard narrows it back to non-null.
struct UniqueThing { int v = 0; int get() { return v; } };
interface IUniqueThing { int get(); };
class UniqueIfaceThing : IUniqueThing { int v = 0; int get() { return v; } };
// No class implements this one, so an IUniqueThing -> IUnrelatedThing upcast can never match a
// vtable at runtime; it must be rejected statically instead of yielding a null-vtable fat value.
interface IUnrelatedThing { int poke(); };
// Brace-init of an interface-typed field is its own store path; it must re-box like `=` does.
struct UnrelatedSlot { IUnrelatedThing s = default; };

// The zero-implementor rebox backstop ("cannot convert to interface 'X' - no class implements
// it") lives in Test/errors/err_iface_rebox_no_implementor.cb: it now fires at finalization,
// after every scope has closed, so it needs the file-scope form of expect_error and cannot
// share a file with the scoped-block expectations below.

// use after move - assign move param to struct field, then read param again
expect_error("use of moved variable 'child'") {
    void storeAndRead(Holder* h, move MoveResource* child)
    {
        h->item = child;
        int y = child->id;
    }
}

/*
 * The '??=' spelling of the store above. A '??=' into a unique FIELD consumes the named source
 * exactly as '=' does (TransferPointerOwnershipOnStore), so a later read of the source is a use
 * after move. On the merge base '??=' returned before that transfer: the program compiled, both
 * bindings pointed at one object, and the scope exit double-freed it (measured rc 133).
 * Discriminator: the pinned name is the SOURCE parameter, which only the transfer marks moved -
 * the '??=' destination is never the subject of this message.
 */
expect_error("use of moved variable 'child3'") {
    void nullAssignAndRead(Holder* h, move MoveResource* child3)
    {
        h->item ??= child3;
        int y = child3->id;
    }
}

// use after move - move param assigned to a field in each branch, read after the if/else
expect_error("use of moved variable 'child2'") {
    void storeAndReadBranched(Holder* h, Holder* h2, move MoveResource* child2)
    {
        if (1) { h->item = child2; } else { h2->item = child2; }
        int y = child2->id;
    }
}

// X4 Part 2: moving a struct FIELD marks only that field, not the whole base.
// Moving the SAME field twice must still error (the field's buffer was transferred).
struct Tree { Tree* left = nullptr; Tree* right = nullptr; };
void consumeTree(move Tree* t) { if (t != nullptr) delete t; }

expect_error("use of moved variable 'root.left'") {
    void moveFieldTwice(Tree* root)
    {
        consumeTree(root->left);
        consumeTree(root->left);   // same field moved twice -> error
    }
}

// Cross-block dereference of an explicitly-moved thin `unique` pointer local. The move is in
// one branch and the (unguarded) deref is after the merge, so the same-block guard cannot see
// it; the MAY-null fixpoint over the function's CFG reports it at end-of-body instead. A
// dominating null guard would narrow it back to non-null - see test_move.cb's narrowing legs.
expect_error("dereference of moved variable 'cb1'") {
    int condMoveThenDeref(int n)
    {
        unique UniqueThing* cb1 = new UniqueThing();
        if (n > 100) { unique UniqueThing* cb2 = move cb1; }
        return cb1->v;
    }
}

// Loop-carried: iteration 1 dereferences what iteration 0 moved out (via the back-edge).
expect_error("dereference of moved variable 'lc1'") {
    int loopCarriedMoveThenDeref()
    {
        unique UniqueThing* lc1 = new UniqueThing();
        unique UniqueThing* lc2 = nullptr;
        int total = 0;
        for (int i = 0; i < 2; i++)
        {
            total = total + lc1->v;
            if (lc2 == nullptr) { lc2 = move lc1; }
        }
        return total;
    }
}

// Same cross-block shape on a `unique <interface>` local: the moved-from interface is nulled but
// plain-readable, so the unguarded dispatch after the merge is caught by the MAY-null fixpoint.
// The guarded spelling (`if (ci1 != nullptr)`) compiles - see test_move.cb's interface leg.
expect_error("dereference of moved variable 'ci1'") {
    int condMoveThenDerefIface(int n)
    {
        unique IUniqueThing ci1 = new UniqueIfaceThing();
        if (n > 100) { unique IUniqueThing ci2 = move ci1; }
        return ci1.get();
    }
}

// Loop-carried move of a `unique <interface>` local: iteration 1 dereferences what iteration 0
// moved out (via the back-edge) - the interface counterpart of the thin-pointer `lc1` leg above.
expect_error("dereference of moved variable 'lc1i'") {
    int loopCarriedMoveThenDerefIface()
    {
        unique IUniqueThing lc1i = new UniqueIfaceThing();
        unique IUniqueThing lc2i = nullptr;
        int total = 0;
        for (int i = 0; i < 2; i++)
        {
            total = total + lc1i.get();
            if (lc2i == nullptr) { lc2i = move lc1i; }
        }
        return total;
    }
}

// Move in BOTH branches of an if/else, then an unguarded deref after the merge: every path is
// moved, so this is strictly worse than the single-branch `ci1` leg above and must still error.
expect_error("dereference of moved variable 'bi1'") {
    int bothBranchesMoveThenDerefIface(int n)
    {
        unique IUniqueThing bi1 = new UniqueIfaceThing();
        if (n > 100) { unique IUniqueThing bi2 = move bi1; } else { unique IUniqueThing bi3 = move bi1; }
        return bi1.get();
    }
}

// An unrelated guard (on a DIFFERENT variable) does not narrow `wg1`: the deref below is still
// unconditional relative to the move, so it must error exactly as the unguarded form does - the
// fixpoint is name-keyed, not silenced by an arbitrary nearby branch.
expect_error("dereference of moved variable 'wg1'") {
    int wrongVarGuardIface(int n, IUniqueThing other)
    {
        unique IUniqueThing wg1 = new UniqueIfaceThing();
        if (n > 100) { unique IUniqueThing wg2 = move wg1; }
        if (other != nullptr) { }
        return wg1.get();
    }
}

// Reading a moved field must still error.
expect_error("use of moved variable 'root.left'") {
    void readMovedField(Tree* root)
    {
        consumeTree(root->left);
        Tree* alias = root->left;  // read of moved field -> error
    }
}

// A '?:' whose arms MIX an owning interface value and a LIVE borrow. An interface value is a
// {vtable, data} fat pointer - a struct - so the join used to take the either-arm rule and let
// the allocating arm stamp it owning whichever arm ran. The `unique` receiver then destroyed the
// borrow arm's box and its real owner destroyed it again (use-after-free, then abort). Which arm
// runs is not knowable, so the join owns nothing an owning receiver may free: reject it, exactly
// as the thin-pointer spelling is rejected (Test/errors/err_unique_borrow_into_unique.cb).
move IUniqueThing makeUniqueIface() { return new UniqueIfaceThing(); }

expect_error("cannot initialize unique 'mixedIface' from a borrowed value") {
    int mixedIfaceJoinIntoUnique(bool c)
    {
        unique IUniqueThing ifaceOwner = new UniqueIfaceThing();
        IUniqueThing borrowedIface = ifaceOwner;
        unique IUniqueThing mixedIface = c ? makeUniqueIface() : borrowedIface;
        return mixedIface.get();
    }
}

// Same mixed join, but the THIN arm goes through the new fat/thin harmonizer branch instead of
// an already-fat owning call: a borrowed already-fat arm mixed with a thin `new` arm still owns
// nothing a `unique` receiver may free.
expect_error("cannot initialize unique 'fatBorrowVsNewUnique' from a borrowed value") {
    int fatBorrowVsNewArmIntoUnique(bool c)
    {
        unique IUniqueThing thinOwner = new UniqueIfaceThing();
        IUniqueThing thinBorrowed = thinOwner;
        unique IUniqueThing fatBorrowVsNewUnique = c ? thinBorrowed : new UniqueIfaceThing();
        return fatBorrowVsNewUnique.get();
    }
}

// Same mixed join, spelled as an ASSIGNMENT to an already-declared unique interface local rather
// than a decl-initializer. The assign-form reject has its own wording (LValue assignment path).
expect_error("cannot assign a borrowed value to unique interface 'mixedIfaceAssign'") {
    int mixedIfaceJoinIntoUniqueAssign(bool c)
    {
        unique IUniqueThing ifaceOwnerA = new UniqueIfaceThing();
        IUniqueThing borrowedIfaceA = ifaceOwnerA;
        unique IUniqueThing mixedIfaceAssign = nullptr;
        mixedIfaceAssign = c ? makeUniqueIface() : borrowedIfaceA;
        return mixedIfaceAssign.get();
    }
}

// A BORROWED THIN-POINTER arm joined into an interface slot. A plain receiver only borrows the
// mixed join (see test_move.cb's iface_ternary_thin_* legs), but a `unique` receiver must own
// what it frees, so this spelling stays rejected exactly like the fat-pointer one above.
expect_error("cannot initialize unique 'thinBorrowIntoUnique' from a borrowed value") {
    int thinBorrowArmIntoUnique(bool c)
    {
        unique UniqueIfaceThing* thinOwner = new UniqueIfaceThing();
        unique IUniqueThing thinBorrowIntoUnique = c ? new UniqueIfaceThing() : thinOwner;
        return thinBorrowIntoUnique.get();
    }
}

// Borrows an interface value; the call-argument spelling of the class -> interface upcast.
int takesIface(IUniqueThing s) { return s.get(); }

// Same upcast reached through VIRTUAL dispatch: an interface method whose parameter is itself
// an interface, so the argument is boxed by CallInterfaceMethod rather than the direct-call path.
interface ISink { int take(IUniqueThing s); };
class SinkImpl : ISink { int n = 0; int take(IUniqueThing s) { return s.get() + n; } };

struct IfaceArmHolder { UniqueIfaceThing* p = default; };
void IfaceArmHolder(IfaceArmHolder* self) {}
UniqueIfaceThing* gIfaceArmPtr = default;

/*
 * An arm whose concrete class cannot be recovered. Boxing an arm needs its class to pick a
 * vtable; a local or parameter supplies it from its declared type, but a FIELD or GLOBAL arm
 * does not, and the upcast used to bail and leave a raw `ptr` bitcast into the fat struct -
 * invalid IR caught only by module verification, with no source location. Diagnose it instead.
 */
expect_error("cannot convert '?:' arm to interface 'IUniqueThing': the arm's concrete class cannot be determined") {
    int fieldArmIntoIface(bool c)
    {
        unique UniqueIfaceThing* fieldOwner = new UniqueIfaceThing();
        IfaceArmHolder fh;
        fh.p = fieldOwner;
        IUniqueThing fieldArm = c ? new UniqueIfaceThing() : fh.p;
        return fieldArm.get();
    }
}

expect_error("cannot convert '?:' arm to interface 'IUniqueThing': the arm's concrete class cannot be determined") {
    int globalArmIntoIface(bool c)
    {
        IUniqueThing globalArm = c ? new UniqueIfaceThing() : gIfaceArmPtr;
        return globalArm.get();
    }
}

/*
 * MIXED '?:' join of an OWNING-VALUE STRUCT (a `unique` field, so its destructor deletes the
 * field). The join may carry the borrow arm's live bits, so no destination whose destructor runs
 * UNCONDITIONALLY may take it. A DECLARATION can (the new local is marked a borrow), so that
 * spelling stays legal and is exercised in Test/test_move.cb; these three are the destinations
 * with no per-value flag to carry the suppression, and each used to double-free.
 */
struct JoinBox { unique UniqueThing* item = nullptr; };
struct JoinHolder { JoinBox box; };

JoinBox makeJoinBox()
{
    JoinBox b;
    b.item = new UniqueThing();
    return b;
}

/*
 * Return-walk launder helpers. A borrowing callee that hands its parameter back defeats the
 * temp-unique-field escape guards on IDENTITY alone: the value the declaration sees is a fresh
 * CallInst, not the ledgered field read. Each helper below is a shape the MAY-return walk must
 * answer YES for; the accept twins (a callee returning another parameter, a global, or a fresh
 * allocation) are value legs in Test/test_move.cb and must keep compiling.
 */
UniqueThing* gRwKept = nullptr;
UniqueThing* rwPassthru(UniqueThing* n) { return n; }
UniqueThing* rwViaLocal(UniqueThing* n) { UniqueThing* x = n; return x; }
UniqueThing* rwViaBranch(UniqueThing* n, int c) { if (c > 0) { return n; } return gRwKept; }
UniqueThing* rwChain(UniqueThing* n) { return rwPassthru(n); }
struct RwSlot { UniqueThing* q = nullptr; RwSlot(UniqueThing* z) { this.q = z; } };
void rwSink(unique UniqueThing* p) { }

/*
 * JOINED store destinations. `getUnderlyingObject` stops at a select/phi, so a store through
 * `c ? &g : &g2` used to find no proof and accept while the single-global spelling one line over
 * was diagnosed. The rule is ALL arms: these callees have no arm naming local memory.
 */
UniqueThing* gSelA = nullptr;
UniqueThing* gSelB = nullptr;
UniqueThing* gSelC = nullptr;
UniqueThing** gSelPtrA = nullptr;
UniqueThing** gSelPtrB = nullptr;
void selTwoGlobals(UniqueThing* n, int c) { UniqueThing** p = c > 0 ? &gSelA : &gSelB; *p = n; }
void selGlobalAndParam(UniqueThing* n, UniqueThing** out, int c)
{
    UniqueThing** p = c > 0 ? out : &gSelA;
    *p = n;
}
void selNestedGlobals(UniqueThing* n, int c, int d)
{
    UniqueThing** q = c > 0 ? &gSelA : &gSelB;
    UniqueThing** p = d > 0 ? q : &gSelC;
    *p = n;
}
void selOfGlobalLoads(UniqueThing* n, int c)
{
    UniqueThing** p = c > 0 ? gSelPtrA : gSelPtrB;
    *p = n;
}

// RETURN position: the laundered result outlives the statement that destructs the temp.
expect_error("cannot store the result of 'rwPassthru' into the return value") {
    UniqueThing* rwLeakThroughReturn() { return rwPassthru(makeJoinBox().item); }
}

expect_error("mixes an owning and a borrowed 'JoinBox' arm into an owning variable") {
    void joinIntoOwningLocal(JoinBox borrowed, bool c)
    {
        JoinBox k;
        k = c ? makeJoinBox() : borrowed;
    }
}

expect_error("mixes an owning and a borrowed 'JoinBox' arm into a struct field") {
    void joinIntoStructField(JoinBox borrowed, bool c)
    {
        JoinHolder h;
        h.box = c ? makeJoinBox() : borrowed;
    }
}

expect_error("mixes an owning and a borrowed 'JoinBox' arm into a struct field") {
    void joinIntoBraceInitField(JoinBox borrowed, bool c)
    {
        JoinHolder h = { box = c ? makeJoinBox() : borrowed };
    }
}

expect_error("mixes an owning and a borrowed 'JoinBox' arm into a return slot") {
    JoinBox joinIntoReturnSlot(JoinBox borrowed, bool c)
    {
        return c ? makeJoinBox() : borrowed;
    }
}

/*
 * An `alias`-return LOCAL (or a mixed-join local, or a bare `alias` call result) is a BORROW of
 * storage it does not own. The field store, the brace-init field and the return slot already
 * rejected it; the OWNING-LOCAL store and the `move` ARGUMENT did not, and each transferred the
 * borrow's bits to a second destroyer that ran over the owner's live storage (abort). All five
 * sites now ask one predicate, so these legs pin the two that were uncovered plus the source
 * spellings - chained borrow and no-local-at-all - that reach the same predicate.
 * The DECLARATION spelling (`JoinBox k2 = k;`) is the sanctioned way to pass a borrow along and
 * stays legal - its value/resource legs are in Test/test_move.cb.
 */
struct AliasWrap
{
    JoinBox b;
    alias JoinBox borrow() { return this.b; }
};

void aliasBoxSink(move JoinBox b) { }

expect_error("cannot store an 'alias' value 'k' into an owning variable") {
    void aliasBorrowIntoOwningLocal(AliasWrap* w)
    {
        JoinBox k = w->borrow();
        JoinBox other = makeJoinBox();
        other = k;
    }
}

expect_error("cannot 'move' the 'alias' value 'k'") {
    void aliasBorrowAsMoveArgument(AliasWrap* w)
    {
        JoinBox k = w->borrow();
        aliasBoxSink(move k);
    }
}

/*
 * `move` of a FIELD of a borrow local. The whole-value `move k` above is rejected, but the field
 * spelling walked straight past it: `k` shallow-copies the wrapper's struct, so nulling `k.item`
 * leaves the wrapper's own `item` live and both the sink and the wrapper free the pointee (abort).
 * Answered against the RESOLVED root binding at the field-access site, so a NESTED path reaches it
 * too, and a by-reference lambda capture is carved out (its storage IS the owner's - see
 * test_function_ptr.cb's `refcap_field_move_*` legs). The ACCEPT side - the same `move` off a local
 * that OWNS its value, and off a borrow local that was RE-BOUND - is in Test/test_move.cb.
 */
void aliasItemSink(move UniqueThing* p) { }

expect_error("cannot 'move' field 'JoinBox.item' out of 'alias' borrow 'k'") {
    void aliasBorrowFieldMove(AliasWrap* w)
    {
        JoinBox k = w->borrow();
        aliasItemSink(move k.item);
    }
}

// The same field consumed by a DECLARATION rather than a call argument - a second store path.
expect_error("cannot 'move' field 'JoinBox.item' out of 'alias' borrow 'k'") {
    void aliasBorrowFieldMoveIntoLocal(AliasWrap* w)
    {
        JoinBox k = w->borrow();
        unique UniqueThing* p = move k.item;
    }
}

// A NESTED field path: the root recorded at each hop is still the borrow local, not the field.
struct AliasOuter
{
    AliasWrap inner;
    alias AliasWrap peek() { return this.inner; }
};

expect_error("cannot 'move' field 'JoinBox.item' out of 'alias' borrow 'ko'") {
    void aliasBorrowNestedFieldMove(AliasOuter* o)
    {
        AliasWrap ko = o->peek();
        aliasItemSink(move ko.b.item);
    }
}

// The MIXED '?:' join is the SECOND declaration site that marks a local a borrow, and which arm ran
// is not knowable, so the field spelling is rejected there too - the whole-value `move kj` already
// was. The borrow arm double-freed on master; the owning arm is the price of not knowing.
expect_error("cannot 'move' field 'JoinBox.item' out of 'alias' borrow 'kj'") {
    void aliasJoinFieldMove(AliasWrap* w, bool c)
    {
        JoinBox kj = c ? makeJoinBox() : w->borrow();
        aliasItemSink(move kj.item);
    }
}

// The CHAINED borrow is the shape the accepted declaration produces, so it must be rejected at the
// same two sites - otherwise one extra `=` launders the borrow right back out.
expect_error("cannot store an 'alias' value 'k2' into an owning variable") {
    void aliasBorrowChainIntoOwningLocal(AliasWrap* w)
    {
        JoinBox k = w->borrow();
        JoinBox k2 = k;
        JoinBox other = makeJoinBox();
        other = k2;
    }
}

expect_error("cannot 'move' the 'alias' value 'k2'") {
    void aliasBorrowChainAsMoveArgument(AliasWrap* w)
    {
        JoinBox k = w->borrow();
        JoinBox k2 = k;
        aliasBoxSink(move k2);
    }
}

// No local at all: the bare `alias` call result carries TypeAndValue.IsAlias and never reaches the
// named-slot arm of the assignment path, so it is a distinct spelling of the same hazard.
expect_error("cannot store an 'alias' value 'JoinBox' into an owning variable") {
    void aliasCallResultIntoOwningLocal(AliasWrap* w)
    {
        JoinBox other = makeJoinBox();
        other = w->borrow();
    }
}

expect_error("cannot 'move' the 'alias' value 'JoinBox'") {
    void aliasCallResultAsMoveArgument(AliasWrap* w)
    {
        aliasBoxSink(move w->borrow());
    }
}

// A borrow that came from a mixed '?:' JOIN, laundered one statement later. The join's own reject
// covers only a DIRECT store of the join; once it is bound to a local, this predicate is the only
// thing standing between the borrow and a second destroyer.
expect_error("cannot store an 'alias' value 'k' into an owning variable") {
    void joinBorrowIntoOwningLocal(JoinBox borrowed, bool c)
    {
        JoinBox k = c ? makeJoinBox() : borrowed;
        JoinBox other = makeJoinBox();
        other = k;
    }
}

expect_error("cannot 'move' the 'alias' value 'k'") {
    void joinBorrowAsMoveArgument(JoinBox borrowed, bool c)
    {
        JoinBox k = c ? makeJoinBox() : borrowed;
        aliasBoxSink(move k);
    }
}

/*
 * `move` of an interface-TYPED local (already fat, {vtable,data}) paired with a THIN arm whose
 * concrete class cannot be recovered - a FIELD read, same shape as fieldArmIntoIface above but
 * with the fat side coming from `move` instead of a second `new`. Exercises the fat-vs-thin case
 * in UnifyTernaryArmTypes, not the already-fat-phi path fieldArmIntoIface exercises.
 */
expect_error("cannot convert '?:' arm to interface 'IUniqueThing': the arm's concrete class cannot be determined") {
    int moveVsFieldArmIntoIface(bool c)
    {
        unique IUniqueThing g = new UniqueIfaceThing();
        IfaceArmHolder fh;
        fh.p = new UniqueIfaceThing();
        IUniqueThing k = c ? move g : fh.p;
        return k.get();
    }
}

// `move` of an interface-TYPED local paired with a THIN arm whose class does NOT implement the
// target interface. UniqueThing is a plain struct - no vtable for IUniqueThing exists at all.
expect_error("cannot convert '?:' arm to interface 'IUniqueThing': 'UniqueThing' does not implement it") {
    int moveVsNonImplementingArmIntoIface(bool c)
    {
        unique IUniqueThing g2 = new UniqueIfaceThing();
        UniqueThing* notIface = new UniqueThing();
        IUniqueThing k2 = c ? move g2 : notIface;
        return k2.get();
    }
}

extern int main()
{
    // use after move - pass to another call
    expect_error("use of moved variable 'r'") {
        MoveResource* r = new MoveResource();
        consume(r);
        consume(r);
    }

    // use after move - field read
    expect_error("use of moved variable 'r2'") {
        MoveResource* r2 = new MoveResource();
        consume(r2);
        int x = r2->id;
    }

    // Dereference (field access) of an explicitly-moved thin `unique` pointer local. A plain
    // read of the same moved-out local (ut == nullptr) stays legal; only the '->' deref errors.
    expect_error("dereference of moved variable 'ut'") {
        unique UniqueThing* ut = new UniqueThing();
        unique UniqueThing* ut2 = move ut;
        int y = ut->v;
    }

    // Dereference via a method-receiver call is rejected identically to a field access.
    expect_error("dereference of moved variable 'ut3'") {
        unique UniqueThing* ut3 = new UniqueThing();
        unique UniqueThing* ut4 = move ut3;
        int y = ut3->get();
    }

    // Same for a `unique <interface>` local.
    expect_error("dereference of moved variable 'ui'") {
        unique IUniqueThing ui = new UniqueIfaceThing();
        unique IUniqueThing ui2 = move ui;
        int y = ui.get();
    }

    // Explicit `*` dereference of an explicitly-moved thin `unique` pointer local.
    expect_error("dereference of moved variable 'ut5'") {
        unique UniqueThing* ut5 = new UniqueThing();
        unique UniqueThing* ut6 = move ut5;
        UniqueThing star = *ut5;
    }

    // Index dereference ('[]') of an explicitly-moved thin `unique` pointer local.
    expect_error("dereference of moved variable 'ut7'") {
        unique int* ut7 = new int[4];
        unique int* ut8 = move ut7;
        int idx = ut7[0];
    }

    // Exception-safety of the '?:' arm-lowering suppression (suppressExplicitNullDerefGuard_):
    // an error thrown WHILE lowering a ternary arm must not leak the suppression past the error
    // (RAII, not manual increment/decrement) - otherwise this later, unrelated same-block deref
    // would be silently un-guarded for the rest of the compile.
    expect_error("Undefined variable undefined_symbol_xyz.") {
        int bogus = 1 ? undefined_symbol_xyz : 2;
    }
    unique UniqueThing* ut9 = new UniqueThing();
    unique UniqueThing* ut10 = move ut9;
    expect_error("dereference of moved variable 'ut9'") {
        int y = ut9->v;
    }

    // Storing an owning struct into a FIXED-ARRAY element consumes a NAMED source, exactly as
    // the whole-local store does, so a later read of that source is a use after move. Before the
    // fix the store was a plain bit copy: this compiled and double-freed at teardown (rc 133).
    expect_error("use of moved variable 'ael'") {
        ArrElemBox ael;
        ael.item = new MoveResource();
        ArrElemBox[2] aelDst;
        aelDst[0] = ael;
        int aelId = ael.item->id;
    }

    // The BRACE-INIT spelling of the same store, `T[N] dst = { a };`, consumes its named source
    // too. Before the fix it was a plain bit copy: this compiled and double-freed (rc 133).
    expect_error("use of moved variable 'abr'") {
        ArrElemBox abr;
        abr.item = new MoveResource();
        ArrElemBox[2] abrDst = { abr };
        int abrId = abr.item->id;
    }

    // The SAME source twice in one brace list: the first element consumes it, so the second is
    // a use after move rather than a second alias of one resource.
    expect_error("use of moved variable 'abrTwice'") {
        ArrElemBox abrTwice;
        abrTwice.item = new MoveResource();
        ArrElemBox[2] abrDup = { abrTwice, abrTwice };
    }

    // CALLER half of the brace element store. Passing a named owner to a parameter the callee
    // consumes surrenders it, so a later read is a use after move. Before the fix the caller was
    // never told, so this compiled and both sides freed one resource (rc 134).
    expect_error("use of moved variable 'bpsA'") {
        ArrElemBox bpsA;
        bpsA.item = new MoveResource();
        bpsBraceParam(bpsA);
        int bpsAId = bpsA.item->id;
    }

    // The bare-brace spelling hangs its list off the declarator, a second syntactic site.
    expect_error("use of moved variable 'bpsB'") {
        ArrElemBox bpsB;
        bpsB.item = new MoveResource();
        bpsBraceBareParam(bpsB);
        int bpsBId = bpsB.item->id;
    }

    // The ORACLE the two above must match: the assignment spelling of the same callee store.
    expect_error("use of moved variable 'bpsC'") {
        ArrElemBox bpsC;
        bpsC.item = new MoveResource();
        bpsAssignParam(bpsC);
        int bpsCId = bpsC.item->id;
    }

    // CALLER half again, with the source PARENTHESIZED in each of the four consuming spellings.
    // Every one of these must reject exactly as its unparenthesized control above does.
    expect_error("use of moved variable 'pcsA'") {
        ArrElemBox pcsA;
        pcsA.item = new MoveResource();
        pcsBraceParam(pcsA);
        int pcsAId = pcsA.item->id;
    }

    expect_error("use of moved variable 'pcsB'") {
        ArrElemBox pcsB;
        pcsB.item = new MoveResource();
        pcsAssignParam(pcsB);
        int pcsBId = pcsB.item->id;
    }

    expect_error("use of moved variable 'pcsC'") {
        ArrElemBox pcsC;
        pcsC.item = new MoveResource();
        pcsDeclParam(pcsC);
        int pcsCId = pcsC.item->id;
    }

    expect_error("use of moved variable 'pcsD'") {
        ArrElemBox pcsD;
        pcsD.item = new MoveResource();
        pcsMoveParam(pcsD);
        int pcsDId = pcsD.item->id;
    }

    // The brace element decision must not swallow a type mismatch either: an `ArrElemBox` value
    // in an `ArrElemNest` list still has to reach the existing cast diagnostic.
    expect_error("cannot cast an aggregate value") {
        ArrElemBox abrBad;
        abrBad.item = new MoveResource();
        ArrElemNest[2] abrNest = { abrBad };
    }

    // The element transfer arm RETURNS EARLY, so it must not swallow a type mismatch: an
    // `ArrElemBox` value stored into an `ArrElemNest` element still has to reach the existing
    // diagnostic. Review found the arm accepted this and emitted a mismatched store.
    expect_error("cannot cast an aggregate value") {
        ArrElemBox aelSrc;
        aelSrc.item = new MoveResource();
        ArrElemNest[2] aelNest;
        aelNest[0] = aelSrc;
    }

    // use after move - move happens inside an if, read happens after the if
    expect_error("use of moved variable 'r3'") {
        MoveResource* r3 = new MoveResource();
        if (1) consume(r3);
        consume(r3);
    }

    // use after move - move happens inside an else, read happens after the if/else
    expect_error("use of moved variable 'r4'") {
        MoveResource* r4 = new MoveResource();
        if (0) { } else { consume(r4); }
        consume(r4);
    }

    // Moving a `unique` interface local into an interface its class does not implement used to
    // build a null-vtable fat pointer and segfault on the next call. Direct spelling.
    expect_error("no class implementing 'IUniqueThing' implements 'IUnrelatedThing'") {
        unique IUniqueThing ug = new UniqueIfaceThing();
        unique IUnrelatedThing uk = move ug;
    }

    // Same conversion through a '?:' whose fat arm is the move and whose thin arm is boxed
    // against the fat arm's interface - the receiver's interface is still the one that must match.
    expect_error("no class implementing 'IUniqueThing' implements 'IUnrelatedThing'") {
        unique IUniqueThing ug2 = new UniqueIfaceThing();
        unique IUnrelatedThing uk2 = 1 ? move ug2 : new UniqueIfaceThing();
    }

    // Brace-init spelling: a fat value bound to a struct field of a different interface. It used
    // to store the source vtable unchanged, so the field's method 0 called the source's method 0.
    expect_error("no class implementing 'IUniqueThing' implements 'IUnrelatedThing'") {
        IUniqueThing ub = new UniqueIfaceThing();
        UnrelatedSlot slot = { s = ub };
    }

    // Array brace-init binds elements through its own store path, with the same defect.
    expect_error("no class implementing 'IUniqueThing' implements 'IUnrelatedThing'") {
        IUniqueThing ub2 = new UniqueIfaceThing();
        IUnrelatedThing[2] uarr = { ub2, ub2 };
    }

    // Direct decl-init from a 'T**' binding. The declared TypeName implements the interface, but
    // the slot holds a POINTER to the instance pointer - boxing it type-confuses the vtable.
    expect_error("cannot convert 'UniqueIfaceThing**' to interface 'IUniqueThing'") {
        unique UniqueIfaceThing* pOwner = new UniqueIfaceThing();
        UniqueIfaceThing** ppOwner = &pOwner;
        IUniqueThing kpp = ppOwner;
    }

    // Same hole through a 'T[]' array view: the view's storage is the element buffer, not one
    // instance, so the class vtable must not be attached to it.
    expect_error("cannot convert 'UniqueIfaceThing[]' to interface 'IUniqueThing'") {
        UniqueIfaceThing[] vview = new UniqueIfaceThing[4];
        IUniqueThing kview = vview;
    }

    // Fixed 'T[N]' slot: the storage is N inlined elements, so attaching the class vtable to the
    // whole slot is the same confusion - the shape guard's ConstArraySize arm rejects it.
    expect_error("cannot convert 'UniqueIfaceThing[3]' to interface 'IUniqueThing'") {
        UniqueIfaceThing[3] ffix;
        IUniqueThing kfix = ffix;
    }

    // Plain '=' assignment spelling of the 'T**' case (a separate upcast site from decl-init).
    expect_error("cannot convert 'UniqueIfaceThing**' to interface 'IUniqueThing'") {
        unique UniqueIfaceThing* pOwner2 = new UniqueIfaceThing();
        UniqueIfaceThing** ppOwner2 = &pOwner2;
        IUniqueThing kasg = nullptr;
        kasg = ppOwner2;
    }

    // Call-ARGUMENT spelling: boxing into an interface PARAMETER is a separate site from the
    // direct upcasts above, and it read garbage through the wrongly attached vtable.
    expect_error("cannot convert 'UniqueIfaceThing**' to interface 'IUniqueThing'") {
        unique UniqueIfaceThing* pOwner3 = new UniqueIfaceThing();
        UniqueIfaceThing** ppOwner3 = &pOwner3;
        int kcall = takesIface(ppOwner3);
    }

    // Array-view argument to the same interface parameter.
    expect_error("cannot convert 'UniqueIfaceThing[]' to interface 'IUniqueThing'") {
        UniqueIfaceThing[] vview2 = new UniqueIfaceThing[4];
        int kcallv = takesIface(vview2);
    }

    // Interface-METHOD argument spelling: the vtable-dispatch path boxes its arguments in its own
    // builder, so a 'T**' reaching an interface parameter there is a distinct hole from the above.
    expect_error("cannot convert 'UniqueIfaceThing**' to interface 'IUniqueThing'") {
        unique UniqueIfaceThing* pOwner4 = new UniqueIfaceThing();
        UniqueIfaceThing** ppOwner4 = &pOwner4;
        unique SinkImpl* sinkOwner = new SinkImpl();
        ISink vsink = sinkOwner;
        int kvcall = vsink.take(ppOwner4);
    }

    // Array-view argument through the same virtual-dispatch parameter.
    expect_error("cannot convert 'UniqueIfaceThing[]' to interface 'IUniqueThing'") {
        UniqueIfaceThing[] vview3 = new UniqueIfaceThing[4];
        unique SinkImpl* sinkOwner2 = new SinkImpl();
        ISink vsink2 = sinkOwner2;
        int kvcallv = vsink2.take(vview3);
    }

    // The RETURN-WALK legs. Each binds a temp's `unique` field, laundered through a borrowing
    // callee, to something that outlives the statement. Pre-fix every one compiled and read
    // freed memory (measured `v=99 same=1 dtors=1` against a freshly reallocated witness);
    // the direct spelling `UniqueThing* d = makeJoinBox().item;` was already rejected.
    expect_error("cannot store the result of 'rwPassthru' into a local") {
        UniqueThing* rwA = rwPassthru(makeJoinBox().item);
    }
    // A local slot inside the callee, not a bare `ret <param>`.
    expect_error("cannot store the result of 'rwViaLocal' into a local") {
        UniqueThing* rwB = rwViaLocal(makeJoinBox().item);
    }
    // MAY-return: only ONE branch of the callee hands the parameter back.
    expect_error("cannot store the result of 'rwViaBranch' into a local") {
        UniqueThing* rwC = rwViaBranch(makeJoinBox().item, 1);
    }
    // The launder is two callees deep - the walk recurses through the inner call.
    expect_error("cannot store the result of 'rwChain' into a local") {
        UniqueThing* rwD = rwChain(makeJoinBox().item);
    }
    // Chained at the CALL site instead: the outer call's argument is the inner call's result,
    // which this fix re-ledgered, so the outer launder is judged too.
    expect_error("cannot store the result of 'rwPassthru' into a local") {
        UniqueThing* rwE = rwPassthru(rwPassthru(makeJoinBox().item));
    }
    // Through a '?:' arm and a '??' fallback: the join machinery picks the marking off the arm.
    expect_error("cannot store the result of 'rwPassthru' into a local") {
        UniqueThing* rwNul = nullptr;
        int rwc = 1;
        UniqueThing* rwF = rwc > 0 ? rwPassthru(makeJoinBox().item) : rwNul;
    }
    expect_error("cannot store the result of 'rwPassthru' into a local") {
        UniqueThing* rwNul2 = nullptr;
        UniqueThing* rwG = rwNul2 ?? rwPassthru(makeJoinBox().item);
    }
    // A by-value CONSTRUCTOR lowers to insertvalue + ret with no store at all, which is why
    // the store-based escape walk structurally could not see it.
    expect_error("cannot store the result of 'RwSlot' into a local") {
        RwSlot rwH = RwSlot(makeJoinBox().item);
    }
    // Same constructor, into the HEAP block `new` allocates - a store no other guard site sees.
    expect_error("cannot store the result of 'RwSlot' into the heap object 'new RwSlot' allocates") {
        RwSlot* rwI = new RwSlot(makeJoinBox().item);
    }
    // Assignment, not declaration: a second guard site on the same laundered value.
    expect_error("cannot store the result of 'rwPassthru' into a longer-lived location") {
        gRwKept = rwPassthru(makeJoinBox().item);
    }
    // Into a parameter that TAKES OWNERSHIP: the callee would own memory the temp frees.
    expect_error("cannot pass a unique field of a temporary to parameter 'p'") {
        rwSink(rwPassthru(makeJoinBox().item));
    }

    // The JOINED-DESTINATION legs. Pre-fix each compiled and read freed memory (measured
    // `v=7 same=1` against a freshly reallocated witness); the single-global spelling of each
    // was already diagnosed, so what these add is the select/phi arm walk.
    expect_error("'selTwoGlobals' stores that pointer into a global") {
        selTwoGlobals(makeJoinBox().item, 1);
    }
    // Arms of DIFFERENT outliving kinds - a global and caller memory - so the message names the
    // join rather than claiming one of them.
    expect_error("stores that pointer into memory that outlives the call on every arm of a join") {
        UniqueThing* selOut = nullptr;
        selGlobalAndParam(makeJoinBox().item, &selOut, 1);
    }
    // A select whose arm is itself a select: the arm walk recurses.
    expect_error("'selNestedGlobals' stores that pointer into a global") {
        selNestedGlobals(makeJoinBox().item, 1, 1);
    }
    // Arms that are LOADS of global pointer variables, not addresses of globals.
    expect_error("'selOfGlobalLoads' stores that pointer into a global") {
        selOfGlobalLoads(makeJoinBox().item, 1);
    }

    return 0;
}
