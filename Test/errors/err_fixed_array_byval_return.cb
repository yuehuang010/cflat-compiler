// Returning a fixed array BY VALUE. This was never implemented rather than merely
// mis-lowered: the '[N]' on the return type was dropped silently, so 'char[8] mk()'
// built a function returning a single 'char', and 'return b;' then emitted 'ret ptr'
// against an i8 return type - "Function return type does not match operand type of
// return inst!", no source location. No probed spelling that actually returned an
// ARRAY worked (1-D, 2-D, alias return type, method, namespaced, array-of-struct,
// never-called, generic over an array alias). The one spelling that did compile and
// run - 'char[8] mk() { return 'a'; }' - only worked BECAUSE the '[8]' was dropped:
// the body returns a single char, which matches the silently-narrowed type. So the
// capability is absent, not accidental. Array-VIEW returns ('T[]') and returns of a
// struct CONTAINING an array are unaffected and still work. Rejected at BOTH function
// registration sites - the definition (which also covers a function that is never
// called) and the bodyless PROTOTYPE, which the grammar parses as a plain declaration
// and so never reaches the definition arm. Both named remedies (a struct wrapping the
// array, and a 'T* out' out-parameter) are exercised in test_basic.cb.

expect_error("function 'mk1' cannot return the fixed array 'char[N]' by value") {
    char[8] mk1() { char[8] b = default; return b; }
}

// Multidimensional, non-char element: the same dropped-size path.
expect_error("function 'mk2' cannot return the fixed array 'int[N]' by value") {
    int[2][3] mk2() { int[2][3] b = default; return b; }
}

// An array type ALIAS carries its size on the type, not in the declarator brackets,
// so it reaches the reject through AliasArraySize rather than ArraySize.
using RetBuf = char[8];
expect_error("function 'mk3' cannot return the fixed array 'char[N]' by value") {
    RetBuf mk3() { RetBuf b = default; return b; }
}

// An ARRAY of simd vectors. Before fix/simdptr the simd branch dropped the declarator's
// dimension, so 'ArraySize' was always null here and the guard carried a '!IsSimd' carve-out
// that was harmless only because of that. With the dimension recorded, the carve-out would
// have suppressed exactly this shape and left an unlocated 'ret ptr' verifier dump. The
// message must name 'simd<float,4>[N]' - the TypeName alone is just the lane type 'float'.
expect_error("function 'mk4' cannot return the fixed array 'simd<float,4>[N]' by value") {
    simd<float,4>[2] mk4() { simd<float,4>[2] b = default; return b; }
}

// A bodyless PROTOTYPE is not a functionDefinition at all (the grammar always requires a
// compoundStatement), so it is parsed as a declaration and registered in ParseDeclaration -
// a second, independent site. It reaches the reject through ArraySize, like mk1.
expect_error("function 'extmk1' cannot return the fixed array 'char[N]' by value") {
    extern char[8] extmk1();
}

// The prototype's ALIAS spelling, reaching the ParseDeclaration site through
// AliasArraySize rather than ArraySize (the mk3/extmk1 cross-product).
expect_error("function 'extmk2' cannot return the fixed array 'char[N]' by value") {
    extern RetBuf extmk2();
}

// A BARE simd return is not an array return and must stay legal - it is how every
// simd-producing helper in test_hpc.cb is written.
simd<float,4> mkVec() { simd<float,4> v = 1.0; return v; }

extern int main()
{
    simd<float,4> v = mkVec();
    return v[0] == 1.0 ? 0 : 1;
}
