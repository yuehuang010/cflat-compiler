// Interface dispatch selects the vtable slot by full signature. A call whose argument count
// matches no overload in the set is rejected here - it used to be silently truncated to the
// first same-named slot (surplus args dropped) or to reach LLVM with a wrong arg count.
interface IOvA
{
    int go(int a);
    int go(int a, int b);
};

class OvA : IOvA
{
    int go(int a) { return 100 + a; }
    int go(int a, int b) { return a * b; }
};

interface IOvDefaultAmbiguous
{
    int h(int a);
    int h(int a, int b = 2);
};
class OvDefaultAmbiguous : IOvDefaultAmbiguous
{
    int h(int a) { return a; }
    int h(int a, int b) { return a + b; }
};

interface IHiddenDefaultBase { int h(int a, int b = 13); };
interface IHiddenDefault : IHiddenDefaultBase { int h(int a, int b); };
class HiddenDefaultImpl : IHiddenDefault
{
    int h(int a, int b) { return a + b; }
};

interface IHelperBadType { int h(int* a, int b = 13); };
class HelperBadTypeImpl : IHelperBadType
{
    int h(int* a, int b) { return b; }
};

interface IHelperNamed { int h(int a, int b = 13, int c = 4); };
class HelperNamedImpl : IHelperNamed
{
    int h(int a, int b, int c) { return a + b + c; }
};

struct IOvlBadValue { int value = 0; };
interface IOvlBadNumericInt { int f(int a); };
class OvlBadNumericInt : IOvlBadNumericInt { int f(int a) { return a; } };
interface IOvlBadNumericFloat { int f(float a); };
class OvlBadNumericFloat : IOvlBadNumericFloat { int f(float a) { return 1; } };
interface IOvlBadStruct { int f(int a); };
class OvlBadStruct : IOvlBadStruct { int f(int a) { return a; } };
interface IOvlBadNamed { int g(int x, IOvlBadValue z); };
class OvlBadNamed : IOvlBadNamed { int g(int x, IOvlBadValue z) { return x; } };
interface IOvlBadString { int g(int x, int y); int g(int x, int* z); };
class OvlBadString : IOvlBadString
{
    int g(int x, int y) { return 1; }
    int g(int x, int* z) { return 2; }
};

extern int main()
{
    OvA o;
    IOvA io = o;

    expect_error("no overload of interface method 'IOvA.go' takes 3 argument(s); expected 1 or 2") {
        int tooMany = io.go(1, 2, 3);
    }

    OvDefaultAmbiguous ambiguousImpl = default;
    IOvDefaultAmbiguous ambiguousIface = ambiguousImpl;
    expect_error("ambiguous call to 'IOvDefaultAmbiguous.h'") {
        int ambiguous = ambiguousIface.h(1);
    }

    HiddenDefaultImpl hiddenDefaultImpl = default;
    IHiddenDefault hiddenDefaultIface = hiddenDefaultImpl;
    expect_error("no overload of interface method 'IHiddenDefault.h' takes 1 argument(s); expected 2") {
        int hiddenDefault = hiddenDefaultIface.h(1);
    }

    HelperBadTypeImpl helperBadTypeImpl = default;
    IHelperBadType helperBadTypeIface = helperBadTypeImpl;
    expect_error("cannot pass parameter 'a' of 'IHelperBadType.h'") {
        int badType = helperBadTypeIface.h(5);
    }

    HelperNamedImpl helperNamedImpl = default;
    IHelperNamed helperNamedIface = helperNamedImpl;
    expect_error("no overload of 'IHelperNamed.h' matches") {
        int badNamed = helperNamedIface.h(1, c: 7);
    }
    expect_error("IHelperNamed.h(IHelperNamed, int, int, int)") {
        int badNamed = helperNamedIface.h(1, c: 7);
    }

    OvlBadNumericInt badNumericIntImpl = default;
    IOvlBadNumericInt badNumericIntIface = badNumericIntImpl;
    expect_error("no overload of 'f' matches the given arguments") {
        int badNumericInt = badNumericIntIface.f(1.5);
    }

    OvlBadNumericFloat badNumericFloatImpl = default;
    IOvlBadNumericFloat badNumericFloatIface = badNumericFloatImpl;
    double wideFloat = 0.1;
    expect_error("no overload of 'f' matches the given arguments") {
        int badNumericFloat = badNumericFloatIface.f(wideFloat);
    }

    OvlBadStruct badStructImpl = default;
    IOvlBadStruct badStructIface = badStructImpl;
    IOvlBadValue badStructValue = default;
    expect_error("no overload of 'f' matches the given arguments") {
        int badStruct = badStructIface.f(badStructValue);
    }

    OvlBadNamed badNamedImpl = default;
    IOvlBadNamed badNamedIface = badNamedImpl;
    int badNamedPointer = 0;
    expect_error("no overload of 'g' matches the given arguments") {
        int badNamedArg = badNamedIface.g(z: &badNamedPointer, x: 1);
    }

    OvlBadString badStringImpl = default;
    IOvlBadString badStringIface = badStringImpl;
    expect_error("no overload of 'g' matches the given arguments") {
        int badStringArg = badStringIface.g(1, "str");
    }
    expect_error("no overload of 'g' matches the given arguments") {
        int badNamedStringArg = badStringIface.g(z: "str", x: 1);
    }

    return 0;
}
