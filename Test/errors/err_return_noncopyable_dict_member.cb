// The dictionary twin of err_return_noncopyable_list_member.cb: a `dictionary<K,V>` member whose
// VALUE type owns a `unique` pointer and has no `copy()`. Same ruling, its own wording.
import "dictionary.cb";
struct Inner { int v = 0; };
struct NC { unique Inner* p = nullptr; ~NC() {} };
expect_error("cannot copy this dictionary: its value type owns a 'unique' pointer and has no 'copy()'");
struct RetDictBag
{
    dictionary<int, NC> m;
    dictionary<int, NC> take() { return m; }
};
extern int main() { return 0; }
