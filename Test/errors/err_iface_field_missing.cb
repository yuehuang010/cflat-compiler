// An interface FIELD is a contract: every implementor must declare a field of the
// same name (the vtable carries that implementor's byte offset for it). A class
// that names the interface but omits the field is rejected EAGERLY, at the class
// definition, not at some later boxing site.
import "string.cb";

interface ITitled
{
    int kind();
    string title;
};

expect_error("does not implement interface field 'ITitled::title'") {
    class Untitled : ITitled
    {
        int kind() { return 1; }
    };
}

/*
 * Accessing an interface FIELD on a provably-null receiver has the same hazard as a method call:
 * the field address is data + vtable[slot], so a null vtable faults on the OFFSET LOAD itself,
 * before any field byte is touched. Same proof, same end-of-body resolution; the wording says
 * "member access", not "method call", which is what proves the FIELD record fired rather than the
 * dispatch one. These two legs are here rather than beside the three method legs in
 * err_iface_call_too_few_args.cb because they are a SEPARATE record site: a regression in either
 * site is always observed, since a failed expectation exits the compile and cannot mask a leg in
 * another file. Read comes first, so a write-only regression surfaces on its own.
 */
interface PTagged { int tag; int kind(); };
class PTag : PTagged { int tag = default; int kind() { return 1; } };

expect_error("member access on null interface value 'pv' - 'pv' has not been assigned an implementation since it was last set to null, so 'pv.tag' would resolve its address through a null 'PTagged' vtable") {
    int pvNullFieldRead() { PTagged pv = default; return pv.tag; }
}

// The WRITE form shares the read's lvalue (EmitInterfaceFieldAddress), so this leg exists to pin
// that a store-only use really does reach the record placed on that lvalue.
expect_error("member access on null interface value 'wv' - 'wv' has not been assigned an implementation since it was last set to null, so 'wv.tag' would resolve its address through a null 'PTagged' vtable") {
    void wvNullFieldWrite() { PTagged wv = default; wv.tag = 5; }
}

/*
 * Parenthesising the receiver used to defeat the FIELD proof and only the FIELD proof: the fat
 * value is already loaded into Primary by the time the member name is walked, and the record was
 * gated on emitting the load here and now. The three legs below pin the paren spellings; the
 * validity condition is that each is a NAMED local whose earlier load reads its own slot in the
 * access's own block - which is what makes that load a sound anchor. Companion accept legs live
 * in testNullIfaceDispatchAcceptSet; they assert values, but note there that a build widening the
 * anchor to the access point still passes the whole suite, so they are not tripwires for it.
 */
expect_error("member access on null interface value 'qv' - 'qv' has not been assigned an implementation since it was last set to null, so 'qv.tag' would resolve its address through a null 'PTagged' vtable") {
    int qvNullParenFieldRead() { PTagged qv = default; return (qv).tag; }
}

expect_error("member access on null interface value 'dv' - 'dv' has not been assigned an implementation since it was last set to null, so 'dv.tag' would resolve its address through a null 'PTagged' vtable") {
    int dvNullDoubleParenFieldRead() { PTagged dv = default; return ((dv)).tag; }
}

// The paren WRITE form: same lvalue as the paren read, so it must reject identically.
expect_error("member access on null interface value 'zv' - 'zv' has not been assigned an implementation since it was last set to null, so 'zv.tag' would resolve its address through a null 'PTagged' vtable") {
    void zvNullParenFieldWrite() { PTagged zv = default; (zv).tag = 5; }
}

extern int main()
{
    return 0;
}
