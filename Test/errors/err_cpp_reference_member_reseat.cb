import cpp "cpp_interop_ref_member.h";

/*
 * A C++ reference data member is an ALIAS of its referent (see the C++ reference data members
 * section of Test/test_cpp_interop.cb), so the field cannot be reseated: assigning a pointer to it
 * is a type error, the same as C++ refusing `h.r = &y`. The second leg is the flattened (base-class)
 * field walk, which is a separate collection path. Storing an int through the field is legal.
 */
extern int main()
{
    expect_error("cannot assign 'h.r' of type 'int' from a value of type 'int*'") {
        int x = 5;
        int y = 9;
        cppref.RefHolder h = cppref.RefHolder(&x);
        h.r = &y;
    }

    expect_error("cannot assign 'd.r' of type 'int' from a value of type 'int*'") {
        int x = 5;
        int y = 9;
        cppref.RefDerived d = cppref.RefDerived(&x, 1);
        d.r = &y;
    }

    // A parenthesized left-hand side is the same destination.
    expect_error("cannot assign 'h.r' of type 'int' from a value of type 'int*'") {
        int x = 5;
        int y = 9;
        cppref.RefHolder h = cppref.RefHolder(&x);
        (h.r) = &y;
    }

    return 0;
}
