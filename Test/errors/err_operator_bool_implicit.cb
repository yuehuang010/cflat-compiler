struct NoOperatorBool { int value = 0; };

extern int main()
{
    // A CONVERSION into bool reports the conversion, not the condition wording; the two share
    // one reject site and only the condition leg below may say "condition must be a scalar".
    expect_error("cannot convert 'NoOperatorBool' to 'bool'") {
        NoOperatorBool x = default;
        bool b = x;
    }

    expect_error("condition must be a scalar") {
        NoOperatorBool y = default;
        if (y) { }
    }
    return 0;
}
