// Same two headers as err_cpp_reqscope_macro_leak.cb, imported in the opposite order. Both files
// must reach the same answer: an import statement never changes the translation unit, or the cache
// identity, of a request made for another import.
import cpp "cpp_interop_reqscope_b.h";
import cpp "cpp_interop_reqscope_a.h";

expect_error("Unknown identifier 'leaked'") {
    int reqscope_leak_probe_reversed()
    {
        reqb.BHolder<int> b = default;
        return b.leaked();
    }
}

extern int main()
{
    reqa.AHolder<int> a = default;
    a.set(4);
    reqb.BHolder<int> b = default;
    b.set(38);
    return a.get() + b.get() == 42 ? 0 : 1;
}
