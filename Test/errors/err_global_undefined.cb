// `global::` must resolve to a symbol at the root (file/global) scope. A name that
// exists in no root scope is a clean compile error, not a silent miss or a crash.

namespace N {
    int useUndefined()
    {
        expect_error("Undefined global symbol 'doesNotExist'.");
        return global::doesNotExist(1, 2);
    }
}

// A namespace nested only in the enclosing namespace is not a root namespace: global::GB is undefined.
namespace GA {
    namespace GB { int g() { return 10; } }
    int useNestedAsRoot()
    {
        expect_error("Undefined global symbol 'GB'.");
        return global::GB.g();
    }
}

namespace QoFallbackTarget { int missing() { return 90; } }
namespace QoFallbackOwner {
    namespace QoFallbackTarget { int other() { return 10; } }
    int rejectMissingMember()
    {
        expect_error("'missing' is not a member of namespace 'QoFallbackOwner.QoFallbackTarget'");
        return QoFallbackTarget.missing();
    }
}

extern int main() { return N.useUndefined() + GA.useNestedAsRoot(); }
