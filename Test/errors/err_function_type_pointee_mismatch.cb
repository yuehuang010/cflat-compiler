import "c_fnabi2_long.h";

int t427FromVoid(void* p) { return 41; }
int t427FromChar(char* p) { return 42; }
int t427FromConstVoid(const void* p) { return 43; }
int t427FromConstChar(const char* p) { return 44; }
void t427FromVoidForInt(void* p) { }
int t427PickChar(function<int(char*)> f) { return 1; }
int t427PickConstChar(function<int((const char)*)> f) { return 2; }
int t427Generic<T>(function<int(T)> f, T p) { return 3; }
void* t427FromVoidReturn() { return nullptr; }
int t427PickCharReturn(function<char*()> f) { return 4; }
int t427FromChar2(char** p) { return 5; }
int t427FromInt2(int** p) { return 6; }
int t427PickVoid2(function<int(void**)> f) { return 7; }
using T427VoidCallback = function<int(void*)>;
struct T427Holder { function<int(char*)> callback; };

expect_error("function-pointer signature mismatch") {
    void t427ValueArgument() {
        function<int(void*)> value = t427FromVoid;
        t427PickChar(value);
    }
}

expect_error("function-pointer signature mismatch") {
    void t427AliasArgument() {
        T427VoidCallback value = t427FromVoid;
        t427PickChar(value);
    }
}

expect_error("no overload of 't427PickChar' matches the given arguments") {
    void t427NamedArgument() { t427PickChar(t427FromVoid); }
}

expect_error("no overload of 't427PickChar' matches the given arguments") {
    void t427AddressArgument() { t427PickChar(&t427FromVoid); }
}

expect_error("no overload of 't427PickChar' matches the given arguments") {
    void t427LambdaArgument() { t427PickChar((void* p) => 1); }
}

expect_error("no overload of 't427PickConstChar' matches the given arguments") {
    void t427ConstPointeeArgument() {
        function<int((const void)*)> value = t427FromConstVoid;
        t427PickConstChar(value);
    }
}

expect_error("cannot bind function 't427FromVoid'") {
    void t427DeclarationInit() { function<int(char*)> value = t427FromVoid; }
}

expect_error("cannot bind function 't427FromVoid'") {
    void t427Assignment() {
        function<int(char*)> value = t427FromChar;
        value = t427FromVoid;
    }
}

expect_error("cannot bind function 't427FromVoid'") {
    function<int(char*)> t427BadReturn() { return t427FromVoid; }
}

expect_error("different signatures") {
    void t427TernaryJoin(bool choose) {
        function<int(void*)> wide = t427FromVoid;
        function<int(char*)> narrow = t427FromChar;
        function<int(char*)> joined = choose ? wide : narrow;
    }
}

expect_error("cannot bind function 't427FromVoid'") {
    void t427StructFieldStore() {
        T427Holder holder;
        holder.callback = t427FromVoid;
    }
}

expect_error("cannot bind function 't427FromVoidForInt'") {
    void t427VoidToIntPointerSignature() {
        function<void(int*)> callback = t427FromVoidForInt;
    }
}

expect_error("no overload of 't427Generic<char*>' matches the given arguments") {
    void t427GenericArgument() {
        function<int(void*)> value = t427FromVoid;
        t427Generic<char*>(value, nullptr);
    }
}

expect_error("no overload of 't427PickCharReturn' matches the given arguments") {
    void t427ReturnComponentArgument() {
        function<void*()> value = t427FromVoidReturn;
        t427PickCharReturn(value);
    }
}

expect_error("no overload of 't427PickVoid2' matches the given arguments") {
    void t427NestedCharPointer() {
        function<int(char**)> value = t427FromChar2;
        t427PickVoid2(value);
    }
}

expect_error("no overload of 't427PickVoid2' matches the given arguments") {
    void t427NestedIntPointer() {
        function<int(int**)> value = t427FromInt2;
        t427PickVoid2(value);
    }
}

int t500FromChar(char* p) { return 51; }
int t500TakesCharCallback(function<int(char*)> cb) { return 52; }
function<int(char*)> t500ReturnsCharCallback(int n) { return t500FromChar; }
int t500GenericNested<T>(function<int(T)> cb, T value) { return 53; }

expect_error("cannot bind function 't500TakesCharCallback'") {
    void t500NestedVoidPointerMismatch() {
        function<int(function<int(void*)>)> value = t500TakesCharCallback;
    }
}

expect_error("cannot bind function 't500TakesCharCallback'") {
    void t500NestedIntPointerMismatch() {
        function<int(function<int(int*)>)> value = t500TakesCharCallback;
    }
}

expect_error("cannot bind function 't500ReturnsCharCallback'") {
    void t500NestedReturnMismatch() {
        function<function<int(void*)>(int)> value = t500ReturnsCharCallback;
    }
}

expect_error("cannot bind function 't500GenericNested") {
    void t500GenericNestedMismatch() {
        function<int(function<int(function<int(function<int(char*)>)>)>, function<int(function<int(char*)>)>)> value =
            t500GenericNested<function<int(function<int(void*)>)>>;
    }
}

int t500TakesFunctionCallback(function<int(char*)> cb) { return cb(nullptr); }
int t500TakesLambdaCallback(Lambda<int(char*)> cb) { return cb(nullptr); }

expect_error("cannot bind function 't500TakesFunctionCallback' to function-pointer type") {
    void t500FunctionToLambdaSignatureMismatch() {
        function<int(Lambda<int(char*)>)> value = t500TakesFunctionCallback;
    }
}

expect_error("cannot bind function 't500TakesLambdaCallback' to function-pointer type") {
    void t500LambdaToFunctionSignatureMismatch() {
        function<int(function<int(char*)>)> value = t500TakesLambdaCallback;
    }
}

Lambda<int(double)> t512Wide;
Lambda<int(double)> t512GetWide() { return t512Wide; }
int t512AddOne(int x) { return x + 1; }
function<int(int)> t512GetThin() { return t512AddOne; }
T t512RoundTrip<T>(T get) { return get; }
T t512ReturnWide<T>() { return t512GetWide; }
T t512ReturnThin<T>() { return t512GetThin; }

extern int main()
{
    // Explicit generic callback arguments must check a named function's nested return signature.
    expect_error("cannot bind function 't512GetWide'") {
        function<Lambda<int(int)>()> slot =
            t512RoundTrip<function<Lambda<int(int)>()>>(t512GetWide);
    }
    expect_error("cannot bind function 't512GetThin'") {
        function<Lambda<int(int)>()> slot =
            t512RoundTrip<function<Lambda<int(int)>()>>(t512GetThin);
    }
    expect_error("cannot bind function 't512GetWide'") {
        function<Lambda<int(int)>()> slot =
            t512ReturnWide<function<Lambda<int(int)>()>>();
    }
    expect_error("cannot bind function 't512GetThin'") {
        function<Lambda<int(int)>()> slot =
            t512ReturnThin<function<Lambda<int(int)>()>>();
    }
    return 0;
}

int t500TakesThinCallback(function<int(int)> cb) { return cb(5); }
expect_error("cannot carry captured state") {
    void t500CapturingLambdaThroughThinNestedSlot() {
        int k = 3;
        function<int(function<int(int)>)> slot = t500TakesThinCallback;
        int r = slot((int x) => x + k);
    }
}

expect_error("cannot bind function 't512GetWide'") {
    void t512WideClosureReturnDeclaration() {
        function<Lambda<int(int)>()> slot = t512GetWide;
    }
}
expect_error("cannot bind function 't512GetThin'") {
    void t512ThinReturnDeclaration() {
        function<Lambda<int(int)>()> slot = t512GetThin;
    }
}
expect_error("cannot bind function 't512GetWide'") {
    void t512WideClosureReturnAssignment() {
        function<Lambda<int(int)>()> slot;
        slot = t512GetWide;
    }
}
expect_error("cannot bind function 't512GetThin'") {
    void t512ThinReturnAssignment() {
        function<Lambda<int(int)>()> slot;
        slot = t512GetThin;
    }
}
expect_error("cannot bind function 't512GetWide'") {
    struct T512WideClosureReturnField { function<Lambda<int(int)>()> get = t512GetWide; };
}
expect_error("cannot bind function 't512GetThin'") {
    struct T512ThinReturnField { function<Lambda<int(int)>()> get = t512GetThin; };
}

expect_error("cannot pass argument of type 'int' to parameter of type 'FnvbErrorBox*' through a function value") {
    struct FnvbErrorBox { int value = default; };
    int fnvbErrorRead(FnvbErrorBox* box) { return box->value; }
    int fnvbErrorCall() { function<int(FnvbErrorBox*)> fn = fnvbErrorRead; return fn(5); }
}

expect_error("cannot pass the address of a stack or global value to 'move' parameter") {
    struct FnvbMoveErrorBox { int value = default; };
    int fnvbMoveErrorTarget(move FnvbMoveErrorBox* p) { return 23; }
    void fnvbMoveErrorCall() {
        FnvbMoveErrorBox b = default;
        function<int(move FnvbMoveErrorBox*)> fn = fnvbMoveErrorTarget;
        fn(b);
    }
}

expect_error("cannot pass parameter 'p' of 'fnvbScalarErrorTarget' of type 'int*' from a value of type 'int'") {
    int fnvbScalarErrorTarget(int* p) { return *p; }
    void fnvbScalarErrorCall() {
        int v = 12;
        function<int(int*)> fn = fnvbScalarErrorTarget;
        fn(v);
    }
}

expect_error("cannot pass parameter 'p' of 'fnvbScalarFieldErrorTarget' of type 'int*' from a value of type 'int'") {
    struct FnvbScalarFieldErrorOwner { int y = default; };
    int fnvbScalarFieldErrorTarget(int* p) { return *p; }
    void fnvbScalarFieldErrorCall() {
        FnvbScalarFieldErrorOwner o = default;
        o.y = 12;
        function<int(int*)> fn = fnvbScalarFieldErrorTarget;
        fn(o.y);
    }
}

// LP64 long and i64 are both 64-bit, but remain distinct pointee type identities.
void fnabiFromLong(long* p) { }
void fnabiFromI64(i64* p) { }
expect_error("cannot bind function 'fnabiFromLong'") {
    void fnabiLongI64Binding() { function<void(i64*)> slot = fnabiFromLong; }
}
extern int fnabiExternLong(long* p);
expect_error("cannot bind function 'fnabiExternLong'") {
    void fnabiLongI64ExternBinding() { function<int(i64*)> slot = fnabiExternLong; }
}
expect_error("cannot bind function 'fnabiFromLong'") {
    void fnabiLongI64Assignment() {
        function<void(i64*)> slot = fnabiFromI64;
        slot = fnabiFromLong;
    }
}
int fnabiTakeI64(function<int(i64*)> cb) { return cb(nullptr); }
int fnabiCallFromLong(long* p) { return 1; }
expect_error("no overload of 'fnabiTakeI64' matches the given arguments") {
    void fnabiLongI64CallArgument() { fnabiTakeI64(fnabiCallFromLong); }
}
i64* fnabiReturnI64() { return nullptr; }
long* fnabiReturnLong() { return nullptr; }
expect_error("cannot bind function 'fnabiReturnLong'") {
    void fnabiLongI64Return() { function<i64*()> slot = fnabiReturnLong; }
}

int fnabiInnerI64(i64* p) { return 1; }
int fnabiNestedFromLong(function<int(long*)> cb) { return cb(nullptr); }
int fnabiNestedFromI64(function<int(i64*)> cb) { return cb(nullptr); }
expect_error("cannot bind function 'fnabiNestedFromLong'") {
    void fnabiNestedLongI64Binding() {
        function<int(function<int(i64*)>)> slot = fnabiNestedFromLong;
    }
}
expect_error("cannot bind function 'fnabiNestedFromLong'") {
    void fnabiNestedLongI64Assignment() {
        function<int(function<int(i64*)>)> slot = fnabiNestedFromI64;
        slot = fnabiNestedFromLong;
    }
}
int fnabiTakeLongCallback(function<int(long*)> cb) { return cb(nullptr); }
expect_error("no overload of 'fnabiTakeLongCallback' matches the given arguments") {
    void fnabiNestedLongI64CallArgument() { fnabiTakeLongCallback(fnabiInnerI64); }
}

// A plain C header keeps native-long identity inside the function-pointer signature.
expect_error("cannot bind function 'fnabi2_c_take_long'") {
    void fnabi2CFunctionLongI64Binding() {
        function<int(i64*)> slot = fnabi2_c_take_long;
    }
}

int fnabi2FromI64(i64* p) { return 1; }
expect_error("cannot bind function 'fnabi2FromI64'") {
    void fnabi2CCallbackLongI64Assignment() {
        Fnabi2LongCallback slot = fnabi2FromI64;
    }
}
