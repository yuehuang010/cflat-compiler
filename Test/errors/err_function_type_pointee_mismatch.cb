Lambda<int(long)> t512Wide;
Lambda<int(long)> t512GetWide() { return t512Wide; }
int t512AddOne(int x) { return x + 1; }
function<int(int)> t512GetThin() { return t512AddOne; }
T t512RoundTrip<T>(T get) { return get; }
T t512ReturnWide<T>() { return t512GetWide; }
T t512ReturnThin<T>() { return t512GetThin; }

extern int main()
{
    // Explicit generic callback arguments must check a named function's nested return signature.
    expect_error("cannot bind function 't512GetWide'") {
        function<Lambda<int(int)>()> slot =
            t512RoundTrip<function<Lambda<int(int)>()>>(t512GetWide);
    }
    expect_error("cannot bind function 't512GetThin'") {
        function<Lambda<int(int)>()> slot =
            t512RoundTrip<function<Lambda<int(int)>()>>(t512GetThin);
    }
    expect_error("cannot bind function 't512GetWide'") {
        function<Lambda<int(int)>()> slot =
            t512ReturnWide<function<Lambda<int(int)>()>>();
    }
    expect_error("cannot bind function 't512GetThin'") {
        function<Lambda<int(int)>()> slot =
            t512ReturnThin<function<Lambda<int(int)>()>>();
    }
    return 0;
}

int t500TakesThinCallback(function<int(int)> cb) { return cb(5); }
expect_error("cannot carry captured state") {
    void t500CapturingLambdaThroughThinNestedSlot() {
        int k = 3;
        function<int(function<int(int)>)> slot = t500TakesThinCallback;
        int r = slot((int x) => x + k);
    }
}

