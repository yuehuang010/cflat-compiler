// Two namespaces each declare an identical generic 'interface IV<T>'. Post-fix, generic
// interface templates are keyed on their qualified name (HA.IV / HB.IV), so a BARE 'IV<T>'
// spelling at file scope names no template at all - not even a collapsed one. Pre-fix, both
// templates collapsed onto the bare key 'IV' and this compiled silently (printing width=32),
// with no diagnostic distinguishing the two. See internal/issue/generic-template-namespace-key-space.md.
namespace HA { interface IV<T> { int Width(); }; }
namespace HB { interface IV<T> { int Width(); }; }
class HC1<T> : IV<T> { int Width() { return 32; } };

expect_error("Unknown identifier 'Width'.");
int useH1(IV<int> v) { return v.Width(); }

extern int main()
{
    return 0;
}
