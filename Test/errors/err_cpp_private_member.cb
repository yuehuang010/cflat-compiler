// A private field of an imported C++ class is laid out (the record's size depends on it) but must
// not be nameable from CFlat. The diagnostic says "is private", not "has no field named".
import cpp "cpp_interop_basic.h";

extern int main()
{
    expect_error("field 'hidden_' of C++ class 'cppi.Point' is private") {
        cppi.Point p = default;
        int leak = p.hidden_;
    }
    // A PRIVATE base that is a class-template specialization. The invertible-mangling ruling
    // requires every user-facing surface to demangle: before the fix this printed the internal
    // 'cppi.BaseBox$int*', so the expectation below is what discriminates the two binaries.
    expect_error("cannot convert 'cppi.PrivBoxDerived*' to 'cppi.BaseBox<int>*' for variable 'sneak': 'cppi.BaseBox<int>' is not a PUBLIC base of 'cppi.PrivBoxDerived'") {
        cppi.PrivBoxDerived priv = default;
        cppi.BaseBox<int>* sneak = &priv;
    }
    expect_error("member 'K' of C++ class 'cppi_inh.StaticPrivateDerived' is private") {
        cppi_inh.StaticPrivateDerived.K();
    }
    expect_error("member 'K' of C++ class 'cppi_inh.StaticProtectedDerived' is protected") {
        cppi_inh.StaticProtectedDerived.K();
    }
    // A PUBLIC member of a private/protected base: found, but inaccessible through that base.
    expect_error("member 'K' of C++ class 'cppi_inh.StaticViaPrivateBase' is inaccessible: 'cppi_inh.StaticGrand' is a private base of 'cppi_inh.StaticViaPrivateBase'") {
        cppi_inh.StaticViaPrivateBase.K();
    }
    expect_error("member 'K' of C++ class 'cppi_inh.StaticViaProtectedBase' is inaccessible: 'cppi_inh.StaticGrand' is a protected base of 'cppi_inh.StaticViaProtectedBase'") {
        cppi_inh.StaticViaProtectedBase.K();
    }
    expect_error("member 'K' of C++ class 'cppi_inh.DataViaPrivateBase' is inaccessible: 'cppi_inh.DataGrand' is a private base of 'cppi_inh.DataViaPrivateBase'") {
        int leak = cppi_inh.DataViaPrivateBase.K;
    }
    return 0;
}
