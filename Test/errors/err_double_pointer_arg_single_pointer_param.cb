// A 'T**' argument must not bind a 'T*' parameter. Before the fix the overload scorer
// (TypeAndValue::IsTypeMatch) gated on the BOOLEAN Pointer and never on indirection depth, so
// the call compiled, linked and ran, reading the low bytes of the heap address as the pointee.
// No verifier complaint: under opaque pointers 'ptr' and 'ptr' are the same LLVM type.
//
// Both sides must be PROVEN. ElemPointer is recorded only by source parsing and C interop, so its
// absence means "depth not recorded", never "depth 1"; the positive TypeAndValue::PointerDepth is
// the other half of the proof, and is what makes an inline '&' refusable here. The accept set
// (void*, array-of-pointer slots, generic type arguments) is frozen as value legs in
// Test/test_basic.cb ("pd_*"); the mirror direction lives in
// err_single_pointer_arg_double_pointer_param.cb.

class DpCircle { int r = 0; };

int dpByPtr(DpCircle* c) { return 2000 + c->r; }

class DpBox { int take(DpCircle* c) { return 2000 + c->r; } };

class DpWrap { DpCircle* c = nullptr; DpWrap(DpCircle* p) { c = p; } };

class DpHolder { DpCircle** pp = nullptr; };

DpCircle** dpForward(DpCircle** s) { return s; }

// A generic type ARGUMENT carries its stars as a real depth, so DpGBox<DpCircle*> and
// DpGBox<DpCircle**> are distinct instantiations and each substituted 'T x' is judgeable.
class DpGBox<T> { T v = default; int put(T x) { v = x; return 1; } T get() { return v; } };

// The type-argument spelling COUNTS stars now, so it joins the 3-star cap like every other
// spelling that does. It used to collapse to DpGBox<DpCircle*> and compile.
expect_error("generic type argument 'DpCircle***' produces pointer depth 3, but the type model caps at 2 levels") {
    DpGBox<DpCircle***> dpTripleArg = default;
}

// The 3-star cap applies to every spelling that counts WRITTEN stars, not only a local
// declarator: a parameter, a struct field, a function-type signature component and a `using`
// alias RHS. The declarator spellings share one guard at the head of ParseDeclarationSpecifiers;
// the function-type parameter has its own, because its stars ride the signature, not a declarator.
expect_error("declared type 'DpCircle' produces pointer depth 3, but the type model caps at 2 levels") {
    int dpTriple(DpCircle*** c) { return 0; }
}
expect_error("declared type 'DpCircle' produces pointer depth 3, but the type model caps at 2 levels") {
    class DpTripleHolder { DpCircle*** ppp = nullptr; };
}
expect_error("declared type 'DpCircle' produces pointer depth 3, but the type model caps at 2 levels") {
    DpCircle*** dpTripleRet() { return nullptr; }
}
expect_error("function type parameter 'DpCircle' produces pointer depth 3, but the type model caps at 2 levels") {
    int dpTakesFn(function<int(DpCircle***)> f) { return 0; }
}
// An ALIAS reaching the same depth was already refused at its USE site; it now shares the one
// message family, and the alias DECLARATION is refused too rather than only a use that may
// never be written.
expect_error("using alias 'DpCP3' = 'DpCircle' produces pointer depth 3, but the type model caps at 2 levels") {
    using DpCP3 = DpCircle***;
}

extern int main()
{
    // Declared 'T**' local: the filed repro. The depth note names both types and both remedies.
    expect_error("parameter 0 'c' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        int r = dpByPtr(pp);
    }

    // A 'T**' RETURN value carries the same depth as a declared local.
    expect_error("parameter 0 'c' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        int r = dpByPtr(dpForward(pp));
    }

    // A 'T**' FIELD read: the depth rides the field type, not the declaration statement.
    expect_error("parameter 0 'c' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        DpHolder h = default;
        h.pp = &a;
        int r = dpByPtr(h.pp);
    }

    // 'T***' is no longer a spellable type at all: the declarator is refused where it is WRITTEN,
    // before any call scores. That closes the old residue where 'T***' into 'T**' was invisible
    // (the clamped declarator was byte-identical to a correct 'T**' argument).
    expect_error("declared type 'DpCircle' produces pointer depth 3, but the type model caps at 2 levels") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        DpCircle*** ppp = &pp;
        int r = dpByPtr(ppp);
    }

    // A CAST spelling counts the same written stars, so it is refused at the cast.
    expect_error("declared type 'DpCircle' produces pointer depth 3, but the type model caps at 2 levels") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        DpCircle*** ppp = (DpCircle***)pp;
    }

    // FOUR stars report the real written depth, not a clamped 3.
    expect_error("declared type 'DpCircle' produces pointer depth 4, but the type model caps at 2 levels") {
        DpCircle**** q = nullptr;
    }

    // A METHOD call scores through the same scorer, with 'this' occupying parameter 0 - so the
    // note must name parameter 1 here. Pins that the index is the PARAMETER index, not the
    // user-visible argument index.
    expect_error("parameter 1 'c' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        DpBox b = default;
        int r = b.take(pp);
    }

    // A CONSTRUCTOR call resolves through the same overload set.
    expect_error("parameter 0 'p' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        DpWrap w = DpWrap(pp);
    }

    // A 'T**' into a substituted 'T' parameter of the DEPTH-1 instantiation. While a type
    // argument's stars collapsed to one bool the parameter looked like a proven 'DpCircle*'
    // either way, so the gate had to decline on it and this compiled.
    expect_error("parameter 1 'x' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        DpGBox<DpCircle*> thin = default;
        int r = thin.put(pp);
    }

    // A value flowing OUT of the depth-2 instantiation is a proven 'DpCircle**' at the call site.
    expect_error("parameter 0 'c' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        DpCircle** pp = &a;
        DpGBox<DpCircle**> deep = default;
        deep.put(pp);
        int r = dpByPtr(deep.get());
    }

    // An inline '&' over a RECORDED depth-1 value now proves depth 2, so it is refused here too.
    // Before PointerDepth existed the address-of result recorded no depth and bound silently.
    expect_error("parameter 0 'c' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle* a = new DpCircle();
        int r = dpByPtr(&a);
    }

    // Same through a fixed array's SLOT address: the element's depth is recorded, so '&' over it
    // is a proven 'T**'. The ARRAY itself still proves nothing (Test/test_basic.cb "pd_*").
    expect_error("parameter 0 'c' has type 'DpCircle*' and the argument has type 'DpCircle**'") {
        DpCircle*[2] arr = default;
        arr[0] = new DpCircle();
        int r = dpByPtr(&arr[0]);
    }

    return 0;
}
