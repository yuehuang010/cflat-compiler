// std::unique_ptr has a deleted copy constructor and must not silently copy an owner.
import cpp "cpp_interop_basic.h";
import cpp "memory" cache;
import "list.cb";

expect_error("cannot copy C++ class 'std.unique_ptr$cppi.Tracked' into construct_at storage") {
    int list_unique_copy_error()
    {
        list<std.unique_ptr<cppi.Tracked>> values = default;
        std.unique_ptr<cppi.Tracked> value = cppi.make_tracked_ptr(2);
        values.add(value);
        return 0;
    }
}

extern int main()
{
    expect_error("its copy constructor is deleted") {
        std.unique_ptr<cppi.Tracked> a = cppi.make_tracked_ptr(1);
        std.unique_ptr<cppi.Tracked> b = a;
    }
    return 0;
}
