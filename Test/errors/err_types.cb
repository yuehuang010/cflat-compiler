// Type errors: unknown types, identifiers, fields, is/as casts

import "function.cb";

interface IShape { int Area(); };
class Circle : IShape
{
    int radius = 0;
    int Area() { return radius * radius; }
};

struct Foo
{
    int x = 0;
};

expect_error("unknown type") {
    int test_unknown_type()
    {
        Blorf x;
        return 0;
    }
}

expect_error("Undefined variable foo.") {
    int test_unknown_identifier()
    {
        int x = foo + 1;
        return x;
    }
}

expect_error("Unknown identifier") {
    int test_unknown_field()
    {
        Foo f;
        int y = f.bogusField;
        return 0;
    }
}

expect_error("is not a known struct type for 'is' check") {
    int test_is_unknown_type()
    {
        Circle c;
        c.radius = 5;
        IShape shape = c;
        bool b = shape is GhostType;
        return 0;
    }
}

expect_error("is not a known struct or interface type for 'as' cast") {
    int test_as_unknown_type()
    {
        Circle c;
        c.radius = 5;
        IShape shape = c;
        Circle* gp = shape as GhostType;
        return 0;
    }
}

// sizeof over a generic INSTANTIATION is not resolved (alignof is - see
// p2/sizeof-over-generic-instantiation-unresolved-while-alignof-resolves). All
// three spellings below used to SIGSEGV the compiler with no diagnostic at all.
struct SizeofBox<T> { T item = default; };
struct SizeofPair<A, B> { A a = default; B b = default; };

expect_error("interface method 'Q13TypeInterface.get' cannot return a fixed-size array") {
    interface Q13TypeInterface { char[8] get(); };
}
expect_error("member 'get' cannot return the fixed array 'char[N]' by value") {
    struct Q13TypeStruct { char[8] get(); };
}
expect_error("member 'get' cannot return the fixed array 'u16[N]' by value") {
    struct Q13MultiWordStruct { unsigned short[8] get(); };
}
expect_error("member 'get' cannot return the fixed array 'u16[N]' by value") {
    class Q13MultiWordClass { unsigned short[8] get(); };
}

interface Q12ArrayViewInterface { int f(); };
struct Q12UniqueArrayViewBox<T> { T value = default; };
expect_error("array views are not supported") {
    Q12UniqueArrayViewBox<unique Q12ArrayViewInterface[]> bad = default;
}

int test_sizeof_thin_closure_arg()
{
    return (int)sizeof(SizeofBox<function<int(int)>>) == 8 ? 0 : 1;
}

int test_sizeof_fat_closure_arg()
{
    return (int)sizeof(SizeofBox<Lambda<int(int)>>) == 16 ? 0 : 1;
}

int test_sizeof_two_type_args()
{
    return (int)sizeof(SizeofPair<int, float>) == 8 ? 0 : 1;
}

expect_error("unknown type 'TDScopeBlockTypedef'") {
    int blockTypedefDoesNotEscape() {
        { typedef double TDScopeBlockTypedef; }
        TDScopeBlockTypedef value = 1;
        return 0;
    }
}

expect_error("unknown type 'TDScopeBlockUsing'") {
    int blockUsingDoesNotEscape() {
        { using TDScopeBlockUsing = double; }
        TDScopeBlockUsing value = 1;
        return 0;
    }
}

expect_error("unknown type 'TDScopeLocalBox'") {
    struct TDScopeErrorBox<T> { T value = default; };
    int genericAliasDoesNotEscape() {
        {
            using TDScopeLocalBox = TDScopeErrorBox<int>;
            TDScopeLocalBox value = default;
        }
        TDScopeLocalBox value = default;
        return 0;
    }
}

// A plain nested block's alias does not reach a later generic argument (ruled 2026-11-04).
expect_error("unknown type 'TDScopeArgAlias'") {
    struct TDScopeArgBox<T> { T value = default; };
    int blockAliasGenericArgDoesNotEscape() {
        { using TDScopeArgAlias = double; }
        TDScopeArgBox<TDScopeArgAlias> b = default;
        return 0;
    }
}

// The unknown argument is diagnosed even when its generic template is defined later.
int blockAliasGenericArgBeforeTemplateDoesNotEscape() {
    { using TDScopeForwardArgAlias = double; }
    expect_error("unknown type 'TDScopeForwardArgAlias'");
    TDScopeForwardArgBox<TDScopeForwardArgAlias> b = default;
    return 0;
}
struct TDScopeForwardArgBox<T> { T value = default; };

// Nested arguments also report their unresolved leaf before a later template layout is used.
int blockAliasNestedGenericArgBeforeTemplateDoesNotEscape() {
    { using TDScopeNestedForwardAlias = double; }
    expect_error("unknown type 'TDScopeNestedForwardAlias'");
    TDScopeNestedForwardOuter<TDScopeNestedForwardInner<TDScopeNestedForwardAlias>> b = default;
    return 0;
}
struct TDScopeNestedForwardInner<T> { T value = default; };
struct TDScopeNestedForwardOuter<T> { T value = default; };

// A discarded tuple-of-comparisons is read as a TYPE by 'sizeof'; the message must quote
// what was written, not the mangled name the type lookup built from it.
extern int main()
{
    int a = 1;
    int b = 2;
    int c = 3;
    int d = 4;
    expect_error("'a<b,c>d' is not a type name") {
        i64 z = sizeof(a<b,c>d);
    }
    return 0;
}
