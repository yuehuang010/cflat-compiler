// Global character-array literal initialization is supported and value-tested in test_basic.cb.

// A non-literal expression on a global fixed array reaches the same bad initializer.
char[8] gSrc = default;
expect_error("cannot initialize global fixed array 'char[8] gCopy' from this expression") {
    char[8] gCopy = gSrc;
}

extern int main()
{
    return 0;
}
