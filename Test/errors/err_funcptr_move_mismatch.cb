// Assigning a borrow-typed function to a `function<R(move T*)>` is rejected:
// the 'move' modifier is part of the function-pointer type and must agree.

expect_error("'move' modifiers of function pointer signature") {
    void borrow_int_ptr(int* p) { }

    void test_assign() {
        function<void(move int*)> fp = borrow_int_ptr;
    }
}

// An INFERRED owning sink cannot ride a closure VALUE, so every crossing into a declared closure
// type that does not spell `move` is rejected with the required spelling. All five double-freed
// (rc 134) before the `Lambda<void(move T)>` spelling existed.
struct FmmRes { int id = 0; ~FmmRes() { } };
struct FmmBox { unique FmmRes* item = nullptr; };

expect_error("but parameter 'g' of 'fmmCall' does not spell it") {
    void fmmCall(Lambda<void(FmmBox)> g, move FmmBox x) { g(x); }
    void fmmArg() {
        FmmBox a;
        fmmCall((FmmBox p) => { FmmBox[2] d = { p }; }, a);
    }
}

expect_error("Lambda<void(move FmmBox)>") {
    void fmmCall2(Lambda<void(FmmBox)> g, move FmmBox x) { g(x); }
    void fmmNamedThenArg() {
        FmmBox a;
        Lambda<void(FmmBox)> f = (FmmBox p) => { FmmBox[2] d = { p }; };
        fmmCall2(f, a);
    }
}

expect_error("does not spell it") {
    void fmmCallG<T>(Lambda<void(T)> g, move T x) { g(x); }
    void fmmGeneric() {
        FmmBox a;
        fmmCallG<FmmBox>((FmmBox p) => { FmmBox[2] d = { p }; }, a);
    }
}

expect_error("the declared return type does not spell it") {
    Lambda<void(FmmBox)> fmmMake() { return (FmmBox p) => { FmmBox[2] d = { p }; }; }
}

expect_error("but 'h.f' does not spell it") {
    struct FmmHolder { Lambda<void(FmmBox)> f = default; };
    void fmmField() {
        FmmHolder h;
        h.f = (FmmBox p) => { FmmBox[2] d = { p }; };
    }
}

// The thin `function<>` family rejects the same three crossings as the fat `Lambda<>` one, and
// names its own spelling. The FIELD door needed the guard OUTSIDE the fat-struct gate: a thin
// destination holds a bare code pointer, so its value is not a struct (rc 134 before).
expect_error("function<void(move FmmBox)>") {
    void fmmCallF(function<void(FmmBox)> g, move FmmBox x) { g(x); }
    void fmmFnArg() {
        FmmBox a;
        fmmCallF((FmmBox p) => { FmmBox[2] d = { p }; }, a);
    }
}

expect_error("the declared return type does not spell it") {
    function<void(FmmBox)> fmmMakeF() { return (FmmBox p) => { FmmBox[2] d = { p }; }; }
}

expect_error("but 'hf.f' does not spell it") {
    struct FmmHolderF { function<void(FmmBox)> f = nullptr; };
    void fmmFnField() {
        FmmHolderF hf;
        hf.f = (FmmBox p) => { FmmBox[2] d = { p }; };
    }
}

// An inferred sink of a COPYABLE owner does NOT consume (its store is a copy), so it must NOT
// satisfy a declared `move`: the caller would transfer a value the literal never took and leak it.
// Accepting this was measured as made=2 dtor=1 - the original never freed.
struct FmmCopyable
{
    unique FmmRes* p = nullptr;
    FmmCopyable copy() { FmmCopyable r; r.p = new FmmRes(); return r; }
};

expect_error("differs in 'move' modifier") {
    void fmmCopyableSink() {
        Lambda<void(move FmmCopyable)> f =
            (FmmCopyable p) => { FmmCopyable[2] d = { p }; };
    }
}

// A `move` source assigned through a DEREF destination TRANSFERS (cflat move = zero the source),
// so reading it afterwards is a use-after-move. Pre-fix the deref arm copied instead and left the
// source live, so this compiled and printed the payload from both.
expect_error("use of moved variable 'p'") {
    struct FmmVal { string s = ""; };
    void fmmDerefMove(move FmmVal p, FmmVal* out) { *out = p; printf("%s", p.s.data()); }
}

// A named function passed to a thin function<> call parameter must use the same move check as a
// function-pointer declarator. The pre-fix argument path only checked this for fat Lambda<> slots.
expect_error("has no overload matching the 'move' modifiers required by parameter") {
    void t208MoveParam(move int* p) { delete p; }
    void t208AcceptBorrow(function<void(int*)> f) { }
    void t208CallBare() { t208AcceptBorrow(t208MoveParam); }
}

expect_error("has no overload matching the 'move' modifiers required by parameter") {
    void t208MoveGeneric<T>(move T* p) { delete p; }
    void t208AcceptGeneric(function<void(int*)> f) { }
    void t208CallGeneric() { t208AcceptGeneric(t208MoveGeneric<int>); }
}

expect_error("has no overload matching the 'move' modifiers required by parameter") {
    namespace T208MoveNs { void consume(move int* p) { delete p; } }
    void t208AcceptNamespace(function<void(int*)> f) { }
    void t208CallNamespace() { t208AcceptNamespace(T208MoveNs.consume); }
}

// A move-returning function has a hidden raw-array-count slot. Passing it to a borrowed return
// slot made the callback call omit that slot and crash in the JIT.
expect_error("returns an owning 'move' pointer but the slot's return is borrowed") {
    move int* t208MoveReturn(int x) { int* p = new int(x); return p; }
    void t208AcceptReturn(function<int*(int)> f) { int* p = f(1); delete p; }
    void t208CallReturn() { t208AcceptReturn(t208MoveReturn); }
}

expect_error("returns an owning 'move' pointer but the slot's return is borrowed") {
    move int* t208MoveReturnGeneric<T>(T x) { int* p = new int((int)x); return p; }
    void t208AcceptReturnGeneric(function<int*(int)> f) { int* p = f(1); delete p; }
    void t208CallReturnGeneric() { t208AcceptReturnGeneric(t208MoveReturnGeneric<int>); }
}

expect_error("returns an owning 'move' pointer but the slot's return is borrowed") {
    namespace T208ReturnNs { move int* make(int x) { int* p = new int(x); return p; } }
    void t208AcceptReturnNs(function<int*(int)> f) { int* p = f(1); delete p; }
    void t208CallReturnNs() { t208AcceptReturnNs(T208ReturnNs.make); }
}

// T287: a declarator adopts the owning return of a named function, so the VARIABLE carries it, and the
// call-argument check refuses it at a borrowed-return slot. Pre-fix the second call crashed (rc 139).
expect_error("it returns an owning 'move' pointer but the slot's return is borrowed") {
    move int* t287MakeOwned(int x) { int* p = new int(x); return p; }
    void t287TakeBorrowed(function<int*(int)> f) { }
    void t287CallVar() {
        function<int*(int)> fv = t287MakeOwned;
        t287TakeBorrowed(fv);
        t287TakeBorrowed(fv);
    }
}

// Assignment cannot adopt an owning return (it is not flow-sensitive), so it refuses the bind itself.
expect_error("it returns an owning 'move' pointer but the slot's return is borrowed") {
    move int* t287MakeAssign(int x) { int* p = new int(x); return p; }
    void t287CallAssign() {
        function<int*(int)> fv = nullptr;
        fv = t287MakeAssign;
    }
}

// A variable of owning-return type passed to a borrowed-return parameter.
expect_error("it returns an owning 'move' pointer but the slot's return is borrowed") {
    move int* t287MakeVar(int x) { int* p = new int(x); return p; }
    int t287TakeRet(function<int*(int)> f) { return 0; }
    void t287OwnedVarArg() {
        function<move int*(int)> g = t287MakeVar;
        t287TakeRet(g);
    }
}

// A thin lambda literal whose parameter is 'move' cannot bind a borrowed slot (declarator, then call argument).
expect_error("differs in 'move' modifier") {
    void t287CallDecl() {
        function<int(int*)> f = (move int* p) => { int v = *p; delete p; return v; };
    }
}

expect_error("differs in 'move' modifier") {
    int t287ApplyBorrow(function<int(int*)> f, int* p) { return f(p); }
    void t287CallLambdaArg() {
        int* q = new int(5);
        t287ApplyBorrow((move int* p) => { int v = *p; delete p; return v; }, q);
    }
}

// A thin function<> variable with a 'move' parameter passed to a borrowed slot (pre-fix: rc 134).
expect_error("differs in 'move' modifier") {
    int t287ConsumeVar(move int* p) { int v = *p; delete p; return v; }
    int t287ApplyVar(function<int(int*)> f, int* p) { return f(p); }
    void t287MoveVarArg() {
        function<int(move int*)> h = t287ConsumeVar;
        int* q = new int(5);
        t287ApplyVar(h, q);
    }
}

// Thin-to-thin declarator init: the gate that skipped thin sources let the 'move' mismatch double-free.
expect_error("differs in 'move' modifier") {
    int t287ConsumeThin(move int* p) { int v = *p; delete p; return v; }
    void t287ThinToThin() {
        function<int(move int*)> h = t287ConsumeThin;
        function<int(int*)> f = h;
    }
}

// The reverse crossing: a borrowing literal cannot take a slot that transfers ownership to it.
expect_error("differs in 'move' modifier") {
    void t287Reverse() {
        function<int(move int*)> f = (int* p) => { return *p; };
    }
}

// The return slot must check the lambda's resolved parameter ownership.
expect_error("differs in 'move' modifier") {
    function<int(int*)> t399ReturnLambda() {
        return (move int* p) => { int v = *p; delete p; return v; };
    }
}

// A named function with a move parameter has the same return-slot constraint.
expect_error("differs in 'move' modifier") {
    int t399ReturnConsume(move int* p) { int v = *p; delete p; return v; }
    function<int(int*)> t399ReturnNamed() { return t399ReturnConsume; }
}

// Named brace field initialization must reject a move lambda in a borrowed slot.
expect_error("differs in 'move' modifier") {
    struct T399BraceHolder { function<int(int*)> f; };
    void t399BraceField() {
        T399BraceHolder h = { f = (move int* p) => { int v = *p; delete p; return v; } };
    }
}

// Field defaults use the same guard when a struct is constructed.
expect_error("differs in 'move' modifier") {
    int t399DefaultConsume(move int* p) { int v = *p; delete p; return v; }
    struct T399DefaultHolder { function<int(int*)> f = t399DefaultConsume; };
    void t399DefaultField() { T399DefaultHolder h = {}; }
}

expect_error("differs in 'move' modifier") {
    int t399DefaultFatConsume(move int* p) { int v = *p; delete p; return v; }
    struct T399DefaultFatHolder { Lambda<int(int*)> f = t399DefaultFatConsume; };
    void t399DefaultFatField() { T399DefaultFatHolder h = {}; }
}

// Positional fixed-array and inferred array-view stores are separate brace paths.
expect_error("differs in 'move' modifier") {
    int t399ArrayConsume(move int* p) { int v = *p; delete p; return v; }
    void t399FixedArray() {
        function<int(move int*)> source = t399ArrayConsume;
        function<int(int*)>[1] arr = { source };
    }
}

expect_error("differs in 'move' modifier") {
    int t399ViewConsume(move int* p) { int v = *p; delete p; return v; }
    void t399ArrayView() {
        function<int(move int*)> source = t399ViewConsume;
        function<int(int*)>[] arr = { source };
    }
}

expect_error("differs in 'move' modifier") {
    struct T399FatHolder { Lambda<int(int*)> f; };
    void t399FatField() {
        T399FatHolder h = { f = (move int* p) => { int v = *p; delete p; return v; } };
    }
}

// An overload of another arity or parameter type does not clear a move-param name for a borrowed slot.
expect_error("differs in 'move' modifier") {
    struct T399Arity { int v = 0; };
    int t399ArityPick(move T399Arity* p) { delete p; return 1; }
    int t399ArityPick(int x, int y) { return 2; }
    function<int(T399Arity*)> t399ArityReturn() { return t399ArityPick; }
}

expect_error("differs in 'move' modifier") {
    struct T399TypePick { int v = 0; };
    int t399TypedPick(move T399TypePick* p) { delete p; return 1; }
    int t399TypedPick(long* p) { return 2; }
    function<int(T399TypePick*)> t399TypedReturn() { return t399TypedPick; }
}

expect_error("differs in 'move' modifier") {
    struct T399VoidPick { int v = 0; };
    int t399VoidOverload(move T399VoidPick* p) { delete p; return 1; }
    int t399VoidOverload(void* p) { return 2; }
    function<int(T399VoidPick*)> t399VoidReturn() { return t399VoidOverload; }
}

expect_error("differs in 'move' modifier") {
    struct T399VariadicPick { int v = 0; };
    int t399VariadicOverload(move T399VariadicPick* p) { delete p; return 1; }
    int t399VariadicOverload(T399VariadicPick* p, ...) { return 2; }
    function<int(T399VariadicPick*)> t399VariadicReturn() { return t399VariadicOverload; }
}
