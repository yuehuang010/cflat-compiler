// Record boundary: a trivially copyable C++ record crosses by value under clang's own arrangement,
// but a NONTRIVIAL one (here: a user destructor) needs construction and destruction at the call
// site, which is not supported yet. The refusal happens when the declaration is registered, so
import cpp "cpp_interop_by_value.h";
import cpp "cpp_interop_basic.h";

extern int main()
{
    expect_error("takes or returns nontrivial type 'cppbv.Owner' by value") {
        cppbv.sum_owner(default);
    }
    // The MS ABI ignores [[no_unique_address]], so the layout is representable there.
    if const (__WINDOWS__) {
        cppi.NuaBitBetween representable = default;
        representable.b = 5;
        representable.y = representable.b;
    } else {
        expect_error("layout is not representable") {
            cppi.NuaBitBetween unsupported = default;
        }
    }
    return 0;
}
