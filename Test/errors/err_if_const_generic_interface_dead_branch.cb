// A generic interface declared ONLY inside a dead 'if const' branch never gets a
// registered template - it must be rejected at the first use, not routed to a fat
// pointer and run (that segfaults on the missing vtable). '__WINDOWS__ && __LINUX__'
// is decidably false on every target (a build can never be both), so this branch is
// dead on whichever host runs this test.
if const (__WINDOWS__ && __LINUX__) {
    interface GiDeadOnly<T> { T Get(); };
}

extern int main()
{
    // The message used to be the structural "has an incomplete layout (a field type C interop
    // could not import)", which came from the opaque shell the forward-ref scan pre-declared for
    // every bare 'Name<Args>'. With that shell gated on the name actually naming a template, a
    // template that exists only in a dead arm names nothing and says so.
    expect_error("unknown type 'GiDeadOnly__i32'");
    GiDeadOnly<int> z = default;
    return 0;
}
