// The chain consumes e exactly as `b = e;` does (accepted before round 2, refused since, by the oracle).

expect_error("use of moved variable 'e'") {
    void t250ChainMovedInner()
    {
        T250Link* b = nullptr;
        T250Link* e = nullptr;
        b = e = new T250Link();
        e->v = 1;
    }
}

// Must stay refused after the round 3 narrowing: a store the pre-scan can see on some back-edge.

expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'src'") {
    void t250LoopOuterStore(T250Link* p)
    {
        unique T250Link* a = nullptr;
        T250Link* b = nullptr;
        T250Link* src = nullptr;
        for (int j = 0; j < 2; j++)
        {
            for (int i = 0; i < 1; i++) { b = (src ?? new T250Link()); a = b; }
            src = p;
        }
    }
}

expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'src'") {
    void t250LoopTernaryNullStore(T250Link* p, bool c)
    {
        unique T250Link* a = nullptr;
        T250Link* b = nullptr;
        T250Link* src = nullptr;
        for (int i = 0; i < 2; i++) { b = (src ?? new T250Link()); a = b; src = (c ? nullptr : p); }
    }
}

unique T* t250GenLoop<T>(T* p)
{
    T* n = nullptr;
    T* m = nullptr;
    unique T* x = nullptr;
    for (int i = 0; i < 2; i++) { m = (n ?? new T()); x = m; n = p; }
    return x;
}

expect_error("cannot reset unique<T250Link> 'x' from borrowed value 'n'") {
    void t250GenericOwnLoopInstantiator(T250Link* p)
    {
        unique T250Link* d = t250GenLoop<T250Link>(p);
    }
}

// Round 4. The loop pre-scan counts every rebind spelling of the join's outer slot, not only `src = ...`.
void t250SetSlot(T250Link** q, T250Link* v) { *q = v; }

expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'b'") {
    void t250LoopParenTarget(T250Link* p)
    {
        unique T250Link* a = nullptr;
        T250Link* b = nullptr;
        T250Link* src = nullptr;
        for (int i = 0; i < 2; i++) { a = b = (src ?? new T250Link()); (src) = p; }
    }
}

expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'b'") {
    void t250LoopSlotPointer(T250Link* p)
    {
        unique T250Link* a = nullptr;
        T250Link* b = nullptr;
        T250Link* src = nullptr;
        for (int i = 0; i < 2; i++) { a = b = (src ?? new T250Link()); T250Link** pp = &src; *pp = p; }
    }
}

expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'b'") {
    void t250LoopSlotAddressCall(T250Link* p)
    {
        unique T250Link* a = nullptr;
        T250Link* b = nullptr;
        T250Link* src = nullptr;
        for (int i = 0; i < 2; i++) { a = b = (src ?? new T250Link()); t250SetSlot(&src, p); }
    }
}

expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'b'") {
    void t250LoopPostfixIncrement()
    {
        unique T250Link* a = nullptr;
        T250Link* b = nullptr;
        T250Link* src = nullptr;
        for (int i = 0; i < 2; i++) { a = b = (src ?? new T250Link()); src++; }
    }
}

// A bare `new` on one path only leaves the slot holding the last iteration's pointer on the next one.
expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'b'") {
    void t250LoopConditionalNew()
    {
        unique T250Link* a = nullptr;
        T250Link* b = nullptr;
        T250Link* src = nullptr;
        for (int i = 0; i < 2; i++) { a = b = (src ?? new T250Link()); if (i == 0) src = new T250Link(); }
    }
}

expect_error("cannot store an 'alias' value 'mid' into an owning variable") {
    void t250UniqueNullMiddle()
    {
        unique T250BorrowBox* owner = nullptr;
        unique T250BorrowBox* mid = nullptr;
        owner = mid = nullptr;
    }
}

expect_error("cannot pass the address of a stack or global value to 'move' parameter 'p'") {
    void t250GlobalMiddleChain()
    {
        unique T250BorrowBox* owner = nullptr;
        T250BorrowBox* e = nullptr;
        owner = t250Global = e = new T250BorrowBox();
    }
}

expect_error("cannot reset unique<T250BorrowBox> 'owner' from a borrowed value") {
    struct T250ImplicitFieldChain
    {
        T250BorrowBox* raw = nullptr;
        void assign()
        {
            unique T250BorrowBox* owner = nullptr;
            T250BorrowBox* e = nullptr;
            owner = raw = e = new T250BorrowBox();
        }
    };
}
