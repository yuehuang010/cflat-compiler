// D5: a `unique` local is an owning location. Initializing it from a borrowed value
// (here a plain-pointer parameter, which the caller still owns) without `move` would
// create two owners of one pointer - a compile error.
struct N { int v = 0; ~N() {} };

expect_error("cannot initialize unique<N> 'u' from borrowed value 'borrowed'") {
    void takes(N* borrowed) { unique N* u = borrowed; }
}

// Same rule through a MIXED '?:' join, where the borrow arm reads a live `unique` LOCAL. Which
// arm runs is not knowable here, and adopting the join freed the local's pointee a second time
// (abort at scope exit). The join owns nothing, so the `unique` initialization is rejected.
move N* makeN() { return new N; }

expect_error("cannot initialize unique<N> 'u2' from a borrowed value") {
    void mixedJoin(bool a, bool b)
    {
        unique N* owned = new N;
        unique N* u2 = a ? (b ? makeN() : owned) : new N;
    }
}

// Same rule when the borrow is laundered through a `move` of a BORROWED PARAMETER. The move nulls
// only the callee's copy, so the caller remains sole owner and the join owns nothing - adopting it
// destroyed the caller's live object inside the callee. Rejecting it here matches the direct
// `unique N* u = move borrowed;` spelling, which was already an error.
expect_error("cannot initialize unique<N> 'u3' from a borrowed value") {
    void borrowedMoveJoin(N* borrowed, bool c)
    {
        unique N* u3 = c ? move borrowed : nullptr;
    }
}

// The REASSIGNMENT spelling of the same laundered borrow. The direct `b = move borrowed;` was
// already rejected, but routing it through a '?:' join whose arms are all borrowed moves or null
// silently borrowed into the owning slot. Every path owns nothing, so reject it like the direct
// form and like the declaration above.
expect_error("cannot reset unique<N> 'b4' from a borrowed value") {
    void borrowedMoveJoinReassign(N* borrowed, bool c)
    {
        unique N* b4 = nullptr;
        b4 = c ? move borrowed : nullptr;
    }
}

// Same through a NESTED join - the provenance survives the outer join, so the laundering depth
// does not change the answer.
expect_error("cannot reset unique<N> 'b5' from a borrowed value") {
    void borrowedMoveNestedJoinReassign(N* borrowed, bool c)
    {
        unique N* b5 = nullptr;
        b5 = c ? (c ? move borrowed : nullptr) : nullptr;
    }
}

// The same laundering into a `unique` FIELD, where it was not merely a missed diagnostic: the
// field adopted the caller's live pointee, the synthesized destructor freed it inside the callee,
// and the caller freed it again (abort). The direct `h->p = move borrowed;` already errored.
struct Holder { unique N* p = nullptr; };

expect_error("cannot store borrowed parameter 'borrowed' into unique field 'Holder.p'") {
    void borrowedMoveJoinIntoField(Holder* h, N* borrowed, bool c)
    {
        h->p = c ? move borrowed : nullptr;
    }
}

// The BRACE-INIT field path (EmitOneFieldInit) is a third store site with the same hole: the direct
// `{ p = borrowed }` already errored, but the join spelling compiled and aborted the same way. Both
// field paths spell the rejection identically.
expect_error("cannot store borrowed parameter 'borrowed' into unique field 'Holder.p'") {
    void borrowedMoveJoinBraceInit(N* borrowed, bool c)
    {
        Holder h = { p = c ? move borrowed : nullptr };
    }
}

// T203: the chained spelling of a heap array into a unique local stays refused. unique<T> does not
// own arrays, so the chain must not reach the transfer path the single-object form is kept off.
expect_error("cannot reset unique<N> 'arrOwner' from borrowed value 'arrRaw'") {
    void chainHeapArray()
    {
        unique N* arrOwner = nullptr;
        N* arrRaw = nullptr;
        arrOwner = arrRaw = new N[2];
    }
}

// T207: a raw local that held an OWNED value and is then rebound to a borrowed parameter. The owned
// bit from the earlier `new` outlived the borrowing store, so the reset adopted the caller's pointee
// (abort at exit). The reaching assignment is the borrow, so the reset refuses it.
expect_error("cannot reset unique<N> 'owner' from borrowed value 'borrowed'") {
    void t207StaleOwnerThenBorrow(N* borrowed)
    {
        unique N* owner = nullptr;
        N* raw = new N;
        raw = borrowed;
        owner = raw;
    }
}

// Same stale owner, rebound to the address of a stack local: the local is not heap memory.
expect_error("cannot reset unique<N> 'owner' from borrowed value 'loc'") {
    void t207StaleOwnerThenAddress()
    {
        unique N* owner = nullptr;
        N loc = default;
        N* raw = new N;
        raw = &loc;
        owner = raw;
    }
}

// A raw local assigned the address of a stack local is a borrow of it, and the reset refuses it.
expect_error("cannot reset unique<N> 'owner' from borrowed value 'loc'") {
    void t207AddressOfLocal()
    {
        unique N* owner = nullptr;
        N loc = default;
        N* raw = nullptr;
        raw = &loc;
        owner = raw;
    }
}

// The same through a field of a stack struct: the root object is named.
struct T207Box { N inner = default; };
expect_error("cannot reset unique<N> 'owner' from borrowed value 'box'") {
    void t207AddressOfField()
    {
        unique N* owner = nullptr;
        T207Box box = default;
        N* raw = nullptr;
        raw = &box.inner;
        owner = raw;
    }
}

// Array decay of a stack array is not an owned pointer: the array keeps its elements.
expect_error("cannot reset unique<N> 'owner' from borrowed value 'arr'") {
    void t207ArrayDecayAssign()
    {
        unique N* owner = nullptr;
        N[2] arr = default;
        N* raw = nullptr;
        raw = arr;
        owner = raw;
    }
}

// The declaration spelling of the same two borrows.
expect_error("cannot reset unique<N> 'owner' from borrowed value 'raw'") {
    void t207ArrayDecayDecl()
    {
        unique N* owner = nullptr;
        N[2] arr = default;
        N* raw = arr;
        owner = raw;
    }
}

expect_error("cannot reset unique<N> 'owner' from borrowed value 'raw'") {
    void t207AddressOfDecl()
    {
        unique N* owner = nullptr;
        N loc = default;
        N* raw = &loc;
        owner = raw;
    }
}

// Branches: every reaching assignment must own. A borrowed arm taken on one path makes the reset
// refuse, whichever arm is the owner in the source order.
expect_error("cannot reset unique<N> 'owner' from borrowed value 'borrowed'") {
    void t207BranchNewThenBorrow(N* borrowed, bool c)
    {
        unique N* owner = nullptr;
        N* raw = nullptr;
        if (c) raw = new N; else raw = borrowed;
        owner = raw;
    }
}

expect_error("cannot reset unique<N> 'owner' from borrowed value 'loc'") {
    void t207BranchAddressThenNew(bool c)
    {
        unique N* owner = nullptr;
        N loc = default;
        N* raw = nullptr;
        if (c) raw = &loc; else raw = new N;
        owner = raw;
    }
}

extern int main()
{
    return 0;
}
