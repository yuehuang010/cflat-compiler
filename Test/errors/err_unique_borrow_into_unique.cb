expect_error("cannot reset unique<T250Link> 'a' from borrowed value 'v'") {
    void t250ArmVoidMiddle(bool c)
    {
        unique T250Link* a = nullptr;
        void* v = nullptr;
        T250Link* e = nullptr;
        a = (c ? (v = e = new T250Link()) : nullptr);
