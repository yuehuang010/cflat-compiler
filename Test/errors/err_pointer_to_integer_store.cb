// Every pointer-to-number store must name its explicit conversion.
struct P2iField { long value = 0; };
struct P2iDesignated { long value = 0; };
struct P2iPointerField { int* value = nullptr; };
struct P80DoubleField { double* value = nullptr; };
struct P89Field { char* value = nullptr; };
enum P2iEnum : int { P2I_ZERO = 0, P2I_ONE = 1 };
int p2iFunction() { return 1; }
extern void* malloc(i64 size);
import "c_macro_helpers.h";
import cpp "cpp_t89_char_pointer.hpp";
void t89TakeI8(i8* value) { }
void t89TakeCharPP(char** value) { }
void p2iNativeTakeInt(int* value) {}
void p2iSimdInt(simd<int,4>* value) {}
void p2iSimdLong(simd<i64,4>* value) {}
i64* p2iBetter(i64* value) { return value; }
int* p2iBetter(int* value) { return value; }
i64* p2iLongGlobal;
int* p2iIntGlobal;
bool* p2iBoolGlobal;
i64 p2iGlobalWide;
expect_error("cannot convert 'i64*' to 'int*' implicitly") {
    int* p2iBadGlobal = &p2iGlobalWide;
}
expect_error("cannot convert 'i64*' to 'int*' implicitly") {
    struct P2iBadFieldDefault { int* value = p2iLongGlobal; };
}
expect_error("cannot convert 'i64*' to 'int*' implicitly") {
    int* p2iBadReturn() { return p2iLongGlobal; }
}
expect_error("a pointer is not a number") {
    struct P2iStringDefault { long value = "abc"; };
}
expect_error("cannot return a value") {
    long p2iBadReturn() { long n = 5; long* p = &n; return p; }
}
extern int main()
{
    long n = 5; long* p = &n; long* q = &n;
    int m = 6; int* ip = &m; i64 wn = 5; i64* wp = &wn;
    int*[2] matchingPointerArray = { &m, &m };
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        int*[2] badPointerArray = { &wn, &wn };
    }
    expect_error("a pointer is not a number") { long x = p; }
    expect_error("a pointer is not a number") { long x = 0; x = p; }
    expect_error("a pointer is not a number") { long x = p + 1; }
    expect_error("a pointer is not a number") { long x = p - 1; }
    expect_error("a pointer is not a number") { char** argv = nullptr; int n = argv[0] + 1; }
    expect_error("a pointer is not a number") { P2iField s = default; s.value = p + 1; }
    expect_error("a pointer is not a number") { P2iDesignated s = {value = p + 1}; }
    expect_error("a pointer is not a number") { long x = "abc"; }
    expect_error("a pointer is not a number") { long x = 0; x = "abc"; }
    expect_error("a pointer is not a number") { char x = "a"; }
    expect_error("a pointer is not a number") { long x = q ?? p; }
    expect_error("a pointer is not a number") { long x = 0; x = q ?? p; }
    expect_error("a pointer is not a number") { bool c = true; long x = c ? p : nullptr; }
    expect_error("a pointer is not a number") { bool c = true; long x = 0; x = c ? p : nullptr; }
    expect_error("a pointer is not a number") { P2iField s = default; s.value = p; }
    expect_error("a pointer is not a number") { P2iDesignated s = {value = p}; }
    expect_error("a pointer is not a number") { long[1] a = {p}; }
    expect_error("a pointer is not a number") { long[1] a = default; a[0] = p; }
    expect_error("a pointer is not a number") { long x = 0; x += p; }
    expect_error("a pointer is not a number") { long x = 0; x -= p; }
    expect_error("a pointer is not a number") { long x = 0; x |= p; }
    expect_error("a pointer is not a number") { bool c = true; long x = c ? p : q; }
    expect_error("a pointer is not a number") { int* ip = (int*)&n; char x = ip; }
    expect_error("a pointer is not a number") { int* ip = (int*)&n; double x = ip; }
    expect_error("a pointer is not a number") { P2iEnum x = p; }
    expect_error("a pointer is not a number") { function<int()>* fp = p2iFunction; long x = fp; }
    expect_error("a pointer is not a number") { int[1] a = {5}; int[] view = a; long x = view; }
    expect_error("a pointer is not a number") { long x = malloc(8); }
    expect_error("a pointer is not a number") { i8 x = p; }
    expect_error("a pointer is not a number") { u8 x = p; }
    expect_error("a pointer is not a number") { i16 x = p; }
    expect_error("a pointer is not a number") { u16 x = p; }
    expect_error("a pointer is not a number") { i32 x = p; }
    expect_error("a pointer is not a number") { u32 x = p; }
    expect_error("a pointer is not a number") { i64 x = p; }
    expect_error("a pointer is not a number") { u64 x = p; }
    expect_error("a pointer is not a number") { float x = p; }
    expect_error("no overload of") { p2iTakeLong(p); }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        int* bad = wp;
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        int* bad = nullptr; bad = wp;
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        p2iNativeTakeInt(wp);
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        c_p2i_take_int(wp);
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        bool c = true; int* bad = c ? wp : ip;
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        int* bad = wp ?? ip;
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        bool same = wp == ip;
    }
    expect_error("cannot convert 'bool*' to 'int*' implicitly") {
        int* bad = p2iBoolGlobal;
    }
    expect_error("cannot convert 'int**' to 'u64**' implicitly") {
        int** source = nullptr; u64** bad = source;
    }
    expect_error("cannot convert 'int*' to 'i64*' implicitly") {
        bool c = true; i64 x = 1; int y = 2; int* bad = c ? &y : &x;
    }
    expect_error("cannot convert 'int*' to 'i64*' implicitly") {
        bool c = true; i64 x = 1; int y = 2; int* bad = nullptr; bad = c ? &y : &x;
    }
    expect_error("cannot convert 'int*' to 'i64*' implicitly") {
        i64 x = 1; int* ip = nullptr; int* bad = ip ?? &x;
    }
    expect_error("cannot convert 'int*' to 'i64*' implicitly") {
        P2iPointerField s;
        i64 x = 1; bool same = s.value == &x;
    }
    expect_error("no overload of") {
        simd<int,4> value; p2iSimdLong(&value);
    }
    expect_error("no overload of") {
        long* value = nullptr; long** source = &value; p2iNativeTakeInt(source);
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        i64[2] wide = {1, 2}; i64[] view = wide; int* bad = view;
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        i64[2] wide = {1, 2}; p2iNativeTakeInt(wide);
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        i64[2] wide = {1, 2}; int* bad = wide;
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        i64[2] wide = {1, 2}; i64[] view = wide; p2iNativeTakeInt(view);
    }
    expect_error("pointee types differ") {
        bool c = true; int[2] small = {1, 2}; int[] view = small;
        i64 wide = 3; int* bad = c ? view : &wide;
    }
    expect_error("pointee types differ") {
        bool c = true; int[2] small = {1, 2}; int[] view = small;
        i64 wide = 3; int* bad = c ? &wide : view;
    }
    expect_error("cannot convert 'i64*' to 'int*' implicitly") {
        i64 wide = 3; P2iPointerField bad = {value = &wide};
    }
    expect_error("cannot convert 'int*' to 'double*' implicitly") {
        int t80Single = 1; p80TakeDouble(&t80Single);
    }
    expect_error("cannot convert 'int*' to 'double*' implicitly") {
        int t80Assigned = 1; double* t80Target = nullptr; t80Target = &t80Assigned;
    }
    expect_error("cannot convert 'int*' to 'double*' implicitly") {
        int t80Declared = 1; double* t80Init = &t80Declared;
    }
    expect_error("cannot convert 'int*' to 'double*' implicitly") {
        bool t80Cond = true; int t80Arm = 1; double t80Wide = 2.0;
        double* t80Chosen = t80Cond ? &t80Arm : &t80Wide;
    }
    expect_error("cannot convert 'int*' to 'double*' implicitly") {
        int t80Field = 1; P80DoubleField t80Struct = { value = &t80Field };
    }
    expect_error("cannot convert 'double*' to 'int*' implicitly") {
        double[2] t80Fixed = {1.0, 2.0}; int* t80Decayed = t80Fixed;
    }
    expect_error("cannot convert 'double*' to 'int*' implicitly") {
        double[2] t80Source = {1.0, 2.0}; double[] t80View = t80Source; int* t80FromView = t80View;
    }
    expect_error("cannot convert 'float*' to 'double*' implicitly") {
        float t80Float = 1.0; double* t80FloatPtr = &t80Float;
    }
    expect_error("cannot convert 'double*' to 'i64*' implicitly") {
        double t80Real = 1.0; i64* t80Bits = &t80Real;
    }
    expect_error("cannot convert 'bool*' to 'float*' implicitly") {
        bool t80Flag = true; float* t80FlagPtr = &t80Flag;
    }
    expect_error("no overload of 'p80Pick' matches") {
        int t80Two = 1; int r80Two = p80Pick(&t80Two);
    }
    simd<int,4> simdValue;
    p2iSimdInt(&simdValue);
    long cLong = 1; ulong cULong = 2;
    c_p2i_take_long(&cLong);
    c_p2i_take_ulong(&cULong);
    p2iNativeTakeInt(ip);
    p2iNativeTakeInt((int*)wp);
    int* explicitPointer = (int*)wp;
    int[2] sameArray = {1, 2};
    int[] sameView = sameArray;
    int* sameViewDecay = sameView;
    int* sameArrayDecay = sameArray;
    p2iNativeTakeInt(sameView);
    i8* bytePointer = (i8*)&n;
    char* charPointer = (char*)bytePointer;
    charPointer = (char*)bytePointer;
    i32* samePrimitive = ip;
    p2iBetter(wp);
    i8* t89I8Ptr = (i8*)&n;
    char* t89CharPtr = (char*)&n;
    u8* t89U8Ptr = (u8*)&n;
    expect_error("cannot convert 'char*' to 'u8*' implicitly") { u8* t89U = nullptr; t89U = t89CharPtr; }
    expect_error("cannot convert 'i8*' to 'char*' implicitly") { char* t89A = t89I8Ptr; }
    expect_error("cannot convert 'u8*' to 'char*' implicitly") { char* t89B = nullptr; t89B = t89U8Ptr; }
    expect_error("cannot convert 'char*' to 'u8*' implicitly") { u8* t89C = t89CharPtr; }
    expect_error("cannot convert 'i8*' to 'char*' implicitly") {
        bool t89Cond = true; char* t89D = t89Cond ? t89I8Ptr : t89CharPtr;
    }
    expect_error("cannot convert 'i8*' to 'char*' implicitly") {
        i8[2] t89ArrI8 = default; char* t89E = t89ArrI8;
    }
    expect_error("cannot convert 'i8*' to 'char*' implicitly") {
        i8[2] t89SrcI8 = default; i8[] t89ViewI8 = t89SrcI8; char* t89F = t89ViewI8;
    }
    expect_error("cannot convert 'i8*' to 'char*' implicitly") { P89Field s = {value = t89I8Ptr}; }
    expect_error("cannot convert 'i8*' to 'char*' implicitly") { t89_take_char(t89I8Ptr); }
    expect_error("cannot convert 'u8*' to 'char*' implicitly") { t89_take_char(t89U8Ptr); }
    expect_error("cannot convert 'char*' to 'i8*' implicitly") { t89TakeI8("A"); }
    expect_error("cannot convert 'char*' to 'u8*' implicitly") { t89_take_uchar("A"); }
    // Parentheses are transparent: a parenthesized literal is still a char* literal.
    expect_error("cannot convert 'char*' to 'i8*' implicitly") { t89TakeI8(("A")); }
    expect_error("cannot convert 'char*' to 'u8*' implicitly") { t89_take_uchar(("A")); }
    expect_error("cannot convert 'char*' to 'i8*' implicitly") { char[2] t89Decay = default; t89TakeI8(t89Decay); }
    expect_error("cannot convert 'char*' to 'i8*' implicitly") { char[2] t89CDecay = default; t89_take_schar(t89CDecay); }
    expect_error("cannot convert 'i8**' to 'char**' implicitly") { i8* t89PP = nullptr; t89TakeCharPP(&t89PP); }
    expect_error("cannot convert 'i8**' to 'char**' implicitly") { i8* t89CPP = nullptr; t89_take_char_pp(&t89CPP); }
    expect_error("cannot convert 'char*' to 'i8*' implicitly") { t89_take_schar(t89CharPtr); }
    expect_error("cannot convert 'i8*' to 'char*' implicitly") { t89_variadic(t89I8Ptr, 1); }
    return 0;
}
int p2iTakeLong(long value) { return (int)value; }

// Global brace list of pointers: same pointee rule as a local one.
expect_error("cannot convert 'i64*' to 'int*' implicitly") {
    int*[2] p2iGlobalBadPtrs = { &p2iGlobalWide, &p2iGlobalWide };
}
int p2iGlobalInt = 3;
int*[2] p2iGlobalGoodPtrs = { &p2iGlobalInt, &p2iGlobalInt };

// T80: unrelated primitive pointees (integer <-> floating) refused at every context.
double p80Double = 0.0;
int p80Int = 0;

// T89: char family (char <-> i8/u8) refused like the other integer pointee pairs.
i8* t89GlobalI8 = nullptr;
u8* t89GlobalU8 = nullptr;
char* t89GlobalChar = nullptr;
void t89TakeChar(char* value) { }
expect_error("cannot convert 'i8*' to 'char*' implicitly") {
    char* t89BadGlobal = t89GlobalI8;
}
expect_error("cannot convert 'char*' to 'u8*' implicitly") {
    u8* t89BadGlobalU8 = t89GlobalChar;
}
expect_error("cannot convert 'i8*' to 'char*' implicitly") {
    struct T89BadFieldDefault { char* value = t89GlobalI8; };
}
expect_error("cannot convert 'i8*' to 'char*' implicitly") {
    char* t89BadReturn() { return t89GlobalI8; }
}
expect_error("cannot convert 'i8*' to 'char*' implicitly") {
    char* t89BadParamReturn(i8* value) { return value; }
}
void p80TakeDouble(double* value) { }
int p80Pick(double* value) { return 2; }
int p80Pick(float* value) { return 3; }
expect_error("cannot convert 'int*' to 'double*' implicitly") {
    double* p80BadGlobal = &p80Int;
}
expect_error("cannot convert 'int*' to 'double*' implicitly") {
    double* p80BadReturn() { return &p80Int; }
}
expect_error("cannot convert 'int*' to 'double*' implicitly") {
    struct P80BadFieldDefault { double* value = &p80Int; };
}
