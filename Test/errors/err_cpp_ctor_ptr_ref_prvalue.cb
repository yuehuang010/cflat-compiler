// A C++ T*& constructor must reject a pointer prvalue, as clang does.
import cpp "cpp_interop_ref_alias.h";
import cpp "cpp_t495_amppick.hpp";

extern int main()
{
    expect_error("is a non-const lvalue reference and cannot bind an rvalue") {
        int value = 6;
        cppalias.CtorPtrRef bad = cppalias.CtorPtrRef(&value);
    }
    int value = 6;
    int* p = &value;
    expect_error("non-const lvalue reference and cannot bind an rvalue") {
        amp2r3.CtorDeleted bad = amp2r3.CtorDeleted(&p);
    }
    expect_error("non-const lvalue reference and cannot bind an rvalue") {
        amp2r3.CtorPrivate bad = amp2r3.CtorPrivate(&p);
    }
    expect_error("non-const lvalue reference and cannot bind an rvalue") {
        amp2r3.CtorNestedNomatch bad = amp2r3.CtorNestedNomatch(&p);
    }
    return 0;
}
