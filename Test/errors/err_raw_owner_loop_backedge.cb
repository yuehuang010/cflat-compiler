        int[2] iterations = {0, 1};
        for (int i in iterations) { owner = raw; raw = p; }
    }
}

expect_error("cannot reset unique<R> 'owner' from borrowed value") {
    void rawOwnerContinueBackedge()
    {
        R stack;
        R* p = &stack;
        R* raw = new R();
        unique R* owner = nullptr;
        for (int i = 0; i < 2; i++)
        {
            owner = raw;
            if (i == 0) { raw = p; continue; }
            raw = new R();
        }
    }
}

