struct R { int value = 0; };
R* rawOwnerLoopGlobal = nullptr;
void takeRawExit(move R* p) { delete p; }

expect_error("cannot reset unique<R> 'owner' from borrowed value") {
    void rawOwnerForBackedge()
    {
        R stack;
        R* p = &stack;
        R* raw = new R();
        unique R* owner = nullptr;
        for (int i = 0; i < 2; i++) { owner = raw; raw = p; }
    }
}

expect_error("cannot reset unique<R> 'owner' from borrowed value") {
    void rawOwnerWhileBackedge()
    {
        R stack;
        R* p = &stack;
        R* raw = new R();
        unique R* owner = nullptr;
        int i = 0;
        while (i < 2) { owner = raw; raw = p; i++; }
    }
}

