import cpp "cpp_interop_tpl.h";
import cpp "list";

expect_error("'std::list<__cflat_user::Leaf>' needs the complete definition of [cpp] struct 'Leaf'; define the struct before this use") {
    struct Holder : cppt.ModuleBase
    {
        std.list<Leaf> values = default;
        override int forward(int x) { return x; }
    };
}

// While Leaf is still incomplete, a second use is refused again.
expect_error("'std::list<__cflat_user::Leaf>' needs the complete definition of [cpp] struct 'Leaf'; define the struct before this use") {
    struct Holder2 : cppt.ModuleBase
    {
        std.list<Leaf> values = default;
        override int forward(int x) { return x; }
    };
}

struct Leaf : cppt.ModuleBase
{
    int v = 0;
    override int forward(int x) { return x + v; }
};

// The refused specialization stays refused after Leaf is defined, naming the cause.
expect_error("'std.list<Leaf>' was refused earlier in this compile because 'Leaf' was incomplete at that point; declare 'Leaf' before its first use in a C++ template argument") {
    struct Later : cppt.ModuleBase
    {
        std.list<Leaf> m = default;
        override int forward(int x) { return x; }
    };
}

struct Other : cppt.ModuleBase
{
    int v = 0;
    override int forward(int x) { return x + v; }
};

// Another specialization of the same template still binds.
struct Fine : cppt.ModuleBase
{
    std.list<Other> m = default;
    override int forward(int x) { return x; }
};

extern int main()
{
    Fine b = Fine();
    Other o = Other();
    o.v = 6;
    b.m.push_back(move o);
    if (b.m.size() != 1) return 1;
    if (b.m.back().forward(1) != 7) return 2;
    return 0;
}
