import cpp "cpp_interop_uniqueptr.h";
import "unique.cb";

expect_error("cannot convert value of type 'unique cpuq.Widget*' to 'int'") {
    void assign_keyword_unique_to_int()
    {
        unique cpuq.Widget* a = new cpuq.Widget(1);
        int n = a;
    }
}

expect_error("cannot convert value of type 'std.unique_ptr<cpuq.Widget>' to 'int'") {
    void assign_spelled_unique_to_int()
    {
        std.unique_ptr<cpuq.Widget> a = cpuq.make(2);
        int n = a;
    }
}

expect_error("cannot convert value of type 'cpuq.Widget' to 'int'") {
    void assign_cpp_class_to_int()
    {
        cpuq.Widget w = cpuq.Widget(3);
        int n = w;
    }
}
