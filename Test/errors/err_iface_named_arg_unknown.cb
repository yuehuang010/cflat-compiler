// A named argument that matches no declared parameter must be rejected on the
// interface call path exactly as it already is on the direct call path - not
// silently accepted (or worse, silently bound to the wrong slot).
interface IF { int f(int a, int b); };

class N : IF { int f(int a, int b) { return a * 10 + b; } };

// Overloaded slots: every same-arity slot is probed silently, so when NONE of them can bind
// the name the diagnostic has to be recovered by re-running the search non-probed. Without
// that recovery this compiled and dispatched to the first slot with the names ignored.
interface IFOv
{
    int f(int a, int b);
    int f(double c, double d);
};

class NOv : IFOv
{
    int f(int a, int b) { return a * 10 + b; }
    int f(double c, double d) { return (int)(c * 100.0 + d); }
};

// The slot with p/q is declared first, but the call names the later a/b slot. The replay must
// not report p/q's name miss; the selected slot's pointer-to-by-value error is the true cause.
interface IFSlot
{
    int g(int* p, int* q);
    int g(int a, int b);
};

class IFSlotImpl : IFSlot
{
    int g(int* p, int* q) { return *p + *q; }
    int g(int a, int b) { return a + b; }
};

extern int main()
{
    N n;
    IF io = n;

    expect_error("named argument 'zz' does not match any parameter") {
        int bogus = io.f(zz: 1, a: 2);
    }

    NOv nov;
    IFOv ovio = nov;

    expect_error("named argument 'zz' does not match any parameter") {
        int bogusOv = ovio.f(zz: 1, a: 2);
    }

    IFSlotImpl slotImpl;
    IFSlot slot = slotImpl;
    int x = 1;
    expect_error("call to 'IFSlot.g': cannot pass a pointer to by-value parameter") {
        int bogusType = slot.g(b: &x, a: &x);
    }

    return 0;
}
