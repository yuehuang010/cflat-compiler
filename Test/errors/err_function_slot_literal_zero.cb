        FnZeroWordMisBoolIface iface = impl;
        return iface.run(false, 0);
    }
}

// A data pointer at another function<> slot is the real mismatch (FNZEROWORD r4): master message stays.
expect_error("no overload of 'fnZeroWordMisF2' matches the given arguments") {
    int fnZeroWordMisF2(function<int(int)> a, function<int(int)> b) { return 1; }
    int fnZeroWordMisF2Call() { return fnZeroWordMisF2(0, "x"); }
}
expect_error("no method of 'FnZeroWordMisPairIface.run' matches the given arguments") {
    interface FnZeroWordMisPairIface { int run(function<int(int)> a, function<int(int)> b); };
    class FnZeroWordMisPairImpl : FnZeroWordMisPairIface {
        int run(function<int(int)> a, function<int(int)> b) { return 1; }
    };
    int fnZeroWordMisPairCall() {
        FnZeroWordMisPairImpl impl;
        FnZeroWordMisPairIface iface = impl;
        return iface.run(0, "x");
    }
}
