// reassigning a bond source while a bonded reference is live is an error
expect_error("cannot reassign 'src' while 'v' holds a bonded reference") {
    int* Borrow(bond int* src) { return src; }

    void Test(int* src, int* other) {
        int* v = Borrow(src);
        src = other;   // error: v still holds a bond to src
    }
}

// The '??=' spelling of the same store. It emits a CONDITIONAL store, but the store may still
// happen, so the bond source is still being reassigned. On the merge base '??=' returned before
// this check ever ran (it was its own store path), so this compiled clean.
expect_error("cannot reassign 'src2' while 'v2' holds a bonded reference") {
    int* Borrow2(bond int* src2) { return src2; }

    void Test2(int* src2, int* other2) {
        int* v2 = Borrow2(src2);
        src2 ??= other2;
    }
}

// A conditional rebind of the bonded view may not retire the bond for the merge base.
expect_error("cannot reassign 'src3' while 'v3' holds a bonded reference") {
    int* Borrow3(bond int* src3) { return src3; }

    void Test3(int* src3, int* other3) {
        int* v3 = Borrow3(src3);
        if (other3 != nullptr) { v3 = other3; }
        src3 = other3;
    }
}
