import "string.cb";
import "list.cb";

struct NestedNamedBraceInner { int count = default; };
struct NestedNamedBraceCfg { NestedNamedBraceInner inner = default; };

extern int main()
{
    expect_error("nested named brace initializer is not supported in container elements") {
        list<NestedNamedBraceCfg> values = { { inner = { count = 3 } } };
    }
    expect_error("nested named brace initializer is not supported in positional fixed-array elements") {
        NestedNamedBraceCfg[1] fixedValues = { { inner = { count = 3 } } };
    }
    expect_error("nested named brace initializer is not supported for inferred array-view elements") {
        NestedNamedBraceCfg[] viewValues = { { inner = { count = 3 } } };
    }
    return 0;
}
