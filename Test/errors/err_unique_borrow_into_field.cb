// Stage 2 of `unique`: a `unique` field declares that it OWNS its pointee, and the
// synthesized destructor deletes it. Storing a borrowed (non-`move`) parameter into it
// therefore makes two owners - the caller frees on scope exit and the field frees at
// teardown. This is Trap A from internal/plan/ownership-move-alias-discipline.md, which
// is only diagnosable because the field states the ownership claim. `move Node* n` is
// the accepted spelling (covered positively in Test/test_move.cb).
struct Node { int v = 0; };

struct Holder { unique Node* slot = nullptr; };

expect_error("cannot store borrowed parameter 'n' into unique field 'Holder.slot'") {
    void store(Holder* h, Node* n) { h->slot = n; }
}

// The SAME mistake spelled through a generic: substitution marks the field IsUniqueTypeArg,
// not IsUnique, and destructor synthesis ORs the two - so the field was freed identically
// while this reject, keyed on IsUnique alone, never saw it (silent abort, exit 134, no
// diagnostic at all). Pinned to the stable prefix only: the message names the INSTANTIATED
// struct, so the full substring would embed the `Box__unique_Nodeptr` mangling.
struct Box<T> { T t = default; };

expect_error("cannot store borrowed parameter 'n' into unique field 'Box") {
    void storeGeneric(Node* n) { Box<unique Node*> b = default; b.t = n; }
}

// The MIXED field-to-field shape: a written `unique` source field into a GENERIC unique
// destination field. Both synthesized destructors free the one pointee (silent abort, exit
// 134). The source gate already passed here - only the destination was blind.
expect_error("cannot store unique field 'a.slot' into unique field 'Box") {
    void mixedFieldToField() { Holder a = default; Box<unique Node*> c = default; c.t = a.slot; }
}

// The FULLY generic field-to-field shape: both sides IsUniqueTypeArg, no written `unique`
// anywhere. IsUniqueFieldRead was keyed on IsUnique alone, so even after the destination
// widening above this leg still short-circuited on the SOURCE and reached the double-free
// with no diagnostic at all (silent abort, exit 134). Fixed by widening IsUniqueFieldRead
// to the same owning-slot predicate (IsOwningUniquePointerField) already used for the
// destination.
expect_error("cannot store unique field 'a.t' into unique field 'Box") {
    void fullyGenericFieldToField()
    {
        Box<unique Node*> a = default;
        Box<unique Node*> c = default;
        c.t = a.t;
    }
}

// Same fully-generic shape through the SECOND field-store path: brace-init (`EmitOneFieldInit`)
// applies the same widened source gate independently of the `=` path above. Uncovered before
// this leg: reverting the widening only in EmitOneFieldInit still double-frees here silently.
expect_error("cannot store unique field 'a.t' into unique field 'Box") {
    void fullyGenericBraceInit()
    {
        Box<unique Node*> a = default;
        Box<unique Node*> c = { t = a.t };
    }
}

// ---------------------------------------------------------------------------------------
// A source read off an owning TEMPORARY. `makeBox().t` never lands on a 2-index field GEP,
// so IsUniqueFieldRead's shape test cannot see it - the temp's own synthesized destructor
// frees the pointee just the same, so the store made two owners (silent abort, exit 134, no
// diagnostic). Closed by the sibling IsUniqueTempFieldRead gate, which reads the temp
// provenance the member-access branch already records instead of widening the shape test.
Box<unique Node*> makeBox() { Box<unique Node*> b = default; b.t = new Node(); return b; }

expect_error("cannot store unique field 'makeBox.t' of a temporary into unique field 'Box") {
    void tempSourceFieldToField() { Box<unique Node*> c = default; c.t = makeBox().t; }
}

// The realistic spelling of the same shape: a BORROWED container element. `list<T>::get`
// returns `alias T`, so the `.t` read is a field of a borrowed temp rather than a call
// result - a different provenance flag (FromOwningTempField, not MovableTempField) reaching
// the same gate, and a DIFFERENT owner - the list, not the temp - so it gets its own wording.
// Naming the call-result remedy here would be wrong twice over: nothing is freed at the end of
// this statement, and binding-then-moving out of the borrowed element double-frees.
expect_error("cannot store unique field 't' borrowed from a temporary into unique field 'Box") {
    void tempElementFieldToField()
    {
        list<Box<unique Node*>> l;
        Box<unique Node*> b = default; b.t = new Node(); l.add(move b);
        Box<unique Node*> c = default;
        c.t = l.get(0).t;
    }
}

// Same temp source through the SECOND field-store path (brace-init / EmitOneFieldInit),
// which applies its own copy of the gate. Reverting the widening only there still
// double-freed here silently.
expect_error("cannot store unique field 'makeBox.t' of a temporary into unique field 'Box") {
    void tempSourceBraceInit() { Box<unique Node*> c = { t = makeBox().t }; }
}

// A pointee with a USER DESTRUCTOR turned the same temp source into a COMPILER CRASH
// (SIGSEGV, exit 139, zero output) when the destination was NOT a unique field: the
// implied-move-of-a-move-temp's-owning-field branch fired on a POINTER field and emitted the
// pointee's destructor against the destination SLOT's address, producing IR that killed
// LLVM's DAG combiner. That branch is for owning VALUE types only; a pointer source now
// falls through to the owning-temp-field reject, which is the correct diagnosis.
class Dtored { int v = default; ~Dtored() {} };
struct PlainSlot { Dtored* p = nullptr; };
Box<unique Dtored*> makeDtored() { Box<unique Dtored*> b = default; b.t = new Dtored(); return b; }

expect_error("taken from a temporary into a longer-lived location") {
    void tempPointerFieldIntoPlainSlot() { PlainSlot q = default; q.p = makeDtored().t; }
}

// The SAME crash through the DECLARATION-with-initializer spelling. That path has its own
// copy of the implied-move capture (ParseDeclaration, `srcMovableTempField`) reaching the
// same aggregate-zero store, so guarding only the `=` twin left this one crashing: the
// assignment spelling above is diagnosed while `Dtored* raw = makeDtored().t;` still died at
// exit 139. Half-a-fix along the spelling axis is the recorded failure mode for this family.
expect_error("taken from a temporary to a local") {
    void tempPointerFieldIntoDeclaredLocal() { Dtored* raw = makeDtored().t; }
}

// And the THIRD copy of the same implied-move capture: the RETURN path (ParseStatement's jump
// handling). Same aggregate-zero store, same exit-139 crash, and guarding the assignment and
// declaration twins left this one dying. N-1 sites fixed is the recorded failure mode here.
expect_error("taken from a temporary; its buffer is owned elsewhere") {
    Dtored* returnTempPointerField() { return makeDtored().t; }
}

// ---------------------------------------------------------------------------------------
// THE DTOR-LESS POINTEE. Every reject above is keyed on IsOwningValueType(TypeName), which is
// true only when the POINTEE has a destructor. `Node` has none, so the identical programs
// compiled clean, ran, printed a plausible value and exited 0 - a silent use-after-free
// (measured: under MallocScribble=1 the read returns 1431655765, the 0x55 fill). The
// discriminator that was missing is the TEMP's own synthesized destructor, which frees the
// pointee at the end of the statement whoever the destination is; the new gate
// (IsOwningTempUniqueFieldEscape) reads that provenance instead of the pointee's type name.
// Every leg below compiles and runs on the pre-fix binary, so each is non-vacuous on its own.
struct PlainNodeSlot { Node* p = nullptr; };

expect_error("cannot store unique field 'makeBox.t' of a temporary into a longer-lived location") {
    void tempDtorlessFieldIntoPlainSlot() { PlainNodeSlot q = default; q.p = makeBox().t; }
}

// The DECLARATION spelling - a separate copy of the gate in ParseDeclaration. Reverting only
// that copy leaves this leg compiling while the assignment leg above still fails.
expect_error("cannot store unique field 'makeBox.t' of a temporary into a local") {
    void tempDtorlessFieldIntoLocal() { Node* raw = makeBox().t; }
}

// The RETURN spelling - the third copy, in ParseStatement's jump handling.
expect_error("cannot store unique field 'makeBox.t' of a temporary into the return value") {
    Node* returnTempDtorlessField() { return makeBox().t; }
}

// The BRACE-INIT store path (EmitOneFieldInit), whose destination field only BORROWS - the
// pre-existing temp gate there requires an owning `unique` destination and declines. This
// destination names itself in the message, which is how the brace path is told from the `=`
// path when both would otherwise read alike.
expect_error("of a temporary into field 'PlainNodeSlot.p'") {
    void tempDtorlessFieldIntoBraceInit() { PlainNodeSlot q = { p = makeBox().t }; }
}

// A NESTED field of the temp (`makeOutr().inner.p`): the provenance propagates through the
// inner member access, and the OUTER temp is the one destructed at end of statement.
struct Inn { unique Node* p = nullptr; };
struct Outr { Inn inner = default; };
Outr makeOutr() { Outr o = default; o.inner.p = new Node(); return o; }

expect_error("cannot store unique field 'makeOutr.p' of a temporary into a local") {
    void tempDtorlessNestedField() { Node* raw = makeOutr().inner.p; }
}

// PARENTHESES. One token is the whole difference, and the rebuilt NamedVariable behind a
// parenthesized primary kept only Primary/type/storage - so the identical program in brackets
// slipped past every persist site (the review's witness: the issue file's own verbatim repro
// plus one token still use-after-freed). The provenance now rides a side channel next to the
// existing lastParenExprType/Storage ones. Both store paths get a leg; a same-type C-style
// cast is a DIFFERENT path and is still open - see
// internal/issue/p1/temp-unique-field-escapes-through-unguarded-spellings.md.
expect_error("cannot store unique field 'makeBox.t' of a temporary into a longer-lived location") {
    void tempDtorlessParenIntoPlainSlot() { PlainNodeSlot q = default; q.p = (makeBox().t); }
}

expect_error("cannot store unique field 'makeBox.t' of a temporary into a local") {
    void tempDtorlessParenIntoLocal() { Node* raw = (makeBox().t); }
}

// ---------------------------------------------------------------------------------------
// A FAT-INTERFACE owning slot (`Box<unique IShape>::t`). The value is a {vtable,data} struct,
// so it failed BOTH the pointer-shaped ownership gate (IsOwningUniquePointerField's type-arg
// arm requires Pointer) and the `=` site's own isPointerTy() test on the stored value - two
// independent blockers, either one alone enough to keep the leg from firing. The message
// deliberately names 'new' rather than 'move': the written `unique IShape` field spelling
// refuses a `move` source too, so suggesting it would send the user at a dead end.
interface IShape { int area(); };
class Circle : IShape { int r = 3; int area() { return r * r; } };

expect_error("cannot store unique interface field 'a.t' into unique field 'Box") {
    void ifaceFieldToField()
    {
        Box<unique IShape> a = default; a.t = new Circle();
        Box<unique IShape> c = default;
        c.t = a.t;
    }
}

expect_error("cannot store unique interface field 'a.t' into unique field 'Box") {
    void ifaceFieldToFieldBraceInit()
    {
        Box<unique IShape> a = default; a.t = new Circle();
        Box<unique IShape> c = { t = a.t };
    }
}

// The WRITTEN `unique IShape` spelling through brace-init. IsOwningUniquePointerField answers
// TRUE unconditionally for any written `unique`, fat interface included, so the pointer leg won
// and told the user two fields "cannot own one pointer. Use 'move a.s'" - untrue (a fat
// interface is not a pointer) and a closed loop (`move a.s` earns the identical message). The
// destination gate now mirrors the `=` path's value-shape test, so the interface leg wins and
// names 'new', which is verified to work (Test/test_move.cb::uniq_generic_iface_new_*).
struct WrittenIfaceHolder { unique IShape s = default; };

expect_error("cannot store unique interface field 'a.s' into unique field 'WrittenIfaceHolder.s'") {
    void writtenIfaceFieldToFieldBraceInit()
    {
        WrittenIfaceHolder a = default; a.s = new Circle();
        WrittenIfaceHolder c = { s = a.s };
    }
}

// The FAT-INTERFACE form of the dtor-less escape: a `unique IShape` field read off a temp and
// stored into a plain (borrowing) interface field. The pointer-shaped legs above cannot see a
// {vtable,data} value, and the pre-existing interface leg needs an OWNING destination, so this
// compiled and dispatched through a freed box (measured: area() returned 954437177 pre-fix).
struct PlainIfaceSlot { IShape s = default; };
Box<unique IShape> makeIBox() { Box<unique IShape> b = default; b.t = new Circle(); return b; }

expect_error("cannot store unique field 'makeIBox.t' of a temporary into a longer-lived location") {
    void tempIfaceFieldIntoPlainSlot() { PlainIfaceSlot q = default; q.s = makeIBox().t; }
}

// An INTERFACE-typed decl-init is its own branch of ParseDeclaration (IsFatInterfaceValue),
// not the else the pointer legs above land in, so it needed its own call - the review's
// witness dispatched through a box the temp had already freed. The destination wording
// ("an interface local") is the discriminator that proves THIS site fired, not the else.
expect_error("cannot store unique field 'makeIBox.t' of a temporary into an interface local") {
    void tempIfaceFieldIntoIfaceLocal() { IShape s = makeIBox().t; }
}

// NOTE: an interface-field-to-interface-field copy with the SAME field name on both sides is
// still MISSING its diagnostic - two different boxed receivers both carry an empty CallerName
// and the store is misread as a no-op self-assign. It has no leg here because it still
// reproduces; see internal/issue/p1/interface-field-self-assign-false-positive.md, which also
// records why a name-based receiver comparison is NOT the fix.

extern int main()
{
    // A `move` parameter DOES transfer ownership, so the generic unique field may take it -
    // the reject above must not widen into this. Same for a fresh heap allocation.
    Box<unique Node*> b = default;
    b.t = new Node();
    // The remedy the field-to-field message recommends must actually work: `move` transfers
    // out of the source field and nulls it, so there is only ever one owner.
    Holder a = default;
    a.slot = new Node();
    b.t = move a.slot;
    // Same remedy for the FULLY generic shape just rejected above: `move` between two
    // Box<unique Node*> fields must still compile and transfer with a single owner.
    Box<unique Node*> d = default;
    d.t = move b.t;

    // The remedy the TEMP message recommends must actually exist: bind the whole call result
    // to a local, which gives the source field an address, then 'move' out of that local.
    Box<unique Node*> tmp = makeBox();
    Box<unique Node*> e = default;
    e.t = move tmp.t;

    // A fat-interface owning slot still takes a fresh heap object; the field-to-field reject
    // above must not widen into the spelling its own message recommends. (Values for these
    // shapes are asserted in Test/test_move.cb - this file is compiled, never run.)
    Box<unique IShape> bi = default;
    bi.t = new Circle();
    return 0;
}
