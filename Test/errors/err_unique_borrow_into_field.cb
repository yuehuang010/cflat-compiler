// Stage 2 of `unique`: a `unique` field declares that it OWNS its pointee, and the
// synthesized destructor deletes it. Storing a borrowed (non-`move`) parameter into it
// therefore makes two owners - the caller frees on scope exit and the field frees at
// teardown. This is Trap A from internal/plan/ownership-move-alias-discipline.md, which
// is only diagnosable because the field states the ownership claim. `move Node* n` is
// the accepted spelling (covered positively in Test/test_move.cb).
struct Node { int v = 0; };

struct Holder { unique Node* slot = nullptr; };

expect_error("cannot store borrowed parameter 'n' into unique field 'Holder.slot'") {
    void store(Holder* h, Node* n) { h->slot = n; }
}

// The SAME mistake spelled through a generic: substitution marks the field IsUniqueTypeArg,
// not IsUnique, and destructor synthesis ORs the two - so the field was freed identically
// while this reject, keyed on IsUnique alone, never saw it (silent abort, exit 134, no
// diagnostic at all). Pinned to the stable prefix only: the message names the INSTANTIATED
// struct, so the full substring would embed the `Box__unique_Nodeptr` mangling.
struct Box<T> { T t = default; };

expect_error("cannot store borrowed parameter 'n' into unique field 'Box") {
    void storeGeneric(Node* n) { Box<unique Node*> b = default; b.t = n; }
}

// The three field-to-field legs that used to live here (mixed `unique`-into-generic, fully
// generic, and the brace-init form of it) were REMOVED by the 2026-08-10 uniform-implicit-move
// ruling: a plain `=` between two `unique` fields now MOVES instead of being rejected. They are
// value-asserted in Test/test_move.cb::testUniqueFieldImplicitMove (uim_generic_*, uim_brace_*).

/*
 * The ONE field-to-field source shape the uniform implicit move must still refuse: a borrowed
 * BY-VALUE struct parameter. Nulling `h.slot` nulls only the callee's copy, so the caller's
 * struct frees the pointee a second time (silent abort, exit 133). The `move h.slot` spelling
 * already rejects this, so accepting the plain `=` would break the ruling's own invariant that
 * the two spellings mean the same thing. Both field-store paths - `=` and brace-init - are
 * pinned, because each reaches the implicit move independently.
 */
Holder gByValDest = default;

expect_error("cannot consume field 'Holder.slot' out of borrowed by-value parameter 'h'") {
    void byValParamFieldAssign(Holder h) { gByValDest.slot = h.slot; }
}

expect_error("cannot consume field 'Holder.slot' out of borrowed by-value parameter 'h'") {
    void byValParamFieldBraceInit(Holder h) { Holder d = { slot = h.slot }; }
}

// ---------------------------------------------------------------------------------------
// A source read off an owning TEMPORARY. `makeBox().t` never lands on a 2-index field GEP,
// so IsUniqueFieldRead's shape test cannot see it - the temp's own synthesized destructor
// frees the pointee just the same, so the store made two owners (silent abort, exit 134, no
// diagnostic). Closed by the sibling IsUniqueTempFieldRead gate, which reads the temp
// provenance the member-access branch already records instead of widening the shape test.
Box<unique Node*> makeBox() { Box<unique Node*> b = default; b.t = new Node(); return b; }

expect_error("cannot store unique field 'makeBox.t' of a temporary into unique field 'Box") {
    void tempSourceFieldToField() { Box<unique Node*> c = default; c.t = makeBox().t; }
}

// The realistic spelling of the same shape: a BORROWED container element. `list<T>::get`
// returns `alias T`, so the `.t` read is a field of a borrowed temp rather than a call
// result - a different provenance flag (FromOwningTempField, not MovableTempField) reaching
// the same gate, and a DIFFERENT owner - the list, not the temp - so it gets its own wording.
// Naming the call-result remedy here would be wrong twice over: nothing is freed at the end of
// this statement, and binding-then-moving out of the borrowed element double-frees.
expect_error("cannot store unique field 't' borrowed from a temporary into unique field 'Box") {
    void tempElementFieldToField()
    {
        list<Box<unique Node*>> l;
        Box<unique Node*> b = default; b.t = new Node(); l.add(move b);
        Box<unique Node*> c = default;
        c.t = l.get(0).t;
    }
}

// Same temp source through the SECOND field-store path (brace-init / EmitOneFieldInit),
// which applies its own copy of the gate. Reverting the widening only there still
// double-freed here silently.
expect_error("cannot store unique field 'makeBox.t' of a temporary into unique field 'Box") {
    void tempSourceBraceInit() { Box<unique Node*> c = { t = makeBox().t }; }
}

// A pointee with a USER DESTRUCTOR turned the same temp source into a COMPILER CRASH
// (SIGSEGV, exit 139, zero output) when the destination was NOT a unique field: the
// implied-move-of-a-move-temp's-owning-field branch fired on a POINTER field and emitted the
// pointee's destructor against the destination SLOT's address, producing IR that killed
// LLVM's DAG combiner. That branch is for owning VALUE types only; a pointer source now
// falls through to the owning-temp-field reject, which is the correct diagnosis.
class Dtored { int v = default; ~Dtored() {} };
struct PlainSlot { Dtored* p = nullptr; };
Box<unique Dtored*> makeDtored() { Box<unique Dtored*> b = default; b.t = new Dtored(); return b; }

expect_error("taken from a temporary into a longer-lived location") {
    void tempPointerFieldIntoPlainSlot() { PlainSlot q = default; q.p = makeDtored().t; }
}

// The SAME crash through the DECLARATION-with-initializer spelling. That path has its own
// copy of the implied-move capture (ParseDeclaration, `srcMovableTempField`) reaching the
// same aggregate-zero store, so guarding only the `=` twin left this one crashing: the
// assignment spelling above is diagnosed while `Dtored* raw = makeDtored().t;` still died at
// exit 139. Half-a-fix along the spelling axis is the recorded failure mode for this family.
expect_error("taken from a temporary to a local") {
    void tempPointerFieldIntoDeclaredLocal() { Dtored* raw = makeDtored().t; }
}

// And the THIRD copy of the same implied-move capture: the RETURN path (ParseStatement's jump
// handling). Same aggregate-zero store, same exit-139 crash, and guarding the assignment and
// declaration twins left this one dying. N-1 sites fixed is the recorded failure mode here.
expect_error("taken from a temporary; its buffer is owned elsewhere") {
    Dtored* returnTempPointerField() { return makeDtored().t; }
}

// ---------------------------------------------------------------------------------------
// THE DTOR-LESS POINTEE. Every reject above is keyed on IsOwningValueType(TypeName), which is
// true only when the POINTEE has a destructor. `Node` has none, so the identical programs
// compiled clean, ran, printed a plausible value and exited 0 - a silent use-after-free
// (measured: under MallocScribble=1 the read returns 1431655765, the 0x55 fill). The
// discriminator that was missing is the TEMP's own synthesized destructor, which frees the
// pointee at the end of the statement whoever the destination is; the new gate
// (IsOwningTempUniqueFieldEscape) reads that provenance instead of the pointee's type name.
// Every leg below compiles and runs on the pre-fix binary, so each is non-vacuous on its own.
struct PlainNodeSlot { Node* p = nullptr; };

expect_error("cannot store unique field 'makeBox.t' of a temporary into a longer-lived location") {
    void tempDtorlessFieldIntoPlainSlot() { PlainNodeSlot q = default; q.p = makeBox().t; }
}

// The DECLARATION spelling - a separate copy of the gate in ParseDeclaration. Reverting only
// that copy leaves this leg compiling while the assignment leg above still fails.
expect_error("cannot store unique field 'makeBox.t' of a temporary into a local") {
    void tempDtorlessFieldIntoLocal() { Node* raw = makeBox().t; }
}

// The RETURN spelling - the third copy, in ParseStatement's jump handling.
expect_error("cannot store unique field 'makeBox.t' of a temporary into the return value") {
    Node* returnTempDtorlessField() { return makeBox().t; }
}

// The BRACE-INIT store path (EmitOneFieldInit), whose destination field only BORROWS - the
// pre-existing temp gate there requires an owning `unique` destination and declines. This
// destination names itself in the message, which is how the brace path is told from the `=`
// path when both would otherwise read alike.
expect_error("of a temporary into field 'PlainNodeSlot.p'") {
    void tempDtorlessFieldIntoBraceInit() { PlainNodeSlot q = { p = makeBox().t }; }
}

// A NESTED field of the temp (`makeOutr().inner.p`): the provenance propagates through the
// inner member access, and the OUTER temp is the one destructed at end of statement.
struct Inn { unique Node* p = nullptr; };
struct Outr { Inn inner = default; };
Outr makeOutr() { Outr o = default; o.inner.p = new Node(); return o; }

expect_error("cannot store unique field 'makeOutr.p' of a temporary into a local") {
    void tempDtorlessNestedField() { Node* raw = makeOutr().inner.p; }
}

// PARENTHESES. One token is the whole difference, and the rebuilt NamedVariable behind a
// parenthesized primary kept only Primary/type/storage - so the identical program in brackets
// slipped past every persist site (the review's witness: the issue file's own verbatim repro
// plus one token still use-after-freed). The provenance now rides a side channel next to the
// existing lastParenExprType/Storage ones. Both store paths get a leg. A same-type C-style cast
// is a DIFFERENT path and was open until 2026-08-05; its legs are in the next section.
expect_error("cannot store unique field 'makeBox.t' of a temporary into a longer-lived location") {
    void tempDtorlessParenIntoPlainSlot() { PlainNodeSlot q = default; q.p = (makeBox().t); }
}

expect_error("cannot store unique field 'makeBox.t' of a temporary into a local") {
    void tempDtorlessParenIntoLocal() { Node* raw = (makeBox().t); }
}

// ---------------------------------------------------------------------------------------
// A FAT-INTERFACE owning slot (`Box<unique IShape>::t`). The value is a {vtable,data} struct,
// so it failed BOTH the pointer-shaped ownership gate (IsOwningUniquePointerField's type-arg
// arm requires Pointer) and the `=` site's own isPointerTy() test on the stored value - two
// independent blockers, either one alone enough to keep the leg from firing. The message
// deliberately names 'new' rather than 'move': the written `unique IShape` field spelling
// refuses a `move` source too, so suggesting it would send the user at a dead end.
interface IShape { int area(); };
class Circle : IShape { int r = 3; int area() { return r * r; } };

// The three `unique IShape` FIELD-to-field legs that used to live here (`=`, brace-init, and the
// written-spelling brace form) were REMOVED by the 2026-08-10 uniform-implicit-move ruling: the
// store now zeroes the source fat slot and releases the destination's old box. Value-asserted in
// Test/test_move.cb::testUniqueFieldImplicitMove (uim_ifacefield_*).
struct WrittenIfaceHolder { unique IShape s = default; };

// The FAT-INTERFACE form of the dtor-less escape: a `unique IShape` field read off a temp and
// stored into a plain (borrowing) interface field. The pointer-shaped legs above cannot see a
// {vtable,data} value, and the pre-existing interface leg needs an OWNING destination, so this
// compiled and dispatched through a freed box (measured: area() returned 954437177 pre-fix).
struct PlainIfaceSlot { IShape s = default; };
Box<unique IShape> makeIBox() { Box<unique IShape> b = default; b.t = new Circle(); return b; }

expect_error("cannot store unique field 'makeIBox.t' of a temporary into a longer-lived location") {
    void tempIfaceFieldIntoPlainSlot() { PlainIfaceSlot q = default; q.s = makeIBox().t; }
}

// An INTERFACE-typed decl-init is its own branch of ParseDeclaration (IsFatInterfaceValue),
// not the else the pointer legs above land in, so it needed its own call - the review's
// witness dispatched through a box the temp had already freed. The destination wording
// ("an interface local") is the discriminator that proves THIS site fired, not the else.
expect_error("cannot store unique field 'makeIBox.t' of a temporary into an interface local") {
    void tempIfaceFieldIntoIfaceLocal() { IShape s = makeIBox().t; }
}

// ---------------------------------------------------------------------------------------
// THE SPELLINGS THAT LOST THE PROVENANCE. A same-type C-style CAST rewrites TypeAndValue and
// a `?:` / `??` JOIN delivers a PHI (or a load out of a slot), so by the time either reaches a
// persist site every declared fact the gate above reads is gone - each of these compiled
// clean, ran and printed 1431655765 (the MallocScribble 0x55 fill) on the pre-fix binary.
// Closed by ledgering the READ by llvm::Value identity (owningTempUniqueFields_) and walking
// the join arms, which is the record-then-resolve shape this repo already uses for code values.
// The cast legs still quote the field name (the NamedVariable survives the cast); the join
// legs cannot, because a PHI has no name to quote, so they get their own wording.

expect_error("cannot store unique field 'makeBox.t' of a temporary into a local") {
    void tempDtorlessCastIntoLocal() { Node* raw = (Node*)makeBox().t; }
}

expect_error("cannot store unique field 'makeBox.t' of a temporary into a longer-lived location") {
    void tempDtorlessCastIntoPlainSlot() { PlainNodeSlot q = default; q.p = (Node*)makeBox().t; }
}

// The CAST-OF-PARENTHESIZED operand is a different program from the bare one: the parenthesized
// primary is rebuilt from the lastParenExpr* side channel and the cast then rewrites THAT
// NamedVariable, so both halves of the provenance chain have to hold for this leg to fire.
expect_error("cannot store unique field 'makeBox.t' of a temporary into the return value") {
    Node* returnTempDtorlessCastParen() { return (Node*)(makeBox().t); }
}

// The '??' join. Its arms are unrecoverable from the IR (it joins through a slot, so the
// joined value is a plain load), which is why the walk consults nullCoalesceJoins_ rather
// than the PHI - the '?:' leg below is the one that exercises the PHI walk.
expect_error("reached through a cast or a '?:' / '??' join, into a local") {
    void tempDtorlessCoalesceIntoLocal() { Node* raw = makeBox().t ?? nullptr; }
}

// The '?:' join, whose arms ARE the PHI's incoming values. ANY dangling arm answers yes: here
// only the TRUE arm reads the temp field, and one arm is enough to leave the destination
// pointing at freed memory.
expect_error("reached through a cast or a '?:' / '??' join, into a longer-lived location") {
    void tempDtorlessTernaryIntoPlainSlot()
    {
        PlainNodeSlot q = default;
        int c = 1;
        q.p = c > 0 ? makeBox().t : nullptr;
    }
}

// NESTED spellings - a cast over a join, and a join over a cast. Each needs the walk to
// recurse through the other's shape rather than stopping at the outermost one.
/*
 * The '??=' STORE spelling of the two shapes above. It is a different path from the '??' join
 * expression already covered: on the merge base '??=' emitted its own compare/branch/store and
 * RETURNED before every persist site, so neither escape gate could see it. Both were measured
 * memory-unsafe there - the bare form left the owning temp unregistered (dtors=0, a leak) and the
 * join form registered it, freed it at end of statement and left the destination dangling
 * (v=1431655765, dtors=1). Discriminator: each leg pins the wording of the gate the '=' oracle
 * fires for the SAME right-hand side (measured: 'raw = makeBox().t;' gives the bare wording,
 * 'raw = c > 0 ? makeBox().t : nullptr;' the join one), so a leg passing on the other gate's
 * message would be visible. Each block is armed and checked on its own, and the only store in
 * either is the '??=', so no earlier site can satisfy them.
 */
expect_error("cannot store unique field 'makeBox.t' of a temporary into a longer-lived location") {
    void tempDtorlessNullAssignBare() { Node* raw = nullptr; raw ??= makeBox().t; }
}

expect_error("reached through a cast or a '?:' / '??' join, into a longer-lived location") {
    void tempDtorlessNullAssignJoin()
    {
        int c = 1;
        Node* raw = nullptr;
        raw ??= c > 0 ? makeBox().t : nullptr;
    }
}

expect_error("reached through a cast or a '?:' / '??' join, into a local") {
    void tempDtorlessCastOfJoin() { Node* raw = (Node*)(makeBox().t ?? nullptr); }
}

expect_error("reached through a cast or a '?:' / '??' join, into a local") {
    void tempDtorlessJoinOfCast() { Node* raw = ((Node*)makeBox().t) ?? nullptr; }
}

// ---------------------------------------------------------------------------------------
// THE ARRAY AGGREGATE INITIALIZER. `Node*[2] a = { makeBox().t, nullptr };` is lowered by
// EmitPositionalFixedArrayInit, not by EmitOneFieldInit, so the brace-init leg above could
// never see it - it was a silent use-after-free even for the BARE spelling. The element index
// in the message is what proves this site fired rather than a declarator or assignment gate.
expect_error("of a temporary into element 0 of array 'aggFixed'") {
    void tempDtorlessArrayAggregate() { Node*[2] aggFixed = { makeBox().t, nullptr }; }
}

// The array-VIEW twin (EmitArrayViewInferredInit), a third separate lowering. Element 1 here,
// so the leg cannot pass by accidentally matching the fixed-array leg's wording.
expect_error("of a temporary into element 1 of array 'aggView'") {
    void tempDtorlessArrayViewAggregate() { Node*[] aggView = { nullptr, (Node*)makeBox().t }; }
}

// ---------------------------------------------------------------------------------------
// A `unique T*` / `move T*` PARAMETER. The store happens in the CALLEE, so a call site cannot
// in general tell a storing argument from a read-only one - but these two parameter spellings
// state the ownership claim AT the call site, which makes them decidable there. A plain `T*`
// parameter is the undecidable remainder and deliberately still compiles; the read-only
// `rd(makeBox().t)` that depends on it is frozen as an accept leg in Test/test_move.cb.
// The message names the CALLEE and the PARAMETER, which is what tells this site from a store.
void sinkUnique(unique Node* n) { }
void sinkMove(move Node* n) { delete n; }

expect_error("call to 'sinkUnique': cannot pass a unique field of a temporary to parameter 'n'") {
    void tempDtorlessIntoUniqueParam() { sinkUnique(makeBox().t); }
}

// The `move` parameter spelling, through a CAST - both halves (the parameter kind and the
// ledger walk past the cast) have to hold, so this cannot pass for the reason above does.
expect_error("call to 'sinkMove': cannot pass a unique field of a temporary to parameter 'n'") {
    void tempDtorlessCastIntoMoveParam() { sinkMove((Node*)makeBox().t); }
}

// ---------------------------------------------------------------------------------------
// A PLAIN `T*` parameter. The claim is NOT stated at the call site, so these are answered by
// a CALLEE-side fact - ParameterProvablyRetainsArgument, which walks the callee body and
// reports true ONLY when the parameter provably reaches memory that outlives the call. Every
// unmodelled shape answers false, so the read-only `rd(makeBox().t)` and its neighbours in
// Test/test_move.cb stay legal. That is what tells these legs from the two sink-parameter
// legs above: the message quotes the DESTINATION KIND the walk proved, which the sink
// legs' message has no way to know. All six were silent use-after-free before this guard
// (measured -o + run: `v=99 same=1 dtors=1`, the allocator-reuse witness).
Node* gStore = nullptr;
void keepGlobal(Node* n) { gStore = n; }
void keepOut(Node* n, Node** out) { *out = n; }
void keepForward(Node* n) { keepGlobal(n); }
struct NodeKeeper { Node* p = nullptr; void take(Node* n) { this.p = n; } };

expect_error("call to 'keepGlobal': cannot pass unique field 'makeBox.t' of a temporary to plain pointer parameter 'n' - 'keepGlobal' stores that pointer into a global") {
    void tempDtorlessIntoStoringPlainParam() { keepGlobal(makeBox().t); }
}

// A DIFFERENT destination kind, so this leg cannot pass for the global leg's reason: the
// store lands in memory the CALLER supplied through a NAMED parameter, and the message quotes
// that parameter's source name - the raw llvm index would have printed a number.
expect_error("'keepOut' stores that pointer into memory the caller supplied through parameter 'out'") {
    void tempDtorlessIntoOutParamCallee() { Node* o = nullptr; keepOut(makeBox().t, &o); }
}

// TRANSITIVE: `keepForward` itself only forwards; the proof comes from recursing into
// `keepGlobal`. Quotes the OUTER callee, which is where the argument was passed.
expect_error("call to 'keepForward': cannot pass unique field 'makeBox.t' of a temporary to plain pointer parameter 'n'") {
    void tempDtorlessIntoForwardingCallee() { keepForward(makeBox().t); }
}

// A METHOD, where the store lands in memory reached through the implicit receiver rather
// than a global. ForwardRefScanner puts the receiver INTO FunctionSymbol::Parameters (named
// `<Struct>__`), so the llvm arity and the cflat parameter list line up 1:1 - what this leg
// proves is that BOTH halves of the message name the receiver correctly: the offending
// parameter is still 'n', and the DESTINATION is described as the receiver object, not as
// "parameter 1", which is what the raw llvm index would have printed.
expect_error("call to 'take': cannot pass unique field 'makeBox.t' of a temporary to plain pointer parameter 'n' - 'take' stores that pointer into memory the caller supplied through the receiver object") {
    void tempDtorlessIntoStoringMethod() { NodeKeeper k = default; k.take(makeBox().t); }
}

// The RECEIVER itself is the temp's unique field: `makeBox().t->park()` where `park` stores
// `this`. Zero coverage before review round 1, and a live use-after-free on the PRE binary
// (`v=99 same=1 dtors=1`). It gets its OWN wording - a receiver is not a parameter the caller
// can re-declare, so `move` is not a remedy for it and the message must not offer one, and the
// no-name fallback must not claim a cast or a join it did not go through.
NodeSelf* gSelfKept = nullptr;
struct NodeSelf { int v = 0; void park() { gSelfKept = this; } };
struct SelfBox<T> { T t = default; };
SelfBox<unique NodeSelf*> makeSelfBox() { SelfBox<unique NodeSelf*> b = default; b.t = new NodeSelf(); return b; }

expect_error("call to method 'park': the receiver is a unique field of a temporary - 'park' stores the receiver into a global") {
    void tempDtorlessAsMethodReceiver() { makeSelfBox().t->park(); }
}

// The CAST and JOIN spellings reach the same callee-side fact through the value ledger, and
// carry the no-name wording because neither survives with a NamedVariable to quote.
expect_error("cannot pass a unique field of a temporary, reached through a '?:' / '??' join to plain pointer parameter 'n' - 'keepGlobal' stores") {
    void tempDtorlessJoinIntoStoringPlainParam() { int c = 1; keepGlobal(c > 0 ? makeBox().t : nullptr); }
}

// The CAST spelling keeps the quoted name (the NamedVariable survives), which is the
// discriminator between the two wordings - so this leg cannot pass for the join leg's reason.
expect_error("call to 'keepGlobal': cannot pass unique field 'makeBox.t' of a temporary to plain pointer parameter 'n'") {
    void tempDtorlessCastIntoStoringPlainParam() { keepGlobal((Node*)makeBox().t); }
}

// ---------------------------------------------------------------------------------------
// INTERFACE DISPATCH. A virtual call has no `getCalledFunction()` to ask, but the implementor
// set IS closed at end of module, so the slot is judged against EVERY implementor. The rule is
// ALL-of-implementors: one implementor that does not store would make this message false on
// that dispatch, so the MIXED shape stays legal and is frozen as an accept leg in
// Test/test_move.cb. All three legs below were silent use-after-free before this guard
// (measured -o + run: the store aliased a freshly reallocated block, `same=1`).
Node* gIfaceKept = nullptr;
interface IKeepOne { void ifaceKeep(Node* n); };
class KeepOneC : IKeepOne { void ifaceKeep(Node* n) { gIfaceKept = n; } };

expect_error("call to interface method 'IKeepOne.ifaceKeep': cannot pass unique field 'makeBox.t' of a temporary to plain pointer parameter 'n' - every implementor of this method stores that pointer into memory that outlives the call ('KeepOneC.ifaceKeep' stores it into a global)") {
    void tempDtorlessIntoStoringIfaceSlot() { KeepOneC k = default; IKeepOne it = k; it.ifaceKeep(makeBox().t); }
}

// TWO implementors, both storing, into DIFFERENT destination kinds. This leg cannot pass for
// the single-implementor leg's reason: the message COUNTS the implementors the proof covered,
// which is what says the ALL rule actually visited more than the first one.
Node* gIfaceKept2 = nullptr;
interface IKeepBoth { void ifaceKeepBoth(Node* n); };
class KeepBothA : IKeepBoth { void ifaceKeepBoth(Node* n) { gIfaceKept2 = n; } };
class KeepBothB : IKeepBoth { Node* p = nullptr; void ifaceKeepBoth(Node* n) { this.p = n; } };

expect_error("all 2 implementors store it, e.g. 'KeepBothA.ifaceKeepBoth' into a global") {
    void tempDtorlessIntoTwoStoringIfaceSlots() { KeepBothA k = default; IKeepBoth it = k; it.ifaceKeepBoth(makeBox().t); }
}

// The RETURN side of the same closed world. Every implementor may hand the parameter straight
// back, so the result IS the temp's unique field: the re-ledger relabels it and the existing
// declaration guard fires. Its ACCEPT twin (an implementor returning something else) is in
// Test/test_move.cb, and that is what makes the ALL polarity here observable.
interface IPassOne { Node* ifacePassOne(Node* n); };
class PassOneC : IPassOne { Node* ifacePassOne(Node* n) { return n; } };

expect_error("cannot store the result of 'IPassOne.ifacePassOne' into a local - 'IPassOne.ifacePassOne' may return its argument, which here is unique field 'makeBox.t' of a temporary") {
    void tempDtorlessLaunderedThroughIfaceReturn() { PassOneC p = default; IPassOne ip = p; Node* b = ip.ifacePassOne(makeBox().t); }
}

// The DIRECT-call twin of the same return-side laundering, with the callee written ABOVE its
// call site so the proof is answerable during the walk. This is the tripwire for the deferred
// leg in err_temp_unique_field_return_deferred.cb: the two must produce the SAME message, or the
// user can tell which pass caught it. Its ACCEPT twins are in Test/test_move.cb.
Node* earlyPassNode(Node* n) { return n; }

expect_error("cannot store the result of 'earlyPassNode' into a local - 'earlyPassNode' may return its argument, which here is unique field 'makeBox.t' of a temporary") {
    void tempDtorlessLaunderedThroughEarlyReturn() { Node* b = earlyPassNode(makeBox().t); }
}

// NOTE: an interface-field-to-interface-field copy with the SAME field name on both sides is
// rejected as of 2026-08-05 - two different boxed receivers still both carry an empty CallerName,
// so they are told apart by the OBJECT each box wraps. Its legs live in
// err_unique_field_to_field.cb, beside the plain field-to-field shape they mirror.

extern int main()
{
    // A `move` parameter DOES transfer ownership, so the generic unique field may take it -
    // the reject above must not widen into this. Same for a fresh heap allocation.
    Box<unique Node*> b = default;
    b.t = new Node();
    // The remedy the field-to-field message recommends must actually work: `move` transfers
    // out of the source field and nulls it, so there is only ever one owner.
    Holder a = default;
    a.slot = new Node();
    b.t = move a.slot;
    // Same remedy for the FULLY generic shape just rejected above: `move` between two
    // Box<unique Node*> fields must still compile and transfer with a single owner.
    Box<unique Node*> d = default;
    d.t = move b.t;

    // The remedy the TEMP message recommends must actually exist: bind the whole call result
    // to a local, which gives the source field an address, then 'move' out of that local.
    Box<unique Node*> tmp = makeBox();
    Box<unique Node*> e = default;
    e.t = move tmp.t;

    // A fat-interface owning slot still takes a fresh heap object; the field-to-field reject
    // above must not widen into the spelling its own message recommends. (Values for these
    // shapes are asserted in Test/test_move.cb - this file is compiled, never run.)
    Box<unique IShape> bi = default;
    bi.t = new Circle();
    return 0;
}
