    }
}

expect_error("cannot move a borrowed pointer; move from the owning slot") {
    int fldcopy2ErrDynNestedMemberStore(int i)
    {
        Fc2E x = default; Fc2EH[2] sa = default; sa[i % 2].arr[1] = &x;
        unique Fc2E* t = move sa[0].arr[1];
        return t->k;
    }
}

expect_error("cannot move a borrowed pointer; move from the owning slot") {
    int fldcopy2ErrDyn2DKeepsBorrow(int i)
    {
        Fc2E x = default; Fc2E*[2][2] g = default; g[0][1] = &x;
        g[i][1] = nullptr; unique Fc2E* t = move g[0][1];
        return t->k;
    }
}

// Review r1: a member array decay escapes only its own elements; a join arm keeps its slot fact
// when the other arm first instantiates a generic; a static owned store on one branch only.
void fc2EFill(Fc2E** a) { a[0] = new Fc2E(); a[1] = new Fc2E(); }
unique T* fc2EMake<T>() { return new T(); }

expect_error("cannot move a borrowed pointer; move from the owning slot") {
    int fldcopy2ErrMemberDecayKeepsOther()
    {
        Fc2E x = default; Fc2EH h = default; h.p = &x; fc2EFill(h.arr);
        unique Fc2E* t = move h.p;
        return t->k;
    }
}

expect_error("cannot move a borrowed pointer; move from the owning slot") {
    int fldcopy2ErrJoinArmGenericFirstUse(bool c)
    {
        Fc2E x = default; Fc2EH h = default; h.p = &x;
        unique Fc2E* t = move (c ? h.p : fc2EMake<Fc2E>());
        return t->k;
    }
}

expect_error("cannot move a borrowed pointer; move from the owning slot") {
    int fldcopy2ErrWideDynOneBranchOwned(bool c, int i)
    {
        Fc2E x = default; Fc2E*[100] a = default; a[i] = &x;
        if (c) a[0] = new Fc2E();
        unique Fc2E* t = move a[0];
        return t->k;
    }
}

