// A virtual base sits at a per-dynamic-type offset: converting a reference result, a dereferenced
// pointer or an alias parameter would read the static complete-object offset, so it is refused.
import cpp "cpp_t26_vbase.hpp";

int viaAlias(alias t26v.left left)
{
    t26v.sink sink = default;
    expect_error("needs the object's dynamic type");
    return sink.read(left);
}

extern int main()
{
    t26v.sink sink = default;
    expect_error("needs the object's dynamic type") {
        int fromRef = sink.read(t26v.held());
    }
    // The base conversion outranks operator int, so the refusal names it instead of picking int.
    expect_error("needs the object's dynamic type") {
        int picked = sink.pick(t26v.held());
    }
    expect_error("needs the object's dynamic type") {
        t26v.sink fromRef = t26v.sink(t26v.held());
    }
    expect_error("needs the object's dynamic type") {
        t26v.left* p = &t26v.held();
        int fromDeref = sink.read(*p);
    }
    return 0;
}
