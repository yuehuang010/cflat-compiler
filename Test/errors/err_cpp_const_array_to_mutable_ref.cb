expect_error("no overload") {
    int enum_array_to_unsigned_pointer_ctor_error() {
        cpp_ptrref.ArraySubscriptElem[3] a = {cpp_ptrref.ArraySubscriptElemA,
            cpp_ptrref.ArraySubscriptElemB, cpp_ptrref.ArraySubscriptElemC};
        return cpp_ptrref.array_conversion_unsigned_pick(a);
    }
}
expect_error("array_conversion_twins") {
    int array_to_ambiguous_classes_error() {
        int[3] a = {1, 2, 3};
        return cpp_ptrref.array_conversion_twins(a);
    }
}
expect_error("array_conversion_dual") {
    int array_to_byvalue_or_constref_error() {
        int[3] a = {1, 2, 3};
        return cpp_ptrref.array_conversion_dual(a);
    }
}
