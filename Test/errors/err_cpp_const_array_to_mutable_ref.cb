expect_error("no overload") {
    int array_grid_to_flat_pointer_ctor_error() {
        int[2][3] a = {{1, 2, 3}, {4, 5, 6}};
        return cpp_ptrref.array_conversion_only_pick(a);
    }
}
expect_error("no overload") {
    int pointer_to_row_ctor_error() {
        int value = 1;
        int* p = &value;
        return cpp_ptrref.array_conversion_row_pick(p);
    }
}
expect_error("no overload") {
    int const_grid_to_mutable_row_ctor_error() {
        const int[2][3] a = {{1, 2, 3}, {4, 5, 6}};
