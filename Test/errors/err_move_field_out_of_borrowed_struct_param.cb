// 'move h.p' where h is a BORROWED by-value struct parameter nulls only the callee's copy of
// the field; the caller's original still holds the pointer, so both synthesized destructors
// free it. Declaring the parameter 'move' makes the callee the owner and the move legal.

struct Payload { int v = 0; };
struct Holder  { unique Payload* p = nullptr; };

Holder stash = default;

expect_error("cannot 'move' field 'Holder.p' out of borrowed parameter 'h'") {
    void badFieldMove(Holder h) { stash.p = move h.p; }
}

// The same field move out of an OWNED ('move') parameter is the sanctioned transfer.
void goodFieldMove(move Holder h) { stash.p = move h.p; }

/*
 * The IMPLICIT consuming stores of the same field. Every one of these used to compile and
 * abort with a double free at the caller's teardown (rc 133): the store zeroed the callee's
 * bit copy of `w.b` while the caller's `Wrap` still owned - and freed - the same Res.
 * `UBox` is a NON-copyable owner (it holds a `unique`), so each store below classifies as a
 * MOVE; that is the discriminator that reaches the consume arm the guard sits in. The
 * copyable-field and 'move'-parameter twins in Test/test_move.cb pin the accept side.
 */
struct Res  { int id = 0; };
struct UBox { unique Res* item = nullptr; };
struct Wrap { UBox b; };
struct Mid  { UBox b; };
struct Nest { Mid a; };

UBox makeBorrowedDestinationBox()
{
    UBox b = default;
    b.item = new Res();
    return b;
}

UBox gsink = default;

expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badDeclInit(Wrap w) { UBox o = w.b; return o.item->id; }
}

expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badAssign(Wrap w) { UBox o = default; o = w.b; return o.item->id; }
}

expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badArrayElement(Wrap w) { UBox[2] dst = default; dst[0] = w.b; return dst[0].item->id; }
}

expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badBraceElement(Wrap w) { UBox[2] dst = { w.b }; return dst[0].item->id; }
}

// The `T[]` VIEW element destination. It is a single-index GEP - a container slot's shape - so
// before the view-element arm existed there was no consume arm here to hang the guard on, and the
// store silently aliased the caller's field (rc 133). The fixed-array spelling is two lines above.
expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badViewElement(Wrap w) { UBox[] v = new UBox[2]; v[0] = w.b; return v[0].item->id; }
}

expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badDerefDest(Wrap w) { UBox o = default; UBox* dp = &o; *dp = w.b; return o.item->id; }
}

expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badGlobalDest(Wrap w) { gsink = w.b; return gsink.item->id; }
}

// The RETURN position - the seventh consume arm. It is the one consuming spelling of `w.b` that
// still compiled after the six store arms were routed through this guard, and it double-freed
// (rc 133) exactly as they did. Its accept twins are the rfld_* legs in Test/test_move.cb.
expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    UBox badReturn(Wrap w) { return w.b; }
}

// A NESTED field path roots at the same borrowed parameter: 'w' owns nothing here either.
expect_error("cannot consume field 'Mid.b' out of borrowed parameter 'w'") {
    int badNestedPath(Nest w) { UBox o = w.a.b; return o.item->id; }
}

// The explicit spelling of the nested path, which used to slip past the 'move' guard
// because the immediate parent of `.b` is the field `a`, not the parameter.
expect_error("cannot 'move' field 'Mid.b' out of borrowed parameter 'w'") {
    int badNestedMove(Nest w) { UBox o = move w.a.b; return o.item->id; }
}

// An ELEMENT of an owning ARRAY field of the same borrowed parameter. The message names the
// owning array field, not the slot: IsElementAccess is not set on the source here, and the
// field / parameter / remedy it does name are all correct.
struct AWrap { UBox[2] arr; };

expect_error("cannot consume field 'AWrap.arr' out of borrowed parameter 'w'") {
    int badArrayFieldElement(AWrap w) { UBox o = w.arr[0]; return o.item->id; }
}

// Binding the array field to a view is another hop: the view local must retain the field root.
expect_error("cannot consume field 'AWrap.arr' out of borrowed parameter 'w'") {
    UBox badViewBound(AWrap w) { UBox[] v = w.arr; return v[0]; }
}

// Reassignment drops the old field value, so a borrowed by-value destination cannot be overwritten.
expect_error("cannot assign owning field 'Wrap.b' of borrowed parameter 'w'") {
    void badOwningFieldDestination(Wrap w) { w.b = makeBorrowedDestinationBox(); }
}

/*
 * NOT rejected, and pinned here so the guard's polarity stays visible next to its reject legs:
 * an inner local SHADOWING the parameter owns its own storage, so consuming its field is legal.
 * The value legs (caller's resource still live, two frees) are in Test/test_move.cb as
 * cbvf_shadow_* / cbvf_shadowmove_* / cbvf_shadowloop_*.
 */
int okShadowedLocal(Wrap w) { { Wrap w; w.b.item = new Res(); UBox o = w.b; return o.item == nullptr ? 0 : 1; } }

/*
 * WRAPPER SPELLINGS of the same consume. A parenthesis and a REDUNDANT same-type cast change the
 * spelling, never the value, but the parenthesized primary dropped the operand's OwningStructName
 * / FieldName / FieldPathRoot / RootIsBorrowedByValueParam, so this guard could not see the source
 * at all: every leg below COMPILED and double-freed (rc 133/134) while its bare twin above was
 * already a hard error. A TYPE-CHANGING cast is not a whole-value consume and is not covered here
 * (its accept legs are wcp_typechanging_* in Test/test_move.cb).
 */
expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badDeclInitParen(Wrap w) { UBox o = (w.b); return o.item->id; }
}

expect_error("cannot 'move' field 'Wrap.b' out of borrowed parameter 'w'") {
    int badMoveParen(Wrap w) { UBox o = move (w.b); return o.item->id; }
}

// The paren around the RECEIVER rather than the whole path - a different parse (the postfix
// chain's base is the parenthesized primary). COVERAGE, not a discriminator: this spelling
// already rejected before the fix (the field access still ran against the resolved parent), and
// the leg is here so the provenance threading cannot silently LOSE that rejection.
expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    int badDeclInitParenRecv(Wrap w) { UBox o = (w).b; return o.item->id; }
}

// The RETURN position under a paren. The GEP-shape return arm already CONSUMED this spelling, so
// it was the worst of the set: a silent consume with the guard blind, rc 133 with no diagnostic.
expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    UBox badReturnParen(Wrap w) { return (w.b); }
}

// The redundant CAST and `as` spellings of that same return. The `(UBox)` form already rejected
// before the fix (the cast kept FieldName, only Storage was lost, and the return arm bailed
// earlier) - it is a coverage leg. The `as` form is the discriminator: it compiled and rc-133'd.
expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    UBox badReturnCast(Wrap w) { return (UBox)w.b; }
}

expect_error("cannot consume field 'Wrap.b' out of borrowed parameter 'w'") {
    UBox badReturnAs(Wrap w) { return w.b as UBox; }
}

// A NESTED path under a wrapper: the recorded FieldPathRoot has to survive the peel too.
expect_error("cannot consume field 'Mid.b' out of borrowed parameter 'w'") {
    int badNestedPathParen(Nest w) { UBox o = (w.a.b); return o.item->id; }
}

extern int main() { return 0; }
