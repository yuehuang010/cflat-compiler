// Unknown parameter counts cannot be stored in persistent views.
expect_error("cannot pass an array view with unknown length") {
    int svErrStaticUnknownParamForeachWriter(int[] values) {
        static int[] view = svErrStaticBase;
        int result = 0; for (int item in view) result++;
        view = values;
        return 0;
    }
    int svErrStaticUnknownParamForeachCaller(int* raw) { return svErrStaticUnknownParamForeachWriter((int[])raw); }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticUnknownParamLengthWriter(int[] values) {
        static int[] view = svErrStaticBase;
        int result = svErrViewLength(view);
        view = values;
        return 0;
    }
    int svErrStaticUnknownParamLengthCaller(int* raw) { return svErrStaticUnknownParamLengthWriter((int[])raw); }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticUnknownParamCountreaderWriter(int[] values) {
        static int[] view = svErrStaticBase;
        int result = svErrCountReader(view);
        view = values;
        return 0;
    }
    int svErrStaticUnknownParamCountreaderCaller(int* raw) { return svErrStaticUnknownParamCountreaderWriter((int[])raw); }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrGlobalUnknownParamForeachRead() { int n = 0; for (int item in svErrGlobalTarget) n++; return n; }
    void svErrGlobalUnknownParamForeachWriter(int[] values) { svErrGlobalTarget = values; }
    int svErrGlobalUnknownParamForeachCaller(int* raw) { svErrGlobalUnknownParamForeachWriter((int[])raw); return svErrGlobalUnknownParamForeachRead(); }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrGlobalUnknownParamLengthRead() { return svErrViewLength(svErrGlobalTarget); }
    void svErrGlobalUnknownParamLengthWriter(int[] values) { svErrGlobalTarget = values; }
    int svErrGlobalUnknownParamLengthCaller(int* raw) { svErrGlobalUnknownParamLengthWriter((int[])raw); return svErrGlobalUnknownParamLengthRead(); }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrGlobalUnknownParamCountreaderRead() { return svErrCountReader(svErrGlobalTarget); }
    void svErrGlobalUnknownParamCountreaderWriter(int[] values) { svErrGlobalTarget = values; }
    int svErrGlobalUnknownParamCountreaderCaller(int* raw) { svErrGlobalUnknownParamCountreaderWriter((int[])raw); return svErrGlobalUnknownParamCountreaderRead(); }
}

// A raw-cast write to a static struct field makes every read in the function unknown-count.
struct SvErrStaticFieldHolder { int[] view = default; };
