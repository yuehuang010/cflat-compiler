        static SvErrStaticFieldHolder holder = default;
        if (second == 0) holder.view = svErrStaticBase;
        int result = 0; for (int item in holder.view) result++;
        if (second == 0) holder.view = (int[])raw;
        return result;
    }
}
expect_error("cannot pass an array view with unknown length") {
    int svErrStaticFieldRawLength(int* raw, int second) {
        static SvErrStaticFieldHolder holder = default;
        if (second == 0) holder.view = svErrStaticBase;
        int result = svErrViewLength(holder.view);
        if (second == 0) holder.view = (int[])raw;
        return result;
    }
}
expect_error("cannot pass an array view with unknown length") {
    int svErrStaticFieldRawCountReader(int* raw, int second) {
        static SvErrStaticFieldHolder holder = default;
        if (second == 0) holder.view = svErrStaticBase;
        int result = svErrCountReader(holder.view);
        if (second == 0) holder.view = (int[])raw;
        return result;
    }
}
