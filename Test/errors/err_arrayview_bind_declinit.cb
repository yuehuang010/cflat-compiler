// Binding a raw `int*` into an `int[]` at declaration-init forges the noalias contract.
expect_error("cannot bind a raw pointer 'T*' to an array-view 'T[]'") {
    void f(int* p) { int[] a = p; a[0] = 1; }
}

// A view bound directly from a fixed array's decayed storage (stack or global) is legal to
// read, but a later 'delete' hands free() a non-heap address and used to abort at runtime
// with no diagnostic at all (internal/issue/p1/delete-of-array-view-over-stack-storage.md).
// Proven from the RHS's own ConstArraySize at THIS bind site.
expect_error("cannot delete array-view 'v' - it was bound from 'a'") {
    void declInitStack() { int[3] a; int[] v = a; delete[_] v; }
}

// Same hole through the 'auto' spelling: 'auto v = a;' deduces the view 'int[]' the same way
// as the explicit 'int[] v = a;' above - it must reach the identical guard.
expect_error("cannot delete array-view 'v' - it was bound from 'a'") {
    void declInitStackAuto() { int[3] a; auto v = a; delete[_] v; }
}

// 'delete' (no brackets) reaches the exact same hole - the guard is not keyed on the
// '[_]'/'[n]' delete spelling.
expect_error("cannot delete array-view 'v' - it was bound from 'a'") {
    void declInitStackPlainDelete() { int[3] a; int[] v = a; delete v; }
}

// A GLOBAL fixed array is exactly as un-free()-able as a stack one, and exactly as provable
// (the RHS's ConstArraySize proves it regardless of where the array itself lives). Pinned to
// the real global name: GetGlobalVariableNV never sets CallerName, so the message is built
// from the RHS's own AST text, not a generic "local" fallback.
int[3] gArrForDelete;
expect_error("cannot delete array-view 'v' - it was bound from 'gArrForDelete'") {
    void declInitGlobalArray() { int[] v = gArrForDelete; delete[_] v; }
}

// Round-2 review (G1): a global whose name COLLIDES with a symbol the runtime already
// declares (libc's 'read', here) gets a '.N' LLVM uniquifying suffix on its mangled name.
// The diagnostic must print the SOURCE spelling 'read', never the mangled 'read.1' - printing
// the LLVM symbol name off the GlobalVariable (the original implementation) would name
// something absent from the user's code. Sourced from the RHS's AST text instead.
int[3] read;
expect_error("cannot delete array-view 'v' - it was bound from 'read'") {
    void declInitGlobalCollision() { int[] v = read; delete[_] v; }
}

// A struct FIELD read (not the field ITSELF, which is left alone below) names the actual
// source path 'h.a', not the base struct instance 'h' - 'h' is a Holder, not fixed-array
// storage, so blaming it would be a factually false diagnostic.
struct DeclInitFieldSourceHolder { int[3] a; };
expect_error("cannot delete array-view 'v' - it was bound from 'h.a'") {
    void declInitFieldSource() { DeclInitFieldSourceHolder h; int[] v = h.a; delete[_] v; }
}

// G2 (round-2 review): a GLOBAL struct's fixed-array field is a GEP off the global, not a
// plain GlobalVariable and not a local CallerName - the same AST-text fallback that fixes G1
// names it correctly too ('gDeclInitFieldHolder.a'), for free.
struct DeclInitGlobalFieldHolder { int[3] a; };
DeclInitGlobalFieldHolder gDeclInitFieldHolder = default;
expect_error("cannot delete array-view 'v' - it was bound from 'gDeclInitFieldHolder.a'") {
    void declInitGlobalFieldSource() { int[] v = gDeclInitFieldHolder.a; delete[_] v; }
}

// Legal: a view from 'new T[n]' is a genuine heap allocation - 'delete[_]' is exactly right
// and must keep compiling.
void declInitHeapOk() { int[] v = new int[3]; delete[_] v; }

// 'auto' from 'new T[n]' deduces the owning array<T> (array.cb is part of the runtime); the
// raw-pointer escape hatch is the explicit 'int* v' spelling.
void declInitHeapAutoOk() { auto v = new int[3]; v.set(0, 1); }
void declInitHeapRawOk() { int* v = new int[3]; delete[_] v; }

// Legal: the view's origin cannot be proven here (it comes from a 'move' parameter, so the
// caller's original binding is out of view) - the guard must not reject what it cannot prove.
void declInitMoveParamOk(move int[] v) { delete[_] v; }
void declInitMoveParamCaller() { int[] h = new int[3]; declInitMoveParamOk(move h); }

// Legal (compile-time; not proven safe at runtime - a residual gap the issue's fix direction
// does not require closing): rebinding one view from another is not traced transitively, so
// v2's origin is not provable from v1 alone even though v1 itself came from fixed-array
// storage. The guard only reasons about the DIRECT bind site's own ConstArraySize.
void declInitViewOfViewOk() { int[3] a; int[] v1 = a; int[] v2 = v1; delete[_] v2; }

// Legal: a conditional-join source is never traced, even when both arms are individually
// provable - joins are always treated as unprovable, matching the polarity of the sibling
// RejectRawPointerToArrayView gate.
void declInitCondJoinOk() { int[3] a; int[3] b; int[] v = 1 > 0 ? a : b; delete[_] v; }

// Legal: a struct FIELD of view type is never traced by this guard - field provenance is
// out of scope for this fix (the field-vs-outsider encapsulation check is a separate,
// pre-existing gate; deleting a field from INSIDE the owning struct's own method reaches
// this code path and must still compile).
struct DeclInitFieldHolder {
    int[] v;
    void takeIt(int[] src) { v = src; }
    void kill() { delete[_] v; }
};
void declInitFieldOk() { int[3] a; DeclInitFieldHolder h; h.takeIt(a); h.kill(); }

// Brace lists own stack backing storage for local views and static backing storage for globals.
expect_error("cannot delete array-view 'v' - it was bound from 'brace initializer backing storage'") {
    void deleteBraceLocalView() { int[] v = {1, 2}; delete[_] v; }
}

int[] gBraceViewForDelete = {3, 4};
expect_error("cannot delete array-view 'gBraceViewForDelete' - it was bound from 'brace initializer backing storage'") {
    void deleteBraceGlobalView() { delete[_] gBraceViewForDelete; }
}

// A raw pointer cast has no statically available extent, so range-for must diagnose it.
expect_error("cannot range-for over an array view whose length is unknown") {
    void rangeForUnknownRawView(int* raw) {
        int[] view = (int[])raw;
        for (int item in view) item += 1;
    }
}

// A field's hidden count cannot outlive a write through another alias to the root.
struct BrViewAliasHolder { int[] values = default; };
expect_error("cannot range-for over an array view whose length is unknown") {
    void brViewFieldAliasWrite() {
        int[] five = {1, 2, 3, 4, 5};
        int[] two = {7, 8};
        BrViewAliasHolder holder = default;
        holder.values = five;
        BrViewAliasHolder* alias = &holder;
        alias->values = two;
        for (int value in holder.values) value += 1;
    }
}

expect_error("cannot range-for over an array view whose length is unknown") {
    void brViewFieldWriteCallee(BrViewAliasHolder* holder, int[] value) {
        holder->values = value;
    }
    void brViewFieldAliasCallee() {
        int[] five = {1, 2, 3, 4, 5};
        int[] two = {7, 8};
        BrViewAliasHolder holder = default;
        holder.values = five;
        brViewFieldWriteCallee(&holder, two);
        for (int value in holder.values) value += 1;
    }
}

expect_error("cannot range-for over an array view whose length is unknown") {
    void brViewFieldDynamicIndex() {
        int[] five = {1, 2, 3, 4, 5};
        int[] two = {7, 8};
        BrViewAliasHolder[2] holders;
        int index = 0;
        holders[index].values = two;
        index = 1;
        holders[index].values = five;
        index = 0;
        for (int value in holders[index].values) value += 1;
    }
}

// A callee that iterates its view requires a real hidden count from every caller.
expect_error("cannot pass an array view with unknown length") {
    int brViewCountRequired(int[] values) {
        int count = 0;
        for (int value in values) count++;
        return count;
    }
    int brViewUnknownArgument(int* raw) { return brViewCountRequired((int[])raw); }
}

// The first iteration is compiled before the loop's later raw rebind executes at runtime.
expect_error("cannot range-for over an array view whose length is unknown") {
    int brViewLoopRawRebind(int* raw) {
        int[] original = {1, 2, 3};
        int[] view = original;
        int count = 0;
        int iteration = 0;
        while (iteration < 2) {
            for (int value in view) count++;
            view = (int[])raw;
            iteration++;
        }
        return count;
    }
}

// Module-wide stores decide a global view's count before any function body is emitted.
int[] brViewGlobalRaw = {1, 2, 3};
expect_error("cannot range-for over an array view whose length is unknown") {
    int brViewGlobalUseBeforeWriter() {
        int count = 0;
        for (int value in brViewGlobalRaw) count++;
        return count;
    }
    void brViewGlobalSetRaw(int* raw) { brViewGlobalRaw = (int[])raw; }
}

// A copied pointer can write the same heap field through a different root name.
expect_error("cannot range-for over an array view whose length is unknown") {
    int brViewPointerRootAlias() {
        int[] five = {1, 2, 3, 4, 5};
        int[] two = {7, 8};
        BrViewAliasHolder* owner = new BrViewAliasHolder();
        owner->values = five;
        BrViewAliasHolder* alias = owner;
        alias->values = two;
        int count = 0;
        for (int value in owner->values) count++;
        return count;
    }
}

// A function value's count requirement is the union over every function bindable to its type.
int brFnCountReader(int[] values) { int n = 0; for (int value in values) n++; return n; }
expect_error("cannot pass an array view with unknown length") {
    int brFnUnknownCall(int* raw) {
        function<int(int[])> fp = brFnCountReader;
        return fp((int[])raw);
    }
}

// An interface method's requirement is the union over its implementors.
interface BrUnknownIface { int count(int[] values); };
class BrUnknownImpl : BrUnknownIface { int count(int[] values) { int n = 0; for (int value in values) n++; return n; } };
expect_error("cannot pass an array view with unknown length") {
    int brIfaceUnknownCall(int* raw) {
        BrUnknownImpl impl;
        BrUnknownIface iface = impl;
        return iface.count((int[])raw);
    }
}

// A declaration copy from a field view carries the field's count: an unknown one is refused.
struct BrDeclFieldHolder { int[] values = default; };
expect_error("cannot range-for over an array view whose length is unknown") {
    int brDeclFieldUnknown(int* raw) {
        BrDeclFieldHolder h = default;
        h.values = (int[])raw;
        int[] w = h.values;
        int n = 0;
        for (int x in w) n++;
        return n;
    }
}

// A loop that rebinds a field view to a raw cast is refused on its first iteration's read.
struct BrLoopFieldHolder { int[] values = default; };
struct BrLoopFieldOuter { BrLoopFieldHolder inner = default; };
expect_error("cannot range-for over an array view whose length is unknown") {
    int brFieldLoopRebindArrow(int* raw) {
        BrLoopFieldHolder* h = new BrLoopFieldHolder();
        int[] a = {1, 2, 3};
        h->values = a;
        int k = 0;
        int total = 0;
        while (k < 2) { int n = 0; for (int x in h->values) n++; total += n; h->values = (int[])raw; k++; }
        return total;
    }
}
expect_error("cannot range-for over an array view whose length is unknown") {
    int brFieldLoopRebindNested(int* raw) {
        BrLoopFieldOuter o = default;
        int[] a = {1, 2, 3};
        o.inner.values = a;
        int k = 0;
        int total = 0;
        while (k < 2) { int n = 0; for (int x in o.inner.values) n++; total += n; o.inner.values = (int[])raw; k++; }
        return total;
    }
}

// The copy owns its own count: rebinding the source field afterwards does not make it known.
expect_error("cannot range-for over an array view whose length is unknown") {
    int brDeclFieldUnknownThenRebind(int* raw) {
        BrDeclFieldHolder h = default;
        int[] a = {1, 2, 3};
        h.values = (int[])raw;
        int[] w = h.values;
        h.values = a;
        int n = 0;
        for (int x in w) n++;
        return n;
    }
}

// STATICVIEW persistent-count regressions
int[] svErrStaticBase = {1, 2, 3};
int[] svErrGlobalTarget = {1, 2, 3};
int svErrViewLength(int[] values) { int n = 0; for (int value in values) n++; return n; }
int svErrCountReader(int[] values) { int n = 0; for (int value in values) n++; return n; }

// A later raw-cast store poisons every earlier static-view count read.
expect_error("cannot range-for over an array view whose length is unknown") {
    int svErrStaticGlobalRawDirectForeach(int* raw) {
        static int[] view = svErrStaticBase;
        int result = 0; for (int item in view) result++;
        view = (int[])raw;
        return result;
    }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticGlobalRawDirectLength(int* raw) {
        static int[] view = svErrStaticBase;
        int result = svErrViewLength(view);
        view = (int[])raw;
        return result;
    }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticGlobalRawDirectCountreader(int* raw) {
        static int[] view = svErrStaticBase;
        int result = svErrCountReader(view);
        view = (int[])raw;
        return result;
    }
}

expect_error("cannot range-for over an array view whose length is unknown") {
    int svErrStaticGlobalRawBranchForeach(int* raw) {
        static int[] view = svErrStaticBase;
        int result = 0; for (int item in view) result++;
        if (raw != nullptr) view = (int[])raw;
        return result;
    }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticGlobalRawBranchLength(int* raw) {
        static int[] view = svErrStaticBase;
        int result = svErrViewLength(view);
        if (raw != nullptr) view = (int[])raw;
        return result;
    }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticGlobalRawBranchCountreader(int* raw) {
        static int[] view = svErrStaticBase;
        int result = svErrCountReader(view);
        if (raw != nullptr) view = (int[])raw;
        return result;
    }
}

expect_error("cannot range-for over an array view whose length is unknown") {
    int svErrStaticGlobalRawLoopForeach(int* raw) {
        static int[] view = svErrStaticBase;
        int result = 0; for (int item in view) result++;
        int i = 0; while (i < 1) { view = (int[])raw; i++; }
        return result;
    }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticGlobalRawLoopLength(int* raw) {
        static int[] view = svErrStaticBase;
        int result = svErrViewLength(view);
        int i = 0; while (i < 1) { view = (int[])raw; i++; }
        return result;
    }
}

expect_error("cannot pass an array view with unknown length") {
    int svErrStaticGlobalRawLoopCountreader(int* raw) {
        static int[] view = svErrStaticBase;
        int result = svErrCountReader(view);
        int i = 0; while (i < 1) { view = (int[])raw; i++; }
        return result;
    }
}

expect_error("cannot range-for over an array view whose length is unknown") {
    int svErrStaticParamRawDirectForeach(int* raw, int[] values) {
        static int[] view = values;
