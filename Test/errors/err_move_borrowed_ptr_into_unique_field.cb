// 'move' of a borrowed (non-move) POINTER parameter into a `unique` field is a deferred
// delete of a pointer the caller still owns - the field's synthesized destructor frees it,
// and so does the caller. Writing 'move' must not launder the borrow.

struct Payload { int v = 0; };
struct Holder  { unique Payload* p = nullptr; };

Holder stash = default;

expect_error("cannot store borrowed parameter 'b' into unique field 'Holder.p'") {
    void badStash(Payload* b) { stash.p = move b; }
}

// A 'move' parameter transfers ownership - storing it into the unique field is valid.
void goodStash(move Payload* b) { stash.p = b; }

// Same laundering, same hazard, but into a `unique` LOCAL instead of a `unique` FIELD. The
// local's scope-exit teardown frees the pointee the caller still owns, so the caller frees
// it a second time. Reassignment through plain '=' is the only way in - decl-init has its
// own D5 reject - and it must not silently adopt a borrow either.
expect_error("cannot assign borrowed parameter 'b' to unique local 'k'") {
    void badLocal(Payload* b) { unique Payload* k = nullptr; k = move b; }
}

// A 'move' parameter transfers ownership - reassigning it into a unique local is valid.
void goodLocal(move Payload* b) { unique Payload* k = nullptr; k = move b; }

// Same laundering at DECL-INIT. The plain `unique Payload* k = b;` form is caught by D5, but
// the 'move' spelling signalled ownership unconditionally, so the local adopted the borrow and
// freed it at scope exit while the caller still owned it (double free, exit 134).
expect_error("cannot initialize unique local 'k' from borrowed parameter 'b'") {
    void badInit(Payload* b) { unique Payload* k = move b; }
}

// A 'move' parameter transfers ownership - initializing a unique local from it is valid.
void goodInit(move Payload* b) { unique Payload* k = move b; }

extern int main() { return 0; }
