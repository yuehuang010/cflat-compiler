// A ternary (?:) whose two branches have genuinely incompatible types (here an
// integer literal and a `string` value) cannot be unified into a single LLVM
// select operand type. Before this was diagnosed, it reached CreateSelect and
// tripped an LLVM assertion ("Invalid operands for select") -> abort(). The
// compiler must instead report a clean type error at the ternary. Unifiable
// branches (e.g. char* literal vs string, or int vs float) are coerced and
// compile fine; only a true mismatch errors here.
import "string.cb";
import cpp "../library/cpp_interop_ternaryref.h";
import cpp "../library/cpp_interop_mixcond3.h";

struct T513VarA { int value = 1; };
struct T513VarB { int value = 2; };

// MIXCOND3 r4: a lvalue by-value conversion into a CFlat callee in a binary expression stays refused.
expect_error("ternary branches have incompatible types 't513mix.A' and 't513mix.BV'") {
    int t513M3LvalueCflatTake(t513mix.BV value) { return value.v; }
    int t513M3LvalueCflatCall(bool k) {
        t513mix.A a = t513mix.mkA(3);
        return t513M3LvalueCflatTake(k ? a : t513mix.mkBV(20)) * 2;
    }
}

expect_error("ternary branches have incompatible types 'T513VarA' and 'T513VarB'") {
    int t513DiscardedStructVariables(bool c) {
        T513VarA a = default;
        T513VarB b = default;
        c ? a : b;
        return 0;
    }
}

expect_error("ternary branches have incompatible types 'T513VarA' and 'T513VarB'") {
    int t513ValueStructVariables(bool c) {
        T513VarA a = default;
        T513VarB b = default;
        T513VarA result = c ? a : b;
        return result.value;
    }
}

expect_error("cannot initialize C++ class 'T513CppA' from this expression; use 'T513CppA(args)', '= default', a 'T513CppA' lvalue, or 'move <T513CppA> lvalue'") {
    int t513ValueCppClasses(bool c) {
        T513CppA result = c ? t513MakeA() : t513MakeB();
        return result.value;
    }
}

expect_error("cannot initialize C++ class 'T513CppA' from this expression; use 'T513CppA(args)', '= default', a 'T513CppA' lvalue, or 'move <T513CppA> lvalue'") {
    int t513DiscardedCppClasses(bool c) {
        c ? t513MakeA() : t513MakeB();
        return 0;
    }
}

expect_error("cannot initialize C++ class 'T513CppA' from this expression; use 'T513CppA(args)', '= default', a 'T513CppA' lvalue, or 'move <T513CppA> lvalue'") {
    int t513BareUnrelatedIntCtor(bool c) {
        c ? t513MakeA() : t513MakeE();
        return 0;
    }
}

expect_error("cannot initialize C++ class 'T513CppA' from this expression; use 'T513CppA(args)', '= default', a 'T513CppA' lvalue, or 'move <T513CppA> lvalue'") {
    int t513ValueUnrelatedIntCtor(bool c) {
        T513CppA result = c ? t513MakeA() : t513MakeE();
        return result.value;
    }
}

expect_error("cannot initialize C++ class 'T513CppA' from this expression; use 'T513CppA(args)', '= default', a 'T513CppA' lvalue, or 'move <T513CppA> lvalue'") {
    int t513VariablesUnrelatedIntCtor(bool c) {
        T513CppA a = default;
        T513CppE e = default;
        c ? a : e;
        return 0;
    }
}

expect_error("cannot initialize C++ class 'T513CppOp' from this expression; use 'T513CppOp(args)', '= default', a 'T513CppOp' lvalue, or 'move <T513CppOp> lvalue'") {
    int t513UnrelatedClassConversionOperator(bool c) {
        c ? t513MakeOp() : t513MakeB();
        return 0;
    }
}

// A discarded conditional still requires the same common type as a value conditional.
expect_error("ternary branches have incompatible types") {
    void t513DiscardedIntString(bool c) {
        string value = "abc";
        c ? 5 : value;
    }
}

expect_error("ternary branches have incompatible types") {
    int bad() {
        string prefix = "abc";
        int x = prefix.length() == 0 ? 5 : prefix;   // int vs string - incompatible
        return x;
    }
}

// A CONDITION that is not a scalar has no truth value. An aggregate reached LLVM's branch /
// select operand unchanged and died with the opaque "module verification failed" instead of a
// source-level error naming the problem.
expect_error("condition must be a scalar") {
    int stringCondition() {
        string s = "abc";
        return s ? 1 : 0;
    }
}

// An INTERFACE value in a condition is the same defect, but its LLVM lowering is the internal
// '__iface_fat_ptr' struct - the diagnostic must name the kind, never that mangled spelling.
interface CondShape
{
    int area();
};
class CondSquare : CondShape
{
    int s = 3;
    int area() { return s * s; }
};
expect_error("not 'interface value'") {
    int interfaceCondition() {
        CondSquare q;
        CondShape v = q;
        return v ? 1 : 0;
    }
}


// Both arms `default` is accepted when the destination type is known, but here the join sits in a
// varargs argument that supplies no destination at all, so there is nothing to take a type from.
expect_error("'default' needs a known target type here") {
    int untypedBothDefaultArms() {
        bool h = true;
        printf("%d\n", h ? default : default);
        return 0;
    }
}

// T191: a generic instantiation arm is a function value, so it is incompatible with an integer arm
// exactly as a named function is.
T tiGen<T>(T a) { return a; }
expect_error("ternary branches have incompatible types") {
    int genericArmVsInt(int k) {
        int x = k ? tiGen<int> : 2;
        return x;
    }
}

// T513 r5: both directions viable (A(const B&) and a deducible B(const U&) ctor): clang refuses as ambiguous.
expect_error("ternary branches have ambiguous C++ conversions between 'T513R5AmbA' and 'T513R5AmbB'") {
    int t513R5Ambiguous(bool c) {
        c ? t513R5MakeAmbA() : t513R5MakeAmbB();
        return 0;
    }
}

expect_error("ternary branches have ambiguous C++ conversions between 'T513R5AmbA' and 'T513R5AmbB'") {
    int t513R5AmbiguousDeclaration(bool c) {
        T513R5AmbB result = c ? t513R5MakeAmbA() : t513R5MakeAmbB();
        return result.v;
    }
}

// T513 r6: clang refuses a const prvalue or const lvalue arm that the only converting constructor cannot take.
expect_error("cannot initialize C++ class 'T513R6CK' from this expression") {
    int t513R6ConstPrvalue(bool c) {
        c ? t513R6MakeCK() : t513R6MakeCB();
        return 0;
    }
}

expect_error("cannot initialize C++ class 'T513R6CK' from this expression") {
    int t513R6ConstLvalue(bool c) {
        c ? t513R6CkRef() : t513R6MakeCL();
        return 0;
    }
}

// T513 r7: a trivial prvalue arm cannot bind B(A&) (clang: incompatible operand types), in both orders.
expect_error("cannot initialize C++ class 'T513R7TA' from this expression") {
    int t513R7PrvalueToLref(bool c) {
        c ? t513R7MakeTA() : t513R7MakeLB();
        return 0;
    }
}

expect_error("cannot initialize C++ class 'T513R7LB' from this expression") {
    int t513R7PrvalueToLrefReversed(bool c) {
        c ? t513R7MakeLB() : t513R7MakeTA();
        return 0;
    }
}

// T513 r5 (S3): a by-value parameter lvalue arm that converts is refused in return position.
expect_error("cannot return C++ class 'T513V10B' from this conditional expression") {
    T513V10B t513V10ReturnParam(bool k, T513V10A a) { return k ? a : t513V10MakeB(); }
}

// MIXCOND2 r2: prefix arguments with a narrowing conversion refuse the conditional sink.
expect_error("ternary branches have incompatible types 'T513V10A' and 'T513V10B'") {
    int t513M2LongCall(int x, T513V10B value) { return x + value.value; }
    int t513M2LongArg(bool k) {
        i64 wide = 5000000001;
        return t513M2LongCall(wide, k ? t513V10MakeA(11) : t513V10MakeB());
    }
}

expect_error("ternary branches have incompatible types 'T513V10A' and 'T513V10B'") {
    int t513M2CharCall(char x, T513V10B value) { return x + value.value; }
    int t513M2CharArg(bool k) {
        return t513M2CharCall(3 - 10, k ? t513V10MakeA(11) : t513V10MakeB());
    }
}

// The pointee mismatch is the first error (clang agrees); the conditional sink is never reached.
expect_error("cannot convert 'double*' to 'int*' implicitly: the pointee types differ") {
    int t513M2PointerCall(int* p, T513V10B value) { return *p + value.value; }
    int t513M2PointerArg(bool k) {
        double d = 2.0;
        return t513M2PointerCall(&d, k ? t513V10MakeA(11) : t513V10MakeB());
    }
}

extern int main() { return 0; }
