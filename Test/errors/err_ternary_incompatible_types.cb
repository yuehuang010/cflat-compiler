// A ternary (?:) whose two branches have genuinely incompatible types (here an
// integer literal and a `string` value) cannot be unified into a single LLVM
// select operand type. Before this was diagnosed, it reached CreateSelect and
// tripped an LLVM assertion ("Invalid operands for select") -> abort(). The
// compiler must instead report a clean type error at the ternary. Unifiable
// branches (e.g. char* literal vs string, or int vs float) are coerced and
// compile fine; only a true mismatch errors here.
import "string.cb";

expect_error("ternary branches have incompatible types") {
    int bad() {
        string prefix = "abc";
        int x = prefix.length() == 0 ? 5 : prefix;   // int vs string - incompatible
        return x;
    }
}

// Arms that produce no value at all: a `void` call in each branch has nothing to join.
// This used to reach the LLVM join operation with a void operand and fail module
// verification ("Instruction operands must be first-class values") instead of being
// reported as a source-level error.
void sideEffectOnly() { }

expect_error("ternary branches must produce a value") {
    int bothVoid(bool c) {
        c ? sideEffectOnly() : sideEffectOnly();
        return 0;
    }
}

// A CONDITION that is not a scalar has no truth value. An aggregate reached LLVM's branch /
// select operand unchanged and died with the opaque "module verification failed" instead of a
// source-level error naming the problem.
expect_error("condition must be a scalar") {
    int stringCondition() {
        string s = "abc";
        return s ? 1 : 0;
    }
}

extern int main() { return 0; }
