int newPtrDepthGeneric<T>(T v) { auto b = new T*; return 0; }

extern int main()
{
    expect_error("produces pointer depth 3") {
        int**[] slots = new int**[2];
    }

    expect_error("produces pointer depth 3") {
        auto slot = new int**(nullptr);
    }

    expect_error("produces pointer depth 3") {
        int x = 1;
        int r = newPtrDepthGeneric<int*>(&x);
    }
}
