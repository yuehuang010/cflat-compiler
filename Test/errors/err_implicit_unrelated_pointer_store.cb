        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = ja_take_bpp(c ? dpp : dpp2);
    }
    expect_error("no overload of 'ja_take_b' matches the given arguments") {
        JaD d1 = default;
        JaD d2 = default;
        JaD* p1 = &d1;
        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = ja_take_b(c ? dpp : dpp2);
    }
    expect_error("no overload of 'jaErrCfTakeBpp' matches the given arguments") {
        JaD d1 = default;
        JaD d2 = default;
        JaD* p1 = &d1;
        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = jaErrCfTakeBpp(c ? dpp : dpp2);
    }
    expect_error("no overload of 'jaErrCfTakeB' matches the given arguments") {
        JaD d1 = default;
        JaD d2 = default;
        JaD* p1 = &d1;
        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = jaErrCfTakeB(c ? dpp : dpp2);
    }
    expect_error("no overload of 'ja_take_bpp' matches the given arguments") {
        JaD d1 = default;
        JaD d2 = default;
        JaD* p1 = &d1;
        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = ja_take_bpp(dnull ?? dpp);
    }
    expect_error("no overload of 'jaErrCfTakeBpp' matches the given arguments") {
        JaD d1 = default;
        JaD d2 = default;
        JaD* p1 = &d1;
        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = jaErrCfTakeBpp(dnull ?? dpp);
    }
    expect_error("no overload of 'ja_take_b' matches the given arguments") {
        JaD d1 = default;
        JaD d2 = default;
        JaD* p1 = &d1;
        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = ja_take_b(dnull ?? dpp);
    }
    expect_error("no overload of 'ja_ov3' matches the given arguments") {
        JaD d1 = default;
        JaD d2 = default;
        JaD* p1 = &d1;
        JaD* p2 = &d2;
        JaD** dpp = &p1;
        JaD** dpp2 = &p2;
        JaD** dnull = nullptr;
        int c = 1;
        int r = ja_ov3(c ? dpp : dpp2);
    }
    // JOINARG: whole multi-dimensional class arrays and unrelated rows (pre-fix each compiled).
    expect_error("cannot convert 'NY*' to 'NS*' implicitly: the pointee types differ") {
        NY[2][2] rows = default;
        NS* p = rows[1];
    }
    expect_error("cannot compare 'JaD[2][2]' with 'JaB*': a multi-dimensional array decays to a pointer to its first row, not to a class pointer") {
        JaD[2][2] rows = default;
        JaD d = default;
        JaB* q = &d;
        bool e = rows == q;
    }
    expect_error("cannot compare 'JaD[2][2]' with 'JaB*': a multi-dimensional array decays to a pointer to its first row, not to a class pointer") {
        JaD[2][2] rows = default;
        JaD d = default;
        JaB* q = &d;
        bool e = q != rows;
    }
    expect_error("cannot convert 'JaD[2][2]' to 'JaB*' for variable 'b': a multi-dimensional array decays to a pointer to its first row, not to a class pointer") {
        JaD[2][2] rows = default;
        JaB* b = rows;
    }
    expect_error("cannot convert 'JaD[2][2]' to 'JaB*' for 'b': a multi-dimensional array decays to a pointer to its first row, not to a class pointer") {
        JaD[2][2] rows = default;
        JaB* b = nullptr;
        b = rows;
    }
    expect_error("cannot convert 'JaD[2][2]' to 'JaX*' for variable 'x': a multi-dimensional array decays to a pointer to its first row, not to a class pointer") {
        JaD[2][2] rows = default;
        JaX* x = rows;
    }
    expect_error("cannot convert 'JaD[2][2]' to 'JaB*' for variable 'b': a multi-dimensional array decays to a pointer to its first row, not to a class pointer") {
        JaD[2][2] rows = default;
        JaD[2][2][2] cube = default;
        JaB* b = cube[1];
    }
    expect_error("no overload of 'ja_take_b' matches the given arguments") {
        JaD[2][2] rows = default;
        int r = ja_take_b(rows);
    }
    expect_error("no overload of 'jaErrCfTakeB' matches the given arguments") {
        JaD[2][2] rows = default;
        int r = jaErrCfTakeB(rows);
    }
    expect_error("no overload of 'ja_take_b' matches the given arguments") {
        JaD[2][2] rows = default;
        JaD[2][2][2] cube = default;
        int r = ja_take_b(cube[1]);
    }
    expect_error("cannot convert 'JaD*' to 'JaX*' implicitly: the pointee types differ") {
        JaD[2][2] rows = default;
        JaX* x = rows[1];
    }
    expect_error("no overload of 'ja_take_x' matches the given arguments") {
        JaD[2][2] rows = default;
        int r = ja_take_x(rows[1]);
    }
    // JOINARG2: a reference-arm join call argument keeps its class (pre-fix each relabelled to
    // the first candidate's parameter and compiled).
    expect_error("ambiguous call to 'ja_ov_ab'") {
        JaD d = default; JaD* p = &d; int c = 1;
        int r = ja_ov_ab(c ? ja_ref_d() : p);
    }
    expect_error("no overload of 'ja_take_x' matches the given arguments") {
        JaD d = default; JaD* p = &d; int c = 1;
        int r = ja_take_x(c ? ja_ref_d() : p);
    }
    // JOINARG2: an int row is an `int[2]`, not an `int**` (pre-fix it compiled).
    expect_error("the pointer depths differ") {
        int[2][2] m = default;
        int** q = m[1];
    }
    // ACCEPT SET guard (refused pre-fix too): a void* join still needs a void* destination.
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        JaB* q = c ? p : v;
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = ja_take_b(c ? p : v);
    }
    // JOINARG2 review: the void* exemption never takes a provisional overload candidate (pre-fix
    // round 1 compiled the void-first order only).
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = jaErrChooseVoidFirst(c ? p : v);
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = jaErrChooseVoidLast(c ? p : v);
    }
    // JOINARG2 review: an overloaded interface method (pre-fix round 3 compiled the void-first order).
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        JaErrVoidFirstImpl impl = default; IJaErrVoidFirst i = impl;
        int r = i.take(c ? p : v);
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        JaErrVoidLastImpl impl = default; IJaErrVoidLast i = impl;
        int r = i.take(c ? p : v);
    }
    // JOINARG2 review: nested in a single-candidate call, the overload set still has no single
    // destination (pre-fix round 2 inherited the outer call's answer).
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = ja_take_void(jaErrChooseVoidFirst(c ? p : v) == 3 ? p : nullptr);
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = ja_take_void(jaErrChooseVoidLast(c ? p : v) == 3 ? p : nullptr);
    }
    // JOINARG2 review: a fixed array decays one level only (pre-fix each compiled and crashed).
    expect_error("no overload of 'jaErrTakeIntPp' matches the given arguments") {
        int[2] a = {1, 2};
        int r = jaErrTakeIntPp(a);
    }
    expect_error("no overload of 'jaErrTakeIntPp' matches the given arguments") {
        int[2] a = default;
        int r = jaErrTakeIntPp(a);
    }
    expect_error("no overload of 'jaErrTakeIntPp' matches the given arguments") {
        int[2][2] m = default;
        int r = jaErrTakeIntPp(m);
    }
    expect_error("no overload of 'jaErrTakeIntPp' matches the given arguments") {
        int*[2][2] pp = default;
        int r = jaErrTakeIntPp(pp);
    }
    expect_error("a multi-dimensional array decays to a pointer to its first row") {
        int*[2][2] pp = default;
        int** q = pp;
    }
    expect_error("a multi-dimensional array decays to a pointer to its first row") {
        int*[2][2] pp = default;
        int** q = nullptr;
        q = pp;
    }
    // JOINVOID: namespace and receiver overload sets stay ambiguous in either order,
    // including when their call is nested in a single-candidate outer call.
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = JaErrJoinNsFirst.take(c ? p : v);
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = jaErrJoinIdentity(JaErrJoinNsFirst.take(c ? p : v));
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = JaErrJoinNsLast.take(c ? p : v);
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        int r = jaErrJoinIdentity(JaErrJoinNsLast.take(c ? p : v));
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        JaErrJoinHostFirst host = default; int r = host.take(c ? p : v);
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        JaErrJoinHostFirst host = default;
        int r = jaErrJoinIdentity(host.take(c ? p : v));
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        JaErrJoinHostLast host = default; int r = host.take(c ? p : v);
    }
    expect_error("the pointee types differ") {
        JaD d = default; JaD* p = &d; void* v = &d; int c = 1;
        JaErrJoinHostLast host = default;
        int r = jaErrJoinIdentity(host.take(c ? p : v));
    }
    return 0;
}
