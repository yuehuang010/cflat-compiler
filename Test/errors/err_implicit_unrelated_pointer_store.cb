// An implicit T* -> U* between distinct native struct pointees (or a struct and a primitive
// pointee) is refused at every store position, matching the call rule (`take(&y)` finds no
// overload). doc/LANGUAGE.md: pointer -> pointer is an explicit cast. Pre-fix every block below
// compiled and read NY bits through an NS* (`return p->a` gave 7).

struct NS { int a = 0; int b = 0; };
struct NY { long z = 0; };
struct NH { NS* p = default; };
struct NO { NH h = default; };
struct NArr { NS*[2] p = default; };
struct NWrap<T> { T v = default; };
union NUa { int i; float f; };
union NUb { int j; double d; };
NY nyGlobal = default;

// CPPRECPTR: C++ record pointees follow the same rule - a primitive, native struct or unrelated
// C++ class pointee never converts implicitly to (or from) a C++ class pointer, nor compares with
// one; base / derived pairs stay PTRSAFE's conversion. Pre-fix every C++ block below compiled.
import cpp "../library/cpp_record_pointee.h";
// JOINARG: a C++ class T** ?: / ?? join call argument keeps its own class (no relabel to the
// parameter), and a whole multi-dimensional class array decays to a row pointer, never a class one.
import cpp "../library/cpp_joinarg.h";
int jaErrCfTakeB(JaB* p) { return p->b; }
int jaErrCfTakeBpp(JaB** p) { return (*p)->b; }
// JOINARG2: a void* join into an overload set has no single destination, whatever the order.
int jaErrChooseVoidFirst(void* p) { return 3; }
int jaErrChooseVoidFirst(JaD* p) { return 2; }
int jaErrChooseVoidLast(JaD* p) { return 2; }
int jaErrChooseVoidLast(void* p) { return 3; }
namespace JaErrJoinNsFirst { int take(void* p) { return 3; } int take(JaD* p) { return 2; } }
namespace JaErrJoinNsLast { int take(JaD* p) { return 2; } int take(void* p) { return 3; } }
struct JaErrJoinHostFirst { int take(void* p) { return 3; } int take(JaD* p) { return 2; } };
struct JaErrJoinHostLast { int take(JaD* p) { return 2; } int take(void* p) { return 3; } };
int jaErrJoinIdentity(int value) { return value; }
int jaErrTakeIntPp(int** p) { return **p; }
// JOINARG2: an overloaded interface method name has no single destination, whatever the order.
interface IJaErrVoidFirst { int take(void* p); int take(JaD* p); };
class JaErrVoidFirstImpl : IJaErrVoidFirst { int k = 0; int take(void* p) { return 3; } int take(JaD* p) { return 2; } };
interface IJaErrVoidLast { int take(JaD* p); int take(void* p); };
class JaErrVoidLastImpl : IJaErrVoidLast { int k = 0; int take(JaD* p) { return 2; } int take(void* p) { return 3; } };
[cpp] struct UrpCpp { int z = 3; };
int urpCfTake(UrpB* p) { return p->v; }
interface IUrp { int m(); };
class UrpImpl : IUrp { int k = 1; int m() { return k; } };

expect_error("cannot convert 'NY*' to 'NS*' implicitly: the pointee types differ") {
    NS* nsGlobalFromNy = &nyGlobal;
}

expect_error("cannot convert 'NY*' to 'NS*' implicitly: the pointee types differ") {
    NS* nsReturnFromNy(NY* y) { return y; }
}

expect_error("cannot convert 'NY*' to 'NS*' implicitly: the pointee types differ") {
    NS* nsTernaryReturn(int c, NY* y) { return c ? y : y; }
}

expect_error("cannot convert 'NY*' to 'NS*' implicitly: the pointee types differ") {
    NS* nsCoalesceReturn(NY* y) { return y ?? y; }
}

expect_error("cannot convert 'int*' to 'NS*' implicitly: the pointee types differ") {
    NS* nsReturnFromInt(int* x) { return x; }
}

// PRIMPTR: a call follows the same rule - an int* / char* / double* / bool* argument into a native
// struct pointer parameter, or a fixed array into an unrelated element pointer, finds no overload.
// Pre-fix every call block below compiled and read the argument's bytes as the struct.
int nsTake(NS* p) { return p->a; }
int nyTake(NY* p) { return (int)p->z; }
int intTake(int* p) { return *p; }
int nsGen<T>(T t, NS* p) { return p->a; }
struct NCall { int k = 0; NCall(NS* p) { k = p->a; } int m(NS* p) { return p->a; } static int sm(NS* p) { return p->a; } };
struct NGenCall<T> { T k = default; int m(NS* p) { return p->a; } };
interface INCall { int m(NS* p); };
class NCallImpl : INCall { int k = 0; int m(NS* p) { return p->a; } };
extern int mblen(NS* s, u64 n);
int nsVar(NS* p, ...) { return p->a; }

// ARRDEPTH: a fixed array of class pointers decays to `T**` and a `?:` / `??` join of `T**`
// keeps its depth, so the base / derived T** store and compare rules (clang: no conversion /
// distinct pointer types) reach them. Pre-fix each block compiled; the native and unrelated
// C++ arms already refused these shapes.
struct UrpArrHold { UrpDer*[2] a = default; };
struct UrpPpHold { UrpBase** q = default; };
expect_error("cannot convert 'UrpDer**' to 'UrpBase**' for conditional expression: a multi-level pointer converts only to the same class") {
    UrpBase** urpJoinReturn(int c, UrpDer** a, UrpDer** b) { return c ? a : b; }
}
expect_error("cannot convert 'UrpDer**' to 'UrpBase**' for the return value: a multi-level pointer converts only to the same class") {
    UrpDer*[2] urpArrGlobal = default;
    UrpBase** urpArrReturn() { return urpArrGlobal; }
}
expect_error("cannot convert 'UrpDer**' to 'UrpBase**' for variable 'urpArrGlobalPp': a multi-level pointer converts only to the same class") {
    UrpDer*[2] urpArrGlobal2 = default;
    UrpBase** urpArrGlobalPp = urpArrGlobal2;
}

