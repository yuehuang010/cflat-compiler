// MIX21: `&` of a `?:` needs both arms to be lvalues; a postfix arm, a literal or a call result is a prvalue.
int m21Call()
{
    return 7;
}

extern int main()
{
    // TERNRES: a redundant scalar cast keeps storage in IR but is still a prvalue.
    expect_error("cannot take the address of a '?:' unless both arms are lvalues") {
        int i = 1;
        int j = 4;
        bool t = true;
        int* p = &(t ? i++ : j);
    }
    expect_error("cannot take the address of a '?:' unless both arms are lvalues") {
        int i = 1;
        int j = 4;
        bool t = false;
        int* p = &(t ? j : i--);
    }
    expect_error("cannot take the address of a '?:' unless both arms are lvalues") {
        int i = 3;
        bool t = false;
        int* p = &(t ? i : 5);
    }
    expect_error("cannot take the address of a '?:' unless both arms are lvalues") {
        int i = 3;
        bool t = false;
        int* p = &(t ? i : m21Call());
    }
    expect_error("cannot take the address of a '?:' unless both arms are lvalues") {
        int i = 3;
        int j = 4;
        bool t = true;
        int* p = &(t ? i : (int)j);
    }
    expect_error("cannot take the address of a '?:' unless both arms are lvalues") {
        int x = 1;
        int y = 2;
        bool t = true;
        int* p = &(t ? x : ((int)y));
    }
    return 0;
}
