// TERNADDR: a `?:` with a pointer prvalue arm (`x + 1`, a call) cannot bind a C++ `int*&` (clang refuses).
import cpp "cpp_t67_postinc.hpp";
import cpp "cpp_castglob.hpp";

extern int main()
{
    expect_error("cannot bind a pointer rvalue") {
        int[4] a;
        int* x = &a[0];
        int* y = &a[1];
        bool t = true;
        cpp_t67.ptr_bump(t ? x + 1 : y);
    }
    expect_error("cannot bind a pointer rvalue") {
        int[4] a;
        int* x = &a[0];
        int* y = &a[1];
        bool t = false;
        cpp_t67.ptr_bump(t ? x : y + 1);
    }
    expect_error("cannot bind a pointer rvalue") {
        int[4] a;
        int* x = &a[0];
        int* y = &a[1];
        int* z = &a[3];
        bool t = true;
        bool u = false;
        cpp_t67.ptr_bump(t ? x : (u ? y : z + 1));
    }
    expect_error("array and cannot bind to a non-const lvalue reference to a pointer") {
        int[3] values = {7, 8, 9};
        castglob.take_ptr_ref(values);
    }
    expect_error("array and cannot bind to a non-const lvalue reference to a pointer") {
        int[3] values = {7, 8, 9};
        castglob.take_const_int_ptr_ref(values);
    }
    expect_error("array and cannot bind to a non-const lvalue reference to a pointer") {
        int[2][3] rows = {{1, 2, 3}, {4, 5, 6}};
        castglob.take_ptr_ref(rows[1]);
    }
    expect_error("no instantiation of C++ function template 'fnrefctor.tpr' accepts these argument types") {
        int[2][3] rows = {{1, 2, 3}, {4, 5, 6}};
        fnrefctor.tpr(rows[1]);
    }
    return 0;
}
