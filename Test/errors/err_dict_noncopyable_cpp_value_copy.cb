import cpp "cpp_interop_t417.h";
import "dictionary.cb";

expect_error("cannot copy this dictionary: its value type owns a 'unique' pointer and has no 'copy()'");
extern int main()
{
    dictionary<int, t417.MoveOnly> source = default;
    dictionary<int, t417.MoveOnly> duplicate = source.copy();
    return duplicate.count();
}
