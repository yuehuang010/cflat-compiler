import cpp "t25_csurface.hpp";

// A C++ callback parameter takes only a callback with the same signature: clang refuses a
// pointee const or return const that differs, for a named function and for a function-pointer value.
extern int main()
{
    expect_error("no overload of 't25surface.only_const' matches the given arguments") {
        int named = t25surface.only_const(t25surface.cb_mutable);
    }
    expect_error("no overload of 't25surface.only_mut' matches the given arguments") {
        int named = t25surface.only_mut(t25surface.cb_const);
    }
    expect_error("no overload of 't25surface.only_const' matches the given arguments") {
        auto mutValue = t25surface.cb_mutable;
        int fromValue = t25surface.only_const(mutValue);
    }
    expect_error("no overload of 't25surface.only_ret_mut' matches the given arguments") {
        int returnConst = t25surface.only_ret_mut(t25surface.ret_const_only);
    }
    expect_error("no overload of 't25surface.pick_ret' matches the given arguments") {
        int returnPlain = t25surface.pick_ret(t25surface.ret_mut_int);
    }
    expect_error("no overload of 't25surface.pick_scope' matches the given arguments") {
        int callback = t25surface.pick_scope(t25surface.scope_cb);
    }
    expect_error("no overload of 't25surface.pick_return' matches the given arguments") {
        int callback = t25surface.pick_return(t25surface.return_cb);
    }
    expect_error("no overload of 't25surface.pick' matches the given arguments") {
        function<int(int*, int*)> callback = (int* a, int* b) => { return 8; };
        int callbackVoidConversion = t25surface.pick(callback);
    }
    return 0;
}
