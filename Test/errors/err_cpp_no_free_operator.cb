import cpp "cpp_interop_basic.h";
import cpp "cpp_interop_strop.h";
import cpp "cpp_interop_freeoptpl.h";

struct NativeNoPlus { int v; };

extern int main()
{
    expect_error("no operator '+'") {
        cppi.Pair a = default;
        cppi.Pair b = default;
        cppi.Pair c = a + b;
    }
    expect_error("ambiguous") {
        cppi_inh.OperatorAmbiguous a = cppi_inh.OperatorAmbiguous(1);
        cppi_inh.OperatorAmbiguous b = cppi_inh.OperatorAmbiguous(2);
        cppi_inh.OperatorAmbiguous c = a + b;
    }
    expect_error("implicit argument conversion refused") {
        cppi_inh.OperatorHiddenDifferent a = cppi_inh.OperatorHiddenDifferent(1);
        cppi_inh.OperatorHiddenDifferent b = cppi_inh.OperatorHiddenDifferent(2);
        cppi_inh.OperatorHidingBase c = a + b;
    }
    expect_error("no overload of 'operator+' matches") {
        cppi_inh.OperatorNameHiding a = default;
        cppi_inh.OperatorNameHiding b = default;
        cppi_inh.OperatorNameHidingBase c = a + b;
    }
    // A class with neither operator< nor operator<=> has no rewritten relational candidate.
    expect_error("no operator '<'") {
        cppi.Pair d = default;
        cppi.Pair e = default;
        bool less = d < e;
    }
    // No compound operator and no binary fallback either.
    expect_error("no overload for compound assignment '+='") {
        cppi.Pair f = default;
        cppi.Pair g = default;
        f += g;
    }
    // Neither a member nor a free operator++ exists for this class.
    expect_error("has no 'operator++'") {
        cppi.Pair h = default;
        h++;
    }
    // A `char*` row never binds a `char**` parameter (clang: invalid operands).
    expect_error("no overload of 'operator-' matches") {
        char[4][4] rowsOnly = default;
        cppsopd.Deep deep;
        int viaRow = deep - rowsOnly[1];
    }
    // A whole `char[4][4]` decays to `char(*)[4]`: neither `char**` nor `const char*` accepts it.
    expect_error("cannot bind its right operand: the pointer's pointee type is not known here") {
        char[4][4] rowsAll = default;
        cppsopd.Tally tally;
        int viaAll = tally - rowsAll;
    }
    // Unary operators: nothing binds - no member, no free operator, no implicit conversion
    // function to an arithmetic type. clang: "invalid argument type to unary expression".
    expect_error("no operator '+' for type 'cppfopun.N'") {
        cppfopun.N u = default;
        auto r = +u;
    }
    expect_error("no operator '-' for type 'cppfopun.N'") {
        cppfopun.N u = default;
        auto r = -u;
    }
    // An `explicit operator int` / `explicit operator bool` is no implicit conversion.
    expect_error("no operator '+' for type 'cppfopun.E'") {
        cppfopun.E u = default;
        auto r = +u;
    }
    expect_error("no operator '+' for type 'cppfopun.EB'") {
        cppfopun.EB u = default;
        auto r = +u;
    }
    expect_error("no operator '~' for type 'cppfopun.EB'") {
        cppfopun.EB u = default;
        auto r = ~u;
    }
    // `~` has no floating-point built-in, whatever the conversion function returns.
    expect_error("no operator '~' for type 'cppfopun.Dbl'") {
        cppfopun.Dbl u = default;
        auto r = ~u;
    }
    // A CFlat struct with no unary operator+ is refused like `-` and `~` were, not passed through.
    expect_error("no operator '+' for type 'NativeNoPlus'") {
        NativeNoPlus n = { v = 4 };
        NativeNoPlus r = +n;
    }
    // Two implicit conversion functions to arithmetic types: clang reports the operator ambiguous.
    expect_error("ambiguous implicit conversion for built-in operator '+'") {
        cppfopun.Two u = default;
        auto r = +u;
    }
    expect_error("ambiguous implicit conversion for built-in operator '-'") {
        cppfopun.Two u = default;
        auto r = -u;
    }
    return 0;
}
