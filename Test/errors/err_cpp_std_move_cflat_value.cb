// `std.move(x)` is the C++ move and binds only C++ objects (ruling 2026-10-01). Applied to a CFlat
// value it is refused, and the message names CFlat's own `move x` instead of the generic
// "argument type cannot be spelled in C++". A C++ object or a scalar still takes std.move.
import cpp "utility";

struct MoveBox
{
    int* p = default;
    MoveBox() { p = new int(3); }
    ~MoveBox() { delete p; }
};

int take_box(MoveBox b) { return *b.p; }

extern int main()
{
    expect_error("'std.move' is the C++ move and applies only to C++ objects; 'box' is a CFlat value of type 'MoveBox' - write 'move box'") {
        MoveBox box = MoveBox();
        MoveBox other = std.move(box);
    }
    expect_error("'u' is a CFlat value of type 'unique<int>' - write 'move u'") {
        unique<int> u = new int(4);
        unique<int> w = std.move(u);
    }
    expect_error("'s' is a CFlat value of type 'string' - write 'move s'") {
        string s = "hi";
        string t = std.move(s);
    }
    expect_error("'arg' is a CFlat value of type 'MoveBox' - write 'move arg' to transfer it, or 'arg' itself") {
        MoveBox arg = MoveBox();
        int r = take_box(std.move(arg));
    }
    int scalar = 5;
    int scalarMoved = std.move(scalar);
    if (scalarMoved != 5) return 1;
    return 0;
}
