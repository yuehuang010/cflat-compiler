// VIRTUAL inheritance is refused: the Itanium ABI reaches a virtual base through a VTT and a
// vbase offset in the vtable, neither of which cflat models. The class stays an opaque shell -
// legal to hold through a pointer, illegal to lay out or name a member of. A TEMPLATE
// spelling is a sized blob instead, and IS constructible - see the note below.
// Non-virtual inheritance and virtual DISPATCH are supported; see the inheritance and virtual dispatch section of Test/test_cpp_interop.cb.
import cpp "cpp_interop_poly.h";
import cpp "cpp_layout_refused.h";
import "c_opaque_struct.h";

extern int main()
{
    expect_error("uses virtual inheritance, which is not supported yet") {
        cpppoly.VBaseMid* m = nullptr;
        int v = m.mv;
    }
    // A TEMPLATE spelling is held as a sized blob, so the layout refusal above never fires and
    // its members reach the binder. Its CONSTRUCTOR is now callable too, through a clang-emitted
    // placement-new thunk - see the virtual-members-through-a-clang-thunk section of Test/test_cpp_interop.cb - so no refusal is
    // pinned for it here.

    // Every BY-VALUE storage shape of the refused class reaches the same refusal - a fixed array
    // too (it once hit "Cannot allocate unsized type" in module verification). Pointers stay legal.
    cpppoly.VBaseMid*[2] heldPtrs = default;
    cpppoly.VBaseMid[] heldView = default;
    if (heldPtrs[1] != nullptr) return 1;
    Opq* heldOpq = nullptr;
    if (opq_tag(heldOpq) != 42) return 1;
    expect_error("uses virtual inheritance, which is not supported yet") {
        cpppoly.VBaseMid[2] arr = default;
    }
    expect_error("uses virtual inheritance, which is not supported yet") {
        cpppoly.VBaseMid[2][2] grid = default;
    }
    expect_error("uses virtual inheritance, which is not supported yet") {
        cpppoly.VBaseMid[2] braced = {};
    }
    expect_error("uses virtual inheritance, which is not supported yet") {
        static cpppoly.VBaseMid[2] kept = default;
    }
    expect_error("uses virtual inheritance, which is not supported yet") {
        int n = (int)sizeof(cpppoly.VBaseMid);
    }
    expect_error("uses virtual inheritance, which is not supported yet") {
        int n = (int)sizeof(cpppoly.VBaseMid[2]);
    }
    expect_error("uses virtual inheritance, which is not supported yet") {
        VbBox<cpppoly.VBaseMid> boxed = default;
    }
    // The other layout refusal (a bitfield inside a hierarchy) takes the same array path.
    expect_error("has a layout cflat cannot flatten") {
        cpprefused.BfDerived[2] bits = default;
    }
    return 0;
}

struct VbBox<T> { T held = default; };

expect_error("uses virtual inheritance, which is not supported yet") {
    cpppoly.VBaseMid[2] globalArr = default;
}
expect_error("uses virtual inheritance, which is not supported yet") {
    cpppoly.VBaseMid[2][2] globalGrid = default;
}
expect_error("uses virtual inheritance, which is not supported yet") {
    struct VbArrField { cpppoly.VBaseMid[2] items = default; };
}
expect_error("uses virtual inheritance, which is not supported yet") {
    struct VbField { cpppoly.VBaseMid item = default; };
}
expect_error("uses virtual inheritance, which is not supported yet") {
    int vbTakes(cpppoly.VBaseMid v) { return 0; }
}
expect_error("uses virtual inheritance, which is not supported yet") {
    cpppoly.VBaseMid vbGives(cpppoly.VBaseMid* p) { return *p; }
}
expect_error("has a layout cflat cannot flatten") {
    cpprefused.BfDerived[2] globalBits = default;
}
// A plain C opaque record (only forward-declared) has no layout either: a defined global of it, or
// of a fixed array of it, is the general incomplete-type error, not a module-verification failure.
expect_error("is incomplete here (its layout is not available at this point)") {
    Opq globalOpq = default;
}
expect_error("is incomplete here (its layout is not available at this point)") {
    Opq[2] globalOpqArr = default;
}
