// VIRTUAL inheritance is refused: the Itanium ABI reaches a virtual base through a VTT and a
// vbase offset in the vtable, neither of which cflat models. The class stays an opaque shell -
// legal to hold through a pointer, illegal to lay out or name a member of. A TEMPLATE
// spelling is a sized blob instead, and IS constructible - see the note below.
// Non-virtual inheritance and virtual DISPATCH are supported; see the inheritance and virtual dispatch section of Test/test_cpp_interop.cb.
import cpp "cpp_interop_poly.h";

extern int main()
{
    expect_error("uses virtual inheritance, which is not supported yet") {
        cpppoly.VBaseMid* m = nullptr;
        int v = m.mv;
    }
    // A TEMPLATE spelling is held as a sized blob, so the layout refusal above never fires and
    // its members reach the binder. Its CONSTRUCTOR is now callable too, through a clang-emitted
    // placement-new thunk - see the virtual-members-through-a-clang-thunk section of Test/test_cpp_interop.cb - so no refusal is
    // pinned for it here.
    return 0;
}
