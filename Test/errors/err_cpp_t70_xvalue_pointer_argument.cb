// A class T&& result is an xvalue, not the class pointer slot. Clang rejects it for T*.
import cpp "utility";
import cpp "cpp_interop_basic.h";

expect_error("cannot pass C++ class xvalue 'cppi.Tracked' to pointer parameter") {
    extern int main()
    {
        cppi.Tracked source = cppi.Tracked(1);
        return cppi.t70_tracked_pointer(std.move(source));
    }
}
