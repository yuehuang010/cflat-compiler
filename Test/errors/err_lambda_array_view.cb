// A 'T[]' array-view is a thin 'ptr' representation, so only a thin `function<T>`
// can take one. A `Lambda<T>` is a fat closure (a by-value struct), so subscripting
// an array-view of them GEPs a struct through a pointer and the module fails LLVM
// verification. Reject it up front; 'Lambda<T>[N]' (a fixed-size array) works.
import "function.cb";

expect_error("array-view '[]' is not supported on closure type 'Lambda<int(int)>'") {
    int sumClosureView(Lambda<int(int)>[] fns, int n, int v)
    {
        int sum = 0;
        for (int i = 0; i < n; i++)
            sum += fns[i](v);
        return sum;
    }
}

// A pointer to a fat closure loads the {code,data} struct as if the pointer WERE the
// struct, so the module fails LLVM verification with no source location. Reject the
// declarator instead; the thin 'function<T>*' spelling is a real pointer and still works.
expect_error("pointer '*' is not supported on closure type 'Lambda<int(int)>'; pass the closure by value or use a fixed size 'Lambda<int(int)>[N]' instead") {
    int callThroughClosurePtr(Lambda<int(int)>* p, int v)
    {
        return (*p)(v);
    }
}

// Same rejection through the 'using' function-type-alias branch of ParseDeclarationSpecifiers.
expect_error("pointer '*' is not supported on closure type 'ClosureAlias'") {
    using ClosureAlias = Lambda<int(int)>;
    ClosureAlias* aliasPtr = nullptr;
}

// A closure/function-pointer field does not own an allocation, so 'unique' on one is
// rejected rather than silently laying the field out by value and freeing a code address.
// Spelled with the THIN 'function<T>*' - the fat 'Lambda<T>*' declarator is rejected
// above before ValidateUniqueField can run, so it could no longer reach this diagnostic.
expect_error("'unique' on field 'FH.p': a function pointer or closure does not own an allocation") {
    struct FH { unique function<int(int)>* p = nullptr; };
}

// The same fat-closure pointer reaching the compiler as a GENERIC TYPE ARGUMENT. Generic
// substitution does not route through ParseDeclarationSpecifiers, so the declarator guard above
// cannot see it; ResolveTypeArgEntry carries the '*' and rejects the fat case there instead.
// Thin 'function<T>*' as a generic argument is SUPPORTED - see Test/test_function_ptr.cb.
expect_error("pointer '*' is not supported on closure type 'Lambda<int(int)>'; pass the closure by value or use a fixed size 'Lambda<int(int)>[N]' instead") {
    struct LavBoxDirect<T> { T item = default; };
    LavBoxDirect<Lambda<int(int)>*> lavDirect = default;
}

expect_error("'unique' on a generic type argument: a function pointer or closure does not own an allocation") {
    struct LavUniqueDirect<T> { T item = default; };
    LavUniqueDirect<unique function<int(int)>*> lavUniqueDirect = default;
}

// The function-type-ALIAS arm of the same resolver: 'using' names the closure, so the rejection
// has to reach it through functionTypeAliases rather than the functionPointerSpecifier branch.
expect_error("pointer '*' is not supported on closure type 'LavAlias'; pass the closure by value or use a fixed size 'LavAlias[N]' instead") {
    using LavAlias = Lambda<int(int)>;
    struct LavBoxAlias<T> { T item = default; };
    LavBoxAlias<LavAlias*> lavAlias = default;
}

expect_error("'unique' on a generic type argument: a function pointer or closure does not own an allocation") {
    using LavUniqueAlias = Lambda<int(int)>;
    struct LavUniqueAliasBox<T> { T item = default; };
    LavUniqueAliasBox<unique LavUniqueAlias*> lavUniqueAlias = default;
}

// The SUBSTITUTION arm: the '*' is written on a type PARAMETER, so by the time it is resolved the
// argument is already an encoded closure name and neither arm above can see it. This spelling
// SIGSEGV'd the compiler (exit with no diagnostic) before the encoded-name funnel got the guard;
// the message names the closure rebuilt from the registered signature.
expect_error("pointer '*' is not supported on closure type 'Lambda<int(int)>'; pass the closure by value or use a fixed size 'Lambda<int(int)>[N]' instead") {
    struct LavBoxSubst<T> { T item = default; };
    struct LavOuter<T> { LavBoxSubst<T*> inner = default; };
    LavOuter<Lambda<int(int)>> lavSubst = default;
}

extern int main()
{
    return 0;
}
