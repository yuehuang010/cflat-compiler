// A C++ constructor parameter declared non-const `int&` cannot bind an integer LITERAL: the
// literal has no address, so the reference would point at a temporary that dies at once.
import cpp "cpp_interop_ctorref.h";
import cpp "cpp_interop_unique_deleter.hpp";
import cpp "cpp_t28_fwdref.hpp";
import "cpp_t103_nullctor_c.h";
import cpp "cpp_t103_nullctor.hpp";
import cpp "cpp_t63_brace_decl.hpp";

void CrDeleteWrongParam(int x) { }
int CrDeleteWrongReturn(move int* p) { delete p; return 1; }

extern int main()
{
    expect_error("constructor 'cppcr.IntRef' parameter 'x'") {
        cppcr.IntRef bad = cppcr.IntRef(5);
    }
    // A bare `nullptr` never binds a non-const `std::nullptr_t&` (clang refuses; pre-fix it
    // picked `long` and failed module verification).
    expect_error("C++ class 'cppcr.NpMutRef' has no constructor whose parameter types match") {
        int v = cppcr.NpMutRef(nullptr).chosen;
    }
    expect_error("constructor 'cppcr.LRef' parameter 'c'") {
        cppcr.LRef bad = cppcr.LRef(cppcr.make_cnt(3), 4);
    }
    expect_error("constructor 'cppcr.LRef' parameter 'x'") {
        cppcr.Cnt c = cppcr.make_cnt(3);
        cppcr.LRef bad = cppcr.LRef(c, 4 + 1);
    }
    expect_error("constructor 'cppcr.RRefPair' parameter 'c'") {
        cppcr.Cnt c = cppcr.make_cnt(3);
        int x = 4;
        cppcr.RRefPair bad = cppcr.RRefPair(c, x);
    }
    // A different scalar type is clang's refusal through the forwarding thunk.
    expect_error("has no constructor that binds these arguments (clang: no matching constructor") {
        char c = 7;
        cppcr.SignedCharRef bad = cppcr.SignedCharRef(c);
    }
    expect_error("has no constructor that binds these arguments (clang: no matching constructor") {
        int i = 7;
        cppcr.LongRef bad = cppcr.LongRef(i);
    }
    // Expression position: a `long` lvalue is not a `long long` lvalue (clang refuses it too).
    expect_error("has no constructor that binds these arguments (clang: no matching constructor") {
        long l = 5;
        int v = cppcr.LongLongRefOnly(l).v;
    }
    // A deleted, private or protected constructor stays in clang's candidate set: the `int&`
    // pick is refused with clang's own diagnostic, never replaced by `const long&`.
    expect_error("has no constructor that binds these arguments (clang: call to deleted constructor") {
        int i = 5;
        int v = cppcr.DelOrConst(i).chosen;
    }
    expect_error("has no constructor that binds these arguments (clang: calling a private constructor") {
        int i = 5;
        int v = cppcr.PrivOrConst(i).chosen;
    }
    expect_error("has no constructor that binds these arguments (clang: calling a protected constructor") {
        int i = 5;
        int v = cppcr.ProtOrConst(i).chosen;
    }
    expect_error("no overload of 'take' matches") {
        cppcr.OrdinarySignedCharCall call = cppcr.OrdinarySignedCharCall();
        char c = 7;
        call.take(c);
    }
    // Equal conversion categories are ambiguous; an omitted default is not a tie-breaker.
    expect_error("is ambiguous") {
        int v = cppcr.RkAmb(3).chosen;
    }
    // int -> long and int -> double are both conversions.
    expect_error("is ambiguous") {
        int rkInt = 3;
        int v = cppcr.RkLD(rkInt).chosen;
    }
    // Two arguments, each candidate better on one: ambiguous.
    expect_error("is ambiguous") {
        int rkInt = 3;
        int v = cppcr.RkTwo(rkInt, rkInt).chosen;
    }
    // nullptr converts to a function pointer and to `int*` alike.
    expect_error("more than one constructor overload") {
        int v = cppcr.RkFnPtr(nullptr).chosen;
    }
    // A function name binds a C++ function-pointer deleter (`const D&` / `D&&`) only when its
    // signature is D's; the in-place `T x = T(args)` route checks it as the temporary route does.
    expect_error("C++ class 'cppt.NoMoveFnUniquePtr<int, function<void(int*)>>' has no constructor") {
        cppt.NoMoveFnUniquePtr<int, function<void(int*)>> bad =
            cppt.NoMoveFnUniquePtr<int, function<void(int*)>>(new int(1), CrDeleteWrongParam);
    }
    expect_error("C++ class 'cppt.NoMoveFnUniquePtr<int, function<void(int*)>>' has no constructor") {
        cppt.NoMoveFnUniquePtr<int, function<void(int*)>> bad =
            cppt.NoMoveFnUniquePtr<int, function<void(int*)>>(new int(2), CrDeleteWrongReturn);
    }
    // A string literal is an array lvalue; its decayed pointer is a prvalue, so a C++ `char *&`
    // parameter cannot bind it, exactly as clang refuses.
    expect_error("no overload of 't28.retarget' matches") {
        int n = t28.retarget("abc");
    }
    // A pointer-reference template and an array-reference template tie for a literal.
    expect_error("call to 'amb' is ambiguous") {
        auto p = t28.amb("abc", 1);
    }
    // T103: no implicit narrowing into a scalar-reference constructor set (ruling 2026-09-04),
    // with no pointer sibling, a usable one, an unusable one (wrong arity) and a pair.
    expect_error("has no constructor whose parameter types match these arguments ('i64')") {
        i64 l = 4294967297;
        t103.NarrowMixed* p = new t103.NarrowMixed(l);
    }
    expect_error("has no constructor whose parameter types match these arguments ('double')") {
        double d = 1.5;
        t103.NarrowMixed* p = new t103.NarrowMixed(d);
    }
    expect_error("has no constructor whose parameter types match these arguments ('i64')") {
        i64 l = 4294967297;
        t103.NarrowPointer* p = new t103.NarrowPointer(l);
    }
    expect_error("has no constructor whose parameter types match these arguments ('double')") {
        double d = 1.5;
        t103.NarrowPointer* p = new t103.NarrowPointer(d);
    }
    expect_error("has no constructor whose parameter types match these arguments ('i64')") {
        i64 l = 4294967297;
        t103.NarrowDead* p = new t103.NarrowDead(l);
    }
    expect_error("has no constructor whose parameter types match these arguments ('double')") {
        double d = 1.5;
        t103.NarrowDead* p = new t103.NarrowDead(d);
    }
    expect_error("has no constructor whose parameter types match these arguments ('i64', 'int')") {
        i64 l = 4294967297;
        t103.NarrowPair* p = new t103.NarrowPair(l, 1);
    }
    expect_error("has no constructor whose parameter types match these arguments ('double', 'int')") {
        double d = 1.5;
        t103.NarrowPair* p = new t103.NarrowPair(d, 1);
    }
    // A non-narrowing candidate exists, but C++ selects (int, char) for (short, int).
    expect_error("narrows argument 2 from 'int' to 'char'") {
        short s = 1;
        int i = 300;
        t103.NarrowRanked* p = new t103.NarrowRanked(s, i);
    }
    expect_error("narrows argument 2 from 'int' to 'char'") {
        short s = 1;
        int i = 300;
        t103.NarrowRanked r = t103.NarrowRanked(s, i);
    }
    expect_error("narrows argument 2 from 'int' to 'char'") {
        short s = 1;
        int i = 300;
        int v = t103.NarrowRanked(s, i).v;
    }
    // A C-header integral zero expression is not a C++ null pointer constant.
    expect_error("no overload of 't103.only_pointer' matches") {
        int v = t103.only_pointer(T103_C_EXPR_ZERO);
    }
    expect_error("no overload of 't103.only_pointer' matches") {
        int v = t103.only_pointer(T103_C_CAST_ZERO);
    }
    expect_error("no overload of 't103.only_pointer' matches") {
        int v = t103.only_pointer(T103_C_CHAR_ZERO);
    }
    expect_error("is an rvalue reference; pass 'move <arg>' or a temporary") {
        function<int(int)> f = t63.call_plus_one;
        int value = t63.call_fn_rvalue_ref(t63.CallFnRvalueRef(f));
    }
    expect_error("is an rvalue reference; pass 'move <arg>' or a temporary") {
        function<int(int)> f = t63.call_plus_one;
        int value = t63.call_fn_rvalue_ref_template(t63.CallFnRvalueRef(f));
    }
    return 0;
}
