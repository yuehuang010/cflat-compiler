interface IOvlStrictCall { int f(int value); int f(double value) const; };
class OvlStrictCall : IOvlStrictCall
{
    int f(int value) { return 1; }
    int f(double value) const { return 2; }
};

extern int main()
{
    OvlStrictCall concrete;
    IOvlStrictCall iface = concrete;
    const OvlStrictCall constConcrete = concrete;
    const IOvlStrictCall constIface = iface;
    expect_error("cannot call non-const member 'f'") {
        int rejected = constConcrete.f(1);
    }
    return 0;
}
