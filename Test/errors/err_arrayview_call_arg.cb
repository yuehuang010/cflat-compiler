// Passing a raw `int*` to an `int[]` parameter forges the noalias contract at the call site.
expect_error("cannot pass a raw pointer 'T*' as array-view parameter") {
    void kernel(int[] a, int n) { a[0] = 1; }
    void f(int* p) { kernel(p, 4); }
}

// Value axis of the same gate: an 'IA[]' indexes fat {vtable,data} elements, so a single value -
// an implementor, or even a fat 'IA' - is not one element of it and must not bind.
expect_error("cannot pass a 'BvcImpl' value as array-view parameter") {
    interface IBvc { int bvc(); };
    class BvcImpl : IBvc { int k = default; int bvc() { return k; } };
    int bvcTake(IBvc[] v) { return v == nullptr ? 0 : v[0].bvc(); }
    int bvcCall() { BvcImpl b; b.k = 1; return bvcTake(b); }
}

expect_error("cannot pass a 'IBvf' value as array-view parameter") {
    interface IBvf { int bvf(); };
    class BvfImpl : IBvf { int k = default; int bvf() { return k; } };
    int bvfTake(IBvf[] v) { return v == nullptr ? 0 : v[0].bvf(); }
    int bvfCall() { BvfImpl b; b.k = 1; IBvf i = b; return bvfTake(i); }
}

// Same value axis at the VIRTUAL-dispatch door: a vtable slot lowers its own arguments, so the
// gate must fire there too (before the fix this forged a call the module verifier rejected).
expect_error("cannot pass a 'BvvImpl' value as array-view parameter") {
    interface IBvv { int bvv(); };
    class BvvImpl : IBvv { int k = default; int bvv() { return k; } };
    interface IBvvHost { int bvvHost(IBvv[] v); };
    class BvvHostImpl : IBvvHost { int bvvHost(IBvv[] v) { return v == nullptr ? 0 : v[0].bvv(); } };
    int bvvCall() { BvvHostImpl h; BvvImpl b; b.k = 1; IBvvHost hi = h; return hi.bvvHost(b); }
}

// FIELD door of the same value axis. Brace-init is a separate lowering from the call and the '='
// store, so the legs above say nothing about it: before the fix `{ v = classValue }` boxed a fat
// {vtable,data} into the thin 'IA[]' slot, passed '--check' clean and SIGSEGVd at v[0].
expect_error("cannot brace-initialize array-view field 'BviDest.v' ('IBvi[]') from 'BviImpl'") {
    interface IBvi { int bvi(); };
    class BviImpl : IBvi { int k = default; int bvi() { return k; } };
    struct BviDest { IBvi[] v = default; };
    int bviCall() { BviImpl b; b.k = 1; BviDest d = { v = b }; return d.v[0].bvi(); }
}

// ELEMENT-IDENTITY leg of the same field door: a view of a DIFFERENT interface is a view, so it
// slipped past the single-object guard and kept the source's vtables (dispatched IBxb::xb).
expect_error("cannot bind an array view of 'IBxb' to a destination of 'IBxa'") {
    interface IBxa { int xa(); };
    interface IBxb { int xb(); };
    class BxbImpl : IBxb { int k = default; int xb() { return k; } };
    struct BxDest { IBxa[] v = default; };
    int bxCall() { IBxb[] bv = new IBxb[1]; BxbImpl* c = new BxbImpl(); c->k = 1; bv[0] = c;
                   BxDest d = { v = bv }; return d.v[0].xa(); }
}

// Same-name interfaces in two namespaces: the bare NAME matched, so only interface IDENTITY
// separates them.
expect_error("cannot bind an array view of 'BxnsB.IBxn' to a destination of 'BxnsA.IBxn'") {
    namespace BxnsA { interface IBxn { int xa(); }; };
    namespace BxnsB { interface IBxn { int xb(); }; };
    class BxnImpl : BxnsB.IBxn { int k = default; int xb() { return k; } };
    struct BxnDest { BxnsA.IBxn[] v = default; };
    int bxnCall() { BxnsB.IBxn[] bv = new BxnsB.IBxn[1]; BxnImpl* c = new BxnImpl(); c->k = 1;
                    bv[0] = c; BxnDest d = { v = bv }; return d.v[0].xa(); }
}

// Fat sibling: an 'IBvg' value is still ONE element, not a view of them.
expect_error("cannot brace-initialize array-view field 'BvgDest.v' ('IBvg[]') from 'IBvg'") {
    interface IBvg { int bvg(); };
    class BvgImpl : IBvg { int k = default; int bvg() { return k; } };
    struct BvgDest { IBvg[] v = default; };
    int bvgCall() { BvgImpl b; b.k = 1; IBvg i = b; BvgDest d = { v = i }; return d.v[0].bvg(); }
}

// Pointer row, which the '=' twin already rejects ("cannot bind a raw pointer 'T*' to an
// array-view 'T[]'"): a 'BvpImpl*' points at ONE object, so brace-init must not bind it either.
expect_error("cannot brace-initialize array-view field 'BvpDest.v' ('IBvp[]') from 'BvpImpl*'") {
    interface IBvp { int bvp(); };
    class BvpImpl : IBvp { int k = default; int bvp() { return k; } };
    struct BvpDest { IBvp[] v = default; };
    int bvpCall() { BvpImpl* p = new BvpImpl(); p.k = 1; BvpDest d = { v = p }; return d.v[0].bvp(); }
}

// Bare-brace spelling of the declarator, and a GENERIC 'T[]' field - both reach the same gate.
expect_error("cannot brace-initialize array-view field 'BvbBox<IBvb>.w' ('IBvb[]') from 'BvbImpl'") {
    interface IBvb { int bvb(); };
    class BvbImpl : IBvb { int k = default; int bvb() { return k; } };
    struct BvbBox<T> { T[] w = default; };
    int bvbCall() { BvbImpl b; b.k = 1; BvbBox<IBvb> d { w = b }; return d.w[0].bvb(); }
}

// ELEMENT axis of the same field door. A fixed array, a heap array and a view OF THE CONCRETE
// IMPLEMENTOR index thin objects, so none of them is an 'IBve[]'. Master rejects these with the
// identical text from inside BoxConcreteIntoInterface; excluding views from the brace-init boxing
// arm took that guard away, so these three legs are the tripwire for that hole.
expect_error("cannot convert 'BveImpl[2]' to interface 'IBve'") {
    interface IBve { int bve(); };
    class BveImpl : IBve { int k = default; int bve() { return k; } };
    struct BveDest { IBve[] v = default; };
    int bveCall() { BveImpl[2] a; a[0].k = 1; BveDest d = { v = a }; return d.v[0].bve(); }
}

expect_error("cannot convert 'BvnImpl[]' to interface 'IBvn'") {
    interface IBvn { int bvn(); };
    class BvnImpl : IBvn { int k = default; int bvn() { return k; } };
    struct BvnDest { IBvn[] v = default; };
    int bvnCall() { BvnDest d = { v = new BvnImpl[2] }; return d.v[0].bvn(); }
}

expect_error("cannot convert 'BvwImpl[]' to interface 'IBvw'") {
    interface IBvw { int bvw(); };
    class BvwImpl : IBvw { int k = default; int bvw() { return k; } };
    struct BvwDest { IBvw[] v = default; };
    int bvwCall() { BvwImpl[2] a; a[0].k = 1; BvwImpl[] w = a; BvwDest d = { v = w }; return d.v[0].bvw(); }
}

// NON-interface element, call door: a 'Bnc' value is one object, not a view of them. Before the
// widening this bound silently and the callee indexed a stack temp as if it were an array.
expect_error("cannot pass a 'Bnc' value as array-view parameter 'v' ('Bnc[]')") {
    struct Bnc { int k = default; };
    int bncTake(Bnc[] v) { return v == nullptr ? 0 : v[0].k; }
    int bncCall() { Bnc b; b.k = 1; return bncTake(b); }
}

// Element read 'a[0]' is a value too, and a METHOD lowers its arguments by the same ABI.
expect_error("cannot pass a 'Bnm' value as array-view parameter 'v' ('Bnm[]')") {
    struct Bnm { int k = default; };
    class BnmHost { int put(Bnm[] v) { return v == nullptr ? 0 : v[0].k; } };
    int bnmCall() { Bnm[2] a; BnmHost h; return h.put(a[0]); }
}

// Virtual-dispatch door with a non-interface view parameter: before the widening this forged a
// call the module verifier rejected ("module verification failed"), not a diagnostic.
expect_error("cannot pass a 'Bnv' value as array-view parameter 'v' ('Bnv[]')") {
    struct Bnv { int k = default; };
    interface IBnvHost { int host(Bnv[] v); };
    class BnvHost : IBnvHost { int host(Bnv[] v) { return v == nullptr ? 0 : v[0].k; } };
    int bnvCall() { BnvHost h; Bnv b; b.k = 1; IBnvHost hi = &h; return hi.host(b); }
}

// Generic 'T[]' parameter instantiated at a plain struct reaches the same gate.
expect_error("cannot pass a 'Bng' value as array-view parameter 'v' ('Bng[]')") {
    struct Bng { int k = default; };
    int bngTake<T>(T[] v) { return v == nullptr ? 0 : 1; }
    int bngCall() { Bng b; b.k = 1; return bngTake<Bng>(b); }
}

// FIELD door, non-interface element: brace-init stored the 4-byte value into the thin view slot,
// passed '--check' and SIGSEGVd at v[0].
expect_error("cannot brace-initialize array-view field 'BnfDest.v' ('Bnf[]') from 'Bnf'") {
    struct Bnf { int k = default; };
    struct BnfDest { Bnf[] v = default; };
    int bnfCall() { Bnf b; b.k = 1; BnfDest d = { v = b }; return d.v[0].k; }
}

// Pointer row of the same field door: a 'Bnp*' points at ONE object. The '=' store twin already
// rejects it ("cannot bind a raw pointer 'T*' to an array-view 'T[]'"); brace-init did not.
expect_error("cannot brace-initialize array-view field 'BnpDest.v' ('Bnp[]') from 'Bnp*'") {
    struct Bnp { int k = default; };
    struct BnpDest { Bnp[] v = default; };
    int bnpCall() { Bnp* p = new Bnp(); p.k = 1; BnpDest d = { v = p }; return d.v[0].k; }
}

// MISMATCHED-ELEMENT rows of the same non-interface field door. The single-object guard compared
// the source type to the element and returned false when they DIFFERED, so a whole other struct
// bound silently: the value row SIGSEGVd at v[0], the three element rows strided 'BnrOther' data
// as 'Bnr' (a 2-int source read as 1-int elements returned the source's second field).
expect_error("cannot brace-initialize array-view field 'BnqDest.v' ('Bnq[]') from 'BnqOther'") {
    struct Bnq { int k = default; };
    struct BnqOther { int a = default; };
    struct BnqDest { Bnq[] v = default; };
    int bnqCall() { BnqOther o; o.a = 5; BnqDest d = { v = o }; return d.v[0].k; }
}

// Pointer spelling of the same mismatch: a 'BnqpOther*' points at ONE object of the wrong type.
expect_error("cannot brace-initialize array-view field 'BnqpDest.v' ('Bnqp[]') from 'BnqpOther*'") {
    struct Bnqp { int k = default; };
    struct BnqpOther { int a = default; };
    struct BnqpDest { Bnqp[] v = default; };
    int bnqpCall() { BnqpOther* p = new BnqpOther(); p.a = 5; BnqpDest d = { v = p }; return d.v[0].k; }
}

// Fixed-array element row - the '=' door does not see this one (a fixed array is not yet a view),
// so this leg is the only guard on it.
expect_error("cannot bind an array view of 'BnrOther' to a destination of 'Bnr'") {
    struct Bnr { int k = default; };
    struct BnrOther { int a = default; int b = default; };
    struct BnrDest { Bnr[] v = default; };
    int bnrCall() { BnrOther[2] a; a[0].a = 1; a[0].b = 2; BnrDest d = { v = a }; return d.v[1].k; }
}

// View element row: same text as the '=' door emits for 'd.v = view'.
expect_error("cannot bind an array view of 'BnsOther' to a destination of 'Bns'") {
    struct Bns { int k = default; };
    struct BnsOther { int a = default; int b = default; };
    struct BnsDest { Bns[] v = default; };
    int bnsCall() { BnsOther[2] a; BnsOther[] w = a; BnsDest d = { v = w }; return d.v[1].k; }
}

// Heap element row: a counted 'new T[n]' of the wrong element is a view source too.
expect_error("cannot bind an array view of 'BntOther' to a destination of 'Bnt'") {
    struct Bnt { int k = default; };
    struct BntOther { int a = default; int b = default; };
    struct BntDest { Bnt[] v = default; };
    int bntCall() { BntDest d = { v = new BntOther[2] }; return d.v[1].k; }
}

// PRIMITIVE axis of the same family, four doors. A runtime 'int' was converted to a thin pointer
// and indexed: all four passed '--check' and SIGSEGVd at v[0]. Only a folded constant zero is the
// null-view spelling ('int[] v = 0;' and '{ p = 0 }' still bind - see Test/test_core.cb).
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    int bpiCall() { int x = 4; int[] v = x; return v[0]; }
}

// '=' store door, which is a separate lowering from the declarator init above.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    int bpsCall() { int x = 4; int[] v = 0; v = x; return v[0]; }
}

// Brace-init FIELD door: the primitive early-out of the view-field gate let every non-zero
// primitive through, which is why the class-value fix could not close this one.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    struct BpfDest { int[] p = default; };
    int bpfCall() { int x = 4; BpfDest d = { p = x }; return d.p[0]; }
}

// RETURN door: the callee hands back a number for the caller to index.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    int[] bprMake(int x) { return x; }
    int bprCall() { return bprMake(4)[0]; }
}

// An ELEMENT read of a fixed array is a scalar too - the row bind 'int[] r = md[1]' of an
// 'int[2][3]' stays legal (asserted by value in Test/test_basic.cb), a scalar element does not.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    int bpeCall() { int[2] f; f[0] = 7; int[] e = f[0]; return e[0]; }
}

// A 'float' view takes the same rule: the guard keys on the primitive SHAPE, not on 'int'.
expect_error("cannot bind a 'float' value to array view 'float[]'") {
    int bpxCall() { float f = 1.0; float[] v = f; return v[0] > 0.0 ? 1 : 0; }
}

// FIXED-ARRAY element axis, the three non-brace doors. A fixed array is not a view, so the
// element compare was skipped and the store decayed it to a thin pointer of the DESTINATION's
// element: 'd.v[1].k' read 'qArr[0].b' (22 where 33 was stored). Same text as the view row.
expect_error("cannot bind an array view of 'BfsOther' to a destination of 'Bfs'") {
    struct Bfs { int k = default; };
    struct BfsOther { int a = default; int b = default; };
    struct BfsDest { Bfs[] v = default; };
    int bfsCall() { BfsOther[2] a; BfsDest d = default; d.v = a; return d.v[1].k; }
}

// Same door, a plain local view destination rather than a field.
expect_error("cannot bind an array view of 'BflOther' to a destination of 'Bfl'") {
    struct Bfl { int k = default; };
    struct BflOther { int a = default; int b = default; };
    int bflCall() { BflOther[2] a; Bfl[] v = default; v = a; return v[1].k; }
}

// Declarator-init door, a separate lowering from the '=' store above.
expect_error("cannot bind an array view of 'BfdOther' to a destination of 'Bfd'") {
    struct Bfd { int k = default; };
    struct BfdOther { int a = default; int b = default; };
    int bfdCall() { BfdOther[2] a; Bfd[] v = a; return v[1].k; }
}

// RETURN door: the callee hands the caller a view strided by the wrong element.
expect_error("cannot return an array view of 'BfrOther' from a function whose return element is 'Bfr'") {
    struct Bfr { int k = default; };
    struct BfrOther { int a = default; int b = default; };
    Bfr[] bfrMake() { BfrOther[2] a; return a; }
    int bfrCall() { return bfrMake()[1].k; }
}

// PRIMITIVE twin of the same reshape: the element sizes differ, so the view strides wrong.
expect_error("cannot bind an array view of 'int' to a destination of 'long'") {
    int bfpCall() { int[3] a; long[] v = a; return (int)v[0]; }
}

// Primitive twin at the return door.
expect_error("cannot return an array view of 'int' from a function whose return element is 'long'") {
    long[] bfqMake() { int[3] a; return a; }
    int bfqCall() { return (int)bfqMake()[0]; }
}

// INTERFACE twin: a fixed array of an IMPLEMENTOR indexes thin objects, so binding it to an
// 'IA[]' forges a fat view over them - it SIGSEGVd at fv[1].val() before this reshape.
expect_error("cannot bind an array view of 'BfiImpl' to a destination of 'BfiIface'") {
    interface BfiIface { int val(); };
    class BfiImpl : BfiIface { int v = default; int val() { return this.v; } };
    int bfiCall() { BfiImpl[2] a; BfiIface[] v = a; return v[1].val(); }
}

// LITERAL row of the same four doors. A NAMED source ('int x', '4 + 1') was caught above, but a
// BARE literal names no type at all and took the unnamed early-out, so 'int[] v = 5;' passed
// '--check' and SIGSEGVd at v[0]. Decided by the constant now: only a null one binds.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    int bplCall() { int[] v = 5; return v[0]; }
}

// '=' store door, bare literal.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    int bplsCall() { int[] v = 0; v = 5; return v[0]; }
}

// Brace-init FIELD door, bare literal: the field gate's own unnamed early-out ran BEFORE the
// primitive guard, so this door needed the guard hoisted above it.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    struct BplfDest { int[] p = default; };
    int bplfCall() { BplfDest d = { p = 5 }; return d.p[0]; }
}

// RETURN door, bare literal.
expect_error("cannot bind a 'int' value to array view 'int[]'") {
    int[] bplrMake() { return 5; }
    int bplrCall() { return bplrMake()[0]; }
}

// Non-int spelling of the literal row: 'true' is an unnamed i1 constant, so it is spelled 'bool'.
expect_error("cannot bind a 'bool' value to array view 'bool[]'") {
    int bplbCall() { bool[] v = true; return v[0] ? 1 : 0; }
}

// An unnamed FLOAT constant reached LLVM as 'bitcast (float to ptr)' and failed module
// verification instead of reporting; same guard now spells it before any IR is emitted.
expect_error("cannot bind a 'float' value to array view 'float[]'") {
    int bplxCall() { float[] v = 1.0 + 0.5; return v[0] > 0.0 ? 1 : 0; }
}

// ENUM row of the same four doors. A member names its ENUM, which is not a primitive NAME, so it
// took the named early-out above and every door passed '--check' and SIGSEGVd at v[0]. The enum
// hops to its backing integer now; a ZERO member is still the null-view spelling and still binds
// (asserted by value in Test/test_core.cb).
enum Bpn : int { BPN_ZERO = 0, BPN_ONE = 1 };

expect_error("cannot bind a 'Bpn' value to array view 'int[]'") {
    int bpniCall() { int[] v = Bpn.BPN_ONE; return v[0]; }
}

// '=' store door, enum member.
expect_error("cannot bind a 'Bpn' value to array view 'int[]'") {
    int bpnsCall() { int[] v = 0; v = Bpn.BPN_ONE; return v[0]; }
}

// Brace-init FIELD door, enum member.
expect_error("cannot bind a 'Bpn' value to array view 'int[]'") {
    struct BpnfDest { int[] p = default; };
    int bpnfCall() { BpnfDest d = { p = Bpn.BPN_ONE }; return d.p[0]; }
}

// RETURN door, enum member.
expect_error("cannot bind a 'Bpn' value to array view 'int[]'") {
    int[] bpnrMake() { return Bpn.BPN_ONE; }
    int bpnrCall() { return bpnrMake()[0]; }
}

// A NAMED enum LOCAL is not a member, so nothing proves its slot stays zero - same rule as the
// named 'int x' row, and the enum name is what gets spelled.
expect_error("cannot bind a 'Bpn' value to array view 'int[]'") {
    int bpnvCall() { Bpn e = Bpn.BPN_ONE; int[] v = e; return v[0]; }
}

// A namespaced enum resolves through the scoped walk and is spelled with its qualified name; the
// destination is an enum view here, so the element type is the enum itself.
namespace BpnNs { enum Dir : int { D_ZERO = 0, D_ONE = 1 }; }
expect_error("cannot bind a 'BpnNs.Dir' value to array view 'BpnNs.Dir[]'") {
    int bpnnCall() { BpnNs.Dir[] v = BpnNs.Dir.D_ONE; return (int)v[0]; }
}
