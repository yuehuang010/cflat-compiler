expect_error("transfers nothing") {
    int t79_assign_cond_move_copy()
    {
        cppi_opcref.CO c = cppi_opcref.CO(1);
        cppi_opcref.CO d = cppi_opcref.CO(4);
        cppi_opcref.CO e = cppi_opcref.CO(5);
        bool cond = true;
        c = (cond ? move d : move e);
        return c.v;
    }
}
