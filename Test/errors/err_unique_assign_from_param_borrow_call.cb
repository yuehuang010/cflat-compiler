struct N { int id = 0; };
struct Holder { unique N* p = nullptr; };
unique N* globalOwner = nullptr;
N* borrowFirstResource(N* a, N* b) { return a; }
N* mixedReturnResource(N* p, bool c) { if (c) { return p; } return nullptr; }

expect_error("cannot assign unique") {
    void rejectLocal() {
        unique N* h = new N();
        unique N* owner = nullptr;
        owner = borrowFirstResource(h, new N());
    }
}

expect_error("cannot assign borrowed value") {
    void rejectField() {
        Holder box = default;
        unique N* h = new N();
        box.p = borrowFirstResource(h, new N());
    }
}

expect_error("cannot assign unique") {
    void rejectGlobal() {
        unique N* h = new N();
        globalOwner = borrowFirstResource(h, new N());
    }
}

expect_error("cannot assign unique") {
    void rejectTernaryArgument() {
        unique N* h = new N();
        bool useNew = true;
        unique N* owner = nullptr;
        owner = borrowFirstResource(h, useNew ? new N() : nullptr);
    }
}

expect_error("cannot assign unique") {
    void rejectTernaryNullArgument() {
        unique N* h = new N();
        bool useNew = false;
        unique N* owner = nullptr;
        owner = borrowFirstResource(h, useNew ? new N() : nullptr);
    }
}

expect_error("cannot assign unique") {
    void rejectMixedReturn() {
        unique N* owner = nullptr;
        owner = mixedReturnResource(new N(), true);
    }
}

N* globalN = nullptr;
N* pick<T>(N* p) {
    if const (sizeof(T) == 4) { return globalN; }
    else { return p; }
}

// i64 selects the parameter return; int selects the global return on this host.
expect_error("cannot assign unique") {
    void rejectGenericParameterReturn() {
        unique N* owner = nullptr;
        owner = pick<i64>(nullptr);
    }
}

expect_error("cannot assign unique<N> 'a' from borrowed value 'pick<i64>'") {
    void rejectGenericParameterReturnDiagnostic() {
        unique N* a = nullptr;
        a = pick<i64>(nullptr);
    }
}

expect_error("cannot initialize unique") {
    void rejectGenericGlobalReturn(bool choose) {
        unique N* owner = nullptr;
        owner = choose ? pick<int>(nullptr) : nullptr;
    }
}

expect_error("cannot initialize unique") {
    void rejectGenericGlobalReturnDirect() {
        unique N* owner = nullptr;
        owner = pick<int>(nullptr);
    }
}

N* deadPick(N* p) {
    if const (false) { return p; }
    else { return globalN; }
}

expect_error("cannot initialize unique") {
    void rejectDeadIfConstReturn(bool choose) {
        unique N* owner = nullptr;
        owner = choose ? deadPick(nullptr) : nullptr;
    }
}

struct Box<T> { N* pk<U>(N* q) { return q; } };
struct Plain { N* gp<U>(N* q) { return q; } };
namespace ns { struct Leaf { int id = 0; }; }

expect_error("cannot assign unique<N> 'a' from borrowed value 'Box<i64>.pk<i64>'") {
    void rejectGenericMethodAssignment(Box<i64>* b, N* q) {
        unique N* a = nullptr;
        a = b.pk<i64>(q);
    }
}

expect_error("cannot return borrowed value 'Box<i64>.pk<i64>'") {
    unique N* rejectGenericMethodReturn(Box<i64>* b, N* q) {
        return b.pk<i64>(q);
    }
}

expect_error("cannot initialize unique<N> 'a' from borrowed value 'Box<i64>.pk<i64>'") {
    void rejectGenericMethodDeclaration(Box<i64>* b, N* q) {
        unique N* a = b.pk<i64>(q);
    }
}

expect_error("cannot initialize unique<N> 'a' from borrowed value 'Plain.gp<i64>'") {
    void rejectPlainGenericMethodDeclaration(Plain* b, N* q) {
        unique N* a = b.gp<i64>(q);
    }
}

expect_error("cannot assign unique<N> 'a' from borrowed value 'Box<i64>.pk<ns.Leaf>'") {
    void rejectMethodWithNamespacedGenericArgument(Box<i64>* b) {
        unique N* a = nullptr;
        a = b.pk<ns.Leaf>(nullptr);
    }
}
