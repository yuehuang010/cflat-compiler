import "../library/c_macro_helpers.h";

struct T489Fixed { int data[2] = default; };
struct T489FixedInner { int data[2] = default; };
struct T489FixedOuter { T489FixedInner inner = default; };
struct T489ZeroOuter { CBF_ZeroInt inner; };

void T489Sink(move int* p) { }

// T489 discriminator: CFlat fixed-size; t489_fixed_arrow_declaration_init.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_arrow_declaration_init() { T489Fixed* a = (T489Fixed*)malloc(64); int* out = move a->data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_arrow_assignment.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_arrow_assignment() { T489Fixed* a = (T489Fixed*)malloc(64); int* out = nullptr; out = move a->data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_arrow_move_param_call.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_arrow_move_param_call() { T489Fixed* a = (T489Fixed*)malloc(64); T489Sink(move a->data); }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_arrow_return.
expect_error("cannot move an array member; take its address or copy the elements") {
    int* t489_fixed_arrow_return() { T489Fixed* a = (T489Fixed*)malloc(64); return move a->data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_deref_dot_declaration_init.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_deref_dot_declaration_init() { T489Fixed* a = (T489Fixed*)malloc(64); int* out = move (*a).data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_deref_dot_assignment.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_deref_dot_assignment() { T489Fixed* a = (T489Fixed*)malloc(64); int* out = nullptr; out = move (*a).data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_deref_dot_move_param_call.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_deref_dot_move_param_call() { T489Fixed* a = (T489Fixed*)malloc(64); T489Sink(move (*a).data); }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_deref_dot_return.
expect_error("cannot move an array member; take its address or copy the elements") {
    int* t489_fixed_deref_dot_return() { T489Fixed* a = (T489Fixed*)malloc(64); return move (*a).data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_dot_declaration_init.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_dot_declaration_init() { T489Fixed s = default; int* out = move s.data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_dot_assignment.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_dot_assignment() { T489Fixed s = default; int* out = nullptr; out = move s.data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_dot_move_param_call.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_dot_move_param_call() { T489Fixed s = default; T489Sink(move s.data); }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_dot_return.
expect_error("cannot move an array member; take its address or copy the elements") {
    int* t489_fixed_dot_return() { T489Fixed s = default; return move s.data; }
}

// T489 discriminator: CFlat fixed-size; t489_fixed_nested_declaration_init.
expect_error("cannot move an array member; take its address or copy the elements") {
    void t489_fixed_nested_declaration_init() { T489FixedOuter s = default; int* out = move s.inner.data; }
}

