import "list.cb";
import "dictionary.cb";
import cpp "functional";

// Returning a lambda that reference-captures a local struct must fail with a
// bond escape error - the lambda would outlive the captured stack variable.

struct Counter {
    int value = default;
};

Lambda<void()> escape() {
    expect_error("bonded value whose source 'c' is not a 'bond' parameter");
    Counter c;
    Lambda<void()> inc = () => { c.value = c.value + 1; };
    return inc;
}

Lambda<void()> id(Lambda<void()> f) { return f; }
Lambda<void()> gEscapedThroughIdentity = default;

Lambda<void()> escapeThroughIdentityReturn() {
    expect_error("bonded value whose source 'c' is not a 'bond' parameter");
    Counter c;
    Lambda<void()> inc = () => { c.value = c.value + 1; };
    return id(inc);
}

void escapeThroughIdentityStore() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    Counter c;
    Lambda<void()> inc = () => { c.value = c.value + 1; };
    gEscapedThroughIdentity = id(inc);
}

extern int main() {
    _ = escapeThroughIdentityReturn();
    escapeThroughIdentityStore();
    _ = t529EscapeIdentityReturn();
    t529EscapeIdentityStore();
    t529EscapeSetterReceiver();
    t529EscapeSetterReceiverCounts();
    t529EscapeSetterGlobal();
    t529EscapeSetterPointer();
    t529EscapeGlobalWithUnrelatedArgument();
    t529EscapeThroughPointerReceiver();
    t529EscapeTwoHopIdentity();
    t529EscapeTernaryIdentity();
    t529EscapeNestedReceiverCall();
    t529R3EscapeReceiverAndGlobal();
    t529R3EscapeParamAndGlobal();
    t529R3RejectEarlierSameScopeDestination();
    t529R4EscapeHelperLookalike();
    return 0;
}

// A by-reference capture of a unique pointee must stay bonded through a closure-valued identity call.
struct T529IdentityRes { int value = default; };
Lambda<int()> t529Identity(Lambda<int()> value) { return value; }
Lambda<int()> t529Escaped = default;
Lambda<int()> t529EscapeIdentityReturn() {
    expect_error("bonded value whose source 'owner' is not a 'bond' parameter");
    unique<T529IdentityRes> owner = unique<T529IdentityRes>(new T529IdentityRes());
    owner->value = 23;
    return t529Identity(() => { return owner->value; });
}
void t529EscapeIdentityStore() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    unique<T529IdentityRes> owner = unique<T529IdentityRes>(new T529IdentityRes());
    owner->value = 23;
    t529Escaped = t529Identity(() => { return owner->value; });
}
// A by-value closure parameter stored into a wider receiver escapes the owner's scope.
struct T529SetterRes { int value = default; };
struct T529SetterBox { Lambda<int()> value = default; void set(Lambda<int()> next) { value = next; } };
void t529EscapeSetterReceiver() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    T529SetterBox box;
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        owner->value = 43;
        box.set(() => { return owner->value; });
    }
}
void t529EscapeSetterReceiverCounts() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    T529SetterBox box;
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        owner->value = 43;
        box.set(() => { return owner->value; });
    }
}

Lambda<int()> t529GlobalClosure = default;
void t529StoreSetterGlobal(Lambda<int()> next) { t529GlobalClosure = next; }
void t529EscapeSetterGlobal() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
    owner->value = 47;
    t529StoreSetterGlobal(() => { return owner->value; });
}

struct T529SetterHolder { Lambda<int()> value = default; };
void t529StoreSetterPointer(T529SetterHolder* destination, Lambda<int()> next) {
    destination->value = next;
}
void t529EscapeSetterPointer() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    T529SetterHolder holder;
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        owner->value = 53;
        t529StoreSetterPointer(&holder, () => { return owner->value; });
    }
}

void t529StoreGlobalWithInt(int unrelated, Lambda<int()> next) {
    t529GlobalClosure = next;
}

void t529EscapeGlobalWithUnrelatedArgument() {
    expect_error("bonded value");
    unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
    owner->value = 61;
    int unrelated = 1;
    t529StoreGlobalWithInt(unrelated, () => { return owner->value; });
}

void t529EscapeThroughPointerReceiver() {
    expect_error("bonded value");
    T529SetterBox box;
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        owner->value = 67;
        T529SetterBox* pointer = &box;
        pointer->set(() => { return owner->value; });
    }
}

void t529EscapeTwoHopIdentity() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
    owner->value = 71;
    t529Escaped = t529Identity(t529Identity(() => { return owner->value; }));
}

void t529EscapeTernaryIdentity() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
    owner->value = 73;
    bool choose = true;
    t529Escaped = choose
        ? t529Identity(() => { return owner->value; })
        : t529Identity(() => { return owner->value + 1; });
}

struct T529NestedMaker {
    Lambda<int()> make(Lambda<int()> value) { return t529Identity(value); }
};

void t529EscapeNestedReceiverCall() {
    expect_error("bonded value");
    T529SetterBox box;
    T529NestedMaker maker;
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        owner->value = 79;
        box.set(maker.make(() => { return owner->value; }));
    }
}

// Receiver stores the closure locally and also into a global: the global sink refuses.
Lambda<int()> t529R3Global = default;
struct T529R3ReceiverAndGlobal {
    Lambda<int()> value = default;
    void set(Lambda<int()> next) { value = next; t529R3Global = next; }
};
void t529R3EscapeReceiverAndGlobal() {
    expect_error("bonded value");
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        T529R3ReceiverAndGlobal receiver;
        Lambda<int()> closure = () => { return owner->value; };
        receiver.set(closure);
    }
}

// Parameter stores the closure in a holder and also into a global: the global sink refuses.
struct T529R3Holder { Lambda<int()> value = default; };
void t529R3StoreParamAndGlobal(T529R3Holder* holder, Lambda<int()> next) {
    holder->value = next;
    t529R3Global = next;
}
void t529R3EscapeParamAndGlobal() {
    expect_error("bonded value");
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        T529R3Holder holder;
        Lambda<int()> closure = () => { return owner->value; };
        t529R3StoreParamAndGlobal(&holder, closure);
    }
}

// The receiver is declared before the closure's source at the same depth; its destructor runs
// after the source is gone, so the store refuses.
int t529R3Seen = 0;
struct T529R3DtorReceiver {
    Lambda<int()> value = default;
    void set(Lambda<int()> next) { value = next; }
    ~T529R3DtorReceiver() { t529R3Seen = value(); }
};
void t529R3RejectEarlierSameScopeDestination() {
    expect_error("bonded value");
    T529R3DtorReceiver receiver;
    unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
    Lambda<int()> closure = () => { return owner->value; };
    receiver.set(closure);
}

// A list<T> is a non-pointer struct, so it reference-captures like the Counter above and the
// closure is bonded to it. Pre-fix the list was deep-copied into the env, the return compiled,
// and the body's mutations were silently discarded. One leg per function: the bare-semicolon
// form arms the expectation for the rest of the enclosing scope.
Lambda<void()> escapeList() {
    expect_error("bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    Lambda<void()> add = () => { xs.add(1); };
    return add;
}

// Same for a dictionary, and through an ASSIGNMENT to a wider scope rather than a return.
void escapeDictToWiderScope() {
    expect_error("'sink' is in a wider scope than its bond source 'd'");
    Lambda<void()> sink = default;
    {
        dictionary<string, int> d = default;
        sink = () => { d.set("a", 1); };
    }
    sink();
}

// A struct field is safe only when its holder dies no later than the source.
struct ListHolder { Lambda<void()> f = default; };
void escapeListIntoField() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    ListHolder h = default;
    {
        list<int> xs = default;
        h.f = () => { xs.add(1); };
    }
}

void rejectSameScopeHolderBeforeSource() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    ListHolder h = default;
    list<int> xs = default;
    h.f = () => { xs.add(1); };
}

struct HolderOuter { ListHolder p = default; };

void escapeCopiedHolderField() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    HolderOuter q = default;
    q.p = h;
}

void escapeCopiedHolderPointer() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    HolderOuter q = default;
    ListHolder* pp = &q.p;
    *pp = h;
}

void escapeCopiedHolderBrace() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    HolderOuter q = { p = h };
}

void escapeCopiedHolderList() {
    expect_error("cannot pass a holder containing a bonded closure to a function");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    list<ListHolder> holders = default;
    holders.add(h);
}

void receiveBondedHolderValue(ListHolder h) { }
void receiveBondedHolderAlias(alias ListHolder h) { }

void escapeCopiedHolderValueArg() {
    expect_error("cannot pass a holder containing a bonded closure to a function");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    receiveBondedHolderValue(h);
}

void escapeCopiedHolderAliasArg() {
    expect_error("cannot pass a holder containing a bonded closure to a function");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    receiveBondedHolderAlias(h);
}

void receiveBondedHolderPointer(ListHolder* h) { }

void escapeCopiedHolderPointerArg() {
    expect_error("cannot pass a holder containing a bonded closure to a function");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    receiveBondedHolderPointer(&h);
}

ListHolder returnBondedHolderPlain() {
    expect_error("cannot return a holder containing a bonded closure");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    return h;
}

// A global has program lifetime, so the closure would outlive the captured stack frame.
Lambda<void()> gEscapedListLambda = default;
void escapeListIntoGlobal() {
    expect_error("cannot store a lambda with a by-reference capture of non-static local 'xs' into program-lifetime storage");
    list<int> xs = default;
    gEscapedListLambda = () => { xs.add(1); };
}

Lambda<void()> returnExtractedBondedField() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    return h.f;
}

Lambda<void()> returnExtractedBondedFieldParam(list<int> xs) {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    return h.f;
}

Lambda<void()> returnExtractedBondedFieldMoveParam(move list<int> xs) {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    return h.f;
}

Lambda<void()> returnAssignedExtractedBondedField() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    Lambda<void()> g = default;
    g = h.f;
    return g;
}

void escapeExtractedBondedFieldGlobal() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    gEscapedListLambda = h.f;
}

void escapeExtractedBondedFieldOut(ListHolder* out) {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    out->f = h.f;
}

void escapeExtractedBondedFieldList() {
    expect_error("cannot pass bonded value to 'consuming' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    list<Lambda<void()>> out = default;
    out.add(h.f);
}

void storeExtractedBondedField(Lambda<void()> f) { gEscapedListLambda = f; }

void escapeExtractedBondedFieldToCallee() {
    expect_error("cannot pass bonded value to 'consuming' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    storeExtractedBondedField(h.f);
}

struct NestedBondedFieldHolder { ListHolder inner = default; };

Lambda<void()> returnNestedExtractedBondedField() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    NestedBondedFieldHolder h = default;
    h.inner.f = () => { xs.add(1); };
    return h.inner.f;
}

Lambda<void()> returnPointerExtractedBondedField() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    return (&h)->f;
}

Lambda<void()> returnTernaryExtractedBondedField(bool chooseFirst) {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    ListHolder h = default;
    ListHolder k = default;
    h.f = () => { xs.add(1); };
    k.f = () => { xs.add(2); };
    return chooseFirst ? h.f : k.f;
}

// A holder in an outer scope outlives a bonded source in an inner scope.
void escapeOuterHolder() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    ListHolder h = default;
    {
        list<int> xs = default;
        h.f = () => { xs.add(1); };
    }
}

// Heap and pointer-reached holders are not statically lifetime-bounded by the source frame.
void escapeHeapHolder() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder* h = new ListHolder;
    h->f = () => { xs.add(1); };
    delete h;
}

void escapePointerHolder() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder h = default;
    ListHolder* p = &h;
    p->f = () => { xs.add(1); };
}

// Parenthesized pointer field path: the wrapper must retain the pointer-crossing provenance.
void escapeParenthesizedPointerHolder() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder h = default;
    ListHolder* p = &h;
    (p->f) = () => { xs.add(1); };
}

struct OwnerBondedHolder { unique ListHolder* holder = nullptr; };

void escapeUniqueHolderField() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    OwnerBondedHolder owner = default;
    owner.holder = new ListHolder;
    owner.holder->f = () => { xs.add(1); };
    delete owner.holder;
    owner.holder = nullptr;
}

struct ReturnBondedHolder { Lambda<void()> f = default; };

ReturnBondedHolder returnBondedHolder() {
    expect_error("cannot move a holder containing a bonded closure");
    list<int> xs = default;
    ReturnBondedHolder h = default;
    h.f = () => { xs.add(1); };
    return move h;
}

void receiveBondedHolder(ReturnBondedHolder* h) { }

void passBondedHolderPointer() {
    expect_error("cannot pass a holder containing a bonded closure to a function");
    list<int> xs = default;
    ReturnBondedHolder h = default;
    h.f = () => { xs.add(1); };
    receiveBondedHolder(&h);
}

void consumeBondedHolder(move ReturnBondedHolder h) { }

void passBondedHolderMove() {
    expect_error("cannot move a holder containing a bonded closure");
    list<int> xs = default;
    ReturnBondedHolder h = default;
    h.f = () => { xs.add(1); };
    consumeBondedHolder(move h);
}

void escapeFixedArrayHolder() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    list<int> xs = default;
    ListHolder[1] arr = default;
    arr[0].f = () => { xs.add(1); };
}

// The holder is declared before a later local source, so same-depth declaration order is unsafe.
void rejectParameterWithLaterLocal(list<int> xs) {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    ListHolder h = default;
    list<int> later = default;
    h.f = () => { xs.count(); later.count(); };
}

void captureHolderContainingClosure() {
    expect_error("cannot capture 'h' in a lambda");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.add(1); };
    ListHolder q = default;
    q.f = () => { h.f(); };
}

struct CopyHolder { Lambda<void()> f = default; };

struct BondCounter { int value = 0; };

// A copy of a holder carrying a bonded closure escapes the tracking.
void copyBondedHolderIntoNewLocal() {
    expect_error("cannot copy a holder containing a bonded closure");
    BondCounter c = default;
    CopyHolder h = default;
    h.f = () => { c.value = 1; };
    CopyHolder h2 = h;
}

// Taking the holder's address is the same copy-out through a pointer local.
void addressOfBondedHolder() {
    expect_error("cannot copy a holder containing a bonded closure");
    BondCounter c = default;
    CopyHolder h = default;
    h.f = () => { c.value = 1; };
    CopyHolder* p = &h;
}

void takeClosure(Lambda<void()> f) { }

// A second lambda capturing the holder transitively borrows the same frame.
void secondLambdaCapturesHolder() {
    expect_error("cannot capture 'h' in a lambda");
    BondCounter c = default;
    CopyHolder h = default;
    h.f = () => { c.value = 1; };
    takeClosure(() => { h.f(); });
}

void lambdaCapturesExtractedBondedClosure() {
    expect_error("cannot capture 'g' in a lambda");
    Counter c = default;
    ListHolder h = default;
    h.f = () => { c.value = 1; };
    Lambda<void()> g = h.f;
    takeClosure(() => { g(); });
}

struct MethodBondedHolder { Lambda<void()> f = default; Lambda<void()> get() { return this->f; } };

Lambda<void()> returnMethodExtractedBondedField() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    MethodBondedHolder h = default;
    h.f = () => { xs.count(); };
    return h.get();
}

Lambda<void()> returnMovedExtractedBondedField() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.count(); };
    return move h.f;
}

interface IBondedClosureStore { void put(Lambda<void()> f); };
class BondedClosureStore : IBondedClosureStore {
    void put(Lambda<void()> f) { gEscapedListLambda = f; }
};

void escapeExtractedBondedFieldThroughInterface() {
    expect_error("cannot pass bonded value to interface method");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.count(); };
    BondedClosureStore impl = default;
    IBondedClosureStore sink = impl;
    sink.put(h.f);
}

// The holder lives in the enclosing function; the inner lambda's own parameter dies first, so
// storing a closure bonded to it into that captured holder must reject.
struct InnerHolder { Lambda<int()> f = default; };
void rejectHolderCapturedByLambda() {
    expect_error("bonded value cannot be stored in a struct field or through a pointer");
    InnerHolder h = default;
    Lambda<void(BondCounter)> inner = (BondCounter c) => {
        h.f = () => c.value;
    };
}

// A callee that hands its argument back keeps the bond on the RESULT, so the
// caller's return escapes just as `return h.f;` does.
Lambda<void()> passThroughBondedField(Lambda<void()> f) { return f; }

Lambda<void()> returnBondedFieldThroughIdentityCall() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.count(); };
    return passThroughBondedField(h.f);
}

Lambda<void()> returnBondedFieldWithRawCount(Lambda<void()> f, move int* p) { return f; }

Lambda<void()> returnBondedFieldThroughRawCount() {
    expect_error("returning bonded value whose source 'xs' is not a 'bond' parameter");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.count(); };
    int* p = new int[1];
    return returnBondedFieldWithRawCount(h.f, move p);
}

// Brace initialization must mark the DESTINATION holder, not the source's holder.
struct BraceResultHolder { Lambda<void()> f = default; };

BraceResultHolder returnBraceInitBondedField() {
    expect_error("cannot return a holder containing a bonded closure");
    list<int> xs = default;
    ListHolder h = default;
    h.f = () => { xs.count(); };
    BraceResultHolder r = {f = h.f};
    return r;
}

// A user `_closure_fat_ptr` namespace mangles like the closure runtime helpers; its global store
// must still count as a sink.
namespace _closure_fat_ptr {
    void copyT529(Lambda<int()> n) { t529R3Global = n; }
}
void t529R4StoreHolderAndLookalike(T529R3Holder* holder, Lambda<int()> next) {
    holder->value = next;
    _closure_fat_ptr.copyT529(next);
}
void t529R4EscapeHelperLookalike() {
    expect_error("bonded value");
    {
        unique<T529SetterRes> owner = unique<T529SetterRes>(new T529SetterRes());
        T529R3Holder holder;
        Lambda<int()> closure = () => { return owner->value; };
        t529R4StoreHolderAndLookalike(&holder, closure);
    }
}

Lambda<int()> clpfxCtorGlobal = default;
namespace _closure_fat_ptr {
    void dtorClpfx(Lambda<int()> value) { clpfxCtorGlobal = value; }
}
expect_error("the constructor of 'ClpfxCtorValue' returns the object by value") {
    struct ClpfxCtorValue {
        int value = default;
        ClpfxCtorValue(int initial) {
            this.value = initial;
            Lambda<int()> local = () => { return this.value; };
            _closure_fat_ptr.dtorClpfx(local);
        }
    };
}

namespace _closure_fat_ptr {
    void dtorClpfxCInterop(alias Lambda<int(int)> slot) { }
}
expect_error("a closure that may own non-trivial captures") {
    int clpfxCInteropImpostor() {
        Lambda<int(int)> f = (int x) => x + 40;
        _closure_fat_ptr.dtorClpfxCInterop(f);
        std.function<int(int)> copied = f;
        return copied(2);
    }
}
