    // ---- owning ternary lvalue sinks (1950-1969) -----------------------------------
    bridge_reset_cf();
    if (bridge_ternary_lvalue_cf(true) != 110000 + 1100 + 22) return 1950;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1951;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_cf(false) != 220000 + 1100 + 22) return 1952;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1953;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_nested_cf(false, true) != 22000000 + 110000 + 2200 + 33) return 1954;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 5 || bridge_cf_live != 0) return 1955;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_nested_cf(true, false) != 11000000 + 110000 + 2200 + 33) return 1954;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 5 || bridge_cf_live != 0) return 1955;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_nested_cf(false, false) != 33000000 + 110000 + 2200 + 33) return 1954;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 5 || bridge_cf_live != 0) return 1955;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_field_cf(true) != 410000 + 4100 + 42) return 1956;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1957;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_field_cf(false) != 420000 + 4100 + 42) return 1956;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1957;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_array_cf(false) != 520000 + 5100 + 52) return 1958;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1959;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_array_cf(true) != 510000 + 5100 + 52) return 1958;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1959;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_deref_cf(true) != 610000 + 6100 + 62) return 1960;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1961;
    bridge_reset_cf();
    if (bridge_ternary_lvalue_deref_cf(false) != 620000 + 6100 + 62) return 1960;
    if (bridge_cf_copy != 1 || bridge_cf_dtor != 4 || bridge_cf_live != 0) return 1961;

    cpptw.reset_counts();
    if (bridge_ternary_lvalue_cppfield(true) != 710000 + 7100 + 72) return 1962;
    if (cpptw.copy_count() != 1 || cpptw.dtor_count() != 4
