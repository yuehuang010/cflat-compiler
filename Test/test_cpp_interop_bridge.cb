struct SharedLeaf : cppt.ModuleBase
{
    int value = 0;
    SharedLeaf(int v) { value = v; }
    override int forward(int x) { return x * value; }
};

void shared_init_net(SharedNet* net)
{
    net->register_child("left", std.make_shared<SharedLeaf>(2));
    net->register_child("right", std.make_shared<SharedLeaf>(3));
}

// Same registration, but the handles also land in SharedNet's own shared_ptr FIELDS. SharedNet is
// declared before SharedLeaf, so those fields were requested against a forward declaration only.
void shared_bind_net(SharedNet* net)
{
    net->left = net->register_child("left", std.make_shared<SharedLeaf>(2));
    net->right = net->register_child("right", std.make_shared<SharedLeaf>(3));
}

