    int bridgeBraceMoveCpp = bridge_brace_array_move_cpp();
    bridge_check("bridge brace-init array move C++ value", bridgeBraceMoveCpp, 8);
    bridge_check("bridge brace-init array move C++ ctor", cpptw.ctor_count(), 1);
    bridge_check("bridge brace-init array move C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge brace-init array move C++ move", cpptw.move_count(), 1);
    bridge_check("bridge brace-init array move C++ dtor", cpptw.dtor_count(), 2);
    bridge_check("bridge brace-init array move C++ live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeBraceShortCf = bridge_brace_array_short_cf();
    bridge_check("bridge brace-init array short CFlat value", bridgeBraceShortCf, 0);
    bridge_check("bridge brace-init array short CFlat dtor", bridge_cf_dtor, 3);
    bridge_check("bridge brace-init array short CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeBraceShortCpp = bridge_brace_array_short_cpp();
    bridge_check("bridge brace-init array short C++ value", bridgeBraceShortCpp, 0);
    bridge_check("bridge brace-init array short C++ ctor", cpptw.ctor_count(), 3);
    bridge_check("bridge brace-init array short C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge brace-init array short C++ move", cpptw.move_count(), 0);
    bridge_check("bridge brace-init array short C++ dtor", cpptw.dtor_count(), 3);
    bridge_check("bridge brace-init array short C++ live", cpptw.live_allocations(), 0);
    bridge_check("bridge brace-init array call then lvalue copies", bridge_brace_array_call_then_lvalue(), 221);
    cpptw.reset_counts();
    bridge_check("bridge brace-init array CFlat function result value", bridge_brace_array_cflat_result(), 30);
    bridge_check("bridge brace-init array CFlat function result live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeFieldCf = bridge_struct_field<TwinCf>();
    bridge_check("bridge struct field CFlat value", bridgeFieldCf, 12);
    bridge_check("bridge struct field CFlat ctor", bridge_cf_ctor, 1);
    bridge_check("bridge struct field CFlat copy", bridge_cf_copy, 0);
    bridge_check("bridge struct field CFlat move", bridge_cf_move, 0);
    bridge_check("bridge struct field CFlat dtor", bridge_cf_dtor, 1);
    bridge_check("bridge struct field CFlat live", bridge_cf_live, 0);

