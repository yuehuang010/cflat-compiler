    bridge_check("conditional C++ local fallthrough return live", cpptw.live_allocations(), 0);

    bridge_check("range-for Twin CFlat begin/end", bridge_range_twin_container<TwinCf>(4), 15);
    bridge_check("range-for Twin C++ begin/end", bridge_range_twin_container<cpptw.Twin>(4), 15);
    bridge_check("range-for vector int", bridge_range_vector_int(), 15);
    bridge_check("range-for vector string length", bridge_range_vector_string(), 6);
    bridge_check("range-for map key/value", bridge_range_map(), 25);
    bridge_check("range-for map alias mutation", bridge_range_map_alias(), 20);
    bridge_check("range-for raw pointer element", bridge_range_raw_pointer_element(), 11);
    bridge_check("range-for set", bridge_range_set(), 13);
    bridge_check("range-for list", bridge_range_list(), 9);
    bridge_check("range-for array", bridge_range_array(), 14);
    bridge_check("range-for borrowing mutation", bridge_range_mutation(), 30);

    bridge_reset_cf();
    bridge_check("list Twin CFlat value", bridge_list_twin<TwinCf>(), 23);
    bridge_check("list Twin CFlat ctor", bridge_cf_ctor, 3);
    bridge_check("list Twin CFlat copy", bridge_cf_copy, 4);
    bridge_check("list Twin CFlat move", bridge_cf_move, 0);
    bridge_check("list Twin CFlat dtor", bridge_cf_dtor, 9);
    bridge_check("list Twin CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    bridge_check("list Twin C++ value", bridge_list_twin<cpptw.Twin>(), 23);
    bridge_check("list Twin C++ ctor", cpptw.ctor_count(), 3);
    bridge_check("list Twin C++ copy", cpptw.copy_count(), 4);
    bridge_check("list Twin C++ move", cpptw.move_count(), 7);
    bridge_check("list Twin C++ dtor", cpptw.dtor_count(), 14);
    bridge_check("list Twin C++ live", cpptw.live_allocations(), 0);
    bridge_check("list Twin C++ balance", cpptw.ctor_count() + cpptw.copy_count() + cpptw.move_count(),
        cpptw.dtor_count());

    bridge_reset_cf();
    bridge_check("list Twin CFlat growth value", bridge_list_growth<TwinCf>(), 780);
