    return values[0].value() + values[1].value() + values[2].value();
}

int bridge_brace_identity(int v) { return v; }

// An lvalue element AFTER a call-result element must still be copied, not moved:
// the earlier element's return temporary must not mark the later one movable.
int bridge_brace_array_call_then_lvalue()
{
    std.shared_ptr<int> kept = std.make_shared<int>(7);
    int inside = 0;
    {
        std.shared_ptr<int>[2] values = { std.make_shared<int>(bridge_brace_identity(1)), kept };
        inside = (int)kept.use_count() * 10 + (int)values[1].use_count();
    }
    return inside * 10 + (int)kept.use_count();
}

cpptw.Twin bridge_brace_make_twin(int v) { return cpptw.Twin(v); }

// A CFlat function result has no storage; it must still be accepted as an element.
int bridge_brace_array_cflat_result()
{
    cpptw.Twin[2] values = { bridge_brace_make_twin(28), bridge_brace_make_twin(2) };
    return values[0].value() + values[1].value();
}

