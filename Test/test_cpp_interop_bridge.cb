{
    list<T> values = default;
};

struct BridgeListBox
{
    TwinCf twin = default;
    int tag = 0;
};

T bridge_return_field<T>(BridgeFieldHolder<T>* holder)
{
    return holder->value;
}

T bridge_return_local<T>(int value)
{
    T local = default;
    local.set(value);
    return local;
}

int bridge_method_field<T>(T* pointer)
{
    (*pointer).set(pointer->value() + 1);
    pointer->set(pointer->value() + 1);
    return (*pointer).value() + pointer->value() + pointer->field;
}

int bridge_lifetime<T>(int seed)
{
    int result = 0;
    {
        T local = default;
        local.set(seed);
        for (int i = 0; i < 2; i++)
        {
            T loop = default;
            loop.set(local.value() + i);
            result = result + loop.value();
        }
        if (result > 0) return result;
    }
    return result;
}

int bridge_parameterized<T>(int value)
{
    T* local = new T(value);
    int result = local->value();
    delete local;
    return result;
}

int bridge_fixed_array<T>()
{
    T[2] values = default;
    values[0].set(3);
    values[1].set(4);
    return values[0].value() + values[1].value() + values[0][1];
}

