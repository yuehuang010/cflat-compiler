int proxyCppAssignValue = 0;
[cpp] struct ProxyCppRecord
{
    int value = 0;
    void operator=(int next) { value = next; proxyCppAssignValue = next; }
};
ProxyCppRecord makeProxyCppRecord()
{
    ProxyCppRecord result = default;
    return move result;
}
