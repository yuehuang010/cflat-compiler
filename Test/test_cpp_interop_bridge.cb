int bridge_list_sort_cf()
{
    list<TwinCf> values = default;
    TwinCf first = default; first.set(30); values.add(move first);
    TwinCf second = default; second.set(10); values.add(move second);
    TwinCf third = default; third.set(20); values.add(move third);
    values.sort((TwinCf a, TwinCf b) => { return a.value() < b.value(); });
    return values[0].value() * 100 + values[1].value() * 10 + values[2].value();
}

