// R5 (ruling 2026-09-23): the `unique` keyword on a C++ class IS std::unique_ptr<T> (3550-3559).
// Every leg hands the owner to a C++ API typed std::unique_ptr (peek/take/take_rr), which a
// core unique<T> cannot bind, and counts Widget structors to prove single destruction.
struct UqHolder { unique cpuq.Widget* w = default; int tag = 0; };
struct UqDefaultHolder { unique cpuq.Widget* w = new cpuq.Widget(31); int tag = 0; };
unique cpuq.Widget* UqMakeNew(int v) { return new cpuq.Widget(v); }
unique cpuq.Widget* UqMakeMoved(int v) { cpuq.Widget* raw = new cpuq.Widget(v); return move raw; }
unique cpuq.Widget* UqForward(unique cpuq.Widget* p) { return move p; }
std.unique_ptr<cpuq.Widget> UqForwardSpelled(std.unique_ptr<cpuq.Widget> p) { return move p; }
int UqSink(unique cpuq.Widget* p) { return cpuq.peek(p); }
UqHolder UqMakeHolder(int v) { UqHolder h = default; h.w = cpuq.make(v); return move h; }

int uq_scope_exit()
{
    cpuq.reset_counts();
    {
        unique cpuq.Widget* w = new cpuq.Widget(1);
        if (cpuq.peek(w) != 1 || w.value() != 1) return 3550;
        if (cpuq.dtors() != 0) return 3550;
    }
    if (cpuq.ctors() != 1 || cpuq.dtors() != 1) return 3550;
    return 0;
}
int uq_take_by_value()
{
    cpuq.reset_counts();
    {
        unique cpuq.Widget* w = new cpuq.Widget(2);
        if (cpuq.take(move w) != 2) return 3551;
        if (cpuq.dtors() != 1) return 3551;    // destroyed by the callee's parameter
    }
    if (cpuq.dtors() != 1) return 3551;
    return 0;
}
int uq_take_rvalue_ref()
{
    cpuq.reset_counts();
    {
        unique cpuq.Widget* w = cpuq.make(3);
        if (cpuq.take_rr(move w) != 3) return 3552;
        if (cpuq.dtors() != 1) return 3552;
    }
    if (cpuq.dtors() != 1) return 3552;
    cpuq.reset_counts();
    {
        unique cpuq.Widget* w = cpuq.make(4);
        if (cpuq.take_rr_keep(move w) != 4) return 3553;
        if (cpuq.dtors() != 0) return 3553;    // && did not adopt: w still owns
    }
    if (cpuq.dtors() != 1) return 3553;
    return 0;
}
int uq_returns()
{
    cpuq.reset_counts();
    {
        unique cpuq.Widget* a = cpuq.make(5);
        unique cpuq.Widget* b = UqMakeNew(6);
        unique cpuq.Widget* c = UqMakeMoved(7);
        unique cpuq.Widget* d = UqForward(move a);
        if (cpuq.peek(b) + cpuq.peek(c) + cpuq.peek(d) != 18) return 3554;
        if (cpuq.dtors() != 0) return 3554;
    }
    if (cpuq.ctors() != 3 || cpuq.dtors() != 3) return 3554;
    return 0;
}
int uq_fields()
{
    cpuq.reset_counts();
    {
        UqHolder h = default;
        h.w = cpuq.make(8);
        if (cpuq.peek(h.w) != 8) return 3555;
        h.w = new cpuq.Widget(9);                  // old pointee released at the assignment
        if (cpuq.dtors() != 1 || cpuq.peek(h.w) != 9) return 3555;
        UqDefaultHolder d = default;
        if (cpuq.peek(d.w) != 31) return 3555;
        UqHolder m = UqMakeHolder(10);
        if (cpuq.peek(m.w) != 10) return 3555;
    }
    if (cpuq.ctors() != 4 || cpuq.dtors() != 4) return 3555;
    return 0;
}
int uq_reassign_and_adopt()
{
    cpuq.reset_counts();
    {
        unique cpuq.Widget* w = new cpuq.Widget(11);
        w = cpuq.make(12);
        if (cpuq.dtors() != 1 || cpuq.peek(w) != 12) return 3556;
        cpuq.Widget* raw = new cpuq.Widget(13);
        w = move raw;                              // adopts; raw reads null afterwards
        if (raw != nullptr || cpuq.dtors() != 2 || cpuq.peek(w) != 13) return 3556;
        cpuq.Widget* raw2 = new cpuq.Widget(14);
        unique cpuq.Widget* v = move raw2;
        if (raw2 != nullptr || cpuq.peek(v) != 14) return 3556;
        w = nullptr;
        if (cpuq.dtors() != 3 || cpuq.peek(w) != -1) return 3556;
    }
    if (cpuq.ctors() != 4 || cpuq.dtors() != 4) return 3556;
    return 0;
}
int uq_spellings()
{
    cpuq.reset_counts();
    {
        unique<cpuq.Widget> g = cpuq.make(15);         // the spelled unique<T> form
        std.unique_ptr<cpuq.Widget> s = cpuq.make(16);
        unique cpuq.Widget* k = move s;                // one type: move-construct, no adoption
        std.unique_ptr<cpuq.Widget> back = move g;
        if (cpuq.peek(k) != 16 || cpuq.peek(back) != 15) return 3557;
        if (cpuq.dtors() != 0) return 3557;
    }
    if (cpuq.dtors() != 2) return 3557;
    return 0;
}
int uq_cflat_sink()
{
    cpuq.reset_counts();
    {
        unique cpuq.Widget* w = cpuq.make(17);
        if (UqSink(move w) != 17) return 3558;
        if (cpuq.dtors() != 1) return 3558;
        if (UqSink(new cpuq.Widget(18)) != 18) return 3558;
        if (cpuq.dtors() != 2) return 3558;
        if (cpuq.take(new cpuq.Widget(19)) != 19) return 3558;
        if (cpuq.dtors() != 3) return 3558;
    }
    if (cpuq.ctors() != 3 || cpuq.dtors() != 3) return 3558;
    return 0;
}
int uq_null_compare()
{
    cpuq.reset_counts();
    {
        unique cpuq.Widget* w = default;
        if (w != nullptr || !(w == nullptr) || cpuq.peek(w) != -1) return 3559;
        w = new cpuq.Widget(20);
        if (w == nullptr || nullptr == w || cpuq.peek(w) != 20) return 3559;
    }
    if (cpuq.dtors() != 1) return 3559;
    return 0;
}

extern int main(int argc, char** argv)
{
    // Win64 keeps the existing SEH trampoline and does not emit the C++ guard, so the
    // whole C++-interop surface is verified on the Itanium-ABI hosts only.
    if const (__WINDOWS__) {
        return 0;
    }

    // Nontrivial C++ by-value parameters use constructors, not an aggregate bit copy.
    cpptw.reset_counts();
    {
        cpptw.Twin source = cpptw.Twin(10);
        bridge_check("byvalue free lvalue value", bridge_param_free(source), 10);
    }
    bridge_check("byvalue free lvalue copy", cpptw.copy_count(), 1);
    bridge_check("byvalue free lvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue free lvalue live", cpptw.live_allocations(), 0);
    cpptw.reset_counts();
    bridge_check("byvalue free move prvalue value", bridge_param_free_move(cpptw.Twin(11)), 11);
    bridge_check("byvalue free move prvalue move", cpptw.move_count(), 1);
    bridge_check("byvalue free move prvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue free move prvalue live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        BridgeParamMethod method = default;
        cpptw.Twin source = cpptw.Twin(12);
        bridge_check("byvalue method lvalue value", method.take(source), 12);
    }
    bridge_check("byvalue method lvalue copy", cpptw.copy_count(), 1);
    bridge_check("byvalue method lvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue method lvalue live", cpptw.live_allocations(), 0);
    cpptw.reset_counts();
    {
        BridgeParamMethod method = default;
        bridge_check("byvalue method move prvalue value", method.take_move(cpptw.Twin(13)), 13);
    }
    bridge_check("byvalue method move prvalue move", cpptw.move_count(), 1);
    bridge_check("byvalue method move prvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue method move prvalue live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        cpptw.Twin source = cpptw.Twin(14);
        bridge_check("byvalue generic lvalue value", bridge_param_generic<cpptw.Twin>(source), 14);
    }
    bridge_check("byvalue generic lvalue copy", cpptw.copy_count(), 1);
    bridge_check("byvalue generic lvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue generic lvalue live", cpptw.live_allocations(), 0);
    cpptw.reset_counts();
    bridge_check("byvalue generic move prvalue value",
        bridge_param_generic_move<cpptw.Twin>(cpptw.Twin(15)), 15);
    bridge_check("byvalue generic move prvalue move", cpptw.move_count(), 1);
    bridge_check("byvalue generic move prvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue generic move prvalue live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        cpptw.Twin source = cpptw.Twin(16);
        Lambda<int(cpptw.Twin)> fn = (cpptw.Twin value) => { return value.value(); };
        bridge_check("byvalue lambda lvalue value", fn(source), 16);
    }
    bridge_check("byvalue lambda lvalue copy", cpptw.copy_count(), 1);
    bridge_check("byvalue lambda lvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue lambda lvalue live", cpptw.live_allocations(), 0);
    cpptw.reset_counts();
    {
        Lambda<int(move cpptw.Twin)> fn = (move cpptw.Twin value) => { return value.value(); };
        bridge_check("byvalue lambda move prvalue value", fn(cpptw.Twin(17)), 17);
    }
    bridge_check("byvalue lambda move prvalue move", cpptw.move_count(), 1);
    bridge_check("byvalue lambda move prvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue lambda move prvalue live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        cpptw.Twin source = cpptw.Twin(18);
        function<int(cpptw.Twin)> fn = bridge_param_free;
        bridge_check("byvalue function pointer lvalue value", fn(source), 18);
    }
    bridge_check("byvalue function pointer lvalue copy", cpptw.copy_count(), 1);
    bridge_check("byvalue function pointer lvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue function pointer lvalue live", cpptw.live_allocations(), 0);
    cpptw.reset_counts();
    {
        function<int(move cpptw.Twin)> fn = bridge_param_free_move;
        bridge_check("byvalue function pointer move prvalue value", fn(cpptw.Twin(19)), 19);
    }
    bridge_check("byvalue function pointer move prvalue move", cpptw.move_count(), 1);
    bridge_check("byvalue function pointer move prvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue function pointer move prvalue live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        BridgeParamIface value = new BridgeParamIfaceImpl();
        cpptw.Twin source = cpptw.Twin(20);
        bridge_check("byvalue interface lvalue value", value?.take(source), 20);
    }
    bridge_check("byvalue interface lvalue copy", cpptw.copy_count(), 1);
    bridge_check("byvalue interface lvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue interface lvalue live", cpptw.live_allocations(), 0);
    cpptw.reset_counts();
    {
        BridgeParamIface value = new BridgeParamIfaceImpl();
        bridge_check("byvalue interface move prvalue value", value?.take_move(cpptw.Twin(21)), 21);
    }
    bridge_check("byvalue interface move prvalue move", cpptw.move_count(), 1);
    bridge_check("byvalue interface move prvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue interface move prvalue live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    bridge_check("last-use list lvalue add value", bridge_list_lvalue_add_cpp(), 31);
    bridge_check("last-use list lvalue add copy", cpptw.copy_count(), 1);
    bridge_check("last-use list lvalue add move", cpptw.move_count(), 1);
    bridge_check("last-use list lvalue add dtor", cpptw.dtor_count(), 3);
    bridge_check("last-use list lvalue add live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        cpptw.Twin source = default;
        bridge_check("last-use parameter twice value", bridge_cxx_param_twice(source), 0);
    }
    bridge_check("last-use parameter twice copy", cpptw.copy_count(), 2);
    bridge_check("last-use parameter twice move", cpptw.move_count(), 1);
    bridge_check("last-use parameter twice dtor", cpptw.dtor_count(), 4);
    bridge_check("last-use parameter twice live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        cpptw.Twin source = default;
        bridge_check("last-use parameter loop value", bridge_cxx_param_loop(source), 2);
    }
    bridge_check("last-use parameter loop copy", cpptw.copy_count(), 3);
    bridge_check("last-use parameter loop move", cpptw.move_count(), 1);
    bridge_check("last-use parameter loop dtor", cpptw.dtor_count(), 5);
    bridge_check("last-use parameter loop live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        cpptw.Twin source = default;
        bridge_cxx_param_outer(source);
    }
    bridge_check("last-use parameter forward copy", cpptw.copy_count(), 1);
    bridge_check("last-use parameter forward move", cpptw.move_count(), 1);
    bridge_check("last-use parameter forward dtor", cpptw.dtor_count(), 3);
    bridge_check("last-use parameter forward live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    {
        cpptw.Twin source = default;
        cpptw.Twin result = bridge_cxx_param_return(source);
        bridge_check("last-use parameter return value", result.value(), 0);
    }
    bridge_check("last-use parameter return copy", cpptw.copy_count(), 1);
    bridge_check("last-use parameter return move", cpptw.move_count(), 1);
    bridge_check("last-use parameter return dtor", cpptw.dtor_count(), 3);
    bridge_check("last-use parameter return live", cpptw.live_allocations(), 0);

    std.string bridgeText = std.string("0123456789012345678901234567890123456789");
    bridge_check("byvalue std.string size", bridge_param_string(bridgeText), 48);
    bridge_check("byvalue std.string source survives", (int)bridgeText.size(), 40);
    bridge_check("byvalue std.string content survives",
        strcmp(bridgeText.c_str(), "0123456789012345678901234567890123456789"), 0);
    std.shared_ptr<int> bridgeShared = std.make_shared<int>(7);
    bridge_check("byvalue shared_ptr inside count", bridge_param_shared(bridgeShared), 2);
    bridge_check("byvalue shared_ptr source count", (int)bridgeShared.use_count(), 1);

    bridge_conditional_value = 1;
    cpptw.reset_counts();
    bridge_conditional_box_release(bridge_conditional_value != 0);
    bridge_check("conditional box discard taken dtor", cpptw.dtor_count(), 1);
    bridge_check("conditional box discard taken live", cpptw.live_allocations(), 0);
    bridge_conditional_value = 0;
    cpptw.reset_counts();
    bridge_conditional_box_release(bridge_conditional_value != 0);
    bridge_check("conditional box discard not taken dtor", cpptw.dtor_count(), 1);
    bridge_check("conditional box discard not taken live", cpptw.live_allocations(), 0);

    bridge_conditional_value = 1;
    cpptw.reset_counts();
    bridge_conditional_twin_release(bridge_conditional_value != 0);
    bridge_check("conditional C++ local taken dtor", cpptw.dtor_count(), 1);
    bridge_check("conditional C++ local taken live", cpptw.live_allocations(), 0);

    bridge_conditional_value = 0;
    cpptw.reset_counts();
    bridge_conditional_twin_release(bridge_conditional_value != 0);
    bridge_check("conditional C++ local not taken dtor", cpptw.dtor_count(), 1);
