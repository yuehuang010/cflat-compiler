    bridge_check("reinit live Twin dtor", cpptw.dtor_count(), 2);
    bridge_check("reinit live Twin live", cpptw.live_allocations(), 0);

    bridge_conditional_value = 1;
    cpptw.reset_counts();
    bridge_reinit_box(bridge_conditional_value != 0);
    bridge_check("reinit released Box made", cpptw.ctor_count() + cpptw.copy_count()
        + cpptw.move_count(), 2);
    bridge_check("reinit released Box dtor", cpptw.dtor_count(), 2);
    bridge_check("reinit released Box live", cpptw.live_allocations(), 0);

    bridge_conditional_value = 0;
