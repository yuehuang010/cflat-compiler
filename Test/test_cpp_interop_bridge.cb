struct SharedNet : cppt.ModuleBase
{
    std.shared_ptr<SharedLeaf> left = default;
    std.shared_ptr<SharedLeaf> right = default;
    SharedNet() {}
    override int forward(int x) { return call_child(1, call_child(0, x)); }
};

struct SharedLeaf : cppt.ModuleBase
{
    int value = 0;
    SharedLeaf(int v) { value = v; }
    override int forward(int x) { return x * value; }
};

void shared_init_net(SharedNet* net)
{
    net->register_child("left", std.make_shared<SharedLeaf>(2));
    net->register_child("right", std.make_shared<SharedLeaf>(3));
}

// Same registration, but the handles also land in SharedNet's own shared_ptr FIELDS. SharedNet is
// declared before SharedLeaf, so those fields were requested against a forward declaration only.
void shared_bind_net(SharedNet* net)
{
    net->left = net->register_child("left", std.make_shared<SharedLeaf>(2));
    net->right = net->register_child("right", std.make_shared<SharedLeaf>(3));
}

// A plain CFlat struct whose fields are nontrivial C++ classes, so `box.p` / `bp->p` is a
// field LVALUE used as a local's initializer. copyctorGlobal covers the namespace-scope object leg.
struct CopyCtorBox
{
    std.shared_ptr<SharedLeaf> p = default;
    std.string s = default;
};

std.shared_ptr<SharedLeaf> copyctorGlobal = default;

struct SharedSelf : cppt.ModuleBase
{
    std.shared_ptr<SharedSelf> self = default;
    override int forward(int x) { return x + 1; }
};

struct SharedHolderBlock : cppt.ModuleBase
{
    std.shared_ptr<cppt.ModuleBase> leaf = default;
    SharedHolderBlock(int v)
    {
        cppt.HolderOf<cppt.ModuleBase> holder =
            cppt.HolderOf<cppt.ModuleBase>(std.make_shared<cppt.ModuleBase>());
        leaf = register_child("leaf", holder);
    }
    override int forward(int x) { return leaf->forward(x) + 1; }
};

struct SharedHolderNet : cppt.ModuleBase
{
    std.shared_ptr<SharedHolderBlock> block = default;
    SharedHolderNet(int v)
    {
        block = register_child("block", std.make_shared<SharedHolderBlock>(v));
    }
    override int forward(int x) { return block->forward(x) + 1; }
};

