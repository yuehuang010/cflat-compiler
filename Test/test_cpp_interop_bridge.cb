{
    BridgeSetCopyKey(int value) { tag = value; }
};

[cpp] struct BridgeOwnMethodFirst : cppownmethod.ProtectedBase
{
    int prot() { return 30; }
    int bare() { return prot(); }
    int explicit_this() { return this->prot(); }
