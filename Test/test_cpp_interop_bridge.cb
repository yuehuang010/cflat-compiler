// One value-element body runs against both the native and imported Twin. It covers copy and move
// insertion, set/remove/clear, alias and by-value reads, and list.copy() without triggering growth.
int bridge_list_twin<T>()
{
    list<T> values = default;
    T source = default;
    source.set(2);
    values.add(source);
    T moved = default;
    moved.set(3);
    values.add(move moved);
    T replacement = default;
    replacement.set(4);
    values.set(0, replacement);
    int result = values.get(0).value() + values[1].value();
    for (T value in values) result = result + value.value();
    for (alias T value in values) value.set(value.value() + 1);
    list<T> copy = values.copy();
    result = result + copy[0].value();
    values.removeAt(0);
    values.clear();
    return result + copy[1].value();
}

int bridge_list_growth<T>()
{
    list<T> values = default;
    int i = 0;
    while (i < 40)
    {
        T value = default;
        value.set(i);
        values.add(move value);
        i++;
    }
    int sum = 0;
    i = 0;
    while (i < values.count())
    {
        sum = sum + values[i].value();
        i++;
    }
    return sum;
}

int bridge_list_shift_heavy<T>()
{
    list<T> values = default;
    int i = 0;
    while (i < 10)
    {
        T value = default;
        value.set(i);
        values.add(move value);
        i++;
    }
    i = 0;
    while (i < 5)
    {
        values.removeAt(0);
        i++;
    }
    i = 0;
    while (i < 10)
    {
        T value = default;
        value.set(100 + i);
        values.add(move value);
        i++;
    }
    int sum = 0;
    i = 0;
    while (i < values.count())
    {
        sum = sum + values[i].value();
        i++;
    }
    values.clear();
    return sum;
}

