int bridge_checks = 0;
int bridge_passed = 0;
void bridge_check(const char* name, int actual, int expected)
{
    bridge_checks++;
    bridge_passed += Test(name, actual, expected);
}

int sharedGlobal = 42;
extern int strcmp(const char* a, const char* b);
int cbAdd(int a, int b) { return a + b; }
int cbTwice(int x) { return x * 2; }

// Callables handed to C++ through std::function.
int stdfn_twice(int x) { return x * 2; }
int stdfn_bumped = 0;
void stdfn_bump() { stdfn_bumped = stdfn_bumped + 1; }
int stdfn_len(alias std.string s) { return (int)s.size(); }

// The CFlat std.function local dies with this frame; the handler C++ stored must survive it.
void stdfn_install(alias cppfn.Holder h)
{
    std.function<int(int)> local = std.function<int(int)>(stdfn_twice);
    h.set_handler(local);
}

int cbMixedOut(cppi.Mixed m, char** out) { *out = "callback-out"; return m.i + (int)m.d; }
cppi.Mixed cbMixed(cppi.Mixed m) { m.d = m.d + 1.0; m.i = m.i + 1; return m; }
cppi.Large cbLarge(cppi.Large v)
{
    v.x = v.x + 1; v.y = v.y + 1; v.z = v.z + 1; return v;
}
cppi.Hfa cbHfa(cppi.Hfa v)
{
    v.a = v.a + 1.0f; v.b = v.b + 1.0f; v.c = v.c + 1.0f; v.d = v.d + 1.0f; return v;
}
int cbVisit(cppi.Tracked* t, void* ctx)
{
    int* state = (int*)ctx;
    if (cppi.dtor_count() != 0) state[1] = 1;
    state[0] = state[0] + 1;
    return t.value();
}

int g_nobase_dtor = 0;
int g_nobase_resource_dtor = 0;

struct NoBaseResource
{
    ~NoBaseResource() { g_nobase_resource_dtor = g_nobase_resource_dtor + 1; }
};

[cpp] struct Plain
{
    int a = 1;
    string name = "seed";
    unique NoBaseResource* resource = new NoBaseResource();
    int second = 17;

    Plain(int v) { a = v; }
    ~Plain() { g_nobase_dtor = g_nobase_dtor + 1; }
    int total() { return a * 2; }
    static int make_tag() { return 7; }
};

