}

int bridge_reinit_shared_ptr(bool condition)
{
    std.shared_ptr<int> a = std.make_shared<int>(1);
    if (condition) { _ = move a; }
    std.shared_ptr<int> n = std.make_shared<int>(2);
    a = n;
    return (int)a.use_count() * 10 + (int)n.use_count();
}

void bridge_conditional_loop(bool condition)
{
    for (int i = 0; i < 2; i++)
    {
        cpptw.Twin value = cpptw.Twin(i + 1);
        if (condition && i == 1) { _ = move value; }
    }
}

void bridge_conditional_loop_break(bool condition)
{
    for (int i = 0; i < 2; i++)
    {
        cpptw.Twin value = cpptw.Twin(i + 1);
        if (condition && i == 1) { _ = move value; }
        if (i == 0) break;
    }
}

void bridge_conditional_switch(bool condition)
{
    cpptw.Twin value = cpptw.Twin(1);
    switch (condition ? 1 : 0)
    {
        case 1: _ = move value; break;
        default: break;
    }
}

void bridge_conditional_both_arms(bool condition)
{
    cpptw.Twin value = cpptw.Twin(1);
    if (condition) { _ = move value; }
    else { _ = move value; }
}

int bridge_conditional_return_before_move(bool condition)
{
    cpptw.Twin value = cpptw.Twin(1);
    if (condition) return 9;
    _ = move value;
    return 0;
}

int bridge_conditional_move_then_return(bool condition)
{
    cpptw.Twin value = cpptw.Twin(1);
    if (condition)
    {
        _ = move value;
        return 9;
    }
    return 0;
}

extern int main(int argc, char** argv)
{
    // Win64 keeps the existing SEH trampoline and does not emit the C++ guard, so the
    // whole C++-interop surface is verified on the Itanium-ABI hosts only.
    if const (__WINDOWS__) {
        return 0;
    }

    // Nontrivial C++ by-value parameters use constructors, not an aggregate bit copy.
    cpptw.reset_counts();
    {
        cpptw.Twin source = cpptw.Twin(10);
        bridge_check("byvalue free lvalue value", bridge_param_free(source), 10);
    }
    bridge_check("byvalue free lvalue copy", cpptw.copy_count(), 1);
    bridge_check("byvalue free lvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("byvalue free lvalue live", cpptw.live_allocations(), 0);
