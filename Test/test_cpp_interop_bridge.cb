    bridge_conditional_value = 1;
    cpptw.reset_counts();
    bridge_reinit_twin(bridge_conditional_value != 0);
    bridge_check("reinit released Twin made", cpptw.ctor_count() + cpptw.copy_count()
        + cpptw.move_count(), 3);
    bridge_check("reinit released Twin copy construct", cpptw.copy_count(), 1);
    bridge_check("reinit released Twin dtor", cpptw.dtor_count(), 3);
    bridge_check("reinit released Twin live", cpptw.live_allocations(), 0);

    bridge_conditional_value = 0;
    cpptw.reset_counts();
