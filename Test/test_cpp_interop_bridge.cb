void bridge_conditional_box_move(bool condition)
{
    BridgeConditionalBox value = default;
    if (condition)
    {
        BridgeConditionalBox moved = move value;
        moved.tag = 1;
    }
}

// Explicit discard of a struct whose C++ field owns a resource: destroyed once on either path.
void bridge_conditional_box_release(bool condition)
{
    BridgeConditionalBox box = default;
    if (condition)
        _ = move box;
}

void bridge_conditional_outer_move(bool condition)
{
    BridgeConditionalOuter value = default;
    if (condition)
    {
        BridgeConditionalOuter moved = move value;
        moved.box.tag = 1;
    }
}

void bridge_reinit_twin(bool condition)
{
    cpptw.Twin a = cpptw.Twin(1);
    if (condition) { _ = move a; }
    cpptw.Twin n = cpptw.Twin(2);
    a = n;
}

void bridge_reinit_box(bool condition)
{
    BridgeConditionalBox a = default;
    if (condition)
    {
        BridgeConditionalBox moved = move a;
        moved.tag = 1;
    }
    BridgeConditionalBox fresh = default;
    a = move fresh;
}

int bridge_reinit_twin_prvalue()
{
    cpptw.Twin a = cpptw.Twin(1);
    a = cpptw.Twin(2);
