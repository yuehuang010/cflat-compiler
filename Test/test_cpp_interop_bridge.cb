int bridge_tracked_range_balanced()
{
    if (cpptw.tracked_iter_made_count() != cpptw.tracked_iter_dtor_count()) return 0;
    if (cpptw.tracked_iter_bad_dtor_count() != 0) return 0;
    if (cpptw.tracked_iter_live_count() != 0) return 0;
    if (cpptw.tracked_range_made_count() != cpptw.tracked_range_dtor_count()) return 0;
    if (cpptw.tracked_range_bad_dtor_count() != 0) return 0;
    if (cpptw.tracked_range_live_count() != 0) return 0;
    return 1;
}

