    bridge_check("reinit live Box dtor", cpptw.dtor_count(), 2);
    bridge_check("reinit live Box live", cpptw.live_allocations(), 0);

    cpptw.reset_counts();
    bridge_check("reinit Twin constructor prvalue value", bridge_reinit_twin_prvalue(), 2);
    bridge_check("reinit Twin constructor prvalue move assign", cpptw.move_assign_count(), 1);
    bridge_check("reinit Twin constructor prvalue dtor", cpptw.dtor_count(), 2);
    bridge_check("reinit Twin constructor prvalue live", cpptw.live_allocations(), 0);

    bridge_conditional_value = 1;
    bridge_check("reinit shared_ptr released use count",
