int bridge_enclosing_string_copy()
{
    BridgeStringCopyFieldHolder source = {
        value = std.string("bridge-field-copy")
    };
    BridgeStringCopyFieldHolder copy = source;
    return (int)copy.value.size();
}

int bridge_enclosing_shared_copy()
{
    BridgeSharedCopyFieldHolder source = default;
    source.value = std.make_shared<int>(7);
    int inside = 0;
    {
        BridgeSharedCopyFieldHolder copy = source;
        inside = (int)copy.value.use_count() * 10 + *copy.value;
    }
    return inside * 10 + (int)source.value.use_count();
}

int bridge_ternary_field_copy_cpp(bool choose)
{
    BridgeCopyFieldHolder<cpptw.Twin> left = default;
    BridgeCopyFieldHolder<cpptw.Twin> right = default;
    left.value.set(11);
    right.value.set(22);
    BridgeCopyFieldHolder<cpptw.Twin> picked = choose ? left : right;
    picked.value.set(99);
    return picked.value.value();
}

int bridge_ternary_field_alias_cpp(bool choose)
{
    BridgeCopyFieldHolder<cpptw.Twin> left = default;
    BridgeCopyFieldHolder<cpptw.Twin> right = default;
    left.value.set(11);
    right.value.set(22);
    alias BridgeCopyFieldHolder<cpptw.Twin> picked = choose ? left : right;
    picked.value.set(99);
    return left.value.value() * 100 + right.value.value() * 10;
}

int bridge_reference<T>(alias T value)
{
    value.set(value.value() + 2);
    return value.value();
}

int bridge_operators<T>(T* left, T* right)
{
    int result = 0;
    if ((*left) == (*right)) result = result + 1;
    if ((*left)[1] == left->value() + 1) result = result + 2;
    if (*left) result = result + 4;
    return result;
}

int bridge_nullable<T>(T* value)
{
    if (value?.value() == 5) return 1;
