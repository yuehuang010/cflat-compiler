    int inside = 0;
    {
        BridgeSharedCopyFieldHolder copy = source;
        inside = (int)copy.value.use_count() * 10 + *copy.value;
    }
    return inside * 10 + (int)source.value.use_count();
}

int bridge_reference<T>(alias T value)
{
    value.set(value.value() + 2);
    return value.value();
}

int bridge_operators<T>(T* left, T* right)
{
    int result = 0;
    if ((*left) == (*right)) result = result + 1;
    if ((*left)[1] == left->value() + 1) result = result + 2;
    if (*left) result = result + 4;
    return result;
}

