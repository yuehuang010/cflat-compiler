int bridge_list_sort_cf()
{
    list<TwinCf> values = default;
    TwinCf first = default; first.set(30); values.add(move first);
    TwinCf second = default; second.set(10); values.add(move second);
    TwinCf third = default; third.set(20); values.add(move third);
    values.sort((TwinCf a, TwinCf b) => { return a.value() < b.value(); });
    return values[0].value() * 100 + values[1].value() * 10 + values[2].value();
}

int bridge_list_sort_cpp()
{
    list<cpptw.Twin> values = default;
    cpptw.Twin first = default; first.set(30); values.add(move first);
    cpptw.Twin second = default; second.set(10); values.add(move second);
    cpptw.Twin third = default; third.set(20); values.add(move third);
    values.sort((cpptw.Twin a, cpptw.Twin b) => { return a.value() < b.value(); });
    return values[0].value() * 100 + values[1].value() * 10 + values[2].value();
}

int bridge_list_string()
{
    list<std.string> values = default;
    values.add(std.string("a"));
    values.add(std.string("bb"));
    values.add(std.string("ccc"));
    values.add(std.string("dddd"));
    values.add(std.string("eeeee"));
    int total = 0;
    for (std.string value in values) total = total + (int)value.size();
    return total;
}

int bridge_list_shared()
{
    std.shared_ptr<int> value = std.make_shared<int>(7);
    list<std.shared_ptr<int>> values = default;
    values.add(value);
    int inside = (int)value.use_count() * 1000 + (int)values[0].use_count() * 100;
    values.removeAt(0);
    int afterRemove = (int)value.use_count() * 10;
    values.add(value);
    values.clear();
    return inside + afterRemove + (int)value.use_count();
}

