// Signature coverage for a generated [cpp] record nested inside C++ template arguments. The
// first declaration deliberately precedes GrsSigBP to pin declaration-order independence.
int grs_sig_order(std.vector<std.vector<GrsSigBP*>> v) { return (int)v.size() + 1930; }

