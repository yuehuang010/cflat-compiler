// C++-interop coverage: the CFlat BRIDGE. Everything here is CFlat code that C++ sees -
// CFlat-defined [cpp] structs (plain, derived, generic), CFlat functions reached through
// the reverse C++ ABI, and std::function handed a CFlat callable. New bridge work goes
// in this file. The plain C++ surface is in Test/test_cpp_interop.cb; templates and std::
// specializations are in Test/test_cpp_interop_template.cb.

// End-to-end C++-interop coverage. Each section exercises one path of the C++ interop
// pipeline; on failure the section's exit code identifies which one regressed.
//   CFlat-defined no-base [cpp] structs - fields, layout, structors, ownership, move,
//     nesting, methods, static methods, and ctor edges.
//   CFlat-defined derived [cpp] structs - one C++ base, construction, overrides, virtual
//     dispatch, protected access, and diagnostics.
//   C++ struct return adoption, destructor counts, and closure rows.
//   C++ class-template specializations as [cpp] struct bases, including base initializers,
//     virtual dispatch, move cleanup, and fields.
//   C++ by-value return temporaries and inherited member-template lookup, including
//     constructor and sret returns, nested returns, unrelated temps, and implicit/explicit
//     receiver spellings.
//   std::make_shared/std::shared_ptr of CFlat-defined [cpp] structs, generated
//     constructors/destructors, virtual dispatch, conversions, recursive template arguments,
//     incomplete ordering, move ownership, promotion, receiver sret, member-template
//     overloads, and ref/value rank.
//   Generic CFlat-defined [cpp] structs - one C++ class per instantiation, dependent C++ base
//     initializers, override dispatch, destructor counts, move construction, and a no-base
//     field generic.
//   Initializing a local of a NONTRIVIAL C++ class from an lvalue that is not a bare
//     identifier - a dot field, an arrow field, a dereference, a namespace-scope object and a
//     vector element - must copy-CONSTRUCT. Every leg reads a refcount or a heap string the
//     source still owns, so a bitwise store (the pre-fix lowering) shows up as a low
//     use_count and a double release.
//   std::function as a C++ MEMBER parameter (by value, by const&, by &&, on a static member,
//     on a constructor) and as a RETURN type (free function, member, static member; called
//     directly and through a CFlat local), plus a member that STORES the callable and runs it
//     after the CFlat frame that made it is gone, the void() and int(const std::string&)
//     signatures, and the free-function forms of the same signatures already covered by the
//     plain-CFlat-function checks. Every member position was refused ("takes/returns
//     unsupported type") while the free-function parameter one bound.

import cpp "library/cpp_interop_basic.h" cache;
import cpp "library/cpp_interop_basic.cpp" cache;
// Inheritance and virtual dispatch. Definitions are out-of-line on purpose - every
// virtual function needs a real symbol and the vtable needs a key function.
import cpp "library/cpp_interop_poly.h" cache;
import cpp "library/cpp_interop_poly.cpp" cache;
// The CFlat-defined [cpp] structs below derive from C++ class-template specializations, and
// the make_shared checks register them through std::shared_ptr.
import cpp "library/cpp_interop_tpl.h" cache;
import cpp "vector" cache;
import cpp "string" cache;
import cpp "memory" cache;
import cpp "functional" cache;
import cpp "deque" cache;
import cpp "map" cache;
import cpp "set" cache;
import cpp "list" cache;
import cpp "array" cache;
// std::function as a MEMBER parameter and as a RETURN type.
import cpp "library/cpp_interop_stdfn.h" cache;
import cpp "library/cpp_interop_twin.h" cache;
import "test_helper.cb";
import "list.cb";

int bridge_cf_ctor = 0;
int bridge_cf_copy = 0;
int bridge_cf_move = 0;
int bridge_cf_dtor = 0;
int bridge_cf_copy_assign = 0;
int bridge_cf_move_assign = 0;
int bridge_cf_live = 0;

void bridge_reset_cf()
{
    bridge_cf_ctor = 0; bridge_cf_copy = 0; bridge_cf_move = 0;
    bridge_cf_dtor = 0; bridge_cf_copy_assign = 0; bridge_cf_move_assign = 0;
    bridge_cf_live = 0;
}

struct TwinCf
{
    int* data = new int[3];
    int field = 0;

    TwinCf() { bridge_cf_ctor++; bridge_cf_live++; data[0] = 0; data[1] = 1; data[2] = 2; }
    TwinCf(int value)
    {
        bridge_cf_ctor++; bridge_cf_live++; field = value;
        data[0] = value; data[1] = value + 1; data[2] = value + 2;
    }
    ~TwinCf()
    {
        if (data != nullptr) { delete[] data; bridge_cf_live--; }
        bridge_cf_dtor++;
    }
    TwinCf copy()
    {
        TwinCf result = default;
        bridge_cf_ctor--; bridge_cf_copy++;
        result.field = field;
        result.data[0] = data[0]; result.data[1] = data[1]; result.data[2] = data[2];
        return move result;
    }
    int value() { return field; }
    void set(int value)
    {
        field = value;
        data[0] = value; data[1] = value + 1; data[2] = value + 2;
    }
    bool operator==(alias TwinCf other) { return field == other.field; }
    int operator[](int index) { return data[index]; }
    int* begin() { return data; }
    int* end() { return data + 3; }
    int count() { return 3; }
    int get(int index) { return data[index]; }
    static int static_value() { return 73; }
};

bool operator bool(alias TwinCf value) { return value.field != 0; }

