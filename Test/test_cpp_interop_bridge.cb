    if (bridge_passed != bridge_checks) return 2000;

    // ---- CFlat struct globals with C++ fields (2020-2039) ---------------------------
    // Twelve GTrk fields across these globals must be constructed before main.
    // One field: the pre-fix value was zero and no GTrk constructor had run.
    if (cppa.gctor_count() != 12 || gfieldOne.item.v != 7) return 2020;
    // Two fields around an int: both constructors and both field values are observable.
    if (cppa.gctor_count() != 12 || gfieldPair.first.v != 7
        || gfieldPair.last.v != 7 || gfieldPair.middle != 0) return 2021;
    // The C++ field is reached through a nested CFlat holder.
    if (cppa.gctor_count() != 12 || gfieldNested.nested.item.v != 7) return 2022;
    // Each array element holder owns one independently constructed C++ field.
    if (cppa.gctor_count() != 12 || gfieldArrayHolders[0].item.v != 7
        || gfieldArrayHolders[2].item.v != 7) return 2023;
    // A fixed array of C++ classes is reached through its CFlat holder.
    if (cppa.gctor_count() != 12 || gfieldCppArray.items[0].v != 7
        || gfieldCppArray.items[1].v != 7) return 2024;
    // Empty-brace defaulting follows the same zero-fill path as '= default'.
    if (cppa.gctor_count() != 12 || gfieldEmptyBrace.item.v != 7) return 2025;
    // No-initializer globals already use the synthesized CFlat constructor.
    if (cppa.gctor_count() != 12 || gfieldBare.item.v != 7) return 2026;
    // The [cpp] aggregate already uses its own constructor path on both binaries.
    if (cppa.gctor_count() != 12 || gfieldBridge.item.v != 7) return 2027;
    // Separate imported CFlat modules construct in import order before main.
    if (cppa.gseq_slot() != 2 || gfieldOrderA.item.v != 1) return 2028;
    if (cppa.gseq_slot() != 2 || gfieldOrderB.item.v != 2) return 2029;
    // A function-local static holder remains constructed on its first call.
    if (bridge_global_field_static_value() != 7 || cppa.gctor_count() != 13) return 2030;
    // Globals follow the no-exit-destruction ruling; every remaining dtor count must be zero.
    if (cppa.gdtor_count() != 0) return 2031;

    // ---- C++ holder parameters through interface dispatch (2040-2059) ----------------
    int bridgeIfhStartChecks = bridge_checks;
