extern int main()
{
    // Win64 keeps the existing SEH trampoline and does not emit the C++ guard, so the
    // whole C++-interop surface is verified on the Itanium-ABI hosts only.
    if const (__WINDOWS__) {
        return 0;
    }

    // ---- generic CFlat-defined [cpp] structs ----------------------------------------------------
    cppt.tplbase.reset_holder_int_dtors();
    {
        GenericWrap<int> source = GenericWrap<int>(5);
        if (source.doubled() != 13) return 1560;
        if (cppt.tplbase.call_doubled<int>(&source) != 13) return 1561;
        GenericWrap<int> target = move source;
        if (target.value != 5 || target.doubled() != 13) return 1562;
        if (cppt.tplbase.call_doubled<int>(&target) != 13) return 1563;
        if (cppt.tplbase.holder_int_dtors() != 0) return 1564;
    }
    if (cppt.tplbase.holder_int_dtors() != 2) return 1565;

    cppt.tplbase.reset_holder_double_dtors();
    {
        GenericWrap<double> value = GenericWrap<double>(2.5);
        if (value.doubled() != 8.0) return 1566;
        if (cppt.tplbase.call_doubled<double>(&value) != 8.0) return 1567;
    }
    if (cppt.tplbase.holder_double_dtors() != 1) return 1568;

    {
        GenericValue<int> intValue = GenericValue<int>(17);
        GenericValue<double> doubleValue = GenericValue<double>(4.5);
        if (intValue.value != 17) return 1569;
        if (doubleValue.value != 4.5) return 1570;
        GenericValue<int> moved = move intValue;
        if (moved.value != 17) return 1571;
    }

    // ---- reverse C++ ABI callback entry points --------------------------------------------------
    if (cppi.apply_int(cbAdd, 20, 22) != 42) return 584;

    cppi.Mixed revM = default;
    revM.d = 1.5; revM.i = 20;
    cppi.Mixed revMr = cppi.apply_mixed(cbMixed, revM);
    if (revMr.d != 2.5 || revMr.i != 21)        return 585;

    cppi.Large revL = default;
    revL.x = 10; revL.y = 20; revL.z = 30;
    cppi.Large revLr = cppi.apply_large(cbLarge, revL);
    if (revLr.x != 11 || revLr.y != 21 || revLr.z != 31) return 588;

    cppi.Hfa revH = default;
    revH.a = 1.0f; revH.b = 2.0f; revH.c = 3.0f; revH.d = 4.0f;
    cppi.Hfa revHr = cppi.apply_hfa(cbHfa, revH);
    if (revHr.a != 2.0f || revHr.b != 3.0f || revHr.c != 4.0f || revHr.d != 5.0f) return 589;

    cppi.reset_counts();
    int[2] revState = {0, 0};
    if (cppi.visit_tracked(cbVisit, (void*)revState, 7) != 14) return 590;
    if (revState[0] != 2)                           return 591;
    if (revState[1] != 0)                           return 592;
    if (cppi.ctor_count() != 1)                    return 593;
    if (cppi.copy_count() != 0)                    return 594;
    if (cppi.dtor_count() != 1)                    return 595;

    // ---- std::function from a plain CFlat function ----------------------------------------------
    std.function<int(int)> revF = std.function<int(int)>(cbTwice);
    if (revF(21) != 42)                             return 610;
    if (cppi.apply_fn(revF, 5) != 10)               return 611;
    if (cppi.apply_fn(std.function<int(int)>(cbTwice), 5) != 10) return 612;
    std.function<int(int)> revFCopy = revF;
    if (revFCopy(4) != 8)                           return 613;
    std.function<int(int)> revFCopyCtor = std.function<int(int)>(revF);
    if (revFCopyCtor(6) != 12)                      return 614;
    using F = std.function<int(int)>;
    F revFAlias = std.function<int(int)>(cbTwice);
    if (revFAlias(7) != 14)                         return 615;
    std.vector<char*> revPv = default;
    char* revS = "vector-pointer";
    revPv.push_back(revS);
    if (revPv[0] != revS)                             return 616;
    cppi.Mixed revMo = default; revMo.i = 30; revMo.d = 2.0;
    char* revOut = nullptr;
    if (cppi.apply_mixed_out(cbMixedOut, revMo, &revOut) != 32) return 617;
    if (revOut == nullptr || strcmp(revOut, "callback-out") != 0) return 618;

    // ---- CFlat-defined no-base [cpp] structs ----------------------------------------------------
    g_nobase_dtor = 0;
    g_nobase_resource_dtor = 0;
    {
        Plain nobasePlain = Plain(5);
        if (nobasePlain.a != 5) return 1360;
        if (length(nobasePlain.name) != 4 || nobasePlain.second != 17) return 1361;
        if (nobasePlain.total() != 10) return 1362;
        nobasePlain.a = 9;
        if (nobasePlain.a != 9) return 1364;
        if (nobasePlain.total() != 18) return 1363;
        // int (4) + padding (4) + string (16) + unique pointer (8) + int (4)
        // + tail padding (4) = 40.
        if (sizeof(Plain) != 4 + 4 + 16 + 8 + 4 + 4) return 1365;
        if (alignof(Plain) != 8) return 1366;
        if (g_nobase_dtor != 0) return 1368;
    }
    if (g_nobase_dtor != 1) return 1367;

    g_nobase_dtor = 0;
    g_nobase_resource_dtor = 0;
    {
        Plain nobaseOwned = Plain(1);
        if (g_nobase_resource_dtor != 0) return 1369;
    }
    if (g_nobase_resource_dtor != 1) return 1370;

    g_nobase_dtor = 0;
    g_nobase_resource_dtor = 0;
    {
        Plain nobaseFrom = Plain(5);
        Plain nobaseTo = move nobaseFrom;
        if (nobaseTo.a != 5) return 1371;
        if (g_nobase_dtor != 0 || g_nobase_resource_dtor != 0) return 1372;
    }
    if (g_nobase_dtor != 2 || g_nobase_resource_dtor != 1) return 1373;

    g_nobase_dtor = 0;
    g_nobase_resource_dtor = 0;
    {
        Plain nobaseReturned = nobase_make_plain(6);
        if (nobaseReturned.a != 6) return 1374;
    }
    if (g_nobase_dtor != 1 || g_nobase_resource_dtor != 1) return 1391;

    {
        Plain nobasePointer = Plain(8);
        nobase_bump(&nobasePointer);
        if (nobasePointer.a != 9) return 1375;
    }

    g_nobase_dtor = 0;
    g_nobase_resource_dtor = 0;
    Plain* nobaseHeap = new Plain(2);
    if (nobaseHeap->a != 2) return 1376;
    delete nobaseHeap;
    if (g_nobase_dtor != 1 || g_nobase_resource_dtor != 1) return 1377;

    if (Plain.make_tag() != 7) return 1378;

    {
        nobase.Q nobaseQ = nobase.Q();
        if (nobaseQ.v != 3) return 1379;
    }

    g_nobase_dtor = 0;
    {
        NoBasePlainOuter nobaseOuter = default;
        if (g_nobase_dtor != 0) return 1380;
    }
