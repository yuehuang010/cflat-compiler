        values.emplace_back(move local);
        bridge_check("LVS emplace move value", values.front().value(), 10);
        bridge_check("LVS emplace moved-from", source.value(), -1);
    }
    {
        std.vector<cppas.Life> values = default;
        cppas.Life local = cppas.Life(12);
        cppas.Life* source = &local;
        values.insert(values.end(), move local);
        bridge_check("LVS insert move value", values.front().value(), 12);
        bridge_check("LVS insert moved-from", source.value(), -1);
    }
    {
        std.set<std.string> values = default;
        std.string key = std.string("lvs");
        values.insert(key);
        int count = values.count(key);
        int found = 0;
        if (values.find(key) != values.end()) found = 1;
        bridge_check("LVS set count copyable key", count, 1);
        bridge_check("LVS set find copyable key", found, 1);
    }
