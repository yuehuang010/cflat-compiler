import cpp "library/cpp_interop_basic.h";
import cpp "library/cpp_interop_basic.cpp";
// Inheritance and virtual dispatch. Definitions are out-of-line on purpose - every
// virtual function needs a real symbol and the vtable needs a key function.
import cpp "library/cpp_interop_poly.h";
import cpp "library/cpp_interop_poly.cpp";
import cpp "library/cpp_interop_override_abi.h";
// The CFlat-defined [cpp] structs below derive from C++ class-template specializations, and
// the make_shared checks register them through std::shared_ptr.
import cpp "library/cpp_interop_tpl.h";
import cpp "vector";
import cpp "string";
import cpp "memory";
import cpp "functional";
import cpp "deque";
import cpp "map";
