int bridge_range_twin_break_continue()
{
    std.vector<cpptw.Twin> values = default;
    values.push_back(cpptw.Twin(1));
    values.push_back(cpptw.Twin(2));
    values.push_back(cpptw.Twin(3));
    int sum = 0;
    for (cpptw.Twin value in values)
    {
        if (value.value() == 1) continue;
        sum = sum + value.value();
        if (value.value() == 2) break;
    }
    return sum;
}

