        bridge_check("LVS vector move value", values[0].forward(1), 5);
        bridge_check("LVS vector moved-from", source.k, 0);
    }
    {
        std.vector<BridgeSinkCheck> values = default;
        values.push_back(BridgeSinkCheck(4));
        bridge_check("LVS vector temporary", values[0].forward(1), 5);
    }
    {
        std.vector<BridgeSinkCheck> values = default;
        values.emplace_back(4);
        bridge_check("LVS vector emplace", values[0].forward(1), 5);
    }
    {
        std.deque<BridgeSinkCheck> values = default;
        BridgeSinkCheck local = BridgeSinkCheck(6);
        values.push_back(move local);
        bridge_check("LVS deque move", values[0].forward(1), 7);
    }
    {
        BridgeSinkCheck local = BridgeSinkCheck(8);
        bridge_check("LVS const-ref borrow", cplv.borrow(local), 8);
        bridge_check("LVS const-ref source", local.k, 8);
    }
    if (bridge_passed - bridgeLvsStartPassed != bridge_checks - bridgeLvsStartChecks)
        return 2079;

    // ---- C++ sink accept neighbours (2080-2089) --------------------------------------
    int bridgeLvaStartChecks = bridge_checks;
    int bridgeLvaStartPassed = bridge_passed;
    {
        std.vector<cppas.MoveOnly> values = default;
        cppas.MoveOnly local = cppas.MoveOnly(10);
