};

T bridge_return_field<T>(BridgeFieldHolder<T>* holder)
{
    return holder->value;
}

T bridge_return_local<T>(int value)
{
    T local = default;
    local.set(value);
    return local;
}

int bridge_method_field<T>(T* pointer)
{
    (*pointer).set(pointer->value() + 1);
    pointer->set(pointer->value() + 1);
    return (*pointer).value() + pointer->value() + pointer->field;
}

int bridge_lifetime<T>(int seed)
{
    int result = 0;
    {
        T local = default;
        local.set(seed);
        for (int i = 0; i < 2; i++)
        {
            T loop = default;
            loop.set(local.value() + i);
            result = result + loop.value();
        }
        if (result > 0) return result;
    }
    return result;
}

int bridge_parameterized<T>(int value)
{
    T* local = new T(value);
    int result = local->value();
    delete local;
    return result;
}

