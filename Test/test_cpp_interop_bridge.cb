struct RetTempPlainReturns
{
    cppi.Tracked ctor_return(int value) { return cppi.Tracked(value); }
    cppi.Tracked sret_return(int value) { return cppi.make_tracked(value); }
    cppi.Tracked inner(int value) { return cppi.make_tracked(value); }
    cppi.Tracked outer(int value) { return inner(value); }
    cppi.Tracked both(int value)
    {
        return cppi.make_tracked(cppi.Tracked(value).value());
    }
};

