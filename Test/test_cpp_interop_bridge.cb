    cppt.tplbase.Holder<int> inner = default;
    TplBaseMemberTripler(int v) : cppt.tplbase.Holder<int>(v) { inner.value = 9; }
    override int doubled() { return value * 2 + inner.value; }
};

struct GenericWrap<T> : cppt.tplbase.Holder<T>
{
    GenericWrap(T v) : cppt.tplbase.Holder<T>(v) { }
    override T doubled() { return value + value + 3; }
};

