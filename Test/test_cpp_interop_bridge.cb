        if (cppt.module_use_count(leaf) != 2) return 1508;
    }
    if (cppt.module_dtors() != 1) return 1509;

    cppt.reset_module_dtors();
    {
        std.shared_ptr<SharedNet> net = std.make_shared<SharedNet>();
        shared_init_net(net.get());
        if (net->child_count() != 2) return 1510;
        if (net->call_child(1, 2) != 6) return 1511;
        if (net->forward(1) != 6) return 1512;
        std.shared_ptr<cppt.ModuleBase> base = net;
        if (cppt.run_module(base, 1) != 6) return 1513;
    }
    if (cppt.module_dtors() != 3) return 1514;

    cppt.reset_module_dtors();
    {
        std.shared_ptr<SharedNet> net = std.make_shared<SharedNet>();
        shared_init_net(net.get());
        std.shared_ptr<SharedLeaf> local = std.make_shared<SharedLeaf>(4);
        std.shared_ptr<SharedLeaf> returned = net->register_child("local", local);
        if (net->child_count() != 3) return 1515;
        if (cppt.module_use_count(local) != 3) return 1516;
        if (returned->forward(2) != 8) return 1517;
    }
    if (cppt.module_dtors() != 4) return 1518;

    cppt.reset_module_dtors();
    {
        SharedNet net = SharedNet();
        shared_init_net(&net);
        if (net.forward(1) != 6) return 1519;
        if (net.child_count() != 2) return 1520;
    }
    if (cppt.module_dtors() != 3) return 1521;

    {
        SharedSelf self = SharedSelf();
        if (self.forward(4) != 5) return 1522;
    }

    {
        std.vector<std.shared_ptr<SharedLeaf>> values = default;
        values.push_back(std.make_shared<SharedLeaf>(2));
        values.push_back(std.make_shared<SharedLeaf>(5));
        if (values[0]->forward(2) != 4) return 1523;
        if (values[1]->forward(2) != 10) return 1524;
        if (cppt.module_use_count(values[0]) != 1) return 1525;
        if (cppt.module_use_count(values[1]) != 1) return 1526;
    }

    {
        std.shared_ptr<SharedLeaf> source = std.make_shared<SharedLeaf>(7);
        std.shared_ptr<SharedLeaf> target = move source;
        if (cppt.module_use_count(target) != 1) return 1527;
        if (target->forward(2) != 14) return 1528;
    }
    if (cppt.module_dtors() != 7) return 1529;
    cppt.reset_module_dtors();
    if (cppt.module_dtors() != 0) return 1529;

    cppt.reset_module_dtors();
    {
        std.shared_ptr<SharedNet> net = std.make_shared<SharedNet>();
        std.shared_ptr<SharedLeaf> got = net->take(std.make_shared<SharedLeaf>(4));
        if (got->forward(1) != 4) return 1530;
    }
    if (cppt.module_dtors() != 2) return 1531;

    cppt.reset_module_dtors();
    {
        std.shared_ptr<SharedHolderNet> net = std.make_shared<SharedHolderNet>(4);
        if (net->child_count() != 1) return 1535;
        if (net->call_child(0, 2) != 3) return 1536;
        if (net->forward(2) != 4) return 1537;
        if (cppt.module_use_count(net) != 1) return 1538;
    }
    if (cppt.module_dtors() != 3) return 1539;

    std.string sharedText = std.string("abcd");
    if (cppt.shared_pick_string(sharedText) != 24) return 1540;
    if (cppt.shared_pick_string(std.string("abc")) != 13) return 1541;
    if (cppt.shared_pick_pointer(&sharedGlobal) != 11) return 1542;

    // A shared_ptr FIELD whose argument class is declared after the owner: the field's type was
    // registered from a forward declaration and promoted when SharedLeaf's definition arrived. Every
    // member below is one the promotion has to hand back complete - operator*, get() with a real
    // pointee type (not a bare void*), use_count, copy, and assignment from a temporary.
    cppt.reset_module_dtors();
    {
        std.shared_ptr<SharedNet> net = std.make_shared<SharedNet>();
        shared_bind_net(net.get());
        if ((*net->left).forward(3) != 6) return 1543;
        if ((*net->right).value != 3) return 1544;
        if (net->left.get()->value != 2) return 1545;
        if (net->left.get()->forward(4) != 8) return 1546;
        if ((int)net->left.use_count() != 2) return 1547;
        std.shared_ptr<SharedLeaf> handle = net->left;
        std.shared_ptr<SharedLeaf> second = handle;
        // 4 owners: children[0], net->left, handle, second. This read was 3 before the
        // field-lvalue initializer was copy-CONSTRUCTED - `handle` had skipped the refcount.
        if ((int)handle.use_count() != 4) return 1548;
        if (second.get()->forward(5) != 10) return 1549;
        if ((*second).value != 2) return 1550;
        std.shared_ptr<SharedLeaf> fresh = std.make_shared<SharedLeaf>(7);
        if (fresh.get()->value != 7) return 1551;
        fresh = std.make_shared<SharedLeaf>(9);
        if ((*fresh).forward(2) != 18) return 1552;
    }
    if (cppt.module_dtors() != 5) return 1553;

    // ---- copy-CONSTRUCT a C++ class local from a non-identifier lvalue --------------------------
    // Every use_count leg below reads a refcount the SOURCE still owns. Pre-fix the initializer
    // was a bitwise store, so each read was one low and the local's destructor released a
    // reference it never acquired; the deref / global / element legs did not compile at all.
    // Measured pre-fix: 1692 read 3, 1694 read 2, 1695 read 2, 1697 read 1, and the run then
    // aborted in free() before 1707 (the heap-string field's buffer was released twice).
    // 1690, 1691, 1693, 1696, 1702 are accept-set: they read the same value on both binaries
    // and are here to pin the source values the failing legs are measured against.
    cppt.reset_module_dtors();
    {
        std.shared_ptr<SharedLeaf> seed = std.make_shared<SharedLeaf>(6);
        // Accept-set: a bare-identifier source already copy-constructed before this change.
        std.shared_ptr<SharedLeaf> alias = seed;
        if ((int)seed.use_count() != 2)                 return 1690;
        CopyCtorBox box = default;
        box.p = seed;
        if ((int)seed.use_count() != 3)                 return 1691;
        {
            std.shared_ptr<SharedLeaf> fromDot = box.p;
            if ((int)seed.use_count() != 4)             return 1692;
            if (fromDot->forward(2) != 12)              return 1693;
        }
        if ((int)seed.use_count() != 3)                 return 1694;
        CopyCtorBox* bp = &box;
        {
            std.shared_ptr<SharedLeaf> fromArrow = bp->p;
            if ((int)seed.use_count() != 4)             return 1695;
            if (fromArrow->value != 6)                  return 1696;
        }
        if ((int)seed.use_count() != 3)                 return 1697;
        std.shared_ptr<SharedLeaf>* pp = &box.p;
        {
            std.shared_ptr<SharedLeaf> fromDeref = *pp;
            if ((int)seed.use_count() != 4)             return 1698;
            if (fromDeref->forward(3) != 18)            return 1699;
        }
        std.vector<std.shared_ptr<SharedLeaf>> vec = default;
        vec.push_back(seed);
        if ((int)seed.use_count() != 4)                 return 1700;
        {
            std.shared_ptr<SharedLeaf> fromElem = vec[0];
            if ((int)seed.use_count() != 5)             return 1701;
            if (fromElem->value != 6)                   return 1702;
        }
        if ((int)seed.use_count() != 4)                 return 1703;
        // A HEAP (non-SSO) string field: the pre-fix bitwise copy aliased the buffer and the
        // local's destructor freed it, so the field read back below aborted in free().
        std.string copyctorLong = std.string("abcdefghijklmnopqrstuvwxyz0123456789");
        box.s = copyctorLong;
        {
            std.string fromField = box.s;
            if ((int)fromField.size() != 36)            return 1704;
        }
        if ((int)box.s.size() != 36)                    return 1705;
        if (cppt.shared_pick_string(box.s) != 56)          return 1706;
    }
    if (cppt.module_dtors() != 1)                       return 1707;

    // A namespace-scope C++ object as the initializer. Kept last: the global holds its leaf for
    // the rest of the program, so it must not be inside the destructor count above.
    copyctorGlobal = std.make_shared<SharedLeaf>(9);
    if ((int)copyctorGlobal.use_count() != 1)                return 1708;
    {
        std.shared_ptr<SharedLeaf> fromGlobal = copyctorGlobal;
        if ((int)copyctorGlobal.use_count() != 2)            return 1709;
        if (fromGlobal->forward(2) != 18)               return 1709;
    }

    {
        ReturnSharedBox box = default;
        box.value = std.make_shared<SharedLeaf>(4);
        std.shared_ptr<SharedLeaf> returned = bridge_return_shared(&box);
        bridge_check("bridge return shared_ptr value", (int)returned.use_count(), 2);
        std.shared_ptr<SharedLeaf> afterCall = bridge_return_shared_after_call(&box);
        bridge_check("bridge return shared_ptr after a call statement", (int)afterCall.use_count(), 3);
        if ((int)box.value.use_count() != 3) return 1710;
    }
    // The return slot owns the copied function object; the local in bridge_return_function is
    // moved-from and destroyed exactly once before this call observes the returned handler.
    std.function<int(int)> returnedFunction = bridge_return_function();
    bridge_check("bridge return std.function value", returnedFunction(2), 4);

    // ---- std::function as a member parameter and as a return type -------------------------------
    // Every member leg below was refused at bind time ("member '...' takes/returns unsupported
    // type 'std::function<...>'") while the free-function parameter forms bound.
    cppfn.Plain stdfnP = cppfn.Plain();
    if (stdfnP.run_val(std.function<int(int)>(stdfn_twice), 3) != 106)     return 1910;
    if (stdfnP.run_ref(std.function<int(int)>(stdfn_twice), 4) != 108)     return 1911;
    if (stdfnP.run_rv(std.function<int(int)>(stdfn_twice), 5) != 110)      return 1912;
    if (cppfn.Plain.run_static(std.function<int(int)>(stdfn_twice), 6) != 1012) return 1913;
    // A CONSTRUCTOR parameter bound before this change (its void* shape happened to carry the
    // address); it is here so the retyped parameter keeps passing the same callable.
    cppfn.Plain stdfnC = cppfn.Plain(std.function<int(int)>(stdfn_twice));
    if (stdfnC.bias() != 20)                                              return 1914;

    std.function<int(int)> stdfnA = cppfn.make_adder(7);
    if (stdfnA(4) != 11)                                                  return 1915;
    if (cppfn.make_adder(3)(4) != 7)                                     return 1916;
    std.function<int(int)> stdfnM = stdfnP.get_adder(5);
    if (stdfnM(4) != 9)                                                   return 1917;
    std.function<int(int)> stdfnS = cppfn.Plain.make_scaler(3);
    if (stdfnS(4) != 12)                                                  return 1918;

    cppfn.Holder stdfnH = cppfn.Holder();
    stdfn_install(stdfnH);
    if (stdfnH.fire(7) != 14)                                             return 1919;

    stdfn_bumped = 0;
    if (cppfn.call_void(std.function<void()>(stdfn_bump)) != 7)           return 1920;
    cppfn.VoidHolder stdfnV = cppfn.VoidHolder();
    if (stdfnV.go(std.function<void()>(stdfn_bump)) != 5)                  return 1921;
    if (stdfn_bumped != 2)                                                return 1922;

    if (cppfn.call_str(std.function<int(std.string)>(stdfn_len)) != 4)    return 1923;
    cppfn.StrHolder stdfnSt = cppfn.StrHolder();
    if (stdfnSt.go(std.function<int(std.string)>(stdfn_len)) != 5)         return 1924;

    // A CONSTRUCTOR parameter spelled `const&` keeps the pointer shape its C++ symbol declares;
    // binding it by value emitted "Call parameter type does not match function signature!".
    // The `&&` constructor form and the nested-spelling refusals are in
    // Test/errors/err_cpp_std_function_nested.cb.
    cppfn.CtorRef stdfnCr = cppfn.CtorRef(std.function<int(int)>(stdfn_twice));
    if (stdfnCr.v() != 4)                                                 return 1925;

    // Anchoring the free-PARAMETER retype at top level must not narrow the real thing: these are
    // the top-level free-parameter shapes, taken from the same header as the refused
    // vector<function> one (Test/errors/err_cpp_std_function_nested.cb pins that refusal).
    if (cppfn.apply_val(std.function<int(int)>(stdfn_twice), 9) != 18)     return 1926;
    if (cppfn.apply_ref(std.function<int(int)>(stdfn_twice), 11) != 22)    return 1927;
    if (cppfn.apply_rv(std.function<int(int)>(stdfn_twice), 12) != 24)     return 1928;

    // Generated-record signature legs; the unique_ptr container is global because a local C++ owner
    // hits the existing no-destructor limitation, but this leg still inserts and reads a BP.
    std.vector<std.vector<GrsSigBP*>> grsRows = default;
    if (grs_sig_order(grsRows) != 1930)                                      return 1930;
    if (grs_sig_param(grsRows) != 1931)                                      return 1931;
    auto grsReturned = grs_sig_return();
    if ((int)grsReturned.size() != 0)                                        return 1932;
    std.vector<std.vector<std.vector<GrsSigBP*>>> grsDeep = default;
    if (grs_sig_depth3(grsDeep) != 1933)                                    return 1933;
    std.vector<std.shared_ptr<GrsSigBP>> grsShared = default;
    if (grs_sig_shared(grsShared) != 1934)                                  return 1934;
    grs_sig_unique_global.push_back(std.unique_ptr<GrsSigBP>(new GrsSigBP()));
    if (grs_sig_unique(&grs_sig_unique_global) != 1935)                       return 1935;
    std.deque<std.vector<GrsSigBP*>> grsDeque = default;
    if (grs_sig_deque(grsDeque) != 1936)                                    return 1936;
    std.map<int, std.vector<GrsSigBP*>> grsMap = default;
    if (grs_sig_map(grsMap) != 1937)                                        return 1937;
    GrsSigCflatHolder grsCflatHolder = default;
    if ((int)grsCflatHolder.rows.size() != 0)                               return 1938;
    GrsSigCppHolder grsCppHolder = default;
    if ((int)grsCppHolder.rows.size() != 0)                                 return 1939;
    if ((int)grs_sig_global.size() != 0)                                    return 1940;
    if (grs_sig_alias(grsRows) != 1941)                                     return 1941;
    std.vector<std.vector<grs_sig_ns.BP*>> grsNs = default;
    if (grs_sig_ns.take(grsNs) != 1942)                                     return 1942;
    std.vector<std.vector<GrsSigDerived*>> grsBase = default;
    if (grs_sig_base(grsBase) != 1943)                                      return 1943;
    if (grsRows.size() != 0 || grsDeep.size() != 0)                         return 1944;
    if (grsShared.size() != 0 || grsDeque.size() != 0)                      return 1945;
    if (grsMap.size() != 0 || grs_sig_global.size() != 0)                   return 1946;
    if (grsCflatHolder.rows.size() != 0 || grsCppHolder.rows.size() != 0)   return 1947;
    GrsSigBP value = GrsSigBP();
    if (value.v != 7 || grs_sig_ns.BP().v != 8)                              return 1948;
    std.vector<std.vector<GrsSigBaseOnly*>> grsBaseOnly = default;
    if (grs_sig_base_only(grsBaseOnly) != 1949)                              return 1949;

    bridge_reset_cf();
    int bridgeMethodCf = 0;
    {
        TwinCf value = default;
        value.set(5);
        bridgeMethodCf = bridge_method_field<TwinCf>(&value) + TwinCf.static_value();
    }
    bridge_check("bridge method/field CFlat value", bridgeMethodCf, 94);
    bridge_check("bridge method/field CFlat ctor", bridge_cf_ctor, 1);
    bridge_check("bridge method/field CFlat copy", bridge_cf_copy, 0);
    bridge_check("bridge method/field CFlat move", bridge_cf_move, 0);
    bridge_check("bridge method/field CFlat dtor", bridge_cf_dtor, 1);
    bridge_check("bridge method/field CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeMethodCpp = 0;
    {
        cpptw.Twin value = default;
        value.set(5);
        bridgeMethodCpp = bridge_method_field<cpptw.Twin>(&value) + cpptw.Twin.static_value();
    }
    bridge_check("bridge method/field C++ value", bridgeMethodCpp, 94);
    bridge_check("bridge method/field C++ ctor", cpptw.ctor_count(), 1);
    bridge_check("bridge method/field C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge method/field C++ move", cpptw.move_count(), 0);
    bridge_check("bridge method/field C++ dtor", cpptw.dtor_count(), 1);
    bridge_check("bridge method/field C++ live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeLifetimeCf = bridge_lifetime<TwinCf>(7);
    bridge_check("bridge lifetime CFlat value", bridgeLifetimeCf, 15);
    bridge_check("bridge lifetime CFlat ctor", bridge_cf_ctor, 3);
    bridge_check("bridge lifetime CFlat copy", bridge_cf_copy, 0);
    bridge_check("bridge lifetime CFlat move", bridge_cf_move, 0);
    bridge_check("bridge lifetime CFlat dtor", bridge_cf_dtor, 3);
    bridge_check("bridge lifetime CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeLifetimeCpp = bridge_lifetime<cpptw.Twin>(7);
    bridge_check("bridge lifetime C++ value", bridgeLifetimeCpp, 15);
    bridge_check("bridge lifetime C++ ctor", cpptw.ctor_count(), 3);
    bridge_check("bridge lifetime C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge lifetime C++ move", cpptw.move_count(), 0);
    bridge_check("bridge lifetime C++ dtor", cpptw.dtor_count(), 3);
    bridge_check("bridge lifetime C++ live", cpptw.live_allocations(), 0);

    // A parameterized constructor runs field initialization and its own body, not the user
    // no-arg body. The same generic harness must produce the same constructor count for both twins.
    bridge_reset_cf();
    bridge_check("bridge parameterized CFlat value", bridge_parameterized<TwinCf>(7), 7);
    bridge_check("bridge parameterized CFlat ctor", bridge_cf_ctor, 1);
    bridge_check("bridge parameterized CFlat dtor", bridge_cf_dtor, 1);
    bridge_check("bridge parameterized CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    bridge_check("bridge parameterized C++ value", bridge_parameterized<cpptw.Twin>(7), 7);
    bridge_check("bridge parameterized C++ ctor", cpptw.ctor_count(), 1);
    bridge_check("bridge parameterized C++ dtor", cpptw.dtor_count(), 1);
    bridge_check("bridge parameterized C++ live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeArrayCf = bridge_fixed_array<TwinCf>();
    bridge_check("bridge fixed array CFlat value", bridgeArrayCf, 11);
    bridge_check("bridge fixed array CFlat ctor", bridge_cf_ctor, 2);
    bridge_check("bridge fixed array CFlat copy", bridge_cf_copy, 0);
    bridge_check("bridge fixed array CFlat move", bridge_cf_move, 0);
    bridge_check("bridge fixed array CFlat dtor", bridge_cf_dtor, 2);
    bridge_check("bridge fixed array CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeArrayCpp = bridge_fixed_array<cpptw.Twin>();
    bridge_check("bridge fixed array C++ value", bridgeArrayCpp, 11);
    bridge_check("bridge fixed array C++ ctor", cpptw.ctor_count(), 2);
    bridge_check("bridge fixed array C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge fixed array C++ move", cpptw.move_count(), 0);
    bridge_check("bridge fixed array C++ dtor", cpptw.dtor_count(), 2);
    bridge_check("bridge fixed array C++ live", cpptw.live_allocations(), 0);

    // Brace-constructed CFlat values call the user no-arg constructor, just like C++.
    bridge_reset_cf();
    int bridgeBracePrvalueCf = bridge_brace_array_prvalue_cf();
    bridge_check("bridge brace-init array prvalue CFlat value", bridgeBracePrvalueCf, 0);
    bridge_check("bridge brace-init array prvalue CFlat dtor", bridge_cf_dtor, 2);
    bridge_check("bridge brace-init array prvalue CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeBracePrvalueCpp = bridge_brace_array_prvalue_cpp();
    bridge_check("bridge brace-init array prvalue C++ value", bridgeBracePrvalueCpp, 0);
    bridge_check("bridge brace-init array prvalue C++ ctor", cpptw.ctor_count(), 2);
    bridge_check("bridge brace-init array prvalue C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge brace-init array prvalue C++ move", cpptw.move_count(), 0);
    bridge_check("bridge brace-init array prvalue C++ dtor", cpptw.dtor_count(), 2);
    bridge_check("bridge brace-init array prvalue C++ live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeBraceLvalueCf = bridge_brace_array_lvalue_cf();
    bridge_check("bridge brace-init array lvalue CFlat value", bridgeBraceLvalueCf, 15);
    bridge_check("bridge brace-init array lvalue CFlat dtor", bridge_cf_dtor, 4);
    bridge_check("bridge brace-init array lvalue CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeBraceLvalueCpp = bridge_brace_array_lvalue_cpp();
    bridge_check("bridge brace-init array lvalue C++ value", bridgeBraceLvalueCpp, 15);
    bridge_check("bridge brace-init array lvalue C++ ctor", cpptw.ctor_count(), 2);
    bridge_check("bridge brace-init array lvalue C++ copy", cpptw.copy_count(), 2);
    bridge_check("bridge brace-init array lvalue C++ move", cpptw.move_count(), 0);
    bridge_check("bridge brace-init array lvalue C++ dtor", cpptw.dtor_count(), 4);
    bridge_check("bridge brace-init array lvalue C++ live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeBraceMoveCf = bridge_brace_array_move_cf();
    bridge_check("bridge brace-init array move CFlat value", bridgeBraceMoveCf, 8);
    bridge_check("bridge brace-init array move CFlat dtor", bridge_cf_dtor, 2);
    bridge_check("bridge brace-init array move CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeBraceMoveCpp = bridge_brace_array_move_cpp();
    bridge_check("bridge brace-init array move C++ value", bridgeBraceMoveCpp, 8);
    bridge_check("bridge brace-init array move C++ ctor", cpptw.ctor_count(), 1);
    bridge_check("bridge brace-init array move C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge brace-init array move C++ move", cpptw.move_count(), 1);
    bridge_check("bridge brace-init array move C++ dtor", cpptw.dtor_count(), 2);
    bridge_check("bridge brace-init array move C++ live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeBraceShortCf = bridge_brace_array_short_cf();
    bridge_check("bridge brace-init array short CFlat value", bridgeBraceShortCf, 0);
    bridge_check("bridge brace-init array short CFlat dtor", bridge_cf_dtor, 3);
    bridge_check("bridge brace-init array short CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeBraceShortCpp = bridge_brace_array_short_cpp();
    bridge_check("bridge brace-init array short C++ value", bridgeBraceShortCpp, 0);
    bridge_check("bridge brace-init array short C++ ctor", cpptw.ctor_count(), 3);
    bridge_check("bridge brace-init array short C++ copy", cpptw.copy_count(), 0);
    bridge_check("bridge brace-init array short C++ move", cpptw.move_count(), 0);
    bridge_check("bridge brace-init array short C++ dtor", cpptw.dtor_count(), 3);
    bridge_check("bridge brace-init array short C++ live", cpptw.live_allocations(), 0);
    bridge_check("bridge brace-init array call then lvalue copies", bridge_brace_array_call_then_lvalue(), 221);
    cpptw.reset_counts();
    bridge_check("bridge brace-init array CFlat function result value", bridge_brace_array_cflat_result(), 30);
    bridge_check("bridge brace-init array CFlat function result live", cpptw.live_allocations(), 0);

    bridge_reset_cf();
    int bridgeFieldCf = bridge_struct_field<TwinCf>();
    bridge_check("bridge struct field CFlat value", bridgeFieldCf, 12);
    bridge_check("bridge struct field CFlat ctor", bridge_cf_ctor, 1);
    bridge_check("bridge struct field CFlat copy", bridge_cf_copy, 0);
    bridge_check("bridge struct field CFlat move", bridge_cf_move, 0);
    bridge_check("bridge struct field CFlat dtor", bridge_cf_dtor, 1);
    bridge_check("bridge struct field CFlat live", bridge_cf_live, 0);

    cpptw.reset_counts();
    int bridgeFieldCpp = bridge_struct_field<cpptw.Twin>();
    bridge_check("bridge struct field C++ value", bridgeFieldCpp, 12);
    bridge_check("bridge struct field C++ ctor", cpptw.ctor_count(), 1);
