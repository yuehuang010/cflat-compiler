    // ---- generic CFlat-defined [cpp] structs ----------------------------------------------------
    cppt.tplbase.reset_holder_int_dtors();
    {
        GenericWrap<int> source = GenericWrap<int>(5);
        if (source.doubled() != 13) return 1560;
        if (cppt.tplbase.call_doubled<int>(&source) != 13) return 1561;
        GenericWrap<int> target = move source;
        if (target.value != 5 || target.doubled() != 13) return 1562;
        if (cppt.tplbase.call_doubled<int>(&target) != 13) return 1563;
        if (cppt.tplbase.holder_int_dtors() != 0) return 1564;
    }
    if (cppt.tplbase.holder_int_dtors() != 2) return 1565;

    cppt.tplbase.reset_holder_double_dtors();
    {
        GenericWrap<double> value = GenericWrap<double>(2.5);
        if (value.doubled() != 8.0) return 1566;
        if (cppt.tplbase.call_doubled<double>(&value) != 8.0) return 1567;
    }
    if (cppt.tplbase.holder_double_dtors() != 1) return 1568;

