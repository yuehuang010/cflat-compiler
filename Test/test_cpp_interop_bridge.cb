[cpp] struct BridgeHidingMembers : cppsf.HidingBase
{
    int size() { return 1; }
    int read() { return 3; }
    int same(int x) { return x + 2; }
    // Same name as a PRIVATE base member: no `using` may be emitted for it.
    int secret() { return 4; }
};

[cpp] struct BridgeMultipleBaseMembers : cppsf.HidingMulti
{
    int choose(int x) { return x + 1; }
};

[cpp] struct BridgeCppKeywordMethods
{
    int concept() { return 1; }
    int requires() { return 2; }
    int and() { return 3; }
};

[cpp] struct BridgeSinkCheck : cplv.Module
{
    int k = 0;
    BridgeSinkCheck(int value) { k = value; tag = value; }
    override int forward(int x) { return x + k; }
};

[cpp] struct BridgeOverrideAbi : cppoa.Base
{
    int field = 0;
    override void set_value(int* out) { *out = 47; }
    override int integer() { return 37; }
    override double floating() { return 19.5; }
    override int* pointer() { field = 41; return &field; }
    override int* reference() { field = 43; return &field; }
    override cppoa.Small8 small8()
    {
        cppoa.Small8 result = default;
        result.a = 3;
        result.b = 4;
        return result;
    }
    override cppoa.Small16 small16()
    {
        cppoa.Small16 result = default;
        result.a = 5;
        result.b = 7;
        return result;
    }
    override cppoa.Large24 large24()
    {
        cppoa.Large24 result = default;
        result.a = 1;
        result.b = 2;
        result.c = 3;
        return result;
    }
    override int byvalue(cppoa.Dtor value) { return value.value + 1; }
};

[cpp] struct BridgeGenericOverrideAbi<T> : cppoa.GenericBase<T>
{
    override T value(cppoa.Dtor value)
    {
        T result = default;
        result.a = value.value;
        return result;
    }
};

int bridge_cf_ctor = 0;
int bridge_cf_copy = 0;
int bridge_cf_move = 0;
int bridge_cf_dtor = 0;
int bridge_cf_copy_assign = 0;
int bridge_cf_move_assign = 0;
int bridge_cf_live = 0;

void bridge_reset_cf()
{
    bridge_cf_ctor = 0; bridge_cf_copy = 0; bridge_cf_move = 0;
    bridge_cf_dtor = 0; bridge_cf_copy_assign = 0; bridge_cf_move_assign = 0;
    bridge_cf_live = 0;
}

struct TwinCf
{
    int* data = new int[3];
    int field = 0;

    TwinCf() { bridge_cf_ctor++; bridge_cf_live++; data[0] = 0; data[1] = 1; data[2] = 2; }
    TwinCf(int value)
    {
        bridge_cf_ctor++; bridge_cf_live++; field = value;
        data[0] = value; data[1] = value + 1; data[2] = value + 2;
    }
    ~TwinCf()
    {
        if (data != nullptr) { delete[] data; bridge_cf_live--; }
        bridge_cf_dtor++;
    }
    TwinCf copy()
    {
        TwinCf result = default;
        bridge_cf_ctor--; bridge_cf_copy++;
        result.field = field;
        result.data[0] = data[0]; result.data[1] = data[1]; result.data[2] = data[2];
        return move result;
    }
    int value() { return field; }
    void set(int value)
    {
        field = value;
        data[0] = value; data[1] = value + 1; data[2] = value + 2;
    }
    bool operator==(alias TwinCf other) { return field == other.field; }
    int operator[](int index) { return data[index]; }
    int* begin() { return data; }
    int* end() { return data + 3; }
    int count() { return 3; }
    int get(int index) { return data[index]; }
    static int static_value() { return 73; }
};

bool operator bool(alias TwinCf value) { return value.field != 0; }

struct BridgeFieldHolder<T>
{
    T value = default;
    int tag = 2;
};

struct BridgeCopyFieldHolder<T>
{
    T value = default;
};

struct BridgeNestedCopyFieldHolder<T>
{
    BridgeCopyFieldHolder<T> inner = default;
};

struct BridgeArrayCopyFieldHolder<T>
{
    T[2] values = default;
};

struct BridgeStringCopyFieldHolder
{
    std.string value = default;
};

struct BridgeSharedCopyFieldHolder
{
    std.shared_ptr<int> value = default;
};

struct BridgeMultiCxxFieldHolder<T>
{
    T first = default;
    T second = default;
    int marker = 0;
};

interface BridgeIfhHolder { int read(BridgeFieldHolder<cpptw.Twin> value); };
class BridgeIfhHolderA : BridgeIfhHolder
{
    int read(BridgeFieldHolder<cpptw.Twin> value)
    {
        value.value.set(77);
        return value.value.value() + value.tag;
    }
};
class BridgeIfhHolderB : BridgeIfhHolder
{
    int read(BridgeFieldHolder<cpptw.Twin> value) { return value.value.value() + 9; }
};
int bridge_ifh_last_use(BridgeIfhHolder value, BridgeFieldHolder<cpptw.Twin> holder)
{
    return value.read(holder);
}
interface BridgeIfhEcho
{
    BridgeFieldHolder<cpptw.Twin> echo(BridgeFieldHolder<cpptw.Twin> value);
};
class BridgeIfhEchoImpl : BridgeIfhEcho
{
    BridgeFieldHolder<cpptw.Twin> echo(BridgeFieldHolder<cpptw.Twin> value) { return move value; }
};
interface BridgeIfhSret { cpptw.Twin take(BridgeFieldHolder<cpptw.Twin> value); };
class BridgeIfhSretImpl : BridgeIfhSret
{
    cpptw.Twin take(BridgeFieldHolder<cpptw.Twin> value)
    {
        return cpptw.Twin(value.value.value());
    }
};
interface BridgeIfhGeneric<T> { int read(T value); };
class BridgeIfhGenericImpl : BridgeIfhGeneric<BridgeFieldHolder<cpptw.Twin>>
{
    int read(BridgeFieldHolder<cpptw.Twin> value) { return value.value.value() + value.tag; }
};
interface BridgeIfhTwin { int read(cpptw.Twin value); };
class BridgeIfhTwinImpl : BridgeIfhTwin
{
    int read(cpptw.Twin value) { return value.value(); }
};
struct BridgeIfhPlain { int x = 2; int y = 3; };
interface BridgeIfhPlainRead { int read(BridgeIfhPlain value); };
class BridgeIfhPlainImpl : BridgeIfhPlainRead
{
    int read(BridgeIfhPlain value) { value.x = 9; return value.x * 10 + value.y; }
};

int bridge_bvh_inner<T>(BridgeFieldHolder<T> value) { return value.value.value(); }
int bridge_bvh_read<T>(BridgeFieldHolder<T> value) { return value.value.value(); }
int bridge_bvh_mutate<T>(BridgeFieldHolder<T> value)
{
    value.value.set(52);
    return value.value[0];
}
int bridge_bvh_nested<T>(BridgeNestedCopyFieldHolder<T> value)
{
    return value.inner.value.value();
}
int bridge_bvh_array<T>(BridgeArrayCopyFieldHolder<T> value)
{
    return value.values[0].value() + value.values[1].value();
}
int bridge_bvh_array_move<T>(move BridgeArrayCopyFieldHolder<T> value)
{
    return value.values[0].value() + value.values[1].value();
}
int bridge_bvh_multi<T>(BridgeMultiCxxFieldHolder<T> value)
{
    return value.first.value() + value.second.value() + value.marker;
}
cpptw.Twin bridge_bvh_move_field(BridgeFieldHolder<cpptw.Twin> value)
{
    return move value.value;
}
TwinCf bridge_bvh_move_field_cf(move BridgeFieldHolder<TwinCf> value)
{
    return move value.value;
}
int bridge_bvh_loop<T>(BridgeFieldHolder<T> value)
{
    int total = 0;
    for (int i = 0; i < 2; i++) total += bridge_bvh_inner<T>(value);
    return total;
}
int bridge_bvh_last_use<T>(BridgeFieldHolder<T> value)
{
    return bridge_bvh_inner<T>(value);
}
int bridge_bvh_move<T>(BridgeFieldHolder<T> value)
{
    return value.value.value();
}
int bridge_bvh_move_cf(move BridgeFieldHolder<TwinCf> value)
{
    return value.value.value();
}
BridgeFieldHolder<T> bridge_bvh_return<T>(BridgeFieldHolder<T> value)
{
    return move value;
}
int bridge_bvh_recurse<T>(BridgeFieldHolder<T> value, int depth)
{
    if (depth == 0) return value.value.value();
    return bridge_bvh_recurse<T>(value, depth - 1);
}

