// cflat-args: --cpp-assume-noexcept
// (the line above is read by test.sh / test.bat: sections M8-M9 call libc++ members, which
// carry no noexcept specification - Test/errors/err_cpp_template_may_throw.cb proves the
// gate is still on by default)
// End-to-end C-interop coverage. Each section exercises one path of the C-interop
// pipeline; on failure the section's exit code identifies which one regressed.
//
//   Section A (1-9)   : auto-extern of a compiled .c source (clang JSON AST -> auto
//                       extern + struct registration), no hand-written declarations.
//   Section B (10)    : hand-written extern alongside auto-extern (first-writer-wins).
//   Section C (20-25) : `import package` - prebuilt library bound via header + .lib,
//                       including variadic call-site ABI and enum constant registration.
//   Section D (30-42) : struct-by-value ABI - core sizes 1/4/8/12/24, mixed slots,
//                       SRet+ByVal round-trip.
//   Section E (50-59) : struct-by-value ABI - odd sizes 2/3/7 (non-{1,2,4,8} routes).
//   Section F (60-69) : struct-by-value ABI - single-float / single-double / mixed-
//                       type structs (MSVC x64 still routes through GPR, not XMM).
//   Section G (70-79) : struct-by-value ABI - nested struct field, pointer-field
//                       struct (size differs across Win64/Win32), composed calls.
//   Section H (80-89) : struct-by-value ABI - register exhaustion (6 struct params
//                       on Win64 spills past RCX/RDX/R8/R9 onto the stack).
//   Section I (90-99) : object-like #define macro extraction - decimal, hex,
//                       parenthesized negative, expression-folded, i64-promoted,
//                       define-gated, and float/double (routed via __typeof__);
//                       function-like / string macros must be silently skipped
//                       without poisoning their neighbors.
//   Section J (100-115): function-like #define macro translation - each accepted
//                       macro becomes an `auto` generic function callable without
//                       explicit type args; rejected bodies (calls, strings,
//                       member access, floats) must be silently dropped.
//   Section K (120-129): typedef chain resolution - signatures spelled with
//                       `typedef void* HANDLE` (and multi-hop chains like
//                       SCK -> HANDLE -> void*) must auto-register; previously
//                       skipped as "unsupported return/parameter type".
//   Section M3 (290-322): C++ trivially copyable records by value - layout (size, alignment,
//                       packed, over-aligned) checked against the C++ side's own sizeof/alignof,
//                       then round trips through every AArch64 arrangement clang picks: coerced
//                       small integer, two-eightbyte, HFA in float registers, indirect + sret.
//   Section M4 (330-349): C++ class members - instance methods (const and mutating, with
//                       arguments), static methods, static data member reads, dispatch through
//                       a pointer receiver, the const-overload ruling (an lvalue picks the
//                       non-const leg), and qualified scoped-enum spellings. Access control and
//                       polymorphism are covered by Test/errors/err_cpp_*.cb.
//   Section M6 (420-459): C++ inheritance and VIRTUAL dispatch - polymorphic classes laid out
//                       from clang (vptr slot + base subobjects), virtual calls through the
//                       vtable slot ItaniumVTableContext assigned, virtual destructor via the
//                       Itanium deleting-destructor slot, and multiple inheritance with a
//                       non-primary base whose `this` must be adjusted.
//   Section M5 (350-399): C++ NONTRIVIAL class lifetime - construction into the declared slot
//                       (`T(args)`), copy/move construction, copy/move assignment, exactly-once
//                       destruction on normal exit, nested scopes, early return, break and
//                       continue, nontrivial by-value arguments (copy and move) and by-value
//                       returns constructed straight into the local, plus new/delete and
//                       `unique T*` through the C++ operators. Every assertion is an EXACT
//                       instrumented count, so an extra copy or a missed destructor fails here.
//   Section M7 (460-479): HEADER-ONLY C++ - inline free functions (including one that calls
//                       another, and one with a static local), an all-inline nontrivial class,
//                       inline static data members as lifetime counters, and an all-inline
//                       VIRTUAL hierarchy with no key function. Nothing here has an out-of-line
//                       symbol, so every assertion also proves clang's definition emission
//                       landed in the linked image. Two import groups cover the same code, so a
//                       duplicate definition would fail the link instead of merging by ODR.
//   Section M8 (480-499): C++ CLASS TEMPLATES instantiated from CFlat - `cppt.Box<int>` and
//                       `cppt.Box<double>` from one header-only pattern (constructor, get/set,
//                       operator[] bound to the index expression, operator==), a per-
//                       specialization static counter, a specialization over a nontrivial C++
//                       class whose DEFAULTED destructor still has to run, and the same
//                       specialization named in two functions (one registration, one symbol).
//   Section M9 (500-529): libc++ through the same path - std.vector<int>, std.vector<double>,
//                       std.string, and the nested std.vector<std.string>, plus element
//                       destruction counted for std.vector<cppi.Tracked>.
//   Section M10 (530-549, 578-585): review follow-ups - a specialization whose element type is a POINTER
//                       (std.vector<char*>), where every member signature that names the container
//                       itself carries an inner '*' that the type mapper must not strip, and a
//                       `move` argument to a libc++ member.
//   Section M (270-289): C++ interop via `import cpp` - namespaced/overloaded declarations
//   Section M19 (725-739): C++ operator(), unary ~, and conversion operators
//                       bound by mangled linkage name, reference params and returns
//                       as pointers, extern "C" bare linkage, nested namespaces,
//                       widening and narrow-unsigned round trips, scoped-enum params,
//                       records by pointer. Primitives and bare pointers only.

import "library/c_alias_order_alias.h";
import "library/c_alias_order_real.h";
import "library/c_alias_reverse_real.h";
import "library/c_alias_reverse_alias.h";
import { "library/c_alias_group_alias.h", "library/c_alias_group_real.h" };
import { "library/c_alias_group_real_first.h", "library/c_alias_group_real_first_alias.h" };
import "library/c_alias_late_alias.h";
import "library/c_alias_late_target.h";
import "library/c_alias_late_chain_a.h";
import "library/c_alias_late_chain_b.h";
import "library/c_alias_late_chain_target.h";
import { "library/c_alias_group_late_alias.h", "library/c_alias_group_late_target.h" };
import "library/c_alias_late_diff.h";
import "library/c_alias_late_diff_target.h";
import "library/testmodule.cb";
import "library/cinterop.c";
import "library/struct_byval_util.c";
import package "cinterop/mathlib.h" lib "cinterop/mathlib.lib" define "ML_EXTRA";
import "library/c_macro_helpers.h";
// Section M: C++ interop - `import cpp` selects C++ mode; the extension is irrelevant (the
// fixture header is a plain .h). The header supplies the declarations, the .cpp is compiled
// by the host C++ driver and linked in. Both are needed: the header alone has no
// definitions, and the source alone would not exercise the header-extraction path.
import cpp "library/cpp_interop_basic.h";
import cpp "library/cpp_interop_basic.cpp";
// Section M6: inheritance and virtual dispatch. Definitions are out-of-line on purpose - every
// virtual function needs a real symbol and the vtable needs a key function.
import cpp "library/cpp_interop_poly.h";
import cpp "library/cpp_interop_poly.cpp";
// Section M7: HEADER-ONLY C++ - no .cpp anywhere. Every definition is inline in the header, so
// clang CodeGen has to emit the bodies, vtables and inline statics into the companion module.
// The second header re-includes the first from a DIFFERENT import group, which is the
// duplicate-definition (ODR merge) check.
import cpp "library/cpp_interop_inline.h";
import cpp "library/cpp_interop_inline_again.h";
// Section M8: one header-only CLASS TEMPLATE pattern. No specialization has a symbol anywhere
// until a CFlat declaration asks for one, so every M8 assertion also proves the instantiation
// path emitted the bodies. Section M9 needs no fixture at all - the libc++ headers are the
// fixture, reached by the SYSTEM header spelling below.
import cpp "library/cpp_interop_tpl.h";
import cpp "vector";
import cpp "string";
import cpp "functional";
import "library/float_macros.h";
// Accept side of the conflicting-declaration check: prototypes identical to ones already
// bound (core putn/printf, and c_add from cinterop.c above) must be a silent no-op.
import "library/extern_agree_core.h";
import "string.cb";

// Section B: hand-written extern alongside auto-extern. Same signatures the auto-
// extern path infers; first-writer-wins resolves the duplicate without diagnostic.
extern int c_add(int a, int b);
extern int c_square(int x);

extern int printf(const char* fmt, ...);
extern int  strcmp(const char* a, const char* b);

// CFlat function used as a callback into the C library through the function-pointer
// typedef ML_BinaryOp (declared in mathlib.h as `typedef int (*ML_BinaryOp)(int,int)`).
int my_add_cb(int a, int b) { return a + b; }
int my_sub_cb(int a, int b) { return a - b; }
int my_inc_cb(int x) { return x + 1; }

int m7_cb_add(int a, int b) { return a + b; }
int m7_cb_twice(int x) { return x * 2; }
int m7_cb_mixed_out(cppi.Mixed m, char** out) { *out = "callback-out"; return m.i + (int)m.d; }
cppi.Mixed m7_cb_mixed(cppi.Mixed m) { m.d = m.d + 1.0; m.i = m.i + 1; return m; }
cppi.Large m7_cb_large(cppi.Large v)
{
    v.x = v.x + 1; v.y = v.y + 1; v.z = v.z + 1; return v;
}
cppi.Hfa m7_cb_hfa(cppi.Hfa v)
{
    v.a = v.a + 1.0f; v.b = v.b + 1.0f; v.c = v.c + 1.0f; v.d = v.d + 1.0f; return v;
}
int m7_cb_visit(cppi.Tracked* t, void* ctx)
{
    int* state = (int*)ctx;
    if (cppi.dtor_count() != 0) state[1] = 1;
    state[0] = state[0] + 1;
    return t.value();
}

string abiStringGlobal = default;
extern string abiExternStringValue() { return abiStringGlobal; }
extern alias string abiExternAliasStringValue() { return abiStringGlobal; }
// Taken as a function-pointer value below: an extern whose return is C-ABI lowered needs an
// adapter thunk, while the CFlat sibling on the same signature must stay unwrapped.
extern string abiExternStringOf(int n) { return abiStringGlobal; }
string abiCFlatStringOf(int n) { return abiStringGlobal; }
struct AbiPair { int x = 0; int y = 0; };
extern AbiPair abiExternPairOf(int n) { AbiPair p; p.x = 7; p.y = n; return p; }

// Section L: float/double #define macro extraction.
static bool near(double actual, double expected, double tol)
{
    double diff = actual - expected;
    if (diff < 0.0) { diff = -diff; }
    return diff <= tol;
}

static bool testFloatMacros()
{
    bool r = true;
    // A. Plain literals
    r &= near(FM_DOUBLE_PLAIN,  1.5,   1e-12);
    r &= near(FM_FLOAT_SUFFIX,  2.5,   1e-6);
    r &= near(FM_LONG_DOUBLE,   3.5,   1e-12);
    // B. Sign / parens
    r &= near(FM_NEG,          -1.25,  1e-12);
    r &= near(FM_NEG_PAREN,    -2.75,  1e-12);
    r &= near(FM_DOUBLE_NEG,    4.125, 1e-12);
    r &= near(FM_UNARY_PLUS,    0.75,  1e-12);
    // C. Scientific notation
    r &= near(FM_SCI_POS,       1500.0,  1e-9);
    r &= near(FM_SCI_NEG_EXP,   0.00025, 1e-12);
    r &= near(FM_SCI_LEAD_DOT,  25.0,    1e-12);
    r &= near(FM_SCI_TRAIL_DOT, 40.0,    1e-12);
    r &= near(FM_SCI_CAP_E,     625.0,   1e-12);
    // D. Hex floats - exact binary
    r &= FM_HEX_FLOAT     == 12.0;
    r &= FM_HEX_FLOAT_NEG == -2.5;
    // E. Arithmetic - dyadic rationals, exact
    r &= FM_ADD        ==  2.0;
    r &= FM_SUB        == 10.0;
    r &= FM_MUL        == 10.0;
    r &= FM_DIV        ==  0.25;
    r &= FM_NESTED     == 12.0;
    r &= FM_PRECEDENCE == 14.0;
    // F. Mixed int+float
    r &= FM_MIX_INT_FLOAT == 1.5;
    r &= FM_MIX_DIV_INT   == 0.5;
    // G. Casts
    r &= FM_CAST_DOUBLE         == 42.0;
    r &= FM_CAST_FLOAT          ==  7.0;
    r &= FM_CAST_FROM_INT_MACRO == 101.0;
    // H. Magnitude - proportional tolerance
    r &= near(FM_TINY, 1e-300, 1e-310);
    r &= near(FM_HUGE, 1e300,  1e290);
    // I. Macro chaining
    r &= FM_BASE    ==  2.0;
    r &= FM_DERIVED == 10.0;
    // J. Zero / negative zero
    r &= FM_ZERO     == 0.0;
    r &= FM_NEG_ZERO == 0.0;
    // K. Negative: int cast of float recovers as int 3
    r &= FM_INT_CAST_OF_FLOAT == 3;
    return r;
}

// M5 helpers. Each holds a nontrivial C++ local and leaves through a DIFFERENT exit edge, so
// the counters below prove the existing cleanup paths (not a second mechanism) destroy it.
int m5_early_return(int k)
{
    cppi.Tracked t = cppi.Tracked(k);
    if (k > 0) return t.value();
    return -1;
}

// M8 helper: the SAME specialization `cppt.Box<int>` a second function also declares. One
// registration and one emitted symbol have to serve both, or the link fails on a duplicate.
int m8_second_use(int v)
{
    cppt.Box<int> b = cppt.Box<int>(v);
    return b.get() + b[0];
}

// M9 helper: a std.string built and read in a second function - the specialization is requested
// once for the whole compilation, not once per use site.
int m9_second_use()
{
    std.string s = std.string("abcd");
    return (int)s.size();
}

int m17_direct_array_param(std.array<int, 4> value)
{
    return cppi.array_total(value);
}

extern int main()
{
    // ---- Section A: auto-extern of .c source ---------------------------------
    if (c_add(40, 2) != 42)             return 1;
    if (c_square(7) != 49)              return 2;

    // ---- Section B: hand-written extern (same calls, validates coexistence) --
    if (c_add(1, 2) != 3)               return 10;

    abiStringGlobal = "hello".copy();
    if ((int)abiExternStringValue().length() != 5)      return 11;
    if ((int)abiExternAliasStringValue().length() != 5) return 12;
    function<string(int)> abiFp = abiExternStringOf;
    string abiViaPtr = abiFp(0);
    if ((int)abiViaPtr.length() != 5)   return 13;   // extern string through function<>
    function<string(int)> abiFpCb = abiCFlatStringOf;
    string abiViaPtrCb = abiFpCb(0);
    if ((int)abiViaPtrCb.length() != 5) return 14;   // CFlat sibling unaffected
    AbiPair abiDirect = abiExternPairOf(3);
    if (abiDirect.x != 7 || abiDirect.y != 3) return 15;
    function<AbiPair(int)> abiFpPair = abiExternPairOf;
    AbiPair abiViaPtrPair = abiFpPair(4);
    if (abiViaPtrPair.x != 7 || abiViaPtrPair.y != 4) return 16;

    // library/extern_agree_core.h re-declares core's putn/printf and cinterop.c's c_add at
    // IDENTICAL types. Reaching these lines at all is the accept assertion - a differing type
    // is an import-time error (err_extern_collides_with_core.cb) and this file would not
    // compile. The values then prove the agreeing redeclaration did not REBIND the name.
    if (c_add(20, 22) != 42)            return 17;   // header agreeing with an earlier .c auto-extern
    if (printf("") != 0)                return 18;   // header agreeing with a core VARIADIC extern

    // ---- Section C: import package (header + .lib + enum constants) ----------
    if (ml_add(40, 2) != 42)            return 20;       // plain function
    if (ml_mul(6, 7) != 42)             return 21;
    if (ml_sum(4, 10, 20, 30, 40) != 100) return 22;     // variadic call-site ABI
    if (ml_apply_const(my_inc_cb, 9) != 10) return 26;
    if (WHITE != 100)                   return 23;       // explicit enum value
    if (GREEN != 2)                     return 24;       // auto-incremented enum value
    if (EXTRA_FLAG != 7)                return 25;       // gated by inline `define "ML_EXTRA"`

    // ---- Section D: struct-by-value ABI --------------------------------------
    // 1-byte struct: CoerceToInt(i8) on Win64; ByVal on Win32.
    Byte1 b1 = make_byte1(42);
    if (b1.b != 42)                     return 30;
    if (sum_byte1(b1) != 42)            return 31;

    // 4-byte struct: CoerceToInt(i32) on both platforms.
    Byte4 b4 = make_byte4(1234567);
    if (b4.x != 1234567)                return 32;
    if (sum_byte4(b4) != 1234567)       return 33;

    // 8-byte struct: CoerceToInt(i64) on both platforms (Win32 returns in EDX:EAX).
    Pair p = make_pair(10, 32);
    if (p.x != 10 || p.y != 32)         return 34;
    if (sum_pair(p) != 42)              return 35;

    // 12-byte struct: ByVal/SRet on both platforms.
    Med m = make_med(100, 200, 300);
    if (m.a != 100 || m.b != 200 || m.c != 300) return 36;
    if (sum_med(m) != 600)              return 37;

    // 24-byte struct: ByVal/SRet on both platforms.
    Big bg = make_big(1.5, 2.5, 3.5);
    double s = sum_big(bg);
    if (s < 7.49 || s > 7.51)           return 38;

    // Mixed slot: struct sandwiched between scalar args - exercises non-first slots.
    int sp = scaled_pair(3, p, 7);  // 3*(10+32) + 7 = 133
    if (sp != 133)                      return 39;

    // Round-trip: ByVal arg + SRet return on the same call. Verifies that:
    //   - The callee's mutation lands in the returned struct.
    //   - The caller's bg is NOT mutated (byval means the callee gets a copy).
    Big bumped = bump_big(bg, 1.0);
    double bs = sum_big(bumped);
    if (bs < 10.49 || bs > 10.51)       return 40;
    double original = sum_big(bg);
    if (original < 7.49 || original > 7.51) return 41;

    // ---- Section E: odd / non-{1,2,4,8} sizes --------------------------------
    // 4-byte struct built from two i16 fields - layout/alignment differ from
    // the all-int Byte4 case but lowering must still be CoerceToInt(i32).
    Two t2 = make_two(1000, 2345);
    if (t2.a != 1000 || t2.b != 2345)   return 50;
    if (sum_two(t2) != 3345)            return 51;

    // 3-byte struct - ByVal/SRet on both platforms (size not in {1,2,4,8}).
    Tri t3 = make_tri(10, 20, 30);
    if (t3.a != 10 || t3.b != 20 || t3.c != 30) return 52;
    if (sum_tri(t3) != 60)              return 53;

    // 7-byte struct - ByVal/SRet on both. Exercises a sret slot smaller than 8.
    Sev t7 = make_sev(1, 2, 3, 4, 5, 6, 7);
    if (sum_sev(t7) != 28)              return 54;

    // ---- Section F: single-float / single-double / mixed-type ----------------
    // Struct-of-float: 4 bytes, MSVC x64 still passes/returns in GPR (no HFA).
    Flt ff = make_flt(2.5f);
    float fv = get_flt(ff);
    if (fv < 2.49 || fv > 2.51)         return 60;

    // Struct-of-double: 8 bytes, GPR on both platforms (EDX:EAX on Win32).
    Dbl dd = make_dbl(3.25);
    double dv = get_dbl(dd);
    if (dv < 3.24 || dv > 3.26)         return 61;

    // Mixed int+double: 16 bytes (4 + 4 padding + 8) -> ByVal/SRet on both.
    // Verifies the recipe respects struct padding, not just naive field-size sum.
    Mix mx = make_mix(7, 1.5);
    if (mx.i != 7)                      return 62;
    if (mx.d < 1.49 || mx.d > 1.51)     return 63;
    double mc = mix_combine(mx);
    if (mc < 8.49 || mc > 8.51)         return 64;

    // ---- Section G: nested struct field, pointer-field struct, composed calls --
    // Nested struct - inner Pair is registered before Nested so the field type
    // resolves correctly during RegisterCRecords' two-pass body fill.
    Nested ns = make_nested(11, 22, 33);
    if (ns.p.x != 11 || ns.p.y != 22 || ns.extra != 33) return 70;
    if (nested_sum(ns) != 66)           return 71;

    // Struct with an int* field. Win64: 16 bytes (ByVal/SRet). Win32: 8 bytes
    // (CoerceToInt(i64)). Same source, different ABI path per platform.
    int payload = 100;
    PtrFld pf = make_ptrfld(&payload, 5);
    if (pf.n != 5)                      return 72;
    if (ptrfld_load(pf) != 105)         return 73;

    // Composed call: struct return fed directly into a struct param, with no
    // intermediate local. Verifies EmitAbiLoweredCall correctly allocates the
    // arg-slot from a value still residing in the previous call's sret/coerce slot.
    if (sum_pair(make_pair(8, 9)) != 17)     return 74;
    if (sum_med(make_med(1, 2, 3)) != 6)     return 75;
    double composed = sum_big(make_big(2.0, 3.0, 4.0));
    if (composed < 8.99 || composed > 9.01)  return 76;

    // ---- Section H: register exhaustion on Win64 (>4 struct args) ------------
    // Six 8-byte structs: first four go in RCX/RDX/R8/R9 (each as i64 coerce),
    // the last two spill onto the stack. A miscompile in the spill path or in
    // the per-slot CoerceToInt would show up as a wrong total here.
    Pair p1 = make_pair(1,  2);
    Pair p2 = make_pair(3,  4);
    Pair p3 = make_pair(5,  6);
    Pair p4 = make_pair(7,  8);
    Pair p5 = make_pair(9,  10);
    Pair p6 = make_pair(11, 12);
    if (sum_six_pairs(p1, p2, p3, p4, p5, p6) != 78) return 80;

    // ---- Section I: object-like #define macro extraction ---------------------
    // Decimal, hex, parenthesized negative, and folded expression all resolve
    // via the probe-stub value fold in ResolveCHeaderMacroValues.
    if (ML_PI_X100 != 314)              return 90;
    if (ML_MAX_NODES != 4096)           return 91;   // 0x1000
    if (ML_NEG_OFFSET != -5)            return 92;
    if (ML_COMBINED_MASK != 21)         return 93;   // (1<<0)|(1<<2)|(1<<4)

    // Value > INT32_MAX -> registered as i64 (RegisterCMacros widens automatically).
    i64 big = ML_BIG_CONST;
    if (big != (i64)0x100000000)        return 94;

    // Unsigned 32-bit max (0xFFFFFFFFU). getZExtValue gives 4294967295 (positive i64).
    // A wrong implementation using getSExtValue on an unsigned APSInt would
    // sign-extend to -1, making the value negative - detectable in Release.
    i64 uall = ML_UINT_ALL;
    if (uall <= 0)                      return 116;   // 4294967295 > 0 always

    // Unsigned 64-bit max (~0ULL). Correct extraction bit-reinterprets to i64(-1).
    // The old code triggered an isRepresentableByInt64 assert in Debug LLVM builds
    // for this exact shape; this test catches any regression.
    i64 umax64 = ML_UMAX64;
    if (umax64 != (i64)-1)              return 117;

    // Gated by inline `define "ML_EXTRA"` on the import line. Verifies per-import
    // defines reach the macro extractor, not just the decl/enum dumps.
    if (ML_EXTRA_MACRO != 77)           return 95;

    // Float/double macros - routed through the double-fold probe based on the
    // __typeof__ recovered C type. Registered as CFlat `double` globals.
    if (ML_PI < 3.1415 || ML_PI > 3.1416)               return 96;
    if (ML_HALF < 0.49 || ML_HALF > 0.51)               return 97;
    if (ML_NEG_FLOAT < -1.26 || ML_NEG_FLOAT > -1.24)   return 98;
    if (ML_TWO_PI < 6.28 || ML_TWO_PI > 6.29)           return 99;
    // Float-suffixed source literal: precision lost in float->double round-trip
    // is still well inside our 0.01 tolerance.
    if (ML_FLOAT_F < 2.49 || ML_FLOAT_F > 2.51)         return 119;

    // String-literal macros - routed through Pass B's __typeof__ probe (recovered
    // type is char[N]) and resolved by the string-literal probe. Registered as
    // CFlat `char*` globals interned in the string pool; the C call-site ABI
    // treats them as `const char*`.
    if (strcmp(ML_NAME, "mathlib") != 0)                 return 125;
    if (strcmp(ML_VERSION, "1.2.3") != 0)                return 126;
    if (strcmp(ML_GREETING, "hello\nworld") != 0)        return 127;

    // Anonymous enum: constants are still registered as bare globals (no type
    // name to bind to). The EnumDecl walker is name-agnostic for the constants.
    if (ML_ANON_LOW != 50)                               return 130;
    if (ML_ANON_HIGH != 60)                              return 131;

    // Typedef of anonymous enum: clang reports desugaredQualType as the typedef
    // name itself (self-reference), so CollectCTypedefs falls back to qualType
    // ("enum ML_Mode") to keep the chain resolvable. Without the fallback the
    // signatures below would skip with "unsupported parameter type 'ML_Mode'".
    if (ML_FAST != 1)                                    return 132;
    if (ML_SLOW != 2)                                    return 133;
    if (ml_mode_value(ML_FAST) != 1)                     return 134;
    if (ml_mode_value(ML_AUTO) != 3)                     return 135;
    if (ml_pick_mode(1) != 1)                            return 136;  // ML_FAST
    if (ml_pick_mode(2) != 2)                            return 137;  // ML_SLOW
    if (ml_pick_mode(9) != 3)                            return 138;  // ML_AUTO

    // Typedef of named enum where alias differs from the tag (ML_PriorityAlias
    // -> enum ML_PriorityTag -> int). Constants register as bare globals; the
    // typedef-as-type would resolve to int via the enum-strip path.
    if (ML_LOW_PRI != 10)                                return 139;
    if (ML_HIGH_PRI != 20)                               return 140;

    // Function-pointer typedef: ML_BinaryOp = `int (*)(int,int)`. clang's
    // qualType for the typedef is "int (*)(int, int)"; CollectCTypedefs stores
    // that spelling, MapCTypeToTypeAndValue's ParseCFunctionPointerSpelling
    // turns it into a CFlat IsFunctionPointer TypeAndValue.
    if (ml_apply(my_add_cb, 10, 32) != 42)               return 141;
    if (ml_apply(my_sub_cb, 50,  8) != 42)               return 142;

    // Function-pointer return value: ml_pick_op returns ML_BinaryOp. CFlat
    // receives a fat-struct function<int(int,int)> and calls it through the
    // indirect-call path.
    function<int(int,int)> op_add = ml_pick_op(0);
    function<int(int,int)> op_mul = ml_pick_op(1);
    function<int(int,int)> op_sub = ml_pick_op(2);
    if (op_add(10, 32) != 42)                            return 143;
    if (op_mul(6, 7)  != 42)                             return 144;
    if (op_sub(50, 8) != 42)                             return 145;

    // Function-pointer macro constant: ML_NULL_OP = ((int(*)(int,int))0). Pass B
    // recognizes the (*) shape in __typeof__ output and registers the macro as a
    // function<int(int,int)> global, env=intToPtr(0). The interesting bit is that
    // the assignment compiles - the macro resolves to the constant fat struct
    // and the storage matches function<int(int,int)>. We don't invoke (env=0
    // would AV); we also don't compare (closure fat structs aren't icmp-able).
    function<int(int,int)> sentinel = ML_NULL_OP;
    // Reassign from a live callback to confirm the variable behaves as function<T>.
    sentinel = ml_pick_op(0);
    if (sentinel(10, 32) != 42)                          return 146;

    // ---- Section M: C-interop named union ------------------------------------
    // mathlib.h declares `union ML_IntFloat { int as_int; float as_float; }`.
    // RegisterCRecords routes this through CreateUnionType so both fields share
    // offset 0 (max-size slot, no FieldIndex GEPs). Pass-by-pointer to a C helper
    // exercises that the union resolves end-to-end through the auto-extern path
    // and that field access on a `union ML_IntFloat *` GEPs to offset 0.
    ML_IntFloat u = default;
    ml_pun_write_int(&u, 0x40490FDB);                    // ~ pi as float bits (IEEE-754)
    int ref_bits = ml_pun_int_bits_of(3.14159274f);      // reference bit pattern
    // Field overlap: writing as_int and reading as_float must see the same bytes.
    float f = ml_pun_read_float(&u);
    if (ml_pun_int_bits_of(f) != ref_bits)               return 150;
    // Field overlap from the cflat side: write as_float, read as_int.
    u.as_float = 3.14159274f;
    if (u.as_int != ref_bits)                            return 151;
    // Round-trip the other direction.
    u.as_int = 42;
    if (u.as_int != 42)                                  return 152;

    // ---- Section J: function-like macro translation -------------------------
    // Each accepted macro from c_macro_helpers.h is translated into an `auto`
    // generic function and called without explicit type arguments.
    if (CB_MIN(3, 7) != 3)               return 100;
    if (CB_MIN(9, 2) != 2)               return 101;
    if (CB_MAX(3, 7) != 7)               return 102;
    if (CB_MAX(9, 2) != 9)               return 103;

    if (CB_KB(2) != 2048)                return 104;
    if (CB_KB(0) != 0)                   return 105;

    if (CB_LOWORD(0x12345678) != 0x5678) return 106;
    if (CB_HIWORD(0x12345678) != 0x1234) return 107;

    if (CB_ABS(-9) != 9)                 return 108;
    if (CB_ABS(9)  != 9)                 return 109;

    if (CB_IS_ODD(5) != 1)               return 110;
    if (CB_IS_ODD(4) != 0)               return 111;

    if (CB_CLAMP(5, 0, 10) != 5)         return 112;
    if (CB_CLAMP(-3, 0, 10) != 0)        return 113;
    if (CB_CLAMP(99, 0, 10) != 10)       return 114;

    // Cross-type instantiation: i64 arg forces CB_MIN<int,i64> with widened return.
    if (CB_MIN(3, (i64)7) != (i64)3)     return 115;

    // Richer macro bodies: decimal float literal (int*1.5 widens to double),
    // char literals, and a call into an already-known C function (c_add).
    if (!near(CB_SCALE(2), 3.0, 1e-12)) return 210;
    if (!near(CB_SCALE(5), 7.5, 1e-12)) return 211;
    if (CB_IS_DIGIT('5') != true)        return 212;
    if (CB_IS_DIGIT('a') != false)       return 213;
    if (CB_CALL_ADD(40, 2) != 42)        return 214;
    if (CB_CALL_ADD(100, -1) != 99)      return 215;

    // ---- Section K: typedef chain resolution --------------------------------
    // c_get_handle returns C_HANDLE (typedef void* C_HANDLE). Before this fix
    // the function was skipped with "unsupported return type 'C_HANDLE'".
    void* h = c_get_handle();
    if (c_handle_load(h) != 0x5A5A5A5A) return 120;

    // Multi-hop typedef: SCK -> C_HANDLE -> void*. Mapper must follow >1 hop.
    if (c_sck_load(h) != 0x5A5A5A5A)    return 121;

    // Typedef'd integer chain: C_LONG_PTR -> long long -> i64.
    if (c_lp_double((i64)21) != (i64)42) return 122;

    // Pointer-sentinel macro: CB_INVALID_HANDLE = ((CB_HANDLE)(CB_LONG_PTR)-1).
    // Pass B's __typeof__ probe recovers the type as CB_HANDLE -> void*, so the
    // macro is registered as a void* global and compares equal to the matching
    // pointer returned from C. Before the fix it registered as an i64 constant
    // and the comparison was a type error.
    void* invalid_h = c_get_invalid_handle();
    if (invalid_h != CB_INVALID_HANDLE) return 123;
    if (h == CB_INVALID_HANDLE)         return 124;   // real handle, not sentinel

    // Function-pointer-sentinel macro: CB_TRANSIENT_DTOR = ((CB_DTOR_FN)-1), the
    // SQLITE_TRANSIENT pattern. It registers as a THIN C function-pointer global; the
    // global's type and its inttoptr initializer must agree. Regression: a fat-closure
    // global type vs a thin-ptr initializer failed LLVM module verification, so merely
    // referencing this macro (which emits the global) is the core check; the bit
    // pattern is verified too.
    void* dtor = (void*)CB_TRANSIENT_DTOR;
    if (dtor != (void*)(i64)(-1)) return 125;

    // ---- Section N: anonymous union inside struct (C11) ---------------------
    // mathlib.h declares `struct ML_Overlap { int header; union { int as_int;
    // float as_float; }; int trailer; }`. The C-interop extractor synthesizes a
    // tag (`ML_Overlap__anon0`) for the inner union, registers it as a sibling
    // record, and rewrites the materializing unnamed field to a synthetic name
    // `__anon0`. CFlat reaches the inner members via `o.__anon0.as_int`.
    ML_Overlap o = default;
    o.header  = 0x11111111;
    o.trailer = 0x22222222;
    o.__anon0.as_int = 0x40490FDB;                       // pi-as-float bit pattern
    int ref2 = ml_pun_int_bits_of(3.14159274f);
    if (ml_overlap_read_int(&o) != 0x40490FDB)   return 130;
    // Field overlap inside the anon union: writing as_int and reading as_float
    // through the C helper must see the same bytes.
    if (ml_pun_int_bits_of(ml_overlap_read_float(&o)) != ref2) return 131;
    // Surrounding fields are unaffected by the union write.
    if (ml_overlap_header_of(&o)  != 0x11111111) return 132;
    if (ml_overlap_trailer_of(&o) != 0x22222222) return 133;
    // Symmetric write from cflat: write as_float through the anon, read as_int.
    o.__anon0.as_float = 3.14159274f;
    if (o.__anon0.as_int != ref2)                return 134;

    // ---- Section O: _Bool and long double round-trip -----------------------
    // _Bool (C99) maps to CFlat bool; clang's target-derived IEEE-double long
    // double maps to CFlat double. Both C and C++ shapes must round-trip cleanly.
    if (ml_bool_not(true)  != false)             return 140;
    if (ml_bool_not(false) != true)              return 141;
    if (ml_bool_and(true, false) != false)       return 142;
    if (ml_bool_and(true, true)  != true)        return 143;
    bool bout = false;
    ml_bool_store(&bout, true);
    if (bout != true)                            return 144;

    if (ml_ld_identity(2.5) != 2.5)              return 145;
    if (ml_ld_add(1.25, 2.5) != 3.75)            return 146;
    double dout = 0.0;
    ml_ld_store(&dout, 7.125);
    if (dout != 7.125)                           return 147;
    if (cppi.ld_identity(2.5) != 2.5)            return 148;
    if (cppi.ld_add(1.25, 2.5) != 3.75)         return 149;
    dout = 0.0;
    cppi.ld_store(7.125, &dout);
    if (dout != 7.125)                           return 150;

    // ---- Section P: 3+ levels of pointer indirection -----------------------
    // mathlib.h declares helpers taking `int***`. The C-interop mapper collapses
    // ptr > 2 to opaque `void**` (TypeAndValue has only Pointer + ElemPointer);
    // CFlat holds the chain as an opaque handle and threads it back through C.
    // Functions that were previously skipped per the `ptr > 2` guard now bind.
    void** chain = ml_make_ppp(123);
    if (ml_ppp_load(chain) != 123)               return 160;
    ml_ppp_set(chain, 456);
    if (ml_ppp_load(chain) != 456)               return 161;
    ml_ppp_free(chain);

    // ---- Section Q: C bitfields with MSVC LSB-first packing ----------------
    // ML_Flags has 1+3+4+24 = 32 bits packed into one unsigned int. CFlat must
    // read/write the same bit positions as C; we cross-check by (a) having C
    // initialize via field assignment and CFlat read the same fields, and
    // (b) having CFlat assign and C return the raw 32-bit word.
    ML_Flags qf = default;
    ml_flags_init(&qf);
    if (qf.ready != 1)                          return 170;
    if (qf.mode != 5)                           return 171;
    if (qf.reserved != 12)                      return 172;
    if (qf.count != 1234567)                    return 173;

    // CFlat-side write, C-side read.
    ML_Flags qg = default;
    qg.ready = 1;
    qg.mode = 6;
    qg.reserved = 9;
    qg.count = 99999;
    if (ml_flags_get_count(&qg) != 99999)       return 174;
    // The raw word must match the same bit layout as if C had written it.
    // bits: count<<8 | reserved<<4 | mode<<1 | ready  = 99999<<8 | 9<<4 | 6<<1 | 1
    u32 expectedWord = ((u32)99999 << 8) | ((u32)9 << 4) | ((u32)6 << 1) | (u32)1;
    u32 actualWord = ml_flags_word(&qg);
    if (actualWord != expectedWord)             return 175;

    // C-side write via helper, CFlat-side read.
    ml_flags_set_count(&qg, 8675309);
    if (qg.count != 8675309)                    return 176;

    // ---- Section R: extern global variables (header-bind + .c auto-extern) ---
    // mathlib.h declares `extern int/double/const char*` globals; the import-package
    // path binds them as declaration-only, mutable CFlat globals resolved against
    // mathlib.lib. cinterop.c defines `int c_global_counter` bound via .c auto-extern.
    // Reads come straight from the linked C definitions; writes prove mutability.
    if (ml_global_int != 4242)                   return 180;
    if (ml_global_double < 2.49 || ml_global_double > 2.51) return 181;
    if (strcmp(ml_global_name, "mathlib-global") != 0)      return 182;
    if (c_global_counter != 1000)                return 183;

    // Mutability (C style): assign through the bound global, read back.
    ml_global_int = 7;
    if (ml_global_int != 7)                      return 184;
    c_global_counter = c_global_counter + 5;
    if (c_global_counter != 1005)                return 185;

    // ---- Section L: float/double #define macro extraction -------------------
    if (!testFloatMacros())                     return 200;

    // ---- Section S: opaque forward-declared handle type ---------------------
    // mathlib.h declares `typedef struct ML_Opaque ML_Opaque;` with no body. The
    // extractor registers it as an opaque (pointer-only) type, so it is nameable
    // as a pointer (the SDL_Window / sqlite3_stmt handle idiom). Before the fix
    // this failed with "unknown type 'ML_Opaque'". void* converts both ways with
    // no cast; a by-value `ML_Opaque h;` would error with "incomplete layout".
    ML_Opaque* oh = nullptr;
    void* ohv = oh;                              // typed handle decays to void*
    oh = (ML_Opaque*)ohv;                        // and back via cast
    if (oh != nullptr)                           return 220;

    // The `Ref` form: `typedef struct ML_Opaque *ML_OpaqueRef;` - a typedef whose
    // target is a POINTER to the opaque tag (CGColorSpaceRef / HWND). It must bind as
    // an alias for ML_Opaque*; the alias-adoption pass used to drop every pointer
    // typedef, so the name did not resolve at all. Auto-externed C signatures still
    // spell such handles void*, so the alias has to convert both ways with no cast:
    // `h` below is a real (non-null) handle from Section K's c_get_handle().
    ML_OpaqueRef oref = h;                       // void* from C -> handle alias
    if (oref == nullptr)                         return 221;
    ML_Opaque* obk = oref;                       // alias and its target are one type
    void* obv = oref;                            // and it still decays back to void*
    if (obk != obv)                              return 222;
    if (c_handle_load(oref) != 0x5A5A5A5A)       return 223;   // passes to a void* param

    // ---- Section T: C function-pointer struct fields + typed struct pointers -
    // cinterop.c's CbVtbl is a struct of function pointers (a mini COM vtable) and
    // CbObj.vtbl points at it. The C-fn-ptr fields must import as callable thin
    // function<> slots, and the `vtbl` pointer field must keep its CbVtbl* type, so
    // `o.vtbl->add(&o, ...)` dispatches with no hand-written cast - the COM idiom.
    CbObj cbo = default;
    cb_init_obj(&cbo, 10);
    if (cbo.value != 10)                         return 230;   // typed field readable
    if (cbo.vtbl->add(&cbo, 2, 3) != 15)         return 231;   // dispatch through fn-ptr slot
    if (cbo.vtbl->get(&cbo) != 15)               return 232;   // mutation landed via `this`
    if (cbo.vtbl->add(&cbo, 100, 0) != 115)      return 233;   // accumulates

    // ---- Section U: alias macros (`#define A B`, body is one identifier) -----
    // Such a macro has no parameter list (the function-like translator never sees it)
    // and folds to no constant (the object-like probe dropped it), so the name did not
    // exist in CFlat at all. Legs 240-247 each failed to COMPILE before the fix
    // ("Undefined variable X." / "the function 'X' is not known").
    if (CB_ALIAS_ADD(40, 2) != 42)               return 240;   // alias -> C function
    if (CB_ALIAS_CHAIN(20, 3) != 23)             return 241;   // alias -> alias -> function
    if (CB_ALIAS_EARLY(6) != 24)                 return 242;   // alias precedes target's decl
    if (CB_ALIAS_TRAIL(7) != 21)                 return 243;   // trailing comment after body
    if (CB_ALIAS_MIN(3, 7) != 3)                 return 244;   // alias -> function-like macro
    if (CB_ALIAS_MIN(9, 2) != 2)                 return 245;
    if (CB_ALIAS_FUNC_CALL(7) != 21)             return 250;   // function macro body -> object alias
    if (CB_ALIAS_FUNC_CHAIN(3, 8) != 3)          return 251;   // macro -> alias -> alias -> function macro
    if (CB_PARAM_COLLISION(3) != 1008)           return 252;   // alias retry must preserve parameter name

    // Alias to extern data must share the TARGET's storage: a write through one name is
    // visible through the other (a freshly created global would read 0, not 4243/1005).
    c_global_counter = 4243;
    if (CB_ALIAS_COUNTER != 4243)                return 246;
    CB_ALIAS_COUNTER = 1005;
    if (c_global_counter != 1005)                return 247;

    // Accept-set (identical before and after). 248 pins that an alias-SHAPED body which
    // still folds keeps its constant (the fold path wins); it cannot distinguish fold from
    // alias, since aliasing a constant lands on the same global. 249 is the discriminating
    // one: a real declaration wins over a colliding alias macro.
    // `#define c_alias_victim c_negate` has that function's exact arity, so an alias that
    // did NOT lose to the real declaration would be a live overload candidate here. This is
    // the ONLY call to c_alias_victim in the file, so no earlier leg can absorb the failure.
    if (CB_ALIAS_CONST != 100)                   return 248;
    if (c_alias_victim(5) != 50)                 return 249;

    // Accept-set: these same-header and reverse-order values are identical PRE/POST. They keep
    // existing replacement and reverse-order behavior alive; the late-target legs below are the
    // discriminators for this follow-up.
    if (CAA_GetObject(7) != 407)                 return 253;
    if (CAA_GetReverse(7) != 507)                return 254;
    if (CAA_GetGroup(7) != 807)                  return 255;
    if (CAA_GetGroupRealFirst(7) != 1007)        return 256;

    expect_error("'CAA_GetObject' is a function used as a value") {
        int bad = CAA_GetObject;
    }
    expect_error("Undefined variable CB_ALIAS_CFLAT_TARGET.") {
        int badCFlatAlias = CB_ALIAS_CFLAT_TARGET(1);
    }

    // These aliases are declared before their targets in later separate imports. They are
    // the discriminating late-target legs: PRE reports an undefined alias at each call.
    if (CAA_LateAlias(7) != 1307)                return 257;
    if (CAA_LateChainA(7) != 1407)              return 258;
    // The grouped target order is an accept-set leg: both declarations arrive in one extraction.
    if (CAA_GroupLateAlias(7) != 1507)           return 259;
    // The later target uses a different parameter signature and must still be retried.
    if (CAA_DiffAlias(7.5) != 1607)              return 260;

    // ---- Section M: C++ interop (270-289) ------------------------------------
    // Namespaced call under the dotted CFlat spelling, bound to the Itanium/MSVC
    // mangled symbol. The double overload adds 1000, so the return value alone
    // proves WHICH overload was selected.
    if (cppi.add(40, 2) != 42)                   return 270;
    if (cppi.add(40.5, 2.0) != 1042)             return 271;

    // Nested namespace: every '::' prefix registers as a CFlat namespace.
    if (cppi.inner.twice(21) != 42)              return 272;

    // extern "C" inside a C++ translation unit keeps its bare linkage name and is
    // callable without a namespace qualifier.
    if (cppi_c_linkage(37) != 42)                return 273;

    // Reference parameter: spelled as a pointer on the CFlat side, so the call site
    // passes the address of a local explicitly. pick_ref writes 7 and returns the old
    // value, which makes the MUTATION observable, not just the argument transfer.
    int cppiRef = 5;
    if (cppi.pick_ref(&cppiRef) != 5)            return 274;
    if (cppiRef != 7)                            return 275;

    // const reference read: same pointer shape, no write-back.
    int cppiCRef = 41;
    if (cppi.read_cref(&cppiCRef) != 42)         return 276;
    if (cppiCRef != 41)                          return 277;

    // Reference RETURN arrives as an alias to the C++ side's storage.
    alias int cppiSlot = cppi.ref_slot();
    if (cppiSlot != 99)                          return 278;
    cppiSlot = 5;
    alias int cppiSlot2 = cppi.ref_slot();
    if (cppiSlot2 != 5)                          return 279;

    // Plain pointer parameter and return (no reference decay involved).
    int cppiVal = 9;
    int* cppiIdent = cppi.ptr_ident(&cppiVal);
    if (*cppiIdent != 9)                         return 280;

    // Widening: 'long long' return must keep all 64 bits, not truncate to i32.
    if (cppi.widen(3) != 3000000000)             return 281;
    if (cppi.widen(-3) != -3000000000)           return 282;

    // Narrow unsigned round trip: 'unsigned char' maps to u8 on both legs.
    if ((int)cppi.uc((u8)200) != 201)            return 283;
    if ((int)cppi.uc((u8)0) != 1)                return 284;

    // A scoped enum ('enum class Mode : int') parameter decays to int like a C enum,
    // so the declaration is published rather than skipped as an unsupported type.
    if (cppi.mode_value(1) != 10)                return 285;
    if (cppi.mode_value(0) != 0)                 return 286;

    if (cppi.wchar_roundtrip((i32)0x263a) != 0x263a) return 288;
    if (cppi.char16_roundtrip((u16)0x263a) != 0x263a) return 289;
    if (cppi.char32_roundtrip((u32)0x1f642) != 0x1f642) return 323;
    if (cppi.small8_value(cppi.Small8.Value) != 200) return 324;
    if (cppi.small8_roundtrip(cppi.Small8.Value) != cppi.Small8.Value) return 325;
    if (sizeof(cppi.Small8Holder) != 2)       return 326;
    if (alignof(cppi.Small8Holder) != 1)      return 327;
    if (cppi.Dir.Left != 1 || cppi.dir_value(cppi.Dir.Left) != 1) return 328;

    cppi.Outer.Inner m1inner = default;
    m1inner.value = 21;
    if (m1inner.twice() != 42)                 return 329;
    cppi.Outer.store = 7;
    if (cppi.Outer.store != 7)                 return 630;
    if (cppi.read_outer_store() != 7)          return 631;
    cppi.Outer.store = 11;
    if (cppi.read_outer_store() != 11)         return 632;
    if (cppi.Outer.store != 11)                return 633;
    if (cppi.Outer.Kind.A != 3)                return 619;
    cppi.Number m1number = default;
    m1number.i = 42;
    if (cppi.use_number(&m1number) != 42)      return 621;
    cppi.AnonymousUnion m1anon = default;
    m1anon.__anon0.i = 9;
    if (m1anon.__anon0.i != 9)                 return 622;
    cppi.Bits m1bits = default;
    m1bits.a = 3; m1bits.b = 4;
    if (cppi.use_bits(&m1bits) != 34)          return 623;
    cppi.ArrayHolder m1array = default;
    m1array.arr[0] = 1; m1array.arr[1] = 2; m1array.arr[2] = 3; m1array.arr[3] = 4;
    if (cppi.use_array(&m1array) != 10)        return 624;

    cppi.Buf<int, 4> m1buf = default;
    if (m1buf.cap() != 4)                       return 625;
    cppi.Buf<int, cppi.Dir.Right> m1enumBuf = default;
    if (m1enumBuf.cap() != 2)                   return 631;

    if (cppi.scaled_default(10) != 30)          return 632;
    if (cppi.scaled_default(10, 4) != 40)       return 633;
    if (cppi.default_double_ptr() != 25)        return 634;
    int m1defaultMarker = 7;
    if (cppi.default_double_ptr(3.0, &m1defaultMarker) != 37) return 635;
    cppi.Point m1defaultPoint = default;
    m1defaultPoint.x = 2; m1defaultPoint.y = 3;
    if (m1defaultPoint.mode_scaled() != 5)      return 636;



    cppi.IntArray4 m1arrayTemplate = default;
    m1arrayTemplate[0] = 8; m1arrayTemplate[1] = 9;
    if (m1arrayTemplate.size() != 4 || m1arrayTemplate[0] + m1arrayTemplate[1] != 17) return 626;

    // A record is reachable by POINTER. Passing one BY VALUE is legal when the C++ type is
    // trivially copyable (below); a NONTRIVIAL one is refused - see
    // Test/errors/err_cpp_record_by_value.cb.
    cppi.Pair m3pair = default;
    m3pair.a = 40; m3pair.b = 2;
    if (cppi.read_pair(&m3pair) != 42)           return 287;

    // ---- Section M3: trivially copyable records by value (290-319) -------------
    // Layout first. sizeof/alignof come back from the C++ side as functions, so any
    // disagreement between clang's layout and cflat's is a hard failure here rather than
    // a silent register mismatch inside the calls below.
    if (sizeof(cppi.Small)   != cppi.size_of(0))  return 290;
    if (alignof(cppi.Small)  != cppi.align_of(0)) return 291;
    if (sizeof(cppi.Mixed)   != cppi.size_of(1))  return 292;
    if (alignof(cppi.Mixed)  != cppi.align_of(1)) return 293;
    if (sizeof(cppi.Large)   != cppi.size_of(2))  return 294;
    if (alignof(cppi.Large)  != cppi.align_of(2)) return 295;
    if (sizeof(cppi.Hfa)     != cppi.size_of(3))  return 296;
    if (alignof(cppi.Hfa)    != cppi.align_of(3)) return 297;
    if (sizeof(cppi.Packed)  != cppi.size_of(4))  return 298;
    if (alignof(cppi.Packed) != cppi.align_of(4)) return 299;
    if (sizeof(cppi.Aligned) != cppi.size_of(5))  return 300;
    if (alignof(cppi.Aligned)!= cppi.align_of(5)) return 301;
    if (sizeof(cppi.Pair)    != cppi.size_of(6))  return 302;
    // The packed record is the sharpest layout check: 5 bytes, alignment 1.
    if (sizeof(cppi.Packed) != 5)                 return 303;
    if (alignof(cppi.Packed) != 1)                return 304;
    if (sizeof(cppi.Aligned) != 32)               return 305;

    // Two bytes, coerced into ONE register wider than the record itself.
    cppi.Small m3small = default;
    m3small.a = -5; m3small.b = (u8)200;
    cppi.Small m3smallOut = cppi.small_bump(m3small);
    if ((int)m3smallOut.a != -4)                  return 306;
    if ((int)m3smallOut.b != 201)                 return 307;

    // 16 bytes of mixed FP/integer: two 8-byte chunks, NOT an HFA.
    cppi.Mixed m3mixed = default;
    m3mixed.d = 2.5; m3mixed.i = 41;
    cppi.Mixed m3mixedOut = cppi.mixed_bump(m3mixed);
    if (!near(m3mixedOut.d, 3.5, 1e-12))          return 308;
    if (m3mixedOut.i != 42)                       return 309;

    // 24 bytes: indirect in, hidden sret out.
    cppi.Large m3large = default;
    m3large.x = 10; m3large.y = 20; m3large.z = 30;
    cppi.Large m3largeOut = cppi.large_bump(m3large);
    if (m3largeOut.x != 11)                       return 310;
    if (m3largeOut.y != 21)                       return 311;
    if (m3largeOut.z != 31)                       return 312;

    // Homogeneous float aggregate: four separate float registers under AAPCS64.
    cppi.Hfa m3hfa = default;
    m3hfa.a = 1.0f; m3hfa.b = 2.0f; m3hfa.c = 3.0f; m3hfa.d = 4.0f;
    cppi.Hfa m3hfaOut = cppi.hfa_bump(m3hfa);
    if (!near((double)m3hfaOut.a, 2.0, 1e-6))     return 313;
    if (!near((double)m3hfaOut.b, 3.0, 1e-6))     return 314;
    if (!near((double)m3hfaOut.c, 4.0, 1e-6))     return 315;
    if (!near((double)m3hfaOut.d, 5.0, 1e-6))     return 316;

    // Packed: the coercion must read exactly 5 bytes with 'n' at byte offset 1.
    cppi.Packed m3packed = default;
    m3packed.c = (u8)7; m3packed.n = 1000;
    cppi.Packed m3packedOut = cppi.packed_bump(m3packed);
    if ((int)m3packedOut.c != 8)                  return 317;
    if (m3packedOut.n != 1001)                    return 318;

    // Over-aligned: indirect both ways, with a 32-byte-aligned temp and sret slot.
    cppi.Aligned m3aligned = default;
    m3aligned.x = 100; m3aligned.y = 200;
    cppi.Aligned m3alignedOut = cppi.aligned_bump(m3aligned);
    if (m3alignedOut.x != 101)                    return 319;
    if (m3alignedOut.y != 201)                    return 320;

    // A scalar WEDGED between two aggregates whose slots consume different register counts:
    // s -> one coerced register, k -> one integer register, l -> one hidden pointer.
    if (cppi.mixed_args(m3small, 3, m3large) != -2999640) return 321;

    // By-value and by-pointer records in the same signature.
    if (cppi.pair_and_small(&m3pair, m3small) != 237) return 322;

    // ---- Section M4: C++ class members (330-349) --------------------------------
    // A trivially copyable class carries no lifetime obligations, so these checks isolate
    // member binding: 'this' passing, argument marshalling, static members, and the
    // const-overload ruling.
    cppi.Point m4p = default;
    m4p.x = 3; m4p.y = 4;

    // const instance method: 'this' is the receiver's address, result comes back in a register.
    if (m4p.sum() != 7)                          return 330;

    // Mutating instance method: the write must land in the CALLER's storage, not a copy.
    m4p.bump(2);
    if (m4p.x != 5)                              return 331;
    if (m4p.y != 6)                              return 332;
    if (m4p.sum() != 11)                         return 333;

    // Two arguments after 'this'.
    if (m4p.scaled(2, 1) != 23)                  return 334;
    char* m4out = nullptr;
    m4p.set_out(m4out);
    if (m4out == nullptr || strcmp(m4out, "set-out") != 0) return 344;

    // const/non-const overload pair on an LVALUE receiver: the RULING says the NON-const leg
    // wins, and it is the leg that returns 1.
    if (m4p.probe() != 1)                        return 335;

    // Static method: no receiver, called through the dotted type name.
    if (cppi.Point.origin_sum() != 0)            return 336;

    // Static data member READ. bump() incremented it exactly once above.
    if (cppi.Point.s_calls != 1)                 return 337;
    m4p.bump(0);
    if (cppi.Point.s_calls != 2)                 return 338;

    // Same dispatch through a POINTER receiver.
    cppi.Point* m4q = &m4p;
    if (m4q.sum() != 11)                         return 339;
    m4q.bump(1);
    if (m4p.x != 6)                              return 340;

    // A public method that reads a PRIVATE field is fine; naming the field is not - see
    // Test/errors/err_cpp_private_member.cb.
    if (m4p.hidden() != 0)                       return 341;

    // A scoped enum nested in a namespace is also published under its QUALIFIED C++ spelling,
    // so the enumerator can be written the way C++ writes it instead of as a bare integer.
    if (cppi.Mode.On != 1)                       return 342;
    if (cppi.mode_value(cppi.Mode.On) != 10)     return 343;

    // ---- Section M5: nontrivial C++ class lifetime (350-399) ---------------------
    // cppi.Tracked increments an exported counter in every special member, so each check below
    // is an EXACT count: one extra copy, one missed destructor, or a double destruction fails.

    // Simple scope: one construction, one destruction, nothing else.
    cppi.reset_counts();
    {
        cppi.Tracked t = cppi.Tracked(5);
        if (t.value() != 5)                      return 350;
        if (cppi.dtor_count() != 0)              return 351;
    }
    if (cppi.ctor_count() != 1)                  return 352;
    if (cppi.copy_count() != 0)                  return 353;
    if (cppi.move_count() != 0)                  return 354;
    if (cppi.dtor_count() != 1)                  return 355;

    // Nested scopes: the inner object dies at the inner brace, the outer one at the outer brace.
    cppi.reset_counts();
    {
        cppi.Tracked outer = cppi.Tracked(1);
        {
            cppi.Tracked inner = cppi.Tracked(2);
            if (inner.value() != 2)              return 356;
            if (cppi.dtor_count() != 0)          return 357;
        }
        if (cppi.dtor_count() != 1)              return 358;
        if (outer.value() != 1)                  return 359;
    }
    if (cppi.ctor_count() != 2)                  return 360;
    if (cppi.dtor_count() != 2)                  return 361;

    // Early return out of a helper that holds one.
    cppi.reset_counts();
    if (m5_early_return(4) != 4)                 return 362;
    if (cppi.ctor_count() != 1)                  return 363;
    if (cppi.dtor_count() != 1)                  return 364;

    // break: three iterations ran, three objects were destroyed (including the one live at break).
    cppi.reset_counts();
    for (int m5i = 0; m5i < 5; m5i++)
    {
        cppi.Tracked t = cppi.Tracked(m5i);
        if (t.value() != m5i)                    return 365;
        if (m5i == 2) break;
    }
    if (cppi.ctor_count() != 3)                  return 366;
    if (cppi.dtor_count() != 3)                  return 367;

    // continue: the object is destroyed on the continue edge as well as the fall-through edge.
    cppi.reset_counts();
    for (int m5j = 0; m5j < 4; m5j++)
    {
        cppi.Tracked t = cppi.Tracked(m5j);
        if (m5j % 2 == 0) continue;
        if (t.value() != m5j)                    return 368;
    }
    if (cppi.ctor_count() != 4)                  return 369;
    if (cppi.dtor_count() != 4)                  return 370;

    // Copy construction from a T lvalue: exactly one copy, no move, both objects destroyed.
    cppi.reset_counts();
    {
        cppi.Tracked src = cppi.Tracked(11);
        cppi.Tracked dst = src;
        if (dst.value() != 11)                   return 371;
        if (src.value() != 11)                   return 372;
    }
    if (cppi.ctor_count() != 1)                  return 373;
    if (cppi.copy_count() != 1)                  return 374;
    if (cppi.move_count() != 0)                  return 375;
    if (cppi.dtor_count() != 2)                  return 376;

    // Move construction: the source is compile-time consumed (reading it is an error - see
    // Test/errors/err_cpp_use_after_move.cb) but STILL destroyed, so BOTH objects are destroyed.
    cppi.reset_counts();
    {
        cppi.Tracked from = cppi.Tracked(12);
        cppi.Tracked to = move from;
        if (to.value() != 12)                    return 377;
    }
    if (cppi.move_count() != 1)                  return 378;
    if (cppi.copy_count() != 0)                  return 379;
    if (cppi.dtor_count() != 2)                  return 380;

    // Copy assignment over a LIVE object: the C++ operator runs, never a byte store.
    cppi.reset_counts();
    {
        cppi.Tracked a = cppi.Tracked(1);
        cppi.Tracked b = cppi.Tracked(2);
        b = a;
        if (b.value() != 1)                      return 381;
        if (cppi.copy_assign_count() != 1)       return 382;
        if (cppi.copy_count() != 0)              return 383;
    }
    if (cppi.dtor_count() != 2)                  return 384;

    // Move assignment consumes the source and leaves it destructible.
    cppi.reset_counts();
    {
        cppi.Tracked a = cppi.Tracked(3);
        cppi.Tracked b = cppi.Tracked(4);
        b = move a;
        if (b.value() != 3)                      return 385;
        if (cppi.move_assign_count() != 1)       return 386;
    }
    if (cppi.dtor_count() != 2)                  return 387;

    // By-value ARGUMENT: the caller copy-constructs a temp, the callee reads it, the temp is
    // destroyed - so one copy and two destructions in total.
    cppi.reset_counts();
    {
        cppi.Tracked a = cppi.Tracked(6);
        if (cppi.take_tracked(a) != 6)           return 388;
    }
    if (cppi.copy_count() != 1)                  return 389;
    if (cppi.move_count() != 0)                  return 390;
    if (cppi.dtor_count() != 2)                  return 391;

    // By-value argument written `move x`: move-construction instead of a copy.
    cppi.reset_counts();
    {
        cppi.Tracked a = cppi.Tracked(7);
        if (cppi.take_moved(move a) != 70)       return 392;
    }
    if (cppi.move_count() != 1)                  return 393;
    if (cppi.copy_count() != 0)                  return 394;
    if (cppi.dtor_count() != 2)                  return 395;

    // By-value RETURN into a local: constructed straight into the declared slot through the sret
    // pointer, so there is NO copy and NO move at all - one construction, one destruction.
    cppi.reset_counts();
    {
        cppi.Tracked r = cppi.make_tracked(9);
        if (r.value() != 9)                      return 396;
    }
    if (cppi.ctor_count() != 1)                  return 397;
    if (cppi.copy_count() != 0)                  return 398;
    if (cppi.move_count() != 0)                  return 399;
    if (cppi.dtor_count() != 1)                  return 400;

    // new / delete through the C++ global operators, never CFlat's allocator.
    cppi.reset_counts();
    cppi.Tracked* m5p = new cppi.Tracked(13);
    if (m5p.value() != 13)                       return 401;
    if (cppi.ctor_count() != 1)                  return 402;
    if (cppi.dtor_count() != 0)                  return 403;
    delete m5p;
    if (cppi.dtor_count() != 1)                  return 404;

    // `unique T*` composes: scope exit destroys AND frees through the same C++ operator pair.
    cppi.reset_counts();
    {
        unique cppi.Tracked* m5q = new cppi.Tracked(14);
        if (m5q.value() != 14)                   return 405;
        if (cppi.dtor_count() != 0)              return 406;
    }
    if (cppi.ctor_count() != 1)                  return 407;
    if (cppi.dtor_count() != 1)                  return 408;

    // A nontrivial result nobody declares a slot for is a TEMPORARY: it is still destroyed, once,
    // at the end of the full expression.
    cppi.reset_counts();
    _ = cppi.make_tracked(16);
    if (cppi.ctor_count() != 1)                  return 411;
    if (cppi.dtor_count() != 1)                  return 412;

    // `_ = move x` releases NOW and must not destroy a second time at scope exit.
    cppi.reset_counts();
    {
        cppi.Tracked a = cppi.Tracked(15);
        _ = move a;
        if (cppi.dtor_count() != 1)              return 409;
    }
    if (cppi.dtor_count() != 1)                  return 410;

    // ---- Section M6: C++ inheritance and virtual dispatch (420-459) ---------------
    // Every offset and vtable slot below is clang's own answer, cross-checked against
    // `clang++ -S -emit-llvm -O0` for the same calls: Shape::area is vtable slot 2, the deleting
    // destructor is slot 1, and Right sits at byte 16 of Both.

    // Layout: a polymorphic class is a REAL type whose size matches C++ exactly.
    if (sizeof(cpppoly.Shape) != 16)             return 420;
    if (sizeof(cpppoly.Circle) != 16)            return 421;
    if (sizeof(cpppoly.Right) != 16)             return 422;
    if (sizeof(cpppoly.Both) != 32)              return 423;

    // Object built in C++: virtual dispatch through a BASE pointer picks the derived override,
    // the non-virtual method still binds directly, and the inherited field reads through.
    cpppoly.reset_poly_counts();
    cpppoly.Shape* m6c = cpppoly.make(0);        // a Circle
    if (m6c.area() != 50)                        return 424;   // Circle::area, radius 5
    if (m6c.plain() != 102)                      return 425;   // Shape::plain, non-virtual
    if (m6c.tag != 2)                            return 426;   // Circle's ctor set tag = 2
    // `delete` through the base pointer takes the vtable's DELETING destructor, so the DERIVED
    // destructor chain runs - Circle's, then Shape's - and the storage goes back to C++.
    delete m6c;
    if (cpppoly.circle_dtors() != 1)             return 427;
    if (cpppoly.shape_dtors() != 1)              return 428;
    if (cpppoly.square_dtors() != 0)             return 429;

    cpppoly.Shape* m6s = cpppoly.make(1);        // a Square
    if (m6s.area() != 49)                        return 430;   // Square::area, side 7
    cpppoly.destroy(m6s);                        // released on the C++ side
    if (cpppoly.square_dtors() != 1)             return 431;

    // Object constructed BY CFLAT on the stack: the C++ constructor writes the vptr, so the same
    // virtual dispatch works, and scope exit runs the derived destructor.
    cpppoly.reset_poly_counts();
    {
        cpppoly.Circle m6stack = default;
        if (m6stack.radius != 5)                 return 432;
        if (m6stack.tag != 2)                    return 433;
        // Shape::plain is INHERITED: it is registered on Circle too, with `this` retyped.
        if (m6stack.plain() != 102)              return 452;
        if (m6stack.area() != 50)                return 453;   // Circle's own override, direct
        cpppoly.Shape* m6base = &m6stack;
        if (m6base.area() != 50)                 return 434;
        if (m6base.tag != 2)                     return 435;
    }
    if (cpppoly.circle_dtors() != 1)             return 436;
    if (cpppoly.shape_dtors() != 1)              return 437;

    // Object constructed BY CFLAT on the heap, then released through a BASE pointer.
    cpppoly.reset_poly_counts();
    cpppoly.Square* m6heap = new cpppoly.Square();
    if (m6heap.area() != 49)                     return 438;
    cpppoly.Shape* m6heapBase = move m6heap;
    if (m6heapBase.area() != 49)                 return 439;
    delete m6heapBase;
    if (cpppoly.square_dtors() != 1)             return 440;
    if (cpppoly.shape_dtors() != 1)              return 441;

    // MULTIPLE inheritance. Right is the NON-PRIMARY base of Both, at byte 16, so every
    // Both -> Right crossing must add 16; reading rv is what proves it happened.
    cpppoly.Both m6b = default;
    if (m6b.lv != 33)                            return 442;   // inherited from Left
    if (m6b.rv != 44)                            return 443;   // inherited from Right
    if (m6b.both_only() != 77)                   return 444;
    if (m6b.l() != 1033)                         return 445;   // Both::l overrides Left::l
    if (m6b.r() != 2044)                         return 446;   // Both::r overrides Right::r
    // C++ side takes a Right* and reads rv: wrong adjustment would hand it Left's storage.
    if (cpppoly.read_right(&m6b) != 44)          return 447;
    // C++ side dispatches virtually on that same adjusted pointer and lands on Both::r.
    if (cpppoly.call_right(&m6b) != 2044)        return 448;
    // The adjustment also happens on a STORE, so a saved base pointer is already correct.
    cpppoly.Right* m6r = &m6b;
    if (cpppoly.read_right(m6r) != 44)           return 449;
    if (m6r.rv != 44)                            return 450;
    if (m6r.r() != 2044)                         return 451;   // virtual, through Right's vtable
    // An override of a NON-PRIMARY base virtual, reached through a DERIVED pointer: the slot
    // must come from Both's own vtable (unadjusted this), not from Right's.
    cpppoly.Both* m6bp = &m6b;
    if (m6bp.r() != 2044)                        return 452;
    if (m6bp.l() != 1033)                        return 453;
    if (m6bp.both_only() != 77)                  return 454;

    // ---- Section M6b: class names containing a declarator keyword (452-459) ---------
    // "constant" contains "const" and "classBase" contains "class". Both are NON-PRIMARY bases
    // of QualNames, so a lost class identity shows up as a missing base adjustment.
    cpppoly.QualNames* m6q = cpppoly.make_qual();
    if (cpppoly.read_constant(m6q) != 66)        return 455;
    if (cpppoly.read_class_base(m6q) != 77)      return 456;
    if (m6q.cv != 66)                            return 457;
    if (m6q.bv != 77)                            return 458;
    if (m6q.l() != 3055)                         return 459;   // override of Left::l
    cpppoly.destroy_qual(m6q);

    // ---- Section M7: header-only C++ (definition emission) (460-479) ----------------
    // Inline free function, and one that calls another inline function: 5*3 + 5*3 = 30.
    if (cppinl.helper(5) != 15)                  return 460;
    if (cppinl.twice(5) != 30)                   return 461;
    // Static local inside an inline body: the guard variable and the slot are emitted too.
    if (cppinl.next_id() != 101)                 return 462;
    if (cppinl.next_id() != 102)                 return 463;
    // Same inline code reached through the SECOND import group: one linked definition, so the
    // static local above keeps counting rather than starting over.
    if (cppinl2.twice_plus(5) != 31)             return 464;
    if (cppinl.next_id() != 103)                 return 465;

    // All-inline nontrivial class. The counters are inline static data members, so reading them
    // proves the companion module supplied their storage as well as the constructor body.
    cppinl.Box.reset();
    {
        cppinl.Box m7b = cppinl.Box(4);
        m7b.add(6);
        if (m7b.get() != 10)                     return 466;
        if (m7b.scaled() != 30)                  return 467;   // inline method calling an inline fn
        if (cppinl.Box.ctors != 1)               return 468;
        if (cppinl.Box.dtors != 0)               return 469;
    }
    if (cppinl.Box.dtors != 1)                   return 470;    // destructor ran exactly once

    // All-inline VIRTUAL hierarchy: no key function exists anywhere, so the vtable itself comes
    // from the companion module. Dispatch through a base pointer is the assertion.
    cppinl.Base.reset_dtors();
    {
        cppinl.Derived m7d = cppinl.Derived(5);
        if (m7d.area() != 25)                    return 471;    // own override, direct call
        if (m7d.plain() != 3)                    return 472;    // inherited inline method
        cppinl.Base* m7base = &m7d;
        if (m7base.area() != 25)                 return 473;    // virtual, through the vtable
        if (m7base.tag_ != 2)                    return 474;    // base field set by Base's ctor
    }
    if (cppinl.Base.derived_dtors != 1)          return 475;
    if (cppinl.Base.base_dtors != 1)             return 476;

    // Heap object released through a BASE pointer: the deleting destructor slot of an emitted
    // vtable, so the derived destructor chain runs.
    cppinl.Base.reset_dtors();
    cppinl.Derived* m7heap = new cppinl.Derived(3);
    cppinl.Base* m7heapBase = move m7heap;
    if (m7heapBase.area() != 9)                  return 477;
    delete m7heapBase;
    if (cppinl.Base.derived_dtors != 1)          return 478;
    if (cppinl.Base.base_dtors != 1)             return 479;

    // ---- Section M8: C++ class templates instantiated from CFlat (480-499) ----------
    // One header-only pattern, two specializations. Nothing below exists as a symbol until
    // these declarations ask for it.
    cppt.box_int_reset();
    {
        cppt.Box<int> m8b = cppt.Box<int>(7);
        if (m8b.get() != 7)                      return 480;   // constructor taking T
        if (cppt.box_int_live() != 1)            return 481;   // per-specialization static counter
        if (cppt.box_int_ctors() != 1)           return 482;
        m8b.set(9);
        if (m8b.get() != 9)                      return 483;   // mutating method taking T
        if (m8b[0] != 9)                         return 484;   // operator[] via the index expression
        cppt.Box<int> m8b2 = cppt.Box<int>(9);
        if (!(m8b == m8b2))                      return 485;   // operator== via the overload table
        cppt.Box<int> m8b3 = cppt.Box<int>(4);
        if (m8b == m8b3)                         return 486;
        if (cppt.box_int_live() != 3)            return 487;
    }
    if (cppt.box_int_live() != 0)                return 488;   // all three destroyed exactly once
    if (cppt.box_int_dtors() != 3)               return 489;

    // A SECOND specialization of the same pattern: its own instantiation, its own counter.
    {
        cppt.Box<double> m8d = cppt.Box<double>(2.5);
        if (m8d.get() != 2.5)                    return 490;
        if (m8d[0] != 2.5)                       return 491;
        if (cppt.box_double_live() != 1)         return 492;
        if (cppt.box_int_live() != 0)            return 493;   // counters are per specialization
    }
    if (cppt.box_double_live() != 0)             return 494;

    // The same specialization named in another function: one registration, one linked symbol.
    if (m8_second_use(5) != 10)                  return 495;
    if (cppt.box_int_live() != 0)                return 496;

    // A specialization over a NONTRIVIAL C++ class whose destructor is DEFAULTED: there is no
    // body in the header, so the instantiation has to make clang define and emit it, and it has
    // to destroy the Tracked member.
    cppi.reset_counts();
    {
        cppt.Holder<cppi.Tracked> m8h = cppt.Holder<cppi.Tracked>(4);
        if (m8h.value() != 4)                    return 497;
        if (cppi.ctor_count() != 1)              return 498;
        if (cppi.dtor_count() != 0)              return 499;
    }
    if (cppi.dtor_count() != 1)                  return 480 + 20;   // 500 - defaulted dtor ran

    // ---- Section M9: libc++ through the same path (500-529) -------------------------
    // std.vector<int>: default construction, push_back, size through the size_t mapping,
    // element read as an rvalue, element write as an lvalue, and clear.
    {
        std.vector<int> m9v = default;
        m9v.push_back(3);
        m9v.push_back(4);
        if ((int)m9v.size() != 2)                return 501;
        int m9x = m9v[0];
        if (m9x != 3)                            return 502;
        if (m9v[1] != 4)                         return 503;
