import "test_helper.cb";
import "list.cb";
import "dictionary.cb";
import "tuple.cb";

// =============================================================
// Generic struct tests (compile-time only monomorphization)
// =============================================================

// Generic-function registration and type-argument coverage.
int forwardFunctionCaller() { return forwardFunction<int>(4); }
T forwardFunction<T>(T value) { return value + 1; }

T closureIdentity<T>(T value) { return value; }
T countPack<T...>() { return (T)sizeof(T); }
int zeroValueGeneric<T>() { T value = default; return 7; }
int doubleValue(int x) { return x * 2; }

interface FunctionBase<T> { T Get(); };
interface FunctionDerived<T> : FunctionBase<T> { void Set(T value); };
class FunctionImpl<T> : FunctionDerived<T>
{
    T value = default;
    T Get() { return value; }
    void Set(T v) { value = v; }
};

bool testGenericFunctions()
{
    bool result = true;
    result &= Test("generic_function_forward", forwardFunctionCaller(), 5);
    function<int(int)> source = doubleValue;
    function<int(int)> closureResult = closureIdentity<function<int(int)>>(source);
    result &= Test("generic_function_closure_arg", closureResult(6), 12);
    result &= Test("generic_function_pack", countPack<int, int, int>(), 3);
    FunctionImpl<int> impl = default;
    impl.Set(9);
    result &= Test("generic_interface_parent", impl.Get(), 9);
    return result;
}

struct Box<T>
{
    T value = default;
};

struct Pair<K, V>
{
    K first = default;
    V second = default;
};

struct Container<T>
{
    T data = default;
    int count = 0;
};

struct Stack<T>
{
    T elements = default;
    int size = 0;
};

bool testGenericSizeof()
{
    bool result = true;
    result &= Test("sizeof_generic_struct", (int)sizeof(Box<int>), 4);
    result &= Test("sizeof_generic_interface", (int)sizeof(FunctionBase<int>), 16);
    result &= Test("sizeof_generic_class", (int)sizeof(FunctionImpl<int>), 4);
    return result;
}

bool testGenericBox()
{
    bool result = true;

    // Test Box<int>
    Box<int> intBox = default;
    intBox.value = 42;
    result &= Test("generic_box_int", intBox.value, 42);

    // Test Box<float> - compare as int representation
    Box<float> floatBox = default;
    floatBox.value = 3.14f;
    // Note: floating point comparison would need special handling

    // Test Box<i32>
    Box<i32> i32Box = default;
    i32Box.value = 100;
    result &= Test("generic_box_i32", i32Box.value, 100);
    result &= Test("generic_zero_value_parameters", zeroValueGeneric<Box<int>>(), 7);

    return result;
}

bool testGenericPair()
{
    bool result = true;

    // Test Pair<int, int>
    Pair<int, int> intIntPair = default;
    intIntPair.first = 10;
    intIntPair.second = 20;
    result &= Test("generic_pair_int_int_first", intIntPair.first, 10);
    result &= Test("generic_pair_int_int_second", intIntPair.second, 20);

    // Test Pair<int, float>
    Pair<int, float> intFloatPair = default;
    intFloatPair.first = 5;
    intFloatPair.second = 2.5f;
    result &= Test("generic_pair_int_float_first", intFloatPair.first, 5);

    // Test Pair<i32, i32>
    Pair<i32, i32> i32Pair = default;
    i32Pair.first = 1000;
    i32Pair.second = 2000;
    result &= Test("generic_pair_i32_first", i32Pair.first, 1000);
    result &= Test("generic_pair_i32_second", i32Pair.second, 2000);

    return result;
}

bool testGenericMultipleInstantiations()
{
    bool result = true;

    // Multiple instantiations of Box with different types
    Box<int> boxInt = default;
    Box<i32> boxI32 = default;
    Box<u32> boxU32 = default;
    Box<i8> boxI8 = default;

    boxInt.value = 42;
    boxI32.value = 100;
    boxU32.value = 200;
    boxI8.value = 10;

    result &= Test("generic_multi_int", boxInt.value, 42);
    result &= Test("generic_multi_i32", boxI32.value, 100);
    result &= Test("generic_multi_u32", boxU32.value, 200);
    result &= Test("generic_multi_i8", boxI8.value, 10);

    return result;
}

bool testGenericContainer()
{
    bool result = true;

    // Test Container<int>
    Container<int> intContainer = default;
    intContainer.data = 99;
    intContainer.count = 1;
    result &= Test("generic_container_int_data", intContainer.data, 99);
    result &= Test("generic_container_int_count", intContainer.count, 1);

    // Test Container<i64>
    Container<i64> i64Container = default;
    i64Container.data = 200000;
    i64Container.count = 5;
    result &= Test("generic_container_i64_data", i64Container.data, 200000);
    result &= Test("generic_container_i64_count", i64Container.count, 5);

    return result;
}

bool testGenericStack()
{
    bool result = true;

    // Test Stack<int>
    Stack<int> intStack = default;
    intStack.elements = 42;
    intStack.size = 1;
    result &= Test("generic_stack_int_elements", intStack.elements, 42);
    result &= Test("generic_stack_int_size", intStack.size, 1);

    // Test Stack<i32>
    Stack<i32> i32Stack = default;
    i32Stack.elements = 999;
    i32Stack.size = 10;
    result &= Test("generic_stack_i32_elements", i32Stack.elements, 999);
    result &= Test("generic_stack_i32_size", i32Stack.size, 10);

    return result;
}

int testGenericStructs()
{
    bool result = true;
    result &= testGenericBox();
    result &= testGenericPair();
    result &= testGenericMultipleInstantiations();
    result &= testGenericContainer();
    result &= testGenericStack();
    return result;
}

// Interface tests

interface IReadable
{
    int Read();
};

interface IScalable
{
    int Scale(int factor);
};

class Counter : IReadable
{
    int count = 10;
    int Read() { return count; }
};

class ScaledValue : IReadable, IScalable
{
    int value = 3;
    int Read() { return value; }
    int Scale(int factor) { return value * factor; }
};

int extensionIRead(IReadable scaledValue)
{
    return scaledValue.Read();
}

bool testInterface()
{
    bool result = true;
    Counter c = Counter();
    ScaledValue s = ScaledValue();

    result &= Test("counter.Read", c.Read(), 10);   // 10
    result &= Test("scaledValue.Read", s.Read(), 3);   // 3
    result &= Test("scaledValue.Read", s.extensionIRead(), 3);   // 3
    result &= Test("scaledValue.Scale2", s.Scale(2), 6);   // 3*2=6
    result &= Test("scaledValue.Scale5", s.Scale(5), 15);   // 3*5=15
    return result;
}


// Generic interface for storing and retrieving a value
interface IContainer<T>
{
    T Get();
    void Set(T value);
};

struct MyInt
{
    int x = 5;
};

// Generic struct template with type parameter T implementing Container<T>
class Storage<T> : IContainer<T>
{
    T data = default;

    T Get()
    {
        return data;
    }

    void Set(T value)
    {
        data = value;
    }
};

T ExtGet<T>(IContainer<T> container)
{
    T value = container.Get();
    return value;
}

bool testGenericInterface()
{
    bool result = true;

    // Test Storage<int> implementing Container<int>
    Storage<int> intStorage = default;
    intStorage.Set(42);
    result &= Test("generic_interface_int_get", intStorage.Get(), 42);
    result &= Test("generic_interface_int_getExt", intStorage.ExtGet(), 42);

    // Test Storage<MyInt> implementing Container<MyInt>
    Storage<MyInt> structStorage = default;
    MyInt mi = default;
    mi.x = 99;
    structStorage.Set(mi);
    result &= Test("generic_interface_mystruct_get", structStorage.Get().x, 99);

    // Test another Storage<int> with different value
    Storage<int> anotherIntStorage = default;
    anotherIntStorage.Set(100);
    result &= Test("generic_interface_int_get_100", anotherIntStorage.Get(), 100);

    return result;
}

// =============================================================
// Returning list<T>* from functions
// =============================================================

list<int>* makeIntList()
{
    list<int>* l = new list<int>;
    l->add(10);
    l->add(20);
    l->add(30);
    return l;
}

class ListFactory
{
    list<int>* create()
    {
        list<int>* l = new list<int>;
        l->add(1);
        l->add(2);
        return l;
    }
};

bool testReturnListFreeFunc()
{
    bool result = true;
    list<int>* l = makeIntList();
    result &= Test("return_list_count",  l->count(), 3);
    result &= Test("return_list_get_0",  l->get(0),  10);
    result &= Test("return_list_get_1",  l->get(1),  20);
    result &= Test("return_list_get_2",  l->get(2),  30);
    delete l;
    return result;
}

bool testReturnListMethod()
{
    bool result = true;
    ListFactory f;
    list<int>* l = f.create();
    result &= Test("return_list_method_count", l->count(), 2);
    result &= Test("return_list_method_get_0", l->get(0),  1);
    result &= Test("return_list_method_get_1", l->get(1),  2);
    delete l;
    return result;
}

// =============================================================
// Nested generic struct default initialization
// =============================================================

struct NestedBox<T>
{
    Box<T> inner = default;
};

bool testNestedGenericDefault()
{
    bool result = true;
    NestedBox<int> nb = default;
    nb.inner.value = 77;
    result &= Test("nested_generic_default", nb.inner.value, 77);
    NestedBox<i32> nb2 = default;
    nb2.inner.value = 55;
    result &= Test("nested_generic_default_i32", nb2.inner.value, 55);
    return result;
}

// =============================================================
// Generic local variable with = default (via method)
// =============================================================

struct LocalDefaultBox<T>
{
    T stored = default;

    // Uses a local variable of generic type T initialized to default
    T GetWithLocal()
    {
        T local = default;
        local = stored;
        return local;
    }
};

bool testGenericLocalDefault()
{
    bool result = true;

    LocalDefaultBox<int> b = default;
    b.stored = 99;
    result &= Test("generic_local_default_int", b.GetWithLocal(), 99);

    LocalDefaultBox<i32> b2 = default;
    b2.stored = 77;
    result &= Test("generic_local_default_i32", b2.GetWithLocal(), 77);

    return result;
}

// =============================================================
// Overloaded constructors
// =============================================================

struct Point
{
    int x = 0;
    int y = 0;

    Point(int px, int py)
    {
        this->x = px;
        this->y = py;
    }
};

struct Rect
{
    int left = 0;
    int top = 0;
    int width = 10;
    int height = 10;

    Rect(int l, int t, int w, int h)
    {
        this->left   = l;
        this->top    = t;
        this->width  = w;
        this->height = h;
    }

    Rect(int w, int h)
    {
        this->width  = w;
        this->height = h;
    }
};

bool testOverloadedConstructors()
{
    bool result = true;

    Point p = Point(3, 4);
    result &= Test("ctor_point_x", p.x, 3);
    result &= Test("ctor_point_y", p.y, 4);

    Point q = Point();
    result &= Test("ctor_point_default_x", q.x, 0);
    result &= Test("ctor_point_default_y", q.y, 0);

    Rect r = Rect(5, 10, 200, 100);
    result &= Test("ctor_rect_left",   r.left,   5);
    result &= Test("ctor_rect_top",    r.top,    10);
    result &= Test("ctor_rect_width",  r.width,  200);
    result &= Test("ctor_rect_height", r.height, 100);

    Rect r2 = Rect(320, 240);
    result &= Test("ctor_rect2_left",   r2.left,   0);
    result &= Test("ctor_rect2_top",    r2.top,    0);
    result &= Test("ctor_rect2_width",  r2.width,  320);
    result &= Test("ctor_rect2_height", r2.height, 240);

    return result;
}

// =============================================================
// Constructor default arguments
// =============================================================

struct Vec3
{
    int x = 0;
    int y = 0;
    int z = 0;

    Vec3(int px, int py = 0, int pz = 0)
    {
        this->x = px;
        this->y = py;
        this->z = pz;
    }
};

bool testConstructorDefaultArgs()
{
    bool result = true;

    // All args explicit
    Vec3 a = Vec3(1, 2, 3);
    result &= Test("ctor_default_args_all_x", a.x, 1);
    result &= Test("ctor_default_args_all_y", a.y, 2);
    result &= Test("ctor_default_args_all_z", a.z, 3);

    // One default (pz = 0)
    Vec3 b = Vec3(4, 5);
    result &= Test("ctor_default_args_two_x", b.x, 4);
    result &= Test("ctor_default_args_two_y", b.y, 5);
    result &= Test("ctor_default_args_two_z", b.z, 0);

    // Two defaults (py = 0, pz = 0)
    Vec3 c = Vec3(7);
    result &= Test("ctor_default_args_one_x", c.x, 7);
    result &= Test("ctor_default_args_one_y", c.y, 0);
    result &= Test("ctor_default_args_one_z", c.z, 0);

    return result;
}

// =============================================================
// Collections with struct and class types
// =============================================================

struct Person
{
    int age = 0;
    int id = 0;
};

bool testListStruct()
{
    bool result = true;

    list<Person> people;

    Person p1 = default;
    p1.age = 25;
    p1.id = 101;

    Person p2 = default;
    p2.age = 30;
    p2.id = 102;

    Person p3 = default;
    p3.age = 35;
    p3.id = 103;

    people.add(p1);
    people.add(p2);
    people.add(p3);

    result &= Test("list<struct> count", people.count(), 3);
    result &= Test("list<struct> get[0].age", people.get(0).age, 25);
    result &= Test("list<struct> get[0].id",  people.get(0).id,  101);
    result &= Test("list<struct> get[1].age", people.get(1).age, 30);
    result &= Test("list<struct> get[2].id",  people.get(2).id,  103);

    // operator[]
    result &= Test("list<struct> op[] get", people[1].age, 30);

    // set
    Person p4 = default;
    p4.age = 40;
    p4.id = 104;
    people.set(1, p4);
    result &= Test("list<struct> after set", people.get(1).age, 40);

    // removeAt
    people.removeAt(1);
    result &= Test("list<struct> count after remove", people.count(), 2);
    result &= Test("list<struct> after remove[1]", people.get(1).id, 103);

    // Both edge indices must still be ACCEPTED by the bounds check guarding
    // get/set/operator[]/removeAt. An out-of-range index now aborts with a
    // diagnostic instead of reading past the buffer, so an over-strict check
    // (off by one at either end) would break valid code here.
    Person p5 = default;
    p5.age = 50;
    p5.id = 105;
    result &= Test("list<struct> first index valid", people.get(0).id, 101);
    result &= Test("list<struct> last index valid",  people.get(people.count() - 1).id, 103);
    result &= Test("list<struct> op[] last index",   people[people.count() - 1].id, 103);
    people.set(people.count() - 1, p5);
    result &= Test("list<struct> set last index",    people.get(1).id, 105);
    people.removeAt(people.count() - 1);
    result &= Test("list<struct> removeAt last",     people.count(), 1);

    // clear
    people.clear();
    result &= Test("list<struct> after clear", people.count(), 0);

    return result;
}


bool testDictionaryStruct()
{
    bool result = true;

    dictionary<int, Person> personMap;

    Person p1 = default;
    p1.age = 25;
    p1.id = 101;

    Person p2 = default;
    p2.age = 30;
    p2.id = 102;

    Person p3 = default;
    p3.age = 35;
    p3.id = 103;

    // Add entries
    result &= Test("dict<int,struct> add 1", personMap.add(1, p1), true);
    result &= Test("dict<int,struct> add 2", personMap.add(2, p2), true);
    result &= Test("dict<int,struct> add 3", personMap.add(3, p3), true);

    result &= Test("dict<int,struct> count", personMap.count(), 3);

    // Get and check fields
    result &= Test("dict<int,struct> get 1 age",  personMap.get(1).age, 25);
    result &= Test("dict<int,struct> get 1 id",   personMap.get(1).id,  101);
    result &= Test("dict<int,struct> get 2 age",  personMap.get(2).age, 30);
    result &= Test("dict<int,struct> op[] get",   personMap[3].id,      103);

    // set
    Person p4 = default;
    p4.age = 40;
    p4.id = 104;
    personMap.set(2, p4);
    result &= Test("dict<int,struct> after set", personMap.get(2).age, 40);

    // remove
    result &= Test("dict<int,struct> remove", personMap.remove(2), true);
    result &= Test("dict<int,struct> count after remove", personMap.count(), 2);
    result &= Test("dict<int,struct> get after remove", personMap.get(3).age, 35);

    return result;
}


bool testForStruct()
{
    bool result = true;

    list<Person> people;

    Person p1 = default;
    p1.age = 20;

    Person p2 = default;
    p2.age = 30;

    Person p3 = default;
    p3.age = 40;

    people.add(p1);
    people.add(p2);
    people.add(p3);

    int sumAge = 0;
    for (Person p in people)
        sumAge += p.age;

    result &= Test("for struct sum", sumAge, 90);

    return result;
}

// =============================================================
// Pointer types inside generic parameters (list<Employee*>)
// =============================================================

int empDtorCount = 0;

struct Employee
{
    int id = 0;
    int salary = 0;
    ~Employee() { empDtorCount = empDtorCount + 1; }
};

bool testListPointer()
{
    bool result = true;

    {
        list<unique Employee*> employees;

        Employee* e1 = new Employee;
        e1->id = 1;
        e1->salary = 50000;

        Employee* e2 = new Employee;
        e2->id = 2;
        e2->salary = 60000;

        Employee* e3 = new Employee;
        e3->id = 3;
        e3->salary = 70000;

        employees.add(e1);
        employees.add(e2);
        employees.add(e3);

        result &= Test("list<ptr> count",        employees.count(),          3);
        result &= Test("list<ptr> get[0].id",    employees.get(0)->id,       1);
        result &= Test("list<ptr> get[0].salary",employees.get(0)->salary,   50000);
        result &= Test("list<ptr> get[1].id",    employees.get(1)->id,       2);
        result &= Test("list<ptr> get[2].salary",employees.get(2)->salary,   70000);

        // operator[]
        result &= Test("list<ptr> op[]",         employees[1]->id,           2);

        // removeAt auto-frees the element (destructor called + memory released)
        empDtorCount = 0;
        employees.removeAt(1);
        result &= Test("list<ptr> removeAt dtor fired",    empDtorCount,              1);
        result &= Test("list<ptr> count after remove",     employees.count(),         2);
        result &= Test("list<ptr> after remove[1].id",     employees.get(1)->id,      3);
        // employees destructor frees remaining elements (e1, e3) here
    }
    // ~list() freed the 2 remaining elements; total dtor fires = 1 (removeAt) + 2 (dtor) = 3
    result &= Test("list<ptr> cleanup dtor count",     empDtorCount,              3);

    return result;
}

bool testListPointerClear()
{
    bool result = true;

    empDtorCount = 0;
    {
        list<unique Employee*> employees;
        Employee* e1 = new Employee; e1->id = 1;
        Employee* e2 = new Employee; e2->id = 2;
        Employee* e3 = new Employee; e3->id = 3;
        employees.add(e1);
        employees.add(e2);
        employees.add(e3);

        // clear() must free all 3 elements
        employees.clear();
        result &= Test("list<ptr> clear count",      employees.count(), 0);
        result &= Test("list<ptr> clear dtor fires", empDtorCount,      3);

        // add after clear - destructor must not double-free
        Employee* e4 = new Employee; e4->id = 4;
        employees.add(e4);
        result &= Test("list<ptr> add after clear count", employees.count(), 1);
        result &= Test("list<ptr> add after clear id",    employees.get(0)->id, 4);
        // ~list() frees e4 here
    }
    result &= Test("list<ptr> dtor after clear", empDtorCount, 4);

    return result;
}

// list<unique Employee*> OWNS its elements (frees them), while bare list<Employee*> is a
// DISTINCT instantiation that BORROWS (never frees).
struct UniqueChecker<T>
{
    int check()
    {
        if const (is_unique(T))
            return 1;
        else
            return 0;
    }
};

bool testListUniquePointer()
{
    bool result = true;

    empDtorCount = 0;
    {
        // Owning list frees its elements; a borrowing list (distinct instantiation) coexists
        // and only BORROWS - it holds an aliased element and frees nothing.
        list<unique Employee*> owning;

        Employee* e1 = new Employee; e1->id = 1;
        Employee* e2 = new Employee; e2->id = 2;
        owning.add(e1);
        owning.add(e2);

        list<Employee*> borrowed;
        borrowed.add(owning.get(0));

        result &= Test("list<unique ptr> count",     owning.count(),      2);
        result &= Test("list<unique ptr> get id",    owning.get(0)->id,   1);
        result &= Test("list<ptr> borrow count",     borrowed.count(),    1);
        result &= Test("list<ptr> borrow same elem", borrowed.get(0)->id, 1);

        // removeAt on the unique list frees the element; the borrowing list's dtor frees nothing.
        owning.removeAt(0);
        result &= Test("list<unique ptr> removeAt dtor", empDtorCount, 1);
        result &= Test("list<unique ptr> count after remove", owning.count(), 1);
        // owning frees e2 at scope exit; borrowed frees nothing
    }
    // 1 (removeAt e1) + 1 (owning dtor e2) = 2
    result &= Test("list<unique ptr> cleanup dtor", empDtorCount,     2);

    return result;
}

bool testIsUniqueIntrinsic()
{
    bool result = true;
    // is_unique is true only inside a unique instantiation; is_pointer holds for both.
    UniqueChecker<unique Employee*> cu = default;
    UniqueChecker<Employee*>        cp = default;
    UniqueChecker<int>              ci = default;
    result &= Test("is_unique unique Employee*", cu.check(), 1);
    result &= Test("is_unique Employee*",        cp.check(), 0);
    result &= Test("is_unique int",              ci.check(), 0);
    return result;
}

// A bare pointer element BORROWS: `add()` is NOT an ownership sink - the caller keeps the
// pointer and frees it exactly once. (Formerly spelled list<alias Employee*>.)
bool testListBorrowedPointer()
{
    bool result = true;

    empDtorCount = 0;
    {
        // The borrowing list: add() does not consume, and the list frees nothing.
        list<Employee*> borrowing;

        Employee* e1 = new Employee; e1->id = 1;
        Employee* e2 = new Employee; e2->id = 2;
        borrowing.add(e1);
        borrowing.add(e2);

        // e1/e2 are still usable after add() - no use-after-move.
        result &= Test("borrowed list<ptr> count",        borrowing.count(),      2);
        result &= Test("borrowed list<ptr> src usable",   e1->id,                 1);
        result &= Test("borrowed list<ptr> get id",       borrowing.get(0)->id,   1);
        result &= Test("borrowed list<ptr> no dtor yet",  empDtorCount,           0);

        // removeAt on a borrowing list must NOT free the element.
        borrowing.removeAt(0);
        result &= Test("borrowed list<ptr> removeAt no dtor", empDtorCount, 0);

        delete e1;
        delete e2;
        result &= Test("borrowed list<ptr> caller frees", empDtorCount, 2);
    }
    // The borrowing list's destructor freed nothing extra.
    result &= Test("borrowed list<ptr> dtor frees nothing", empDtorCount, 2);

    return result;
}

bool testHashsetPointer()
{
    bool result = true;

    hashset<Employee*> s;
    Employee* e1 = new Employee; e1->id = 10;
    Employee* e2 = new Employee; e2->id = 20;
    Employee* e3 = new Employee; e3->id = 30;

    s.add(e1);
    s.add(e2);
    s.add(e3);
    result &= Test("hashset<ptr> count",          s.count(),      3);
    result &= Test("hashset<ptr> contains e1",    s.contains(e1), true);
    result &= Test("hashset<ptr> contains e2",    s.contains(e2), true);
    result &= Test("hashset<ptr> dup add",        s.add(e1),      false);

    s.remove(e2);
    delete e2;
    result &= Test("hashset<ptr> count after remove", s.count(),      2);
    result &= Test("hashset<ptr> contains after remove", s.contains(e2), false);

    s.clear();
    result &= Test("hashset<ptr> count after clear", s.count(), 0);

    // caller owns e1 and e3 - delete them manually
    delete e1;
    delete e3;

    Employee* e4 = new Employee; e4->id = 40;
    s.add(e4);
    result &= Test("hashset<ptr> add after clear", s.count(), 1);
    delete e4;

    return result;
}

bool testDictionaryPointer()
{
    bool result = true;

    empDtorCount = 0;
    {
        // `unique Employee*` value: the dictionary OWNS the pointees and frees them on
        // remove()/set()-overwrite/clear()/teardown (a bare `dictionary<int, Employee*>` would
        // borrow and free nothing). add()/set() take ownership - the caller's local is moved out.
        dictionary<int, unique Employee*> d;
        Employee* e1 = new Employee; e1->id = 1; e1->salary = 100;
        Employee* e2 = new Employee; e2->id = 2; e2->salary = 200;
        Employee* e3 = new Employee; e3->id = 3; e3->salary = 300;
        d.add(1, e1);
        d.add(2, e2);
        d.add(3, e3);
        result &= Test("dict<ptr> count",    d.count(), 3);
        result &= Test("dict<ptr> get id",   d.get(1)->id, 1);

        // remove() must free the value
        d.remove(2);
        result &= Test("dict<ptr> remove dtor",        empDtorCount, 1);
        result &= Test("dict<ptr> count after remove", d.count(),    2);

        // set() on existing key must free old value before storing new
        Employee* e2b = new Employee; e2b->id = 99; e2b->salary = 999;
        d.add(2, e2b);
        Employee* e2c = new Employee; e2c->id = 77;
        d.set(2, e2c);
        result &= Test("dict<ptr> set overwrites and frees", empDtorCount, 2);
        result &= Test("dict<ptr> get after set",            d.get(2)->id, 77);

        // clear() must free remaining elements (e1, e2c, e3)
        d.clear();
        result &= Test("dict<ptr> clear dtor",  empDtorCount, 5);
        result &= Test("dict<ptr> clear count", d.count(),    0);

        // add after clear - destructor must not double-free
        Employee* e4 = new Employee; e4->id = 4;
        d.add(4, e4);
        result &= Test("dict<ptr> add after clear count", d.count(), 1);
        // ~dictionary() frees e4 here
    }
    result &= Test("dict<ptr> dtor after clear", empDtorCount, 6);

    return result;
}

// =============================================================
// Nested generic structures (generic fields with generic types)
// =============================================================

struct DoubleNested<T>
{
    Box<Box<T>> innerBox = default;
};

struct TripleNested<T>
{
    Box<Box<Box<T>>> tripleBox = default;
};

struct PairOfBoxes<K, V>
{
    Box<K> left = default;
    Box<V> right = default;
};

struct ContainerOfPairs<A, B>
{
    Pair<A, B> data = default;
    int dataCount = 0;
};

bool testDoubleNestedGeneric()
{
    bool result = true;

    // Test DoubleNested<int>
    DoubleNested<int> dn = default;
    dn.innerBox.value.value = 123;
    result &= Test("double_nested_int", dn.innerBox.value.value, 123);

    // Test DoubleNested<i32>
    DoubleNested<i32> dn2 = default;
    dn2.innerBox.value.value = 456;
    result &= Test("double_nested_i32", dn2.innerBox.value.value, 456);

    return result;
}

bool testTripleNestedGeneric()
{
    bool result = true;

    // Test TripleNested<int>
    TripleNested<int> tn = default;
    tn.tripleBox.value.value.value = 789;
    result &= Test("triple_nested_int", tn.tripleBox.value.value.value, 789);

    // Test TripleNested<i32>
    TripleNested<i32> tn2 = default;
    tn2.tripleBox.value.value.value = 999;
    result &= Test("triple_nested_i32", tn2.tripleBox.value.value.value, 999);

    return result;
}

bool testPairOfBoxes()
{
    bool result = true;

    // Test PairOfBoxes<int, int>
    PairOfBoxes<int, int> pob = default;
    pob.left.value = 10;
    pob.right.value = 20;
    result &= Test("pair_of_boxes_int_int_left", pob.left.value, 10);
    result &= Test("pair_of_boxes_int_int_right", pob.right.value, 20);

    // Test PairOfBoxes<i32, i64>
    PairOfBoxes<i32, i64> pob2 = default;
    pob2.left.value = 100;
    pob2.right.value = 1000;
    result &= Test("pair_of_boxes_i32_i64_left", pob2.left.value, 100);
    result &= Test("pair_of_boxes_i32_i64_right", pob2.right.value, 1000);

    // Test PairOfBoxes<u32, u16>
    PairOfBoxes<u32, u16> pob3 = default;
    pob3.left.value = 50000;
    pob3.right.value = 5000;
    result &= Test("pair_of_boxes_u32_u16_left", pob3.left.value, 50000);
    result &= Test("pair_of_boxes_u32_u16_right", pob3.right.value, 5000);

    return result;
}

bool testContainerOfPairs()
{
    bool result = true;

    // Test ContainerOfPairs<int, int>
    ContainerOfPairs<int, int> cop = default;
    cop.data.first = 5;
    cop.data.second = 10;
    cop.dataCount = 1;
    result &= Test("container_of_pairs_int_int_first", cop.data.first, 5);
    result &= Test("container_of_pairs_int_int_second", cop.data.second, 10);
    result &= Test("container_of_pairs_int_int_count", cop.dataCount, 1);

    // Test ContainerOfPairs<i32, i64>
    ContainerOfPairs<i32, i64> cop2 = default;
    cop2.data.first = 777;
    cop2.data.second = 888;
    cop2.dataCount = 2;
    result &= Test("container_of_pairs_i32_i64_first", cop2.data.first, 777);
    result &= Test("container_of_pairs_i32_i64_second", cop2.data.second, 888);
    result &= Test("container_of_pairs_i32_i64_count", cop2.dataCount, 2);

    return result;
}

// Generic struct with generic method returning nested generic
struct GenericWrapper<T>
{
    Box<T> wrapped = default;

    Box<T> GetWrapped()
    {
        return wrapped;
    }

    T GetValue()
    {
        return wrapped.value;
    }
};

bool testGenericWrapperMethods()
{
    bool result = true;

    // Test GenericWrapper<int> GetValue
    GenericWrapper<int> gw = default;
    gw.wrapped.value = 42;
    result &= Test("generic_wrapper_int_get_value", gw.GetValue(), 42);

    // Test GenericWrapper<i32> GetValue
    GenericWrapper<i32> gw2 = default;
    gw2.wrapped.value = 100;
    result &= Test("generic_wrapper_i32_get_value", gw2.GetValue(), 100);

    // Test GenericWrapper<int> GetWrapped
    Box<int> b = gw.GetWrapped();
    result &= Test("generic_wrapper_int_get_wrapped", b.value, 42);

    return result;
}

// Multiple levels of generic composition
struct Layer1<T>
{
    T data = default;
};

struct Layer2<T>
{
    Layer1<T> inner = default;
};

struct Layer3<T>
{
    Layer2<T> inner = default;
};

bool testMultiLayerGeneric()
{
    bool result = true;

    // Test Layer3<int>
    Layer3<int> l3 = default;
    l3.inner.inner.data = 111;
    result &= Test("multi_layer_int", l3.inner.inner.data, 111);

    // Test Layer3<i32>
    Layer3<i32> l3_i32 = default;
    l3_i32.inner.inner.data = 222;
    result &= Test("multi_layer_i32", l3_i32.inner.inner.data, 222);

    return result;
}

// Generic struct with mixed generic and non-generic fields
struct MixedGeneric<T>
{
    Box<T> genericBox = default;
    int regularInt = 0;
    T genericValue = default;
    i64 regularLong = 0;
};

bool testMixedGenericFields()
{
    bool result = true;

    // Test MixedGeneric<int>
    MixedGeneric<int> mg = default;
    mg.genericBox.value = 50;
    mg.regularInt = 100;
    mg.genericValue = 25;
    mg.regularLong = 9999;
    result &= Test("mixed_generic_int_box", mg.genericBox.value, 50);
    result &= Test("mixed_generic_int_regular", mg.regularInt, 100);
    result &= Test("mixed_generic_int_value", mg.genericValue, 25);
    result &= Test("mixed_generic_int_long", mg.regularLong, 9999);

    // Test MixedGeneric<i32>
    MixedGeneric<i32> mg2 = default;
    mg2.genericBox.value = 200;
    mg2.regularInt = 300;
    mg2.genericValue = 400;
    mg2.regularLong = 5555;
    result &= Test("mixed_generic_i32_box", mg2.genericBox.value, 200);
    result &= Test("mixed_generic_i32_regular", mg2.regularInt, 300);
    result &= Test("mixed_generic_i32_value", mg2.genericValue, 400);
    result &= Test("mixed_generic_i32_long", mg2.regularLong, 5555);

    return result;
}

// =============================================================
// Sort with lambda tests
// =============================================================

interface IPriority {
    int priority();
};

class RankedEmployee {
    int id   = 0;
    int rank = 0;
    int getRank() { return rank; }
};

class PrioItem : IPriority {
    int score = 0;
    int priority() { return score; }
};

bool testSortInt()
{
    bool ok = true;

    list<int> asc;
    asc.add(5); asc.add(2); asc.add(8); asc.add(1); asc.add(9); asc.add(3);
    asc.sort((int a, int b) => { return a < b; });
    ok &= asc.get(0) == 1;
    ok &= asc.get(1) == 2;
    ok &= asc.get(2) == 3;
    ok &= asc.get(3) == 5;
    ok &= asc.get(4) == 8;
    ok &= asc.get(5) == 9;

    list<int> desc;
    desc.add(5); desc.add(2); desc.add(8); desc.add(1); desc.add(9); desc.add(3);
    desc.sort((int a, int b) => { return a > b; });
    ok &= desc.get(0) == 9;
    ok &= desc.get(1) == 8;
    ok &= desc.get(2) == 5;
    ok &= desc.get(3) == 3;
    ok &= desc.get(4) == 2;
    ok &= desc.get(5) == 1;

    if (!ok) printf("FAIL: testSortInt\n");
    return ok;
}

bool testSortFloat()
{
    bool ok = true;

    list<float> nums;
    nums.add(3.5f); nums.add(1.0f); nums.add(4.0f); nums.add(1.5f); nums.add(2.5f);
    nums.sort((float a, float b) => { return a < b; });

    ok &= nums.get(0) == 1.0f;
    ok &= nums.get(1) == 1.5f;
    ok &= nums.get(2) == 2.5f;
    ok &= nums.get(3) == 3.5f;
    ok &= nums.get(4) == 4.0f;

    if (!ok) printf("FAIL: testSortFloat\n");
    return ok;
}

bool testSortStruct()
{
    bool ok = true;

    list<Point> byX;
    Point p1; p1.x = 5; p1.y = 1;
    Point p2; p2.x = 2; p2.y = 4;
    Point p3; p3.x = 8; p3.y = 2;
    Point p4; p4.x = 1; p4.y = 7;
    byX.add(p1); byX.add(p2); byX.add(p3); byX.add(p4);
    byX.sort((Point a, Point b) => { return a.x < b.x; });
    ok &= byX.get(0).x == 1;
    ok &= byX.get(1).x == 2;
    ok &= byX.get(2).x == 5;
    ok &= byX.get(3).x == 8;

    list<Point> byY;
    Point q1; q1.x = 0; q1.y = 3;
    Point q2; q2.x = 0; q2.y = 7;
    Point q3; q3.x = 0; q3.y = 1;
    Point q4; q4.x = 0; q4.y = 5;
    byY.add(q1); byY.add(q2); byY.add(q3); byY.add(q4);
    byY.sort((Point a, Point b) => { return a.y > b.y; });
    ok &= byY.get(0).y == 7;
    ok &= byY.get(1).y == 5;
    ok &= byY.get(2).y == 3;
    ok &= byY.get(3).y == 1;

    if (!ok) printf("FAIL: testSortStruct\n");
    return ok;
}

bool testSortPointer()
{
    bool ok = true;

    list<unique Point*> pts;
    Point* sp1 = new Point; sp1->x = 30;
    Point* sp2 = new Point; sp2->x = 10;
    Point* sp3 = new Point; sp3->x = 50;
    Point* sp4 = new Point; sp4->x = 20;
    pts.add(sp1); pts.add(sp2); pts.add(sp3); pts.add(sp4);

    pts.sort((Point* a, Point* b) => { return a->x < b->x; });

    ok &= pts.get(0)->x == 10;
    ok &= pts.get(1)->x == 20;
    ok &= pts.get(2)->x == 30;
    ok &= pts.get(3)->x == 50;

    if (!ok) printf("FAIL: testSortPointer\n");
    return ok;
}

bool testSortClass()
{
    bool ok = true;

    list<RankedEmployee> emps;
    RankedEmployee e1; e1.id = 1; e1.rank = 40;
    RankedEmployee e2; e2.id = 2; e2.rank = 10;
    RankedEmployee e3; e3.id = 3; e3.rank = 70;
    RankedEmployee e4; e4.id = 4; e4.rank = 25;
    emps.add(e1); emps.add(e2); emps.add(e3); emps.add(e4);

    emps.sort((RankedEmployee a, RankedEmployee b) => { return a.getRank() < b.getRank(); });

    ok &= emps.get(0).getRank() == 10;
    ok &= emps.get(1).getRank() == 25;
    ok &= emps.get(2).getRank() == 40;
    ok &= emps.get(3).getRank() == 70;

    if (!ok) printf("FAIL: testSortClass\n");
    return ok;
}

bool testSortInterface()
{
    bool ok = true;

    list<PrioItem> items;
    PrioItem si1; si1.score = 30;
    PrioItem si2; si2.score = 10;
    PrioItem si3; si3.score = 50;
    PrioItem si4; si4.score = 20;
    items.add(si1); items.add(si2); items.add(si3); items.add(si4);

    items.sort((PrioItem a, PrioItem b) => {
        IPriority ia = a;
        IPriority ib = b;
        return ia.priority() < ib.priority();
    });

    ok &= items.get(0).score == 10;
    ok &= items.get(1).score == 20;
    ok &= items.get(2).score == 30;
    ok &= items.get(3).score == 50;

    if (!ok) printf("FAIL: testSortInterface\n");
    return ok;
}

bool testSortCapturedKey()
{
    bool ok = true;

    bool flipSort = false;

    list<int> nums;
    nums.add(5); nums.add(2); nums.add(8);

    Lambda<bool(int,int)> cmpAsc = (int a, int b) => {
        if (flipSort) return a > b;
        return a < b;
    };
    nums.sort(cmpAsc);
    ok &= nums.get(0) == 2;
    ok &= nums.get(2) == 8;

    flipSort = true;
    nums.sort(cmpAsc);
    ok &= nums.get(0) == 2;
    ok &= nums.get(2) == 8;

    Lambda<bool(int,int)> cmpDesc = (int a, int b) => {
        if (flipSort) return a > b;
        return a < b;
    };
    nums.sort(cmpDesc);
    ok &= nums.get(0) == 8;
    ok &= nums.get(2) == 2;

    if (!ok) printf("FAIL: testSortCapturedKey\n");
    return ok;
}

bool testSortEdgeCases()
{
    bool ok = true;

    list<int> empty;
    empty.sort((int a, int b) => { return a < b; });
    ok &= empty.count() == 0;

    list<int> one;
    one.add(42);
    one.sort((int a, int b) => { return a < b; });
    ok &= one.get(0) == 42;

    list<int> same;
    same.add(7); same.add(7); same.add(7); same.add(7);
    same.sort((int a, int b) => { return a < b; });
    ok &= same.get(0) == 7;
    ok &= same.get(3) == 7;

    list<int> sorted;
    sorted.add(1); sorted.add(2); sorted.add(3); sorted.add(4);
    sorted.sort((int a, int b) => { return a < b; });
    ok &= sorted.get(0) == 1;
    ok &= sorted.get(3) == 4;

    list<int> rev;
    rev.add(4); rev.add(3); rev.add(2); rev.add(1);
    rev.sort((int a, int b) => { return a < b; });
    ok &= rev.get(0) == 1;
    ok &= rev.get(3) == 4;

    if (!ok) printf("FAIL: testSortEdgeCases\n");
    return ok;
}

// =============================================================
// is_pointer(T) compile-time intrinsic
// =============================================================

struct PointerChecker<T>
{
    int check()
    {
        return is_pointer(T);
    }
};

bool testIsPointerIntrinsic()
{
    bool result = true;
    PointerChecker<int>       ci = default;
    PointerChecker<bool>      cb = default;
    PointerChecker<Employee*> cp = default;
    result &= Test("is_pointer int",       ci.check(), 0);
    result &= Test("is_pointer bool",      cb.check(), 0);
    result &= Test("is_pointer Employee*", cp.check(), 1);
    return result;
}

// --- Templated global function (explicit type args) ---
T ShadowPick<T>(T a, T b) { return a > b ? a : b; }

T PickFirst<T>(T a, T b)
{
    return a;
}

// --- Templated static member function ---
struct MathOps
{
    static T Max<T>(T a, T b)
    {
        if (a > b) return a;
        return b;
    }

    static T Clamp<T>(T val, T lo, T hi)
    {
        if (val < lo) return lo;
        if (val > hi) return hi;
        return val;
    }
};

// --- Template with struct type ---
struct TemplatePoint
{
    int x = 0;
    int y = 0;
};

struct PointOps
{
    static TemplatePoint CombinePoints(TemplatePoint p1, TemplatePoint p2)
    {
        TemplatePoint result = default;
        result.x = p1.x + p2.x;
        result.y = p1.y + p2.y;
        return result;
    }
};

// --- Template with pointer type ---
struct PointerOps
{
    static T* MakeCopy<T>(T* source)
    {
        T* copy = new T;
        *copy = *source;
        return copy;
    }

    static T Dereference<T>(T* ptr)
    {
        return *ptr;
    }
};

// --- Template with interface type ---
interface IComparable
{
    int CompareTo(IComparable other);
};

class IntComparable : IComparable
{
    int value = 0;

    int CompareTo(IComparable other)
    {
        return 0;
    }
};

struct InterfaceOps
{
    static T* WrapInterface<T>(T value)
    {
        T* ptr = new T;
        *ptr = value;
        return ptr;
    }
};

bool testTemplateFunctions()
{
    bool result = true;

    // Test 1: Global generic function with explicit type args - primitives
    result &= Test("global_template_int", PickFirst<int>(7, 3), 7);
    result &= Test("global_template_i64", PickFirst<i64>(10, 20), 10);
    result &= Test("global_template_i32", PickFirst<i32>(99, 1), 99);
    result &= Test("global_template_u32", PickFirst<u32>(50, 25), 50);

    // Test 2: Static member generic function - primitives
    result &= Test("static_template_max_int", MathOps.Max<int>(3, 7), 7);
    result &= Test("static_template_max_neg", MathOps.Max<int>(-5, -1), -1);
    result &= Test("static_template_clamp_lo", MathOps.Clamp<int>(15, 0, 10), 10);
    result &= Test("static_template_clamp_mid", MathOps.Clamp<int>(5, 0, 10), 5);
    result &= Test("static_template_clamp_hi", MathOps.Clamp<i64>(5, 0, 10), 5);

    // Test 3: Static method with struct type
    TemplatePoint p1 = default;
    p1.x = 3;
    p1.y = 4;
    TemplatePoint p2 = default;
    p2.x = 1;
    p2.y = 2;
    TemplatePoint p3 = PointOps.CombinePoints(p1, p2);
    result &= Test("struct_static_combine_x", p3.x, 4);
    result &= Test("struct_static_combine_y", p3.y, 6);

    // Test 4: Generic pointer type parameter
    int* intPtr = new int;
    *intPtr = 42;
    int* intCopy = PointerOps.MakeCopy<int>(intPtr);
    int derefValue = PointerOps.Dereference<int>(intCopy);
    result &= Test("pointer_template_deref_int", derefValue, 42);
    delete intCopy;

    TemplatePoint* pointPtr = new TemplatePoint;
    pointPtr->x = 10;
    pointPtr->y = 20;
    TemplatePoint* pointCopy = PointerOps.MakeCopy<TemplatePoint>(pointPtr);
    int copiedX = PointerOps.Dereference<TemplatePoint>(pointCopy).x;
    int copiedY = PointerOps.Dereference<TemplatePoint>(pointCopy).y;
    result &= Test("pointer_template_copy_struct_x", copiedX, 10);
    result &= Test("pointer_template_copy_struct_y", copiedY, 20);
    delete pointCopy;
    delete pointPtr;

    // Test 5: Generic interface type parameter
    IntComparable ic = default;
    ic.value = 100;
    IntComparable* icPtr = InterfaceOps.WrapInterface<IntComparable>(ic);
    result &= Test("interface_template_wrap", icPtr->value, 100);
    delete icPtr;

    // Regression: when a generic function is instantiated mid-emission of the
    // outer caller, the generic body must not bind parameter names to the
    // outer's locals. Here the outer declares `int a`, which collides with
    // ShadowPick<T>'s parameter `a`. Pre-fix: the generic body's lookup walked
    // past its own frame, loaded from the outer's alloca, and produced
    // "Instruction does not dominate all uses" at LLVM verify time. Uses a
    // fresh generic so the instantiation happens here, mid-emit of this body.
    int a = 5;
    result &= Test("generic_local_shadow_outer_a", a, 5);
    result &= Test("generic_local_shadow_pick",   ShadowPick<int>(3, 7), 7);

    return result;
}

// --- Generic INSTANCE methods (own type parameter, receiver bound) ---
// A method with its own type parameter must still see `this` and the owner's fields,
// on a plain class as well as inside a generic one.
class BoxedCounter
{
    i64 _n = 0;
    int _bump = 1;

    T get<T>() { return (T)_n; }
    T getVia<T>() { return (T)this->_n; }
    T scaled<T>(int factor) { return (T)(_n * factor + _bump); }
};

class TypedHolder<T>
{
    T _value = default;

    U convert<U>() { return (U)_value; }
    static int sconvert<U>(U x) { return (int)x + 1; }
};

// A static generic method has no receiver, so it keeps its free-function shape and is
// reached through the type name - including through an instantiated generic type name.
class StaticBox
{
    int _unused = 0;

    static int twice<U>(U x) { return (int)x * 2; }
};

struct TypedPair<T>
{
    T _first = default;
    T _second = default;

    static int triple<U>(U x) { return (int)x * 3; }
};

bool testGenericStaticMethods()
{
    bool result = true;

    // Static generic method on a NON-generic class (already worked - guard against regression).
    result &= Test("generic_static_plain_class", StaticBox.twice<int>(5), 10);
    result &= Test("generic_static_plain_class_i64", StaticBox.twice<i64>(6), 12);

    // Static generic method on a GENERIC class, reached through the instantiated type name.
    result &= Test("generic_static_generic_class", TypedHolder<i64>.sconvert<int>(5), 6);
    result &= Test("generic_static_generic_class_alt", TypedHolder<int>.sconvert<i64>(9), 10);

    // Same, on a generic struct.
    result &= Test("generic_static_generic_struct", TypedPair<int>.triple<int>(4), 12);

    // The instance path through the same generic class must still bind its receiver.
    TypedHolder<i64> h = default;
    h._value = 21;
    result &= Test("generic_static_sibling_instance", (int)h.convert<int>(), 21);

    return result;
}

bool testGenericInstanceMethods()
{
    bool result = true;

    BoxedCounter c = default;
    c._n = 7;
    c._bump = 2;

    result &= Test("generic_method_field_int", (int)c.get<int>(), 7);
    result &= Test("generic_method_field_i64", (int)c.get<i64>(), 7);
    result &= Test("generic_method_this_field", (int)c.getVia<int>(), 7);
    result &= Test("generic_method_with_args", (int)c.scaled<int>(3), 23);

    // Same call through a pointer receiver.
    BoxedCounter* p = &c;
    result &= Test("generic_method_ptr_receiver", (int)p->get<int>(), 7);

    // Generic method inside a generic class: the method's own parameter and the
    // class's monomorphized fields must both resolve.
    TypedHolder<i64> h = default;
    h._value = 12;
    result &= Test("generic_method_in_generic_class", (int)h.convert<int>(), 12);

    return result;
}

// =============================================================
// Generic type constraint tests (where T : IInterface)
// =============================================================

interface IScorer
{
    int Score();
};

interface ILabeled
{
    int Label();
};

class Player : IScorer
{
    int points = 0;
    int Score() { return points; }
};

class Robot : IScorer
{
    int power = 0;
    int Score() { return power * 2; }
};

class Medal : IScorer, ILabeled
{
    int value = 0;
    int rank  = 0;
    int Score() { return value; }
    int Label() { return rank;  }
};

struct BestOf<T> where T : IScorer
{
    T first  = default;
    T second = default;

    int best()
    {
        int a = first.Score();
        int b = second.Score();
        return a > b ? a : b;
    }
};

struct Duel<T, U> where T : IScorer, U : IScorer
{
    T challenger = default;
    U defender   = default;

    bool challengerWins()
    {
        return challenger.Score() > defender.Score();
    }
};

struct TaggedBest<T> where T : IScorer, T : ILabeled
{
    T first  = default;
    T second = default;

    int bestScore()
    {
        int a = first.Score();
        int b = second.Score();
        return a > b ? a : b;
    }

    int bestLabel()
    {
        int la = first.Label();
        int lb = second.Label();
        return la > lb ? la : lb;
    }
};

class ScoreAccumulator<T> where T : IScorer
{
    T item  = default;
    int bonus = 0;

    int total()
    {
        return item.Score() + bonus;
    }
};

int MaxScore<T>(T* a, T* b) where T : IScorer
{
    int sa = a.Score();
    int sb = b.Score();
    return sa > sb ? sa : sb;
}

int SumScores<T>(T* a, T* b) where T : IScorer
{
    return a.Score() + b.Score();
}

bool testBasicStructConstraint()
{
    bool result = true;
    BestOf<Player> bo;
    bo.first.points  = 10;
    bo.second.points = 20;
    result &= Test("constraint_best_of_20", bo.best(), 20);
    BestOf<Player> bo2;
    bo2.first.points  = 99;
    bo2.second.points = 7;
    result &= Test("constraint_best_of_99", bo2.best(), 99);
    return result;
}

bool testAlternativeConcreteType()
{
    bool result = true;
    BestOf<Robot> br;
    br.first.power  = 5;
    br.second.power = 8;
    result &= Test("constraint_robot_best_16", br.best(), 16);
    BestOf<Robot> br2;
    br2.first.power  = 9;
    br2.second.power = 3;
    result &= Test("constraint_robot_best_18", br2.best(), 18);
    return result;
}

bool testTwoConstrainedParams()
{
    bool result = true;
    Duel<Player, Robot> d;
    d.challenger.points = 25;
    d.defender.power    = 10;
    result &= Test("constraint_duel_challenger_wins", d.challengerWins(), true);
    Duel<Robot, Player> d2;
    d2.challenger.power  = 3;
    d2.defender.points   = 50;
    result &= Test("constraint_duel_defender_wins", d2.challengerWins(), false);
    return result;
}

bool testMultipleConstraintsSameParam()
{
    bool result = true;
    TaggedBest<Medal> tb;
    tb.first.value  = 10;
    tb.first.rank   = 3;
    tb.second.value = 7;
    tb.second.rank  = 5;
    result &= Test("constraint_tagged_best_score", tb.bestScore(), 10);
    result &= Test("constraint_tagged_best_label", tb.bestLabel(), 5);
    return result;
}

bool testConstrainedClass()
{
    bool result = true;
    ScoreAccumulator<Player> sa;
    sa.item.points = 30;
    sa.bonus       = 5;
    result &= Test("constraint_class_player_total", sa.total(), 35);
    ScoreAccumulator<Robot> sar;
    sar.item.power = 4;
    sar.bonus      = 2;
    result &= Test("constraint_class_robot_total", sar.total(), 10);
    return result;
}

bool testConstrainedFunction()
{
    bool result = true;
    Player p1;
    p1.points = 15;
    Player p2;
    p2.points = 30;
    result &= Test("constraint_func_max_player", MaxScore<Player>(&p1, &p2), 30);
    result &= Test("constraint_func_sum_player", SumScores<Player>(&p1, &p2), 45);
    Robot r1;
    r1.power = 6;
    Robot r2;
    r2.power = 4;
    result &= Test("constraint_func_max_robot", MaxScore<Robot>(&r1, &r2), 12);
    result &= Test("constraint_func_sum_robot", SumScores<Robot>(&r1, &r2), 20);
    return result;
}

// ---- Variadic template tests ----

struct PackTuple<T...>
{
    T item = default;
};

bool testVariadicStruct()
{
    PackTuple<int> t1 = default;
    t1.item_0 = 42;
    bool result = Test("variadic_1elem", t1.item_0, 42);

    PackTuple<int, float> t2 = default;
    t2.item_0 = 7;
    t2.item_1 = 3.0f;
    result &= Test("variadic_2elem_0", t2.item_0, 7);

    PackTuple<int, int, int> t3 = default;
    t3.item_0 = 1;
    t3.item_1 = 2;
    t3.item_2 = 3;
    result &= Test("variadic_3elem_2", t3.item_2, 3);

    return result;
}

struct PackWithFixed<K, V...>
{
    K key = default;
    V value = default;
};

bool testVariadicFixedPlusPack()
{
    PackWithFixed<int, float> p1 = default;
    p1.key = 99;
    p1.value_0 = 1.5f;
    bool result = Test("varfixed_key", p1.key, 99);

    PackWithFixed<int, int, int> p2 = default;
    p2.key = 5;
    p2.value_0 = 10;
    p2.value_1 = 20;
    result &= Test("varfixed_val1", p2.value_1, 20);

    return result;
}

struct SizeChecker<T...>
{
    int count()
    {
        return sizeof(T);
    }
};

bool testVariadicSizeof()
{
    SizeChecker<int> s1 = default;
    SizeChecker<int, float, bool> s3 = default;
    bool result = Test("sizeof_pack_1", s1.count(), 1);
    result &= Test("sizeof_pack_3", s3.count(), 3);
    return result;
}

// =============================================================
// tuple<T...> comprehensive tests
// =============================================================

bool testTuplePrimitives()
{
    bool result = true;

    tuple<int> ti = default;
    ti.item_0 = 42;
    result &= Test("tuple_int_val",  ti.item_0, 42);
    result &= Test("tuple_int_size", ti.size(),  1);

    tuple<float> tf = default;
    tf.item_0 = 2.5f;
    result &= Test("tuple_float_val",  tf.item_0, 2.5f);
    result &= Test("tuple_float_size", tf.size(),  1);

    tuple<bool> tb = default;
    tb.item_0 = true;
    result &= Test("tuple_bool_val",  tb.item_0, true);
    result &= Test("tuple_bool_size", tb.size(),  1);

    tuple<i64> tl = default;
    tl.item_0 = 9000000000;
    result &= Test("tuple_i64_val",  tl.item_0, 9000000000);
    result &= Test("tuple_i64_size", tl.size(),  1);

    // four-element mixed: int, float, bool, i64
    tuple<int, float, bool, i64> tmix = default;
    tmix.item_0 = 7;
    tmix.item_1 = 1.5f;
    tmix.item_2 = true;
    tmix.item_3 = 8000000000;
    result &= Test("tuple_mix_int",   tmix.item_0, 7);
    result &= Test("tuple_mix_float", tmix.item_1, 1.5f);
    result &= Test("tuple_mix_bool",  tmix.item_2, true);
    result &= Test("tuple_mix_i64",   tmix.item_3, 8000000000);
    result &= Test("tuple_mix_size",  tmix.size(),  4);

    return result;
}

bool testTupleSizedIntegers()
{
    bool result = true;

    // signed: i8, i16, i32, i64
    tuple<i8, i16, i32, i64> ts = default;
    ts.item_0 = 100;
    ts.item_1 = 30000;
    ts.item_2 = 2000000;
    ts.item_3 = 5000000000;
    result &= Test("tuple_i8",          ts.item_0,      100);
    result &= Test("tuple_i16",         ts.item_1,      30000);
    result &= Test("tuple_i32",         ts.item_2,      2000000);
    result &= Test("tuple_i64_sized",   ts.item_3,      5000000000);
    result &= Test("tuple_signed_size", ts.size(),      4);

    // unsigned: u8, u16, u32, u64
    tuple<u8, u16, u32, u64> tu = default;
    tu.item_0 = 200;
    tu.item_1 = 50000;
    tu.item_2 = 2000000;
    tu.item_3 = 5000000000;
    result &= Test("tuple_u8",            tu.item_0,      200);
    result &= Test("tuple_u16",           tu.item_1,      50000);
    result &= Test("tuple_u32",           tu.item_2,      2000000);
    result &= Test("tuple_u64_sized",     tu.item_3,      5000000000);
    result &= Test("tuple_unsigned_size", tu.size(),      4);

    return result;
}

bool testTupleStructs()
{
    bool result = true;

    // single struct
    tuple<Person> tp1 = default;
    tp1.item_0.age = 25;
    tp1.item_0.id  = 101;
    result &= Test("tuple_struct_age",  tp1.item_0.age, 25);
    result &= Test("tuple_struct_id",   tp1.item_0.id,  101);
    result &= Test("tuple_struct_size", tp1.size(), 1);

    // two structs of same type
    tuple<Person, Person> tp2 = default;
    tp2.item_0.age = 30;
    tp2.item_0.id  = 102;
    tp2.item_1.age = 40;
    tp2.item_1.id  = 103;
    result &= Test("tuple_struct2_age0", tp2.item_0.age, 30);
    result &= Test("tuple_struct2_id0",  tp2.item_0.id,  102);
    result &= Test("tuple_struct2_age1", tp2.item_1.age, 40);
    result &= Test("tuple_struct2_id1",  tp2.item_1.id,  103);
    result &= Test("tuple_struct2_size", tp2.size(), 2);

    // mixed: struct + int + struct
    tuple<TemplatePoint, int, Person> tms = default;
    tms.item_0.x   = 3;
    tms.item_0.y   = 4;
    tms.item_1     = 77;
    tms.item_2.age = 50;
    result &= Test("tuple_mix_struct_x",   tms.item_0.x,   3);
    result &= Test("tuple_mix_struct_y",   tms.item_0.y,   4);
    result &= Test("tuple_mix_struct_int", tms.item_1,     77);
    result &= Test("tuple_mix_struct_age", tms.item_2.age, 50);
    result &= Test("tuple_mix_struct_sz",  tms.size(),     3);

    return result;
}

bool testTupleClasses()
{
    bool result = true;

    // single class
    tuple<Player> tc1 = default;
    tc1.item_0.points = 15;
    result &= Test("tuple_class1_pts",  tc1.item_0.points,  15);
    result &= Test("tuple_class1_scr",  tc1.item_0.Score(), 15);
    result &= Test("tuple_class1_size", tc1.size(), 1);

    // two different classes
    tuple<Player, Robot> tc2 = default;
    tc2.item_0.points = 20;
    tc2.item_1.power  = 8;
    result &= Test("tuple_class2_player", tc2.item_0.Score(), 20);
    result &= Test("tuple_class2_robot",  tc2.item_1.Score(), 16);
    result &= Test("tuple_class2_size",   tc2.size(), 2);

    // three classes: Player, Robot, Medal (Medal implements IScorer + ILabeled)
    tuple<Player, Robot, Medal> tc3 = default;
    tc3.item_0.points = 10;
    tc3.item_1.power  = 5;
    tc3.item_2.value  = 7;
    tc3.item_2.rank   = 2;
    result &= Test("tuple_class3_player", tc3.item_0.Score(), 10);
    result &= Test("tuple_class3_robot",  tc3.item_1.Score(), 10);
    result &= Test("tuple_class3_medal",  tc3.item_2.Score(),  7);
    result &= Test("tuple_class3_label",  tc3.item_2.Label(),  2);
    result &= Test("tuple_class3_size",   tc3.size(), 3);

    return result;
}

bool testTuplePointers()
{
    bool result = true;

    // single struct pointer
    Employee* e1 = new Employee;
    e1->id     = 1;
    e1->salary = 50000;
    tuple<Employee*> tp1 = default;
    tp1.item_0 = e1;
    result &= Test("tuple_ptr1_id",     tp1.item_0->id,     1);
    result &= Test("tuple_ptr1_salary", tp1.item_0->salary, 50000);
    result &= Test("tuple_ptr1_size",   tp1.size(), 1);
    Employee* tp1_e1 = move tp1.item_0; delete tp1_e1;

    // two struct pointers
    Employee* e2 = new Employee;
    e2->id     = 2;
    e2->salary = 60000;
    Employee* e3 = new Employee;
    e3->id     = 3;
    e3->salary = 70000;
    tuple<Employee*, Employee*> tp2 = default;
    tp2.item_0 = e2;
    tp2.item_1 = e3;
    result &= Test("tuple_ptr2_id0",  tp2.item_0->id,     2);
    result &= Test("tuple_ptr2_sal0", tp2.item_0->salary, 60000);
    result &= Test("tuple_ptr2_id1",  tp2.item_1->id,     3);
    result &= Test("tuple_ptr2_sal1", tp2.item_1->salary, 70000);
    result &= Test("tuple_ptr2_size", tp2.size(), 2);
    Employee* tp2_e2 = move tp2.item_0; delete tp2_e2;
    Employee* tp2_e3 = move tp2.item_1; delete tp2_e3;

    // mixed: int* + Employee* + bool*
    int* ip = new int;
    *ip = 777;
    Employee* e4 = new Employee;
    e4->id = 4;
    bool* bp = new bool;
    *bp = true;
    tuple<int*, Employee*, bool*> tpm = default;
    tpm.item_0 = ip;
    tpm.item_1 = e4;
    tpm.item_2 = bp;
    result &= Test("tuple_ptr_mix_int",  *tpm.item_0,      777);
    result &= Test("tuple_ptr_mix_emp",  tpm.item_1->id,   4);
    result &= Test("tuple_ptr_mix_bool", *tpm.item_2,      true);
    result &= Test("tuple_ptr_mix_size", tpm.size(),       3);
    int*      tpm_ip = move tpm.item_0; delete tpm_ip;
    Employee* tpm_e4 = move tpm.item_1; delete tpm_e4;
    bool*     tpm_bp = move tpm.item_2; delete tpm_bp;

    return result;
}

bool testTupleInterfaces()
{
    bool result = true;

    // Counter implements IReadable
    Counter c1 = Counter();
    tuple<IReadable> ti1 = default;
    ti1.item_0 = c1;
    result &= Test("tuple_iface1_read", ti1.item_0.Read(), 10);
    result &= Test("tuple_iface1_size", ti1.size(), 1);

    // ScaledValue implements both IReadable and IScalable
    ScaledValue sv = ScaledValue();
    tuple<IReadable, IScalable> ti2 = default;
    ti2.item_0 = sv;
    ti2.item_1 = sv;
    result &= Test("tuple_iface2_read",  ti2.item_0.Read(),    3);
    result &= Test("tuple_iface2_scale", ti2.item_1.Scale(4), 12);
    result &= Test("tuple_iface2_size",  ti2.size(), 2);

    // mixed: IReadable + int
    Counter c2 = Counter();
    tuple<IReadable, int> tim = default;
    tim.item_0 = c2;
    tim.item_1 = 99;
    result &= Test("tuple_iface_mix_read", tim.item_0.Read(), 10);
    result &= Test("tuple_iface_mix_int",  tim.item_1,        99);
    result &= Test("tuple_iface_mix_size", tim.size(), 2);

    return result;
}

// Returns a (int, float) tuple via tuple construction expression
(int, float) makePoint()
{
    return (3, 1.5f);
}

// Returns a (int, float, bool) tuple
(int, float, bool) makeTriple()
{
    return (42, 2.7f, true);
}

bool testTupleTypeSyntax()
{
    bool result = true;

    // Phase 1: (int, float) as a type
    (int, float) t = default;
    t.item_0 = 10;
    t.item_1 = 0.5f;
    result &= Test("tuple_type_int",   t.item_0, 10);
    result &= Test("tuple_type_float", t.item_1, 0.5f);
    result &= Test("tuple_type_size",  t.size(), 2);

    return result;
}

bool testTupleConstruct()
{
    bool result = true;

    // Phase 2: (expr, expr) construction expression
    (int, float) p = (7, 3.14f);
    result &= Test("tuple_ctor_int",   p.item_0, 7);
    result &= Test("tuple_ctor_float", p.item_1, 3.14f);

    // Three-element construction
    (int, float, bool) tri = (99, 1.1f, true);
    result &= Test("tuple_ctor3_int",   tri.item_0, 99);
    result &= Test("tuple_ctor3_float", tri.item_1, 1.1f);
    result &= Test("tuple_ctor3_bool",  tri.item_2, true);

    return result;
}

bool testTupleReturnAndDestructure()
{
    bool result = true;

    // Phase 2+3: return a tuple and destructure it
    (int x, float y) = makePoint();
    result &= Test("destr_int",   x, 3);
    result &= Test("destr_float", y, 1.5f);

    // Three-element destructure
    (int a, float b, bool c) = makeTriple();
    result &= Test("destr3_int",   a, 42);
    result &= Test("destr3_float", b, 2.7f);
    result &= Test("destr3_bool",  c, true);

    // Inferred entry: omit the type and infer it from the tuple field. At least one entry must
    // carry a type so the parse is unambiguous (a fully type-less '(a, b) = expr;' parses as an
    // assignment expression, not a destructure - see ParseDestructuringDeclaration).
    (int ix, iy) = makePoint();
    result &= Test("destr_infer_int",   ix, 3);
    result &= Test("destr_infer_float", iy, 1.5f);

    // `_` wildcard: skip a slot. The value stays in the tuple (no extra binding), and the wildcard
    // can sit anywhere - first, last, or middle - mixed with typed/inferred entries.
    (_, float wy) = makePoint();
    result &= Test("destr_wild_first", wy, 1.5f);
    (int wx, _) = makePoint();
    result &= Test("destr_wild_second", wx, 3);
    (int wa, _, bool wc) = makeTriple();
    result &= Test("destr_wild_mid_int",  wa, 42);
    result &= Test("destr_wild_mid_bool", wc, true);

    // Leading `auto` disambiguates from an assignment expression, so a FULLY type-less form is
    // allowed - every entry is inferred or `_`, no type token required anywhere.
    auto (aa, ab) = makePoint();
    result &= Test("destr_auto_int",   aa, 3);
    result &= Test("destr_auto_float", ab, 1.5f);
    auto (am, _, ac) = makeTriple();
    result &= Test("destr_auto_wild_int",  am, 42);
    result &= Test("destr_auto_wild_bool", ac, true);

    // Regression: a tuple shape (long, char) that is NEVER value-constructed anywhere and is
    // reached ONLY as a return type + destructure target. makeFreshPair is also defined AFTER
    // this function, so its fields are not yet emitted when this destructure runs - the
    // destructure must lazily instantiate them (was "arity mismatch: 2 variables for 0 fields").
    (long fa, char fb) = makeFreshPair();
    result &= Test("destr_fresh_long", fa, 9L);
    result &= Test("destr_fresh_char", (int)fb, 65);

    return result;
}

// Builds a (long, char) tuple via field assignment - no '(a, b)' construction expression of
// this shape exists in the file. Deliberately defined after testTupleReturnAndDestructure.
(long, char) makeFreshPair()
{
    tuple<long, char> t = default;
    t.item_0 = 9L;
    t.item_1 = (char)65;
    return t;
}

// Returns two array-views as a tuple. A tuple element may be a `T[]` array-view; each
// element keeps the noalias contract, so the destructured locals are distinct views (the
// !alias.scope metadata is checked by the HPC IR tests; here we verify the values).
(int[], int[]) twoViews(int[] a)
{
    int[] first = a;
    int[] second = a;
    return (first, second);
}

bool testTupleArrayView()
{
    bool result = true;

    int[5] backing = {10, 20, 30, 40, 50};
    int[] v = backing;

    // Sugar form (int[], int[]) destructured into array-view locals.
    (int[] x, int[] y) = twoViews(v);
    x[0] = 99;                       // mutate through one view
    result &= Test("tuple_view_destr_write", y[0], 99);

    int sum = 0;
    vectorize for (i64 i = 0; i < (i64)5; i = i + 1) { sum = sum + y[i]; }
    result &= Test("tuple_view_destr_sum", sum, 99 + 20 + 30 + 40 + 50);

    // Explicit generic form tuple<int[], int[]> built from a tuple literal.
    tuple<int[], int[]> t = (v, v);
    t.item_0[1] = 7;
    result &= Test("tuple_view_field_alias", t.item_1[1], 7);

    return result;
}

// Phase 4: ITuple<T...> - a third-party type that implements the interface
class MyRange : ITuple<int, int>
{
    int lo = 0;
    int hi = 0;

    (int, int) get()
    {
        return (lo, hi);
    }
};

bool testITuple()
{
    bool result = true;

    MyRange r;
    r.lo = 5;
    r.hi = 10;
    (int a, int b) = r.get();
    result &= Test("ituple_lo", a, 5);
    result &= Test("ituple_hi", b, 10);

    return result;
}

bool testImplicitStringLiteral()
{
    bool result = true;

    // string s = "literal" - implicit char* -> string coercion in variable declaration
    string s1 = "hello";
    result &= Test("implicit_decl", s1, "hello");

    // list<string>.add("literal") - implicit char* -> string coercion in function argument
    list<string> words = default;
    words.add("foo");
    words.add("bar");
    result &= Test("implicit_add_0", words.get(0), "foo");
    result &= Test("implicit_add_1", words.get(1), "bar");

    return result;
}

// =============================================================
// Generic function references and nested generic locals
// =============================================================

int dbl<T>(T x) { return (int)x + (int)x; }

// Nested generic-type local inside a generic function body (regression for the
// QueueInstantiateGenericType substitution fix - a literal "T" used to be queued
// and failed with "unknown type 'T'").
int sumPair<T>(T seed)
{
    list<T> xs = default;
    xs.add(seed);
    xs.add(seed);
    int total = 0;
    int i = 0;
    while (i < xs.count()) { total = total + (int)xs.get(i); i = i + 1; }
    return total;
}

bool testGenericFnAsValue()
{
    bool result = true;
    function<int(int)> fp = dbl<int>;   // generic fn instantiated as a value
    result &= Test("genfn_value_call",  fp(21), 42);
    result &= Test("genfn_value_call2", fp(0), 0);

    // A CAST of a generic instantiation used to hand CreateCast a null operand and SIGSEGV
    // the compiler with no output. The legs assert the cast reaches the RIGHT monomorphized
    // symbol, not merely a non-null address: it must equal the address of the same
    // instantiation taken through a function<> value, and must DIFFER from dbl<double>'s.
    void* castVoid  = (void*)dbl<int>;
    void* viaValue  = (void*)fp;
    void* otherInst = (void*)dbl<double>;
    result &= Test("genfn_cast_void_same_symbol",  castVoid == viaValue, true);
    result &= Test("genfn_cast_void_distinct_inst", castVoid != otherInst, true);
    char* castChar = (char*)dbl<int>;
    result &= Test("genfn_cast_char_same_symbol", castChar == (char*)viaValue, true);

    // The cast result must still be CALLABLE as the instantiation it names.
    function<int(int)> castFn = (function<int(int)>)dbl<int>;
    result &= Test("genfn_cast_fnptr_call", castFn(21), 42);
    return result;
}

bool testNestedGenericLocal()
{
    bool result = true;
    result &= Test("genfn_nested_local_int", sumPair<int>(5), 10);
    result &= Test("genfn_nested_local_i64", (int)sumPair<i64>(7), 14);
    return result;
}

// =============================================================
// `this` pointer in member-function bodies (plain and generic)
// =============================================================

struct SelfProbe
{
    int n = 0;
    SelfProbe* self() { return this; }
    void*      raw()  { return (void*)this; }
    int        read() { return this.n; }
    void       bump() { this.n = this.n + 1; }
};

class SelfBox<T>
{
    T val = default;
    SelfBox<T>* me()  { return this; }
    T           get() { return this.val; }
};

bool testThisReturnsSelf()
{
    SelfProbe p;
    p.n = 7;
    bool result = true;
    result &= Test("this_self_eq", (int)(p.self() == &p), 1);
    result &= Test("this_raw_eq",  (int)(p.raw() == (void*)&p), 1);
    return result;
}

bool testThisMemberAccess()
{
    SelfProbe p;
    p.n = 41;
    p.bump();
    return Test("this_member_rw", p.read(), 42) != 0;
}

bool testThisInGenericMethod()
{
    SelfBox<int> b;
    b.val = 9;
    bool result = true;
    result &= Test("this_generic_eq",  (int)(b.me() == &b), 1);
    result &= Test("this_generic_get", b.get(), 9);
    return result;
}

// Zero-arg constructor on a generic class: its body must run on declaration.
// Regression for a pre-declare crash (null parameterTypeList fell into the
// method branch and dereferenced a null return-type context).
class CtorBox<T>
{
    T* _data = nullptr;
    int _n = 0;
    CtorBox() { _data = new T[4]; _n = 4; _data[0] = 42; }
};

bool testGenericZeroArgCtor()
{
    CtorBox<int> b;
    bool result = true;
    result &= Test("gen_ctor_n",    b._n,        4);
    result &= Test("gen_ctor_data", b._data[0],  42);
    return result;
}

// =============================================================
// auto return-type inference on generic functions
// =============================================================

auto square<T>(T v)         { return v * v; }
auto identity<T>(T v)       { return v; }
auto pick_max<T>(T lhs, T rhs) { return lhs > rhs ? lhs : rhs; }
auto is_positive<T>(T v)    { return v > (T)0; }
auto abs_val<T>(T v)
{
    if (v < (T)0) return -v;
    return v;
}

bool testAutoReturn()
{
    bool result = true;
    result &= Test("auto_square_int",     square<int>(5),         25);
    result &= Test("auto_square_i64",     square<i64>(7),         (i64)49);
    double d = square<double>(2.5);
    result &= Test("auto_square_double",  (int)(d > 6.24 && d < 6.26), 1);
    result &= Test("auto_identity_int",   identity<int>(42),      42);
    result &= Test("auto_pick_max_7",     pick_max<int>(3, 7),    7);
    result &= Test("auto_pick_max_9",     pick_max<int>(9, 2),    9);
    result &= Test("auto_is_pos_false",   is_positive<int>(-3),   false);
    result &= Test("auto_is_pos_true",    is_positive<int>(5),    true);
    result &= Test("auto_abs_neg",        abs_val<int>(-4),       4);
    result &= Test("auto_abs_pos",        abs_val<int>(4),        4);
    return result;
}

// -- generic argument inference --

auto pick<T>(T a, T b) { return a > b ? a : b; }

bool testGenericArgInference()
{
    bool result = true;
    result &= Test("pick_int_max",  pick(3, 7),                  7);
    result &= Test("pick_int_min",  pick(9, 2),                  9);
    result &= Test("pick_i64_max",  pick((i64)10, (i64)20), (i64)20);
    return result;
}

// -- regression: generic free function whose type parameter T appears ONLY in the
// return type (never in a parameter), called with explicit instantiation. Previously
// this monomorphized to a zero-parameter instance and failed overload resolution.

Box<T> makeBoxTagged<T>(int tag)
{
    Box<T> b = default;
    b.value = tag;
    return b;
}

bool testReturnOnlyTypeParam()
{
    bool result = true;
    Box<int> bi = makeBoxTagged<int>(7);
    result &= Test("return_only_T_int", bi.value, 7);
    Box<i64> bl = makeBoxTagged<i64>(9);
    result &= Test("return_only_T_i64", bl.value, (i64)9);
    return result;
}

// Regression: an outer generic's method calls a method on an INNER generic type
// instantiated with the same type arg. When the inner is instantiated standalone
// (queued first) before any top-level call to its methods, its member bodies must
// still be reachable from the outer's body (forward-declared before the dependency
// flush). Previously failed with "Unknown identifier" on the inner method.
class GInner<T> where T : IMessage
{
    i64 _v = default;
    void bump() { _v = _v + (i64)1; }
};

class GOuter<T> where T : IMessage
{
    GInner<T>* make()
    {
        GInner<T>* a = new GInner<T>[1];
        a.bump();
        a.bump();
        return a;
    }
};

bool testNestedGenericInnerMethod()
{
    bool result = true;
    GOuter<IMessage> o = default;
    GInner<IMessage>* a = o.make();
    result &= Test("nested generic inner-method call", (int)a._v, 2);
    delete[1] a;
    return result;
}

// =============================================================
// Recursive generic instantiation: a generic container used as the type
// argument to another generic (e.g. list<list<int>>). Before the fix the inner
// type argument was kept as the literal string "list<int>" and never
// instantiated, so the outer declaration failed with "unknown type 'list<int>'".
// =============================================================

// list<list<int>> - by-value nested generic. Add inner lists, read back via
// get(i).get(j). add() moves the inner list into the slot (ownership transfer),
// so teardown frees each buffer exactly once.
bool testListOfListByValue()
{
    bool result = true;
    list<list<int>> ll;

    list<int> a = {1, 2, 3};
    list<int> b = {4, 5};
    ll.add(a);
    ll.add(b);

    result &= Test("nested count",   ll.count(),         2);
    result &= Test("nested a.count", ll.get(0).count(),  3);
    result &= Test("nested b.count", ll.get(1).count(),  2);
    result &= Test("nested a[0]",    ll.get(0).get(0),   1);
    result &= Test("nested a[2]",    ll.get(0).get(2),   3);
    result &= Test("nested b[1]",    ll.get(1).get(1),   5);
    return result;
}

// Three levels deep: list<list<list<int>>>.
bool testListOfListOfListByValue()
{
    bool result = true;
    list<list<list<int>>> lll;

    list<list<int>> inner;
    list<int> a = {7, 8};
    inner.add(a);
    lll.add(inner);

    result &= Test("deep count",       lll.count(),                1);
    result &= Test("deep inner count", lll.get(0).count(),         1);
    result &= Test("deep value",       lll.get(0).get(0).get(1),   8);
    return result;
}

// list<unique list<int>*> - the idiomatic owning-pointer nesting. `unique` so the outer
// list OWNS the inner list pointers and frees them in its destructor (bare would borrow
// and leak them here).
bool testListOfListPtr()
{
    bool result = true;
    list<unique list<int>*> ll;

    list<int>* a = new list<int>();
    a.add(10); a.add(20); a.add(30);
    list<int>* b = new list<int>();
    b.add(40); b.add(50);
    ll.add(a);
    ll.add(b);

    result &= Test("ptr count", ll.count(),         2);
    result &= Test("ptr a[0]",  ll.get(0).get(0),  10);
    result &= Test("ptr a[2]",  ll.get(0).get(2),  30);
    result &= Test("ptr b[1]",  ll.get(1).get(1),  50);
    return result;
}

// dictionary<int, unique list<int>*> - a generic used as the value type argument of
// another generic. `unique` so the dictionary OWNS the nested list and frees it at teardown
// (a bare `dictionary<int, list<int>*>` would borrow and leak the added list here).
bool testDictOfListPtr()
{
    bool result = true;
    dictionary<int, unique list<int>*> d;

    list<int>* a = new list<int>();
    a.add(100); a.add(200);
    d.add(1, a);

    list<int>* got = d.get(1);
    result &= Test("dict value count", got.count(),  2);
    result &= Test("dict value[0]",    got.get(0), 100);
    result &= Test("dict value[1]",    got.get(1), 200);
    return result;
}

// =============================================================
// Generic type aliases (using IntList = list<int>) - Tier 1
// The alias value is just the mangled name (list__int), a plain string; the
// instantiation is enqueued by the using itself (see ParseUsingDeclaration).
// =============================================================

using IntList   = list<int>;
using FloatList = list<float>;        // list<float> is mentioned ONLY via this using
using IntToInt  = dictionary<int, int>;

// Alias used in a function signature (parameter + return).
int aliasSum(IntList* xs)
{
    int sum = 0;
    for (int v in *xs) sum += v;
    return sum;
}

bool testGenericAlias()
{
    bool result = true;

    IntList xs;
    xs.add(10);
    xs.add(20);
    xs.add(12);
    result &= Test("generic_alias_count", xs.count(), 3);
    result &= Test("generic_alias_get1",  xs.get(1),  20);
    result &= Test("generic_alias_in_fn", aliasSum(&xs), 42);

    // list<float> instantiates purely from the `using FloatList = list<float>` above.
    FloatList fs;
    fs.add(1.5f);
    fs.add(2.5f);
    result &= Test("generic_alias_float_count", fs.count(), 2);
    result &= Test("generic_alias_float_get0",  fs.get(0) == 1.5f, true);

    // dictionary alias
    IntToInt m;
    m.add(1, 100);
    m.add(2, 200);
    result &= Test("generic_alias_dict_count", m.count(), 2);
    result &= Test("generic_alias_dict_get",   m.get(2),  200);

    return result;
}

// --- member-scope `if const`: per-instantiation member dispatch ---

class IfConstRes
{
    int id = default;
};

class IfConstBox<T>
{
    T _v = default;
    if const (is_unique(T))
    {
        int leg = 1;
        void set(move T value) { _v = move value; }
    }
    else if const (is_pointer(T))
    {
        int leg = 2;
        void set(T value) { _v = value; }
    }
    else
    {
        int leg = 3;
        struct IfConstTag { int q; };
        void set(move T value) { _v = move value; }
        int tag() { IfConstTag t; t.q = leg; return t.q; }
    }
};

class IfConstPlat
{
    if const (__MACOS__)        { int which() { return 1; } }
    else if const (__WINDOWS__) { int which() { return 1; } }
    else                        { int which() { return 1; } }
};

bool testIfConstMemberScope()
{
    bool result = true;

    unique IfConstRes* u = new IfConstRes();
    u->id = 7;
    IfConstBox<unique IfConstRes*> a;
    a.set(move u);
    result &= Test("ifconst_member_unique_leg", a.leg, 1);

    IfConstRes* raw = new IfConstRes();
    raw->id = 8;
    IfConstBox<IfConstRes*> b;
    b.set(raw);
    result &= Test("ifconst_member_pointer_leg", b.leg, 2);
    result &= Test("ifconst_member_pointer_val", b._v->id, 8);
    delete raw;

    IfConstBox<string> c;
    string s = "hi";
    c.set(move s);
    result &= Test("ifconst_member_value_leg",  c.leg, 3);
    result &= Test("ifconst_member_nested_str", c.tag(), 3);

    IfConstPlat p;
    result &= Test("ifconst_member_nongeneric", p.which(), 1);

    return result;
}

// --- interface-scope `if const`: per-instantiation contract selection ---

struct IfConstVal { int x = default; };

interface IIfConstBox<T>
{
    int count();
    if const (is_string(T))         { void set(move T value); string label; }
    else if const (is_primitive(T)) { void set(T value);      int label;    }
    else                            { void set(move T value); int label;    }
    int tag();
};

class IfConstSBox : IIfConstBox<string>
{
    string _v = default;
    string label = default;
    int n = default;
    int count() { return n; }
    void set(move string value) { _v = move value; n = n + 1; }
    int tag() { return 1; }
};

class IfConstIBox : IIfConstBox<int>
{
    int _v = default;
    int label = default;
    int n = default;
    int count() { return n; }
    void set(int value) { _v = value; n = n + 1; }
    int tag() { return 2; }
};

class IfConstVBox : IIfConstBox<IfConstVal>
{
    IfConstVal _v = default;
    int label = default;
    int n = default;
    int count() { return n; }
    void set(move IfConstVal value) { _v = move value; n = n + 1; }
    int tag() { return 3; }
};

interface IIfConstPlat
{
    if const (__MACOS__)        { int which(); }
    else if const (__WINDOWS__) { int which(); }
    else                        { int which(); }
};

class IfConstPlatImpl : IIfConstPlat
{
    int which() { return 9; }
};

bool testIfConstInterfaceScope()
{
    bool result = true;

    IfConstSBox s = default;
    IfConstIBox i = default;
    IfConstVBox v = default;

    string str = "hi";
    s.set(move str);
    s.label = "sl";
    i.set(5);
    i.label = 7;
    IfConstVal mv = default;
    v.set(move mv);
    v.label = 8;

    // Virtual dispatch through each instantiation's interface value.
    IIfConstBox<string>     a = s;
    IIfConstBox<int>        b = i;
    IIfConstBox<IfConstVal> c = v;

    result &= Test("ifconst_iface_string_tag",  a.tag(),   1);
    result &= Test("ifconst_iface_prim_tag",    b.tag(),   2);
    result &= Test("ifconst_iface_value_tag",   c.tag(),   3);
    result &= Test("ifconst_iface_string_cnt",  a.count(), 1);
    result &= Test("ifconst_iface_prim_cnt",    b.count(), 1);
    result &= Test("ifconst_iface_value_cnt",   c.count(), 1);

    // Interface FIELDS declared inside an if const branch, read through the interface.
    result &= Test("ifconst_iface_prim_field",  b.label,   7);
    result &= Test("ifconst_iface_value_field", c.label,   8);

    IfConstPlatImpl p = default;
    IIfConstPlat ip = p;
    result &= Test("ifconst_iface_nongeneric",  ip.which(), 9);

    return result;
}

// --- interface conformance with overloaded contract methods (declaration order) ---
// A class may declare both a `move` and a plain overload of a contract method that differ
// only in move-ness. Conformance must accept the class if ANY overload satisfies the plain
// interface contract, regardless of which overload is declared first, and interface dispatch
// must bind the conforming (plain) overload so a call through the interface never transfers
// ownership the contract did not promise.

interface IOrderSink<T>
{
    void put(T value);
    int  moves();
    int  plains();
    int  slot();
};

// move overload declared BEFORE the plain one - the order that used to be falsely rejected.
class OrderMoveFirst<T> : IOrderSink<T>
{
    T   _slot   = default;
    int _moves  = 0;
    int _plains = 0;
    if const (!is_pointer(T)) { void put(move T value) { _slot = move value; _moves = _moves + 1; } }
    void put(T value) { _slot = value; _plains = _plains + 1; }
    int  moves()  { return _moves; }
    int  plains() { return _plains; }
    int  slot()   { return _slot; }
};

// Reverse order (plain first, move second) - must keep conforming too.
class OrderPlainFirst<T> : IOrderSink<T>
{
    T   _slot   = default;
    int _moves  = 0;
    int _plains = 0;
    void put(T value) { _slot = value; _plains = _plains + 1; }
    if const (!is_pointer(T)) { void put(move T value) { _slot = move value; _moves = _moves + 1; } }
    int  moves()  { return _moves; }
    int  plains() { return _plains; }
    int  slot()   { return _slot; }
};

bool testConformanceOverloadOrder()
{
    bool result = true;

    // Direct call selects the plain overload for a plain (copyable) argument.
    OrderMoveFirst<int> mf = default;
    int a = 5;
    mf.put(a);
    result &= Test("conf_order_mf_direct_plain", mf.plains(), 1);

    // Dispatch through the plain interface must bind the plain overload, not the move one -
    // a plain call must not transfer ownership. moves() stays 0.
    IOrderSink<int> mfi = mf;
    mfi.put(11);
    result &= Test("conf_order_mf_iface_plains", mfi.plains(), 2);
    result &= Test("conf_order_mf_iface_nomove", mfi.moves(),  0);
    result &= Test("conf_order_mf_iface_slot",   mfi.slot(),   11);

    // Reverse declaration order still conforms and dispatches the plain overload.
    OrderPlainFirst<int> pf = default;
    IOrderSink<int> pfi = pf;
    pfi.put(22);
    result &= Test("conf_order_pf_iface_plains", pfi.plains(), 1);
    result &= Test("conf_order_pf_iface_nomove", pfi.moves(),  0);
    result &= Test("conf_order_pf_iface_slot",   pfi.slot(),   22);

    return result;
}

// =============================================================
// Namespaced generic struct/class corpus, merged from
// scratch/nsgi/test_namespaced_generic.cb per
// internal/issue/generic-template-namespace-key-space.md. A generic struct/class template is
// keyed on its qualified name (NS.Base), so it must be reachable qualified from outside its
// namespace, bare from inside it (binding to the namespace-local template, not a same-named
// outer one), and composable with itself as a type argument. The generic-interface positive
// legs for the same issue live in Test/test_interface.cb (prefix GiNs*).
// =============================================================

namespace GnNs
{
    struct Box<T> { T v = default; };
    class S<T> { T d = default; T Get() { return d; } void Set(T v) { d = v; } };

    int useSInside(S<int> s) { return s.Get(); }
    int useBoxInside(Box<int> b) { return b.v; }
    Box<int> makeBoxInside(int v) { Box<int> b = default; b.v = v; return b; }
    int useSBareLocal() { S<int> s = default; s.Set(29); return s.Get(); }

    struct Inner<T> { T v = default; };
    struct Outer<T> { T v = default; };
    struct Pair<K, V> { K k = default; V v = default; };
}

int useBoxGnNs(GnNs.Box<int> b) { return b.v; }
GnNs.Box<int> makeBoxGnNs(int v) { GnNs.Box<int> b = default; b.v = v; return b; }
struct HolderBoxGnNs { GnNs.Box<int> b = default; };

int useSGnNs(GnNs.S<int> s) { return s.Get(); }
GnNs.S<int> makeSGnNs(int v) { GnNs.S<int> s = default; s.Set(v); return s; }
struct HolderSGnNs { GnNs.S<int> s = default; };

// Leg 1: NS.Box<int>, qualified, local.
bool testGnNsStructLocal()
{
    bool result = true;
    GnNs.Box<int> b = default;
    b.v = 5;
    result &= Test("gn_ns_struct_local", b.v, 5);
    return result;
}

// Leg 2: NS.Box<int>, qualified, parameter.
bool testGnNsStructParam()
{
    bool result = true;
    GnNs.Box<int> b = default;
    b.v = 9;
    result &= Test("gn_ns_struct_param", useBoxGnNs(b), 9);
    return result;
}

// Leg 3: NS.Box<int>, qualified, return type.
bool testGnNsStructReturn()
{
    bool result = true;
    GnNs.Box<int> b = makeBoxGnNs(13);
    result &= Test("gn_ns_struct_return", b.v, 13);
    return result;
}

// Leg 4: NS.Box<int>, qualified, struct field.
bool testGnNsStructField()
{
    bool result = true;
    HolderBoxGnNs h = default;
    h.b.v = 21;
    result &= Test("gn_ns_struct_field", h.b.v, 21);
    return result;
}

// Leg 5: Box<int>, bare, local, inside the declaring namespace.
bool testGnNsStructBareLocal()
{
    bool result = true;
    result &= Test("gn_ns_struct_bare_local", GnNs.useBoxInside(GnNs.makeBoxInside(3)), 3);
    return result;
}

// Leg 6: Box<int>, bare, parameter, inside the declaring namespace.
bool testGnNsStructBareParam()
{
    bool result = true;
    GnNs.Box<int> b = default;
    b.v = 31;
    result &= Test("gn_ns_struct_bare_param", GnNs.useBoxInside(b), 31);
    return result;
}

// Leg 7: Box<int>, bare, return type, inside the declaring namespace.
bool testGnNsStructBareReturn()
{
    bool result = true;
    GnNs.Box<int> b = GnNs.makeBoxInside(37);
    result &= Test("gn_ns_struct_bare_return", b.v, 37);
    return result;
}

// Leg 8: NS.S<int>, qualified, local.
bool testGnNsClassLocal()
{
    bool result = true;
    GnNs.S<int> s = default;
    s.Set(7);
    result &= Test("gn_ns_class_local", s.Get(), 7);
    return result;
}

// Leg 9: NS.S<int>, qualified, parameter.
bool testGnNsClassParam()
{
    bool result = true;
    GnNs.S<int> s = default;
    s.Set(7);
    result &= Test("gn_ns_class_param", useSGnNs(s), 7);
    return result;
}

// Leg 10: NS.S<int>, qualified, return type.
bool testGnNsClassReturn()
{
    bool result = true;
    GnNs.S<int> s = makeSGnNs(17);
    result &= Test("gn_ns_class_return", s.Get(), 17);
    return result;
}

// Leg 11: NS.S<int>, qualified, struct field.
bool testGnNsClassField()
{
    bool result = true;
    HolderSGnNs h = default;
    h.s.Set(23);
    result &= Test("gn_ns_class_field", h.s.Get(), 23);
    return result;
}

// Leg 12: S<int>, bare, local, inside the declaring namespace.
bool testGnNsClassBareLocal()
{
    bool result = true;
    result &= Test("gn_ns_class_bare_local", GnNs.useSBareLocal(), 29);
    return result;
}

// Leg 13: S<int>, bare, parameter, inside the declaring namespace.
bool testGnNsClassBareParam()
{
    bool result = true;
    GnNs.S<int> s = default;
    s.Set(41);
    result &= Test("gn_ns_class_bare_param", GnNs.useSInside(s), 41);
    return result;
}

// Leg 14: class + param BOTH declared inside the namespace.
bool testGnNsClassInside()
{
    bool result = true;
    GnNs.S<int> s = default;
    s.Set(11);
    result &= Test("gn_ns_class_inside", GnNs.useSInside(s), 11);
    return result;
}

// Leg 19: identity - two namespaces declaring the same generic STRUCT name with DIFFERENT
// contracts, each used qualified. Must dispatch to its own template.
namespace GnIdA { struct Box<T> { T v = default; int Tag() { return 100; } }; }
namespace GnIdB { struct Box<T> { T v = default; int Tag() { return 200; } }; }

bool testGnNsIdentityStructTwoNamespaces()
{
    bool result = true;
    GnIdA.Box<int> a = default;
    GnIdB.Box<int> b = default;
    result &= Test("gn_ns_identity_struct_a", a.Tag(), 100);
    result &= Test("gn_ns_identity_struct_b", b.Tag(), 200);
    return result;
}

// Leg 23: nested namespaces, A.B.Box<int>.
namespace GnNest
{
    namespace GnNestInner
    {
        struct Box<T> { T v = default; };
    }
}

bool testGnNsNestedNamespace()
{
    bool result = true;
    GnNest.GnNestInner.Box<int> b = default;
    b.v = 61;
    result &= Test("gn_ns_nested_namespace", b.v, 61);
    return result;
}

// Leg 24: a namespaced generic taking a namespaced generic as a type argument - mangling
// composition.
bool testGnNsNestedTypeArg()
{
    bool result = true;
    GnNs.Outer<GnNs.Inner<int>> o = default;
    o.v.v = 67;
    result &= Test("gn_ns_nested_typearg", o.v.v, 67);
    return result;
}

// Leg 26: a namespaced generic instantiated ONLY from a different namespace than the one
// declaring it - resolution is use-site, not declaration-site.
namespace GnCrossA { struct Box<T> { T v = default; }; }
namespace GnCrossB
{
    int useBox() { GnCrossA.Box<int> b = default; b.v = 71; return b.v; }
}

bool testGnNsCrossNamespaceUse()
{
    bool result = true;
    result &= Test("gn_ns_cross_namespace_use", GnCrossB.useBox(), 71);
    return result;
}

// Leg 27: two distinct instantiations of one namespaced template live at once.
bool testGnNsTwoInstantiationsLive()
{
    bool result = true;
    GnNs.Box<int> bi = default;
    bi.v = 73;
    GnNs.Box<float> bf = default;
    bf.v = 7.5;
    result &= Test("gn_ns_two_inst_int", bi.v, 73);
    result &= Test("gn_ns_two_inst_float", bf.v, 7.5f);
    return result;
}

// Extra cheap shapes: multiple type args, non-primitive type arg, pointer type arg - all on a
// namespaced template.
bool testGnNsMultiTypeArg()
{
    bool result = true;
    GnNs.Pair<int, int> p = default;
    p.k = 3;
    p.v = 79;
    result &= Test("gn_ns_multi_typearg_k", p.k, 3);
    result &= Test("gn_ns_multi_typearg_v", p.v, 79);
    return result;
}

struct GnNsPoint { int x = 0; int y = 0; };

bool testGnNsNonPrimitiveTypeArg()
{
    bool result = true;
    GnNs.Box<GnNsPoint> b = default;
    b.v.x = 3;
    b.v.y = 83;
    result &= Test("gn_ns_nonprim_typearg", b.v.y, 83);
    return result;
}

bool testGnNsPointerTypeArg()
{
    bool result = true;
    int val = 89;
    GnNs.Box<int*> b = default;
    b.v = &val;
    result &= Test("gn_ns_pointer_typearg", *b.v, 89);
    return result;
}

// Leg 40: inner-scope-wins. A bare generic name written INSIDE a namespace binds to the
// namespace-local template, not to a same-named GLOBAL one. Ratified in
// internal/issue/generic-template-namespace-key-space.md ("T2") as the correct behaviour, and
// pinned here because it is the one shape whose MEANING silently changed rather than being
// un-broken: the pre-fix compiler bound the bare name outward to the global template instead.
struct GnShadowBox<T> { T v = default; int Tag() { return 1; } };
namespace GnShadow
{
    struct GnShadowBox<T> { T v = default; int Tag() { return 2; } };
    int inner() { GnShadowBox<int> b = default; return b.Tag(); }
}
int gnShadowOuter() { GnShadowBox<int> b = default; return b.Tag(); }

bool testGnNsInnerScopeWins()
{
    bool result = true;
    result &= Test("gn_ns_inner_scope_wins_inner", GnShadow.inner(), 2);
    result &= Test("gn_ns_inner_scope_wins_outer", gnShadowOuter(), 1);
    return result;
}

// Leg 41: a generic template nested in a STRUCT resolves its body against the LEXICAL scope,
// not against a same-named NAMESPACE. Its registered key is "GnNest.GnNestBox" - identical in
// shape to a namespaced template's key - so recovering the declaring scope by splitting the key
// picks namespace GnNest and silently returns ITS Helper (5) instead of the global one (9).
// The declaring namespace is therefore RECORDED at registration. The non-generic analog below
// is the compiler's own answer for this shape and both must agree.
struct GnNestHelper { int v = 9; };
namespace GnNest { struct GnNestHelper { int v = 5; }; }
struct GnNest
{
    int pad = 0;
    struct GnNestBox<T> { GnNestHelper h = default; T t = default; int Get() { return h.v; } };
    struct GnNestBoxNG { GnNestHelper h = default; int Get() { return h.v; } };
};

bool testGnNsNestedInStructNotNamespace()
{
    bool result = true;
    GnNest.GnNestBox<int> b = default;
    GnNest.GnNestBoxNG ng = default;
    result &= Test("gn_ns_nested_in_struct_generic", b.Get(), 9);
    result &= Test("gn_ns_nested_in_struct_nongeneric", ng.Get(), 9);
    return result;
}

// Leg 42: a `using` alias to a generic BASE keeps its declaration-site meaning. The alias target
// is already explicit, so it must not be re-resolved against the namespace of the USE site -
// doing so made a global `using GnAliasBox = GnAliasBoxG;` silently name the namespace-local
// template (2) wherever it appeared inside that namespace, instead of the global one (1).
struct GnAliasBoxG<T> { T v = default; int Tag() { return 1; } };
namespace GnAliasNs { struct GnAliasBoxG<T> { T v = default; int Tag() { return 2; } }; }
using GnAliasBox = GnAliasBoxG;
namespace GnAliasNs
{
    int viaAlias() { GnAliasBox<int> b = default; return b.Tag(); }
}
// The bare-name half of the pair lives OUTSIDE the namespace on purpose: an alias use and a bare
// use of its target inside ONE namespace hits a pre-existing generic-base-alias gap that fails on
// the pre-fix compiler too (see the issue's adjacent list). Leg 40 already pins the bare binding.
int gnAliasGlobal() { GnAliasBoxG<int> b = default; return b.Tag(); }

bool testGnNsGenericBaseAliasKeepsDeclSiteMeaning()
{
    bool result = true;
    result &= Test("gn_ns_alias_keeps_decl_site", GnAliasNs.viaAlias(), 1);
    result &= Test("gn_ns_alias_global_target", gnAliasGlobal(), 1);
    return result;
}

// =============================================================
// Layer 2 (type ARGUMENTS) corpus, merged from the layer-2 corpus (deleted with the issue) per
// internal/issue/interface-issue-queue.md (landed design records). Each leg gives the SAME wrong-namespace's
// Item a DIFFERENT value than the other Item so a wrong bind is visible both directions at once.
// =============================================================

// Leg 1: known repro - global Item vs A.Item as a Box<T> argument, both bare-spelled.
struct Ta1Item { int v = 9; };
struct Ta1Box<T> { T t = default; int Get() { return t.v; } };
namespace Ta1A
{
    struct Ta1Item { int v = 7; };
    int f() { Ta1Box<Ta1Item> b = default; return b.Get(); }
}
int ta1g() { Ta1Box<Ta1Item> b = default; return b.Get(); }

bool testGnNsTaCollision()
{
    bool result = true;
    result &= Test("ta_collision_inA", Ta1A.f(), 7);
    result &= Test("ta_collision_global", ta1g(), 9);
    return result;
}

// Leg 2: same shape, but the template itself is ALSO declared inside a namespace.
namespace Ta2Ns
{
    struct Ta2Item { int v = 9; };
    struct Ta2Box<T> { T t = default; int Get() { return t.v; } };
    namespace Ta2A
    {
        struct Ta2Item { int v = 7; };
        int f() { Ta2Ns.Ta2Box<Ta2Item> b = default; return b.Get(); }
    }
    int g() { Ta2Box<Ta2Item> b = default; return b.Get(); }
}

bool testGnNsTaTemplateInNamespaceToo()
{
    bool result = true;
    result &= Test("ta_template_in_ns_inA", Ta2Ns.Ta2A.f(), 7);
    result &= Test("ta_template_in_ns_global", Ta2Ns.g(), 9);
    return result;
}

// Leg 3: two DIFFERENT namespaces each supplying their own Item, plus the global one -
// three-way against one global template.
struct Ta3Item { int v = 1; };
struct Ta3Box<T> { T t = default; int Get() { return t.v; } };
namespace Ta3A { struct Ta3Item { int v = 2; }; int f() { Ta3Box<Ta3Item> b = default; return b.Get(); } }
namespace Ta3B { struct Ta3Item { int v = 3; }; int f() { Ta3Box<Ta3Item> b = default; return b.Get(); } }
int ta3g() { Ta3Box<Ta3Item> b = default; return b.Get(); }

bool testGnNsTaThreeWayNamespaces()
{
    bool result = true;
    result &= Test("ta_three_way_inA", Ta3A.f(), 2);
    result &= Test("ta_three_way_inB", Ta3B.f(), 3);
    result &= Test("ta_three_way_global", ta3g(), 1);
    return result;
}

// Leg 4: a namespaced type spelled QUALIFIED as a type argument (Ta4A.Item), alongside a bare
// use. Non-discriminating: qualified vs bare are different TEXT so they already mangled apart
// before the fix; kept because it documents mixed qualified/bare is not how the bug manifests.
struct Ta4Item { int v = 9; };
struct Ta4Box<T> { T t = default; int Get() { return t.v; } };
namespace Ta4A
{
    struct Ta4Item { int v = 7; };
}
int ta4Qualified() { Ta4Box<Ta4A.Ta4Item> b = default; return b.Get(); }
int ta4Bare() { Ta4Box<Ta4Item> b = default; return b.Get(); }

bool testGnNsTaQualifiedVsBareTypeArg()
{
    bool result = true;
    result &= Test("ta_qualified_typearg", ta4Qualified(), 7);
    result &= Test("ta_bare_typearg", ta4Bare(), 9);
    return result;
}

// Leg 5: multiple type arguments, only ONE is ambiguous (Pair<Item, int>).
struct Ta5Item { int v = 9; };
struct Ta5Pair<K, V> { K k = default; V v = default; int GetK() { return k.v; } int GetV() { return v; } };
namespace Ta5A
{
    struct Ta5Item { int v = 7; };
    int fK() { Ta5Pair<Ta5Item, int> p = default; p.v = 100; return p.GetK(); }
    int fV() { Ta5Pair<Ta5Item, int> p = default; p.v = 100; return p.GetV(); }
}
int ta5gK() { Ta5Pair<Ta5Item, int> p = default; p.v = 200; return p.GetK(); }
int ta5gV() { Ta5Pair<Ta5Item, int> p = default; p.v = 200; return p.GetV(); }

bool testGnNsTaMultiTypeArgOneAmbiguous()
{
    bool result = true;
    result &= Test("ta_multi_typearg_k_inA", Ta5A.fK(), 7);
    result &= Test("ta_multi_typearg_k_global", ta5gK(), 9);
    result &= Test("ta_multi_typearg_v_inA", Ta5A.fV(), 100);
    result &= Test("ta_multi_typearg_v_global", ta5gV(), 200);
    return result;
}

// Leg 6: a NESTED type argument (Box<Box<Item>>) with the inner Item ambiguous.
struct Ta6Item { int v = 9; };
struct Ta6Box<T> { T t = default; };
namespace Ta6A
{
    struct Ta6Item { int v = 7; };
    int f() { Ta6Box<Ta6Box<Ta6Item>> b = default; return b.t.t.v; }
}
int ta6g() { Ta6Box<Ta6Box<Ta6Item>> b = default; return b.t.t.v; }

bool testGnNsTaNestedTypeArg()
{
    bool result = true;
    result &= Test("ta_nested_typearg_inA", Ta6A.f(), 7);
    result &= Test("ta_nested_typearg_global", ta6g(), 9);
    return result;
}

// Leg 7: a POINTER-to-ambiguous-type argument. The two Item variants have DIFFERENT field
// layouts (a leading pad) so a wrong metadata bind shows up as a wrong value, not a coincidence.
struct Ta7Item { int pad = 100; int v = 9; };
struct Ta7Box<T> { T t = default; };
namespace Ta7A
{
    struct Ta7Item { int v = 7; };
    int f() { Ta7Item i = default; Ta7Box<Ta7Item*> b = default; b.t = &i; return b.t->v; }
}
int ta7g() { Ta7Item i = default; Ta7Box<Ta7Item*> b = default; b.t = &i; return b.t->v; }

bool testGnNsTaPointerTypeArg()
{
    bool result = true;
    result &= Test("ta_pointer_typearg_inA", Ta7A.f(), 7);
    result &= Test("ta_pointer_typearg_global", ta7g(), 9);
    return result;
}

// Leg 8: nested namespaces (A.B.Item).
struct Ta8Item { int v = 9; };
struct Ta8Box<T> { T t = default; int Get() { return t.v; } };
namespace Ta8A
{
    namespace Ta8B
    {
        struct Ta8Item { int v = 7; };
        int f() { Ta8Box<Ta8Item> b = default; return b.Get(); }
    }
}
int ta8g() { Ta8Box<Ta8Item> b = default; return b.Get(); }

bool testGnNsTaNestedNamespaces()
{
    bool result = true;
    result &= Test("ta_nested_namespaces_inAB", Ta8A.Ta8B.f(), 7);
    result &= Test("ta_nested_namespaces_global", ta8g(), 9);
    return result;
}

// Leg 10: layout probe - the two Item variants have DISJOINT fields (global a/b/c/d,
// Ta10A x) so a collapsed instantiation could not resolve 'x' at all pre-fix; post-fix each
// layout gets its own instantiation and both are readable.
struct Ta10Item { int a = 1; int b = 2; int c = 3; int d = 4; };
struct Ta10Box<T> { T t = default; int tail = 77; };
namespace Ta10A
{
    struct Ta10Item { i64 x = 111; };
    int f() { Ta10Box<Ta10Item> b = default; return b.tail + (int)b.t.x; }
}
int ta10g() { Ta10Box<Ta10Item> b = default; return b.tail + b.t.a + b.t.d; }

bool testGnNsTaDifferingLayouts()
{
    bool result = true;
    result &= Test("ta_differing_layouts_inA", Ta10A.f(), 188);
    result &= Test("ta_differing_layouts_global", ta10g(), 82);
    return result;
}

// Leg 13: a DOTTED argument spelling must mean the same type as a plain dotted local in the
// same scope. Ordinary lookup resolves a dotted name from the top, so the argument walk must
// not relatively resolve one either (pinned with the non-generic control).
struct Ta13Box<T> { T t = default; int Get() { return t.v; } };
namespace Ta13B { struct Item { int v = 9; }; }
namespace Ta13A
{
    namespace Ta13B { struct Item { int v = 7; }; }
    int split() { Ta13B.Item direct = default; Ta13Box<Ta13B.Item> boxed = default; return direct.v * 100 + boxed.Get(); }
    int ctrl() { Ta13B.Item direct = default; return direct.v; }
}

bool testGnNsTaDottedArgIsNotRelative()
{
    bool result = true;
    result &= Test("ta_dotted_arg_same_as_local", Ta13A.split(), 909);
    result &= Test("ta_dotted_arg_control", Ta13A.ctrl(), 9);
    return result;
}

// Leg 14: a type declared inside an expect_error block whose OWN declaration is fine is still a
// real type; the scan deliberately keeps such a name out of scannedTypeNames (it may fail to
// register), and this leg pins that the main pass still resolves it via dataStructures.
struct Ta14Item { int v = 9; };
struct Ta14Box<T> { T t = default; int Get() { return t.v; } };
namespace Ta14A
{
    expect_error("Undefined variable ta14zzz.")
    {
        struct Ta14Item { int v = 7; };
        int bad() { return ta14zzz + 1; }
    }
    int f() { Ta14Box<Ta14Item> b = default; return b.Get(); }
}

bool testGnNsTaExpectErrorBlockTypeIsReachable()
{
    bool result = true;
    result &= Test("ta_expect_error_block_type", Ta14A.f(), 7);
    return result;
}

// Leg 15: a type NESTED in `struct Outer` is keyed "Outer.Item", the same dotted key a
// `namespace Outer` produces, so a bare argument inside `namespace Outer` reaches it,
// order-independently. The use must come textually AFTER `struct Ta15Outer` below.
struct Ta15Item { int v = 9; };
struct Ta15Box<T> { T t = default; int Get() { return t.v; } };
struct Ta15Outer { struct Ta15Item { int v = 7; }; int dummy = 0; };
namespace Ta15Outer
{
    int f() { Ta15Box<Ta15Item> b = default; return b.Get(); }
    int ctrl() { Ta15Item i = default; return i.v; }
}

bool testGnNsTaNestedStructKeyIsOrderIndependent()
{
    bool result = true;
    result &= Test("ta_nested_struct_key", Ta15Outer.f(), 7);
    result &= Test("ta_nested_struct_key_control", Ta15Outer.ctrl(), 7);
    return result;
}

// Control 1: unique type names, global scope + namespace, NO ambiguity. Must keep passing.
struct Ta11GlobalItem { int v = 9; };
struct Ta11Box<T> { T t = default; int Get() { return t.v; } };
namespace Ta11A
{
    int f() { Ta11Box<Ta11GlobalItem> b = default; return b.Get(); }
}
int ta11g() { Ta11Box<Ta11GlobalItem> b = default; return b.Get(); }

bool testGnNsTaCtrlUniqueNames()
{
    bool result = true;
    result &= Test("ta_ctrl_unique_names_inA", Ta11A.f(), 9);
    result &= Test("ta_ctrl_unique_names_global", ta11g(), 9);
    return result;
}

// Control 2: unique names, template ALSO declared inside a namespace. Must keep passing.
namespace Ta12Ns
{
    struct Ta12NsItem { int v = 9; };
    struct Ta12Box<T> { T t = default; int Get() { return t.v; } };
    int g() { Ta12Box<Ta12NsItem> b = default; return b.Get(); }
}
int ta12UseOutside() { Ta12Ns.Ta12Box<Ta12Ns.Ta12NsItem> b = default; return b.Get(); }

bool testGnNsTaCtrlUniqueTemplateInNs()
{
    bool result = true;
    result &= Test("ta_ctrl_unique_template_in_ns_inside", Ta12Ns.g(), 9);
    result &= Test("ta_ctrl_unique_template_in_ns_outside", ta12UseOutside(), 9);
    return result;
}

// ---- Layer 3: a template's BODY must keep the argument the CALLER resolved. A template
// declared in a namespace that owns its own same-named type, instantiated at GLOBAL scope with
// the GLOBAL type, used to fill both instantiations with the namespace's type. Each leg asserts
// the global AND the qualified instantiation together, so a collapse cannot hide. Corpus:
// the layer-3 corpus (deleted with the issue).
struct BsItem { int v = 9; };
namespace BsN1
{
    struct BsItem { int v = 3; };
    struct BsTpl<T>
    {
        T t = default;
        int Get() { return t.v; }
        int FromParam(T p) { return p.v; }
        T MakeRet() { T r = default; return r; }
    };
}
int bs1Global()    { BsN1.BsTpl<BsItem> x = default; return x.Get(); }
int bs1Dotted()    { BsN1.BsTpl<BsN1.BsItem> x = default; return x.Get(); }
int bs1ParamG()    { BsN1.BsTpl<BsItem> x = default; BsItem i = default; return x.FromParam(i); }
int bs1ParamD()    { BsN1.BsTpl<BsN1.BsItem> x = default; BsN1.BsItem i = default; return x.FromParam(i); }
int bs1RetG()      { BsN1.BsTpl<BsItem> x = default; return x.MakeRet().v; }
int bs1RetD()      { BsN1.BsTpl<BsN1.BsItem> x = default; return x.MakeRet().v; }

// A field with NO `= default` (and one with a mismatching initializer) takes a DIFFERENT code
// path than `T t = default;`: the struct's field-initializer sites call the field type's default
// ctor directly, and those sites must not walk the namespace either.
namespace BsN13
{
    struct Bs13Item { int v = 3; };
    struct Bs13Tpl<T> { T t; int Get() { return t.v; } };
    struct Bs13Mismatch<T> { T t = 0; int Get() { return t.v; } };
}
struct Bs13Item { int v = 9; };
int bs13NoInitG()   { BsN13.Bs13Tpl<Bs13Item> x = default; return x.Get(); }
int bs13NoInitD()   { BsN13.Bs13Tpl<BsN13.Bs13Item> x = default; return x.Get(); }
int bs13MismatchG() { BsN13.Bs13Mismatch<Bs13Item> x = default; return x.Get(); }
int bs13MismatchD() { BsN13.Bs13Mismatch<BsN13.Bs13Item> x = default; return x.Get(); }

bool testGnNsBodyKeepsCallerTypeArg()
{
    bool result = true;
    result &= Test("bs_body_field_global",  bs1Global(), 9);
    result &= Test("bs_body_field_dotted",  bs1Dotted(), 3);
    result &= Test("bs_body_param_global",  bs1ParamG(), 9);
    result &= Test("bs_body_param_dotted",  bs1ParamD(), 3);
    result &= Test("bs_body_return_global", bs1RetG(),   9);
    result &= Test("bs_body_return_dotted", bs1RetD(),   3);
    result &= Test("bs_body_noinit_global",   bs13NoInitG(),   9);
    result &= Test("bs_body_noinit_dotted",   bs13NoInitD(),   3);
    result &= Test("bs_body_mismatch_global", bs13MismatchG(), 9);
    result &= Test("bs_body_mismatch_dotted", bs13MismatchD(), 3);
    return result;
}

// Layer 3, disjoint layouts: the two same-spelled types share no field, so a wrong bind cannot
// be masked by a coincidentally matching offset (pre-fix: "Unknown identifier 'a'.").
struct Bs8Item { int a = 1; int b = 2; };
namespace BsN8
{
    struct Bs8Item { i64 x = 111; };
    struct Bs8Tpl<T> { T t = default; int tail = 77; };
}
int bs8Global() { BsN8.Bs8Tpl<Bs8Item> b = default; return b.tail + b.t.a + b.t.b; }
int bs8Dotted() { BsN8.Bs8Tpl<BsN8.Bs8Item> b = default; return b.tail + (int)b.t.x; }

bool testGnNsBodyDisjointLayouts()
{
    bool result = true;
    result &= Test("bs_body_layout_global", bs8Global(), 80);
    result &= Test("bs_body_layout_dotted", bs8Dotted(), 188);
    return result;
}

// Layer 3, nested instantiation + generic class + the `namespace Outer` / `struct Outer` shared
// key space (struct nesting and namespace nesting are ONE dotted key space, so the declaring
// scope must come from what registration recorded, never from splitting the key).
struct Bs4Item { int v = 9; };
namespace BsN4
{
    struct Bs4Item { int v = 3; };
    struct Bs4In<T>  { T t = default; };
    struct Bs4Out<T> { T t = default; };
    class  Bs4Box<T> { T t = default; int Get() { return t.v; } };
}
struct Bs7Outer { struct Bs7Inner { int q = 1; }; int dummy = 0; };
namespace Bs7Outer
{
    struct Bs7Item { int v = 3; };
    struct Bs7Tpl<T> { T t = default; int Get() { return t.v; } };
}
struct Bs7Item { int v = 9; };
int bs4NestedG() { BsN4.Bs4Out<BsN4.Bs4In<Bs4Item>> x = default; return x.t.t.v; }
int bs4NestedD() { BsN4.Bs4Out<BsN4.Bs4In<BsN4.Bs4Item>> x = default; return x.t.t.v; }
int bs4ClassG()  { BsN4.Bs4Box<Bs4Item> b = default; return b.Get(); }
int bs4ClassD()  { BsN4.Bs4Box<BsN4.Bs4Item> b = default; return b.Get(); }
int bs7Global()  { Bs7Outer.Bs7Tpl<Bs7Item> x = default; return x.Get(); }
int bs7Dotted()  { Bs7Outer.Bs7Tpl<Bs7Outer.Bs7Item> x = default; return x.Get(); }

bool testGnNsBodyNestedClassAndStructNsKeySpace()
{
    bool result = true;
    result &= Test("bs_body_nested_global",   bs4NestedG(), 9);
    result &= Test("bs_body_nested_dotted",   bs4NestedD(), 3);
    result &= Test("bs_body_class_global",    bs4ClassG(),  9);
    result &= Test("bs_body_class_dotted",    bs4ClassD(),  3);
    result &= Test("bs_body_nsstruct_global", bs7Global(),  9);
    result &= Test("bs_body_nsstruct_dotted", bs7Dotted(),  3);
    return result;
}

// Layer 3 controls, correct on both binaries: a template NESTED in `struct Holder` declares at
// GLOBAL scope even when a `namespace Holder` exists, and an instantiation from INSIDE the
// declaring namespace keeps meaning that namespace's type.
struct Bs9Item { int v = 9; };
struct Bs9Holder { struct Bs9Tpl<T> { T t = default; int Get() { return t.v; } }; int dummy = 0; };
namespace Bs9Holder { struct Bs9Item { int v = 3; }; }
namespace BsN10
{
    struct Bs10Item { int v = 3; };
    struct Bs10Tpl<T> { T t = default; int Get() { return t.v; } };
    int f() { Bs10Tpl<Bs10Item> x = default; return x.Get(); }
}
int bs9Global() { Bs9Holder.Bs9Tpl<Bs9Item> x = default; return x.Get(); }

bool testGnNsBodyCtrlDeclaringScope()
{
    bool result = true;
    result &= Test("bs_body_ctrl_struct_nested_tpl", bs9Global(), 9);
    result &= Test("bs_body_ctrl_from_declaring_ns", BsN10.f(),   3);
    return result;
}

// ---------------------------------------------------------------------------------------------
// Layer 4 of the generic key space (internal/issue/interface-issue-queue.md): generic FUNCTION templates are keyed
// on the namespace-QUALIFIED name, and a BARE call inside a namespace walks the enclosing chain
// (innermost first) to reach its own namespace's key. Every leg asserts the namespaced answer AND
// the global one together so a collapse onto one key cannot hide.
// Corpus: deleted with the issue; pre-fix witnesses are in the landed design records.
// ---------------------------------------------------------------------------------------------

// Leg A - bare call, EXPLICIT type argument, fixed arity, free function. Three declaration
// orders: global first, namespaced first, and a UNIQUE namespaced name with no global at all
// (the last two did not compile before the fix).
Gq1T gq1Ident<Gq1T>(Gq1T x) { return x; }
namespace Gq1NS
{
    Gq1T gq1Ident<Gq1T>(Gq1T x) { return x + 1; }
    int f() { return gq1Ident<int>(10); }
}
namespace Gq2NS
{
    Gq2T gq2Ident<Gq2T>(Gq2T x) { return x + 1; }
    Gq2U gq2Unique<Gq2U>(Gq2U x) { return x + 2; }
    int f()       { return gq2Ident<int>(10); }
    int fUnique() { return gq2Unique<int>(10); }
}
Gq2T gq2Ident<Gq2T>(Gq2T x) { return x; }
Gq3K gq3First<Gq3K, Gq3V>(Gq3K k, Gq3V v) { return k; }
namespace Gq3A { Gq3K gq3First<Gq3K, Gq3V>(Gq3K k, Gq3V v) { return k + v; } int f() { return gq3First<int, int>(10, 1); } }
namespace Gq3B { Gq3K gq3First<Gq3K, Gq3V>(Gq3K k, Gq3V v) { return k + v + v; } int f() { return gq3First<int, int>(10, 1); } }

bool testGnNsGfBareCallInNamespace()
{
    bool result = true;
    result &= Test("gf_bare_ns",            Gq1NS.f(),               11);
    result &= Test("gf_bare_global",        gq1Ident<int>(10),       10);
    result &= Test("gf_declorder_ns",       Gq2NS.f(),               11);
    result &= Test("gf_declorder_global",   gq2Ident<int>(10),       10);
    result &= Test("gf_unique_name_ns",     Gq2NS.fUnique(),         12);
    result &= Test("gf_multi_typeparam_a",  Gq3A.f(),                11);
    result &= Test("gf_multi_typeparam_b",  Gq3B.f(),                12);
    result &= Test("gf_multi_typeparam_gl", gq3First<int, int>(10, 1), 10);
    return result;
}

// Leg B - NESTED namespaces: the inner one's own template wins, a sibling inner namespace with no
// template walks OUT to the enclosing namespace's (not to the global one), and global stays global.
Gq4T gq4Id<Gq4T>(Gq4T x) { return x; }
namespace Gq4Out
{
    Gq4T gq4Id<Gq4T>(Gq4T x) { return x + 1; }
    namespace In  { Gq4T gq4Id<Gq4T>(Gq4T x) { return x + 2; } int f() { return gq4Id<int>(10); } }
    namespace In2 { int f() { return gq4Id<int>(10); } }
    int f() { return gq4Id<int>(10); }
}

bool testGnNsGfNestedNamespaces()
{
    bool result = true;
    result &= Test("gf_nested_inner",     Gq4Out.In.f(),   12);
    result &= Test("gf_nested_walks_out", Gq4Out.In2.f(),  11);
    result &= Test("gf_nested_outer",     Gq4Out.f(),      11);
    result &= Test("gf_nested_global",    gq4Id<int>(10),  10);
    return result;
}

// Leg C - the INFERRED spelling (no explicit type arguments) bare inside the namespace, plus the
// QUALIFIED call spellings from outside in both the inferred and explicit forms.
// The UNIQUE-NAME twin is load-bearing: the colliding form alone passes even when the bare
// spelling never reaches its own namespace's key, because the global template absorbs the call.
Gq5T gq5Id<Gq5T>(Gq5T x) { return x; }
namespace Gq5NS
{
    Gq5T gq5Id<Gq5T>(Gq5T x) { return x + 1; }
    Gq5U gq5UniqInferred<Gq5U>(Gq5U x) { return x + 2; }
    int f()       { return gq5Id(10); }
    int fUnique() { return gq5UniqInferred(10); }
}

bool testGnNsGfInferredAndQualifiedSpellings()
{
    bool result = true;
    result &= Test("gf_inferred_bare_ns",       Gq5NS.f(),            11);
    result &= Test("gf_inferred_global",        gq5Id(10),            10);
    result &= Test("gf_inferred_unique_name",   Gq5NS.fUnique(),      12);
    result &= Test("gf_qualified_inferred",     Gq5NS.gq5Id(10),      11);
    result &= Test("gf_qualified_explicit",     Gq5NS.gq5Id<int>(10), 11);
    result &= Test("gf_explicit_global",        gq5Id<int>(10),       10);
    return result;
}

// Leg D - VARARGS arity, the `T f<T>(T a, ...)` spelling the fixed-arity legs never reach.
Gq6T gq6First<Gq6T>(Gq6T a, ...) { return a; }
namespace Gq6NS
{
    Gq6T gq6First<Gq6T>(Gq6T a, ...) { return a + 1; }
    int f() { return gq6First<int>(10, 99); }
}

bool testGnNsGfVarargs()
{
    bool result = true;
    result &= Test("gf_varargs_ns",     Gq6NS.f(),                11);
    result &= Test("gf_varargs_global", gq6First<int>(10, 99),    10);
    return result;
}

// Leg E - the layer-2 interaction: the generic function's TYPE ARGUMENT is itself
// namespace-ambiguous. One global template, two same-named argument types.
struct Gq7Item { int v = 9; };
Gq7T gq7Pass<Gq7T>(Gq7T x) { return x; }
namespace Gq7NS
{
    struct Gq7Item { int v = 7; };
    int f() { Gq7Item i = default; Gq7Item r = gq7Pass<Gq7Item>(i); return r.v; }
}
int gq7Global() { Gq7Item i = default; Gq7Item r = gq7Pass<Gq7Item>(i); return r.v; }

bool testGnNsGfTypeArgNamespaceAmbiguous()
{
    bool result = true;
    result &= Test("gf_typearg_ns",     Gq7NS.f(),    7);
    result &= Test("gf_typearg_global", gq7Global(),  9);
    return result;
}

// Leg F - the EXTENSION-METHOD spelling: a `where`-constrained generic free function invoked on a
// class receiver (`t.gq8Ext()`), which routes through the argument/interface inference path rather
// than the explicit-type-argument path.
interface IGq8 { int val(); };
class Gq8Thing : IGq8 { int v = 7; int val() { return v; } };
int gq8Ext<Gq8T>(Gq8T t) where Gq8T : IGq8 { return t.val(); }
namespace Gq8NS
{
    int gq8Ext<Gq8T>(Gq8T t) where Gq8T : IGq8 { return t.val() + 100; }
    // UNIQUE-NAME twin: no global template of this name exists to absorb the call, so this leg
    // fails outright unless the bare spelling reaches the namespace's own key.
    int gq8UniqueExt<Gq8U>(Gq8U t) where Gq8U : IGq8 { return t.val() + 200; }
    int f()       { Gq8Thing t = default; return t.gq8Ext(); }
    int fUnique() { Gq8Thing t = default; return t.gq8UniqueExt(); }
}
int gq8Global() { Gq8Thing t = default; return t.gq8Ext(); }

bool testGnNsGfExtensionMethodReceiver()
{
    bool result = true;
    result &= Test("gf_ext_method_ns",          Gq8NS.f(),       107);
    result &= Test("gf_ext_method_unique_name", Gq8NS.fUnique(), 207);
    result &= Test("gf_ext_method_global",      gq8Global(),       7);
    return result;
}

// Leg L - the INTERFACE-TYPED receiver spelling. A generic free function whose FIRST PARAMETER is
// the generic interface itself (`Ctr<T>`) is inferred from an interface-typed receiver - a
// different dispatch site from leg F's `where`-constrained parameter. Colliding and unique-name
// forms, plus the global control that proves the branch executes at all.
interface IGq16<T> { T get(); };
class Gq16Holder : IGq16<int> { int v = 7; int get() { return v; } };
int gq16Ext<Gq16T>(IGq16<Gq16T> c) { return c.get() + 1; }
namespace Gq16NS
{
    int gq16Ext<Gq16T>(IGq16<Gq16T> c) { return c.get() + 100; }
    int gq16UniqueExt<Gq16U>(IGq16<Gq16U> c) { return c.get() + 200; }
    int f()       { Gq16Holder h = default; IGq16<int> i = h; return i.gq16Ext(); }
    int fUnique() { Gq16Holder h = default; IGq16<int> i = h; return i.gq16UniqueExt(); }
}
int gq16Global() { Gq16Holder h = default; IGq16<int> i = h; return i.gq16Ext(); }

bool testGnNsGfInterfaceReceiverExtension()
{
    bool result = true;
    result &= Test("gf_iface_recv_ns",          Gq16NS.f(),       107);
    result &= Test("gf_iface_recv_unique_name", Gq16NS.fUnique(), 207);
    result &= Test("gf_iface_recv_global",      gq16Global(),       8);
    return result;
}

// Leg G - the instantiated BODY resolves in the template's DECLARING namespace, for a bare call
// from inside it and for a qualified call from outside.
namespace Gq9NS
{
    int gq9Helper() { return 5; }
    Gq9T gq9Add<Gq9T>(Gq9T x) { return x + gq9Helper(); }
    int f() { return gq9Add<int>(10); }
}
int gq9Helper() { return 500; }

bool testGnNsGfBodyNamesDeclaringNsSibling()
{
    bool result = true;
    result &= Test("gf_body_sibling_bare",      Gq9NS.f(),              15);
    result &= Test("gf_body_sibling_qualified", Gq9NS.gq9Add<int>(10),  15);
    result &= Test("gf_body_sibling_global_fn", gq9Helper(),           500);
    return result;
}

// Leg H (MUST-NOT-REGRESS CONTROLS) - the "Owner.method" member-template convention: static and
// instance methods, an owner struct nested in a namespace (key "NS.Struct.method", two dots), and
// an owner struct whose name collides with a real namespace elsewhere.
struct Gq10Holder
{
    static Gq10T identStatic<Gq10T>(Gq10T x) { return x; }
    Gq10T identInstance<Gq10T>(Gq10T x) { return x; }
};
namespace Gq11NS
{
    struct Util { Gq11T identInstance<Gq11T>(Gq11T x) { return x + 5; } };
    int callInside() { Util u = default; return u.identInstance<int>(10); }
}
namespace Gq12Nest { struct Gq12Helper { int v = 9; }; }
struct Gq12Helper { int v = 5; };
struct Gq12Nest
{
    int pad = 0;
    Gq12Helper h = default;
    Gq12T identInstance<Gq12T>(Gq12T x) { return x + h.v; }
};

bool testGnNsGfCtrlMemberTemplates()
{
    bool result = true;
    Gq10Holder h = default;
    result &= Test("gf_member_static",           Gq10Holder.identStatic<int>(5), 5);
    result &= Test("gf_member_instance",         h.identInstance<int>(6),        6);
    Gq11NS.Util u = default;
    result &= Test("gf_member_owner_in_ns_in",   Gq11NS.callInside(),           15);
    result &= Test("gf_member_owner_in_ns_out",  u.identInstance<int>(20),      25);
    Gq12Nest s = default;
    result &= Test("gf_member_owner_vs_ns_name", s.identInstance<int>(10),      15);
    return result;
}

// Leg I - an owner struct inside a namespace whose METHOD template name collides with a free
// generic function of the same name in that namespace AND at global scope. The receiver call must
// keep binding to the member key, the bare call to the namespace's free key.
Gq13T gq13Ident<Gq13T>(Gq13T x) { return x; }
namespace Gq13NS
{
    Gq13T gq13Ident<Gq13T>(Gq13T x) { return x + 100; }
    struct Box { int b = 3; Gq13T gq13Ident<Gq13T>(Gq13T x) { return x + b; } };
    int viaReceiver() { Box bx = default; return bx.gq13Ident<int>(10); }
    int viaFree()     { return gq13Ident<int>(10); }
    // UNIQUE-NAME twin: a member template and a free template sharing a name that exists NOWHERE
    // globally, so neither call can be absorbed by a global key.
    struct Box2 { int b = 4; Gq13U gq13Uniq<Gq13U>(Gq13U x) { return x + b; } };
    Gq13U gq13Uniq<Gq13U>(Gq13U x) { return x + 300; }
    int uniqViaReceiver() { Box2 bx = default; return bx.gq13Uniq<int>(10); }
    int uniqViaFree()     { return gq13Uniq<int>(10); }
}

bool testGnNsGfMemberVsFreeNameCollision()
{
    bool result = true;
    result &= Test("gf_member_vs_free_receiver",      Gq13NS.viaReceiver(),     13);
    result &= Test("gf_member_vs_free_bare",          Gq13NS.viaFree(),        110);
    result &= Test("gf_member_vs_free_global",        gq13Ident<int>(10),       10);
    result &= Test("gf_member_vs_free_uniq_receiver", Gq13NS.uniqViaReceiver(),  14);
    result &= Test("gf_member_vs_free_uniq_bare",     Gq13NS.uniqViaFree(),     310);
    return result;
}

// Leg J (CONTROL) - struct nesting and namespace nesting share one dotted key space, so the member
// key "Gq14Own.mget" and a `namespace Gq14Own` look alike. The declaring namespace is RECORDED at
// registration, so a bare call inside `namespace Gq14Own` must NOT reach the struct's member
// template; it takes the global free one. Correct on both binaries - a tripwire, not a fix.
Gq14T gq14Mget<Gq14T>(Gq14T x) { return x; }
struct Gq14Own { int b = 50; Gq14T gq14Mget<Gq14T>(Gq14T x) { return x + b; } };
namespace Gq14Own { int f() { return gq14Mget<int>(10); } }
// The OPPOSITE direction of the same collision, and a false rejection before it was fixed: a FREE
// template in `namespace Gq17Ov` is keyed "Gq17Ov.gq17F", which a last-dot split reads as a method
// on `struct Gq17Ov` and lowers with an implicit `this`. Static and no-struct forms included.
struct Gq17Ov { int v = 3; };
namespace Gq17Ov
{
    Gq17T gq17F<Gq17T>(Gq17T x) { return x + 5; }
    int use() { return gq17F<int>(10); }
}
namespace Gq18NoStruct
{
    Gq18T gq18F<Gq18T>(Gq18T x) { return x + 5; }
    int use() { return gq18F<int>(10); }
}

bool testGnNsGfCtrlOwnerStructNameEqualsNamespace()
{
    bool result = true;
    Gq14Own o = default;
    result &= Test("gf_owner_ns_name_bare",      Gq14Own.f(),             10);
    result &= Test("gf_owner_ns_name_member",    o.gq14Mget<int>(10),     60);
    result &= Test("gf_owner_ns_name_global",    gq14Mget<int>(10),       10);
    result &= Test("gf_free_tpl_ns_name_bare",   Gq17Ov.use(),            15);
    result &= Test("gf_free_tpl_ns_name_qual",   Gq17Ov.gq17F<int>(10),   15);
    result &= Test("gf_free_tpl_no_struct_ctrl", Gq18NoStruct.use(),      15);
    return result;
}

// Leg K (CONTROL) - a bare call from inside a STRUCT METHOD body in a namespace does NOT see the
// namespace, so it takes the global template. Pinned together with its NON-GENERIC control, which
// answers the same way: this is a general namespace-scope limit, not a generic-function one.
Gq15T gq15Id<Gq15T>(Gq15T x) { return x; }
int gq15Plain(int x) { return x; }
namespace Gq15NS
{
    Gq15T gq15Id<Gq15T>(Gq15T x) { return x + 1; }
    int gq15Plain(int x) { return x + 1; }
    struct S { int mGeneric() { return gq15Id<int>(10); } int mPlain() { return gq15Plain(10); } };
    int freeGeneric() { return gq15Id<int>(10); }
    int freePlain()   { return gq15Plain(10); }
}

bool testGnNsGfCtrlStructMethodBodyScope()
{
    bool result = true;
    Gq15NS.S s = default;
    result &= Test("gf_method_body_generic",  s.mGeneric(),        10);
    result &= Test("gf_method_body_plain",    s.mPlain(),          10);
    result &= Test("gf_free_body_generic",    Gq15NS.freeGeneric(), 11);
    result &= Test("gf_free_body_plain",      Gq15NS.freePlain(),   11);
    return result;
}

// =============================================================
// Canonical primitive spellings in a type argument
// `int` and `i32` are ONE type, so they must monomorphize to ONE instantiation. They used to
// produce two LLVM types of identical layout that did not interconvert. Signedness and the
// target-native widths are deliberately NOT folded - the control legs below pin that, since
// over-folding would silently merge two genuinely different instantiations.
// =============================================================

struct CanonBox<T> { T v = default; };

int canonTakesInt(CanonBox<int> b)   { return b.v; }
int canonTakesShort(CanonBox<short> b) { return (int)b.v; }
int canonSumList(list<int> xs)
{
    int total = 0;
    for (int i = 0; i < xs.count(); i++) total += xs[i];
    return total;
}

// Controls: each pair must stay TWO distinct instantiations, so both overloads are selectable.
int canonWhichSign(CanonBox<i32> b) { return 1; }
int canonWhichSign(CanonBox<u32> b) { return 2; }
int canonWhichLong(CanonBox<i64> b) { return 3; }
int canonWhichLong(CanonBox<long> b) { return 4; }

// A pure-rename `using` alias is transparent the way a C typedef is, so it must NOT monomorphize
// as its own type: list<CanonAliasInt> and list<int> are one instantiation. Written FIRST, before
// the `using` below, on purpose - the forward-ref scan mangles every generic use in the file
// before it reaches the first `using`, so this leg pins the two passes to one mangled name.
int canonAliasUsedBeforeUsing(list<CanonAliasInt>* p) { return (int)p->count(); }

using CanonAliasInt  = int;
using CanonAliasInt2 = CanonAliasInt;   // alias-of-alias: must still reach i32
struct CanonAliasS { int v = default; };
using CanonAliasS2 = CanonAliasS;       // alias of a struct, not a primitive

int canonAliasTakesIntList(list<int>* p)          { return (int)p->count(); }
int canonAliasTakesStructList(list<CanonAliasS>* p) { return (int)p->count(); }
int canonAliasTakesBox(CanonBox<int> b)           { return b.v; }
// Closure encoder leg: Lambda<int(CanonAliasInt)> must encode as __fatfn_1_3_i32_3_i32.
int canonAliasTakesFnList(list<Lambda<int(int)>>* p) { return (int)p->count(); }

bool testGnCanonicalPrimitiveTypeArg()
{
    bool result = true;

    CanonBox<i32> bi = default; bi.v = 7;
    result &= Test("canon_i32_binds_int_param", canonTakesInt(bi), 7);

    CanonBox<int> bn = default; bn.v = 9;
    CanonBox<i32> cross = bn;                       // assignment across the two spellings
    result &= Test("canon_int_assigns_to_i32", cross.v, 9);

    CanonBox<i16> bs = default; bs.v = (i16)11;
    result &= Test("canon_i16_binds_short_param", canonTakesShort(bs), 11);

    list<i32> xs = default;
    xs.add(20); xs.add(22);
    result &= Test("canon_list_i32_binds_list_int", canonSumList(xs), 42);

    CanonBox<i32> s1 = default;
    CanonBox<u32> s2 = default;
    result &= Test("canon_ctrl_signed_distinct",   canonWhichSign(s1), 1);
    result &= Test("canon_ctrl_unsigned_distinct", canonWhichSign(s2), 2);

    CanonBox<i64>  l1 = default;
    CanonBox<long> l2 = default;
    result &= Test("canon_ctrl_i64_distinct",  canonWhichLong(l1), 3);
    result &= Test("canon_ctrl_long_distinct", canonWhichLong(l2), 4);

    // A pure-rename alias binds a parameter written with the underlying type - one instantiation.
    list<CanonAliasInt> al;
    al.add(7);
    result &= Test("alias_list_binds_list_int", canonAliasTakesIntList(&al), 1);
    // ... and the same list binds the parameter written with the alias, from the use-before-`using`
    // function above: both passes have to have produced the SAME mangled name for it to resolve.
    result &= Test("alias_list_binds_use_before_using", canonAliasUsedBeforeUsing(&al), 1);

    // Alias of an alias chases to the same underlying instantiation.
    list<CanonAliasInt2> al2;
    al2.add(4); al2.add(5);
    result &= Test("alias_chain_binds_list_int", canonAliasTakesIntList(&al2), 2);

    CanonBox<CanonAliasInt2> ab = default; ab.v = 13;
    result &= Test("alias_chain_binds_box_int", canonAliasTakesBox(ab), 13);

    // A struct alias unifies too - the fold is not primitive-only.
    list<CanonAliasS2> asl;
    CanonAliasS one = default; one.v = 1;
    asl.add(one);
    result &= Test("alias_struct_binds_list_struct", canonAliasTakesStructList(&asl), 1);

    // The closure encoder builds its name from raw source text as well: an alias inside a
    // signature must encode as the underlying type, or the two list<Lambda<...>> split.
    list<Lambda<int(CanonAliasInt)>> af;
    af.add((int x) => x + 1);
    result &= Test("alias_closure_param_unifies", canonAliasTakesFnList(&af), 1);

    return result;
}

// =============================================================
// The opaque-shell gate in the forward-ref scan. It used to pre-declare an unsized struct shell
// for EVERY bare `Name<Args>`, which ate two live shapes below and suppressed the `unknown type`
// diagnostic an undeclared generic is owed (the negative half lives in
// Test/errors/err_unknown_type_arg_qualifier.cb).
// =============================================================

// A generic FUNCTION taking NO arguments: `gsMk<int>()` parses as a generic TYPE construction, so
// it reached the shell path and the declared body was never emitted - the call then died on
// "cannot cast an aggregate value". The one-argument sibling never had the bug (it parses as a
// call), so it is the control that proves this leg is about the EMPTY argument list.
int gsMk<T>() { return 5; }
int gsMk1<T>(int u) { return u + 5; }

// ACCEPT-SET leg for the gate. A generic CLASS declared inside an `if const` arm the forward scan
// cannot FOLD (`sizeof` is deliberately unfoldable) is absent from the template KEY SPACE by
// design - an invented key is a false rejection - so a gate keyed only on that space would refuse
// it a shell and false-reject this file. The discriminator is the SIGNATURE below: a plain local
// declaration of the type needs no shell (the main pass instantiates the template itself), but a
// function signature naming it is parsed by the forward scan, which resolves the type before the
// main pass runs. Test/errors/err_lambda_array_view.cb and err_data_pointer_to_closure_param.cb
// are the expect_error-block twins of the same region rule. The arm IS taken on every host.
if const (sizeof(int) == 4) {
    class GsUncertainBox<T> { T v = default; };
    int gsUncertainRead(GsUncertainBox<int>* b) { return b->v; }
}

// ACCEPT-SET legs for the gate, alias face. `using X = Template;` names a generic BASE, and the
// forward scan only learns that through IsGenericTemplateKey - the main-pass template maps it used
// to consult are still empty for a template declared in THIS file. Without that the alias is not
// registered as a generic base, the gate refuses the shell, and a SIGNATURE naming the alias dies
// on `unknown type`. A plain local declaration of the alias never needed the shell, so the
// signature position is the discriminator here too.
class GsAliasBox<T> { T v = default; };
using GsAliasBase = GsAliasBox;
int gsAliasRead(GsAliasBase<int> b) { return b.v; }

using GsChainAlias = GsAliasBase;
int gsChainRead(GsChainAlias<int>* b) { return b->v; }

namespace GsNs { class GsNsBox<T> { T v = default; }; }
using GsNsBase = GsNs.GsNsBox;
int gsNsRead(GsNsBase<int>* b) { return b->v; }

bool testGnUnresolvedGenericShellGate()
{
    bool result = true;

    result &= Test("gs_zero_arg_generic_fn_call", gsMk<int>(), 5);
    result &= Test("gs_one_arg_generic_fn_ctrl",  gsMk1<int>(1), 6);

    GsUncertainBox<int> ub = default;
    ub.v = 21;
    result &= Test("gs_ifconst_uncertain_template_use", gsUncertainRead(&ub), 21);

    GsAliasBase<int> ab = default;
    ab.v = 4;
    result &= Test("gs_same_tu_base_alias_in_signature", gsAliasRead(ab), 4);

    GsChainAlias<int> cb = default;
    cb.v = 3;
    result &= Test("gs_alias_of_alias_in_signature", gsChainRead(&cb), 3);

    GsNsBase<int> nb = default;
    nb.v = 6;
    result &= Test("gs_namespaced_base_alias_in_signature", gsNsRead(&nb), 6);

    return result;
}


// ---------------------------------------------------------------
// Pointer-depth gate vs generic substitution
// ---------------------------------------------------------------
// PeelTypeArgSuffix carries a type argument's stars as a real DEPTH, so PdgBox<PdgC**> mangles
// PdgBox__PdgCptrptr and its substituted `T x` parameter is a proven PdgC** - a distinct
// instantiation from PdgBox<PdgC*>, and one the overload depth gate can judge.
class PdgC { int r = 0; };
int pdgPick(PdgC* c) { return 1; }
int pdgPick(PdgC** c) { return 2; }
class PdgBox<T> { T v = default; int put(T x) { v = x; return 1; } T get() { return v; }
                  int which() { return pdgPick(v); } };
// Overloaded on the two INSTANTIATIONS: while both mangled to PdgBox__PdgCptr this pair was a
// redefinition, so the fact that it compiles at all is the distinctness proof.
int pdgWhichBox(PdgBox<PdgC*> b) { return 1; }
int pdgWhichBox(PdgBox<PdgC**> b) { return 2; }
int pdgId<T>(T x) { return 7; }
int pdgThin(PdgC* c) { return 100 + c->r; }

bool testGnPointerDepthSubstitution()
{
    bool result = true;

    PdgC* a = new PdgC();
    a->r = 3;
    PdgC** pp = &a;

    // A 'C**' argument into a substituted 'T' parameter - now a proven 'C**' on both sides.
    PdgBox<PdgC**> deep = default;
    result &= Test("pdg_ptrptr_typearg_put", deep.put(pp), 1);
    PdgC** back = deep.get();
    result &= Test("pdg_ptrptr_typearg_roundtrip", (*back)->r, 3);

    // The depth-1 instantiation of the same template keeps working.
    PdgBox<PdgC*> thin = default;
    result &= Test("pdg_ptr_typearg_put", thin.put(a), 1);
    result &= Test("pdg_ptr_typearg_roundtrip", thin.get()->r, 3);

    // A generic FUNCTION's substituted parameter, same collapse.
    result &= Test("pdg_ptrptr_generic_fn", pdgId<PdgC**>(pp), 7);
    result &= Test("pdg_ptr_generic_fn", pdgId<PdgC*>(a), 7);

    // Core containers reach the same substitution path.
    list<PdgC**> lst = default;
    lst.add(pp);
    PdgC** lback = lst.get(0);
    result &= Test("pdg_ptrptr_list_roundtrip", (*lback)->r, 3);
    dictionary<int, PdgC**> dict = default;
    dict.add(1, pp);
    PdgC** dback = dict.get(1);
    result &= Test("pdg_ptrptr_dict_roundtrip", (*dback)->r, 3);

    // A depth-1 value flowing OUT of a template still binds a plain 'C*' parameter.
    result &= Test("pdg_typearg_value_into_thin_param", pdgThin(thin.get()), 103);

    // The two instantiations are DISTINCT types: overloading on them is legal, and each picks
    // its own overload. While the stars collapsed, this pair was a redefinition error.
    result &= Test("pdg_distinct_instantiation_thin", pdgWhichBox(thin), 1);
    result &= Test("pdg_distinct_instantiation_deep", pdgWhichBox(deep), 2);

    // The substituted FIELD/parameter carries the real depth, so a call from inside the template
    // body picks the 'C**' overload for T = C** and the 'C*' one for T = C*.
    result &= Test("pdg_substituted_field_picks_ptrptr", deep.which(), 2);
    result &= Test("pdg_substituted_field_picks_ptr", thin.which(), 1);

    // The value flowing OUT of the deep instantiation is a proven 'C**' at the call site too.
    result &= Test("pdg_typearg_value_picks_ptrptr", pdgPick(deep.get()), 2);
    result &= Test("pdg_typearg_value_picks_ptr", pdgPick(thin.get()), 1);

    return result;
}

struct GenericCellForTests { int value = 6; };

namespace TupleChecks
{
    using CellAlias = GenericCellForTests;

    int run()
    {
        (int, float) tupleValue = default;
        tupleValue.item_0 = 4;
        list<CellAlias> cells = default;
        CellAlias cell = default;
        cells.add(cell);
        return tupleValue.item_0 + cells[0].value;
    }
}

bool testNamespaceTupleAndGenericAlias()
{
    return Test("namespace_tuple_and_alias", TupleChecks.run(), 10) != 0;
}

