import "library/testmodule.cb";
import "test_helper.cb";
import "list.cb";
import "thread.cb";
import "library/prog_lib.cb";
import "library/ns_math.cb" as MyMath;

// ---- C module interop ----

bool testImportedFunctions()
{
    bool result = true;
    result &= Test("moduleAdd",      moduleAdd(3, 4),      7);
    result &= Test("moduleMultiply", moduleMultiply(3, 4), 12);
    return result;
}

bool testImportedStruct()
{
    bool result = true;
    ModulePoint p = ModulePoint();
    p.x = 10;
    p.y = 20;
    result &= Test("ModulePoint.Sum",    p.Sum(),    30);
    result &= Test("ModulePoint.Scale2", p.Scale(2), 60);
    return result;
}

bool testImportedGlobalDefaultFold()
{
    bool result = true;
    result &= Test("imported global default fold", getImportedDefaultFold(), 17);
    return result;
}

bool testImportedNamespace()
{
    bool result = true;
    result &= Test("ModuleMath.square", ModuleMath.square(4), 16);
    result &= Test("ModuleMath.cube",   ModuleMath.cube(3),   27);
    return result;
}

// ---- import "file" as Alias ----

bool testImportAs()
{
    bool result = true;
    result &= Test("MyMath.square",    MyMath.square(5),     25);
    result &= Test("MyMath.add",       MyMath.add(3, 4),      7);
    result &= Test("MyMath.main",      MyMath.main(),        99);
    MyMath.Point p;
    p.x = 10;
    p.y = 20;
    result &= Test("MyMath.Point.x",   p.x,                  10);
    result &= Test("MyMath.Point.y",   p.y,                  20);
    result &= Test("MyMath.point_sum", MyMath.point_sum(&p), 30);
    return result;
}

// ---- a VARIABLE shadows a same-named namespace ----
// The postfix primary walk used to take its namespace branch on the name alone, so a variable
// spelled like a namespace ('os' from the auto-imported core, 'ModuleMath' from the imported
// test library) resolved to a namespace qualifier and produced an EMPTY value with no
// diagnostic: a bare read silently gave 0 and any other use crashed the compiler (SIGSEGV).
// testImportedNamespace/testImportAs above are the unshadowed twins - the same spellings still
// resolve as namespaces where no variable of that name is in scope.

int os = 5;

int shadowNsParam(int os) { return os + 1; }

// Member access through a struct local spelled like a namespace. Its own function so the name
// 'ModuleMath' is bound to the struct, not to the int local used by the arithmetic legs.
// PRE-FIX: "'x' is not a member of namespace 'ModuleMath'".
int shadowNsStructMember()
{
    ModulePoint ModuleMath;
    ModuleMath.x = 10;
    ModuleMath.y = 20;
    return ModuleMath.Sum();
}

bool testVariableShadowsNamespace()
{
    bool result = true;
    // Global spelled like a namespace. PRE-FIX: compiler SIGSEGV (exit 139).
    result &= Test("shadow_ns_global_arith", os + 1, 6);
    // Parameter spelled like a namespace. PRE-FIX: compiler SIGSEGV (exit 139).
    result &= Test("shadow_ns_param", shadowNsParam(6), 7);

    // Local spelled like an imported namespace. PRE-FIX these read the namespace, not the
    // local: rejected outright, or (as a plain initializer) a silent 0.
    int ModuleMath = 12;
    result &= Test("shadow_ns_local_bare",  ModuleMath,      12);
    result &= Test("shadow_ns_local_arith", ModuleMath + 30, 42);
    bool cc = true;
    result &= Test("shadow_ns_local_ternary", cc ? ModuleMath : 0, 12);

    // The filed repro: a local fixed array decayed into a view whose name is a namespace, then
    // joined by '?:'. PRE-FIX: compiler SIGSEGV (exit 139).
    u8 [4] backing;
    backing[0] = 7;
    backing[1] = 9;
    u8[] os = backing;
    u8[] joined = cc ? os : os;
    result &= Test("shadow_ns_view_ternary_elem0", joined[0], 7);
    result &= Test("shadow_ns_view_ternary_elem1", joined[1], 9);

    result &= Test("shadow_ns_struct_member", shadowNsStructMember(), 30);
    return result;
}

// ---- program defined in an imported library file ----
// Regression: CompileImportedFile must run ScanGenericTypeUses before
// ScanExternalDeclaration so the opaque shell for list$string is present
// when ScanProgramDefinition pre-declares run().

bool testProgramImport()
{
    list<string> args;
    LibProgram p;
    p.run(args);
    p.WaitForExit();
    bool result = true;
    result &= Test("program in imported file: result", p.result, 42);
    return result;
}

// Cross-file generic type alias: ModuleIntList = list<int> is declared in the imported
// library/testmodule.cb and used here in the importer.
bool testCrossFileAlias()
{
    ModuleIntList xs;
    xs.add(10);
    xs.add(20);
    xs.add(12);
    bool result = true;
    result &= Test("crossfile_alias_count", xs.count(), 3);
    result &= Test("crossfile_alias_sum",   xs.get(0) + xs.get(1) + xs.get(2), 42);

    // Pointer alias declared in the imported module.
    int n = 7;
    ModuleIntPtr p = &n;
    result &= Test("crossfile_ptr_alias", *p, 7);

    // Array alias declared in the imported module.
    ModuleVec v = default;
    v[0] = 1; v[3] = 41;
    result &= Test("crossfile_arr_alias_sum",    v[0] + v[3], 42);
    result &= Test("crossfile_arr_alias_sizeof", sizeof(ModuleVec), 16);
    return result;
}

extern int main()
{
    int passed = 0;
    int total  = 0;
    total++; passed += testCrossFileAlias()    ? 1 : 0;
    total++; passed += testImportedFunctions() ? 1 : 0;
    total++; passed += testImportedStruct()    ? 1 : 0;
    total++; passed += testImportedGlobalDefaultFold() ? 1 : 0;
    total++; passed += testImportedNamespace() ? 1 : 0;
    total++; passed += testVariableShadowsNamespace() ? 1 : 0;
    total++; passed += testImportAs()          ? 1 : 0;
    total++; passed += testProgramImport()     ? 1 : 0;
    printf("%d/%d tests passed.\n", passed, total);
    return passed == total ? 0 : 1;
}
