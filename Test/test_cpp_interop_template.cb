        if (alnKeepQual.value != 9)                                          return 2219;
        cppta.CellAlias<int> alnKeepCtor = cppta.CellAlias<int>();
        if (alnKeepCtor.value != 9)                                          return 2220;
        GCellAlias<int> alnKeepGlobal = default;
        if (alnKeepGlobal.value != 9)                                        return 2221;

