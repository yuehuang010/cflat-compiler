         * Pre-fix the conversion-operator branch scored the same rank as a standard sequence,
         * so 2373 and 2376/2377 were decided by DECLARATION ORDER and 2374 never compared the
         * second standard conversion. 2377 is 2376 with the two declarations swapped: the
         * answer must not move.
         */
        Conv c = Conv(7);
        if (ovl_a(c) != 2)                            // identity `const Conv&` beats operator int
                                                                             return 2373;
        if (ovl_b(c) != 10)                           // operator int -> int beats -> double
                                                                             return 2374;
        Both bt = default;
        if (ovl_c(bt) != 30)                          // exact `operator bool` wins outright
                                                                             return 2375;
        Der2 d2 = default;
        if (ovl_f(d2) != 109)                         // derived-to-base bind beats operator int
                                                                             return 2376;
        Der3 d3 = default;
        if (ovl_g(d3) != 109)                         // same pair, declarations swapped
                                                                             return 2377;
    }
    {
        /*
         * LIFETIME. Every one of these sites materializes a LifeRef temporary that must be
         * destroyed; the counters are the RESOURCE assertion, not the values. The return path
         * regressed here first: it unregistered the proxy as the returned value and then never
         * destroyed it (ctor=200, dtor=0), because the caller receives the converted bool.
         * ctor > 0 is asserted too, so a leg that stopped materializing cannot pass vacuously.
         */
        LifeBag lb = default;
        int lbefore = life_ctor();
        int hits = 0;
        for (int i = 0; i < 50; i++)
        {
            bool li = lb[0];                          // initializer
            if (li) hits += 1;
            bool la = false;
            la = lb[0];                               // assignment
            if (la) hits += 1;
            hits += (int)lb[0];                       // explicit cast
            hits += life_take_bool(lb[0]);            // call argument
        }
        if (hits != 200)                                                     return 2378;
        if (life_ctor() - lbefore < 200 || life_ctor() != life_dtor())       return 2379;

        int rbefore = life_ctor();
        for (int i = 0; i < 50; i++) { if (life_bool_return(&lb)) hits += 1; }
        if (hits != 250 || life_ctor() - rbefore < 50
            || life_ctor() != life_dtor())                                   return 2364;
    }

    return 0;
}
