        if ((int)vb[0] != 1 || (int)vb[1] != 0)                              return 2354;

        if (proxy_take_bool(vb[0]) != 7 || proxy_take_bool(vb[1]) != 3)      return 2355;
        if (proxy_take_int(vb[0]) != 101)             // call argument, int parameter
                                                                             return 2356;
        if (!proxy_bool_return(&vb))                  // return value of a CFlat function
                                                                             return 2357;
        if ((vb[0] ? 5 : 6) != 5)                                            return 2358;
