        if (alnGlobal.v != 6)                                                return 2214;  // was 4

        // The alias in a FILE-SCOPE CFlat signature (ForwardRefScanner copy of the type path).
        alna.NBdef<int> alnFromFn = alnpat_make_nbdef();
