        // value back into it on failure, so the two legs below also prove the T& parameter binds.
        int atmExpect = 7;
        if ((int)atmI.compare_exchange_strong(atmExpect, 9) != 1)            return 2109;
        if (atmI.load() != 9)                                                return 2110;
        int atmStale = 100;
        if ((int)atmI.compare_exchange_strong(atmStale, 1) != 0)             return 2111;
        if (atmStale != 9)                                                   return 2112;
        if (atmI.load() != 9)                                                return 2113;

