        bool vbInit0 = vb[0];                         // initializer
        bool vbInit1 = vb[1];
        if (!vbInit0 || vbInit1)                                             return 2351;

        bool vbAssign = false;                        // assignment to an existing bool
        vbAssign = vb[0];
        bool vbAssignHigh = vbAssign;
        vbAssign = vb[1];
