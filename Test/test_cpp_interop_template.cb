    // ---- C++ ALIAS TEMPLATES, declaration and CONSTRUCTOR spelling ------------------------------
    // 1581 and 1583 are the discriminators: the constructor spelling of an alias template was
    // refused as "the function 'CellAlias' is not known" / "unknown generic function 'GCellAlias'",
    // because the call path looked the name up in the function tables while the declaration path
    // desugared it. The `= default` legs pin that the declaration spelling still resolves.
    cppta.CellAlias<int> cellaliasCtor = cppta.CellAlias<int>();
    if (cellaliasCtor.value != 9)                         return 1581;
    cppta.CellAlias<int> cellaliasDecl = default;
    if (cellaliasDecl.value != 9)                         return 1582;
    GCellAlias<int> gcellaliasCtor = GCellAlias<int>();
    if (gcellaliasCtor.value != 9)                        return 1583;
    // The alias and the aliased template must reach ONE record: these header functions take the
    // ALIASED specialization by reference, so a second registration would not bind here.
    if (gcellalias_take(gcellaliasCtor) != 11)            return 1584;
    if (cellalias_take(cellaliasCtor) != 12)              return 1585;
    // An alias template inside a NESTED namespace, constructor-called.
    cppta.deep.DeepCellAlias<int> cellaliasDeep = cppta.deep.DeepCellAlias<int>();
    if (cellaliasDeep.value != 9)                         return 1586;

    // ---- C++ member ref-qualifiers --------------------------------------------------------------
    cppt.RefQualAssignBox refqualA = cppt.RefQualAssignBox(1);
    cppt.RefQualAssignBox refqualAlias = refqualA;
    cppt.RefQualAssignBox refqualB = cppt.RefQualAssignBox(2);
    refqualA = refqualB;
    if (refqualA.tag != 1 || refqualA.value != 2) return 1640;
    if (refqualAlias.value != 1) return 1641;
    refqualA = move refqualB;
    if (refqualA.tag != 3 || refqualA.value != 202) return 1642;

    cppt.RefQualFieldHolder refqualField = default;
    refqualField.box = refqualA;
    if (refqualField.box.tag != 1 || refqualField.box.value != 202) return 1643;
    cppt.RefQualAssignBox* refqualPtr = &refqualField.box;
    *refqualPtr = refqualAlias;
    if (refqualField.box.tag != 1 || refqualField.box.value != 1) return 1644;

    cppt.RefQualSlotHolder refqualSlots = default;
    refqualSlots[0] = refqualA;
    if (refqualSlots[0].tag != 1 || refqualSlots[0].value != 202) return 1645;
    std.vector<cppt.RefQualAssignBox> refqualVector = default;
    refqualVector.push_back(refqualAlias);
    refqualVector[0] = refqualA;
    if (refqualVector[0].tag != 1 || refqualVector[0].value != 202) return 1652;

    cppt.RefQualMethods refqualMethod = cppt.RefQualMethods(1);
    if (refqualMethod.both() != 11) return 1646;
    if (refqualMethod.onlyL() != 44) return 1647;
    if (refqualMethod.plain() != 55) return 1648;
    if (cppt.refqual_make_methods(2).both() != 22) return 1649;
    if ((move refqualMethod).both() != 22) return 1650;
    cppt.RefQualMethods refqualNullMethod = cppt.RefQualMethods(3);
    cppt.RefQualMethods* refqualMethodPtr = &refqualNullMethod;
    if (refqualMethodPtr?.both() != 11) return 1651;
    if (cppt.RefQualMethods(1).with(2).with(3).marker != 206) return 1653;
    if (cppt.RefQualMethods(8)[2] != 202) return 1654;
    if (cppt.RefQualMethods(4).onlyR() != 33) return 1655;
    if (cppt.RefQualMethods(4).plain() != 55) return 1656;
    if (cppt.RefQualMethods({4}).with(2).marker != 106) return 1657;
    if (cppt.RefQualMethods(4)?.both() != 22) return 1658;

    // ---- standard-library free functions and nested namespaces ----------------------------------
    int stdfreeResult = stdfree_standard();
    if (stdfreeResult != 0) return stdfreeResult;
    int stdfreeOrder = stdfree_import_order();
    if (stdfreeOrder != 0) return stdfreeOrder;

    // ---- namespaces whose every declaration names a std:: specialization ------------------------
    // Binding such a signature is deferred to first use; the namespace must be registered
    // anyway, or the call reports "Undefined variable <ns>" and the whole API is unreachable.
    std.string stdnsS = std.string("abcd");
    if (nsstd_param.lens(stdnsS) != 4) return 1710;
    std.string stdnsR = nsstd_ret.makes("abcde");
    if ((int)stdnsR.size() != 5) return 1711;
    std.vector<int> stdnsV = default;
    stdnsV.push_back(1);
    stdnsV.push_back(2);
    if (nsstd_vec.usevec(stdnsV) != 22) return 1712;
    if (nsstd_outer.inner.lens(stdnsS) != 5) return 1713;
    // Control: nsstd_mix holds one std-free declaration, which registered it even pre-fix.
    if (nsstd_mix.lens(stdnsS) != 11) return 1714;
    if (nsstd_mix.plain(5) != 7) return 1715;

    // ---- qualified C++ class-template constructor temporaries -----------------------------------
    if (qualtemp_take_box(cppt.Box<int>(9)) != 9) return 1730;
    if (cppt.take_box_arg(cppt.Box<int>(10)) != 10) return 1731;
    cppt.CtorTempSink qualtempSink = default;
    if (qualtempSink.take(cppt.Box<int>(11)) != 12) return 1732;
    if (cppt.make_box(cppt.Box<int>(12)).get().get() != 12) return 1733;
    if (qualtempSink.take_any(cppt.Box<int>(13)) != 15) return 1734;
    if (qualtemp_return_box(14).get() != 14) return 1735;
    std.optional<int> qualtempAssigned = default;
    qualtempAssigned = std.optional<int>(16);
    if (!qualtempAssigned.has_value() || qualtempAssigned.value() != 16) return 1736;
    if (qualtemp_take_box(cppt.Box<int>()) != 0) return 1737;
    if (qualtemp_take_pair(cppt.CtorPair<int>(16, 17)) != 33) return 1738;
    if (qualtemp_take_nested(cppt.Box<cppt.Box<int>>(cppt.Box<int>(18))) != 18) return 1739;
    if (qualtemp_take_nested2(cppt.Box<cppt.Box<cppt.Box<int>>>(
            cppt.Box<cppt.Box<int>>(cppt.Box<int>(19)))) != 19) return 1740;
    cppt.impl_detail.Payload qualtempPayload = default;
    if (qualtemp_take_payload(cppt.Box<cppt.impl_detail.Payload>(qualtempPayload)) != 3) return 1741;
    cppt.Box<cppt.impl_detail.Payload> qualtempPayloadBox =
        cppt.Box<cppt.impl_detail.Payload>(qualtempPayload);
    if (qualtempPayloadBox.get().get() != 3) return 1742;
    cppt.Box<cppt.Box<int>> qualtempNestedDecl =
        cppt.Box<cppt.Box<int>>(cppt.Box<int>(20));
    if (qualtempNestedDecl.get().get() != 20) return 1743;
    if (qualtemp_take_nested(cppt.Box<cppt.Box<int>>(cppt.Box<int>(21))) != 21) return 1744;
    if (cppt.take_box_arg(cppt.Box<int>(22)) != 22) return 1745;
    cppt.Box<double> qualtempDouble = cppt.Box<double>(2.5);
    if (qualtempDouble.get() != 2.5) return 1746;
    cppt.Box<int> qualtempDecl = cppt.Box<int>(23);
    if (qualtempDecl.get() != 23) return 1747;
    if (cppt.make_box(cppt.Box<int>()).get().get() != 0) return 1748;
    if (qualtemp_return_box(24).get() != 24) return 1749;

    // ---- static members of a C++ class TEMPLATE -------------------------------------------------
    // Every leg goes through the qualified-specialization spelling `cppt.TplStatics<T>.member`.
    // PRE-FIX (532e7bd0): each of these fails name lookup with
    // "'TplStatics' is not a member of namespace 'cppt'."
    cppt.TplStatics<int> tplstaticDeclared = default;
    if (tplstaticDeclared.x != 0) return 1810;
    if (cppt.TplStatics<int>.rank() != 7) return 1811;              // static method, 0 args
    if (cppt.TplStatics<int>.twice(5) != 10) return 1812;           // 1 arg
    if (cppt.TplStatics<int>.combine(4, 3) != 43) return 1813;      // 2 args
    // No `TplStatics<double>` is declared anywhere: the static call alone instantiates it.
    if (cppt.TplStatics<double>.rank() != 7) return 1814;
    if (cppt.TplStatics<double>.twice(2.5) != 5.0) return 1815;
    if (cppt.TplStatics<double>.combine(4.0, 3.0) != 43.0) return 1816;
    // Static DATA member: read, write, and per-specialization storage.
    if (cppt.TplStatics<int>.counter != 0) return 1817;
    cppt.TplStatics<int>.counter = 9;
    if (cppt.TplStatics<int>.counter != 9) return 1818;
    if (cppt.TplStatics<float>.counter != 0) return 1819;
    if (cppt.TplStatics<int>.kTag != 41) return 1820;               // static constexpr member
    // Specialization over a user C++ class, and over another specialization.
    cppt.TplStaticPayload tplstaticPayload = cppt.TplStaticPayload(6);
    if (cppt.TplStaticWrap<cppt.TplStaticPayload>.rank() != 3) return 1821;
    if (cppt.TplStaticWrap<cppt.TplStaticPayload>.score(tplstaticPayload) != 11) return 1822;
    if (cppt.TplStaticNest<cppt.TplStatics<int>>.depth() != 2) return 1823;
    if (cppt.TplStaticNest<cppt.TplStatics<int>>.fromInner(tplstaticDeclared) != 1) return 1824;
    // Call positions: as a C++ call argument, as a plain assignment statement.
    if (cppt.tplstatic_take(cppt.TplStatics<int>.rank()) != 1007) return 1825;
    int tplstaticAssigned = cppt.TplStatics<int>.combine(1, 2);
    if (tplstaticAssigned != 12) return 1826;
    // The same spelling inside a CFlat generic body, on the body's own T.
    if (tplstaticTwiceStatic<int>(5) != 10) return 1827;
    if (tplstaticTwiceStatic<double>(1.5) != 3.0) return 1828;
    if (tplstaticRankStatic<float>() != 7) return 1829;

    // ---- a string LITERAL as a C++ operator operand ---------------------------------------------
    // Pre-fix every literal leg below reported "no overload of 'operator...' matches the given
    // arguments" with the matching char* candidate listed, because the literal was wrapped as a
    // CFlat 'string' before the candidates were ranked.
    std.string strlitS = std.string("hello");
    strlitS += " world";
    if ((int)strlitS.size() != 11) return 1790;
    strlitS += "!";
    if ((int)strlitS.size() != 12) return 1791;

    // Both a char* and a std::string overload are declared: C++ picks char* for a literal.
    cppsop.Acc strlitA = cppsop.Acc();
    strlitA += "hello";
    if (strlitA.tag() != 1) return 1792;
    if (strlitA.n() != 5) return 1793;
    // Control: a CHAR literal keeps selecting the 'char' leg, before and after the fix.
    strlitA += 'z';
    if (strlitA.tag() != 3) return 1794;
    if (strlitA.n() != 6) return 1795;

    cppsop.CharOnly strlitC = cppsop.CharOnly();
    strlitC += "abc";
    if (strlitC.n() != 3) return 1796;
    if (!(strlitC == "xyz")) return 1797;
    if (strlitC == "ab") return 1798;

    // FREE operators: the literal on the right, then on the left (the +100 leg proves which
    // free overload ran rather than an operand swap).
    cppsop.Free strlitF = cppsop.Free();
    cppsop.Free strlitG = strlitF + "hello";
    if (strlitG.n() != 5) return 1799;
    if (!(strlitG == "world")) return 1800;
    cppsop.Free strlitH = "hello" + strlitF;
    if (strlitH.n() != 105) return 1801;

    // Controls that behaved identically pre-fix: a char* local, a literal std.map key, and
    // the CFlat-native string operators the literal wrap exists for.
    char* strlitP = " world";
    std.string strlitS2 = std.string("hello");
    strlitS2 += strlitP;
    if ((int)strlitS2.size() != 11) return 1802;

    std.map<std.string, int> strlitM = std.map<std.string, int>();
    strlitM["k"] = 5;
    if (strlitM["k"] != 5) return 1803;

    string strlitCs = "ab";
    strlitCs += "cd";
    if (strlitCs.length() != 4) return 1804;
    if (strlitCs != "abcd") return 1805;

    // ---- std containers over std specializations over USER classes ------------------------------
    /*
     * Every declaration here names a class (nest::Cell, nest2::Tag) whose header declares no std
     * template, nested inside a std specialization inside another std template. The request has
     * to compile against the union of the outer template's group AND the groups owning every
     * class nested at any depth; unioning only the direct argument's group refused all of these.
     */
    {
        std.vector<std.vector<nest.Cell>> nestuserV = default;
        std.vector<nest.Cell> nestuserInner = default;
        nestuserInner.push_back(nest.Cell(8, 9));
        nestuserV.push_back(nestuserInner);
        if ((int)nestuserV.size() != 1)                                      return 1930;
        if ((int)nestuserV[0].size() != 1)                                   return 1931;
        if (nestuserV[0][0].a != 8)                                          return 1932;
        if (nestuserV[0][0].sum() != 17)                                     return 1933;
    }
    {
        std.vector<std.shared_ptr<nest.Cell>> nestuserS = default;
        std.shared_ptr<nest.Cell> nestuserP = default;
        nestuserS.push_back(nestuserP);
        if ((int)nestuserS.size() != 1)                                      return 1934;
        if (nestuserS[0].get() != nullptr)                                   return 1935;
    }
    {
        // The user class in the SECOND map argument, then in the FIRST.
        std.map<int, std.shared_ptr<nest.Cell>> nestuserM = default;
        std.shared_ptr<nest.Cell> nestuserMp = default;
        nestuserM[3] = nestuserMp;
        if ((int)nestuserM.size() != 1)                                      return 1936;
        if (nestuserM[3].get() != nullptr)                                   return 1937;

        std.map<std.shared_ptr<nest.Cell>, int> nestuserK = default;
        std.shared_ptr<nest.Cell> nestuserKey = default;
        nestuserK[nestuserKey] = 42;
        if ((int)nestuserK.size() != 1)                                      return 1938;
        if (nestuserK[nestuserKey] != 42)                                        return 1939;
    }
    {
        // Three levels, and a map naming user classes from TWO different headers.
        std.vector<std.vector<std.shared_ptr<nest.Cell>>> nestuserD = default;
        std.vector<std.shared_ptr<nest.Cell>> nestuserDi = default;
        nestuserD.push_back(nestuserDi);
        if ((int)nestuserD.size() != 1)                                      return 1940;
        if ((int)nestuserD[0].size() != 0)                                   return 1941;

        std.map<std.shared_ptr<nest.Cell>, std.shared_ptr<nest2.Tag>> nestuserTwo = default;
        if ((int)nestuserTwo.size() != 0)                                    return 1942;
    }
    {
        // A USER class template over a user class inside a std container, and a pointer element:
        // both already bound, and the widened union must not disturb them.
        std.vector<nest.Box<nest.Cell>> nestuserB = default;
        nest.Box<nest.Cell> nestuserBox = default;
        nestuserB.push_back(nestuserBox);
        if (nestuserB[0].tag() != 7)                                         return 1943;

        nest.Cell nestuserOne = nest.Cell(2, 3);
        std.vector<nest.Cell*> nestuserPv = default;
        nestuserPv.push_back(&nestuserOne);
        if (nestuserPv[0]->b != 3)                                           return 1944;
    }

    {
        // ITERATOR -> CONST_ITERATOR at an OVERLOADED C++ member. libc++ declares
        // vector::insert/erase over const_iterator; `v.begin()` yields __wrap_iter<int*> and the
        // parameter is __wrap_iter<const int*>. Before the structural const-added-pointer
        // conversion these calls were refused with "no overload of 'insert' matches" while the
        // cbegin() spelling compiled, so every leg here discriminates on the begin() spelling.
        std.vector<int> citv = default;
        citv.push_back(1);
        citv.push_back(2);
        int citx = 9;
        citv.insert(citv.begin(), citx);
        if ((int)citv.size() != 3)                                           return 1979;
        if (citv[0] != 9)                                                    return 1980;
        citv.insert(citv.end(), citx);
        if ((int)citv.size() != 4)                                           return 1981;
        if (citv[3] != 9)                                                    return 1982;
        // The count form: a THIRD parameter after the iterator, so the old wrapper path
        // (which needs every other argument to match exactly) could never reach it.
        citv.insert(citv.begin(), (ulong)2, citx);
        if ((int)citv.size() != 6)                                           return 1983;
        if (citv[1] != 9)                                                    return 1984;
        // The cbegin() anchor still resolves to the same member.
        citv.insert(citv.cbegin(), citx);
        if ((int)citv.size() != 7)                                           return 1985;

        // erase: single-candidate per arity, and previously accepted through a generated C++
        // conversion wrapper instead of the ranking. Same values, one mechanism now.
        citv.erase(citv.begin());
        if ((int)citv.size() != 6)                                           return 1986;
        citv.erase(citv.begin(), citv.end());
        if ((int)citv.size() != 0)                                           return 1987;
    }
    {
        // The rule is on the TEMPLATE ARGUMENT, not on the element type: double repeats it.
        std.vector<double> citd = default;
        citd.push_back(2.5);
        double cityd = 1.5;
        citd.insert(citd.begin(), cityd);
        if ((int)citd.size() != 2)                                           return 1988;
        if ((int)(citd[0] * 10.0) != 15)                                     return 1989;

        // basic_string's iterator is the same __wrap_iter template over char*.
        std.string cits = default;
        cits.push_back('b');
        cits.insert(cits.begin(), 'a');
        if ((int)cits.size() != 2)                                           return 1990;
        if ((int)cits[0] != 97)                                              return 1991;

        // A NAMED iterator local, not just a call result in argument position.
        std.vector<int> citn = default;
        citn.push_back(4);
        auto citit = citn.begin();
        int citv2 = 8;
        citn.insert(citit, citv2);
        if ((int)citn.size() != 2)                                           return 1992;
        if (citn[0] != 8)                                                    return 1993;
    }
    {
        // STRUCTURAL, not keyed on __wrap_iter: a user template with the same shape. Both
        // cppt.constit_take overloads are declared over ConstIt<const int*>; the argument is a
        // ConstIt<int*>. Two arities prove the overloaded path, not a single-candidate fallback.
        int cita = 41;
        cppt.ConstIt<int*> citu = cppt.constit_make(&cita);
        if (cppt.constit_take(citu) != 141)                                  return 1994;
        if (cppt.constit_take(citu, 7) != 48)                                return 1995;

        // Identity still outranks the const-added conversion: constit_pick is declared over BOTH
        // ConstIt<int*> (+1) and ConstIt<const int*> (+2), and the exact one must win. A perfect
        // match beats the conversion tier, so a wrong pick shows up as 43 instead of 42.
        if (cppt.constit_pick(citu) != 42)                                   return 1996;

        // A value and a reference overload BOTH reached through the const-added conversion is a
        // genuine tie. It must break on the lvalue argument (reference wins, +20) and not on
        // declaration order, so the same answer is required from both spelled orders.
        if (cppt.constit_tie(citu) != 61)                                    return 1997;
        if (cppt.constit_tie2(citu) != 61)                                   return 1998;
    }

    return 0;
}
