import "test_helper.cb";
import "list.cb";
import "channel.cb";
import "library/iface_rebox_lib.cb";
import "function.cb";

// === Interfaces ===

interface IShape
{
    int area();
};

interface IDrawable : IShape
{
    void draw();
};

interface IReader
{
    string read();
};

interface IWriter
{
    void write(string text);
};

// === Concrete classes ===

class Circle : IDrawable
{
    int r = 0;
    int area() { return r * r * 3; }
    void draw() { printf("Circle r=%d\n", r); }
};

class Square : IShape
{
    int s = 0;
    int area() { return s * s; }
};

class Triangle : IDrawable
{
    int b = 0;
    int area() { return b / 2; }
    void draw() { printf("Triangle b=%d\n", b); }
};

// Captures the last by-value string passed through IWriter.write (Bug 1 regression).
int gLastWriteLen = 0;

class FileStream : IReader, IWriter
{
    int id = 0;

    string read()  { return "data"; }
    void write(string text) { gLastWriteLen = text.length(); }
};

// Destructor side-effect counter for delete-through-interface (Test 15).
int gDelIfaceDtorCount = 0;

interface ICounted { int value(); };

class Counted : ICounted
{
    int v = 0;
    int value() { return v; }
    ~Counted() { gDelIfaceDtorCount = gDelIfaceDtorCount + 1; }
};

move ICounted makeCounted()
{
    Counted* c = new Counted();
    c->v = 7;
    return c;
}

// ── Test 1: VTable dispatch ──────────────────────────────────────────────────
// Interface method calls route to the correct concrete implementation.

bool testVTableDispatch()
{
    bool result = true;

    Circle c;
    c.r = 5;
    IShape sc = c;
    result &= Test("vtable_circle_area",   sc.area(), 75);   // 5*5*3

    Square sq;
    sq.s = 4;
    IShape ss = sq;
    result &= Test("vtable_square_area",   ss.area(), 16);   // 4*4

    Triangle t;
    t.b = 10;
    IShape st = t;
    result &= Test("vtable_triangle_area", st.area(), 5);    // 10/2

    // Heap-allocated - interface holds pointer to heap object
    Circle* hc = new Circle();
    hc.r = 6;
    IShape shc = hc;            // boxing moves ownership of hc into shc
    result &= Test("vtable_heap_circle_area", shc.area(), 108);  // 6*6*3
    delete shc;                 // delete through the owning interface (hc is moved-from)

    return result;
}

// ── Test 2: is operator ──────────────────────────────────────────────────────
// Reports the concrete type behind an interface value.

bool testIsOperator()
{
    bool result = true;

    Circle c;
    c.r = 3;
    IShape sc = c;

    Square sq;
    sq.s = 2;
    IShape ss = sq;

    Triangle t;
    t.b = 4;
    IShape st = t;

    result &= Test("is_circle_true",     sc is Circle,   true);
    result &= Test("is_circle_false_sq", ss is Circle,   false);
    result &= Test("is_square_true",     ss is Square,   true);
    result &= Test("is_square_false_c",  sc is Square,   false);
    result &= Test("is_triangle_true",   st is Triangle, true);
    result &= Test("is_triangle_false",  sc is Triangle, false);

    return result;
}

// ── Test 3: as operator - downcast to concrete struct ────────────────────────
// Returns a non-null pointer on match, null on mismatch.

bool testAsToStruct()
{
    bool result = true;

    Circle c;
    c.r = 7;
    IShape sc = c;

    Circle* cp = sc as Circle;
    result &= Test("as_circle_nonnull",      cp != nullptr, true);
    if (cp != nullptr)
        result &= Test("as_circle_area_via_ptr", cp.r * cp.r * 3, 147);  // 7*7*3

    Square* sp = sc as Square;
    result &= Test("as_circle_as_square_null", sp == nullptr, true);

    Square sq;
    sq.s = 6;
    IShape ss = sq;

    Square* sp2 = ss as Square;
    result &= Test("as_square_nonnull",        sp2 != nullptr, true);
    if (sp2 != nullptr)
        result &= Test("as_square_s_via_ptr",  sp2.s * sp2.s, 36);

    Circle* cp2 = ss as Circle;
    result &= Test("as_square_as_circle_null", cp2 == nullptr, true);

    return result;
}

// ── Test 4: as operator - interface-to-interface cast ────────────────────────
// Casting IShape (Circle) to IDrawable should succeed; calling the inherited
// area() and own draw() on the result should dispatch correctly.

bool testAsToInterface()
{
    bool result = true;

    Circle c;
    c.r = 4;
    IShape sc = c;

    // Circle implements IDrawable - cast must succeed
    IDrawable d = sc as IDrawable;
    result &= Test("as_iface_is_circle",     d is Circle, true);
    result &= Test("as_iface_area_inherited", d.area(),   48);   // 4*4*3

    // Direct assignment from Circle to IDrawable (no intermediate IShape)
    Circle c2;
    c2.r = 3;
    IDrawable d2 = c2;
    result &= Test("direct_assign_to_idrawable", d2.area(), 27);  // 3*3*3
    result &= Test("direct_idrawable_is_circle", d2 is Circle, true);

    // Triangle also implements IDrawable
    Triangle t;
    t.b = 8;
    IDrawable dt = t;
    result &= Test("triangle_as_idrawable_area", dt.area(), 4);   // 8/2
    result &= Test("triangle_idrawable_is_triangle", dt is Triangle, true);

    return result;
}

// ── Test 4b: as operator - box a CONCRETE class pointer into an interface ────
// Regression for the bug where `concretePtr as IFace` was lowered as a runtime
// downcast (assumes an already-boxed source) instead of a box, yielding a null
// fat pointer and crashing on first method call. See internal/issue history.

bool testAsBoxConcretePointerIntoInterface()
{
    bool result = true;

    Circle* cp = new Circle();
    cp.r = 4;

    // The crash repro: `as` from a plain class pointer into an interface must box.
    // Boxing an OWNING pointer moves ownership into the box (same as `IDrawable d = boxed;`),
    // so the boxed object is a separate allocation from `cp`, which stays live below.
    Circle* boxed = new Circle();
    boxed.r = 4;
    IDrawable d = boxed as IDrawable;
    result &= Test("as_box_ptr_area",  d.area(), 48);   // 4*4*3
    result &= Test("as_box_ptr_is_circle", d is Circle, true);
    d.draw();   // access through the boxed value must not fault

    // Round trip: casting the boxed interface value back to the concrete
    // pointer type must still behave exactly as before (interface source).
    Circle* back = d as Circle;
    result &= Test("as_box_roundtrip_nonnull", back != nullptr, true);
    if (back != nullptr)
        result &= Test("as_box_roundtrip_r", back.r, 4);

    // `is` against a concrete pointer source folds to a compile-time constant.
    result &= Test("concrete_ptr_is_idrawable_true", cp is IDrawable, true);

    Square* sp = new Square();
    sp.s = 5;
    result &= Test("concrete_ptr_is_idrawable_false", sp is IDrawable, false);

    // Concrete source with the SAME concrete target is an identity cast. This used to
    // fall into the downcast path and dereference field 0 as if it were a vtable.
    Circle* self = cp as Circle;
    result &= Test("as_same_concrete_nonnull", self != nullptr, true);
    if (self != nullptr)
    {
        result &= Test("as_same_concrete_field", self.r, 4);
        result &= Test("as_same_concrete_method", self.area(), 48);   // 4*4*3
    }
    result &= Test("concrete_ptr_is_circle_true",  cp is Circle, true);
    result &= Test("concrete_ptr_is_square_false", cp is Square, false);

    // `d` owns what `boxed` used to; deleting the interface is the only correct release.
    delete d;
    delete cp;
    delete sp;
    return result;
}

/*
 * Boxing an OWNING pointer with `as` transfers ownership into the box, exactly as the plain
 * `move IDrawable f() { return sq; }` spelling does. Before the boxing paths were consolidated
 * this callee ran its own scope-exit free on the object it had just handed out, so the caller
 * read freed memory and then freed it a second time.
 */
move IDrawable makeHeapBoxed(int r)
{
    Circle* sq = new Circle();
    sq.r = r;
    return sq as IDrawable;
}

bool testAsBoxTransfersOwnership()
{
    bool result = true;

    // The use-after-free repro: the returned box must still name a live object.
    IDrawable h = makeHeapBoxed(7);
    result &= Test("as_move_return_area", h.area(), 147);   // 7*7*3
    delete h;

    // The double-free repro: the source local is nulled and marked moved, so only the box
    // owns the object - a second free at scope exit would abort the run before it reports.
    Circle* owned = new Circle();
    owned.r = 3;
    IDrawable box = owned as IDrawable;
    result &= Test("as_box_owning_area", box.area(), 27);   // 3*3*3
    delete box;

    return result;
}

// A class returned BY VALUE: the `as` operand has no storage of its own, so the
// boxing path has to spill it before it can hand out a data pointer.
Circle makeStackCircle()
{
    Circle made;
    made.r = 5;
    return made;
}

// -- Test 4c: as/is on a concrete class STACK VALUE ---------------------------
// Regression for the compiler crash where a class VALUE operand (which carries no
// elemType - only pointer operands get one) fell through to the interface-source
// path and read the plain class aggregate as a fat pointer: `extractvalue` with an
// out-of-range index asserted in Debug and segfaulted in Release, with no diagnostic.

bool testAsBoxStackValueIntoInterface()
{
    bool result = true;

    Circle c;
    c.r = 4;

    // The crash repro: `as` from a class stack VALUE into an interface must box.
    IDrawable d = c as IDrawable;
    result &= Test("as_box_value_area",      d.area(), 48);   // 4*4*3
    result &= Test("as_box_value_is_circle", d is Circle, true);
    d.draw();   // access through the boxed value must not fault

    // The box refers to the object itself, not a copy - same as `IDrawable x = c;`.
    c.r = 10;
    result &= Test("as_box_value_aliases_source", d.area(), 300);   // 10*10*3

    // Boxing a by-value call result spills it to a slot the fat pointer can point at.
    IDrawable made = makeStackCircle() as IDrawable;
    result &= Test("as_box_value_call_result", made.area(), 75);    // 5*5*3

    // Round trip back to the concrete pointer through the interface source path.
    Circle* back = d as Circle;
    result &= Test("as_box_value_roundtrip_nonnull", back != nullptr, true);
    if (back != nullptr)
        result &= Test("as_box_value_roundtrip_r", back.r, 10);

    // Same concrete target is an identity cast and keeps the value.
    Circle copy = c as Circle;
    result &= Test("as_box_value_identity", copy.r, 10);

    // `is` on a class value folds to a compile-time constant, exactly as it does
    // for a pointer operand. This used to emit invalid IR for the same reason.
    Square sq;
    sq.s = 6;
    result &= Test("value_is_idrawable_true",  c is IDrawable,  true);
    result &= Test("value_is_idrawable_false", sq is IDrawable, false);
    result &= Test("value_is_circle_true",     c is Circle,     true);
    result &= Test("value_is_square_false",    c is Square,     false);

    return result;
}

// ── Test 5: switch on concrete type ─────────────────────────────────────────
// Dispatches to the matching case by runtime concrete type.

bool testSwitchConcreteType()
{
    bool result = true;

    Circle c;
    c.r = 2;
    IShape sc = c;

    Square sq;
    sq.s = 3;
    IShape ss = sq;

    Triangle t;
    t.b = 6;
    IShape st = t;

    int kind = 0;

    switch (sc)
    {
        case Circle:   kind = 1; break;
        case Square:   kind = 2; break;
        case Triangle: kind = 3; break;
        default:       kind = 0; break;
    }
    result &= Test("switch_circle",   kind, 1);

    switch (ss)
    {
        case Circle:   kind = 1; break;
        case Square:   kind = 2; break;
        case Triangle: kind = 3; break;
        default:       kind = 0; break;
    }
    result &= Test("switch_square",   kind, 2);

    switch (st)
    {
        case Circle:   kind = 1; break;
        case Square:   kind = 2; break;
        case Triangle: kind = 3; break;
        default:       kind = 0; break;
    }
    result &= Test("switch_triangle", kind, 3);

    return result;
}

// ── Test 6: switch on interface case ────────────────────────────────────────
// A case can name an interface; any concrete type implementing it matches.

bool testSwitchInterfaceCase()
{
    bool result = true;

    Circle c;
    c.r = 1;
    IShape sc = c;       // Circle implements IDrawable

    Square sq;
    sq.s = 1;
    IShape ss = sq;      // Square does NOT implement IDrawable

    Triangle t;
    t.b = 2;
    IShape st = t;       // Triangle implements IDrawable

    int hit = 0;

    switch (sc)
    {
        case IDrawable: hit = 1; break;
        default:        hit = 0; break;
    }
    result &= Test("switch_iface_circle_matches",   hit, 1);

    switch (ss)
    {
        case IDrawable: hit = 1; break;
        default:        hit = 0; break;
    }
    result &= Test("switch_iface_square_no_match",  hit, 0);

    switch (st)
    {
        case IDrawable: hit = 1; break;
        default:        hit = 0; break;
    }
    result &= Test("switch_iface_triangle_matches", hit, 1);

    return result;
}

// ── Test 7: switch default case ─────────────────────────────────────────────
// When no type case matches, execution goes to default.

bool testSwitchDefault()
{
    bool result = true;

    Square sq;
    sq.s = 5;
    IShape ss = sq;

    int hit = 0;
    switch (ss)
    {
        case Circle:   hit = 1; break;
        case Triangle: hit = 2; break;
        default:       hit = 3; break;
    }
    result &= Test("switch_default_hit", hit, 3);

    // No default: execution falls through to resume block
    hit = 0;
    switch (ss)
    {
        case Circle:   hit = 1; break;
        case Triangle: hit = 2; break;
    }
    result &= Test("switch_no_default_no_match", hit, 0);

    return result;
}

// ── Test 8: multiple interface implementations ───────────────────────────────
// FileStream implements both IReader and IWriter; each interface dispatches
// correctly and `is` works through either interface fat pointer.

bool testMultipleInterfaces()
{
    bool result = true;

    FileStream fs;
    fs.id = 42;

    IReader reader = fs;
    IWriter writer = fs;

    string s = reader.read();
    result &= Test("multi_iface_read",                  s, "data");

    // Regression: chaining a method directly on the result of an interface method that
    // returns a by-value type (string) must resolve. The interface call's result needs a
    // populated return type + struct receiver, else the chained call re-dispatched the
    // stale method name and failed overload resolution.
    result &= Test("multi_iface_read_chain_len",        reader.read().length(), 4);
    result &= Test("multi_iface_read_chain_data",       reader.read().data(), "data");

    // Bug 1 regression: a virtual interface method taking a by-value struct (string)
    // arg used to push a bare ptr where the vtable signature expects %string by value,
    // failing module verification. Both a literal and a named owned string must work.
    writer.write("hello");
    result &= Test("multi_iface_write_byval_literal",   gLastWriteLen, 5);
    string greeting = "hi-" + "there";
    writer.write(greeting);
    result &= Test("multi_iface_write_byval_named",     gLastWriteLen, 8);
    result &= Test("multi_iface_write_named_survives",  greeting.length(), 8);

    result &= Test("multi_iface_is_filestream_reader",  reader is FileStream, true);
    result &= Test("multi_iface_is_filestream_writer",  writer is FileStream, true);

    // Downcast via as from each interface view
    FileStream* rfp = reader as FileStream;
    FileStream* wfp = writer as FileStream;
    result &= Test("multi_iface_as_from_reader_nonnull", rfp != nullptr, true);
    result &= Test("multi_iface_as_from_writer_nonnull", wfp != nullptr, true);
    if (rfp != nullptr)
        result &= Test("multi_iface_field_via_reader_ptr", rfp.id, 42);
    if (wfp != nullptr)
        result &= Test("multi_iface_field_via_writer_ptr", wfp.id, 42);

    // Switch via IReader view
    int kind = 0;
    switch (reader)
    {
        case FileStream: kind = 1; break;
        default:         kind = 0; break;
    }
    result &= Test("multi_iface_switch_reader", kind, 1);

    return result;
}

// ── Test 9: returning an interface value ─────────────────────────────────────
// A function whose declared return type is an interface must produce a correct fat
// pointer (vtable + data), so a method call on the returned value dispatches to the
// concrete implementation. Regression for the interface-return miscompile, where a
// returned concrete pointer was emitted as a bare `ret ptr` (verifier failure) and
// the boxing workaround lost the object/vtable (silent 0 result).

move IShape makeCircleShape(int r)
{
    Circle* c = new Circle();
    c.r = r;
    return c;            // concrete implementer POINTER -> interface fat pointer
}

IShape echoShape(IShape s)
{
    return s;            // already-boxed interface value -> passthrough
}

bool testReturnInterface()
{
    bool result = true;

    // Return a concrete implementer pointer as an interface, then dispatch a method.
    IShape c = makeCircleShape(5);
    result &= Test("return_iface_from_ptr_area",      c.area(),    75);   // 5*5*3
    result &= Test("return_iface_from_ptr_is_circle", c is Circle, true);
    Circle* cp = c as Circle;          // reclaim ownership to free the heap object
    if (cp != nullptr)
        delete cp;

    // Return an already-boxed interface value (passthrough of a parameter).
    Square sq;
    sq.s = 6;
    IShape boxed  = sq;
    IShape passed = echoShape(boxed);
    result &= Test("return_iface_passthrough_area",   passed.area(), 36); // 6*6

    return result;
}

// =============================================================
// list<IInterface> tests
// =============================================================

bool testListInterfaceBasic()
{
    bool result = true;

    list<IShape> shapes;

    Circle c;
    c.r = 5;
    shapes.add(c);

    Square sq;
    sq.s = 4;
    shapes.add(sq);

    result &= Test("count", shapes.count(), 2);
    result &= Test("operator[0]_area", shapes[0].area(), 75);
    result &= Test("operator[1]_area", shapes[1].area(), 16);
    result &= Test("get0_area",        shapes.get(0).area(), 75);
    result &= Test("get1_area",        shapes.get(1).area(), 16);

    return result;
}

bool testListInterfaceIsAs()
{
    bool result = true;

    list<IShape> shapes;

    Circle c;
    c.r = 3;
    shapes.add(c);

    Square sq;
    sq.s = 2;
    shapes.add(sq);

    result &= Test("is_circle",  shapes[0] is Circle, true);
    result &= Test("is_square",  shapes[1] is Square, true);
    result &= Test("not_square", shapes[0] is Square, false);

    Circle* cp = shapes[0] as Circle;
    result &= Test("as_circle_nonnull", cp != nullptr, true);
    if (cp != nullptr)
        result &= Test("as_circle_r", cp.r, 3);

    Square* sp = shapes[1] as Square;
    result &= Test("as_square_nonnull", sp != nullptr, true);
    if (sp != nullptr)
        result &= Test("as_square_s", sp.s, 2);

    return result;
}

bool testListInterfaceForeach()
{
    bool result = true;

    list<IShape> shapes;

    Circle c;  c.r = 5;  shapes.add(c);   // area 75
    Square sq; sq.s = 4; shapes.add(sq);  // area 16
    Triangle t; t.b = 6; shapes.add(t);   // area 3

    int sum = 0;
    for (IShape s in shapes)
        sum += s.area();

    result &= Test("foreach_sum", sum, 94);  // 75+16+3

    int count = 0;
    for (IShape s in shapes)
        count++;

    result &= Test("foreach_count", count, 3);

    return result;
}

bool testListInterfaceSort()
{
    bool result = true;

    list<IShape> shapes;

    Square sq1; sq1.s = 3; shapes.add(sq1);  // area 9
    Square sq2; sq2.s = 1; shapes.add(sq2);  // area 1
    Circle c;   c.r  = 2; shapes.add(c);     // area 12

    shapes.sort((IShape a, IShape b) => { return a.area() < b.area(); });

    result &= Test("sort0_area", shapes[0].area(), 1);
    result &= Test("sort1_area", shapes[1].area(), 9);
    result &= Test("sort2_area", shapes[2].area(), 12);

    return result;
}

// =============================================================
// channel<IInterface> tests
// =============================================================

bool testChannelInterface()
{
    channel<IShape> ch;
    ch.init(4);

    Circle c;
    c.r = 5;
    ch.send(c);

    Square sq;
    sq.s = 4;
    ch.send(sq);

    IShape s0 = ch.receive();
    IShape s1 = ch.receive();

    int a0 = s0.area();
    int a1 = s1.area();

    ch.destroy();
    return a0 == 75 && a1 == 16;
}

// ── Test 15: delete through an interface fat pointer ─────────────────────────
// 'delete <interfaceValue>' must virtually destruct the concrete object EXACTLY
// once and free it once - for both a same-scope boxed local (which must transfer
// ownership away from the source so it does not also free) and a factory-returned
// interface. The destructor counter proves single destruction per delete.
bool testDeleteThroughInterface()
{
    gDelIfaceDtorCount = 0;

    // Same-scope boxed local: 'ICounted e = c;' transfers ownership of 'c' into 'e'.
    Counted* c = new Counted();
    c->v = 3;
    ICounted e = c;
    int got1 = e.value();
    delete e;                       // exactly one destruction, one free
    bool boxedOk = (got1 == 3) && (gDelIfaceDtorCount == 1);

    // Factory-returned interface value.
    ICounted f = makeCounted();
    int got2 = f.value();
    delete f;                       // second destruction
    bool factoryOk = (got2 == 7) && (gDelIfaceDtorCount == 2);

    return boxedOk && factoryOk;
}

// Frees a `move` interface param: ownership must transfer into the function so
// 'delete x' is permitted (not rejected as a borrow) and frees exactly once.
void freeMovedInterface(move ICounted x)
{
    delete x;
}

// ── Test 16: move interface parameter takes ownership ────────────────────────
// 'move <Interface> x' must transfer ownership into the callee so 'delete x' in
// the body is allowed and frees the concrete object EXACTLY once - mirroring the
// behaviour of a 'move T*' pointer parameter.
bool testMoveInterfaceParam()
{
    gDelIfaceDtorCount = 0;

    Counted* c = new Counted();
    c->v = 9;
    ICounted a = c;
    freeMovedInterface(a);          // ownership moves in; exactly one destruction, one free

    return gDelIfaceDtorCount == 1;
}

// ---- Test 16b: move a `unique <interface>` local to another local ----------
// 'unique IThing b = move a;' (init) and 'b = move a;' (reassign over a live b)
// must transfer the sole boxed owner: the source becomes moved (nulled, its
// scope-exit teardown a no-op) and the destination owns it - exactly one
// destruction per object, zero leaks. Non-move borrowing stays rejected (see
// Test/errors/err_unique_iface_borrow_no_move.cb).
bool testMoveUniqueInterfaceLocal()
{
    bool result = true;

    // Init form: b adopts a's box; a is moved-from. b frees exactly once at scope exit.
    gDelIfaceDtorCount = 0;
    {
        unique ICounted a = makeCounted();      // v = 7
        unique ICounted b = move a;             // transfer: a moved, b owns
        result &= Test("uniq_iface_init_move_value", b.value(), 7);
    }
    result &= Test("uniq_iface_init_move_dtor", gDelIfaceDtorCount, 1);

    // Reassign over a LIVE destination: y's old box is freed first, then y adopts x's.
    // One destruction at the reassign (old y) + one at scope exit (moved-in box) = 2.
    gDelIfaceDtorCount = 0;
    {
        unique ICounted x = makeCounted();      // v = 7
        unique ICounted y = new Counted();      // a distinct live box
        y = move x;                             // free old y (dtor #1), y adopts x, x moved
        result &= Test("uniq_iface_reassign_live_freed_old", gDelIfaceDtorCount, 1);
        result &= Test("uniq_iface_reassign_value", y.value(), 7);
    }
    result &= Test("uniq_iface_reassign_total_dtor", gDelIfaceDtorCount, 2);

    return result;
}

// Closure-owning node for the move-return regression: its destructor counts
// destructions so we can prove the concrete object (and the function<> env it
// owns) is destructed exactly once - no double-free, no leak.
int gNodeDtorCount = 0;

interface INode { int kind(); };

class ClosureNode : INode
{
    Lambda<void()> cb = default;
    int k = 0;
    int kind() { return k; }
    ~ClosureNode() { gNodeDtorCount = gNodeDtorCount + 1; }
};

move INode makeNode(int k)
{
    ClosureNode* n = new ClosureNode();
    n->k = k;
    n->cb = () => { };
    return n;
}

void dropNode(move INode n) { delete n; }

struct NodePatch { int v = 0; };
NodePatch makeNodePatch(int v) { NodePatch p = default; p.v = v; return p; }

// Move-return of a closure-owning interface AFTER an intervening call (list.add).
// Ownership of the concrete node (and its function<> env) must transfer to the
// caller through the move-return; it must not be cloned or freed here.
move INode reconcileReplace(move INode drop, move INode keep, list<NodePatch>* patches)
{
    patches.add(makeNodePatch(keep.kind()));
    dropNode(drop);
    return keep;
}

// ── Test 17: move-return of a closure-owning interface after an intervening call ──
// Regression for the UI reconciler's replace shape: an intervening call before a
// move-return must not perturb ownership of a closure-bearing interface value.
// 'drop' is deleted inside, 'keep' is move-returned and deleted by the caller -
// each concrete node (with its function<> env) destructed exactly once.
bool testMoveReturnClosureInterface()
{
    gNodeDtorCount = 0;
    INode a = makeNode(1);
    INode b = makeNode(2);
    list<NodePatch> patches;
    a = reconcileReplace(a, b, &patches);   // deletes original 'a', returns 'b'
    dropNode(a);                            // caller frees the returned node once
    return gNodeDtorCount == 2;
}

// =============================================================
// String + interface coverage
// Exercises owned strings flowing through: inherited interface chains,
// interface values held in containers, owned string FIELDS dispatched via
// an interface, and an interface-typed FIELD inside a class.
// =============================================================

// A base interface declares a string-returning method; the child interface
// inherits it and adds its own. A concrete class backs both with OWNED string
// fields. The inherited name() must dispatch correctly through BOTH the child
// and the parent fat pointer, and every returned owned string must be correct
// and freed exactly once.

interface INamed
{
    string name();
};

interface IDescribed : INamed
{
    string describe();
};

int gAnimalDtorCount = 0;

class Animal : IDescribed
{
    string nm = default;
    string species = default;
    string name()     { return nm; }                          // owned copy of field
    string describe() { return name() + " the " + species; }  // chains inherited method
    ~Animal() { gAnimalDtorCount = gAnimalDtorCount + 1; }
};

// ── Test 18: owned strings through an inherited interface chain ──────────────
bool testStringInheritedInterfaceChain()
{
    bool result = true;
    gAnimalDtorCount = 0;

    Animal a;
    a.nm = "Rex";
    a.species = "dog";

    // Dispatch through the CHILD interface view.
    IDescribed d = a;
    result &= Test("inh_child_name",      d.name(),     "Rex");
    result &= Test("inh_child_describe",  d.describe(), "Rex the dog");

    // Dispatch the inherited name() through the PARENT interface view.
    INamed n = a;
    result &= Test("inh_parent_name",     n.name(),     "Rex");

    // Cast a child interface value UP to the parent interface, then dispatch
    // the inherited string method through the parent fat pointer.
    IDescribed d2 = a;
    INamed n2 = d2 as INamed;
    result &= Test("inh_cast_up_nonnull", n2 is Animal, true);
    result &= Test("inh_cast_up_name",    n2.name(),    "Rex");

    // Heap object boxed into the interface; delete frees the concrete (and its
    // owned string fields) exactly once.
    Animal* ha = new Animal();
    ha.nm = "Mimi";
    ha.species = "cat";
    IDescribed hd = ha;
    result &= Test("inh_heap_describe",   hd.describe(), "Mimi the cat");
    delete hd;
    result &= Test("inh_heap_dtor_once",  gAnimalDtorCount, 1);

    return result;
}

// ── Test 19: list<Interface> of string-returning interface values ────────────
bool testStringInterfaceList()
{
    bool result = true;

    list<INamed> names;

    Animal a1; a1.nm = "Ann";  a1.species = "x"; names.add(a1);
    Animal a2; a2.nm = "Bob";  a2.species = "y"; names.add(a2);
    Animal a3; a3.nm = "Cara"; a3.species = "z"; names.add(a3);

    result &= Test("list_iface_str_count", names.count(),   3);
    result &= Test("list_iface_str_get0",  names[0].name(), "Ann");
    result &= Test("list_iface_str_get2",  names[2].name(), "Cara");

    // Accumulate every interface-dispatched owned string in a foreach. Each
    // reassignment of 'joined' must free the previous owned buffer (no leak).
    string joined = "";
    for (INamed nm in names)
        joined = joined + nm.name() + ",";
    result &= Test("list_iface_str_joined", joined, "Ann,Bob,Cara,");

    return result;
}

// ── Test 20: channel<Interface> carrying string-returning interface values ───
bool testStringInterfaceChannel()
{
    bool result = true;

    channel<INamed> ch;
    ch.init(4);

    Animal a1; a1.nm = "Sky"; a1.species = "q"; ch.send(a1);
    Animal a2; a2.nm = "Sea"; a2.species = "w"; ch.send(a2);

    INamed r0 = ch.receive();
    INamed r1 = ch.receive();

    result &= Test("chan_iface_str_recv0", r0.name(), "Sky");
    result &= Test("chan_iface_str_recv1", r1.name(), "Sea");

    ch.destroy();
    return result;
}

// An owned string field mutated through an interface: setLabel reassigns the
// owned field (old buffer must be freed), label() returns an owned copy.
interface IBox
{
    string label();
    void setLabel(string s);
};

int gLabelBoxDtorCount = 0;

class LabelBox : IBox
{
    string lbl = default;
    string label()          { return lbl; }
    void setLabel(string s) { lbl = s; }
    ~LabelBox() { gLabelBoxDtorCount = gLabelBoxDtorCount + 1; }
};

// ── Test 21: owned string field read/mutated through an interface ────────────
bool testStringFieldThroughInterface()
{
    bool result = true;
    gLabelBoxDtorCount = 0;

    LabelBox* b = new LabelBox();
    b.lbl = "initial";
    IBox box = b;

    result &= Test("field_iface_initial",    box.label(), "initial");

    // Store an owned interpolated string through the interface; old field freed.
    int count = 7;
    box.setLabel("count={count}");
    result &= Test("field_iface_after_set",  box.label(), "count=7");

    // Reassign again - exercises the owned-field reassignment path via vtable.
    box.setLabel("final");
    result &= Test("field_iface_reassigned", box.label(), "final");

    // label() returns a BORROW of the field, so an independent snapshot needs
    // an explicit `.copy()`. The copy must survive a LATER store to the field
    // (without .copy() the snapshot would alias the field buffer, which is then
    // freed by the next setLabel - the original borrow-into-local dangle).
    string snapshot = box.label().copy();
    box.setLabel("changed");
    result &= Test("field_iface_snapshot_survives", snapshot,    "final");
    result &= Test("field_iface_current",           box.label(), "changed");

    delete box;
    result &= Test("field_iface_dtor_once", gLabelBoxDtorCount, 1);

    return result;
}

int gMovedLabelLen = 0;

// Consumes a moved interface owning a string field: the field is readable in
// the callee, and delete frees the concrete (and its string) exactly once.
void consumeBox(move IBox b)
{
    gMovedLabelLen = b.label().length();
    delete b;
}

// ── Test 22: move an interface owning a string field into a callee ───────────
bool testStringFieldMoveInterface()
{
    bool result = true;
    gLabelBoxDtorCount = 0;

    LabelBox* b = new LabelBox();
    b.lbl = "greetings";
    IBox box = b;
    consumeBox(box);                       // ownership moves in
    result &= Test("field_move_label_len",  gMovedLabelLen, 9);
    result &= Test("field_move_dtor_once",  gLabelBoxDtorCount, 1);

    return result;
}

// An interface-typed FIELD inside a class. The field is a borrow (assigning a
// concrete into it does NOT transfer ownership); the outer class dispatches a
// string method through the stored interface value.
class Container : INamed
{
    IDescribed inner = default;
    string tag = default;
    string name() { return tag + ":" + inner.name(); }
};

// ── Test 23: interface-typed field dispatching owned strings ─────────────────
bool testInterfaceFieldString()
{
    bool result = true;
    gAnimalDtorCount = 0;

    Animal* a = new Animal();
    a.nm = "Leo";
    a.species = "lion";

    Container* c = new Container();
    c.tag = "zoo";
    c.inner = a;                           // borrow: 'a' still owns the Animal

    // Dispatch the inherited / child string methods through the interface field.
    result &= Test("iface_field_inner_name",     c.inner.name(),     "Leo");
    result &= Test("iface_field_inner_describe", c.inner.describe(), "Leo the lion");
    // The outer method combines an owned field string with a field-dispatched one.
    result &= Test("iface_field_outer_name",     c.name(),           "zoo:Leo");

    // Box the outer object into an interface too - dispatch through two layers.
    // Boxing a heap pointer into a local interface transfers ownership of 'c'.
    INamed outer = c;
    result &= Test("iface_field_outer_via_iface", outer.name(),      "zoo:Leo");

    delete outer;                          // frees the Container (and its tag) once
    delete a;                              // frees the borrowed Animal once
    result &= Test("iface_field_inner_dtor_once", gAnimalDtorCount, 1);

    return result;
}

// A class that is an OWNING value type (has a string field) bound to an interface
// slot BY VALUE (stack instance, not `new`). Regression for the interface-bind
// owning-value zeroing bug: binding used to MOVE-zero the aliased source, so reads
// through the interface (and the source) returned default field values. The bind is
// a borrow of the source storage - the source keeps ownership and stays intact.
interface IStackBox
{
    int getV();
    string getName();
};

class StackBox : IStackBox
{
    int v = 40;
    string name = default;
    int getV()       { return this.v; }
    string getName() { return "" + this.name; }
};

IStackBox gStackBox = default;

// ── Test 24: owning-value class bound to an interface slot by value ───────────
bool testStackOwningValueBoxedToInterface()
{
    bool result = true;

    // Assignment form (`_g = c`): global interface slot bound to a stack value.
    StackBox c;
    c.v = 41;
    c.name = "hel" + c.v.toString();           // owned heap buffer, not a literal
    gStackBox = c;                             // bind by value (borrow of c)
    result &= Test("stackbox_assign_v",     gStackBox.getV(),        41);
    result &= Test("stackbox_assign_name",  gStackBox.getName(),     "hel41");
    result &= Test("stackbox_src_v",        c.v,                     41);
    result &= Test("stackbox_src_name",     c.name,                  "hel41");

    // Declaration-init form (`I x = c`): local interface slot bound to a stack value.
    StackBox d;
    d.v = 42;
    d.name = "nm" + d.v.toString();
    IStackBox ix = d;
    result &= Test("stackbox_decl_v",       ix.getV(),               42);
    result &= Test("stackbox_decl_name",    ix.getName(),            "nm42");
    result &= Test("stackbox_decl_src",     d.name,                  "nm42");

    return result;
}

// ── Test 25: downcast of a call result is a BORROW, not an owner ──────────────
// Regression: `T* d = someCall() as U;` where the operand is a function-call
// result (r-value) must yield a BORROW. A stale new/move owning flag left by a
// prior statement (e.g. `list.add(new U())`) used to leak into this declaration,
// so `d` was tracked as owning and auto-deleted at scope exit - double-freeing
// the object the list still owns (and freeing a live object each closure return).
int gDcDtorCount = 0;

interface IPokable { int poke(); };

class Pokable : IPokable
{
    int v = 0;
    int poke() { return v; }
    ~Pokable() { gDcDtorCount = gDcDtorCount + 1; }
};

list<IPokable> _dcZoo = default;

alias IPokable dcActive() { return _dcZoo.get(0); }

bool testDowncastCallResultBorrow()
{
    bool result = true;
    gDcDtorCount = 0;

    _dcZoo.add(new Pokable());   // a bare list BORROWS; this function frees it below

    {
        // Downcast of a CALL RESULT (r-value) - must be a BORROW, not owning.
        Pokable* d = dcActive() as Pokable;
        d.v = 7;
        result &= Test("dc_mutate_via_ptr", d.v, 7);

        // Closure variant: each call downcasts the same call result. Before the fix
        // the inner `p` was owning and freed the live object at the closure's return.
        Lambda<void()> bump = () => { Pokable* p = dcActive() as Pokable; p.v = p.v + 1; };
        bump();
        bump();
        result &= Test("dc_closure_bumped_twice", d.v, 9);
    }
    // `d` (and the closure's inner downcasts) are out of scope. A borrow must NOT
    // have freed the object - the list still owns it. Before the fix, `d`'s scope-exit
    // delete freed it here, so the dtor count would already be 1 and the object dead.
    result &= Test("dc_borrow_did_not_free", gDcDtorCount, 0);
    result &= Test("dc_object_still_live",   dcActive().poke(), 9);

    // The real owner frees the heap object exactly once.
    IPokable owned = _dcZoo.get(0);   // the list only borrows; the caller frees
    _dcZoo.removeAt(0);
    delete owned;
    result &= Test("dc_owner_frees_once", gDcDtorCount, 1);

    return result;
}

// ── Tests 26-28: interface FIELDS (byte-offset vtable slots) ─────────────────
// A 3-level interface chain that introduces a field at EVERY level, so a field
// read through the interface must index the flattened [grandparent, parent, own]
// field list. Two implementors lay their fields out DIFFERENTLY on purpose - a
// fixed offset could not pass these; only the per-implementor offset slot can.
struct WBox
{
    int w = 0;
    int h = 0;
};

interface IWidget
{
    int kind();
    int  tag;
    WBox box;
};

interface ITipped : IWidget
{
    string tip;
};

interface IPress : ITipped
{
    int clicks();
    string label;
};

int gWidgetDtorCount = 0;

class Pressy : IPress
{
    int pad = 7;               // pushes every field off a "natural" offset
    int tag = 0;
    WBox box = default;
    string tip = default;
    string label = default;
    int nclicks = 0;
    int kind()   { return 1; }
    int clicks() { return nclicks; }
    ~Pressy() { gWidgetDtorCount = gWidgetDtorCount + 1; }
};

class Toggly : IPress
{
    string label = default;    // deliberately the reverse layout of Pressy
    i64 pad2 = 0;
    string tip = default;
    WBox box = default;
    int nclicks = 0;
    int tag = 0;
    int kind()   { return 2; }
    int clicks() { return nclicks + 100; }
    ~Toggly() { gWidgetDtorCount = gWidgetDtorCount + 1; }
};

class Plain : IWidget          // implements the ROOT interface only
{
    WBox box = default;
    int tag = 0;
    int kind() { return 3; }
    ~Plain() { gWidgetDtorCount = gWidgetDtorCount + 1; }
};

// A global list keeps this test focused on the upcast itself. The LOCAL-list form
// (take + delete at scope exit) is covered by testLocalListInterfaceTakeDelete.
list<IWidget> _wzoo = default;

// Call-argument upcast: a derived-interface value binds an ancestor-interface param.
int widgetTag(IWidget w)  { return w.tag; }
int widgetKind(IWidget w) { return w.kind(); }

// Return-position upcast: IPress local returned from an IWidget-returning function.
move IWidget makePressy(int t)
{
    Pressy* p = new Pressy();
    p.tag   = t;
    p.tip   = "tip";
    p.label = "Go";
    IPress ip = p;
    return ip;
}

// ── Test 26: read/write interface fields across a 3-level chain ──────────────
bool testInterfaceFieldAccess()
{
    bool result = true;
    gWidgetDtorCount = 0;

    Pressy* p = new Pressy();
    p.tag = 1; p.tip = "pt"; p.label = "Go";   p.nclicks = 3;
    Toggly* t = new Toggly();
    t.tag = 2; t.tip = "tt"; t.label = "Flip"; t.nclicks = 9;

    IPress ip = p;                             // heap pointer moves into the interface
    IPress it = t;

    // Read a field declared at each level of the chain, on both layouts.
    result &= Test("ifld_own_a",     ip.label, "Go");
    result &= Test("ifld_own_b",     it.label, "Flip");
    result &= Test("ifld_parent_a",  ip.tip,   "pt");
    result &= Test("ifld_parent_b",  it.tip,   "tt");
    result &= Test("ifld_grand_a",   ip.tag,   1);
    result &= Test("ifld_grand_b",   it.tag,   2);
    // Methods still dispatch (fields do not disturb the method slots).
    result &= Test("ifld_method_a",  ip.clicks(), 3);
    result &= Test("ifld_method_b",  it.clicks(), 109);

    // Write through the interface: int, owned string, and a NESTED struct field.
    ip.tag = 11;
    it.tip = "z" + "z!";                       // owned buffer; the old one must be freed
    ip.box.w = 5;
    it.box.h = 6;
    result &= Test("ifld_write_int",      ip.tag,   11);
    result &= Test("ifld_write_string",   it.tip,   "zz!");
    result &= Test("ifld_write_nested_a", ip.box.w, 5);
    result &= Test("ifld_write_nested_b", it.box.h, 6);
    // The write landed in the concrete object, at that object's own offset.
    result &= Test("ifld_write_seen_by_iface", it.kind(), 2);

    delete ip;
    delete it;
    result &= Test("ifld_dtor_once", gWidgetDtorCount, 2);

    return result;
}

// A pointer field and an interface-typed field, so the '?.' guard is exercised on
// field types beyond int/string/struct. 'probe' additionally makes the short-circuit
// OBSERVABLE: a zero on the null path proves nothing (a zeroed field reads zero too),
// but a call counter that stays 0 could only happen if the chain was really skipped.
int gNcProbeCalls = 0;

interface IProbe { int probe(); };

class ProbeImpl : IProbe
{
    int z = 41;
    int probe() { gNcProbeCalls = gNcProbeCalls + 1; return z; }
};

interface IHolder
{
    int kind();
    int*    ptr;
    IWidget inner;
    IProbe  probe;
};

class Holder : IHolder
{
    i64 pad3 = 0;              // keep the fields off a natural offset
    int*    ptr = nullptr;
    IWidget inner = default;
    IProbe  probe = default;
    int kind() { return 4; }
};

// Test 26b: '?.' on an interface FIELD must short-circuit instead of dereferencing
// a null fat pointer (the field address is data + vtable[slot], so BOTH halves of a
// null receiver would fault before this guard existed).
bool testInterfaceFieldNullConditional()
{
    bool result = true;

    IPress nullPress = default;
    // Every field type reachable through the 3-level chain, on a null receiver.
    result &= Test("ifld_nc_null_int",    nullPress?.tag,   0);
    result &= Test("ifld_nc_null_string", nullPress?.tip,   "");
    result &= Test("ifld_nc_null_label",  nullPress?.label, "");
    // '??' must compose with the guarded field read. On its own this leg is weak - '??'
    // treats an int 0 as null - so the live sentinel leg below is what pins the value.
    result &= Test("ifld_nc_null_coalesce", nullPress?.tag ?? -1, -1);
    // A struct field, and a chain that continues PAST the '?.' - the whole chain
    // must short-circuit, not just the first link.
    WBox nullBox = nullPress?.box;
    result &= Test("ifld_nc_null_struct_w", nullBox.w, 0);
    result &= Test("ifld_nc_null_chain_w",  nullPress?.box.w, 0);
    result &= Test("ifld_nc_null_chain_h",  nullPress?.box.h, 0);

    // A null derived at RUNTIME (a failed 'as'), not folded from 'default'.
    Plain* pl = new Plain();
    pl.tag = 5;
    IWidget plainIface = pl;
    IPress missed = plainIface as IPress;
    result &= Test("ifld_nc_runtime_null_is_null", missed == nullptr, true);
    result &= Test("ifld_nc_runtime_null_tag",     missed?.tag, 0);

    // Non-null receivers still read the REAL field, at each implementor's own offset -
    // the per-implementor offset slot must survive the guard.
    Pressy* p = new Pressy();
    p.tag = 31; p.tip = "pt"; p.label = "Go"; p.box.w = 3; p.box.h = 4;
    Toggly* t = new Toggly();
    t.tag = 32; t.tip = "tt"; t.label = "Flip"; t.box.w = 5; t.box.h = 6;
    IPress ip = p;
    IPress it = t;
    result &= Test("ifld_nc_live_tag_a",   ip?.tag,   31);
    result &= Test("ifld_nc_live_tag_b",   it?.tag,   32);
    result &= Test("ifld_nc_live_tip_a",   ip?.tip,   "pt");
    result &= Test("ifld_nc_live_tip_b",   it?.tip,   "tt");
    result &= Test("ifld_nc_live_label_b", it?.label, "Flip");
    result &= Test("ifld_nc_live_chain_a", ip?.box.w, 3);
    result &= Test("ifld_nc_live_chain_b", it?.box.h, 6);
    result &= Test("ifld_nc_live_coalesce", ip?.tag ?? -1, 31);
    // Methods on the same receivers are unaffected.
    result &= Test("ifld_nc_live_method_b", it?.clicks(), 100);

    // Pointer-typed and interface-typed fields, null and live.
    IHolder nullHolder = default;
    int* np = nullHolder?.ptr;
    result &= Test("ifld_nc_null_ptr_field", np == nullptr, true);
    IWidget ni = nullHolder?.inner;
    result &= Test("ifld_nc_null_iface_field", ni == nullptr, true);

    int cell = 91;
    Holder* h = new Holder();
    h.ptr = &cell;
    Plain* pl2 = new Plain();
    pl2.tag = 6;
    IWidget plain2 = pl2;
    h.inner = plain2;                          // the holder owns this one
    h.probe = new ProbeImpl();
    IHolder ih = h;
    int* lp = ih?.ptr;
    result &= Test("ifld_nc_live_ptr_field", *lp, 91);
    IWidget li = ih?.inner;
    result &= Test("ifld_nc_live_iface_field", li.tag, 6);

    // The ONLY assertions here whose expected value cannot also come from an unguarded
    // read: a call sitting past the guarded field must not run on the null path. The
    // live legs prove the counter itself works, so a stuck 0 is not a false pass.
    gNcProbeCalls = 0;
    result &= Test("ifld_nc_null_chain_call_result",  nullHolder?.probe.probe(), 0);
    result &= Test("ifld_nc_null_chain_no_call",      gNcProbeCalls, 0);
    result &= Test("ifld_nc_live_chain_call_result",  ih?.probe.probe(), 41);
    result &= Test("ifld_nc_live_chain_did_call",     gNcProbeCalls, 1);

    delete ip;
    delete it;
    delete ih;
    delete plainIface;

    return result;
}

// --- Test 29: boxing an owning POINTER local into a `move` interface param ---
// Regression (heap corruption): passing an owning `T*` local to a `move IFace`
// parameter (e.g. `list<IFace>.add`) boxes it into a fat pointer and hands
// ownership to the callee. The source local used to keep its owning flag, so its
// scope-exit cleanup freed the object the list still held - then `delete` on the
// taken-out element freed it again (double free -> STATUS_HEAP_CORRUPTION at exit).
// The dtor counters below catch the double free deterministically; the heap
// corruption itself shows up as a non-zero process exit code.
int gBoxDtorCount = 0;

interface IBoxed { int value(); };

class Boxed : IBoxed
{
    int v = 0;
    int value() { return v; }
    ~Boxed() { gBoxDtorCount = gBoxDtorCount + 1; }
};

// The UI-tree shape: the list is a CLASS FIELD, elements are handed in through a
// `move IFace` parameter, then deleted one by one and the list is cleared.
class BoxHolder
{
    list<IBoxed> children = default;

    void addChild(move IBoxed c)
    {
        this.children.add(c);
    }

    int sum()
    {
        int total = 0;
        for (IBoxed c in this.children)
            total += c.value();
        return total;
    }

    void destroyTree()
    {
        for (IBoxed c in this.children)
            delete c;
        this.children.clear();
    }
};

bool testLocalListInterfaceTakeDelete()
{
    bool result = true;
    gBoxDtorCount = 0;

    {
        Boxed* named = new Boxed();      // the CALLER owns; a bare list only borrows
        named->v = 7;
        Boxed* other = new Boxed();
        {
            list<IBoxed> zoo = default;  // LOCAL list - its buffer is freed at scope exit
            zoo.add(named);              // boxed into the list as a BORROW
            zoo.add(other);

            result &= Test("localbox_count",      zoo.count(),      2);
            result &= Test("localbox_elem0",      zoo[0].value(),   7);
            // A borrowing list frees nothing, so the sources are still live and undestructed.
            result &= Test("localbox_no_early_dtor", gBoxDtorCount, 0);

            zoo.removeAt(0);
            result &= Test("localbox_removeAt_frees_nothing", gBoxDtorCount, 0);
            zoo.removeAt(0);
            result &= Test("localbox_empty", zoo.count(), 0);
        }
        // The list's destructor ran; it owned nothing, so still no element destructors.
        result &= Test("localbox_dtor_after_list", gBoxDtorCount, 0);
    }
    // The owning locals freed each object exactly once at scope exit.
    result &= Test("localbox_dtor_total", gBoxDtorCount, 2);

    return result;
}

// ── Test 27: `is <Interface>`, null-compare, and derived -> parent upcast ────
bool ternaryPick(bool b) { return b; }

/*
 * A '?:' bound to an interface slot. The ternary result carries no concrete TypeName, so the
 * class -> fat-pointer upcast used to be skipped and a raw pointer was bitcast into the fat
 * struct (invalid IR). Each arm is boxed inside its own branch now, so a null arm and arms of
 * DIFFERENT concrete classes both work; only the taken arm is evaluated.
 */
bool testInterfaceTernaryUpcast()
{
    bool result = true;
    gWidgetDtorCount = 0;

    // Declaration initializer with a null arm - the concrete arm wins.
    IPress a = ternaryPick(true) ? new Pressy() : nullptr;
    result &= Test("iface_ternary_decl_nonnull", a != nullptr, true);
    result &= Test("iface_ternary_decl_kind", a.kind(), 1);

    // Null arm taken.
    IPress b = ternaryPick(false) ? new Pressy() : nullptr;
    result &= Test("iface_ternary_decl_null", b == nullptr, true);

    // Arms of different concrete classes: each arm gets its own vtable.
    IPress c = ternaryPick(true) ? new Pressy() : new Toggly();
    IPress d = ternaryPick(false) ? new Pressy() : new Toggly();
    result &= Test("iface_ternary_mixed_true_kind",  c.kind(), 1);
    result &= Test("iface_ternary_mixed_false_kind", d.kind(), 2);

    // Plain assignment to an existing interface local takes the same path.
    IPress e = default;
    e = ternaryPick(true) ? new Toggly() : nullptr;
    result &= Test("iface_ternary_assign_kind", e.kind(), 2);
    delete e;
    e = ternaryPick(false) ? new Toggly() : nullptr;
    result &= Test("iface_ternary_assign_null", e == nullptr, true);

    delete a; delete c; delete d;
    result &= Test("iface_ternary_dtor_count", gWidgetDtorCount, 4);
    return result;
}

/*
 * The `as` / `is` spelling of the same '?:' join. GenerateSafeCast/GenerateIsCheck used to
 * treat any operand they could not name as an interface fat pointer, so a pointer '?:' - a
 * `select`/phi of two raw ptrs - was read as {vtable,data} and the program segfaulted with no
 * diagnostic. Both spellings now route through the per-arm boxing the plain assignment uses.
 */
bool testInterfaceTernaryAsCast()
{
    bool result = true;
    gWidgetDtorCount = 0;

    // Borrowed arms of the SAME class: the join boxes per arm and the taken arm dispatches.
    Pressy* p = new Pressy();
    Pressy* q = new Pressy();
    IPress same = (ternaryPick(true) ? p : q) as IPress;
    result &= Test("iface_ternary_as_same_kind", same.kind(), 1);
    result &= Test("iface_ternary_as_is_true", (ternaryPick(true) ? p : q) is IPress, true);

    // Arms of DIFFERENT concrete classes: each arm carries its own vtable through the cast.
    Toggly* t = new Toggly();
    IPress mixedTrue  = (ternaryPick(true)  ? p : t) as IPress;
    IPress mixedFalse = (ternaryPick(false) ? p : t) as IPress;
    result &= Test("iface_ternary_as_mixed_true_kind",  mixedTrue.kind(),  1);
    result &= Test("iface_ternary_as_mixed_false_kind", mixedFalse.kind(), 2);

    // A null arm contributes a null fat pointer, exactly as on the assignment path.
    IPress nulled = (ternaryPick(false) ? p : nullptr) as IPress;
    result &= Test("iface_ternary_as_null_arm", nulled == nullptr, true);

    // 'is' against a CONCRETE class is answered per arm, so a mixed join is not a constant.
    result &= Test("iface_ternary_is_concrete_true",  (ternaryPick(true)  ? p : t) is Pressy, true);
    result &= Test("iface_ternary_is_concrete_false", (ternaryPick(false) ? p : t) is Pressy, false);

    delete p; delete q; delete t;
    result &= Test("iface_ternary_as_dtor_count", gWidgetDtorCount, 3);
    return result;
}

/*
 * The RETURN spelling of the same '?:' join. A ternary result carries no NamedVariable TypeName,
 * so the interface-return upcast found no class to box and a bare `ptr` reached the `ret` - the
 * module failed verification with no source location. Each arm is boxed in its own branch on the
 * return path too now. A 'move' return additionally transfers each OWNING arm's ownership inside
 * that arm's block, so the UNTAKEN arm still runs its ordinary scope-exit free: the dtor counts
 * below prove neither a leak nor a double free.
 */
move IPress ternaryReturnOwned(int c)
{
    Pressy* x = new Pressy(); x.nclicks = 3;
    Pressy* y = new Pressy(); y.nclicks = 4;
    return c > 0 ? x : y;
}

move IPress ternaryReturnOwnedMixedClass(int c)
{
    Pressy* x = new Pressy();
    Toggly* y = new Toggly();
    return c > 0 ? x : y;
}

// Borrowed pointer PARAMETERS: nothing is owned here, so a plain (non-'move') return is legal.
IPress ternaryReturnBorrowed(int c, Pressy* p, Toggly* q)
{
    return c > 0 ? p : q;
}

bool testInterfaceTernaryReturnUpcast()
{
    bool result = true;
    gWidgetDtorCount = 0;

    // 'move' return of a join of two owning locals: the taken arm reaches the caller intact.
    move IPress taken = ternaryReturnOwned(1);
    result &= Test("iface_ternary_ret_taken_kind", taken.kind(), 1);
    result &= Test("iface_ternary_ret_taken_clicks", taken.clicks(), 3);
    // The untaken arm was freed at the callee's scope exit; the taken one is still live.
    result &= Test("iface_ternary_ret_untaken_freed", gWidgetDtorCount, 1);
    delete taken;
    result &= Test("iface_ternary_ret_taken_freed", gWidgetDtorCount, 2);

    move IPress other = ternaryReturnOwned(0);
    result &= Test("iface_ternary_ret_other_clicks", other.clicks(), 4);
    delete other;
    result &= Test("iface_ternary_ret_no_leak", gWidgetDtorCount, 4);

    // Arms of DIFFERENT concrete classes: each arm carries its own vtable through the return.
    move IPress mixedTrue = ternaryReturnOwnedMixedClass(1);
    result &= Test("iface_ternary_ret_mixed_true_kind", mixedTrue.kind(), 1);
    delete mixedTrue;
    move IPress mixedFalse = ternaryReturnOwnedMixedClass(0);
    result &= Test("iface_ternary_ret_mixed_false_kind", mixedFalse.kind(), 2);
    delete mixedFalse;
    result &= Test("iface_ternary_ret_mixed_dtor_count", gWidgetDtorCount, 8);

    // Borrowed arms through a plain return: the caller still owns both objects.
    Pressy* p = new Pressy(); p.nclicks = 11;
    Toggly* q = new Toggly();  q.nclicks = 12;
    IPress bp = ternaryReturnBorrowed(1, p, q);
    IPress bq = ternaryReturnBorrowed(0, p, q);
    result &= Test("iface_ternary_ret_borrow_true_kind",  bp.kind(), 1);
    result &= Test("iface_ternary_ret_borrow_false_kind", bq.kind(), 2);
    result &= Test("iface_ternary_ret_borrow_clicks", bp.clicks(), 11);
    // The callee owns neither arm, so it must free neither - and both objects stay usable here.
    // (The 'move' spelling of this same borrowed join is rejected; see err_return_owning_*.cb.)
    result &= Test("iface_ternary_ret_borrow_no_free", gWidgetDtorCount, 8);
    result &= Test("iface_ternary_ret_borrow_src_live", p.nclicks + q.nclicks, 23);
    result &= Test("iface_ternary_ret_borrow_src_kind", p.kind() + q.kind(), 3);
    delete p; delete q;
    result &= Test("iface_ternary_ret_borrow_dtor_count", gWidgetDtorCount, 10);
    return result;
}

/*
 * Brace-init binds an interface-typed struct field or array element through its own store path,
 * separate from `=`. Each must re-box the source to the DESTINATION's interface; otherwise the slot
 * keeps the source's vtable and its slot 0 answers the destination interface's method 0.
 * The two interfaces below are unrelated and their method 0 identities differ, so a missing rebox
 * is observable: it returns kick()'s 100 where hum()'s 5 is expected.
 */
interface IKick { int kick(); };
interface IHum  { int hum(); };

class KickHum : IKick, IHum
{
    int v = 5;
    int kick() { return 100; }
    int hum()  { return v; }
};

struct HumSlot { IHum s = default; };

bool testInterfaceBraceInitField()
{
    bool result = true;

    // Stack instance, so the boxed slots borrow and nothing needs freeing.
    KickHum kh = KickHum();
    IKick k = &kh;

    // Already-fat source (IKick) into an IHum field: needs the rebox.
    HumSlot fromIface = { s = k };
    result &= Test("iface_braceinit_field_from_iface", fromIface.s.hum(), 5);

    // Thin concrete pointer into the same field: the pre-existing boxing path.
    HumSlot fromPtr = { s = &kh };
    result &= Test("iface_braceinit_field_from_ptr", fromPtr.s.hum(), 5);

    // Same two sources through the ARRAY brace-init element path.
    IHum[2] arrFromIface = { k, k };
    result &= Test("iface_braceinit_arr_from_iface", arrFromIface[0].hum(), 5);
    result &= Test("iface_braceinit_arr_from_iface1", arrFromIface[1].hum(), 5);

    IHum[2] arrFromPtr = { &kh, &kh };
    result &= Test("iface_braceinit_arr_from_ptr", arrFromPtr[0].hum(), 5);
    return result;
}

bool testInterfaceIsNullUpcast()
{
    bool result = true;
    gWidgetDtorCount = 0;

    Pressy* p = new Pressy();
    p.tag = 4; p.tip = "pt"; p.label = "Go";
    IPress ip = p;
    Plain* pl = new Plain();
    pl.tag = 5;
    IWidget iw = pl;

    // `x is <Interface>`: true for an implementor, false for a non-implementor.
    result &= Test("iface_is_self",    ip is IPress,   true);
    result &= Test("iface_is_ancestor", ip is IWidget, true);   // two levels up
    result &= Test("iface_is_false",   iw is IPress,   false);

    // `as <Interface>` hit/miss, tested with a null-compare on the fat pointer.
    IPress hit  = ip as IPress;
    IPress miss = iw as IPress;
    result &= Test("iface_null_hit",       hit  != nullptr, true);
    result &= Test("iface_null_miss",      miss != nullptr, false);
    result &= Test("iface_null_miss_eq",   miss == nullptr, true);
    result &= Test("iface_null_hit_field", hit.label,       "Go");

    // F3: null-compare on interface values, independent of `as`. A default-initialized
    // interface value is a zeroed fat pointer {null, null} and must compare == nullptr;
    // boxing (either a stack struct or a heap object) must compare != nullptr. Both operand
    // orders and both operators are covered.
    IPress defIface = default;
    result &= Test("iface_default_eq_null",         defIface == nullptr, true);
    result &= Test("iface_default_ne_null",          defIface != nullptr, false);
    result &= Test("iface_default_reversed_eq",      nullptr == defIface, true);
    result &= Test("iface_default_reversed_ne",      nullptr != defIface, false);

    StackBox boxSrc;
    boxSrc.v = 99;
    IStackBox boxedStack = boxSrc;
    result &= Test("iface_boxed_stack_ne_null",      boxedStack != nullptr, true);
    result &= Test("iface_boxed_stack_eq_null",      boxedStack == nullptr, false);
    result &= Test("iface_boxed_stack_reversed_ne",  nullptr != boxedStack, true);
    result &= Test("iface_boxed_stack_reversed_eq",  nullptr == boxedStack, false);

    result &= Test("iface_boxed_heap_ne_null",       iw != nullptr, true);
    result &= Test("iface_boxed_heap_eq_null",       iw == nullptr, false);
    result &= Test("iface_boxed_heap_reversed_ne",   nullptr != iw, true);
    result &= Test("iface_boxed_heap_reversed_eq",   nullptr == iw, false);

    // Upcast (derived -> parent/grandparent) in every position.
    IWidget upAssign = ip;                                    // assignment
    result &= Test("iface_up_assign",  upAssign.tag,  4);
    result &= Test("iface_up_arg",     widgetTag(ip), 4);     // call argument
    result &= Test("iface_up_arg_kind", widgetKind(ip), 1);
    ITipped upMid = ip;                                       // one level, not two
    result &= Test("iface_up_mid",     upMid.tip, "pt");

    IWidget upRet = makePressy(6);                            // return position
    result &= Test("iface_up_return",      upRet.tag,  6);
    result &= Test("iface_up_return_kind", upRet.kind(), 1);

    _wzoo.add(ip);                                            // list<IParent>.add
    _wzoo.add(upRet);
    _wzoo.add(iw);
    int sum = 0;
    for (int i = 0; i < _wzoo.count(); i++)
    {
        IWidget w = _wzoo.get(i);
        sum = sum + w.tag * 10 + w.kind();
    }
    result &= Test("iface_up_list", sum, 155);   // 41 + 61 + 53

    while (_wzoo.count() > 0)
    {
        IWidget w = _wzoo.get(0);
        _wzoo.removeAt(0);
        delete w;                                // dtor runs exactly once each
    }
    result &= Test("iface_up_list_dtor_once", gWidgetDtorCount, 3);

    return result;
}

// --- Test 30: same boxing shape across a list _grow (buffer realloc) ---
bool testLocalListInterfaceGrowTakeDelete()
{
    bool result = true;
    gBoxDtorCount = 0;

    {
        // `unique` so the list OWNS the boxes across the realloc - the shape under test is
        // that _grow moves fat-pointer elements intact, which only an owning list can assert.
        list<unique IBoxed> zoo = default;
        int i = 0;
        while (i < 6)                    // > 4: forces _grow (buffer realloc)
        {
            Boxed* b = new Boxed();
            b->v = i;
            zoo.add(b);
            i++;
        }
        result &= Test("growbox_count",         zoo.count(),   6);
        result &= Test("growbox_no_early_dtor", gBoxDtorCount, 0);

        int sum = 0;
        while (zoo.count() > 0)
        {
            sum += zoo[0].value();
            zoo.removeAt(0);             // the owning list frees each box exactly once
        }
        result &= Test("growbox_sum",  sum,           15);   // 0+1+2+3+4+5
        result &= Test("growbox_dtors", gBoxDtorCount, 6);
    }
    result &= Test("growbox_dtor_total", gBoxDtorCount, 6);

    return result;
}

// A GENERIC interface with a field: the field's type is the substituted argument.
interface IHolder<T>
{
    int kind();
    T value;
};

class IntHolder : IHolder<int>
{
    int pad = 3;
    int value = 0;
    int kind() { return 1; }
};

class WideHolder : IHolder<int>
{
    int value = 0;
    i64 pad = 0;
    int kind() { return 2; }
};

// ── Test 28: fields on a GENERIC interface ──────────────────────────────────
bool testGenericInterfaceField()
{
    bool result = true;

    IntHolder* a = new IntHolder();
    a.value = 11;
    WideHolder* b = new WideHolder();
    b.value = 22;

    IHolder<int> ia = a;
    IHolder<int> ib = b;
    result &= Test("gen_ifld_read_a",  ia.value, 11);
    result &= Test("gen_ifld_read_b",  ib.value, 22);
    ia.value = 33;
    result &= Test("gen_ifld_write_a", ia.value, 33);
    result &= Test("gen_ifld_method",  ia.kind() * 10 + ib.kind(), 12);

    delete ia;
    delete ib;

    return result;
}

// A generic interface named in a base clause with an EXPLICIT pointer / unique-pointer type
// argument (class : IGSetter<GISetElem*>). Regression: the explicit form once stripped the
// declarator '*' and the 'unique' qualifier from both the mangled interface name and the
// substituted method signature, so the class could not satisfy its own contract.
int gGISetElemDtorCount = default;

class GISetElem
{
    int id = default;
    ~GISetElem() { gGISetElemDtorCount = gGISetElemDtorCount + 1; }
};

interface IGSetter<T>
{
    void set(T value);
    int  peek();
};

class PtrSetter : IGSetter<GISetElem*>
{
    GISetElem* _v = default;
    void set(GISetElem* value) { _v = value; }
    int  peek() { if (_v == nullptr) { return -1; } return _v->id; }
};

class UniqSetter : IGSetter<unique GISetElem*>
{
    unique GISetElem* _v = default;
    void set(unique GISetElem* value) { _v = value; }
    int  peek() { if (_v == nullptr) { return -1; } return _v->id; }
};

// Test 28b: explicit pointer / unique-pointer type argument on a generic interface base
bool testGenericInterfaceExplicitPtrArg()
{
    bool result = true;

    // Direct call: explicit borrow pointer argument keeps its '*'.
    GISetElem e = default;
    e.id = 7;
    PtrSetter s = default;
    s.set(&e);
    result &= Test("gen_iface_ptr_direct", s.peek(), 7);

    // Virtual dispatch through the generic-interface fat pointer.
    PtrSetter* sp = new PtrSetter();
    IGSetter<GISetElem*> ig = sp;
    GISetElem e2 = default;
    e2.id = 5;
    ig.set(&e2);
    result &= Test("gen_iface_ptr_vdispatch", ig.peek(), 5);
    delete ig;

    // Explicit `unique` pointer argument, direct call: the substituted contract param is a move
    // sink, and the owning field frees the element exactly once at scope exit.
    gGISetElemDtorCount = 0;
    {
        UniqSetter u = default;
        GISetElem* h = new GISetElem();
        h->id = 9;
        u.set(h);
        result &= Test("gen_iface_uniq_direct",      u.peek(), 9);
        result &= Test("gen_iface_uniq_not_early",    gGISetElemDtorCount, 0);
    }
    result &= Test("gen_iface_uniq_freed_once",       gGISetElemDtorCount, 1);

    // Explicit `unique` argument dispatched through the generic-interface fat pointer: ownership
    // transfers across the vtable into the owning field, and delete-through-interface frees the
    // element exactly once (no leak, no double free).
    gGISetElemDtorCount = 0;
    {
        UniqSetter* up = new UniqSetter();
        IGSetter<unique GISetElem*> iu = up;
        GISetElem* h2 = new GISetElem();
        h2->id = 3;
        iu.set(h2);
        result &= Test("gen_iface_uniq_vdispatch",       iu.peek(), 3);
        result &= Test("gen_iface_uniq_v_not_early",      gGISetElemDtorCount, 0);
        delete iu;
        result &= Test("gen_iface_uniq_v_freed_once",     gGISetElemDtorCount, 1);
    }

    return result;
}

// --- Test 31: the UI-tree shape - list<IFace> as a CLASS FIELD, filled via `move` ---
bool testFieldListInterfaceTeardown()
{
    bool result = true;
    gBoxDtorCount = 0;

    {
        // Field list on a STACK-allocated holder (the field's list dtor runs at scope exit).
        BoxHolder h;
        Boxed* a = new Boxed();
        a->v = 3;
        h.addChild(a);
        h.addChild(new Boxed());

        result &= Test("fieldbox_sum",           h.sum(),       3);
        result &= Test("fieldbox_no_early_dtor", gBoxDtorCount, 0);

        h.destroyTree();                 // iterate, delete each, clear
        result &= Test("fieldbox_dtors_after_teardown", gBoxDtorCount, 2);
        result &= Test("fieldbox_empty",                h.children.count(), 0);
    }
    result &= Test("fieldbox_dtor_total", gBoxDtorCount, 2);

    // Same shape on a HEAP-allocated holder (the UI tree's actual layout).
    gBoxDtorCount = 0;
    BoxHolder* hp = new BoxHolder();
    Boxed* b = new Boxed();
    b->v = 5;
    hp->addChild(b);
    result &= Test("fieldbox_heap_sum", hp->sum(), 5);
    hp->destroyTree();
    result &= Test("fieldbox_heap_dtors", gBoxDtorCount, 1);
    delete hp;
    result &= Test("fieldbox_heap_dtor_total", gBoxDtorCount, 1);

    return result;
}

// --- Test 32: a `move` parameter on an INTERFACE method (virtual dispatch) ---
// Regression: the virtual-dispatch call path had no move-param source-nulling at all,
// so an owning local boxed into a `move` param kept its owning flag and was freed a
// second time at the caller's scope exit (STATUS_HEAP_CORRUPTION at process exit).
interface IBoxSink
{
    void take(move IBoxed c);
    int  total();
    void drain();
};

class BoxSink : IBoxSink
{
    list<IBoxed> items = default;

    void take(move IBoxed c) { this.items.add(c); }

    int total()
    {
        int t = 0;
        for (IBoxed i in this.items)
            t += i.value();
        return t;
    }

    void drain()
    {
        for (IBoxed i in this.items)
            delete i;
        this.items.clear();
    }
};

bool testMoveParamThroughInterfaceMethod()
{
    bool result = true;
    gBoxDtorCount = 0;

    BoxSink* bs = new BoxSink();
    IBoxSink sink = bs;

    {
        Boxed* p = new Boxed();      // owning local
        p->v = 41;
        sink.take(p);                // virtual dispatch, `move IBoxed` param
        // `p` is moved-from here; reading it is a compile-time error.
    }
    // The caller's source was nulled, so `p`'s scope exit did NOT free the object the
    // sink now owns. Without the nulling this is already 1 (and the heap is corrupt).
    result &= Test("movevirt_source_nulled", gBoxDtorCount, 0);
    result &= Test("movevirt_callee_owns",   sink.total(),  41);

    sink.drain();                    // the real owner frees it - exactly once
    result &= Test("movevirt_dtor_once", gBoxDtorCount, 1);

    delete sink;
    result &= Test("movevirt_dtor_total", gBoxDtorCount, 1);

    return result;
}

// --- Test 33: interface values across the two arg paths the direct path already had ---
// Three regressions, all "the direct-call path did it, the other path did not":
//   a) a function<>/Lambda parameter typed as an INTERFACE got the raw class value (invalid IR).
//   b) a lambda LITERAL passed to an INTERFACE METHOD had no expected signature, so its
//      return type defaulted to void and its `ret i1` failed module verification.
//   c) an owned-string call result passed as a borrow argument of an INTERFACE METHOD was
//      never registered as a temp, so its buffer leaked (proven under --heap-audit).
interface ICase
{
    string label(int n);
    void record(string name, string got);
    bool runUntil(Lambda<bool()> pred);
    int hits();
};

class Case : ICase
{
    int n = 0;
    string label(int i) { return "row" + i.toString(); }
    void record(string name, string got) { if (got.length() > 0) this.n = this.n + 1; }
    bool runUntil(Lambda<bool()> pred) { return pred(); }
    int hits() { return this.n; }
};

class CaseHolder
{
    function<void(ICase)> body = default;   // an INTERFACE-typed function-pointer param
};

bool testInterfaceArgPaths()
{
    bool result = true;

    // (a) the case body is invoked through a function<> field with a CLASS VALUE argument;
    // the indirect-call path must box it into the fat pointer the callee expects.
    CaseHolder* h = new CaseHolder();
    h.body = (ICase c) =>
    {
        // (c) label() hands back an owned string that record() only borrows.
        c.record("first",  c.label(1));
        c.record("second", c.label(2));
        // (b) a lambda literal argument to an interface method - Lambda<bool()>, not void().
        c.record("third",  c.runUntil(() => c.hits() == 2) ? c.label(3) : "");
    };

    Case t = default;
    h.body(t);
    result &= Test("ifacearg_value_boxed", t.hits(), 3);

    // The same body, invoked with a class POINTER argument (the other boxing branch).
    Case* p = new Case();
    h.body(p);
    result &= Test("ifacearg_ptr_boxed", p.hits(), 3);

    delete p;
    delete h;
    return result;
}

// --- Test 34: an AGREEING ownership contract still binds and still transfers ---
// The companion to the err_iface_method_* tests: the implementor matches the interface on
// every ownership qualifier, so the vtable binds and each qualifier keeps its meaning
// through dynamic dispatch. `move` param -> callee owns; `move` return -> caller owns;
// `alias` return -> caller borrows and must not free.
int gOwnDtorCount = 0;

struct Owned
{
    int v = 0;
    ~Owned() { gOwnDtorCount++; }
};

interface IOwnerBox
{
    void put(move Owned* o);      // ownership transferred to the box
    move Owned* release();         // ownership transferred back to the caller
    alias Owned* peek();           // borrow - the box keeps ownership
};

class OwnerBox : IOwnerBox
{
    Owned* held = nullptr;

    void put(move Owned* o)
    {
        if (held != nullptr) delete held;
        held = o;
    }

    move Owned* release()
    {
        Owned* out = move held;   // `move` out of the field: the box stops owning it
        return out;
    }

    alias Owned* peek() { return held; }

    ~OwnerBox() { if (held != nullptr) delete held; }
};

bool testInterfaceMethodOwnershipContract()
{
    bool result = true;
    gOwnDtorCount = 0;

    OwnerBox* obp = new OwnerBox();
    IOwnerBox box = obp;

    {
        Owned* o = new Owned();
        o->v = 21;
        box.put(move o);            // `move` param: the box takes ownership, caller is nulled
    }
    // The caller's scope exit must NOT free what the box now owns.
    result &= Test("contract_move_param_no_free", gOwnDtorCount, 0);

    {
        Owned* borrowed = box.peek();   // `alias` return: a borrow, not freed at scope exit
        result &= Test("contract_alias_return_value", borrowed->v, 21);
    }
    result &= Test("contract_alias_return_no_free", gOwnDtorCount, 0);

    {
        Owned* taken = box.release();   // `move` return: the caller owns it now
        result &= Test("contract_move_return_value", taken->v, 21);
        delete taken;                    // freed exactly once, by the new owner
    }
    result &= Test("contract_move_return_freed_once", gOwnDtorCount, 1);

    delete box;                          // box is empty - nothing double-freed
    result &= Test("contract_dtor_total", gOwnDtorCount, 1);

    return result;
}

// A derived-to-parent upcast used to lower its typedesc if-chain AT the conversion site, so it
// only tested implementors registered so far. Every helper below is defined ABOVE the class it
// must dispatch to; the chain is emitted at finalization now, so declaration order is irrelevant.
interface IRbxElement { int rbxArea(); };
interface IRbxButton : IRbxElement { int rbxPoke(); };

// Helper #1 sits above EVERY implementor of IRbxButton - the chain would have been empty.
IRbxElement rbxWidenEarly(IRbxButton b) { IRbxElement e = b; return e; }

class RbxEarly : IRbxButton
{
    int r = 2;
    RbxEarly() {}
    int rbxArea() { return r * r; }
    int rbxPoke() { return 1; }
};

// Helper #2 sits BETWEEN two implementors - the chain would have held only RbxEarly.
IRbxElement rbxWidenMiddle(IRbxButton b) { IRbxElement e = b; return e; }

class RbxLate : IRbxButton
{
    int r = 4;
    RbxLate() {}
    int rbxArea() { return r * r; }
    int rbxPoke() { return 7; }
};

// A generic implementor does not exist at all until its instantiation site is reached.
class RbxBox<T> : IRbxButton
{
    T v = default;
    RbxBox(T x) { v = x; }
    int rbxArea() { return (int)v * 3; }
    int rbxPoke() { return 9; }
};

bool testInterfaceReboxDeclarationOrder()
{
    bool result = true;

    IRbxButton early = new RbxEarly();
    IRbxButton late  = new RbxLate();

    result &= Test("rebox_early_helper_early_impl", rbxWidenEarly(early).rbxArea(), 4);
    result &= Test("rebox_early_helper_late_impl",  rbxWidenEarly(late).rbxArea(), 16);
    result &= Test("rebox_mid_helper_early_impl",   rbxWidenMiddle(early).rbxArea(), 4);
    result &= Test("rebox_mid_helper_late_impl",    rbxWidenMiddle(late).rbxArea(), 16);

    IRbxButton boxed = new RbxBox<int>(7);
    result &= Test("rebox_generic_impl_early_helper", rbxWidenEarly(boxed).rbxArea(), 21);
    result &= Test("rebox_generic_impl_mid_helper",   rbxWidenMiddle(boxed).rbxArea(), 21);

    // A null (failed-cast) source must still rebox to a null fat value, not match a case.
    IRbxButton none = default;
    result &= Test("rebox_null_source_stays_null", rbxWidenEarly(none) == nullptr, true);

    delete early;
    delete late;
    delete boxed;
    return result;
}

// The rebox site is in the IMPORTED iface_rebox_lib.cb, code-gen'd before this file is even
// scanned; the only implementor of its interface is right here, in the importing file.
class RbxImportedCtl : IRbxImportedChild
{
    int r = 5;
    RbxImportedCtl() {}
    int rbxiArea() { return r * r; }
    int rbxiPoke() { return 3; }
};

bool testInterfaceReboxAcrossImport()
{
    bool result = true;

    IRbxImportedChild ctl = new RbxImportedCtl();
    result &= Test("rebox_across_import_area", rbxImportedWiden(ctl).rbxiArea(), 25);

    IRbxImportedChild none = default;
    result &= Test("rebox_across_import_null", rbxImportedWiden(none) == nullptr, true);

    delete ctl;
    return result;
}

// A generic class only enters the type registry once it is MONOMORPHIZED. This one never is,
// so at finalization the destination interface has no registered implementor and the thunk's
// case list is empty - yet the program is legal. The zero-implementor backstop must stay silent
// here (the scanner marks an interface a generic class names as unprovable) rather than reject
// it; a false rejection is a source-compatibility break.
interface IRbxUninstBase { int rbxuArea(); };
interface IRbxUninstChild : IRbxUninstBase { int rbxuPoke(); };

class RbxNeverInstantiated<T> : IRbxUninstBase
{
    T v = default;
    RbxNeverInstantiated() {}
    int rbxuArea() { return 1; }
};

IRbxUninstBase rbxUninstWiden(IRbxUninstChild c) { IRbxUninstBase e = c; return e; }

bool testInterfaceReboxUninstantiatedGeneric()
{
    bool result = true;

    // Compiling this file at all is the regression: the rebox below has no case to emit.
    IRbxUninstChild none = default;
    result &= Test("rebox_uninstantiated_generic_null", rbxUninstWiden(none) == nullptr, true);

    return result;
}

// An interface-typed FIXED ARRAY held as a struct FIELD used to lower to a SINGLE fat pointer
// instead of [N x {ptr,ptr}]: sizeof reported one element for any N while indexing used the
// correct 16-byte stride, so writes past v[0] silently clobbered the following fields.
struct IfaceArrField
{
    int head = default;
    IShape vals[8] = default;
    int* tail[9] = default;
};

bool testInterfaceArrayField()
{
    bool result = true;

    // sizeof must count all N elements, and the field must not be smaller than the local form.
    result &= Test("iface_arr_field_sizeof_8", (i64)sizeof(IfaceArrField), (i64)(8 + 8 * 16 + 9 * 8));

    IfaceArrField s = default;
    s.head = 77;
    int[9] sentinel = default;
    for (int i = 0; i < 9; i++) { sentinel[i] = i + 500; s.tail[i] = &sentinel[i]; }

    // Stride must match the element size sizeof now reports.
    result &= Test("iface_arr_field_stride", (i64)((i8*)&s.vals[1] - (i8*)&s.vals[0]), (i64)16);

    Square[8] sqs = default;
    Circle[8] cis = default;
    for (int i = 0; i < 8; i++)
    {
        sqs[i].s = i + 1;
        cis[i].r = i + 1;
        if (i % 2 == 0) s.vals[i] = sqs[i];
        else            s.vals[i] = cis[i];
    }

    // Per-element round trip: each slot keeps the implementation stored into it, and dispatch
    // through s.vals[i] reaches that element - not element 0.
    int bad = 0;
    for (int i = 0; i < 8; i++)
    {
        int expect = (i % 2 == 0) ? (i + 1) * (i + 1) : (i + 1) * (i + 1) * 3;
        if (s.vals[i].area() != expect) bad++;
    }
    result &= Test("iface_arr_field_roundtrip", bad, 0);

    // Nothing adjacent in the struct was overwritten by the element writes.
    int clobbered = 0;
    for (int i = 0; i < 9; i++)
        if (s.tail[i] != &sentinel[i] || *s.tail[i] != i + 500) clobbered++;
    result &= Test("iface_arr_field_tail_intact", clobbered, 0);
    result &= Test("iface_arr_field_head_intact", s.head, 77);

    // The array LOCAL form must keep dispatching per element too.
    IShape[4] loc = default;
    for (int i = 0; i < 4; i++) loc[i] = sqs[i];
    result &= Test("iface_arr_local_elem0", loc[0].area(), 1);
    result &= Test("iface_arr_local_elem3", loc[3].area(), 16);

    return result;
}

// An `IShape[]` array VIEW - element type an INTERFACE - used to lower as one bare fat struct
// instead of a pointer to a run of them, so every element GEP and the view's `noalias` parameter
// attribute were built against the struct type and the module failed LLVM verification.
int ifaceViewSum(IShape[] items, int n)
{
    int sum = 0;
    for (int i = 0; i < n; i++) sum += items[i].area();
    return sum;
}

void ifaceViewSetSecond(IShape[] items, IShape v)
{
    items[1] = v;
}

// A view of interfaces held as a struct FIELD, and one RETURNED across a call boundary.
struct IfaceViewHolder
{
    IShape[] items = default;
    int n = 0;
    int sum() { int s = 0; for (int i = 0; i < n; i++) s += items[i].area(); return s; }
};

IShape[] ifaceViewFresh(int n)
{
    return new IShape[n];
}


bool testInterfaceArrayViewOfInterfaces()
{
    bool result = true;

    Square[4] sqs = default;
    Circle[4] cis = default;
    for (int i = 0; i < 4; i++) { sqs[i].s = i + 1; cis[i].r = i + 1; }

    IShape[] view = new IShape[4];
    for (int i = 0; i < 4; i++) view[i] = sqs[i];

    // Reading an element and dispatching through it, across a call that takes the view.
    result &= Test("iface_view_sum", ifaceViewSum(view, 4), 1 + 4 + 9 + 16);

    // Writing an element through a view the callee received as a parameter.
    ifaceViewSetSecond(view, cis[2]);
    result &= Test("iface_view_write_through", ifaceViewSum(view, 4), 1 + 27 + 9 + 16);

    // Rebox: a DERIVED interface value stored into an IShape slot goes through the
    // interface-to-interface rebox path, not a plain fat-struct copy.
    IDrawable d = cis[3];
    view[0] = d;
    result &= Test("iface_view_rebox_elem", view[0].area(), 48);

    // An element read out into a bare interface local keeps that element's target.
    IShape e = view[2];
    result &= Test("iface_view_elem_local", e.area(), 9);

    // An empty view is legal; iterating it touches nothing.
    IShape[] empty = new IShape[0];
    result &= Test("iface_view_empty", ifaceViewSum(empty, 0), 0);

    // The view rides in a struct FIELD and dispatches per element from a method.
    IfaceViewHolder h = default;
    h.items = view;
    h.n = 4;
    result &= Test("iface_view_field_sum", h.sum(), 48 + 27 + 9 + 16);

    // A '?:' over two views picks a view, not an interface box - both arms are already
    // pointers, so nothing needs boxing and the join must not demand a concrete class.
    bool pick = h.n == 4;
    IShape[] chosen = pick ? view : empty;
    result &= Test("iface_view_ternary", chosen[2].area(), 9);

    // A view RETURNED from a function. Its unwritten elements must read as null interfaces.
    // NOTE: this pins the SEMANTICS, not the buffer-zeroing that implements them - macOS's
    // allocator scrubs freed blocks, so no .cb-level heap pollution can tell a missing memset
    // from a present one here. The memset itself is guarded by reading the emitted IR.
    IShape[] fresh = ifaceViewFresh(3);
    int nonNull = 0;
    for (int i = 0; i < 3; i++) if (fresh[i] != nullptr) nonNull++;
    result &= Test("iface_view_new_zeroed", nonNull, 0);

    fresh[1] = sqs[2];
    result &= Test("iface_view_returned_write", fresh[1].area(), 9);
    result &= Test("iface_view_null_guard_count", fresh[1] != nullptr, true);

    // Freeing a view of interfaces frees the BUFFER, exactly as a struct view does; it must
    // not take the by-value interface teardown (which used to crash the compiler outright).
    delete fresh;
    delete empty;
    delete view;

    return result;
}

/*
 * Interface method dispatch used to pick the vtable slot by NAME alone, so every overload in a
 * set resolved to the first slot and surplus arguments were silently discarded. The vtable was
 * always populated per full signature; only the call site was wrong.
 */
interface IOvArity
{
    int go(int a);
    int go(int a, int b);
};

class OvArity : IOvArity
{
    // Declared in the OPPOSITE order from the contract: slot order follows the interface.
    int go(int a, int b) { return a * b; }
    int go(int a) { return 100 + a; }
};

interface IOvType
{
    int pick(int a);
    int pick(const char* s);
    int pick(double d);
};

class OvType : IOvType
{
    int pick(const char* s) { return 2; }
    int pick(double d) { return 3; }
    int pick(int a) { return 1; }
};

interface IOvBase { int mix(int a); };
interface IOvChild : IOvBase { int mix(int a, int b); };

class OvChild : IOvChild
{
    int mix(int a) { return 100 + a; }
    int mix(int a, int b) { return a * b; }
};

bool testInterfaceOverloadDispatch()
{
    bool result = true;

    OvArity oa;
    IOvArity ia = oa;
    result &= Test("iface_ov_arity_1", ia.go(7), 107);
    result &= Test("iface_ov_arity_2", ia.go(7, 3), 21);

    OvType ot;
    IOvType it = ot;
    result &= Test("iface_ov_type_int", it.pick(7), 1);
    result &= Test("iface_ov_type_str", it.pick("hi"), 2);
    result &= Test("iface_ov_type_dbl", it.pick(1.5), 3);

    // Parent declares one overload, child the other: the flattened slot list must keep both.
    OvChild oc;
    IOvChild ic = oc;
    result &= Test("iface_ov_inherited_1", ic.mix(7), 107);
    result &= Test("iface_ov_inherited_2", ic.mix(7, 3), 21);

    // Same selection through the '?.' null-conditional call path on a non-null receiver.
    IOvArity? na = oa;
    result &= Test("iface_ov_nullcond_1", na?.go(7), 107);
    result &= Test("iface_ov_nullcond_2", na?.go(7, 3), 21);

    return result;
}

// === Named arguments on the interface call path ===
// Named args used to be silently ignored on virtual dispatch: the synthesized call
// argument never carried its VariableName, so MatchFunction saw zero named args and
// bound everything positionally - f(b: 2, a: 1) computed as if it were f(2, 1).
interface INArg { int f(int a, int b); };
class NArgImpl : INArg { int f(int a, int b) { return a * 10 + b; } };

// Interface names win: the implementor spells its params differently, so a correct
// fix must bind against the INTERFACE's declared names, not NArgDiffNames's.
class NArgDiffNames : INArg { int f(int x, int y) { return x * 10 + y; } };

// Extension method: no vtable slot for 'f', so this routes through
// CreateOverloadedFunctionCall (the general overload resolver) instead of
// CallInterfaceMethod's vtable dispatch.
int nargExt(INArg io, int p, int q) { return p * 10 + q; }

interface INArgGeneric<T> { T f(T a, T b); };
class NArgGenericImpl : INArgGeneric<int> { int f(int a, int b) { return a * 10 + b; } };

// The receiver arrives as an interface-typed PARAMETER rather than a local.
int nargViaParam(INArg io) { return io.f(b: 2, a: 1); }

// OVERLOADED interface method: the slot is picked by full signature, so the names must be
// matched against the slot that declares them - and the winning slot's permutation applied.
// A losing slot's name mismatch must not error out of the search either.
interface INArgOv
{
    int f(int a, int b);
    int f(double c, double d);
};
class NArgOvImpl : INArgOv
{
    int f(int a, int b) { return a * 10 + b; }
    int f(double c, double d) { return (int)(c * 100.0 + d); }
};

// Two same-arity slots the type scorer cannot rank: the argument type implements neither
// parameter type, so every candidate scores negative and resolution falls back to the first
// slot. That fallback must still apply the named-argument permutation. The three classes share
// one `int t` layout on purpose - the point is to defeat the scorer, not the field read.
class NArgP { int t = 0; };
class NArgQ { int t = 0; };
class NArgR { int t = 0; };
interface INArgUnrank
{
    int g(NArgP* p, NArgP* q);
    int g(NArgQ* p, NArgQ* q);
};
class NArgUnrankImpl : INArgUnrank
{
    int g(NArgP* p, NArgP* q) { return p.t * 10 + q.t; }
    int g(NArgQ* p, NArgQ* q) { return q.t * 10 + p.t; }
};

bool testInterfaceNamedArguments()
{
    bool result = true;

    NArgImpl n;
    INArg io = n;
    result &= Test("iface_named_full",       io.f(b: 2, a: 1), 12);
    result &= Test("iface_named_partial",    io.f(2, a: 1), 12);

    INArg? ncio = n;
    result &= Test("iface_named_nullcond",   ncio?.f(b: 2, a: 1), 12);

    unique INArg uio = new NArgImpl();
    result &= Test("iface_named_unique",     uio.f(b: 2, a: 1), 12);

    INArg extIo = n;
    result &= Test("iface_named_ext",        extIo.nargExt(q: 2, p: 1), 12);

    NArgGenericImpl ng;
    INArgGeneric<int> gio = ng;
    result &= Test("iface_named_generic",    gio.f(b: 2, a: 1), 12);

    NArgDiffNames d;
    INArg dio = d;
    result &= Test("iface_named_iface_wins", dio.f(b: 2, a: 1), 12);

    // Receiver reached through an array element and through a parameter.
    INArg[2] arr = { n, n };
    result &= Test("iface_named_array_elem",  arr[1].f(b: 2, a: 1), 12);
    result &= Test("iface_named_param_recv",  nargViaParam(io), 12);

    // Overloaded slots: the names select and reorder within the matching slot, and a name
    // that only the OTHER slot declares must still reach its own slot.
    NArgOvImpl ov;
    INArgOv ovio = ov;
    result &= Test("iface_named_ov_int",      ovio.f(b: 2, a: 1), 12);
    result &= Test("iface_named_ov_double",   ovio.f(d: 2.0, c: 1.0), 102);
    result &= Test("iface_named_ov_positional", ovio.f(1, 2), 12);

    // No type winner: the fallback first-slot pick must still carry the permutation.
    // p is the second argument here, so a dropped permutation would score 12 instead.
    NArgUnrankImpl ur;
    INArgUnrank urio = ur;
    NArgR* r1 = new NArgR(); r1.t = 1;
    NArgR* r2 = new NArgR(); r2.t = 2;
    result &= Test("iface_named_unrank_perm", urio.g(q: r1, p: r2), 21);

    return result;
}

// === Function-pointer parameters through an interface slot ===
// A thin `function<>` parameter is a bare code pointer, so a closure fat struct handed to a
// virtual slot must be lowered to its invoker exactly as the direct call path does. The fat
// `Lambda<>` spelling keeps its {code, env} pair and carries captures.
interface IFnParam
{
    int run(function<int(int)> fn);
    int two(int a, function<int(int)> fn);
    int lam(Lambda<int(int)> fn);
    int lam2(Lambda<int(int)> fn, int a);
};
class FnParamImpl : IFnParam
{
    int run(function<int(int)> fn) { return fn(5); }
    int two(int a, function<int(int)> fn) { return fn(a); }
    int lam(Lambda<int(int)> fn) { return fn(5); }
    int lam2(Lambda<int(int)> fn, int a) { return fn(a); }
};
int fnParamTriple(int x) { return x * 3; }
int fnParamQuad(int x) { return x * 4; }
// Direct-path twin: the interface and direct arms must accept the same argument shapes.
class FnParamDirect { int lam(Lambda<int(int)> fn) { return fn(5); } };

bool testInterfaceFunctionPointerParam()
{
    bool result = true;

    FnParamImpl impl;
    IFnParam io = impl;

    // Non-capturing lambda into a thin `function<>` slot: positional and named.
    result &= Test("iface_thinfn_positional", io.run((int x) => { return x * 4; }), 20);
    result &= Test("iface_thinfn_named",      io.run(fn: (int x) => { return x * 4; }), 20);

    // A named function and a stored thin `function<>` value are already bare pointers.
    result &= Test("iface_thinfn_namedfunc",  io.run(fnParamTriple), 15);
    function<int(int)> stored = fnParamTriple;
    result &= Test("iface_thinfn_variable",   io.run(stored), 15);

    // Second parameter slot, positional and reordered by name.
    result &= Test("iface_thinfn_slot2",      io.two(3, (int x) => { return x + 1; }), 4);
    result &= Test("iface_thinfn_slot2_named", io.two(fn: (int x) => { return x + 1; }, a: 3), 4);

    // The fat `Lambda<>` spelling still carries captures, in both argument orders.
    int factor = 7;
    result &= Test("iface_fatlambda",         io.lam((int x) => { return x * factor; }), 35);
    result &= Test("iface_fatlambda_named",   io.lam2(fn: (int x) => { return x * factor; }, a: 2), 14);

    // Mirror direction: a fat `Lambda<>` slot fed a NAMED function ({shim, null}) or a stored
    // thin `function<>` value ({code, null}). A lambda literal is already fat, so only these
    // two shapes exercise the widening - positionally and by name, in both slot positions.
    result &= Test("iface_fat_from_func",         io.lam(fnParamTriple), 15);
    result &= Test("iface_fat_from_func_named",   io.lam(fn: fnParamTriple), 15);
    result &= Test("iface_fat_from_thin",         io.lam(stored), 15);
    result &= Test("iface_fat_from_thin_named",   io.lam(fn: stored), 15);
    result &= Test("iface_fat_from_func_slot2",   io.lam2(fnParamTriple, 4), 12);
    result &= Test("iface_fat_from_thin_slot2",   io.lam2(fn: stored, a: 4), 12);

    // An already-fat `Lambda<>` variable must pass through the widening untouched.
    Lambda<int(int)> fatvar = (int x) => { return x * factor; };
    result &= Test("iface_fat_from_fatvar",       io.lam(fatvar), 35);

    // A `?:` join carries no recorded provenance - neither arm's type survives into the join -
    // so the widen must ACCEPT what it cannot disprove. Pinned on both arms: an allowlist gate
    // rejected these through the interface while the direct path kept accepting them.
    int k = 1;
    function<int(int)> altThin = fnParamQuad;
    FnParamDirect direct;
    result &= Test("iface_fat_from_ternary",      io.lam(k > 0 ? stored : altThin), 15);
    result &= Test("direct_fat_from_ternary",     direct.lam(k > 0 ? stored : altThin), 15);
    result &= Test("iface_fat_from_ternary_func", io.lam(k > 0 ? fnParamTriple : fnParamQuad), 15);
    result &= Test("direct_fat_from_ternary_func", direct.lam(k > 0 ? fnParamTriple : fnParamQuad), 15);

    return result;
}

// === Namespaced interfaces ===
// An interface is registered under its enclosing namespace, so two namespaces may each declare
// their own "INsCounter" with a DIFFERENT contract without one silently replacing the other.
interface INsGlobal { int gid(); };

namespace nsa
{
    interface INsCounter { int value(); };
    class NsA : INsCounter { int value() { return 11; } };
    // Bare sibling name in a parameter position resolves to nsa.INsCounter.
    int callBare(INsCounter c) { return c.value(); }
    // The same interface spelled with its full name.
    int callQualified(nsa.INsCounter c) { return c.value(); }
};

namespace nsb
{
    // Same simple name, i64 contract: dispatching an nsa implementor through THIS one used to
    // read a zero-extended i32 as an i64 and yield 4294967295 for -1.
    interface INsCounter { i64 value(); };
    class NsB : INsCounter { i64 value() { return -1; } };
    i64 callBare(INsCounter c) { return c.value(); }

    // Qualified base clause: implement the interface that lives in another namespace.
    class NsCross : nsa.INsCounter { int value() { return 42; } };

    // Bare base clause that walks outward to a file-scope interface.
    class NsOuter : INsGlobal { int gid() { return 7; } };
};

namespace nsc
{
    // Interface inheritance across namespaces via a qualified parent name.
    interface INsDerived : nsa.INsCounter { int extra(); };
    class NsD : INsDerived { int value() { return 3; } int extra() { return 4; } };
};

// core/interfaces.cb is implicitly loaded, so it already owns the file-scope name
// "IHashable" (see Test/errors/err_iface_name_collides_with_core.cb for the resulting
// error). Declaring a same-named interface inside a namespace is the documented
// workaround: it registers as "nsCore.IHashable", distinct from the core one. A bare
// "IHashable" spelling still resolves outward to the core interface first (it already
// matches at file scope before the enclosing-namespace walk runs), so the base clause
// and the variable type below use the qualified spelling "nsCore.IHashable".
namespace nsCore
{
    interface IHashable { int myhash(); };
    class NsHashable : nsCore.IHashable { int myhash() { return 99; } };
};

namespace nsCtor
{
    // A namespaced class with an explicit no-arg constructor used to crash the compiler:
    // the forward-ref scanner's constructor-overload check compared the ctor's bare
    // source name against the namespace-qualified type name, never matched, and fell
    // through to the plain member-function path where the ctor's absent return-type
    // specifier was dereferenced as null.
    interface INsCtorThing { int id(); };
    class NsCtorThing : INsCtorThing
    {
        int v = 0;
        NsCtorThing() { v = 55; }
        int id() { return v; }
    };
};

bool testNamespacedInterfaceShadowsCoreName()
{
    bool result = true;

    nsCore.NsHashable h;
    nsCore.IHashable v = h;
    result &= Test("ns_iface_shadows_core_name", v.myhash(), 99);

    return result;
}

bool testNamespacedClassExplicitCtor()
{
    bool result = true;

    nsCtor.NsCtorThing t = nsCtor.NsCtorThing();
    result &= Test("ns_class_explicit_ctor", t.id(), 55);

    nsCtor.INsCtorThing i = t;
    result &= Test("ns_class_explicit_ctor_via_iface", i.id(), 55);

    return result;
}

bool testNamespacedInterfaces()
{
    bool result = true;

    nsa.NsA a;
    result &= Test("ns_iface_bare_param",      nsa.callBare(a),      11);
    result &= Test("ns_iface_qualified_param", nsa.callQualified(a), 11);

    // Each namespace keeps its own contract; the i64 side must return a true -1.
    nsb.NsB b;
    result &= Test("ns_iface_i64_contract", (int)(nsb.callBare(b) == -1 ? 1 : 0), 1);

    // Qualified base clause, boxed through the qualified interface type from file scope.
    nsb.NsCross cross;
    nsa.INsCounter q = cross;
    result &= Test("ns_iface_qualified_base", q.value(), 42);

    // Bare base clause resolving outward to the file-scope interface.
    nsb.NsOuter outer;
    INsGlobal g = outer;
    result &= Test("ns_iface_outward_base", g.gid(), 7);

    // Cross-namespace interface inheritance: the derived slot list keeps the parent's method.
    nsc.NsD d;
    nsc.INsDerived nd = d;
    result &= Test("ns_iface_inherited_own",    nd.extra(), 4);
    result &= Test("ns_iface_inherited_parent", nd.value(), 3);
    nsa.INsCounter up = d;
    result &= Test("ns_iface_upcast_parent",    up.value(), 3);

    return result;
}

// =============================================================
// Interface-return-dangle positive corpus
//
// These pin LEGAL programs (current compiler accepts them and prints the
// correct answer). Most were discovered while chasing
// internal/issue/interface-return-dangle-defeated-by-intermediate-local.md;
// a few (noted on the leg itself) are synthesized variants added later to
// close a coverage gap without duplicating an existing shape. Three
// separate fix attempts each passed the whole suite and each was caught
// only by adversarial review rejecting one of these shapes. Keep every
// shape below so a future attempt is reviewable by ./test.sh.
// =============================================================

// guards an early return inside a then-arm whose RETURNED value is not the frame box
// (the arm does write the frame box first - that is the point)
move IShape dangleThenArmEarlyReturn(int c)
{
    Square loc; loc.s = 3;
    Square* h = new Square(); h.s = 9;
    IShape r = h as IShape;
    if (c > 0)
    {
        r = loc as IShape;
        Square* h2 = new Square(); h2.s = 11;
        return h2 as IShape;
    }
    return r;
}

// guards the else-arm return that layout-order selection rejected (attempt 1)
move IShape dangleElseArmReturn(int c)
{
    Square loc; loc.s = 3;
    Square* h = new Square(); h.s = 9;
    IShape r = h as IShape;
    if (c > 0) { r = loc as IShape; printf("%d\n", r.area()); }
    else { return r; }
    Square* h2 = new Square(); h2.s = 11;
    return h2 as IShape;
}

// guards an early return sibling to the fallthrough path inside a switch case
move IShape dangleSwitchCaseEarlyReturn(int c)
{
    Square loc; loc.s = 3;
    Square* h = new Square(); h.s = 9;
    IShape r = h as IShape;
    switch (c)
    {
        case 1: { r = loc as IShape; printf("%d\n", r.area()); Square* h3 = new Square(); return h3 as IShape; }
        default: break;
    }
    return r;
}

// guards a while loop that may run zero times, never touching the frame box
move IShape dangleWhileLoopZeroIterations(int n)
{
    Square loc; loc.s = 3;
    Square* h = new Square(); h.s = 9;
    IShape r = h as IShape;
    int i = 0;
    while (i < n) { r = loc as IShape; Square* h4 = new Square(); return h4 as IShape; }
    return r;
}

// guards both if/else arms overwriting the slot before return (attempt 2: dominance)
move IShape dangleIfElseBothArmsOverwrite(int c)
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    if (c > 0)
    {
        Square* h1 = new Square(); h1.s = 9;
        r = h1 as IShape;
    }
    else
    {
        Square* h2 = new Square(); h2.s = 9;
        r = h2 as IShape;
    }
    return r;
}

// guards a switch where every case overwrites the slot before return
move IShape dangleSwitchBothCasesOverwrite(int c)
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    switch (c)
    {
        case 1: { Square* a = new Square(); a.s = 9; r = a as IShape; break; }
        default: { Square* b = new Square(); b.s = 9; r = b as IShape; break; }
    }
    return r;
}

// guards nested if/else where every leaf overwrites the slot
move IShape dangleNestedIfAllLeavesOverwrite(int c)
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    if (c > 0)
    {
        if (c > 5) { Square* a = new Square(); a.s = 9; r = a as IShape; }
        else { Square* b = new Square(); b.s = 9; r = b as IShape; }
    }
    else { Square* d = new Square(); d.s = 9; r = d as IShape; }
    return r;
}

// guards an if/else-if chain that is exhaustive by arithmetic but not by CFG shape
move IShape dangleIfElseIfChainExhaustiveByArithmetic(int c)
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    if (c > 0) { Square* a = new Square(); a.s = 9; r = a as IShape; }
    else if (c <= 0) { Square* b = new Square(); b.s = 9; r = b as IShape; }
    return r;
}

Square gDangleCorpusGlobal = default;

// guards boxing a global lvalue (not the frame box) into an interface return
IShape dangleGlobalBoxedSquare()
{
    gDangleCorpusGlobal.s = 9;
    return gDangleCorpusGlobal as IShape;
}

// guards boxing a pointer parameter (passed by value, as pointers are) straight into the
// return. A by-value STRUCT parameter ("Square p") boxed DIRECTLY ("return p as IShape;")
// is REJECTED by this compiler, but routed through an intermediate local first
// ("IShape r = p as IShape; return r;") it currently compiles and runs - that gap is the
// open bug in internal/issue/interface-return-dangle-defeated-by-intermediate-local.md.
IShape danglePointerParamDirect(Square* p)
{
    return p as IShape;
}

class SquareBox
{
    Square* sq = nullptr;
};

// guards a heap object reached through a by-value struct field held by a local
move IShape dangleHeapFieldThroughLocalHolder()
{
    SquareBox hd;
    hd.sq = new Square();
    hd.sq.s = 9;
    IShape r = hd.sq as IShape;
    return r;
}

// guards a pointer parameter rebound through a local before the return
IShape danglePtrParamThroughLocal(Square* p)
{
    IShape r = p as IShape;
    return r;
}

// guards a straight-line heap pointer boxed into a local then returned unmodified
move IShape dangleHeapPointerHeldInLocal()
{
    Square* h = new Square(); h.s = 9;
    IShape r = h as IShape;
    return r;
}

// guards a for-loop return that yields the heap box stored on the prior iteration
// (attempt 3: incomplete CFG at emission time)
move IShape dangleForLoopReturnPreviousIteration()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    for (int i = 0; i < 2; i++)
    {
        if (i == 1) { return r; }
        Square* h = new Square(); h.s = 9;
        r = h as IShape;
    }
    return r;
}

// guards a while-loop return that yields the heap box stored on the prior iteration
move IShape dangleWhileLoopReturnPreviousIteration()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    int i = 0;
    while (i < 5)
    {
        if (i > 0) { return r; }
        Square* h = new Square(); h.s = 9;
        r = h as IShape;
        i++;
    }
    return r;
}

// guards a do/while-loop return that yields the heap box stored on the prior iteration
move IShape dangleDoWhileLoopReturnPreviousIteration()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    int i = 0;
    do
    {
        if (i > 0) { return r; }
        Square* h = new Square(); h.s = 9;
        r = h as IShape;
        i++;
    } while (i < 5);
    return r;
}

// guards a return from inside a nested loop that yields a prior outer-loop store.
// "delete r" is guarded on i > 0: iteration 0's box would otherwise be dropped, unfreeable,
// when iteration 1 overwrites r - proven with a dtor-counting mirror (ctor==dtor==3).
move IShape dangleNestedLoopReturnFromInner()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    for (int i = 0; i < 3; i++)
    {
        for (int j = 0; j < 2; j++) { if (i == 2) { return r; } }
        Square* h = new Square(); h.s = 9;
        if (i > 0) { delete r; }
        r = h as IShape;
    }
    return r;
}

// guards a heap store already emitted where only the loop back-edge link was missing
move IShape dangleLoopMissingBackedgeAnalysis()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    for (int i = 0; i < 2; i++)
    {
        if (i == 0) { Square* h = new Square(); h.s = 9; r = h as IShape; }
        else { return r; }
    }
    return r;
}

// same for-loop-previous-iteration shape but with a non-move return type
IShape dangleForLoopReturnNonMoveType()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    for (int i = 0; i < 2; i++)
    {
        if (i == 1) { return r; }
        Square* h = new Square(); h.s = 9;
        r = h as IShape;
    }
    return r;
}

// guards a return-after-store within the same loop iteration, reached on a later pass.
// "delete r" is guarded on i > 0 for the same reason as dangleNestedLoopReturnFromInner -
// proven with a dtor-counting mirror (ctor==dtor==3).
move IShape dangleLoopReturnAfterStoreSameIteration()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    for (int i = 0; i < 3; i++)
    {
        Square* h = new Square(); h.s = 9;
        if (i > 0) { delete r; }
        r = h as IShape;
        if (i == 1) { return r; }
    }
    return r;
}

// guards a break out of the loop before the post-loop return of the last stored box
move IShape dangleLoopBreakThenReturn()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    for (int i = 0; i < 3; i++)
    {
        Square* h = new Square(); h.s = 9;
        r = h as IShape;
        if (i == 0) { break; }
    }
    return r;
}

// guards a while(true) loop whose body stores a heap box over the frame box, then breaks -
// distinct from leg 21 (dangleLoopBreakThenReturn), which is a bounded for-loop, not while(true)
move IShape dangleWhileTrueLoopStoreThenBreak()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    while (true)
    {
        Square* h = new Square(); h.s = 9;
        r = h as IShape;
        break;
    }
    return r;
}

// guards a slot stored only inside a loop that may run zero times
move IShape dangleLoopOnlyStoreMayRunZeroTimes(int n)
{
    IShape r = default;
    for (int i = 0; i < n; i++) { Square* h = new Square(); h.s = 9; r = h as IShape; }
    return r;
}

// Synthesized (not from a scratch/ repro): guards 3-level-deep nesting where one leaf is
// itself a loop, not just a wider if/else (a bare alpha-rename of
// dangleNestedIfAllLeavesOverwrite would collide with this shape otherwise - this one is a
// level deeper and mixes a loop leaf in). The loop leaf's
// "delete r" is guarded on i > 0 for the same reason as dangleNestedLoopReturnFromInner -
// proven with a dtor-counting mirror (ctor==dtor==3).
move IShape dangleDeepNestedIfLeavesAllOverwrite(int c, int d, int e)
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    if (c > 0) {
        if (d > 0) {
            if (e > 0) { Square* a = new Square(); a.s = 9; r = a as IShape; }
            else {
                for (int i = 0; i < 2; i++)
                {
                    Square* b = new Square(); b.s = 9;
                    if (i > 0) { delete r; }
                    r = b as IShape;
                }
            }
        } else {
            Square* g = new Square(); g.s = 9; r = g as IShape;
        }
    } else {
        Square* h = new Square(); h.s = 9; r = h as IShape;
    }
    return r;
}

// guards a ?: initializer later rebound to a heap box before return.
// h0 is NOT leaked on the path this leg exercises: the compiler emits a select over the
// ternary and a cleanup that frees the chosen pointer, so h0 is freed when c > 0. Do not
// "fix" it by adding "delete h0" - that is rejected outright ("its ownership was boxed
// into an interface... delete through the interface instead") because the compiler treats
// h0 as consumed by the ternary regardless of which arm runs. Shape is from the
// verified-legal repro scratch/rev3/n7_ternary_rebound.cb.
move IShape dangleTernaryInitializerReboundLater(int c)
{
    Square loc; loc.s = 3;
    Square* h0 = new Square(); h0.s = 1;
    IShape r = c > 0 ? (loc as IShape) : (h0 as IShape);
    Square* h = new Square(); h.s = 9;
    r = h as IShape;
    return r;
}

// guards two interface locals over the same class where only one is ever returned
move IShape dangleTwoInterfaceLocalsSameClass(int c)
{
    Square loc; loc.s = 3;
    IShape a = loc as IShape;
    Square* h = new Square(); h.s = 9;
    IShape b = h as IShape;
    if (c > 0) { return b; }
    return b;
}

// guards an interface local declared and discarded in an inner scope before the real return
move IShape dangleInnerScopeLocalDiscarded()
{
    { Square loc; loc.s = 3; IShape q = loc as IShape; }
    Square* h = new Square(); h.s = 9;
    IShape r = h as IShape;
    return r;
}

// guards a slot-to-slot interface copy (one interface local assigned from another),
// distinct from leg 26 which declares two locals but never copies one into the other
move IShape dangleSlotToSlotInterfaceCopy()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    Square* h = new Square(); h.s = 9;
    IShape src = h as IShape;
    r = src;
    return r;
}

struct DangleShapeFieldHolder { IShape s = default; };

// guards an interface value round-tripped through a struct field, distinct from leg 11
// which holds a raw Square* field rather than an already-boxed IShape field
move IShape dangleStructFieldRoundTrip()
{
    Square* h = new Square(); h.s = 9;
    DangleShapeFieldHolder hd;
    hd.s = h as IShape;
    IShape r = hd.s;
    return r;
}

int dangleUseShapeArg(IShape x) { return x.area(); }

// guards an interface local passed as an argument before being returned
move IShape dangleInterfaceLocalPassedAsArg()
{
    Square* h = new Square(); h.s = 9;
    IShape r = h as IShape;
    int q = dangleUseShapeArg(r);
    return r;
}

// guards "return r;" from INSIDE a nested { } scope, where scope-exit emission meets the
// return check; leg 27 opens an inner scope but returns outside it, this returns inside it
move IShape dangleReturnFromNestedScope()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    {
        Square* h = new Square(); h.s = 9;
        r = h as IShape;
        return r;
    }
}

// guards a bare "continue;" driving the loop back-edge (rev3/n4_loop_continue.cb, despite
// its name, contains no continue statement - nothing else in the corpus does either).
// "delete r" is guarded on i > 0 for the same reason as dangleNestedLoopReturnFromInner -
// proven with a dtor-counting mirror (ctor==dtor==3).
move IShape dangleLoopContinueThenReturnPrevious()
{
    Square loc; loc.s = 3;
    IShape r = loc as IShape;
    for (int i = 0; i < 3; i++)
    {
        if (i == 2) { return r; }
        Square* h = new Square(); h.s = 9;
        if (i > 0) { delete r; }
        r = h as IShape;
        continue;
    }
    return r;
}

// guards a "move" pointer parameter boxed directly into the return - no other leg has a
// move-qualified parameter
move IShape dangleAdoptMovePointerParam(move Square* p)
{
    return p as IShape;
}

bool testInterfaceReturnDangleCorpus()
{
    bool result = true;

    IShape v01 = dangleThenArmEarlyReturn(0);
    result &= Test("dangle_then_arm_early_return", v01.area(), 81);
    delete v01;

    IShape v02 = dangleElseArmReturn(0);
    result &= Test("dangle_else_arm_return", v02.area(), 81);
    delete v02;

    IShape v03 = dangleSwitchCaseEarlyReturn(0);
    result &= Test("dangle_switch_case_early_return", v03.area(), 81);
    delete v03;

    IShape v04 = dangleWhileLoopZeroIterations(0);
    result &= Test("dangle_while_loop_zero_iterations", v04.area(), 81);
    delete v04;

    IShape v05 = dangleIfElseBothArmsOverwrite(1);
    result &= Test("dangle_if_else_both_arms_overwrite", v05.area(), 81);
    delete v05;

    IShape v06 = dangleSwitchBothCasesOverwrite(1);
    result &= Test("dangle_switch_both_cases_overwrite", v06.area(), 81);
    delete v06;

    IShape v07 = dangleNestedIfAllLeavesOverwrite(1);
    result &= Test("dangle_nested_if_all_leaves_overwrite", v07.area(), 81);
    delete v07;

    IShape v08 = dangleIfElseIfChainExhaustiveByArithmetic(1);
    result &= Test("dangle_if_elseif_chain_exhaustive_by_arithmetic", v08.area(), 81);
    delete v08;

    IShape v09 = dangleGlobalBoxedSquare();
    result &= Test("dangle_global_boxed_square", v09.area(), 81);

    Square* p10 = new Square(); p10.s = 9;
    IShape v10 = danglePointerParamDirect(p10);
    result &= Test("dangle_pointer_param_direct", v10.area(), 81);
    delete p10;

    IShape v11 = dangleHeapFieldThroughLocalHolder();
    result &= Test("dangle_heap_field_through_local_holder", v11.area(), 81);
    delete v11;

    Square* p12 = new Square(); p12.s = 9;
    IShape v12 = danglePtrParamThroughLocal(p12);
    result &= Test("dangle_ptr_param_through_local", v12.area(), 81);
    delete p12;

    IShape v13 = dangleHeapPointerHeldInLocal();
    result &= Test("dangle_heap_pointer_held_in_local", v13.area(), 81);
    delete v13;

    IShape v14 = dangleForLoopReturnPreviousIteration();
    result &= Test("dangle_for_loop_return_previous_iteration", v14.area(), 81);
    delete v14;

    IShape v15 = dangleWhileLoopReturnPreviousIteration();
    result &= Test("dangle_while_loop_return_previous_iteration", v15.area(), 81);
    delete v15;

    IShape v16 = dangleDoWhileLoopReturnPreviousIteration();
    result &= Test("dangle_dowhile_loop_return_previous_iteration", v16.area(), 81);
    delete v16;

    IShape v17 = dangleNestedLoopReturnFromInner();
    result &= Test("dangle_nested_loop_return_from_inner", v17.area(), 81);
    delete v17;

    IShape v18 = dangleLoopMissingBackedgeAnalysis();
    result &= Test("dangle_loop_missing_backedge_analysis", v18.area(), 81);
    delete v18;

    IShape v19 = dangleForLoopReturnNonMoveType();
    result &= Test("dangle_for_loop_return_non_move_type", v19.area(), 81);
    delete v19;

    IShape v20 = dangleLoopReturnAfterStoreSameIteration();
    result &= Test("dangle_loop_return_after_store_same_iteration", v20.area(), 81);
    delete v20;

    IShape v21 = dangleLoopBreakThenReturn();
    result &= Test("dangle_loop_break_then_return", v21.area(), 81);
    delete v21;

    IShape v22 = dangleWhileTrueLoopStoreThenBreak();
    result &= Test("dangle_while_true_loop_store_then_break", v22.area(), 81);
    delete v22;

    IShape v23 = dangleLoopOnlyStoreMayRunZeroTimes(1);
    result &= Test("dangle_loop_only_store_may_run_zero_times", v23.area(), 81);
    delete v23;

    IShape v24 = dangleDeepNestedIfLeavesAllOverwrite(1, 1, 0);
    result &= Test("dangle_deep_nested_if_leaves_all_overwrite", v24.area(), 81);
    delete v24;

    IShape v25 = dangleTernaryInitializerReboundLater(1);
    result &= Test("dangle_ternary_initializer_rebound_later", v25.area(), 81);
    delete v25;

    IShape v26 = dangleTwoInterfaceLocalsSameClass(1);
    result &= Test("dangle_two_interface_locals_same_class", v26.area(), 81);
    delete v26;

    IShape v27 = dangleInnerScopeLocalDiscarded();
    result &= Test("dangle_inner_scope_local_discarded", v27.area(), 81);
    delete v27;

    IShape v28 = dangleSlotToSlotInterfaceCopy();
    result &= Test("dangle_slot_to_slot_interface_copy", v28.area(), 81);
    delete v28;

    IShape v29 = dangleStructFieldRoundTrip();
    result &= Test("dangle_struct_field_round_trip", v29.area(), 81);
    delete v29;

    IShape v30 = dangleInterfaceLocalPassedAsArg();
    result &= Test("dangle_interface_local_passed_as_arg", v30.area(), 81);
    delete v30;

    IShape v31 = dangleReturnFromNestedScope();
    result &= Test("dangle_return_from_nested_scope", v31.area(), 81);
    delete v31;

    IShape v32 = dangleLoopContinueThenReturnPrevious();
    result &= Test("dangle_loop_continue_then_return_previous", v32.area(), 81);
    delete v32;

    Square* p33 = new Square(); p33.s = 9;
    IShape v33 = dangleAdoptMovePointerParam(move p33);
    result &= Test("dangle_adopt_move_pointer_param", v33.area(), 81);
    delete v33;

    return result;
}

extern int main()
{
    int passed = 0;
    int total  = 0;

    total++; passed += testVTableDispatch()      ? 1 : 0;
    total++; passed += testIsOperator()          ? 1 : 0;
    total++; passed += testAsToStruct()          ? 1 : 0;
    total++; passed += testAsToInterface()       ? 1 : 0;
    total++; passed += testAsBoxConcretePointerIntoInterface() ? 1 : 0;
    total++; passed += testAsBoxStackValueIntoInterface()      ? 1 : 0;
    total++; passed += testAsBoxTransfersOwnership()           ? 1 : 0;
    total++; passed += testSwitchConcreteType()  ? 1 : 0;
    total++; passed += testSwitchInterfaceCase() ? 1 : 0;
    total++; passed += testSwitchDefault()       ? 1 : 0;
    total++; passed += testMultipleInterfaces()  ? 1 : 0;
    total++; passed += testReturnInterface()     ? 1 : 0;
    total++; passed += testListInterfaceBasic()  ? 1 : 0;
    total++; passed += testListInterfaceIsAs()   ? 1 : 0;
    total++; passed += testListInterfaceForeach() ? 1 : 0;
    total++; passed += testListInterfaceSort()   ? 1 : 0;
    total++; passed += testChannelInterface()    ? 1 : 0;
    total++; passed += testDeleteThroughInterface() ? 1 : 0;
    total++; passed += testMoveInterfaceParam()     ? 1 : 0;
    total++; passed += testMoveUniqueInterfaceLocal() ? 1 : 0;
    total++; passed += testMoveReturnClosureInterface() ? 1 : 0;
    total++; passed += testStringInheritedInterfaceChain() ? 1 : 0;
    total++; passed += testStringInterfaceList()         ? 1 : 0;
    total++; passed += testStringInterfaceChannel()      ? 1 : 0;
    total++; passed += testStringFieldThroughInterface() ? 1 : 0;
    total++; passed += testStringFieldMoveInterface()    ? 1 : 0;
    total++; passed += testStackOwningValueBoxedToInterface() ? 1 : 0;
    total++; passed += testInterfaceFieldString()        ? 1 : 0;
    total++; passed += testDowncastCallResultBorrow()    ? 1 : 0;
    total++; passed += testInterfaceFieldAccess()        ? 1 : 0;
    total++; passed += testInterfaceFieldNullConditional() ? 1 : 0;
    total++; passed += testInterfaceBraceInitField()     ? 1 : 0;
    total++; passed += testInterfaceIsNullUpcast()       ? 1 : 0;
    total++; passed += testInterfaceTernaryUpcast()      ? 1 : 0;
    total++; passed += testInterfaceTernaryAsCast()      ? 1 : 0;
    total++; passed += testInterfaceTernaryReturnUpcast() ? 1 : 0;
    total++; passed += testGenericInterfaceField()       ? 1 : 0;
    total++; passed += testGenericInterfaceExplicitPtrArg() ? 1 : 0;
    total++; passed += testLocalListInterfaceTakeDelete()     ? 1 : 0;
    total++; passed += testLocalListInterfaceGrowTakeDelete() ? 1 : 0;
    total++; passed += testFieldListInterfaceTeardown()       ? 1 : 0;
    total++; passed += testMoveParamThroughInterfaceMethod()  ? 1 : 0;
    total++; passed += testInterfaceArgPaths()                ? 1 : 0;
    total++; passed += testInterfaceMethodOwnershipContract()  ? 1 : 0;
    total++; passed += testInterfaceArrayField()               ? 1 : 0;
    total++; passed += testInterfaceArrayViewOfInterfaces()    ? 1 : 0;
    total++; passed += testInterfaceReboxDeclarationOrder()    ? 1 : 0;
    total++; passed += testInterfaceReboxAcrossImport()        ? 1 : 0;
    total++; passed += testInterfaceReboxUninstantiatedGeneric() ? 1 : 0;
    total++; passed += testInterfaceOverloadDispatch()           ? 1 : 0;
    total++; passed += testInterfaceNamedArguments()              ? 1 : 0;
    total++; passed += testNamespacedClassExplicitCtor()          ? 1 : 0;
    total++; passed += testNamespacedInterfaces()                ? 1 : 0;
    total++; passed += testInterfaceReturnDangleCorpus()          ? 1 : 0;
    total++; passed += testNamespacedInterfaceShadowsCoreName()   ? 1 : 0;
    total++; passed += testInterfaceFunctionPointerParam()         ? 1 : 0;

    printf("Interface/is/as tests: %d/%d passed.\n", passed, total);
    return passed == total ? 0 : 1;
}
