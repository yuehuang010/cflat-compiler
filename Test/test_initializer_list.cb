// Comprehensive positional / key:value brace-initializer tests across element types and constructs.
//   list<T>          = {v0, v1, ...}    -> add() per element
//   array<T>         = {v0, v1, ...}    -> init(N) then set(i, v)
//   dictionary<K,V>  = {k: v, ...}      -> set(k, v) per pair
//   T[N]             = {v0, v1, ...}    -> positional stores, trailing slots zero-filled
//   T[]              = {v0, v1, ...}    -> length-inferred backing array; thin T* points at elem 0
//
// CFlat does NOT implicitly down-convert, and the container paths (list/array/dictionary) drive
// add()/set() through overload resolution, so a genuinely narrowing element literal does not
// match: `list<u8> = {255}` (literal wider than u8) is intentionally rejected today, and is
// DISABLED below pending narrowing-conversion work. Note float literals default to f32 (1.5 is
// float, not double), so `list<float> = {1.5}` is NOT a narrow and is exercised here.
//
// Note: nested generic containers (list<list<int>>) are a separate, unrelated generics
// limitation - that type does not instantiate at all today - so they are out of scope here.
import "string.cb";
import "list.cb";
import "array.cb";
import "dictionary.cb";
import "function.cb";
import "test_helper.cb";

// Seed struct for the empty-brace legs below. Its fields default to NON-ZERO values on purpose:
// that is what distinguishes a real default-construction from a zero-fill or an undef read.
struct PtrSeed { int a = 7; int b = 9; };

// Empty '{}' as a PARAMETER DEFAULT. These are the deterministic half of the '= {}' seeding
// coverage: pre-fix BOTH were a hard compile error ("cannot build the default value for
// parameter ... this default initializer form is not supported"), because '{}' yields a null
// initializerList() and the wrapper's arms all missed. The struct one returns 79 (7*10+9), a
// value only real default-construction can produce - it cannot pass by zero-fill or by luck.
int ebParamInt(int x = {}) { return x; }
int ebParamStruct(PtrSeed s = {}) { return s.a * 10 + s.b; }

// '= default' is the remedy the empty-brace-on-a-pointer diagnostic names FIRST, and it is the
// only one valid at every instantiation of a generic body: 'T x = {}' rejects when T substitutes
// to a pointer (Test/errors/err_ptr_brace_init.cb pins that), so the guidance is only honest if
// the same body compiles at BOTH a pointer and a non-pointer T. Both are instantiated below.
struct EbHold<T> { T v = default; void seed() { T x = default; v = x; } };

// Brace-init bound to a POINTER PARAMETER at a call. This site is CORRECT and must stay working:
// it builds its own struct temp and passes THAT address, never a pointer variable's own 8 bytes.
struct PtrArg { int a = default; int b = default; };
int ptrArgSum(PtrArg* p) { return p->a * 10 + p->b; }
struct PtrArgHost { int use(PtrArg* p) { return p->a * 100 + p->b; } };

// ===== class with no user-written constructor: the synthesized default ctor =====
// Pre-fix the CLASS default ctor seeded its return aggregate with `undef` (the struct twin
// already seeded with zero), so `_C_C__` was literally `ret %C undef`.
class CNoCtor  { int a; int b; int c; int d; };            // no field has a default
class CMixed   { int a = 7; int b; int c = 9; int d; };    // some defaulted, some not
class CInner   { int x; int y; };
class CNest    { CInner i; int z; };                       // class-in-class field
class CWithDtor{ int a; int b; int c; int d; ~CWithDtor() { } };   // dtor, still no ctor
class CWithCtor{ int a; int b; CWithCtor() { a = 11; b = 12; } };  // must be UNTOUCHED
interface IArea { int Area(); };
class CSide : IArea { int side; int Area() { return side * side; } };
interface HeapDefaultIface { int value(); };
int heapDefaultDtors = 0;
class HeapDefaultImpl : HeapDefaultIface { int value() { return 1; } ~HeapDefaultImpl() { heapDefaultDtors = heapDefaultDtors + 1; } };
struct HeapDefaultHolder { unique HeapDefaultIface c = new HeapDefaultImpl(); };
class COwn     { string s; int n; };                       // owning field: null, then teardown
struct CBox<T> { T v; int tag; };                          // class inside a generic container

// ===== a struct FIELD whose OWN default is a brace list =====
// Pre-fix every default-ctor emitter read only `initializer->assignmentExpression()` and
// `initializer->Default()`, so a brace-list field default matched neither arm and the field
// was left at the zero seed. Every leg below reads 0 on the pre-fix binary.
struct FbIn    { int x; int y; };
struct FbSeed  { int x = 7; int y = 8; int w = 9; };       // inner scalar defaults of its own
struct FbEq    { FbIn i = { x = 1, y = 2 }; int z; };      // the '=' spelling
struct FbBare  { FbIn i { x = 3, y = 4 }; int z; };        // the BARE spelling: list on initDeclarator
struct FbPart  { FbSeed s = { x = 1 }; };                  // partial list: y/w keep FbSeed's defaults
struct FbEmpty { FbSeed s = {}; };                         // accept set: '{}' still default-constructs
class  FbClass { FbIn i = { x = 5, y = 6 }; int z; };      // class twin of FbEq
struct FbNest  { FbEq o; int w; };                         // brace-defaulted field one level down
struct FbBox<T>{ T v; };                                   // generic container over FbEq
struct FbCtor  { FbIn i = { x = 1, y = 2 }; int z; FbCtor() { z = 7; } };  // user no-arg ctor
interface IFbArea { int FbArea(); };
class FbIface : IFbArea { FbIn i = { x = 1, y = 2 }; int FbArea() { return i.x * 1000 + i.y; } };
struct FbList  { list<int> l = { 1, 2, 3 }; };             // container-typed field default
int fbBumped = 0;
int fbBump() { fbBumped = fbBumped + 1; return 41; }
struct FbSide  { FbIn i = { x = fbBump(), y = 2 }; };      // the call must run exactly once
FbEq fbGlobal = default;                                   // globals skip the ctor - still zero

// Nested named braces reuse the ordinary per-field emission path.
struct NbiLeaf   { int x = 11; string label = default; };
struct NbiMiddle { NbiLeaf leaf = default; int keep = 22; };
struct NbiOuter  { NbiMiddle middle = default; list<int> nums = default; int[3] fixed = default; int id = 33; };
struct NbiDefaultOuter { NbiMiddle middle = { leaf = { x = 5, label = "field" } }; };

// ===== a FIXED-ARRAY field whose OWN default is a brace list =====
// The brace-list field arm above bailed on ConstArraySize > 0, so an array field fell back to
// the zero seed. Every value leg below reads 0 (or "") on the pre-fix binary. The list is
// POSITIONAL, so the value is built as an [N x T] aggregate for the insertvalue - the named
// field-init path the struct case uses cannot express it.
struct FbaHost   { int[3] a = { 1, 2, 3 }; int z; };        // the headline repro
struct FbaShort  { int[3] a = { 4 }; };                     // short list: trailing slots zero
struct FbaChar   { char[4] c = { 'a', 'b', 'c' }; };        // char element, NUL-terminated tail
struct FbaPtr    { FbIn*[2] p = { nullptr, nullptr }; };    // pointer ELEMENT, positional
struct FbaNamed  { FbSeed[2] s = { x = 5 }; };              // NAMED list: seed once, splat over N
struct FbaStr    { string[2] s = { "ab", "cd" }; };         // OWNING element: value + no leak
class  FbaClass  { int[3] a = { 7, 8, 9 }; int z; };        // class twin
struct FbaBox<T> { T[3] a = { 1, 2, 3 }; };                 // generic owner
struct FbaCtor   { int[3] a = { 1, 2, 3 }; int z; FbaCtor() { z = 6; } };  // user no-arg ctor
int fbaBumped = 0;
int fbaBump() { fbaBumped = fbaBumped + 1; return 4; }
struct FbaSide   { int[3] a = { fbaBump(), 2, 3 }; };       // NON-constant element, runs once
struct FbaEmpty  { int[3] a = {}; };                        // accept cell: '{}' stays zero

// ===== An OWNING element under a NAMED value-init list ('T[N] a = { field = v }') =====
// PRE, both the local declarator arm and the field arm built ONE seed element and memcpy'd it
// into every slot, so every element's `string` pointed at the SAME heap buffer: correct values,
// then a double free at teardown (rc 133). POST each slot is constructed on its own. The
// ctor-count legs are the discriminator - the count moves from 1 to N, converging on the
// '= default' and no-initializer spellings, which already build per slot.
int sviCtors = 0;
string sviMk()   { sviCtors = sviCtors + 1; string a = "he"; string b = "llo"; return a + b; }
struct SviE      { string s = sviMk(); int v = default; };
struct SviHost   { SviE[2] e = { v = 5 }; };                 // FIELD spelling of the same shape
int sviDtors = 0;
struct SviD      { int v = default; ~SviD() { sviDtors = sviDtors + 1; } };  // dtor, owns nothing
int sviNews = 0;
struct SviT      { int x = default; };
SviT* sviMkT()   { sviNews = sviNews + 1; SviT* p = new SviT(); p.x = 9; return p; }

// Per-element construction COUNT fixture: a field initializer with a side effect.
struct SviCount  { int k = sviBump(); };

// Raw `new T[n]` heap array of an OWNING struct - the double-free repro's types.
int rawHeapDtors = 0;
class RawHeapNode { int v = default; ~RawHeapNode() { rawHeapDtors = rawHeapDtors + 1; } };
struct RawHeapBox { unique RawHeapNode* p = default; };
RawHeapBox rawHeapMk(int v) { RawHeapBox b = default; b.p = new RawHeapNode(); b.p.v = v; return b; }

int braceOverrideDtors = 0;
struct BraceOverrideNode { ~BraceOverrideNode() { braceOverrideDtors = braceOverrideDtors + 1; } };
struct BraceOverrideOwner { unique BraceOverrideNode* p = new BraceOverrideNode(); int v = default; };
struct SviU      { unique SviT* p = sviMkT(); int v = default; };
struct SviPod    { int a = 1; int b = 2; };                  // POD anchor: constant override
// The override EXPRESSION's own side effects: re-evaluated per slot on BOTH arms (Q13 ruling).
int sviOv = 0;
int sviBump()    { sviOv = sviOv + 1; return sviOv; }

// ===== 'S[N] a = default;' on the STACK: types for the per-element seeding legs =====
// PRE, this one spelling zero-filled the whole array and skipped every field initializer, while
// the bare 'S[N] a;' spelling and the heap 'new S[N]' both ran them. POST it is byte-identical
// to the bare spelling (only __FILE__ differs in the emitted IR).
struct FadS      { int k = 7; };
struct FadInner  { int w = 42; };
struct FadDeep   { int k = 7; FadInner d; };                     // struct-typed field, no initializer
struct FadFd     { FadInner d = default; int k = 7; };           // the field's own '= default'
struct FadNone   { int k; int j; };                              // no field defaults - accept cell
struct FadCtor   { int k = 1; FadCtor() { k = 9; } };            // user no-arg ctor
struct FadAllDef { int k = 1; FadAllDef(int v = 5) { k = v; } }; // all-defaulted ctor
struct FadBox<T> { T v; int tag = 5; };                          // generic element
int fadDtors = 0;
struct FadDtor   { int k = 7; ~FadDtor() { fadDtors = fadDtors + 1; } };
int fadAddOne(int x) { return x + 1; }
struct FadClo    { Lambda<int(int)> f = fadAddOne; };            // PRE: the zeroed slot was CALLED
FadS[2] fadGlobal = default;                       // frozen: a global still skips the ctor
struct FadHost   { FadS[2] a; int z = 3; };        // field array defaults are constructed per element

// ===== BRACED elements of a fixed array ('T[N] a = { {field = v}, ... }') =====
// PRE, every element path read `fi->assignmentExpression(0)`, which a BRACED fieldInit
// (CFlat.g4 fieldInit's '{' initializerList? '}' alternative) does not have: the compiler
// walked a null context and SIGSEGV'd with no diagnostic, on `T[N]`, `T[N][M]`, the struct
// FIELD spelling and the global spelling alike. POST the element is constructed and its list
// goes through EmitFieldInitializer - the same machinery the scalar `T x = {field = v};`
// spelling uses - so every field-store rule (ownership, string copy, interface rebox,
// temp-field reject) reaches an array element for free.
struct NbeP      { int a = 9; int b = 8; };                  // field DEFAULTS must survive a partial list
struct NbeQ      { NbeP inner = default; };                  // brace nested inside a braced element
struct NbeHost   { NbeP[2] items = { {a=1,b=2}, {a=3,b=4} }; };   // struct FIELD of array type
interface NbeI   { int get(); };
class NbeImpl : NbeI { int v = 0; int get() { return v; } };
struct NbeW      { NbeI item = default; };                   // interface field: rebox through EmitOneFieldInit
int nbeDtors = 0;
struct NbeR      { int v = default; ~NbeR() { nbeDtors = nbeDtors + 1; } };
struct NbeH      { NbeR r = default; };
struct NbeStr    { string s = default; };                    // owning element: implicit copy per slot

// Reject cell: the element type has no fields for a brace to name.
expect_error("is not a struct, so there are no fields to initialize")
{
    void nbeScalarElementBrace() { int[2] bad = { {1}, 2 }; printf("%d", bad[0]); }
}
// Reject cell: a global element needs a runtime field-initializer, exactly as the scalar
// global brace spelling does.
expect_error("at global scope")
{
    NbeP[2] nbeGlobalBrace = { {a=1}, {a=2} };
}

int cNoCtorSum(CNoCtor v) { return v.a + v.b + v.c + v.d; }      // pass by value
CNoCtor cNoCtorMake()     { CNoCtor t; return t; }               // return by value

extern int main()
{
    int passed = 0;
    int total = 0;

    // An interface field initialized by a concrete heap implementation must be boxed by the
    // synthesized default constructor, so dispatch sees a real vtable rather than null.
    {
        heapDefaultDtors = 0;
        HeapDefaultHolder heapDefault = default;
        total++; passed += Test("interface field heap default dispatch", heapDefault.c.value(), 1);
    }
    total++; passed += Test("interface field heap default frees once", heapDefaultDtors, 1);

    // ===== list<T> across element types =====
    list<int> li = {10, 20, 30};
    total++; passed += Test("list<int> count", li.count(), 3);
    total++; passed += Test("list<int> sum", li.get(0) + li.get(1) + li.get(2), 60);

    list<i64> lbig = {1000000000000, 2000000000000};
    total++; passed += Test("list<i64> count", lbig.count(), 2);
    total++; passed += Test("list<i64>[1]", lbig.get(1), (i64)2000000000000);

    list<bool> lbool = {true, false, true};
    total++; passed += Test("list<bool> count", lbool.count(), 3);
    total++; passed += Test("list<bool>[0]", lbool.get(0), true);
    total++; passed += Test("list<bool>[1]", lbool.get(1), false);

    list<string> ls = {"alpha", "beta", "gamma"};   // char* literals coerced to string
    total++; passed += Test("list<string> count", ls.count(), 3);
    total++; passed += Test("list<string>[0]", ls.get(0), "alpha");
    total++; passed += Test("list<string>[2]", ls.get(2), "gamma");

    list<float> lf = {1.5, 2.5};   // 1.5/2.5 are f32 literals -> match float element
    total++; passed += Test("list<float> count", lf.count(), 2);
    total++; passed += Test("list<float>[0]", lf.get(0), 1.5f);
    total++; passed += Test("list<float>[1]", lf.get(1), 2.5f);

    // DISABLED (genuine narrowing - no implicit down-convert; pending later work):
    //   list<u8>    lu = {1, 2, 255};      // int literal -> u8 narrows

    // ===== array<T> =====
    array<int> ai = {1, 2, 3, 4};
    total++; passed += Test("array<int> count", ai.count(), 4);
    total++; passed += Test("array<int>[3]", ai.get(3), 4);

    array<i64> al = {100, 200};                // widening: int literals -> i64 (allowed)
    total++; passed += Test("array<i64>[0]", al.get(0), (i64)100);

    array<float> af = {1.5, 2.5};              // f32 literals -> float element
    total++; passed += Test("array<float>[0]", af.get(0), 1.5f);
    total++; passed += Test("array<float>[1]", af.get(1), 2.5f);

    // ===== dictionary<K,V> =====
    dictionary<int, int> di = {1: 100, 2: 200, 3: 300};
    total++; passed += Test("dict<int,int> count", di.count(), 3);
    total++; passed += Test("dict<int,int>[2]", di.get(2), 200);

    dictionary<string, string> ds = {"k1": "v1", "k2": "v2"};
    total++; passed += Test("dict<string,string> count", ds.count(), 2);
    total++; passed += Test("dict<string,string>[k1]", ds.get("k1"), "v1");
    total++; passed += Test("dict<string,string>[k2]", ds.get("k2"), "v2");

    dictionary<int, string> dis = {1: "one", 2: "two"};
    total++; passed += Test("dict<int,string>[1]", dis.get(1), "one");

    // DISABLED (narrowing K and V): dictionary<u8, float> duf = {1: 1.5, 2: 2.5};

    // ===== fixed array T[N] =====
    int[5] fa = {7, 8, 9};                     // partial fill: trailing slots zero-filled
    total++; passed += Test("int[5][0]", fa[0], 7);
    total++; passed += Test("int[5][2]", fa[2], 9);
    total++; passed += Test("int[5][3] zero-fill", fa[3], 0);
    total++; passed += Test("int[5][4] zero-fill", fa[4], 0);

    int[3] fb = {100, 200, 300};               // fully populated
    total++; passed += Test("int[3] sum", fb[0] + fb[1] + fb[2], 600);

    i64[2] fd = {5000000000, 1};
    total++; passed += Test("i64[2][0]", fd[0], (i64)5000000000);

    char[4] fe = {72, 73, 0, 0};               // 'H', 'I' (char-from-int-constant, like C)
    total++; passed += Test("char[4][0]", (int)fe[0], 72);
    total++; passed += Test("char[4][1]", (int)fe[1], 73);

    char[8] cstr = "hello";
    total++; passed += Test("char literal array first", cstr[0], 'h');
    total++; passed += Test("char literal array terminator", (int)cstr[5], 0);

    bool[3] fg = {true, false, true};
    total++; passed += Test("bool[3][0]", fg[0], true);
    total++; passed += Test("bool[3][2]", fg[2], true);

    float[3] fc = {1.5, 2.5, 3.0};             // f32 literals
    total++; passed += Test("float[3][0]", fc[0], 1.5f);
    total++; passed += Test("float[3][2]", fc[2], 3.0f);

    // ===== length-inferred array-view T[] (thin T* over a backing array) =====
    int[] iv = {11, 22, 33};
    total++; passed += Test("int[] iv[0]", iv[0], 11);
    total++; passed += Test("int[] iv[2]", iv[2], 33);

    i64[] lv = {9000000000, 1};
    total++; passed += Test("i64[] lv[0]", lv[0], (i64)9000000000);

    string[] sv = {"x", "y"};
    total++; passed += Test("string[] sv[0]", sv[0], "x");
    total++; passed += Test("string[] sv[1]", sv[1], "y");

    float[] fv = {1.5, 2.5};                   // f32 literals; thin float* over backing array
    total++; passed += Test("float[] fv[0]", fv[0], 1.5f);
    total++; passed += Test("float[] fv[1]", fv[1], 2.5f);

    // ===== identifier / expression elements =====
    // Regression: a bare-identifier element (e.g. `{ e0 }`) was parsed with its
    // VariableName set and the synthesized add()/set() then treated it as a NAMED
    // argument ("named argument 'e0' does not match any parameter"). Literal elements
    // worked; identifier elements did not. All container forms must accept them.
    int e0 = 10;
    int e1 = 20;
    list<int> lid = {e0, e1, e0 + e1};
    total++; passed += Test("list<int> ident elems count", lid.count(), 3);
    total++; passed += Test("list<int> ident elems[2]", lid.get(2), 30);

    array<int> aid = {e0, e1};
    total++; passed += Test("array<int> ident elems[1]", aid.get(1), 20);

    int dk = 5;
    dictionary<int, int> did = {dk: e0, 6: e1};
    total++; passed += Test("dict<int,int> ident key/val", did.get(5), 10);

    string se = "elem";                        // owning local moved positionally into list
    list<string> lse = {se};
    total++; passed += Test("list<string> ident elem", lse.get(0), "elem");

    // ===== array<string> ownership (regression: double-free / heap corruption) =====
    // array<T>.set() copy-assigned an owning element while the by-value parameter's
    // scope-exit destructor freed the same buffer. The array brace-initializer drives
    // set() per element, so populating + destructing array<string> corrupted the heap.
    // Build, overwrite, and let it destruct inside a scope; then allocate again so any
    // heap corruption from the buggy path would surface here.
    {
        array<string> sarr = {"aa", "bb", "cc"};
        total++; passed += Test("array<string>[0]", sarr.get(0), "aa");
        total++; passed += Test("array<string>[2]", sarr.get(2), "cc");
        sarr.set(1, "OVER");
        total++; passed += Test("array<string> overwrite", sarr.get(1), "OVER");
    }
    list<string> afterArr = {"x", "y", "z"};   // alloc after array<string> destruct
    total++; passed += Test("post array<string> alloc ok", afterArr.count(), 3);

    // ===== empty '{}' on a NON-POINTER target seeds the default =====
    // '{}' produces a NULL initializerList() (the list rule requires >= 1 element), so the
    // '= {}' declarator arm - which was gated on that list - matched nothing and emitted no
    // store at all: 'int x = {}' read undef. The arm is now gated on the brace TOKEN, exactly
    // as the bare-brace form 'int x {}' always was. Both spellings are asserted together here
    // because the pair disagreeing was the whole bug.
    //
    // '{}' on a POINTER target is REJECTED in every spelling (it is ambiguous between the null
    // pointer and a pointer to an empty object) - see Test/errors/err_ptr_brace_init.cb. That
    // supersedes the `PtrSeed*[2] pa = {}` zero-init legs this block replaced.
    int ebEq = {};
    int ebBare {};
    total++; passed += Test("int eq-empty-brace seeds zero", ebEq, 0);
    total++; passed += Test("int bare-empty-brace seeds zero", ebBare, 0);
    total++; passed += Test("int eq-empty-brace agrees with bare", ebEq, ebBare);

    PtrSeed ebs = {};                          // struct: real default-construction, not zero-fill
    total++; passed += Test("struct eq-empty-brace field default a", ebs.a, 7);
    total++; passed += Test("struct eq-empty-brace field default b", ebs.b, 9);

    PtrSeed[2] ebArr = {};                      // NON-pointer array keeps seeding per element
    total++; passed += Test("struct-array eq-empty-brace elem1 a", ebArr[1].a, 7);
    total++; passed += Test("struct-array eq-empty-brace elem1 b", ebArr[1].b, 9);

    // Parameter defaults - the deterministic legs (pre-fix: hard compile error, see above).
    total++; passed += Test("param default int eq-empty-brace", ebParamInt(), 0);
    total++; passed += Test("param default struct eq-empty-brace", ebParamStruct(), 79);

    // 'T x = default;' at a non-pointer AND a pointer type argument - the remedy the reject
    // suggests. Seed the non-pointer one from a non-zero value first so the leg cannot pass by
    // reading an already-zero slot: seed() must overwrite 5 with the default 0.
    EbHold<int> ebhi = default;
    ebhi.v = 5;
    ebhi.seed();
    total++; passed += Test("generic 'T x = default' at T=int", ebhi.v, 0);

    EbHold<PtrSeed*> ebhp = default;
    ebhp.v = new PtrSeed();
    ebhp.seed();
    total++; passed += Test("generic 'T x = default' at T=ptr", (i64)ebhp.v, (i64)0);

    // ===== brace argument bound to a POINTER parameter (must NOT be rejected) =====
    // Discriminator: both field values arrive intact through a real materialized temp, so 12
    // and 304 are unreachable if the braces ever wrote into the pointer slot instead.
    PtrArgHost pah = default;
    total++; passed += Test("ptr param brace arg positional", ptrArgSum({a=1,b=2}), 12);
    total++; passed += Test("ptr param brace arg named", ptrArgSum(p: {a=1,b=2}), 12);
    total++; passed += Test("ptr param brace arg method", pah.use({a=3,b=4}), 304);

    // ===== class with no user-written ctor default-constructs like the struct twin =====
    // Every leg below read `undef` pre-fix. Discriminator for the all-zero legs: they SUM four
    // (or three) independent fields, so a single stale stack word makes the sum non-zero - the
    // pre-fix binary produced a different, varying non-zero value on each run.
    CNoCtor cnc;
    total++; passed += Test("class no-ctor bare local zero", cNoCtorSum(cnc), 0);
    CNoCtor cnc2 = {};
    total++; passed += Test("class no-ctor eq-empty-brace zero", cnc2.a + cnc2.b + cnc2.c + cnc2.d, 0);
    CNoCtor cnc3 = default;
    total++; passed += Test("class no-ctor '= default' zero", cnc3.a + cnc3.b + cnc3.c + cnc3.d, 0);

    // Field defaults must still be honoured: 7*1000 + 9 is only reachable if the defaulted
    // fields keep their values AND the undefaulted ones are zero. Garbage cannot hit 7009.
    CMixed cmx;
    total++; passed += Test("class no-ctor field defaults honoured", cmx.a * 1000 + cmx.b + cmx.c + cmx.d, 7009);

    // Class-typed field of a class: the nested default ctor's result is inserted, so the
    // nested fields are the ones that were undef.
    CNest cn;
    total++; passed += Test("class no-ctor nested class field zero", cn.i.x + cn.i.y + cn.z, 0);

    // A destructor but no constructor still gets the synthesized zero ctor.
    CWithDtor cwd;
    total++; passed += Test("class no-ctor with dtor zero", cwd.a + cwd.b + cwd.c + cwd.d, 0);

    // Must be UNTOUCHED: a user-written no-arg ctor suppresses the synthesized one entirely.
    CWithCtor cwc;
    total++; passed += Test("class user ctor unchanged", cwc.a * 100 + cwc.b, 1112);

    // Interface dispatch after default construction: side is 0, so Area() is 0 through both the
    // direct call and the fat-pointer slot. Assigning 6 then re-dispatching proves the vtable is
    // real (36 is unreachable if the interface value lost its object or its slot).
    CSide cs;
    total++; passed += Test("class no-ctor iface direct after default", cs.Area(), 0);
    IArea csi = cs;
    total++; passed += Test("class no-ctor iface slot after default", csi.Area(), 0);
    cs.side = 6;
    IArea csi2 = cs;
    total++; passed += Test("class no-ctor iface slot still dispatches", csi2.Area(), 36);

    // Owning field: default must NULL the string (length 0, no garbage pointer) and the value
    // must survive scope exit. length() on an undef {ptr,len} pair was reading a stale word.
    {
        COwn co;
        total++; passed += Test("class no-ctor owning field empty", co.s.length() + co.n, 0);
        co.s = "hello";
        total++; passed += Test("class no-ctor owning field assignable", co.s.length(), 5);
    }

    // Storage axis: array element, heap `new`, by-value return, whole-value copy.
    CNoCtor[3] cncArr;
    total++; passed += Test("class no-ctor array elem zero",
                            cncArr[0].a + cncArr[0].b + cncArr[2].c + cncArr[2].d, 0);
    CNoCtor* cncHeap = new CNoCtor();
    total++; passed += Test("class no-ctor heap new zero",
                            cncHeap->a + cncHeap->b + cncHeap->c + cncHeap->d, 0);
    delete cncHeap;
    CNoCtor cncRet = cNoCtorMake();
    total++; passed += Test("class no-ctor return by value zero", cNoCtorSum(cncRet), 0);
    CNoCtor cncCopy = cnc;
    total++; passed += Test("class no-ctor whole-value copy zero", cNoCtorSum(cncCopy), 0);

    // A class inside a generic struct: the container's own default ctor CALLS _CNoCtor_CNoCtor__,
    // so the undef propagated through the generic instantiation too.
    CBox<CNoCtor> cbx;
    total++; passed += Test("class no-ctor inside generic zero",
                            cbx.v.a + cbx.v.b + cbx.v.c + cbx.v.d + cbx.tag, 0);

    // ===== brace-list field defaults =====
    // Every sum below is x*1000+y, so a zero-filled or garbage field cannot produce it.
    FbEq fbe;
    total++; passed += Test("field brace default eq spelling", fbe.i.x * 1000 + fbe.i.y, 1002);
    // Accept set - identical on both binaries: a brace list naming 'i' must not disturb 'z'.
    total++; passed += Test("field brace default leaves other fields zero", fbe.z, 0);

    // The bare spelling carries its list on initDeclarator, not on an initializer - a separate
    // grammar node, and the one the global-positional family was bitten by.
    FbBare fbb;
    total++; passed += Test("field brace default bare spelling", fbb.i.x * 1000 + fbb.i.y, 3004);

    // Partial list: only x is named, so y and w must keep FbSeed's OWN scalar defaults (8, 9).
    // 189 is unreachable both from a zero fill (000) and from ignoring the list (789).
    FbPart fbp;
    total++; passed += Test("field brace default partial keeps inner defaults",
                            fbp.s.x * 100 + fbp.s.y * 10 + fbp.s.w, 189);

    // Accept set - identical on both binaries: '{}' has no list and must still default-construct.
    FbEmpty fbem;
    total++; passed += Test("field brace default empty still default constructs",
                            fbem.s.x * 100 + fbem.s.y * 10 + fbem.s.w, 789);

    FbClass fbc;
    total++; passed += Test("field brace default class twin", fbc.i.x * 1000 + fbc.i.y, 5006);

    // One level down: FbNest has no initializer at all, so FbEq's ctor has to be called and
    // carry the brace default with it.
    FbNest fbn;
    total++; passed += Test("field brace default nested container",
                            fbn.o.i.x * 1000 + fbn.o.i.y + fbn.w, 1002);

    FbBox<FbEq> fbx;
    total++; passed += Test("field brace default inside generic", fbx.v.i.x * 1000 + fbx.v.i.y, 1002);

    // A user-written no-arg ctor is a separate emitter (a store into 'this', not an insertvalue
    // into a returned aggregate) and needs the same seeding before the ctor body runs.
    FbCtor fbct;
    total++; passed += Test("field brace default user no-arg ctor",
                            fbct.i.x * 1000 + fbct.i.y + fbct.z, 1009);

    FbIface fbi;
    IFbArea fbia = fbi;
    total++; passed += Test("field brace default through interface slot", fbia.FbArea(), 1002);

    // A container-typed field default routes through the add() desugaring, not field-init.
    FbList fbl;
    int fblSum = 0;
    for (int fbk = 0; fbk < fbl.l.count(); fbk = fbk + 1) { fblSum = fblSum + fbl.l.get(fbk); }
    total++; passed += Test("field brace default container count", fbl.l.count(), 3);
    total++; passed += Test("field brace default container values", fblSum, 6);

    // A call in a brace-list field default must run exactly once per construction.
    FbSide fbs;
    total++; passed += Test("field brace default call value", fbs.i.x * 1000 + fbs.i.y, 41002);
    total++; passed += Test("field brace default call runs once", fbBumped, 1);

    // Nested named braces recurse through three struct levels, replace an owning string,
    // preserve omitted defaults, and route a named list field through its normal initializer.
    NbiOuter nbi = { id = 7, middle = { leaf = { x = 3, label = "hi" } }, nums = { 1, 2, 3 }, fixed = { 4, 5, 6 } };
    total++; passed += Test("nested named struct value", nbi.middle.leaf.x, 3);
    total++; passed += Test("nested named owning string", nbi.middle.leaf.label, "hi");
    total++; passed += Test("nested named omitted field default", nbi.middle.keep, 22);
    total++; passed += Test("nested named list count", nbi.nums.count(), 3);
    total++; passed += Test("nested named list values", nbi.nums.get(0) + nbi.nums.get(1) + nbi.nums.get(2), 6);
    total++; passed += Test("nested named fixed array values", nbi.fixed[0] + nbi.fixed[1] + nbi.fixed[2], 15);

    NbiDefaultOuter nbiFieldDefault;
    total++; passed += Test("nested named field default", nbiFieldDefault.middle.leaf.x, 5);
    total++; passed += Test("nested named field default string", nbiFieldDefault.middle.leaf.label, "field");

    NbiOuter* nbiNew = new NbiOuter { middle = { leaf = { x = 4, label = "new" } } };
    total++; passed += Test("nested named new expression", nbiNew->middle.leaf.x, 4);
    total++; passed += Test("nested named new owning string", nbiNew->middle.leaf.label, "new");
    delete nbiNew;

    NbiOuter nbiPartial = { middle = { leaf = { x = 9 } } };
    total++; passed += Test("nested named partial keeps leaf default", nbiPartial.middle.leaf.label, "");
    total++; passed += Test("nested named partial keeps middle default", nbiPartial.middle.keep, 22);
    total++; passed += Test("nested named partial keeps outer default", nbiPartial.id, 33);

    // Instantiation axis - all four spellings run the same synthesized ctor.
    FbEq fbeB = {};
    total++; passed += Test("field brace default via empty brace", fbeB.i.x * 1000 + fbeB.i.y, 1002);
    FbEq fbeD = default;
    total++; passed += Test("field brace default via default", fbeD.i.x * 1000 + fbeD.i.y, 1002);
    FbEq* fbeH = new FbEq();
    total++; passed += Test("field brace default via new", fbeH->i.x * 1000 + fbeH->i.y, 1002);
    delete fbeH;
    FbEq[3] fbeArr;
    total++; passed += Test("field brace default in array element",
                            fbeArr[0].i.x * 1000 + fbeArr[2].i.y, 1002);
    // A container brace-init that does NOT name i must not wipe i's own default.
    FbEq fbeZ = { z = 5 };
    total++; passed += Test("field brace default survives outer brace init",
                            fbeZ.i.x * 1000 + fbeZ.i.y + fbeZ.z, 1007);

    // Frozen, NOT fixed here: a global never runs the ctor at all, so it still reads zero.
    // That is global-struct-no-initializer-ignores-field-defaults, identical on both binaries.
    total++; passed += Test("field brace default at global scope still zero",
                            fbGlobal.i.x * 1000 + fbGlobal.i.y, 0);

    // ===== 'S[N] a = default;' runs the element's field initializers per element =====
    // Every leg in this block read 0 (or crashed) on the pre-fix binary.
    FadS[2] fadA = default;
    total++; passed += Test("fixed-array '= default' element 0", fadA[0].k, 7);
    total++; passed += Test("fixed-array '= default' element 1", fadA[1].k, 7);

    FadDeep[2] fadD = default;
    total++; passed += Test("fixed-array '= default' depth-2 struct field", fadD[1].d.w, 42);
    total++; passed += Test("fixed-array '= default' depth-2 scalar field", fadD[1].k, 7);

    FadFd[2] fadF = default;
    total++; passed += Test("fixed-array '= default' field's own '= default'", fadF[1].d.w, 42);

    FadCtor[2] fadC = default;
    total++; passed += Test("fixed-array '= default' user no-arg ctor", fadC[0].k + fadC[1].k, 18);

    FadAllDef[2] fadAd = default;
    total++; passed += Test("fixed-array '= default' all-defaulted ctor", fadAd[0].k + fadAd[1].k, 10);

    FadBox<int>[2] fadG = default;
    total++; passed += Test("fixed-array '= default' generic element", fadG[0].tag + fadG[1].tag, 10);

    FadS[2][2] fadN = default;
    total++; passed += Test("fixed-array '= default' nested dimensions", fadN[0][0].k + fadN[1][1].k, 14);

    FadS[1] fadOne = default;
    total++; passed += Test("fixed-array '= default' N=1", fadOne[0].k, 7);

    // N=64 is past kMaxUnrolledArrayElements, so this is the only leg on the LOOP arm of
    // EmitFixedArrayElementWalk; every other leg here exercises the unrolled arm.
    FadS[64] fadBig = default;
    total++; passed += Test("fixed-array '= default' N=64 loop arm", fadBig[0].k + fadBig[63].k, 14);

    // A closure field default. PRE the zeroed slot was called and the program SIGSEGV'd, so this
    // leg cannot report a wrong value on the old binary - it takes the whole process down.
    FadClo[2] fadL = default;
    total++; passed += Test("fixed-array '= default' closure element", fadL[1].f(30), 31);

    // Seeding must not change destruction: exactly one destructor call per element.
    {
        FadDtor[3] fadT = default;
        total++; passed += Test("fixed-array '= default' dtor element value", fadT[2].k, 7);
    }
    total++; passed += Test("fixed-array '= default' destructs each element once", fadDtors, 3);

    // ===== fixed-array FIELD brace-list defaults =====
    // Each expected value is positional (d0*100 + d1*10 + d2), so a zero fill, a reversed
    // order, or a splat of one element cannot produce it.
    FbaHost fbah;
    total++; passed += Test("fixed-array field brace positional",
                            fbah.a[0] * 100 + fbah.a[1] * 10 + fbah.a[2], 123);
    // Accept set - identical on both binaries: the list names 'a', so 'z' must stay zero.
    total++; passed += Test("fixed-array field brace leaves sibling zero", fbah.z, 0);

    // Short list: named slots take their values, trailing slots zero-fill. 400 is unreachable
    // both from a zero fill (0) and from a splat of the one element (444).
    FbaShort fbas;
    total++; passed += Test("fixed-array field brace short list zero-fills tail",
                            fbas.a[0] * 100 + fbas.a[1] * 10 + fbas.a[2], 400);

    // char element: the unwritten 4th slot is the NUL a C string needs, so this reads back
    // through strlen as a real 3-char string, not just three ints.
    FbaChar fbac;
    total++; passed += Test("fixed-array field brace char element", fbac.c[1], 'b');
    total++; passed += Test("fixed-array field brace char tail is NUL", (int)fbac.c[3], 0);

    // Pointer ELEMENT with a POSITIONAL list is legal (the named form is rejected - see
    // Test/errors/err_field_brace_reject.cb); nullptr must land as a real null store.
    FbaPtr fbap;
    total++; passed += Test("fixed-array field brace pointer element", (i64)fbap.p[1], (i64)0);

    // NAMED entries over a struct element type: build one element, apply 'x = 5', memcpy it
    // into all N. 5858 proves BOTH slots got the override AND kept FbSeed's own y default.
    FbaNamed fban;
    total++; passed += Test("fixed-array field brace named splats every element",
                            fban.s[0].x * 1000 + fban.s[0].y * 100 + fban.s[1].x * 10 + fban.s[1].y,
                            5858);

    // OWNING element type: the values must survive, and the strings must not leak. Pre-fix
    // both slots read as the empty string.
    FbaStr fbast;
    total++; passed += Test("fixed-array field brace owning string element 0", fbast.s[0], "ab");
    total++; passed += Test("fixed-array field brace owning string element 1", fbast.s[1], "cd");

    // Owner axis: class, generic and user-no-arg-ctor are three separate default-ctor emitters.
    FbaClass fbacl;
    total++; passed += Test("fixed-array field brace class twin",
                            fbacl.a[0] * 100 + fbacl.a[1] * 10 + fbacl.a[2], 789);
    FbaBox<int> fbab;
    total++; passed += Test("fixed-array field brace inside generic",
                            fbab.a[0] * 100 + fbab.a[1] * 10 + fbab.a[2], 123);
    FbaCtor fbact;
    total++; passed += Test("fixed-array field brace user no-arg ctor",
                            fbact.a[0] * 100 + fbact.a[1] * 10 + fbact.a[2] + fbact.z, 129);

    // A NON-constant element must still be emitted (the value cannot be constant-folded into
    // the aggregate) and must run exactly once per construction.
    FbaSide fbasi;
    total++; passed += Test("fixed-array field brace non-constant element",
                            fbasi.a[0] * 100 + fbasi.a[1] * 10 + fbasi.a[2], 423);
    total++; passed += Test("fixed-array field brace non-constant element runs once", fbaBumped, 1);

    // Multi-dimensional fixed arrays use nested braces. The char-row spelling is the one
    // exception: each outer row may be initialized by one string literal.
    int[2][3] q13Nested = {{1, 2, 3}, {4, 5, 6}};
    total++; passed += Test("multi-dimensional nested brace shape",
                            q13Nested[0][0] + q13Nested[1][2], 7);
    char[2][8] q13Rows = {"ab", "cd"};
    total++; passed += Test("multi-dimensional char string rows",
                            (int)q13Rows[0][0] + (int)q13Rows[1][1], 'a' + 'd');

    // Accept set - identical on both binaries: an empty list on a primitive element is zero.
    FbaEmpty fbae;
    total++; passed += Test("fixed-array field brace empty list stays zero",
                            fbae.a[0] + fbae.a[1] + fbae.a[2], 0);

    // ----- Owning element under a named value-init list: one seed per SLOT, not one per array -----
    // The buffer-identity legs are the load-bearing ones: PRE the values were already correct and
    // only the shared pointer (then the rc 133 double free) gave the bug away.
    SviE[2] svil = { v = 5 };
    total++; passed += Test("owning value-init local override applied", svil[0].v + svil[1].v, 10);
    total++; passed += Test("owning value-init local value", svil[1].s, "hello");
    total++; passed += Test("owning value-init local buffers distinct",
                            (svil[0].s.data() != svil[1].s.data()) ? 1 : 0, 1);
    total++; passed += Test("owning value-init local constructs per slot", sviCtors, 2);

    SviHost svih;
    total++; passed += Test("owning value-init field override applied", svih.e[0].v + svih.e[1].v, 10);
    total++; passed += Test("owning value-init field value", svih.e[1].s, "hello");
    total++; passed += Test("owning value-init field buffers distinct",
                            (svih.e[0].s.data() != svih.e[1].s.data()) ? 1 : 0, 1);
    total++; passed += Test("owning value-init field constructs per slot", sviCtors, 4);

    // A `unique` pointer field is the second owning shape the same slot must not share.
    SviU[2] sviu = { v = 5 };
    total++; passed += Test("owning value-init unique field allocates per slot", sviNews, 2);
    total++; passed += Test("owning value-init unique pointers distinct",
                            (sviu[0].p != sviu[1].p) ? 1 : 0, 1);
    total++; passed += Test("owning value-init unique pointee intact", sviu[0].p.x + sviu[1].p.x, 18);

    // A destructor that owns nothing still routes to the per-slot arm, so the count has to be
    // exactly N - a leaked seed alloca would make it N+1, the old splat made it N with one
    // shared resource. Scoped so the destructors run before the leg reads the counter.
    {
        SviD[3] svid = { v = 5 };
        total++; passed += Test("owning value-init dtor element values",
                                svid[0].v + svid[1].v + svid[2].v, 15);
    }
    total++; passed += Test("owning value-init destructs exactly once per element", sviDtors, 3);

    // POD anchor: a constant override needs no per-slot evaluation to differ, so this leg holds
    // across the Q13 change and pins that per-element construction did not disturb the values.
    SviPod[3] svip = { b = 5 };
    total++; passed += Test("POD value-init splat unchanged",
                            svip[0].a + svip[0].b + svip[2].a + svip[2].b, 12);

    // RE-RATIFIED (Q13, 2026-08-12): element initialization runs ONCE PER ELEMENT for every
    // element type, POD or owning - the C++ rule for `S a[N]`. These legs previously pinned a
    // POD/owning SPLIT (POD once per array, owning once per slot); that split is retired and the
    // two arms now agree. C++ has no splat spelling to copy: its nearest form writes the
    // initializer per element, which evaluates per element.
    sviOv = 0;
    SviE[3] svio = { v = sviBump() };
    total++; passed += Test("owning value-init override expression runs per slot", sviOv, 3);
    total++; passed += Test("owning value-init override values differ per slot",
                            svio[0].v + svio[1].v + svio[2].v, 6);
    sviOv = 0;
    SviPod[3] svipo = { b = sviBump() };
    total++; passed += Test("POD value-init override expression runs per slot", sviOv, 3);
    total++; passed += Test("POD value-init override values differ per slot",
                            svipo[0].b + svipo[1].b + svipo[2].b, 6);

    // Q13 RULING 2026-08-12: element initialization runs ONCE PER ELEMENT for every spelling,
    // matching C++ `S a[N]`. Pre-fix this family disagreed with itself: the bare and `= {}`
    // spellings ran a non-trivial default ONCE and splatted it, and `= default` ran it ZERO times
    // (one construction was folded to a constant and replicated, dropping the side effect
    // entirely). The COUNT is the discriminator - every value leg passed pre-fix too.
    sviOv = 0; SviCount[3] scBare;           total++; passed += Test("per-element bare", sviOv, 3);
    sviOv = 0; SviCount[3] scEmpty = {};     total++; passed += Test("per-element = {}", sviOv, 3);
    sviOv = 0; SviCount[3] scDef = default;  total++; passed += Test("per-element = default", sviOv, 3);
    sviOv = 0; SviCount[2][3] scMulti = {};  total++; passed += Test("per-element multidim", sviOv, 6);
    // The scalar and heap spellings already ran per element and must not move.
    sviOv = 0; SviCount scOne = default;     total++; passed += Test("per-element scalar", sviOv, 1);
    sviOv = 0; SviCount* scHeap = new SviCount[3];
    total++; passed += Test("per-element new T[n]", sviOv, 3);
    total++; passed += Test("per-element values built", scBare[2].k + scHeap[2].k > 0, 1);

    // Reading an owning STRUCT element out of a raw `new T[n]` heap array used to materialize an
    // independently-destructible copy, so the pointee was freed twice (measured rc 134). A
    // one-index GEP on that provenance now takes the owning-assign decision like any other
    // indirect owning lvalue: a non-copyable owner MOVES, so exactly one destruction runs.
    rawHeapDtors = 0;
    {
        RawHeapBox rhb = rawHeapMk(7);
        RawHeapBox* rhh = new RawHeapBox[2];
        rhh[0] = rhb;
        RawHeapBox rhq = rhh[0];
        total++; passed += Test("raw-heap owning element read value", rhq.p == nullptr ? -1 : rhq.p.v, 7);
    }
    total++; passed += Test("raw-heap owning element read destructs once", rawHeapDtors, 1);

    // A named override replaces an already default-constructed unique field. Both the seed and
    // the replacement must be destroyed exactly once.
    braceOverrideDtors = 0;
    {
        BraceOverrideOwner owner = { p = new BraceOverrideNode() };
    }
    total++; passed += Test("brace override releases constructed owner", braceOverrideDtors, 2);

    // ----- Accept cells, frozen: correct before the fix and must not move -----
    // Value freeze only: a regression here emits no store at all, and the undef read still came
    // back zero under a polarity-flipped build. The discriminating evidence for this cell is the
    // pre/post IR being identical, recorded with the fix, not this leg.
    int[4] fadInt = default;
    total++; passed += Test("frozen: 'int[N] = default' stays all zero", fadInt[0] + fadInt[3], 0);
    FadNone[2] fadNo = default;
    total++; passed += Test("frozen: element with no field defaults stays zero",
                            fadNo[0].k + fadNo[1].j, 0);
    FadS*[2] fadP = default;
    total++; passed += Test("frozen: pointer element stays null", (i64)fadP[0], (i64)0);
    total++; passed += Test("frozen: fixed-array '= default' at global scope still zero",
                            fadGlobal[0].k + fadGlobal[1].k, 0);
    // A fixed-array FIELD with NO initializer is a separate residue from the brace-list one
    // fixed above (fixed-array-field-skips-element-default-construction); this leg pins that
    // neither the local-declarator fix nor the field-brace fix moved that cell.
    FadHost fadH = default;
    total++; passed += Test("fixed-array FIELD constructs element defaults",
                            fadH.a[0].k + fadH.a[1].k, 14);
    total++; passed += Test("frozen: fixed-array FIELD sibling scalar default", fadH.z, 3);

    // ----- BRACED fixed-array elements: all SIGSEGV'd the compiler pre-fix -----
    NbeP[2] nbeA = { {a=1,b=2}, {a=3,b=4} };
    total++; passed += Test("braced elements of a fixed array",
                            nbeA[0].a * 1000 + nbeA[0].b * 100 + nbeA[1].a * 10 + nbeA[1].b, 1234);
    NbeP[2] nbeB = { {a=1}, {b=2} };
    total++; passed += Test("braced element keeps the type's own field defaults",
                            nbeB[0].a * 1000 + nbeB[0].b * 100 + nbeB[1].a * 10 + nbeB[1].b, 1892);
    NbeP[2] nbeC = { {a=1,b=2} };
    total++; passed += Test("short braced list zero-fills the tail",
                            nbeC[1].a + nbeC[1].b, 0);
    NbeP[2] nbeD = { {}, {} };
    total++; passed += Test("empty braced elements construct defaults",
                            nbeD[0].a + nbeD[1].b, 17);
    NbeP[1] nbeE = { { a = 1 + 2, b = 4 } };
    total++; passed += Test("braced element takes expressions", nbeE[0].a * 10 + nbeE[0].b, 34);
    NbeP[2][2] nbeF = { { {a=1}, {a=2} }, { {a=3}, {a=4} } };
    total++; passed += Test("braced elements at the innermost dimension of 'T[N][M]'",
                            nbeF[0][0].a * 1000 + nbeF[0][1].a * 100 + nbeF[1][0].a * 10 + nbeF[1][1].a,
                            1234);
    NbeQ[1] nbeG = { { inner = { a = 1, b = 2 } } };
    total++; passed += Test("brace NESTED inside a braced element", nbeG[0].inner.a * 10 + nbeG[0].inner.b, 12);
    NbeHost nbeH = default;
    total++; passed += Test("braced elements of a fixed-array FIELD",
                            nbeH.items[0].a * 10 + nbeH.items[1].b, 14);
    NbeImpl nbeIm = default; nbeIm.v = 3;
    NbeW[1] nbeJ = { { item = nbeIm } };
    total++; passed += Test("interface field of a braced element reboxes", nbeJ[0].item.get(), 3);
    string nbeS = "abcdefghijklmnop" + "qrstuvwxyz";
    {
        NbeStr[2] nbeK = { { s = nbeS }, { s = nbeS } };
        total++; passed += Test("owning string field copies per braced element",
                                nbeK[0].s == nbeS && nbeK[1].s == nbeS, true);
    }
    total++; passed += Test("source string still readable after braced-element copies", nbeS, "abcdefghijklmnopqrstuvwxyz");
    nbeDtors = 0;
    {
        NbeH[2] nbeL = { { r = { v = 1 } }, { r = { v = 2 } } };
        total++; passed += Test("dtor-bearing braced elements carry their values",
                                nbeL[0].r.v * 10 + nbeL[1].r.v, 12);
    }
    total++; passed += Test("one destruction per braced element", nbeDtors, 2);
    string[2] methodValues = { "A", "B" };
    total++; passed += Test("fixed-array element method receiver", methodValues[0].length(), 1);
    char[4] methodChars = { 'a', 'b', 'c', 0 };
    total++; passed += Test("fixed-array char toString conversion", methodChars.toString().length(), 3);
    if (passed == total)
    {
        printf("ALL %d initializer-list tests passed.\n", total);
        return 0;
    }
    printf("%d of %d initializer-list tests FAILED.\n", total - passed, total);
    return 1;
}
