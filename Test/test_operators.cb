
// ── Vec2: 2D vector with full arithmetic ────────────────────────────────────

struct Vec2
{
    float x = 0;
    float y = 0;

    Vec2 operator+(Vec2 other) { Vec2 r; r.x = x + other.x; r.y = y + other.y; return r; }
    Vec2 operator-(Vec2 other) { Vec2 r; r.x = x - other.x; r.y = y - other.y; return r; }
    Vec2 operator*(float s)    { Vec2 r; r.x = x * s;       r.y = y * s;       return r; }
    Vec2 operator/(float s)    { Vec2 r; r.x = x / s;       r.y = y / s;       return r; }
    bool operator==(Vec2 other) { return x == other.x && y == other.y; }
    bool operator!=(Vec2 other) { return x != other.x || y != other.y; }
    Vec2 operator-()  { Vec2 r; r.x = -x;  r.y = -y;  return r; }
};

// ── BoolBox: logical NOT overload ────────────────────────────────────────────

struct BoolBox
{
    bool value = false;
    bool operator!() { return !value; }
};

// ── Bits: bitwise NOT overload ───────────────────────────────────────────────

struct Bits
{
    int value = 0;
    int operator~() { return ~value; }
};

// ── UBits: overloads whose RETURN type is unsigned (u64) ─────────────────────
// The expression result must carry the overload's return signedness, not the
// operands' flags: 0x8000000000000000 divides/compares unsigned, never sdiv/sgt.

struct UBits
{
    u64 v = 0;
    u64 operator+(u64 rhs)  { return v + rhs; }
    u64 operator*(u64 rhs)  { return v * rhs; }
    u64 operator>>(int rhs) { return v >> rhs; }
};

// ── Cells: subscript overload, reached through a pointer deref ──────────────

struct Cells
{
    int base = 0;
    int operator[](int i) { return base + i; }
};

// ── Fraction: rational number with arithmetic ────────────────────────────────

struct Fraction
{
    int num = 0;
    int den = 1;

    Fraction operator+(Fraction other)
    {
        Fraction r;
        r.num = num * other.den + other.num * den;
        r.den = den * other.den;
        return r;
    }

    Fraction operator-(Fraction other)
    {
        Fraction r;
        r.num = num * other.den - other.num * den;
        r.den = den * other.den;
        return r;
    }

    Fraction operator*(Fraction other)
    {
        Fraction r;
        r.num = num * other.num;
        r.den = den * other.den;
        return r;
    }

    bool operator==(Fraction other) { return num * other.den == other.num * den; }
    bool operator!=(Fraction other) { return num * other.den != other.num * den; }
    bool operator<(Fraction other)  { return num * other.den <  other.num * den; }
    bool operator>(Fraction other)  { return num * other.den >  other.num * den; }
};

// ── Counter: integer wrapper demonstrating overloaded +/== ──────────────────

struct Counter
{
    int value = 0;

    Counter operator+(Counter other) { Counter r; r.value = value + other.value; return r; }
    Counter operator-(Counter other) { Counter r; r.value = value - other.value; return r; }
    Counter operator*(int scale)     { Counter r; r.value = value * scale;       return r; }
    bool operator==(Counter other)   { return value == other.value; }
    bool operator<(Counter other)    { return value < other.value; }
};

// ── operator->: forwarding / drill-down member access ────────────────────────

struct Inner
{
    int value = 0;
    int triple() { return value * 3; }
    int who() { return 1; }   // shadowed by Box::who - never reached through a Box
};

// Box forwards member access to the contained Inner* via operator->.
// It also has its OWN members (tag, who) to prove own-member-first resolution:
// `.`/`->` reach these directly and they shadow Inner's same-named members.
struct Box
{
    Inner* p = nullptr;
    int tag = 0;
    Inner* operator->() { return p; }
    int who() { return 2; }   // own member - shadows Inner::who
};

// Plain has no operator->; flexible `.`/`->` both reach its own members directly.
struct Plain { int value = 0; };

// OuterBox holds a Box (a value type that itself defines operator->); `ob->member`
// must chain operator-> until a raw pointer is reached (Box -> Inner*).
struct OuterBox
{
    Box inner;
    Box operator->() { return inner; }
};

// ── PtrNode/PtrKey: free operator with a RAW-POINTER left operand ────────────
// `node == key` must select operator==(PtrNode*, PtrKey). `node == nullptr` must
// stay the builtin address check and never route into overload resolution.

struct PtrKey { int v = 0; };
struct PtrNode { int v = 0; };

bool operator==(PtrNode* a, PtrKey b) { return a->v == b.v; }
bool operator!=(PtrNode* a, PtrKey b) { return a->v != b.v; }

// ── Helpers ──────────────────────────────────────────────────────────────────

import "test_helper.cb";
import "list.cb";

// Unsigned-literal regression support: field defaults, a global, and an indirect callee.
struct UDefaults { u64 wide = 4294967295u; double asDouble = 4294967295u; };
UDefaults g_unsignedDefaults = default;
u64[2] g_unsignedArray = {4294967295u, 1u};
u64 WidenUnsigned(u64 value) { return value; }

// Records that it ran, so a ternary arm that must NOT execute can be detected.
int g_sideEffects = 0;
int bumpSideEffect(int amount) { g_sideEffects = g_sideEffects + amount; return amount; }

// Primitive postfix results must become the receiver of the next link. These
// value legs distinguish the result from the original aggregate receiver.
struct ChainBox
{
    int value = 7;
    int get() { return value; }
    int doubleValue() { return value * 2; }
};

int doubleValue(int x) { return x * 100; }
int chainAddOne(int x) { return x + 1; }

struct PrimitiveResults
{
    double getDouble() { return 2.5; }
    bool getBool() { return true; }
    char getChar() { return 'A'; }
};

int softImportIdentifiers(int from, int lib, int cache, int define, int pri,
                          int framework, int package)
{
    int program = from + lib + cache + define + pri + framework + package;
    return program;
}

double addOneDouble(double x) { return x + 1.0; }
bool flipBool(bool x) { return !x; }
string charLabel(char x) { return "char"; }

// ── Main ─────────────────────────────────────────────────────────────────────

extern int main()
{
    // Vec2 tests
    Vec2 a; a.x = 1.0f; a.y = 2.0f;
    Vec2 b; b.x = 3.0f; b.y = 4.0f;

    Vec2 sum = a + b;
    Test("Vec2 + x", sum.x, 4.0f);
    Test("Vec2 + y", sum.y, 6.0f);

    Vec2 diff = b - a;
    Test("Vec2 - x", diff.x, 2.0f);
    Test("Vec2 - y", diff.y, 2.0f);

    Vec2 scaled = a * 3.0f;
    Test("Vec2 * x", scaled.x, 3.0f);
    Test("Vec2 * y", scaled.y, 6.0f);

    Vec2 divided = b / 2.0f;
    Test("Vec2 / x", divided.x, 1.5f);
    Test("Vec2 / y", divided.y, 2.0f);

    Vec2 c; c.x = 1.0f; c.y = 2.0f;
    Test("Vec2 == (equal)",     a == c,  true);
    Test("Vec2 == (not equal)", a == b,  false);
    Test("Vec2 != (not equal)", a != b,  true);
    Test("Vec2 != (equal)",     a != c,  false);

    // Fraction tests:  1/2 + 1/3 = 5/6,  1/2 * 2/3 = 2/6 = 1/3
    Fraction half;  half.num  = 1; half.den  = 2;
    Fraction third; third.num = 1; third.den = 3;
    Fraction twothirds; twothirds.num = 2; twothirds.den = 3;

    Fraction fsum = half + third;          // 5/6
    Test("Frac + num", fsum.num, 5);
    Test("Frac + den", fsum.den, 6);

    Fraction fdiff = half - third;         // 1/6
    Test("Frac - num", fdiff.num, 1);
    Test("Frac - den", fdiff.den, 6);

    Fraction fprod = half * twothirds;     // 2/6
    Fraction oneThird; oneThird.num = 1; oneThird.den = 3;
    Test("Frac * ==",  fprod == oneThird, true);

    Test("Frac ==",    half == half,   true);
    Test("Frac !=",    half != third,  true);
    Test("Frac < ",    third < half,   true);
    Test("Frac > ",    half > third,   true);

    // Counter tests
    Counter p; p.value = 10;
    Counter q; q.value = 5;

    Counter csum  = p + q;
    Counter cdiff = p - q;
    Counter cmul  = q * 4;

    Test("Counter + value",  csum.value,  15);
    Test("Counter - value",  cdiff.value,  5);
    Test("Counter * value",  cmul.value,  20);
    Test("Counter == (eq)",  p == p,  true);
    Test("Counter == (ne)",  p == q,  false);
    Test("Counter <  ",      q < p,   true);

    // Chained: (a + b) + c  ==  a + (1,2) + (3,4)+(1,2) = (5,8)+(1,2) but let's just check addition chaining
    Vec2 chain = a + b + c;    // (1+3+1, 2+4+2) = (5, 8)
    Test("Vec2 chain + x", chain.x, 5.0f);
    Test("Vec2 chain + y", chain.y, 8.0f);

    // ── Unary operator overloads ──────────────────────────────────────────────

    // operator-(): unary negation on Vec2
    Vec2 neg = -a;             // -(1,2) = (-1,-2)
    Test("Vec2 unary- x", neg.x, -1.0f);
    Test("Vec2 unary- y", neg.y, -2.0f);

    // Ensure binary operator- still works alongside unary
    Vec2 bsub = b - a;         // (3,4)-(1,2) = (2,2)
    Test("Vec2 binary- after unary- x", bsub.x, 2.0f);
    Test("Vec2 binary- after unary- y", bsub.y, 2.0f);

    // operator!(): logical NOT on BoolBox
    BoolBox bt; bt.value = true;
    BoolBox bf; bf.value = false;
    Test("BoolBox !true",  !bt, false);
    Test("BoolBox !false", !bf, true);

    // operator~(): bitwise NOT on Bits
    Bits bits; bits.value = 0xFF;
    int flipped = ~bits;
    Test("Bits ~ 0xFF", flipped, ~0xFF);

    Bits zero; zero.value = 0;
    Test("Bits ~ 0", ~zero, ~0);

    // ── operator-> forwarding ──────────────────────────────────────────────────

    // Wrapper over a plain struct pointer: w->field reads and w->method() calls
    // forward to the contained Inner.
    Inner item; item.value = 7;
    Box w; w.p = &item;
    Test("Box-> field read",   w->value,    7);
    Test("Box-> method call",  w->triple(), 21);

    // Mutate through the forwarded pointer, then read back.
    w->value = 9;
    Test("Box-> field write",  item.value,  9);
    Test("Box-> method after write", w->triple(), 27);

    // Chaining: OuterBox::operator-> returns a Box, which itself defines
    // operator-> - the chain must continue until the raw Inner* is reached.
    OuterBox ob; ob.inner = w;
    Test("OuterBox-> chained field",  ob->value,    9);
    Test("OuterBox-> chained method", ob->triple(), 27);

    // ── Flexible model: own-member-first, forward only on a miss ──────────────

    // (a) `.` (not just `->`) forwards when the member is NOT on the wrapper.
    Test("Box. forwards field (miss)",  w.value,    9);
    Test("Box. forwards method (miss)", w.triple(), 27);

    // (b) `->` resolves an OWN member of the wrapper directly (no forwarding).
    w.tag = 5;
    Test("Box-> own field",  w->tag,   5);
    Test("Box-> own method", w->who(), 2);

    // (c) Shadowing: `who` exists on BOTH Box and Inner; access resolves to the
    // wrapper's Box::who (2), never the forwarded Inner::who (1) - via both tokens.
    Test("Box. own shadows forwarded", w.who(),  2);
    Test("Box-> own shadows forwarded", w->who(), 2);

    // Flexible `->` on a plain value (no operator->) reaches its own member,
    // exactly like `.` would - `->` on a value is not an error.
    Plain pl; pl.value = 42;
    Test("Plain-> own field",  pl->value, 42);
    Test("Plain. own field",   pl.value,  42);

    // ── ?. (null-conditional) composes with operator-> forwarding ──────────────
    // The `?` is recognized first, then operator-> forwards on a miss and the
    // null guard applies to the forwarded pointer (w.p is &item, non-null here).
    Test("Box?. forwards field (non-null)",  w?.value,    9);
    Test("Box?. forwards method (non-null)", w?.triple(), 27);

    // When the wrapped pointer is null, the forwarded `?.` short-circuits to the
    // default instead of dereferencing.
    Box wn; wn.p = nullptr;
    Test("Box?. null field short-circuits", wn?.value,       0);
    Test("Box?. null with coalesce",        wn?.value ?? -1, -1);

    // ── operator[] through a parenthesized deref ──────────────────────────────
    // `(*p)` is a struct receiver like any other, so `(*p)[i]` must find operator[].
    // Regression: the parenthesized primary published its type and storage but never
    // its BaseType, so no struct receiver was established - the subscript fell through
    // to the raw-index path and crashed the COMPILER on a null type (exit 139, no
    // diagnostic). An unknown base type is now a LogError instead.
    Cells cs; cs.base = 100;
    Cells* cp = &cs;
    Test("Cells value subscript",     cs[3],    103);
    Test("Cells deref subscript",     (*cp)[3], 103);
    Test("Cells deref subscript [0]", (*cp)[0], 100);

    // The same shape stays an LVALUE: a write through it must reach the pointee,
    // not a materialized copy of it.
    (*cp).base = 200;
    Test("Cells deref field write",   cs.base,  200);
    Test("Cells deref subscript after write", (*cp)[1], 201);

    // Logical '!' is a zero-compare yielding bool, NOT the bitwise '~'. Regression:
    // '!' used to lower to xor -1, so on any type wider than i1 every operand negated
    // to a nonzero (truthy) value - '!1' and '!0' were both true, and '!ptr' was
    // invalid IR that faulted at runtime.
    int notOne  = 1;
    int notZero = 0;
    Test("!int 1",         !notOne,   false);
    Test("!int 0",         !notZero,  true);
    Test("!!int 1",        !!notOne,  true);
    Test("!int truthy 42", !42,    false);

    bool notBt = true;
    Test("!bool true",  !notBt, false);
    Test("!bool false", !!notBt, true);

    float notFz = 0.0f;
    float notFnz = 2.5f;
    Test("!float 0",   !notFz,  true);
    Test("!float 2.5", !notFnz, false);

    int notTarget = 7;
    int* notPv = &notTarget;
    int* notPn = nullptr;
    Test("!ptr null",    !notPn, true);
    Test("!ptr non-null", !notPv, false);

    // '~' stays bitwise - the two operators must not collapse onto each other.
    Test("~int 0", ~notZero, -1);
    Test("~int 1", ~notOne,  -2);

    // Compile-time macros are i32, so `if const (!MACRO)` exercised the same bug:
    // the not-taken arm was compiled anyway. __WINDOWS__ and __MACOS__ are disjoint,
    // so exactly one of these two arms may run.
    int constArm = 0;
    if const (!__WINDOWS__) { constArm = constArm + 1; }
    if const (!__MACOS__)   { constArm = constArm + 10; }
    Test("if const (!macro) picks one arm", constArm == 1 || constArm == 10, true);

    // Ternary condition coercion. A non-bool '?:' condition used to be handed to LLVM's
    // 'select' raw (which demands i1), so `int cond ? a : b` failed module verification.
    int terPassed = 0;
    int    terI  = 3;
    int    terI0 = 0;
    char   terC  = 'x';
    char   terC0 = 0;
    u64    terU  = 7;
    u64    terU0 = 0;
    double terD  = 1.5;
    double terD0 = 0.0;
    float  terF  = 2.5f;
    int    terTarget = 9;
    int*   terP  = &terTarget;
    int*   terPn = nullptr;
    bool   terB  = true;

    terPassed += Test("ternary int cond nonzero",   terI  ? 1 : 0, 1);
    terPassed += Test("ternary int cond zero",      terI0 ? 1 : 0, 0);
    terPassed += Test("ternary char cond nonzero",  terC  ? 1 : 0, 1);
    terPassed += Test("ternary char cond zero",     terC0 ? 1 : 0, 0);
    terPassed += Test("ternary u64 cond nonzero",   terU  ? 1 : 0, 1);
    terPassed += Test("ternary u64 cond zero",      terU0 ? 1 : 0, 0);
    terPassed += Test("ternary double cond nonzero", terD ? 1 : 0, 1);
    terPassed += Test("ternary double cond zero",   terD0 ? 1 : 0, 0);
    terPassed += Test("ternary float cond nonzero", terF  ? 1 : 0, 1);
    terPassed += Test("ternary ptr cond non-null",  terP  ? 1 : 0, 1);
    terPassed += Test("ternary ptr cond null",      terPn ? 1 : 0, 0);
    terPassed += Test("ternary bool cond",          terB  ? 1 : 0, 1);
    // Non-bool condition in a branch of if/while must keep working too.
    if (terD) { terPassed += Test("if double cond nonzero", 1, 1); }

    // Only the SELECTED arm runs. The ternary used to compute both arms eagerly and combine
    // them with a select, so a side effect in the not-taken arm still happened.
    g_sideEffects = 0;
    int scT = true  ? bumpSideEffect(1) : bumpSideEffect(100);
    terPassed += Test("ternary picks true arm",      scT, 1);
    terPassed += Test("ternary skips false arm",     g_sideEffects, 1);
    g_sideEffects = 0;
    int scF = false ? bumpSideEffect(1) : bumpSideEffect(100);
    terPassed += Test("ternary picks false arm",     scF, 100);
    terPassed += Test("ternary skips true arm",      g_sideEffects, 100);
    // Nested ternary: exactly one leaf arm runs.
    g_sideEffects = 0;
    int scN = terI0 ? bumpSideEffect(1) : (terI ? bumpSideEffect(10) : bumpSideEffect(1000));
    terPassed += Test("nested ternary picks one leaf", scN, 10);
    terPassed += Test("nested ternary skips others",   g_sideEffects, 10);

    // Raw-pointer left operand selects the free operator==(PtrNode*, PtrKey). The pointer
    // is passed straight through as `this` - it is never copied into a temporary alloca.
    int ptrOpPassed = 0;
    PtrNode* pnode = new PtrNode();
    pnode->v = 42;
    PtrKey pkey = default;
    pkey.v = 42;
    ptrOpPassed += Test("ptr lhs operator== match",     pnode == pkey, true);
    ptrOpPassed += Test("ptr lhs operator!= match",     pnode != pkey, false);
    pkey.v = 7;
    ptrOpPassed += Test("ptr lhs operator== mismatch",  pnode == pkey, false);
    ptrOpPassed += Test("ptr lhs operator!= mismatch",  pnode != pkey, true);

    // ANTI-REGRESSION: ptr-vs-ptr must NEVER enter overload dispatch. `p == nullptr` is
    // the builtin address check, so it is false while allocated and true once nulled.
    ptrOpPassed += Test("ptr == nullptr builtin, allocated", pnode == nullptr, false);
    ptrOpPassed += Test("ptr != nullptr builtin, allocated", pnode != nullptr, true);
    delete pnode;
    pnode = nullptr;
    ptrOpPassed += Test("ptr == nullptr builtin, nulled",    pnode == nullptr, true);
    ptrOpPassed += Test("ptr != nullptr builtin, nulled",    pnode != nullptr, false);

    // Overload results above 2^63 stay unsigned through /, >, and chained arithmetic.
    int uPassed = 0;
    UBits ub = default;
    ub.v = (u64)0x8000000000000000;
    uPassed += Test("u64 operator>> result divides unsigned", (ub >> 0) / 2 == (u64)4611686018427387904, true);
    // RHS literals stay SIGNED so the operands' flags cannot mask a dropped return signedness.
    uPassed += Test("u64 operator+ result divides unsigned",  (ub + 0) / 2 == (u64)4611686018427387904, true);
    uPassed += Test("u64 operator* result compares unsigned", (ub * 1) > 1000, true);

    // Unsigned literals keep their zero-extension and unsigned integer-to-double conversion.
    int unsignedLiteralPassed = 0;
    u64 literalMaskValue = 4294967296u;
    unsignedLiteralPassed += Test("u32 literal widens without sign extension",
        (literalMaskValue & 4294967295u) == 0, true);
    unsignedLiteralPassed += Test("u64 max unsigned-to-double",
        (double)18446744073709551615u > 1.8e19, true);

    // Aggregate initializers must carry the source's unsignedness into the widening store.
    u64[1] braceArray = {4294967295u};
    unsignedLiteralPassed += Test("fixed-array brace element zero-extends",
        braceArray[0] == (u64)4294967295, true);
    UDefaults defaulted = default;
    unsignedLiteralPassed += Test("struct field default zero-extends",
        defaulted.wide == (u64)4294967295, true);
    UDefaults named = {wide = 4294967295u};
    unsignedLiteralPassed += Test("named brace field zero-extends",
        named.wide == (u64)4294967295, true);
    unsignedLiteralPassed += Test("global field default zero-extends",
        g_unsignedDefaults.wide == (u64)4294967295, true);

    // Indirect calls widen arguments with the argument's own signedness.
    function<u64(u64)> widenFn = WidenUnsigned;
    unsignedLiteralPassed += Test("function-pointer argument zero-extends",
        widenFn(4294967295u) == (u64)4294967295, true);

    // Unary minus on an unsigned literal wraps modulo the literal's own width (C semantics),
    // so it must NOT be folded down into a narrower signed type.
    u64 negatedUnsigned = -5u;
    unsignedLiteralPassed += Test("unary minus on u32 literal wraps modulo 2^32",
        negatedUnsigned == (u64)4294967291, true);

    // ACCEPT-SET (these already hold before the unsigned-literal fix; they are anti-regression
    // guards that the new unsignedness plumbing must not flip).
    int unsignedAcceptPassed = 0;
    u32 variableValue = 4294967295u;
    u64 variableWidened = variableValue;
    unsignedAcceptPassed += Test("u32 variable widening remains unsigned",
        variableWidened == (u64)4294967295, true);
    i32 negativeShifted = -8;
    unsignedAcceptPassed += Test("signed >> unsigned stays an arithmetic shift",
        (negativeShifted >> 1u) == -4, true);
    i64 negativeWide = -1;
    unsignedAcceptPassed += Test("wider signed vs narrower unsigned compares signed",
        negativeWide < 1u, true);
    unsignedAcceptPassed += Test("global array brace element already zero-extended",
        g_unsignedArray[0] == (u64)4294967295, true);
    unsignedAcceptPassed += Test("u32 vs signed zero compares unsigned",
        variableValue > 0, true);
    unsignedAcceptPassed += Test("unsigned field default to double stays positive",
        defaulted.asDouble > 4.0e9, true);
    u8[400] indexedBytes = default;
    indexedBytes[300u] = 7;
    unsignedAcceptPassed += Test("array index above 255u addresses the right slot",
        (int)indexedBytes[300u], 7);


    int chainPassed = 0;
    ChainBox cb;
    ChainBox* cbp = &cb;
    list<int> chainItems;
    chainItems.add(1); chainItems.add(2);
    list<int> xs;
    xs.add(7);
    string chainCount = chainItems.count().toString();
    PrimitiveResults pr;
    chainPassed += Test("primitive method result uses free receiver", cb.get().doubleValue(), 700);
    chainPassed += Test("primitive pointer result uses free receiver", cbp->get().doubleValue(), 700);
    chainPassed += Test("primitive result toString", chainItems.count().toString(), "2");
    chainPassed += Test("list int get primitive toString", xs.get(0).toString(), "7");
    chainPassed += Test("list int index primitive toString", xs[0].toString(), "7");
    chainPassed += Test("primitive result length toString", chainCount.length().toString(), "1");
    chainPassed += Test("primitive result as argument", chainAddOne(cb.get().doubleValue()), 701);
    chainPassed += Test("three primitive links", cb.get().doubleValue().doubleValue(), 70000);
    chainPassed += Test("double result receiver", pr.getDouble().addOneDouble() == 3.5, true);
    chainPassed += Test("bool result receiver", pr.getBool().flipBool().toString(), "false");
    chainPassed += Test("char result receiver", pr.getChar().charLabel(), "char");

    int softPassed = 0;
    softPassed += Test("soft import words remain identifiers",
                       softImportIdentifiers(1, 2, 4, 8, 16, 32, 64), 127);


    int promoPassed = promotionAndLiteralLegs();

    return (terPassed == 19 && ptrOpPassed == 8 && uPassed == 3
        && unsignedLiteralPassed == 8 && unsignedAcceptPassed == 7
        && chainPassed == 11 && softPassed == 1 && promoPassed == 11) ? 0 : 1;
}

// C integer promotion for equal-width sub-int operands, plus the two literal-unsignedness
// sites (ternary arm, default parameter) that used to sign-extend a u-suffixed literal.
i64 unsignedDefaultParam(i64 v = 4294967295u) { return v; }

int promotionAndLiteralLegs()
{
    int passed = 0;
    i8 nc = -1;
    u8 uc = 3;
    passed += Test("i8 vs u8 compare promotes to signed int", nc < uc, true);
    passed += Test("i8 divided by u8 promotes to signed int", (int)(nc / uc), 0);
    i16 ns = -1;
    u16 us = 3;
    passed += Test("i16 vs u16 compare promotes to signed int", ns < us, true);
    passed += Test("i16 divided by u16 promotes to signed int", (int)(ns / us), 0);

    // ACCEPT-SET: promotion must not change the width of a narrow result, the signed
    // pure-signed case, the logical shift of an unsigned operand, or the 32-bit rule.
    u8 bigByte = 200;
    u8 halfByte = 100;
    passed += Test("u8 addition still wraps in 8 bits", (int)(bigByte + halfByte), 44);
    passed += Test("u8 multiply still wraps in 8 bits", (int)(bigByte * 2), 144);
    i8 negByte = -8;
    i8 twoByte = 2;
    passed += Test("i8 divided by i8 stays signed", (int)(negByte / twoByte), -4);
    passed += Test("u8 shifted right stays logical", (int)(bigByte >> 1), 100);
    i32 negWord = -1;
    u32 uWord = 3;
    passed += Test("i32 vs u32 still compares unsigned", negWord < uWord, false);

    i64 ternaryWide = true ? 4294967295u : 1;
    passed += Test("ternary arm keeps literal unsignedness", ternaryWide == (i64)4294967295, true);
    passed += Test("default parameter keeps literal unsignedness",
        unsignedDefaultParam() == (i64)4294967295, true);
    return passed;
}
