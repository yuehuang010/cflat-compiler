// cflat-twin-args: -O2

// ── Vec2: 2D vector with full arithmetic ────────────────────────────────────

struct Vec2
{
    float x = 0;
    float y = 0;

    Vec2 operator+(Vec2 other) { Vec2 r; r.x = x + other.x; r.y = y + other.y; return r; }
    Vec2 operator-(Vec2 other) { Vec2 r; r.x = x - other.x; r.y = y - other.y; return r; }
    Vec2 operator*(float s)    { Vec2 r; r.x = x * s;       r.y = y * s;       return r; }
    Vec2 operator/(float s)    { Vec2 r; r.x = x / s;       r.y = y / s;       return r; }
    bool operator==(Vec2 other) { return x == other.x && y == other.y; }
    bool operator!=(Vec2 other) { return x != other.x || y != other.y; }
    Vec2 operator-()  { Vec2 r; r.x = -x;  r.y = -y;  return r; }
};

int unaryMutDtorCount = 0;
struct UnaryMut
{
    int value = 0;
    int operator-() { value++; return value; }
    ~UnaryMut() { unaryMutDtorCount++; }
};
UnaryMut makeUnaryMut(int value) { UnaryMut result = default; result.value = value; return result; }

// ── BoolBox: logical NOT overload ────────────────────────────────────────────

struct BoolBox
{
    bool value = false;
    bool operator!() { return !value; }
};

// Callable uses the CFlat call-operator spelling. Overloads are selected by arity and type,
// and direct calls through a pointer or type alias keep the same member dispatch.
struct Callable
{
    int operator()() { return 40; }
    int operator()(int value) { return value + 10; }
    int operator()(float value) { return (int)value + 100; }
};

using CallableAlias = Callable;

struct CallableHolder
{
    Callable value = default;
};

int callFieldTarget(int value) { return value + 20; }
struct CallableField { function<int(int)> fn = callFieldTarget; };

struct TruthinessBox
{
    int value = 0;
};

bool operator bool(TruthinessBox b) { return b.value != 0; }

struct Celsius
{
    int degrees = 0;
};

struct Fahrenheit
{
    int degrees = 0;
};

int operator int(Celsius value) { return value.degrees; }
int operator int(int value) { return value + 1000; }
Fahrenheit operator Fahrenheit(Celsius value)
{
    Fahrenheit result = default;
    result.degrees = value.degrees + 32;
    return result;
}
int operator int(Fahrenheit value) { return value.degrees + 1000; }

using CelsiusAlias = Celsius;

struct GenericTruthinessBox<T>
{
    T value = default;
    bool operator bool(GenericTruthinessBox<T> b) { return b.value != 0; }
};

// ── Bits: bitwise NOT overload ───────────────────────────────────────────────

struct Bits
{
    int value = 0;
    int operator~() { return ~value; }
};

// ── UBits: overloads whose RETURN type is unsigned (u64) ─────────────────────
// The expression result must carry the overload's return signedness, not the
// operands' flags: 0x8000000000000000 divides/compares unsigned, never sdiv/sgt.

struct UBits
{
    u64 v = 0;
    u64 operator+(u64 rhs)  { return v + rhs; }
    u64 operator*(u64 rhs)  { return v * rhs; }
    u64 operator>>(int rhs) { return v >> rhs; }
};

// ── Cells: subscript overload, reached through a pointer deref ──────────────

struct Cells
{
    int base = 0;
    int operator[](int i) { return base + i; }
};

// ── Fraction: rational number with arithmetic ────────────────────────────────

struct Fraction
{
    int num = 0;
    int den = 1;

    Fraction operator+(Fraction other)
    {
        Fraction r;
        r.num = num * other.den + other.num * den;
        r.den = den * other.den;
        return r;
    }

    Fraction operator-(Fraction other)
    {
        Fraction r;
        r.num = num * other.den - other.num * den;
        r.den = den * other.den;
        return r;
    }

    Fraction operator*(Fraction other)
    {
        Fraction r;
        r.num = num * other.num;
        r.den = den * other.den;
        return r;
    }

    bool operator==(Fraction other) { return num * other.den == other.num * den; }
    bool operator!=(Fraction other) { return num * other.den != other.num * den; }
    bool operator<(Fraction other)  { return num * other.den <  other.num * den; }
    bool operator>(Fraction other)  { return num * other.den >  other.num * den; }
};

// ── Counter: integer wrapper demonstrating overloaded +/== ──────────────────

struct Counter
{
    int value = 0;

    Counter operator+(Counter other) { Counter r; r.value = value + other.value; return r; }
    Counter operator-(Counter other) { Counter r; r.value = value - other.value; return r; }
    Counter operator*(int scale)     { Counter r; r.value = value * scale;       return r; }
    bool operator==(Counter other)   { return value == other.value; }
    bool operator<(Counter other)    { return value < other.value; }
};

struct CompoundBox
{
    int value = 0;
    CompoundBox operator+(CompoundBox other)  { CompoundBox r; r.value = value + other.value; return r; }
    CompoundBox operator-(CompoundBox other)  { CompoundBox r; r.value = value - other.value; return r; }
    CompoundBox operator*(CompoundBox other)  { CompoundBox r; r.value = value * other.value; return r; }
    CompoundBox operator/(CompoundBox other)  { CompoundBox r; r.value = value / other.value; return r; }
    CompoundBox operator%(CompoundBox other)  { CompoundBox r; r.value = value % other.value; return r; }
    CompoundBox operator<<(CompoundBox other) { CompoundBox r; r.value = value << other.value; return r; }
    CompoundBox operator>>(CompoundBox other) { CompoundBox r; r.value = value >> other.value; return r; }
};

struct NoCompoundBox { int value = 0; };

// Bitwise overloads: '&' '|' '^' are declarable, and '&=' '|=' '^=' fall back to them.
struct BitBox
{
    int value = 0;
    BitBox operator&(BitBox other) { BitBox r; r.value = value & other.value; return r; }
    BitBox operator|(BitBox other) { BitBox r; r.value = value | other.value; return r; }
    BitBox operator^(BitBox other) { BitBox r; r.value = value ^ other.value; return r; }
};

// Only a compound overload is declared - the binary form must not be required.
struct OnlyCompoundBox
{
    int value = 0;
    OnlyCompoundBox operator+=(OnlyCompoundBox other)
    { OnlyCompoundBox r; r.value = value + other.value + 100; return r; }
};

// Both declared: the compound overload wins over the binary one.
struct BothCompoundBox
{
    int value = 0;
    BothCompoundBox operator+(BothCompoundBox other)
    { BothCompoundBox r; r.value = value + other.value; return r; }
    BothCompoundBox operator+=(BothCompoundBox other)
    { BothCompoundBox r; r.value = value + other.value + 1000; return r; }
};

struct CompoundHolder { CompoundBox f = default; };

// ── operator->: forwarding / drill-down member access ────────────────────────

struct Inner
{
    int value = 0;
    int triple() { return value * 3; }
    int who() { return 1; }   // shadowed by Box::who - never reached through a Box
};

// Box forwards member access to the contained Inner* via operator->.
// It also has its OWN members (tag, who) to prove own-member-first resolution:
// `.`/`->` reach these directly and they shadow Inner's same-named members.
struct Box
{
    Inner* p = nullptr;
    int tag = 0;
    Inner* operator->() { return p; }
    int who() { return 2; }   // own member - shadows Inner::who
};

// Plain has no operator->; flexible `.`/`->` both reach its own members directly.
struct Plain { int value = 0; };

// OuterBox holds a Box (a value type that itself defines operator->); `ob->member`
// must chain operator-> until a raw pointer is reached (Box -> Inner*).
struct OuterBox
{
    Box inner;
    Box operator->() { return inner; }
};

// A pointer-like value exercising postfix operators, unary dereference, and forwarding.
struct ForwardThing
{
    int field = 0;
    int count = 0;
    int tag = 0;
    int method() { return field * 2; }
};

struct ForwardPtr
{
    ForwardThing* raw = nullptr;
    int tag = 0;
    void operator++() { raw = raw + 1; }
    void operator--() { raw = raw - 1; }
    ForwardThing* operator->() { return raw; }
    ForwardThing* operator*() { return raw; }
};

struct GenericForwardBox<T>
{
    T* raw = nullptr;
    T* operator->() { return raw; }
    T* operator*() { return raw; }
};

struct ValueDerefBox
{
    ForwardThing value = default;
    ForwardThing operator*() { return value; }
};

struct AliasDerefBox
{
    ForwardThing* raw = nullptr;
    alias ForwardThing operator*() { return *raw; }
};

// ── PtrNode/PtrKey: free operator with a RAW-POINTER left operand ────────────
// `node == key` must select operator==(PtrNode*, PtrKey). `node == nullptr` must
// stay the builtin address check and never route into overload resolution.

struct PtrKey { int v = 0; };
struct PtrNode { int v = 0; };

bool operator==(PtrNode* a, PtrKey b) { return a->v == b.v; }
bool operator!=(PtrNode* a, PtrKey b) { return a->v != b.v; }

// ── Helpers ──────────────────────────────────────────────────────────────────

import "test_helper.cb";
import "list.cb";
import "string.cb";
import "tuple.cb";

int g_userAtollCalls = 0;
extern i64 atoll(const char* s) { g_userAtollCalls++; return 777; }
bool userLibcAtollWins()
{
    g_userAtollCalls = 0;
    string input = "42";
    i64 value = input.toLong();
    return value == 777 && g_userAtollCalls == 1;
}

// Unsigned-literal regression support: field defaults, a global, and an indirect callee.
struct UDefaults { u64 wide = 4294967295u; double asDouble = 4294967295u; };
UDefaults g_unsignedDefaults = default;
u64[2] g_unsignedArray = {4294967295u, 1u};
u64 WidenUnsigned(u64 value) { return value; }

// Records that it ran, so a ternary arm that must NOT execute can be detected.
int g_sideEffects = 0;
int bumpSideEffect(int amount) { g_sideEffects = g_sideEffects + amount; return amount; }

// Primitive postfix results must become the receiver of the next link. These
// value legs distinguish the result from the original aggregate receiver.
struct ChainBox
{
    int value = 7;
    int get() { return value; }
    int doubleValue() { return value * 2; }
};

int doubleValue(int x) { return x * 100; }
int chainAddOne(int x) { return x + 1; }

struct PrimitiveResults
{
    double getDouble() { return 2.5; }
    bool getBool() { return true; }
    char getChar() { return 'A'; }
};

int softImportIdentifiers(int from, int lib, int cache, int define, int pri,
                          int framework, int package)
{
    int program = from + lib + cache + define + pri + framework + package;
    return program;
}

double addOneDouble(double x) { return x + 1.0; }
bool flipBool(bool x) { return !x; }
string charLabel(char x) { return "char"; }

int i128FeatureLegs()
{
    int passed = 0;
    i128 signedValue = 170141183460469231731687303715884105727;
    u128 unsignedValue = 340282366920938463463374607431768211455;
    passed += Test("i128 declaration and assignment", signedValue == (i128)170141183460469231731687303715884105727, true);
    passed += Test("wide integer literal", signedValue > (i128)18446744073709551616, true);
    i128 nearSigned = (i128)18446744073709551616 + 5;
    passed += Test("i128 add", nearSigned + 3 == (i128)18446744073709551624, true);
    passed += Test("i128 sub", nearSigned - 3 == (i128)18446744073709551618, true);
    passed += Test("i128 mul", nearSigned * 3 == (i128)55340232221128654863, true);
    passed += Test("i128 div", nearSigned / 3 == (i128)6148914691236517207, true);
    passed += Test("i128 rem", nearSigned % 3 == (i128)0, true);
    u128 nearUnsigned = (u128)18446744073709551616 + 5;
    passed += Test("u128 add", nearUnsigned + 3 == (u128)18446744073709551624, true);
    passed += Test("u128 sub", nearUnsigned - 3 == (u128)18446744073709551618, true);
    passed += Test("u128 mul", nearUnsigned * 3 == (u128)55340232221128654863, true);
    passed += Test("u128 div", nearUnsigned / 3 == (u128)6148914691236517207, true);
    passed += Test("u128 rem", nearUnsigned % 3 == (u128)0, true);
    passed += Test("u128 max wraps", unsignedValue + (u128)1 == (u128)0, true);
    passed += Test("i128 shift by 64", ((i128)1 << 64) == (i128)18446744073709551616, true);
    passed += Test("u128 shift by 64", ((u128)1 << 64) == (u128)18446744073709551616, true);
    passed += Test("i128 signed boundary", (i128)-1 < (i128)1, true);
    passed += Test("u128 unsigned boundary", unsignedValue > (u128)0, true);
    int narrowInt = 7;
    i64 narrowI64 = 8;
    u64 narrowU64 = 9;
    passed += Test("widen int to i128", (i128)narrowInt == (i128)7, true);
    passed += Test("widen i64 to i128", (i128)narrowI64 == (i128)8, true);
    passed += Test("widen u64 to u128", (u128)narrowU64 == (u128)9, true);
    i64 explicitNarrow = (i64)nearSigned;
    passed += Test("explicit i128 narrowing", explicitNarrow == (i64)5, true);
    i128 floatSigned = (i128)(double)123456789012345;
    u128 floatUnsigned = (u128)(double)123456789012345;
    passed += Test("i128 float round trip", floatSigned == (i128)123456789012345, true);
    passed += Test("u128 float round trip", floatUnsigned == (u128)123456789012345, true);
    passed += Test("i128 toString zero", ((i128)0).toString(), "0");
    passed += Test("i128 toString negative", ((i128)-1).toString(), "-1");
    passed += Test("i128 toString min", ((i128)-170141183460469231731687303715884105728).toString(), "-170141183460469231731687303715884105728");
    passed += Test("u128 toString max", unsignedValue.toString(), "340282366920938463463374607431768211455");
    passed += Test("sizeof i128", (int)sizeof(i128), 16);
    list<i128> genericValues = default;
    genericValues.add((i128)42);
    passed += Test("generic list<i128> add/get", genericValues.get(0) == (i128)42, true);
    return passed;
}

// A C++ exception thrown by a field's C++ constructor unwinds through a [cpp] struct's generated
// constructor helper up to the C++ catch in cppunw.guarded (test_cpp_interop legs 3276-3277, kept
// here for this file's -O2 twin run: a noexcept helper declaration terminated once inlined).
import cpp "library/cpp_interop_unwind.h";
import cpp "library/cpp_interop_unwind.cpp";
[cpp] struct OpUnwFields { cppunw.Tx f1 = default; cppunw.Tx f2 = default; };
[cpp] struct OpUnwFieldsCtor { cppunw.Tx f1 = default; cppunw.Tx f2 = default; OpUnwFieldsCtor(int v) { } };
int OpUnwStructFields(int x)
{
    cppunw.Tr a = default;
    cppunw.setArm(2);
    OpUnwFields s = default;
    return s.f1.get();
}
int OpUnwStructCtorFields(int x)
{
    cppunw.setArm(2);
    OpUnwFieldsCtor s = OpUnwFieldsCtor(1);
    return s.f1.get();
}
// Override helpers and struct-returning callbacks run behind a reverse ABI thunk that must
// stay unwindable (it was nounwind: the throw terminated even at -O0).
import cpp "library/cpp_interop_override_abi.h";
[cpp] struct OpUnwOverride : cppoa.Base
{
    int k = 0;
    override int integer() { return cppunw.thrower(k); }
    override cppoa.Small16 small16() { cppoa.Small16 r = default; r.a = cppunw.thrower(k); return r; }
    override cppoa.Large24 large24() { cppoa.Large24 r = default; r.a = cppunw.thrower(k); return r; }
};
int OpUnwOverrideInt(int x) { cppunw.Tr t = default; OpUnwOverride d = default; d.k = x; cppoa.Base* b = &d; return cppoa.call_integer(b); }
int OpUnwOverride16(int x) { cppunw.Tr t = default; OpUnwOverride d = default; d.k = x; cppoa.Base* b = &d; return cppoa.call_small16(b); }
int OpUnwOverride24(int x) { cppunw.Tr t = default; OpUnwOverride d = default; d.k = x; cppoa.Base* b = &d; return cppoa.call_large24(b); }
cppunw.S16 OpUnwCb16(int x) { cppunw.Tr t = default; cppunw.S16 r = default; r.a = cppunw.thrower(x); return r; }
cppunw.S24 OpUnwCb24(int x) { cppunw.Tr t = default; cppunw.S24 r = default; r.a = cppunw.thrower(x); return r; }
int cppUnwindThroughHelperLegs()
{
    cppunw.reset();
    int r = cppunw.guarded(OpUnwStructFields, 5);
    if (r != -5 || cppunw.live() != 0 || cppunw.dtors() != 2) return 1;
    cppunw.reset();
    r = cppunw.guarded(OpUnwStructCtorFields, 5);
    if (r != -5 || cppunw.live() != 0 || cppunw.dtors() != 1) return 2;
    cppunw.reset(); r = cppunw.guarded(OpUnwOverrideInt, 5); if (r != -5 || cppunw.live() != 0) return 3;
    cppunw.reset(); r = cppunw.guarded(OpUnwOverride16, 5); if (r != -5 || cppunw.live() != 0) return 4;
    cppunw.reset(); r = cppunw.guarded(OpUnwOverride24, 5); if (r != -5 || cppunw.live() != 0) return 5;
    cppunw.reset(); r = cppunw.guarded16(OpUnwCb16, 5); if (r != -5 || cppunw.live() != 0) return 6;
    cppunw.reset(); r = cppunw.guarded24(OpUnwCb24, 5); if (r != -5 || cppunw.live() != 0) return 7;
    return 0;
}

// ── Main ─────────────────────────────────────────────────────────────────────

extern int main()
{
    // Vec2 tests
    Vec2 a; a.x = 1.0f; a.y = 2.0f;
    Vec2 b; b.x = 3.0f; b.y = 4.0f;

    Vec2 sum = a + b;
    Test("Vec2 + x", sum.x, 4.0f);
    Test("Vec2 + y", sum.y, 6.0f);

    Vec2 diff = b - a;
    Test("Vec2 - x", diff.x, 2.0f);
    Test("Vec2 - y", diff.y, 2.0f);

    Vec2 scaled = a * 3.0f;
    Test("Vec2 * x", scaled.x, 3.0f);
    Test("Vec2 * y", scaled.y, 6.0f);

    Vec2 divided = b / 2.0f;
    Test("Vec2 / x", divided.x, 1.5f);
    Test("Vec2 / y", divided.y, 2.0f);

    Vec2 c; c.x = 1.0f; c.y = 2.0f;
    Test("Vec2 == (equal)",     a == c,  true);
    Test("Vec2 == (not equal)", a == b,  false);
    Test("Vec2 != (not equal)", a != b,  true);
    Test("Vec2 != (equal)",     a != c,  false);

    // Fraction tests:  1/2 + 1/3 = 5/6,  1/2 * 2/3 = 2/6 = 1/3
    Fraction half;  half.num  = 1; half.den  = 2;
    Fraction third; third.num = 1; third.den = 3;
    Fraction twothirds; twothirds.num = 2; twothirds.den = 3;

    Fraction fsum = half + third;          // 5/6
    Test("Frac + num", fsum.num, 5);
    Test("Frac + den", fsum.den, 6);

    Fraction fdiff = half - third;         // 1/6
    Test("Frac - num", fdiff.num, 1);
    Test("Frac - den", fdiff.den, 6);

    Fraction fprod = half * twothirds;     // 2/6
    Fraction oneThird; oneThird.num = 1; oneThird.den = 3;
    Test("Frac * ==",  fprod == oneThird, true);

    Test("Frac ==",    half == half,   true);
    Test("Frac !=",    half != third,  true);
    Test("Frac < ",    third < half,   true);
    Test("Frac > ",    half > third,   true);

    // Counter tests
    Counter p; p.value = 10;
    Counter q; q.value = 5;

    Counter csum  = p + q;
    Counter cdiff = p - q;
    Counter cmul  = q * 4;

    Test("Counter + value",  csum.value,  15);
    Test("Counter - value",  cdiff.value,  5);
    Test("Counter * value",  cmul.value,  20);
    Test("Counter == (eq)",  p == p,  true);
    Test("Counter == (ne)",  p == q,  false);
    Test("Counter <  ",      q < p,   true);

    CompoundBox copA; copA.value = 10;
    CompoundBox copB; copB.value = 3;
    copA += copB; Test("compound overload +=", copA.value, 13);
    copA -= copB; Test("compound overload -=", copA.value, 10);
    copA *= copB; Test("compound overload *=", copA.value, 30);
    copA /= copB; Test("compound overload /=", copA.value, 10);
    copA %= copB; Test("compound overload %=", copA.value, 1);
    copA.value = 3; copA <<= copB; Test("compound overload <<=", copA.value, 24);
    copA >>= copB; Test("compound overload >>=", copA.value, 3);

    int primitiveMod = 5;
    primitiveMod %= 4;
    Test("primitive %=", primitiveMod, 1);

    // Bitwise: binary overload used directly, and reached through the compound spelling.
    BitBox bitA; bitA.value = 12;
    BitBox bitB; bitB.value = 10;
    BitBox bitAnd = bitA & bitB; Test("BitBox binary &", bitAnd.value, 8);
    BitBox bitOr  = bitA | bitB; Test("BitBox binary |", bitOr.value, 14);
    BitBox bitXor = bitA ^ bitB; Test("BitBox binary ^", bitXor.value, 6);
    BitBox bitC = bitA; bitC &= bitB; Test("compound overload &=", bitC.value, 8);
    BitBox bitD = bitA; bitD |= bitB; Test("compound overload |=", bitD.value, 14);
    BitBox bitE = bitA; bitE ^= bitB; Test("compound overload ^=", bitE.value, 6);

    // Only a compound overload declared, and compound-beats-binary precedence.
    OnlyCompoundBox onlyA; onlyA.value = 1;
    OnlyCompoundBox onlyB; onlyB.value = 2;
    onlyA += onlyB; Test("compound-only overload +=", onlyA.value, 103);
    BothCompoundBox bothA; bothA.value = 1;
    BothCompoundBox bothB; bothB.value = 2;
    BothCompoundBox bothSum = bothA + bothB; Test("both: binary + used", bothSum.value, 3);
    bothA += bothB; Test("both: compound += wins", bothA.value, 1003);

    // Compound overload on a field, an array element, and through a pointer deref.
    CompoundHolder copH = default; copH.f.value = 4;
    copH.f *= copB; Test("compound overload on field", copH.f.value, 12);
    CompoundBox[3] copArr = default;
    copArr[1].value = 5;
    copArr[1] *= copB; Test("compound overload on array element", copArr[1].value, 15);
    CompoundBox copTarget; copTarget.value = 7;
    CompoundBox* copPtr = &copTarget;
    *copPtr *= copB; Test("compound overload through pointer", copTarget.value, 21);

    // Chained: (a + b) + c  ==  a + (1,2) + (3,4)+(1,2) = (5,8)+(1,2) but let's just check addition chaining
    Vec2 chain = a + b + c;    // (1+3+1, 2+4+2) = (5, 8)
    Test("Vec2 chain + x", chain.x, 5.0f);
    Test("Vec2 chain + y", chain.y, 8.0f);

    // ── Unary operator overloads ──────────────────────────────────────────────

    // operator-(): unary negation on Vec2
    Vec2 neg = -a;             // -(1,2) = (-1,-2)
    Test("Vec2 unary- x", neg.x, -1.0f);
    Test("Vec2 unary- y", neg.y, -2.0f);

    unaryMutDtorCount = 0;
    {
        UnaryMut mut = default; mut.value = 1;
        Test("native unary- mutates lvalue", -mut, 2);
        Test("native unary- keeps lvalue receiver", mut.value, 2);
        UnaryMut* mutPtr = &mut;
        Test("native unary- mutates pointer deref", -(*mutPtr), 3);
        Test("native unary- pointer receiver value", mut.value, 3);
        Test("native unary- has no receiver copy dtors", unaryMutDtorCount, 0);
    }
    Test("native unary- lvalue destroyed once", unaryMutDtorCount, 1);
    unaryMutDtorCount = 0;
    Test("native unary- on temporary", -makeUnaryMut(9), 10);
    Test("native unary- temporary destroyed once", unaryMutDtorCount, 1);

    // Ensure binary operator- still works alongside unary
    Vec2 bsub = b - a;         // (3,4)-(1,2) = (2,2)
    Test("Vec2 binary- after unary- x", bsub.x, 2.0f);
    Test("Vec2 binary- after unary- y", bsub.y, 2.0f);

    // operator!(): logical NOT on BoolBox
    BoolBox bt; bt.value = true;
    BoolBox bf; bf.value = false;
    Test("BoolBox !true",  !bt, false);
    Test("BoolBox !false", !bf, true);

    bool unaryBool = true;
    Test("C bool unary minus promotes to -1", -unaryBool, -1);
    Test("C bool unary plus promotes to 1", +unaryBool, 1);
    Test("C bool unary complement promotes to -2", ~unaryBool, -2);
    const bool unaryBoolConst = true;
    bool* unaryBoolPtr = &unaryBool;
    Test("C bool temporary unary minus", -true, -1);
    Test("C bool temporary unary plus", +true, 1);
    Test("C bool temporary unary complement", ~true, -2);
    Test("C const bool unary minus", -unaryBoolConst, -1);
    Test("C const bool unary plus", +unaryBoolConst, 1);
    Test("C const bool unary complement", ~unaryBoolConst, -2);
    Test("C bool pointer unary minus", -*unaryBoolPtr, -1);
    Test("C bool pointer unary plus", +*unaryBoolPtr, 1);
    Test("C bool pointer unary complement", ~*unaryBoolPtr, -2);

    float[4] unarySimdInput = {1.0f, -2.0f, 3.5f, -4.5f};
    simd<float, 4> unarySimdValue = simd<float, 4>.load(unarySimdInput, 0);
    const simd<float, 4> unarySimdConst = unarySimdValue;
    simd<float, 4>* unarySimdPtr = &unarySimdValue;
    float[4] unarySimdOutput = default;
    simd<float, 4>.store(-unarySimdValue, unarySimdOutput, 0);
    Test("simd float unary minus lane 0", unarySimdOutput[0], -1.0f);
    Test("simd float unary minus lane 1", unarySimdOutput[1], 2.0f);
    Test("simd float unary minus lane 2", unarySimdOutput[2], -3.5f);
    Test("simd float unary minus lane 3", unarySimdOutput[3], 4.5f);
    simd<float, 4>.store(-simd<float, 4>.load(unarySimdInput, 0), unarySimdOutput, 0);
    Test("simd float temporary unary minus lane 0", unarySimdOutput[0], -1.0f);
    simd<float, 4>.store(-unarySimdConst, unarySimdOutput, 0);
    Test("simd float const unary minus lane 0", unarySimdOutput[0], -1.0f);
    simd<float, 4>.store(-*unarySimdPtr, unarySimdOutput, 0);
    Test("simd float pointer unary minus lane 0", unarySimdOutput[0], -1.0f);

    // -- operator(): callable struct values, pointers, aliases, and overloads --
    int callPassed = 0;
    Callable callable;
    Callable* callablePtr = &callable;
    CallableAlias callableAlias = callable;
    callPassed += Test("Callable operator() no args", callable(), 40);
    callPassed += Test("Callable operator() int overload", callable(2), 12);
    callPassed += Test("Callable operator() float overload", callable(2.5f), 102);
    callPassed += Test("Callable pointer operator()", callablePtr(3), 13);
    callPassed += Test("Callable alias operator()", callableAlias(4), 14);
    CallableHolder callableHolder = default;
    callableHolder.value = callable;
    callPassed += Test("Callable struct field operator()", callableHolder.value(5), 15);
    CallableField callableField;
    callPassed += Test("function-pointer field call remains indirect", callableField.fn(5), 25);

    TruthinessBox truth = default;
    truth.value = 1;
    Test("operator bool in if", truth ? true : false, true);
    Test("operator bool in ternary", truth ? 17 : 23, 17);
    Test("operator bool in &&", truth && true, true);
    Test("operator bool in ||", false || truth, true);
    Test("operator bool explicit cast", (bool)truth, true);
    double truthScalar = 2.5;
    Test("scalar bool cast ignores struct operator bool", (bool)truthScalar, true);
    Test("operator bool in !", !truth, false);
    while (truth) truth.value = 0;
    Test("operator bool terminates while", truth.value, 0);
    do { truth.value = 1; } while (false && truth);
    for (; truth; truth.value = 0) { }
    Test("operator bool in do-for", truth.value, 0);

    GenericTruthinessBox<int> genericTruth = default;
    genericTruth.value = 1;
    Test("operator bool generic struct", genericTruth ? true : false, true);

    // Conversion operators are explicit-only, and can target primitives or structs.
    CelsiusAlias celsius = default;
    celsius.degrees = 20;
    Test("built-in cast keeps its meaning", (int)7, 7);
    Test("operator int primitive target", (int)celsius, 20);
    Fahrenheit fahrenheit = (Fahrenheit)celsius;
    Test("operator Fahrenheit struct target", fahrenheit.degrees, 52);
    Test("chained conversion operators", (int)(Fahrenheit)celsius, 1052);

    // operator~(): bitwise NOT on Bits
    Bits bits; bits.value = 0xFF;
    int flipped = ~bits;
    Test("Bits ~ 0xFF", flipped, ~0xFF);

    Bits zero; zero.value = 0;
    Test("Bits ~ 0", ~zero, ~0);

    // ── operator-> forwarding ──────────────────────────────────────────────────

    // Wrapper over a plain struct pointer: w->field reads and w->method() calls
    // forward to the contained Inner.
    Inner item; item.value = 7;
    Box w; w.p = &item;
    Test("Box-> field read",   w->value,    7);
    Test("Box-> method call",  w->triple(), 21);

    // Mutate through the forwarded pointer, then read back.
    w->value = 9;
    Test("Box-> field write",  item.value,  9);
    Test("Box-> method after write", w->triple(), 27);

    // Chaining: OuterBox::operator-> returns a Box, which itself defines
    // operator-> - the chain must continue until the raw Inner* is reached.
    OuterBox ob; ob.inner = w;
    Test("OuterBox-> chained field",  ob->value,    9);
    Test("OuterBox-> chained method", ob->triple(), 27);

    // ── postfix increment/decrement, unary operator*, and forwarding ─────────
    ForwardThing[2] forwardThings = default;
    forwardThings[0].field = 4;
    forwardThings[0].count = 7;
    forwardThings[0].tag = 1;
    forwardThings[1].field = 8;
    ForwardPtr fp; fp.raw = &forwardThings[0]; fp.tag = 2;
    ForwardPtr updated = fp++;
    Test("struct postfix ++ mutates in place", fp.raw == &forwardThings[1], true);
    Test("struct postfix ++ yields updated value", updated.raw == fp.raw, true);
    ForwardPtr decremented = fp--;
    Test("struct postfix -- mutates in place", fp.raw == &forwardThings[0], true);
    Test("struct postfix -- yields updated value", decremented.raw == fp.raw, true);
    Test("unary operator* returns pointer", (*fp).field, 4);
    ForwardThing* dereferenced = *fp;
    Test("unary operator* pointer value", dereferenced->field, 4);
    Test("dot forwards field", fp.field, 4);
    fp.field = 5;
    Test("dot forwards field write", forwardThings[0].field, 5);
    Test("dot forwards method", fp.method(), 10);
    fp.count++;
    Test("dot forwards scalar postfix", forwardThings[0].count, 8);
    Test("own member wins over forwarding", fp.tag, 2);
    Test("own raw member wins over forwarding", fp.raw == &forwardThings[0], true);
    ForwardPtr* fpReceiver = &fp;
    Test("pointer dot forwards field", fpReceiver.field, 5);
    fpReceiver.field = 6;
    Test("pointer dot forwards field write", forwardThings[0].field, 6);
    Test("pointer dot forwards method", fpReceiver.method(), 12);
    fpReceiver.field = 5;

    GenericForwardBox<ForwardThing> genericForward;
    genericForward.raw = &forwardThings[0];
    Test("generic operator-> forwarding", genericForward->field, 5);
    Test("generic unary operator*", (*genericForward).field, 5);

    ValueDerefBox valueDeref; valueDeref.value.field = 12;
    Test("value unary operator*", (*valueDeref).field, 12);
    AliasDerefBox aliasDeref; aliasDeref.raw = &forwardThings[0];
    (*aliasDeref).field = 13;
    Test("alias unary operator*", forwardThings[0].field, 13);

    // ── Flexible model: own-member-first, forward only on a miss ──────────────

    // (a) `.` (not just `->`) forwards when the member is NOT on the wrapper.
    Test("Box. forwards field (miss)",  w.value,    9);
    Test("Box. forwards method (miss)", w.triple(), 27);

    // (b) `->` resolves an OWN member of the wrapper directly (no forwarding).
    w.tag = 5;
    Test("Box-> own field",  w->tag,   5);
    Test("Box-> own method", w->who(), 2);

    // (c) Shadowing: `who` exists on BOTH Box and Inner; access resolves to the
    // wrapper's Box::who (2), never the forwarded Inner::who (1) - via both tokens.
    Test("Box. own shadows forwarded", w.who(),  2);
    Test("Box-> own shadows forwarded", w->who(), 2);

    // Flexible `->` on a plain value (no operator->) reaches its own member,
    // exactly like `.` would - `->` on a value is not an error.
    Plain pl; pl.value = 42;
    Test("Plain-> own field",  pl->value, 42);
    Test("Plain. own field",   pl.value,  42);

    // ── ?. (null-conditional) composes with operator-> forwarding ──────────────
    // The `?` is recognized first, then operator-> forwards on a miss and the
    // null guard applies to the forwarded pointer (w.p is &item, non-null here).
    Test("Box?. forwards field (non-null)",  w?.value,    9);
    Test("Box?. forwards method (non-null)", w?.triple(), 27);

    Box? nullableBox = &w;
    callPassed += Test("nullable Box?. forwards field", nullableBox?.value, 9);
    callPassed += Test("nullable Box?. forwards method", nullableBox?.triple(), 27);
    callPassed += Test("OuterBox?. forwards through arrow chain", ob?.value, 9);

    // When the wrapped pointer is null, the forwarded `?.` short-circuits to the
    // default instead of dereferencing.
    Box wn; wn.p = nullptr;
    Test("Box?. null field short-circuits", wn?.value,       0);
    Test("Box?. null with coalesce",        wn?.value ?? -1, -1);
    Box? nullBox = nullptr;
    callPassed += Test("nullable Box?. null field", nullBox?.value, 0);
    callPassed += Test("nullable Box?. null method", nullBox?.triple(), 0);

    // A `string?` slot holds a real `string*`, so `?.` through it must reach the pointee's
    // method, and a null one must short-circuit to 0. Accept-set for the 2026-08-21 p2 SIGSEGV,
    // whose cause was a `const char*` LITERAL silently accepted for the `string*` slot (that
    // spelling is now rejected - see Test/errors/err_ptr_from_value.cb); `&s` is the spelling
    // that always worked and must keep working.
    string ncText = "ab" + "cd";
    string? ncPtr  = &ncText;
    string? ncNull = nullptr;
    Test("string? ?. method (non-null)", (int)ncPtr?.length(),  4);
    Test("string? ?. method (null)",     (int)ncNull?.length(), 0);

    // ── operator[] through a parenthesized deref ──────────────────────────────
    // `(*p)` is a struct receiver like any other, so `(*p)[i]` must find operator[].
    // Regression: the parenthesized primary published its type and storage but never
    // its BaseType, so no struct receiver was established - the subscript fell through
    // to the raw-index path and crashed the COMPILER on a null type (exit 139, no
    // diagnostic). An unknown base type is now a LogError instead.
    Cells cs; cs.base = 100;
    Cells* cp = &cs;
    Test("Cells value subscript",     cs[3],    103);
    Test("Cells deref subscript",     (*cp)[3], 103);
    Test("Cells deref subscript [0]", (*cp)[0], 100);

    // The same shape stays an LVALUE: a write through it must reach the pointee,
    // not a materialized copy of it.
    (*cp).base = 200;
    Test("Cells deref field write",   cs.base,  200);
    Test("Cells deref subscript after write", (*cp)[1], 201);

    // Logical '!' is a zero-compare yielding bool, NOT the bitwise '~'. Regression:
    // '!' used to lower to xor -1, so on any type wider than i1 every operand negated
    // to a nonzero (truthy) value - '!1' and '!0' were both true, and '!ptr' was
    // invalid IR that faulted at runtime.
    int notOne  = 1;
    int notZero = 0;
    Test("!int 1",         !notOne,   false);
    Test("!int 0",         !notZero,  true);
    Test("!!int 1",        !!notOne,  true);
    Test("!int truthy 42", !42,    false);

    bool notBt = true;
    Test("!bool true",  !notBt, false);
    Test("!bool false", !!notBt, true);

    float notFz = 0.0f;
    float notFnz = 2.5f;
    Test("!float 0",   !notFz,  true);
    Test("!float 2.5", !notFnz, false);

    int notTarget = 7;
    int* notPv = &notTarget;
    int* notPn = nullptr;
    Test("!ptr null",    !notPn, true);
    Test("!ptr non-null", !notPv, false);

    // '~' stays bitwise - the two operators must not collapse onto each other.
    Test("~int 0", ~notZero, -1);
    Test("~int 1", ~notOne,  -2);

    // Compile-time macros are i32, so `if const (!MACRO)` exercised the same bug:
    // the not-taken arm was compiled anyway. __WINDOWS__ and __MACOS__ are disjoint,
    // so exactly one of these two arms may run.
    int constArm = 0;
    if const (!__WINDOWS__) { constArm = constArm + 1; }
    if const (!__MACOS__)   { constArm = constArm + 10; }
    Test("if const (!macro) picks one arm", constArm == 1 || constArm == 10, true);

    // Ternary condition coercion. A non-bool '?:' condition used to be handed to LLVM's
    // 'select' raw (which demands i1), so `int cond ? a : b` failed module verification.
    int terPassed = 0;
    int    terI  = 3;
    int    terI0 = 0;
    char   terC  = 'x';
    char   terC0 = 0;
    u64    terU  = 7;
    u64    terU0 = 0;
    double terD  = 1.5;
    double terD0 = 0.0;
    float  terF  = 2.5f;
    int    terTarget = 9;
    int*   terP  = &terTarget;
    int*   terPn = nullptr;
    bool   terB  = true;

    terPassed += Test("ternary int cond nonzero",   terI  ? 1 : 0, 1);
    terPassed += Test("ternary int cond zero",      terI0 ? 1 : 0, 0);
    terPassed += Test("ternary char cond nonzero",  terC  ? 1 : 0, 1);
    terPassed += Test("ternary char cond zero",     terC0 ? 1 : 0, 0);
    terPassed += Test("ternary u64 cond nonzero",   terU  ? 1 : 0, 1);
    terPassed += Test("ternary u64 cond zero",      terU0 ? 1 : 0, 0);
    terPassed += Test("ternary double cond nonzero", terD ? 1 : 0, 1);
    terPassed += Test("ternary double cond zero",   terD0 ? 1 : 0, 0);
    terPassed += Test("ternary float cond nonzero", terF  ? 1 : 0, 1);
    terPassed += Test("ternary ptr cond non-null",  terP  ? 1 : 0, 1);
    terPassed += Test("ternary ptr cond null",      terPn ? 1 : 0, 0);
    terPassed += Test("ternary bool cond",          terB  ? 1 : 0, 1);
    // Non-bool condition in a branch of if/while must keep working too.
    if (terD) { terPassed += Test("if double cond nonzero", 1, 1); }

    // Only the SELECTED arm runs. The ternary used to compute both arms eagerly and combine
    // them with a select, so a side effect in the not-taken arm still happened.
    g_sideEffects = 0;
    int scT = true  ? bumpSideEffect(1) : bumpSideEffect(100);
    terPassed += Test("ternary picks true arm",      scT, 1);
    terPassed += Test("ternary skips false arm",     g_sideEffects, 1);
    g_sideEffects = 0;
    int scF = false ? bumpSideEffect(1) : bumpSideEffect(100);
    terPassed += Test("ternary picks false arm",     scF, 100);
    terPassed += Test("ternary skips true arm",      g_sideEffects, 100);
    // Nested ternary: exactly one leaf arm runs.
    g_sideEffects = 0;
    int scN = terI0 ? bumpSideEffect(1) : (terI ? bumpSideEffect(10) : bumpSideEffect(1000));
    terPassed += Test("nested ternary picks one leaf", scN, 10);
    terPassed += Test("nested ternary skips others",   g_sideEffects, 10);

    // A ternary over two lvalues is itself an lvalue (C++ rule): a write lands on the selected
    // arm only, and reading the ternary into a variable still copies.
    int terLa = 1;
    int terLb = 2;
    (terB ? terLa : terLb) = 5;
    terPassed += Test("ternary lvalue assign selected", terLa, 5);
    terPassed += Test("ternary lvalue assign other",    terLb, 2);
    (terI0 ? terLa : terLb)++;
    terPassed += Test("ternary lvalue ++ selected",     terLb, 3);
    int terCopy = terB ? terLa : terLb;
    terLa = 99;
    terPassed += Test("ternary read still copies",      terCopy, 5);

    // Raw-pointer left operand selects the free operator==(PtrNode*, PtrKey). The pointer
    // is passed straight through as `this` - it is never copied into a temporary alloca.
    int ptrOpPassed = 0;
    PtrNode* pnode = new PtrNode();
    pnode->v = 42;
    PtrKey pkey = default;
    pkey.v = 42;
    ptrOpPassed += Test("ptr lhs operator== match",     pnode == pkey, true);
    ptrOpPassed += Test("ptr lhs operator!= match",     pnode != pkey, false);
    pkey.v = 7;
    ptrOpPassed += Test("ptr lhs operator== mismatch",  pnode == pkey, false);
    ptrOpPassed += Test("ptr lhs operator!= mismatch",  pnode != pkey, true);

    // ANTI-REGRESSION: ptr-vs-ptr must NEVER enter overload dispatch. `p == nullptr` is
    // the builtin address check, so it is false while allocated and true once nulled.
    ptrOpPassed += Test("ptr == nullptr builtin, allocated", pnode == nullptr, false);
    ptrOpPassed += Test("ptr != nullptr builtin, allocated", pnode != nullptr, true);
    delete pnode;
    pnode = nullptr;
    ptrOpPassed += Test("ptr == nullptr builtin, nulled",    pnode == nullptr, true);
    ptrOpPassed += Test("ptr != nullptr builtin, nulled",    pnode != nullptr, false);

    // Overload results above 2^63 stay unsigned through /, >, and chained arithmetic.
    int uPassed = 0;
    UBits ub = default;
    ub.v = (u64)0x8000000000000000;
    uPassed += Test("u64 operator>> result divides unsigned", (ub >> 0) / 2 == (u64)4611686018427387904, true);
    // RHS literals stay SIGNED so the operands' flags cannot mask a dropped return signedness.
    uPassed += Test("u64 operator+ result divides unsigned",  (ub + 0) / 2 == (u64)4611686018427387904, true);
    uPassed += Test("u64 operator* result compares unsigned", (ub * 1) > 1000, true);

    // Unsigned literals keep their zero-extension and unsigned integer-to-double conversion.
    int unsignedLiteralPassed = 0;
    u64 literalMaskValue = 4294967296u;
    unsignedLiteralPassed += Test("u32 literal widens without sign extension",
        (literalMaskValue & 4294967295u) == 0, true);
    unsignedLiteralPassed += Test("u64 max unsigned-to-double",
        (double)18446744073709551615u > 1.8e19, true);

    // Aggregate initializers must carry the source's unsignedness into the widening store.
    u64[1] braceArray = {4294967295u};
    unsignedLiteralPassed += Test("fixed-array brace element zero-extends",
        braceArray[0] == (u64)4294967295, true);
    UDefaults defaulted = default;
    unsignedLiteralPassed += Test("struct field default zero-extends",
        defaulted.wide == (u64)4294967295, true);
    UDefaults named = {wide = 4294967295u};
    unsignedLiteralPassed += Test("named brace field zero-extends",
        named.wide == (u64)4294967295, true);
    unsignedLiteralPassed += Test("global field default zero-extends",
        g_unsignedDefaults.wide == (u64)4294967295, true);

    // Indirect calls widen arguments with the argument's own signedness.
    function<u64(u64)> widenFn = WidenUnsigned;
    unsignedLiteralPassed += Test("function-pointer argument zero-extends",
        widenFn(4294967295u) == (u64)4294967295, true);

    // Unary minus on an unsigned literal wraps modulo the literal's own width (C semantics),
    // so it must NOT be folded down into a narrower signed type.
    u64 negatedUnsigned = -5u;
    unsignedLiteralPassed += Test("unary minus on u32 literal wraps modulo 2^32",
        negatedUnsigned == (u64)4294967291, true);

    // ACCEPT-SET (these already hold before the unsigned-literal fix; they are anti-regression
    // guards that the new unsignedness plumbing must not flip).
    int unsignedAcceptPassed = 0;
    u32 variableValue = 4294967295u;
    u64 variableWidened = variableValue;
    unsignedAcceptPassed += Test("u32 variable widening remains unsigned",
        variableWidened == (u64)4294967295, true);
    i32 negativeShifted = -8;
    unsignedAcceptPassed += Test("signed >> unsigned stays an arithmetic shift",
        (negativeShifted >> 1u) == -4, true);
    i64 negativeWide = -1;
    unsignedAcceptPassed += Test("wider signed vs narrower unsigned compares signed",
        negativeWide < 1u, true);
    unsignedAcceptPassed += Test("global array brace element already zero-extended",
        g_unsignedArray[0] == (u64)4294967295, true);
    unsignedAcceptPassed += Test("u32 vs signed zero compares unsigned",
        variableValue > 0, true);
    unsignedAcceptPassed += Test("unsigned field default to double stays positive",
        defaulted.asDouble > 4.0e9, true);
    u8[400] indexedBytes = default;
    indexedBytes[300u] = 7;
    unsignedAcceptPassed += Test("array index above 255u addresses the right slot",
        (int)indexedBytes[300u], 7);


    int chainPassed = 0;
    ChainBox cb;
    ChainBox* cbp = &cb;
    list<int> chainItems;
    chainItems.add(1); chainItems.add(2);
    list<int> xs;
    xs.add(7);
    string chainCount = chainItems.count().toString();
    PrimitiveResults pr;
    chainPassed += Test("primitive method result uses free receiver", cb.get().doubleValue(), 700);
    chainPassed += Test("primitive pointer result uses free receiver", cbp->get().doubleValue(), 700);
    chainPassed += Test("primitive result toString", chainItems.count().toString(), "2");
    chainPassed += Test("list int get primitive toString", xs.get(0).toString(), "7");
    chainPassed += Test("list int index primitive toString", xs[0].toString(), "7");
    chainPassed += Test("primitive result length toString", chainCount.length().toString(), "1");
    chainPassed += Test("primitive result as argument", chainAddOne(cb.get().doubleValue()), 701);
    chainPassed += Test("three primitive links", cb.get().doubleValue().doubleValue(), 70000);
    chainPassed += Test("double result receiver", pr.getDouble().addOneDouble() == 3.5, true);
    chainPassed += Test("bool result receiver", pr.getBool().flipBool().toString(), "false");
    chainPassed += Test("char result receiver", pr.getChar().charLabel(), "char");

    int softPassed = 0;
    softPassed += Test("soft import words remain identifiers",
                       softImportIdentifiers(1, 2, 4, 8, 16, 32, 64), 127);


    int promoPassed = promotionAndLiteralLegs();
    int signednessPassed = primitiveBinarySignednessLegs();
    int autoNarrowPassed = autoNarrowMixedSignednessLegs();
    int joinAcceptPassed = stringLiteralJoinAcceptLegs();
    int narrowPromoPassed = narrowUnaryAndTernaryPromotionLegs();
    int i128Passed = i128FeatureLegs();
    int reversedPassed = reversedAndZeroArgOverloadLegs();
    int sizeofUnevalPassed = sizeofUnevaluatedLegs();
    int boolFpPassed = boolToFloatingLegs();
    if (compoundResultOwnershipLegs() != 26) return 57;
    if (byValueParamOwnershipLegs() != 66) return 58;
    if (byValueAliasTempLegs() != 68) return 59;
    if (byValueAliasOperatorLegs() != 11) return 61;
    if (cppUnwindThroughHelperLegs() != 0) return 60;

    return (callPassed == 12 && terPassed == 23 && ptrOpPassed == 8 && uPassed == 3
        && unsignedLiteralPassed == 8 && unsignedAcceptPassed == 7
        && chainPassed == 11 && softPassed == 1 && promoPassed == 11
        && signednessPassed == 38 && autoNarrowPassed == 4 && joinAcceptPassed == 5
        && narrowPromoPassed == 46 && i128Passed == 29
        && reversedPassed == 3 && sizeofUnevalPassed == 67
        && boolFpPassed == 20 && userLibcAtollWins()) ? 0 : 1;
}

// C integer promotion for equal-width sub-int operands, plus the two literal-unsignedness
// sites (ternary arm, default parameter) that used to sign-extend a u-suffixed literal.
i64 unsignedDefaultParam(i64 v = 4294967295u) { return v; }

// bool -> floating point is unsigned: true is 1.0, never the -1.0 a signed i1 conversion gives.
double g_boolFpScalar = true;
double[2] g_boolFpArray = {true, false};
double boolFpReturn(bool b) { return b; }
T boolFpGeneric<T>(T x) { return x; }

int boolToFloatingLegs()
{
    int p = 0;
    bool b = true;
    bool f = false;
    p += Test("bool to double cast", (double)b == 1.0, true);
    p += Test("bool to float cast", (float)b == 1.0f, true);
    p += Test("bool to longdouble cast", (double)(longdouble)b == 1.0, true);
    double di = b;
    float fi = b;
    p += Test("bool to double init", di == 1.0, true);
    p += Test("bool to float init", fi == 1.0f, true);
    double da = 0.0;
    da = b;
    p += Test("bool to double assignment", da == 1.0, true);
    p += Test("bool to double return", boolFpReturn(b) == 1.0, true);
    p += Test("bool plus double", b + 0.5 == 1.5, true);
    p += Test("bool plus float", b + 0.5f == 1.5f, true);
    bool c = true;
    p += Test("bool ternary arm with double", (c ? b : 0.5) == 1.0, true);
    double dc = 1.0;
    dc += b;
    p += Test("double compound add bool", dc == 2.0, true);
    simd<double, 2> v = b;
    p += Test("bool simd splat", v[1] == 1.0, true);
    p += Test("bool generic double", boolFpGeneric<double>((double)b) == 1.0, true);
    p += Test("bool generic bool", (double)boolFpGeneric<bool>(b) == 1.0, true);
    p += Test("bool global double init", g_boolFpScalar == 1.0, true);
    p += Test("bool global array element", g_boolFpArray[0] == 1.0, true);
    double[2] la = {true, false};
    p += Test("bool local array element", la[0] == 1.0, true);
    p += Test("false to double", (double)f == 0.0, true);
    p += Test("signed negative to double", (double)-7 == -7.0, true);
    int ii = b;
    p += Test("bool to int stays 1", ii, 1);
    return p;
}

int promotionAndLiteralLegs()
{
    int passed = 0;
    i8 nc = -1;
    u8 uc = 3;
    passed += Test("i8 vs u8 compare promotes to signed int", nc < uc, true);
    passed += Test("i8 divided by u8 promotes to signed int", (int)(nc / uc), 0);
    i16 ns = -1;
    u16 us = 3;
    passed += Test("i16 vs u16 compare promotes to signed int", ns < us, true);
    passed += Test("i16 divided by u16 promotes to signed int", (int)(ns / us), 0);

    // ACCEPT-SET: promotion must not change the width of a narrow result, the signed
    // pure-signed case, the logical shift of an unsigned operand, or the 32-bit rule.
    u8 bigByte = 200;
    u8 halfByte = 100;
    passed += Test("u8 addition still wraps in 8 bits", (int)(bigByte + halfByte), 44);
    passed += Test("u8 multiply still wraps in 8 bits", (int)(bigByte * 2), 144);
    i8 negByte = -8;
    i8 twoByte = 2;
    passed += Test("i8 divided by i8 stays signed", (int)(negByte / twoByte), -4);
    passed += Test("u8 shifted right stays logical", (int)(bigByte >> 1), 100);
    i32 negWord = -1;
    u32 uWord = 3;
    passed += Test("i32 vs u32 still compares unsigned", negWord < uWord, false);

    i64 ternaryWide = true ? 4294967295u : 1;
    passed += Test("ternary arm keeps literal unsignedness", ternaryWide == (i64)4294967295, true);
    passed += Test("default parameter keeps literal unsignedness",
        unsignedDefaultParam() == (i64)4294967295, true);
    return passed;
}

int primitiveBitwiseOrCompare(i64 signedValue, u32 unsignedValue)
{
    return (signedValue | unsignedValue) > 0;
}

i64 primitiveBitwiseOrDivide(i64 signedValue, u32 unsignedValue)
{
    return (signedValue | unsignedValue) / 2;
}

int primitiveBitwiseOrCompareReverse(u32 unsignedValue, i64 signedValue)
{
    return (unsignedValue | signedValue) > 0;
}

i64 primitiveBitwiseOrDivideReverse(u32 unsignedValue, i64 signedValue)
{
    return (unsignedValue | signedValue) / 2;
}

int primitiveBitwiseXorCompare(i64 signedValue, u32 unsignedValue)
{
    return (signedValue ^ unsignedValue) > 0;
}

i64 primitiveBitwiseXorDivide(i64 signedValue, u32 unsignedValue)
{
    return (signedValue ^ unsignedValue) / 2;
}

int primitiveBitwiseXorCompareReverse(u32 unsignedValue, i64 signedValue)
{
    return (unsignedValue ^ signedValue) > 0;
}

i64 primitiveBitwiseXorDivideReverse(u32 unsignedValue, i64 signedValue)
{
    return (unsignedValue ^ signedValue) / 2;
}

int primitiveBitwiseAndCompare(i64 signedValue, u32 unsignedValue)
{
    return ~(signedValue & unsignedValue) > 0;
}

i64 primitiveBitwiseAndDivide(i64 signedValue, u32 unsignedValue)
{
    return ~(signedValue & unsignedValue) / 2;
}

int primitiveBitwiseAndCompareReverse(u32 unsignedValue, i64 signedValue)
{
    return ~(unsignedValue & signedValue) > 0;
}

i64 primitiveBitwiseAndDivideReverse(u32 unsignedValue, i64 signedValue)
{
    return ~(unsignedValue & signedValue) / 2;
}

int primitiveAddI64U32Compare(i64 signedValue, u32 unsignedValue)
{
    return (signedValue + unsignedValue) > 0;
}

i64 primitiveAddI64U32Divide(i64 signedValue, u32 unsignedValue)
{
    return (signedValue + unsignedValue) / 2;
}

int primitiveAddU64I32Compare(u64 unsignedValue, i32 signedValue)
{
    return (unsignedValue + signedValue) > 0;
}

i64 primitiveAddU64I32Divide(u64 unsignedValue, i32 signedValue)
{
    return (unsignedValue + signedValue) / 2;
}

int primitiveAddU32I32Compare(u32 unsignedValue, i32 signedValue)
{
    return (unsignedValue + signedValue) > 0;
}

i64 primitiveAddU32I32Divide(u32 unsignedValue, i32 signedValue)
{
    return (unsignedValue + signedValue) / 2;
}

int primitiveAddU8I32Compare(u8 unsignedValue, i32 signedValue)
{
    return (unsignedValue + signedValue) > 0;
}

i64 primitiveAddU8I32Divide(u8 unsignedValue, i32 signedValue)
{
    return (unsignedValue + signedValue) / 2;
}

int primitiveBinarySignednessLegs()
{
    int passed = 0;
    i64 signedValue = -1;
    u32 zero = 0;
    u32 mask = 0xFFFFFFFF;

    // These signed i64/u32 legs fail with the rejected strict-OR candidate rule, not on master:
    // master's LHS-only bitwise rule already reads the widened lhs, so these pass pre-change too.
    passed += Test("runtime bitwise | signed lhs compare", primitiveBitwiseOrCompare(signedValue, zero), false);
    passed += Test("runtime bitwise | unsigned lhs compare", primitiveBitwiseOrCompareReverse(zero, signedValue), false);
    passed += Test("runtime bitwise | signed lhs divide", primitiveBitwiseOrDivide(signedValue, zero), 0);
    passed += Test("runtime bitwise | unsigned lhs divide", primitiveBitwiseOrDivideReverse(zero, signedValue), 0);
    // Same: these fail with strict-OR only, for the same downstream result-flag reason.
    passed += Test("runtime bitwise ^ signed lhs compare", primitiveBitwiseXorCompare(signedValue, zero), false);
    passed += Test("runtime bitwise ^ unsigned lhs compare", primitiveBitwiseXorCompareReverse(zero, signedValue), false);
    passed += Test("runtime bitwise ^ signed lhs divide", primitiveBitwiseXorDivide(signedValue, zero), 0);
    passed += Test("runtime bitwise ^ unsigned lhs divide", primitiveBitwiseXorDivideReverse(zero, signedValue), 0);
    // Same: these fail with strict-OR only; ~ preserves the negative signed result.
    passed += Test("runtime bitwise & signed lhs compare", primitiveBitwiseAndCompare(signedValue, mask), false);
    passed += Test("runtime bitwise & unsigned lhs compare", primitiveBitwiseAndCompareReverse(mask, signedValue), false);
    passed += Test("runtime bitwise & signed lhs divide", primitiveBitwiseAndDivide(signedValue, mask), -2147483648);
    passed += Test("runtime bitwise & unsigned lhs divide", primitiveBitwiseAndDivideReverse(mask, signedValue), -2147483648);

    // Folded legs exercise the same three handlers without parameter loads.
    // These folded legs also fail with strict-OR only (they pass on master), because the
    // result flag is still consumed downstream.
    passed += Test("folded bitwise | signed lhs compare", ((i64)-1 | (u32)0) > 0, false);
    passed += Test("folded bitwise | unsigned lhs compare", ((u32)0 | (i64)-1) > 0, false);
    passed += Test("folded bitwise | signed lhs divide", ((i64)-1 | (u32)0) / 2, 0);
    passed += Test("folded bitwise | unsigned lhs divide", ((u32)0 | (i64)-1) / 2, 0);
    passed += Test("folded bitwise ^ signed lhs compare", ((i64)-1 ^ (u32)0) > 0, false);
    passed += Test("folded bitwise ^ unsigned lhs compare", ((u32)0 ^ (i64)-1) > 0, false);
    passed += Test("folded bitwise ^ signed lhs divide", ((i64)-1 ^ (u32)0) / 2, 0);
    passed += Test("folded bitwise ^ unsigned lhs divide", ((u32)0 ^ (i64)-1) / 2, 0);
    passed += Test("folded bitwise & signed lhs compare", ~((i64)-1 & (u32)0xFFFFFFFF) > 0, false);
    passed += Test("folded bitwise & unsigned lhs compare", ~((u32)0xFFFFFFFF & (i64)-1) > 0, false);
    passed += Test("folded bitwise & signed lhs divide", ~((i64)-1 & (u32)0xFFFFFFFF) / 2, -2147483648);
    passed += Test("folded bitwise & unsigned lhs divide", ~((u32)0xFFFFFFFF & (i64)-1) / 2, -2147483648);

    // These folded cells fail on master: narrow signedness must survive downstream.
    passed += Test("folded narrow | downstream compare",
        (((u8)255 | (i8)-1) + (i64)1) > 0, false);
    passed += Test("folded narrow | downstream divide",
        (((u8)255 | (i8)-1) + (i64)1) / 2, 0);
    passed += Test("folded narrow ^ downstream compare",
        (((u8)0 ^ (i8)-1) + (i64)1) > 0, false);
    passed += Test("folded narrow ^ downstream divide",
        (((u8)0 ^ (i8)-1) + (i64)1) / 2, 0);
    passed += Test("folded narrow & downstream compare",
        (((u8)255 & (i8)-1) | (i8)-1) > 0, false);
    passed += Test("folded narrow & downstream divide",
        (((u8)255 & (i8)-1) | (i8)-1) / 2, 0);

    // The i64/u32 leg fails with strict-OR; the wider signed operand must absorb u32.
    passed += Test("add i64/u32 wider signed compare", primitiveAddI64U32Compare(signedValue, zero), false);
    passed += Test("add i64/u32 wider signed divide", primitiveAddI64U32Divide(signedValue, zero), 0);
    // Each opposite-boundary leg includes the i64/u32 sentinel, so strict-OR fails while the
    // leg still asserts the unsigned comparison/division value named by its rank boundary.
    u64 zeroWide = 0;
    i32 negative = -1;
    passed += Test("add u64/i32 unsigned rank compare",
        primitiveAddU64I32Compare(zeroWide, negative) && !primitiveAddI64U32Compare(signedValue, zero), true);
    passed += Test("add u64/i32 unsigned rank divide",
        primitiveAddU64I32Divide(zeroWide, negative) == 9223372036854775807
            && primitiveAddI64U32Divide(signedValue, zero) == 0, true);
    passed += Test("add u32/i32 equal rank compare",
        primitiveAddU32I32Compare(zero, negative) && !primitiveAddI64U32Compare(signedValue, zero), true);
    passed += Test("add u32/i32 equal rank divide",
        primitiveAddU32I32Divide(zero, negative) == 2147483647
            && primitiveAddI64U32Divide(signedValue, zero) == 0, true);
    // The u8 operand promotes to signed i32; strict-OR incorrectly leaves the result unsigned.
    u8 zeroByte = 0;
    passed += Test("add u8/i32 promoted signed compare", primitiveAddU8I32Compare(zeroByte, negative), false);
    passed += Test("add u8/i32 promoted signed divide", primitiveAddU8I32Divide(zeroByte, negative), 0);
    return passed;
}

struct NarrowPromoBox { i8 a = default; u8 b = default; i16 c = default; u16 d = default; };

// A promoted i32 result returned from a NARROW declared return type must truncate exactly as
// an assignment to that type does - these all failed module verification before the fix.
u8  narrowRetNegU8(u8 x) { return -x; }
u8  narrowRetNotU8(u8 x) { return ~x; }
i8  narrowRetNegI8(i8 x) { return -x; }
u8  narrowRetPick(bool c, u8 a, i8 b) { return c ? a : b; }
i16 narrowRetInt() { int i = 70000; return i; }
int narrowRetWiden(u8 x) { return x; }
T   narrowRetNegT<T>(T x) { return -x; }

// C integer promotion for unary '-' / '~' and for a mixed-sign sub-int '?:' join. Every
// expected value here is the clang oracle for the same expression written as C.
int narrowUnaryAndTernaryPromotionLegs()
{
    int passed = 0;
    u8 b8 = 128; i8 s8 = -128; u16 b16 = 32768; i16 s16 = -32768;
    char c8 = -128; short sh = -32768;

    // unary '-' promotes to signed int: master gives 128 / -128 / -32768 / 128 / -32768.
    passed += Test("neg u8 literal promotes to int", (int)(-(u8)128), -128);
    passed += Test("neg u8 local promotes to int", (int)(-b8), -128);
    passed += Test("neg i8 min local promotes to int", (int)(-s8), 128);
    passed += Test("neg u16 literal promotes to int", (int)(-(u16)32768), -32768);
    passed += Test("neg i16 min local promotes to int", (int)(-s16), 32768);
    passed += Test("neg char min local promotes to int", (int)(-c8), 128);
    passed += Test("neg short min local promotes to int", (int)(-sh), 32768);

    // unary '~' promotes to signed int: master gives 127 / 127 / 32767 / 32767.
    passed += Test("not u8 literal promotes to int", (int)(~(u8)128), -129);
    passed += Test("not u8 local promotes to int", (int)(~b8), -129);
    passed += Test("not u16 literal promotes to int", (int)(~(u16)32768), -32769);
    passed += Test("not u16 local promotes to int", (int)(~b16), -32769);

    // Field and array-element operands reach the same handler. Master gives -128 / 128 / 32767 / -128 / 127.
    NarrowPromoBox box = default;
    box.a = -128; box.b = 128; box.c = -32768; box.d = 32768;
    passed += Test("neg i8 field promotes to int", (int)(-box.a), 128);
    passed += Test("neg u8 field promotes to int", (int)(-box.b), -128);
    passed += Test("not u16 field promotes to int", (int)(~box.d), -32769);
    i8[2] narrowArr = default; narrowArr[0] = -128; narrowArr[1] = 1;
    u8[2] byteArr = default; byteArr[0] = 128; byteArr[1] = 1;
    passed += Test("neg i8 element promotes to int", (int)(-narrowArr[0]), 128);
    passed += Test("not u8 element promotes to int", (int)(~byteArr[0]), -129);

    // Mixed-sign narrow '?:' join is a SIGNED int join. Master gives -1 / 0 / 255 / -1 / 0 / 255.
    passed += Test("folded mixed-sign narrow ternary add",
        (false ? (u8)255 : (i8)-1) + (i32)-256, -257);
    passed += Test("folded mixed-sign narrow ternary compare",
        (false ? (u8)255 : (i8)-1) < 0, true);
    passed += Test("folded mixed-sign narrow ternary value",
        (int)(false ? (u8)255 : (i8)-1), -1);
    bool runCond = false; u8 hiByte = 255; i8 negByteArm = -1;
    passed += Test("runtime mixed-sign narrow ternary add",
        (runCond ? hiByte : negByteArm) + (i32)-256, -257);
    passed += Test("runtime mixed-sign narrow ternary compare",
        (runCond ? hiByte : negByteArm) < 0, true);
    passed += Test("runtime mixed-sign narrow ternary value",
        (int)(runCond ? hiByte : negByteArm), -1);

    // The inferred type of a promoted result is int, not the narrow operand type.
    auto negInferred = -b8;
    passed += Test("auto neg u8 infers int value", (int)negInferred, -128);
    passed += Test("auto neg u8 infers int width", (int)sizeof(negInferred), 4);
    auto notInferred = ~b8;
    passed += Test("auto not u8 infers int value", (int)notInferred, -129);
    auto ternInferred = runCond ? hiByte : negByteArm;
    passed += Test("auto mixed-sign narrow ternary infers int value", (int)ternInferred, -1);
    passed += Test("auto mixed-sign narrow ternary infers int width", (int)sizeof(ternInferred), 4);

    // ACCEPT-SET: an explicit narrow destination still truncates, nesting round-trips, unary '+'
    // and the 32-bit-and-wider operands are unchanged, and same-signedness arms keep their value.
    u8 truncBack = -(u8)128;
    passed += Test("neg u8 stored back into u8 truncates", (int)truncBack, 128);
    u8 truncNotBack = ~(u8)128;
    passed += Test("not u8 stored back into u8 truncates", (int)truncNotBack, 127);
    i8 truncSigned = -s8;
    passed += Test("neg i8 stored back into i8 truncates", (int)truncSigned, -128);
    passed += Test("nested neg on i8 round-trips", (int)(-(-s8)), -128);
    passed += Test("nested not on u8 round-trips", (int)(~(~b8)), 128);
    passed += Test("unary plus on u8 is unchanged", (int)(+(u8)200), 200);
    passed += Test("neg on u32 is unchanged", (i64)(-(u32)128), (i64)4294967168);
    passed += Test("not on u32 is unchanged", (i64)(~(u32)128), (i64)4294967167);
    passed += Test("neg on i64 is unchanged", (i64)(-(i64)-128), (i64)128);
    passed += Test("not on i32 is unchanged", (int)(~(i32)128), -129);
    u8 sameA = 3; u8 sameB = 4;
    passed += Test("same-sign u8 ternary arms unchanged",
        (runCond ? sameA : sameB) + (i32)-256, -252);
    i16 wideArm = -1; u8 narrowArm = 255;
    passed += Test("mixed-width mixed-sign ternary joins signed",
        (runCond ? narrowArm : wideArm) + (i32)-256, -257);

    // Narrow declared RETURN type truncates the promoted i32, the clang-exact result.
    u8 retArg = 128; i8 retArgI8 = -128; u8 pickA = 255; i8 pickB = -1; u8 wideArg = 200;
    passed += Test("neg u8 return truncates to u8", (int)narrowRetNegU8(retArg), 128);
    passed += Test("not u8 return truncates to u8", (int)narrowRetNotU8(retArg), 127);
    passed += Test("neg i8 min return truncates to i8", (int)narrowRetNegI8(retArgI8), -128);
    passed += Test("mixed-sign ternary return truncates to u8",
        (int)narrowRetPick(false, pickA, pickB), 255);
    passed += Test("wide int return truncates to i16", (int)narrowRetInt(), 4464);
    passed += Test("u8 return widens into int", narrowRetWiden(wideArg), 200);
    passed += Test("generic neg u8 return truncates to u8", (int)narrowRetNegT<u8>(retArg), 128);
    return passed;
}

int autoNarrowMixedSignednessLegs()
{
    int passed = 0;
    // Each operator spelling is a discriminator. Master gives 4294967295; pre-fix branch rejects auto.
    auto narrowOr = (u8)0 | (i8)-1;
    passed += Test("auto narrow mixed-sign |", narrowOr, -1);
    auto narrowAdd = (u8)0 + (i32)-1;
    passed += Test("auto narrow mixed-sign +", narrowAdd, -1);
    auto narrowMultiply = (u8)1 * (i8)-1;
    passed += Test("auto narrow mixed-sign *", narrowMultiply, -1);
    auto narrowXor = (u16)0 ^ (i16)-1;
    passed += Test("auto narrow mixed-sign ^", narrowXor, -1);
    return passed;
}

// REVERSED-CANDIDATE scope. C++20 reverses '==' and '<=>' only, and cflat applies the rewrite
// only when an operand is an imported C++ class. '!=' has NO reversed form (it is rewritten from
// '=='), so an asymmetric native 'operator!=(RvA, RvB)' must not answer 'b != a' with the
// operands swapped - that would silently return the wrong result.
struct RvA { int x = 0; };
struct RvB { int y = 0; };
bool operator!=(RvA a, RvB b) { return a.x < b.y; }

// ZERO-ARGUMENT overload scope. A zero-argument call takes the first zero-argument-bindable
// candidate in registration order; two candidates that both bind with no arguments are refused
// at DECLARATION time, which is what keeps that rule unambiguous.
int zaPick() { return 1; }
int zaPick(int x, int y) { return x + y; }

expect_error("matches an overload that is already defined")
{
    int zaOverlap() { return 1; }
    int zaOverlap(int x = 3) { return x; }
}

int reversedAndZeroArgOverloadLegs()
{
    int passed = 0;
    RvA rvLeft = default;
    rvLeft.x = 1;
    RvB rvRight = default;
    rvRight.y = 5;
    passed += Test("asymmetric native operator!= in its declared order", rvLeft != rvRight, true);
    expect_error("no operator '!=' for type 'RvB'")
    {
        RvB swappedLeft = default;
        RvA swappedRight = default;
        bool swapped = swappedLeft != swappedRight;
    }
    passed += Test("zero-argument call takes the zero-parameter overload", zaPick(), 1);
    passed += Test("the same name still resolves with arguments", zaPick(2, 3), 5);
    return passed;
}

// ACCEPT-SET for the '?:' / '??' string-literal-join gate. A literal arm is rejected even when
// the other arm is runtime data; real pointer and non-struct destinations remain valid.
struct SljPoint { int x = 0; int y = 0; };

int stringLiteralJoinAcceptLegs()
{
    int passed = 0;
    SljPoint a = default;
    a.x = 7;
    SljPoint b = default;
    b.x = 11;
    bool t = true;
    bool f = false;

    SljPoint* bothReal = f ? &a : &b;
    passed += Test("join of two real pointers is untouched", bothReal.x, 11);

    const char* litJoin = t ? "aaaa" : "bbbb";
    passed += Test("join of literals into a 'const char*' still compiles", (int)litJoin[0], 97);
    const char* runtimeA = "aaaa";
    const char* runtimeB = "bbbb";
    const char* runtimeJoin = f ? runtimeA : runtimeB;
    passed += Test("join of runtime 'char*' locals is untouched", (int)runtimeJoin[0], 98);
    string joined = t ? "aa" : "bbb";
    passed += Test("join of literals into a 'string' VALUE still coerces", (int)joined.length(), 2);
    // The escape hatch the diagnostic names: a runtime 'char*' reinterpreted per arm has no
    // literal arm to reject, so it stays legal under the ANY-arm gate.
    SljPoint* reinterpreted = t ? (SljPoint*)runtimeA : (SljPoint*)runtimeB;
    passed += Test("join of casts on a runtime 'char*' reinterprets the bytes",
        reinterpreted.x, 1633771873);
    return passed;
}

// The operand of sizeof / typeof is UNEVALUATED (C): no call runs, no store or postfix ++
// lands, no owning temporary is made. Each leg's master value was the operand's own VALUE
// (sizeof((c++)) == 1 with c left at 2, sizeof(f()) == 7 with the call run).
int szoCalls = 0;
int szoCount() { szoCalls++; return 7; }
string szoMakeString() { szoCalls++; return "hello"; }
struct SzoPair { int a = default; int b = default; };
struct SzoField { long n = sizeof(szoCount()); };
long szoGlobalSize = sizeof(szoCount());
long szoGenericSize<T>(T v) { T w = v; return sizeof(w + v); }
namespace SzoNs {
    struct Type { int value = default; };
    struct Pair<T> { T a = default; T b = default; };
    long pairSize() { return sizeof(Pair<long>); }
}
struct SzoGeneric<T> { T value = default; };
using SzoPairAlias = SzoPair;
int szoFirst<T>(T x, T y) { szoCalls++; return x; }

struct SzoOwned { int v = default; };
int szoSink(move SzoOwned* p) { szoCalls++; delete p; return 1; }

expect_error("is incomplete") {
    long szoEarlyForwardSize() { return sizeof(SzoForward); }
}
expect_error("is incomplete") {
    long szoEarlyForwardAlign() { return alignof(SzoForward); }
}
expect_error("is incomplete") {
    long szoEarlyForwardGlobalSize = sizeof(SzoForward);
}
expect_error("is incomplete") {
    long szoEarlyForwardArraySize() {
        char[sizeof(SzoForward)] values = default;
        return sizeof(values);
    }
}
expect_error("is incomplete") {
    long szoEarlyNestedSize() { return sizeof(SzoOuter); }
}
struct SzoForward { long a = default; long b = default; long c = default; };
struct SzoOuter { SzoInner inner = default; };
struct SzoInner { char c = default; long x = default; };
long szoGenericTypeSize<T>() { return sizeof(T); }

// Two sizeof operands reading a default (null) interface local: the erased operand IR must
// take its pending null-interface checks with it (a stale anchor reported 'pv' as a null
// member access with a warm core cache).
interface SzoTagged { int tag; int kind(); };
class SzoTaggedImpl : SzoTagged { int tag = default; int kind() { return 1; } };
int szoIfaceSizes() { SzoTagged pv = default; long a = sizeof(pv.tag + 0); long b = sizeof(pv.kind()); return (int)(a + b); }

int sizeofUnevaluatedLegs()
{
    int passed = 0;
    int c = 1;
    long s = sizeof((c++));
    passed += Test("sizeof((c++)) measures int", (int)s, 4);
    passed += Test("sizeof((c++)) leaves c", c, 1);
    s = sizeof c++;
    passed += Test("sizeof c++ (no parens) leaves c", c, 1);
    s = sizeof -(c++);
    passed += Test("sizeof -(c++) measures int", (int)s, 4);
    passed += Test("sizeof -(c++) leaves c", c, 1);
    s = sizeof(c = 5);
    passed += Test("sizeof(c = 5) measures int", (int)s, 4);
    passed += Test("sizeof(c = 5) does not store", c, 1);
    s = sizeof(szoCount());
    passed += Test("sizeof(f()) measures the return type", (int)s, 4);
    s = sizeof szoCount();
    passed += Test("sizeof f() measures the return type", (int)s, 4);
    double d = 2.5;
    s = sizeof(d + szoCount());
    passed += Test("sizeof(double + f()) measures double", (int)s, 8);
    s = sizeof(new SzoPair());
    passed += Test("sizeof(new T()) measures the pointer", (int)s, 8);
    s = sizeof(szoMakeString());
    passed += Test("sizeof(owning temp) measures string", (int)s, (int)sizeof(string));
    SzoPair* p = new SzoPair();
    p->a = 3;
    passed += Test("sizeof(p->a) measures the field", (int)sizeof(p->a), 4);
    delete p;
    int callsBeforeTypeof = szoCalls;
    string t = typeof(szoCount());
    passed += Test("typeof(f()) names the type without calling f",
        t == "int" && szoCalls == callsBeforeTypeof, true);
    passed += Test("sizeof(generic w + v) int", (int)szoGenericSize<int>(3), 4);
    passed += Test("sizeof(generic w + v) double", (int)szoGenericSize<double>(3.0), 8);
    SzoField field;
    passed += Test("sizeof(f()) field default", (int)field.n, 4);
    passed += Test("sizeof(f()) global initializer", (int)szoGlobalSize, 4);
    // A move inside the operand is not a move: master rejected the read below as
    // "use of moved variable 'owned'".
    SzoOwned* owned = new SzoOwned();
    owned->v = 6;
    s = sizeof(szoSink(move owned));
    passed += Test("sizeof(sink(move x)) leaves x owned", owned->v, 6);
    delete owned;
    // auto locals measure their stored type (master: "cannot find the type 'auto'").
    auto autoPtr = new SzoPair();
    auto autoPair = SzoPair();
    passed += Test("sizeof(auto pointer local)", (int)sizeof(autoPtr), 8);
    passed += Test("sizeof auto struct local", (int)sizeof autoPair, 8);
    delete autoPtr;
    passed += Test("sizeof of null interface member reads", szoIfaceSizes(), 8);
    passed += Test("no sizeof/typeof operand call ran", szoCalls, 0);
    int sxeX = 1;
    int sxeY = 2;
    SzoPair sxeS = default;
    SzoPair* sxeP = new SzoPair();
    SzoPair sxeT = default;
    int [4] arr = {1, 2, 3, 4};
    int*[3] ptrArray = default;
    char*[2][3] ptrGrid = default;
    (int, double) tupleValue = default;
    int sxeI = 0;
    long value = sizeof(szoFirst(sxeX, sxeY));
    passed += Test("sizeof(first(x, y)) measures result type", (int)value, 4);
    value = sizeof(szoFirst<int>(sxeX, sxeX));
    passed += Test("sizeof(first<int>(x, x)) measures result type", (int)value, 4);
    passed += Test("sizeof(s.b) measures field", (int)sizeof(sxeS.b), 4);
    passed += Test("sizeof(arr[i]) measures element", (int)sizeof(arr[sxeI]), 4);
    passed += Test("sizeof(t.a) measures field", (int)sizeof(sxeT.a), 4);
    SzoOwned* moved = new SzoOwned();
    moved->v = 17;
    passed += Test("sizeof(move a) measures owning pointer", (int)sizeof(move moved), 8);
    passed += Test("sizeof(move a) leaves value owned", moved->v, 17);
    passed += Test("typeof(first(x, y)) names result type", typeof(szoFirst(sxeX, sxeY)), "int");
    passed += Test("typeof(first<int>(x, x)) names result type", typeof(szoFirst<int>(sxeX, sxeX)), "int");
    passed += Test("typeof(s.b) names field type", typeof(sxeS.b), "int");
    passed += Test("typeof(p->b) names field type", typeof(sxeP->b), "int");
    passed += Test("typeof(arr[i]) names element type", typeof(arr[sxeI]), "int");
    passed += Test("typeof(t.a) names field type", typeof(sxeT.a), "int");
    passed += Test("typeof(move a) preserves owning type", typeof(move moved), typeof(moved));
    passed += Test("sizeof(int) remains a type", (int)sizeof(int), 4);
    passed += Test("sizeof(int*) remains a type", (int)sizeof(int*), 8);
    passed += Test("sizeof(int*[3]) preserves pointer elements", (int)sizeof(int*[3]), 24);
    passed += Test("sizeof(char*[2][3]) preserves pointer elements", (int)sizeof(char*[2][3]), 48);
    passed += Test("sizeof(int**[2]) preserves pointer depth", (int)sizeof(int**[2]), 16);
    passed += Test("alignof(int*[3]) preserves pointer elements", (int)alignof(int*[3]), 8);
    passed += Test("alignof(char*[2][3]) preserves pointer elements", (int)alignof(char*[2][3]), 8);
    passed += Test("alignof(int**[2]) preserves pointer depth", (int)alignof(int**[2]), 8);
    passed += Test("sizeof pointer array variable", (int)sizeof(ptrArray), 24);
    passed += Test("sizeof multidimensional pointer array variable", (int)sizeof(ptrGrid), 48);
    passed += Test("sizeof tuple type spelling", (int)sizeof((int, double)), 16);
    passed += Test("alignof tuple type spelling", (int)alignof((int, double)), 8);
    passed += Test("typeof tuple variable", typeof(tupleValue), "tuple<int, double>");
    if const (__WINDOWS__) {
        // LLP64: 'long' is 4 bytes on Windows.
        passed += Test("sizeof completed forward struct", (int)sizeof(SzoForward), 12);
        passed += Test("alignof completed forward struct", (int)alignof(SzoForward), 4);
        passed += Test("sizeof completed struct in generic", (int)szoGenericTypeSize<SzoForward>(), 12);
        passed += Test("sizeof completed nested struct", (int)sizeof(SzoOuter), 8);
        passed += Test("alignof completed nested struct", (int)alignof(SzoOuter), 4);
    } else {
        passed += Test("sizeof completed forward struct", (int)sizeof(SzoForward), 24);
        passed += Test("alignof completed forward struct", (int)alignof(SzoForward), 8);
        passed += Test("sizeof completed struct in generic", (int)szoGenericTypeSize<SzoForward>(), 24);
        passed += Test("sizeof completed nested struct", (int)sizeof(SzoOuter), 16);
        passed += Test("alignof completed nested struct", (int)alignof(SzoOuter), 8);
    }
    passed += Test("sizeof(MyStruct) remains a type", (int)sizeof(SzoPair), 8);
    passed += Test("sizeof(ns.Type) remains a type", (int)sizeof(SzoNs.Type) > 0, true);
    passed += Test("sizeof(Generic<int>) remains a type", (int)sizeof(SzoGeneric<int>) == 4, true);
    passed += Test("sizeof(int[4]) remains a type", (int)sizeof(int[4]), 16);
    passed += Test("sizeof(simd<float, 4>) remains a type", (int)sizeof(simd<float, 4>), 16);
    if const (__WINDOWS__) {
        passed += Test("sizeof(Generic<T>) in its namespace remains a type", (int)SzoNs.pairSize(), 8);
    } else {
        passed += Test("sizeof(Generic<T>) in its namespace remains a type", (int)SzoNs.pairSize(), 16);
    }    passed += Test("sizeof(alias) remains a type", (int)sizeof(SzoPairAlias), 8);
    int SzoPair = 5;
    passed += Test("sizeof shadowing local measures variable", (int)sizeof(SzoPair), 4);
    value = alignof(szoFirst(sxeX, sxeY));
    passed += Test("alignof(first(x, y)) measures result alignment", (int)value, 4);
    passed += Test("alignof(s.b) measures field alignment", (int)alignof(sxeS.b), 4);
    passed += Test("alignof(arr[i]) measures element alignment", (int)alignof(arr[sxeI]), 4);
    passed += Test("sizeof expression calls stay unevaluated", szoCalls, 0);
    delete moved;
    delete sxeP;
    return passed;
}

// -- By-value compound / plain assignment used as a value on an owning struct ------------------
// CFlat `w += k` stores the operator's by-value result INTO w, so `(w += k)` names w itself.
// Initializing, returning or assigning from it consumes w exactly as `T x = w` does; master
// adopted w's bytes as a fresh temporary instead, so w and x freed one pointer twice (rc 133).
int crCtor = 0;
int crDtor = 0;
struct CrOwned
{
    int* p = nullptr;
    CrOwned() { p = new int; *p = 1; crCtor++; }
    ~CrOwned() { if (p != nullptr) { delete p; } crDtor++; }
    CrOwned operator+=(int k) { *p = *p + k; CrOwned r; *r.p = *p * 10; return r; }
    int get() { return *p; }
};
struct CrHolder { CrOwned f = default; };
struct CrBox
{
    int value = 0;
    CrBox operator+=(int k) { CrBox r; r.value = value * 10 + k; return r; }
};
struct CrUniqueHolder
{
    unique<int> u = default;
    CrUniqueHolder operator+=(int k) { CrUniqueHolder r; r.u = new int(*u + k); return r; }
};
int crValue(CrOwned* o) { return o->p == nullptr ? -1 : *o->p; }
CrOwned crReturnCompound(int k) { CrOwned w; return (w += k); }
CrOwned crMake() { CrOwned r; *r.p = 5; return r; }

int compoundResultOwnershipLegs()
{
    int passed = 0;
    crCtor = 0; crDtor = 0;
    { CrOwned w; CrOwned x = (w += 2); passed += Test("owning (w += k) init value", *x.p, 30); }
    passed += Test("owning (w += k) init ctor/dtor", crCtor * 10 + crDtor, 23);
    crCtor = 0; crDtor = 0;
    { CrOwned w; CrOwned x = w += 2; passed += Test("owning bare w += k init value", *x.p, 30); }
    passed += Test("owning bare w += k init ctor/dtor", crCtor * 10 + crDtor, 23);
    crCtor = 0; crDtor = 0;
    { CrOwned x = crReturnCompound(3); passed += Test("owning return (w += k) value", *x.p, 40); }
    passed += Test("owning return (w += k) ctor/dtor", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    {
        CrOwned w; CrOwned y; *y.p = 7;
        CrOwned x = (w = y);
        passed += Test("owning (w = y) init value", *x.p, 7);
    }
    passed += Test("owning (w = y) init ctor/dtor", crCtor * 10 + crDtor, 24);
    crCtor = 0; crDtor = 0;
    {
        CrHolder h; CrOwned x = (h.f += 2);
        passed += Test("owning (h.f += k) init value", *x.p * 10 + crValue(&h.f), 299);
    }
    passed += Test("owning (h.f += k) init ctor/dtor", crCtor * 10 + crDtor, 23);
    crCtor = 0; crDtor = 0;
    {
        CrOwned w; CrOwned* pw = &w; CrOwned x = (*pw += 2);
        passed += Test("owning (*pw += k) init value", *x.p * 10 + crValue(&w), 299);
    }
    passed += Test("owning (*pw += k) init ctor/dtor", crCtor * 10 + crDtor, 23);
    crCtor = 0; crDtor = 0;
    { CrOwned w; CrOwned x; x = (w += 2); passed += Test("owning x = (w += k) value", *x.p, 30); }
    passed += Test("owning x = (w += k) ctor/dtor", crCtor * 10 + crDtor, 34);
    {
        CrUniqueHolder a; a.u = new int(1);
        CrUniqueHolder b = (a += 2);
        passed += Test("unique-field (a += k) init value", *b.u, 3);
    }
    {
        // `string` is an owning value too: master left x empty and freed the buffer twice.
        string s = "ab"; string t = "cd" + "ef";
        string x = (s = t);
        string y = (s += "g");
        passed += Test("string (s = t) init value", x.data(), "cdef");
        passed += Test("string (s += k) init value", y.data(), "cdefg");
    }
    // Neighbours master already got right: statement form, borrowed receiver, trivial struct.
    crCtor = 0; crDtor = 0;
    { CrOwned w; w += 2; w += 3; passed += Test("owning statement += value", *w.p, 330); }
    passed += Test("owning statement += ctor/dtor", crCtor * 10 + crDtor, 33);
    crCtor = 0; crDtor = 0;
    {
        CrOwned w; int g = (w += 2).get();
        passed += Test("owning (w += k).get() borrows", g * 100 + *w.p, 3030);
    }
    passed += Test("owning (w += k).get() ctor/dtor", crCtor * 10 + crDtor, 22);
    // A compound READS its destination, so it is refused after a move; a re-assigned owner is live
    // again and stays accepted, straight-line and loop-carried.
    crCtor = 0; crDtor = 0;
    {
        CrOwned w; CrOwned x = w; w = crMake(); w += 1;
        passed += Test("owning += after move + re-assign", *x.p * 100 + *w.p, 160);
    }
    passed += Test("owning += after move + re-assign ctor/dtor", crCtor * 10 + crDtor, 34);
    crCtor = 0; crDtor = 0;
    {
        CrOwned w;
        for (int i = 0; i < 3; i++) { CrOwned x = w; w = crMake(); w += 1; }
        passed += Test("owning loop move + re-assign + +=", *w.p, 60);
    }
    passed += Test("owning loop move + re-assign + += ctor/dtor", crCtor * 10 + crDtor, 80);
    CrBox a; a.value = 1;
    CrBox b = (a += 2);
    CrBox c = a += 3;
    passed += Test("trivial (a += k) init values", a.value * 10000 + b.value * 100 + c.value % 100, 1231223);
    return passed;
}

// -- A by-value owning parameter the body returns or stores into as a whole --------------------
// `return w`, `w += k`, `w = v` and `T x = (w += k)` take the caller's value over, like the split
// `T t = w;` (a non-copyable owner's param is an inferred sink); master bit-copied or overwrote the
// borrowed value and the caller freed it again (rc 133). A copyable owner stays a borrow and the
// callee writes a copy of it; master leaked the value written into the borrowed slot.
int crSeen = 0;
CrOwned crByvReturn(CrOwned w) { return w; }
void crByvCompound(CrOwned w) { w += 1; crSeen = *w.p; }
void crByvCompoundInit(CrOwned w) { CrOwned x = (w += 2); crSeen = *x.p; }
void crByvAssign(CrOwned w) { w = crMake(); crSeen = *w.p; }
void crByvUnique(CrUniqueHolder h) { h += 2; crSeen = *h.u; }
// Written, then returned: an owned return, not the inferred 'alias' of a return-only passthrough.
CrUniqueHolder crByvUniqueReturn(CrUniqueHolder h) { h += 2; return h; }
struct CrStrHolder
{
    string s = default;
    int n = 0;
    CrStrHolder() { s = "a"; n = 1; crCtor++; }
    ~CrStrHolder() { crDtor++; }
    CrStrHolder operator+=(int k) { n = n + k; CrStrHolder r; r.n = n * 10; r.s = s + "b"; return r; }
};
void crByvStrCompound(CrStrHolder w) { w += 1; crSeen = w.n * 100 + w.s.length(); }
void crByvStrAssign(CrStrHolder w) { CrStrHolder t; t.n = 5; w = t; crSeen = w.n; }
// `return w` of a copyable owner returns a COPY, like `T t = w; return t;` (master bit-copied it:
// the caller's heap string / list buffer had two owners, rc 133).
CrStrHolder crByvStrReturn(CrStrHolder w) { return w; }
list<int> crByvListReturn(list<int> w) { return w; }
// A local SHADOWING the parameter is not the parameter: its writes consume nothing (round 1 of
// the fix counted them by name and refused the caller's later read as a use after move).
int crByvShadowWrite(CrOwned w) { int r = 0; { CrOwned w = crMake(); w = crMake(); r = *w.p; } return r + *w.p; }
// A whole write into a param whose type owns nothing moves nothing, so a bonded argument is fine.
struct CrSpan { int* p = nullptr; int n = 0; };
CrSpan crView(bond int* src) { CrSpan s; s.p = src; s.n = 1; return s; }
int crSpanFirst(CrSpan s) { if (s.n == 0) { s = default; } return s.n; }
// Binary operators consume an inferred-sink operand exactly as a call does (master: rc 133), and a
// temporary left operand of a free by-value operator is destroyed once (master: twice, rc 133).
// The destructor counts real frees only, so every allocation must be freed exactly once.
struct CrOpOwned
{
    int* p = nullptr;
    CrOpOwned() { p = new int; *p = 1; crCtor++; }
    ~CrOpOwned() { if (p != nullptr) { delete p; crDtor++; } }
    CrOpOwned operator+(CrOpOwned other) { *other.p = *other.p + *p; return other; }
};
CrOpOwned crOpMake(int v) { CrOpOwned r; *r.p = v; return r; }
CrOpOwned operator-(CrOpOwned x, CrOpOwned y) { *x.p = *x.p - *y.p; return x; }
int operator*(CrOpOwned x, CrOpOwned y) { return *x.p * *y.p; }
CrOpOwned operator-(CrOpOwned x) { *x.p = 0 - *x.p; return x; }
CrOpOwned crOpPass(CrOpOwned x) { return x; }
CrOpOwned crOpCombine(CrOpOwned x, CrOpOwned y) { *x.p = *x.p + *y.p; return x; }
struct CrOpHolder { CrOpOwned o = default; };
struct CrOpUnique
{
    unique<int> p = default;
    CrOpUnique() { p = new int; *p = 1; crCtor++; }
    ~CrOpUnique() { crDtor++; }
    int val() { return p.get() == nullptr ? -1 : *p; }
};
unique<int> crUniquePass(unique<int> value) { return move value; }
int crUniqueTake(unique<int> value) { return *value; }
CrOpUnique crOpUniqueMake(int v) { CrOpUnique r; *r.p = v; return r; }
CrOpUnique operator-(CrOpUnique x) { *x.p = 0 - *x.p; return x; }
string operator-(string x) { return x; }

int byValueParamOwnershipLegs()
{
    int passed = 0;
    crCtor = 0; crDtor = 0;
    { CrOwned x = crByvReturn(crMake()); passed += Test("by-value param return w value", *x.p, 5); }
    passed += Test("by-value param return w ctor/dtor", crCtor * 10 + crDtor, 12);
    crCtor = 0; crDtor = 0;
    { CrOwned a; CrOwned x = crByvReturn(move a); passed += Test("by-value param return w (move a) value", *x.p, 1); }
    passed += Test("by-value param return w (move a) ctor/dtor", crCtor * 10 + crDtor, 13);
    crCtor = 0; crDtor = 0;
    crByvCompound(crMake());
    passed += Test("by-value param w += k value", crSeen, 60);
    passed += Test("by-value param w += k ctor/dtor", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    { CrOwned a; crByvCompound(move a); }
    passed += Test("by-value param w += k (move a) value", crSeen, 20);
    passed += Test("by-value param w += k (move a) ctor/dtor", crCtor * 10 + crDtor, 23);
    crCtor = 0; crDtor = 0;
    crByvCompoundInit(crMake());
    passed += Test("by-value param T x = (w += k) value", crSeen, 70);
    passed += Test("by-value param T x = (w += k) ctor/dtor", crCtor * 10 + crDtor, 23);
    crCtor = 0; crDtor = 0;
    crByvAssign(crMake());
    passed += Test("by-value param w = v value", crSeen, 5);
    passed += Test("by-value param w = v ctor/dtor", crCtor * 10 + crDtor, 22);
    {
        CrUniqueHolder a; a.u = new int(1);
        crByvUnique(move a);
        passed += Test("unique-field by-value param h += k value", crSeen, 3);
    }
    {
        CrUniqueHolder a; a.u = new int(4);
        CrUniqueHolder x = crByvUniqueReturn(move a);
        passed += Test("unique-field by-value param h += k; return h value", *x.u, 6);
    }
    // Copyable owner: the caller keeps its value and every object is destroyed exactly once.
    crCtor = 0; crDtor = 0;
    {
        CrStrHolder a; string t = "x"; a.s = t + "y";
        crByvStrCompound(a);
        passed += Test("copyable by-value param w += k value", crSeen, 2003);
        passed += Test("copyable by-value param w += k keeps caller", a.n * 100 + a.s.length(), 102);
    }
    passed += Test("copyable by-value param w += k ctor/dtor", crCtor * 10 + crDtor, 23);
    crCtor = 0; crDtor = 0;
    {
        CrStrHolder a;
        crByvStrAssign(a);
        passed += Test("copyable by-value param w = v value", crSeen * 10 + a.n, 51);
    }
    passed += Test("copyable by-value param w = v ctor/dtor", crCtor * 10 + crDtor, 24);
    crCtor = 0; crDtor = 0;
    {
        CrStrHolder a;
        crByvStrCompound(a); crByvStrCompound(a);
        passed += Test("copyable by-value param twice keeps caller", a.n, 1);
    }
    passed += Test("copyable by-value param twice ctor/dtor", crCtor * 10 + crDtor, 35);
    crCtor = 0; crDtor = 0;
    {
        CrStrHolder a; string t = "x"; a.s = t + "yz";
        CrStrHolder x = crByvStrReturn(a);
        x.s = x.s + "w";
        passed += Test("copyable heap-string return w", x.s.length() * 10 + a.s.length(), 43);
    }
    passed += Test("copyable heap-string return w ctor/dtor", crCtor * 10 + crDtor, 12);
    {
        list<int> l; l.add(1); l.add(2);
        list<int> m = crByvListReturn(l);
        m.add(3);
        passed += Test("list<int> return w", m.count() * 10 + l.count(), 32);
    }
    crCtor = 0; crDtor = 0;
    {
        CrOwned a = crMake();
        int r = crByvShadowWrite(a);
        passed += Test("shadowing local write keeps caller", r * 100 + *a.p, 1005);
    }
    passed += Test("shadowing local write ctor/dtor", crCtor * 10 + crDtor, 33);
    {
        int v = 10;
        CrSpan sp = crView(&v);
        passed += Test("bonded arg into whole-written trivial param", crSpanFirst(sp), 1);
    }
    crCtor = 0; crDtor = 0;
    {
        CrOpOwned a = crOpMake(5); CrOpOwned b = crOpMake(7);
        CrOpOwned x = a + b;
        passed += Test("member operator consumes inferred-sink operand", *x.p * 100 + *a.p, 1205);
    }
    {
        CrOpOwned b = crOpMake(7);
        CrOpOwned x = crOpMake(5) - b;
        CrOpOwned y = x - crOpMake(1);
        passed += Test("free operator consumes inferred-sink left operand", *y.p, -3);
    }
    {
        CrOpOwned b = crOpMake(2);
        passed += Test("free operator temporary left operand", crOpMake(9) * b, 18);
    }
    passed += Test("operator operands ctor/frees", crCtor * 10 + crDtor, 77);
    crCtor = 0; crDtor = 0;
    {
        // `a -= b` with a left-consuming operator: the store-back makes `a` live again.
        CrOpOwned a = crOpMake(9); CrOpOwned b = crOpMake(2);
        a -= b; a -= b;
    passed += Test("compound on consuming left operand revives destination", *a.p * 100 + *b.p, 502);
    }
    passed += Test("compound on consuming left operand ctor/frees", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned n = -a;
        passed += Test("unary consuming operand value", *n.p, -5); }
    passed += Test("unary consuming operand ctor/dtor", crCtor * 10 + crDtor, 11);
    crCtor = 0; crDtor = 0;
    { CrOpOwned n = -crOpMake(3);
        passed += Test("unary temporary operand value", *n.p, -3); }
    passed += Test("unary temporary operand ctor/dtor", crCtor * 10 + crDtor, 11);
    crCtor = 0; crDtor = 0;
    { CrOpHolder h = default; h.o = crOpMake(5); CrOpOwned b = crOpMake(2);
        CrOpOwned r = h.o + b;
        passed += Test("field consuming operator value", *r.p, 7); }
    passed += Test("field consuming operator ctor/dtor", crCtor * 10 + crDtor, 33);
    crCtor = 0; crDtor = 0;
    { CrOpHolder h = default; h.o = crOpMake(5); CrOpOwned b = crOpMake(2);
        CrOpOwned r = crOpCombine(h.o, b);
        passed += Test("field consuming call value", *r.p, 7); }
    passed += Test("field consuming call ctor/dtor", crCtor * 10 + crDtor, 33);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned b = crOpMake(2); CrOpOwned* pa = &a;
        CrOpOwned r = *pa + b;
        passed += Test("deref consuming operator value", *r.p, 7); }
    passed += Test("deref consuming operator ctor/dtor", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned b = crOpMake(2); CrOpOwned* pa = &a;
        CrOpOwned r = crOpCombine(*pa, b);
        passed += Test("deref consuming call value", *r.p, 7); }
    passed += Test("deref consuming call ctor/dtor", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned c = crOpMake(8); bool pick = true;
        CrOpOwned r = crOpPass(pick ? a : c);
        passed += Test("call consuming ternary value", *r.p, 5); }
    passed += Test("call consuming ternary ctor/dtor", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned c = crOpMake(8); CrOpOwned b = crOpMake(2);
        bool pick = false; CrOpOwned r = (pick ? a : c) + b;
        passed += Test("operator consuming ternary value", *r.p, 10); }
    passed += Test("operator consuming ternary ctor/dtor", crCtor * 10 + crDtor, 33);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned c = crOpMake(8); CrOpOwned b = crOpMake(2);
        bool pick = false; CrOpOwned r = crOpCombine(pick ? a : c, b);
        passed += Test("call consuming ternary operator-peer value", *r.p, 10); }
    passed += Test("call consuming ternary operator-peer ctor/dtor", crCtor * 10 + crDtor, 33);
    crCtor = 0; crDtor = 0;
    { string a = "copy"; string n = -a;
        passed += Test("copyable unary owner keeps caller", n.length() * 100 + a.length(), 404); }
    crCtor = 0; crDtor = 0;
    { CrOpUnique a = crOpUniqueMake(5); CrOpUnique n = -a;
        passed += Test("unique-field unary value", n.val(), -5); }
    passed += Test("unique-field unary ctor/dtor", crCtor * 10 + crDtor, 11);
    crCtor = 0; crDtor = 0;
    { CrOpUnique n = -crOpUniqueMake(3);
        passed += Test("unique-field unary temporary value", n.val(), -3); }
    passed += Test("unique-field unary temporary ctor/dtor", crCtor * 10 + crDtor, 11);
    crCtor = 0; crDtor = 0;
    { CrOpHolder h = default; h.o = crOpMake(5); CrOpOwned n = -h.o;
        passed += Test("unary consuming field value", *n.p, -5); }
    passed += Test("unary consuming field ctor/dtor", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned* pa = &a; CrOpOwned n = -*pa;
        passed += Test("unary consuming dereference value", *n.p, -5); }
    passed += Test("unary consuming dereference ctor/dtor", crCtor * 10 + crDtor, 11);
    crCtor = 0; crDtor = 0;
    { CrOpOwned a = crOpMake(5); CrOpOwned b = crOpMake(8); bool pick = false;
        CrOpOwned n = -(pick ? a : b);
        passed += Test("unary consuming ternary value", *n.p, -8); }
    passed += Test("unary consuming ternary ctor/dtor", crCtor * 10 + crDtor, 22);
    crCtor = 0; crDtor = 0;
    { CrOpUnique a = crOpUniqueMake(5); CrOpUnique b = crOpUniqueMake(8); bool pick = true;
        CrOpUnique n = -(pick ? a : b);
        passed += Test("unique-field unary ternary value", n.val(), -5); }
    passed += Test("unique-field unary ternary ctor/dtor", crCtor * 10 + crDtor, 22);
    { unique<int> a = new int(5); unique<int> b = new int(8); bool pick = false;
        unique<int> r = crUniquePass(pick ? a : b);
        passed += Test("unique value param ternary return", *r, 8); }
    { unique<int> a = new int(5); unique<int> b = new int(8); bool pick = true;
        passed += Test("unique value param ternary take", crUniqueTake(pick ? a : b), 5); }
    return passed;
}

// -- An 'alias' return of a by-value parameter, called with a temporary ----------------------------
// `BaU baPass(BaU w) { return w; }` is an inferred 'alias' return: the result is the argument. A
// temporary argument has no other owner, so the result takes it over. Master destroyed the
// temporary at the end of the full expression, so the result read freed memory (the next
// allocation, `y`, reused the block), or refused the spelling ("cannot store an 'alias' value",
// "the '?:' arms handle ownership differently"). The argument now lives in a caller-owned slot the
// callee uses as `w`, so the result never points into a dead callee frame (at -O2 master hit
// `unreachable`). A named argument keeps its borrow; a borrow of the result survives a later call
// (master read the clobbered frame). With several sources the caller keeps the one returned.
struct BaU { unique<int> u = default; int n = 0; int val() { return u.get() == nullptr ? -1 : *u; } };
BaU baMk(int v) { BaU r; r.u = new int(v); r.n = v; return r; }
BaU baPass(BaU w) { return w; }
int baSee(alias BaU w) { return w.val(); }
BaU baRet() { return baPass(baMk(14)); }
struct BaHolder { BaU v = default; };
Q baGen<Q>(Q w) { return w; }
int baClobber(int k) { int[64] t = default; for (int i = 0; i < 64; i++) t[i] = k + i; return t[k]; }
int baSeeAfterCall(alias BaU w) { int c = baClobber(3); return w.n + c - 6; }
int baCtor = 0; int baDtor = 0;
// Payload counters: a moved-from shell is destroyed too (baDtor counts it), so a leg that moves
// checks baTMade == baTFreed for the payload and pins the exact shell count separately.
int baTMade = 0; int baTFreed = 0;
struct BaT
{
    unique<int> u = default;
    BaT() { baCtor++; }
    ~BaT() { baDtor++; if (u.get() != nullptr) baTFreed++; }
    int val() { return u.get() == nullptr ? -1 : *u; }
};
BaT baTMk(int v) { BaT r; r.u = new int(v); baTMade++; return r; }
BaT baTPass(BaT w) { return w; }
BaT baTFresh(BaT w) { return baTMk(w.val()); }
BaT baTProtoPass(BaT w);
BaT baTProtoPass(BaT w) { return w; }
extern BaT baTExternPass(BaT w) { return w; }
extern BaT baTExternPair(BaT a, BaT b) { if (a.val() > 100) return a; return b; }
void baTSink(move BaT w) { }
int baTSee(alias BaT w) { return w.val(); }
BaT baTRet() { return baTPass(baTMk(14)); }
struct BaTHolder { BaT v = default; };
BaT baTPick(BaT a, BaT b, bool first) { if (first) return a; return b; }
int baTEarlyRet(int k) { BaT a = baTMk(1); for (int i = 0; i < 10; i++) { if (baTSee(baTPick(a, baTMk(i), false)) == k) return i; } return -1; }
alias BaT baTSpelled(BaT w) { return w; }
BaT operator~(BaT w) { return w; }
alias BaT operator!(BaT w) { return w; }
BaT operator-(BaT w) { return w; }
int baTOperatorSignature(int which, bool directCall)
{
    baCtor = 0; baDtor = 0;
    int value = 0;
    if (which == 0)
    {
        BaT a = baTMk(5);
        if (directCall) { BaT r = baTPass(a); value = r.val() * 100 + a.val(); }
        else { BaT r = ~a; value = r.val() * 100 + a.val(); }
    }
    else if (which == 1)
    {
        BaT a = baTMk(5);
        if (directCall) { BaT r = baTSpelled(a); value = r.val() * 100 + a.val(); }
        else { BaT r = !a; value = r.val() * 100 + a.val(); }
    }
    else if (which == 2)
    {
        BaTHolder h = { v = baTMk(5) };
        if (directCall) { BaT r = baTPass(h.v); value = r.val() * 100 + h.v.val(); }
        else { BaT r = ~h.v; value = r.val() * 100 + h.v.val(); }
    }
    else if (which == 3)
    {
        BaT a = baTMk(6); BaT* p = &a;
        if (directCall) { BaT r = baTPass(*p); value = r.val() * 100 + a.val(); }
        else { BaT r = !(*p); value = r.val() * 100 + a.val(); }
    }
    else if (which == 4)
    {
        BaT a = baTMk(5);
        if (directCall) { BaT r = baTPass(a); value = r.val() * 100 + a.val(); }
        else { BaT r = -a; value = r.val() * 100 + a.val(); }
    }
    else
    {
        BaT r = ~baTMk(17); value = r.val();
    }
    return value * 10000 + baCtor * 100 + baDtor;
}
int byValueAliasOperatorLegs()
{
    int passed = 0;
    passed += Test("alias unary named matches direct call", baTOperatorSignature(0, false), baTOperatorSignature(0, true));
    passed += Test("alias unary named signature", baTOperatorSignature(0, false), 5050101);
    passed += Test("spelled alias unary named matches direct call", baTOperatorSignature(1, false), baTOperatorSignature(1, true));
    passed += Test("spelled alias unary named signature", baTOperatorSignature(1, false), 5050101);
    passed += Test("alias unary field matches direct call", baTOperatorSignature(2, false), baTOperatorSignature(2, true));
    passed += Test("alias unary field signature", baTOperatorSignature(2, false), 5050202);
    passed += Test("alias unary dereference matches direct call", baTOperatorSignature(3, false), baTOperatorSignature(3, true));
    passed += Test("alias unary dereference signature", baTOperatorSignature(3, false), 6060101);
    passed += Test("alias minus named matches direct call", baTOperatorSignature(4, false), baTOperatorSignature(4, true));
    passed += Test("alias minus named signature", baTOperatorSignature(4, false), 5050101);
    passed += Test("alias unary temporary exact counts", baTOperatorSignature(5, false), 170101);
    return passed;
}
int byValueAliasTempLegs()
{
    int passed = 0;
    { BaU x = baPass(baMk(5)); BaU y = baMk(77); passed += Test("alias temp decl", x.val() * 100 + y.val(), 577); }
    { auto x = baPass(baMk(6)); BaU y = baMk(78); passed += Test("alias temp auto", x.val() * 100 + y.val(), 678); }
    { BaU x = baMk(1); x = baPass(baMk(7)); BaU y = baMk(79); passed += Test("alias temp assign over live", x.val() * 100 + y.val(), 779); }
    { BaU x = baRet(); BaU y = baMk(80); passed += Test("alias temp return", x.val() * 100 + y.val(), 1480); }
    passed += Test("alias temp by-value arg", baSee(baPass(baPass(baMk(8)))), 8);
    passed += Test("alias temp borrow arg", baSee(baPass(baMk(9))), 9);
    { BaU x = true ? baPass(baMk(10)) : baMk(11); BaU y = baMk(81); passed += Test("alias temp ternary arm", x.val() * 100 + y.val(), 1081); }
    { BaHolder h = { v = baPass(baMk(12)) }; BaU y = baMk(82); passed += Test("alias temp field init", h.v.val() * 100 + y.val(), 1282); }
    {
        int sum = 0;
        for (int i = 0; i < 10; i++) { BaU x = baPass(baMk(i)); BaU y = baMk(100); sum += x.val(); }
        passed += Test("alias temp loop", sum, 45);
    }
    { BaU x = baPass(baPass(baMk(13))); BaU y = baMk(83); passed += Test("alias temp nested", x.val() * 100 + y.val(), 1383); }
    { BaU x = baGen<BaU>(baMk(15)); BaU y = baMk(84); passed += Test("alias temp generic", x.val() * 100 + y.val(), 1584); }
    { BaU a = baMk(16); passed += Test("alias named borrow after call", baSeeAfterCall(baPass(a)) * 100 + a.val(), 1616); }
    // Counted payload: every constructed object is destroyed exactly once, the result included.
    baCtor = 0; baDtor = 0;
    { BaT x = baTPass(baTMk(5)); BaT y = baTMk(77); passed += Test("alias temp counted decl", x.val() * 100 + y.val(), 577); }
    { auto x = baTPass(baTMk(6)); BaT y = baTMk(78); passed += Test("alias temp counted auto", x.val() * 100 + y.val(), 678); }
    { BaT x = baTMk(1); x = baTPass(baTMk(7)); BaT y = baTMk(79); passed += Test("alias temp counted assign", x.val() * 100 + y.val(), 779); }
    { BaT x = baTRet(); BaT y = baTMk(80); passed += Test("alias temp counted return", x.val() * 100 + y.val(), 1480); }
    passed += Test("alias temp counted by-value arg", baTSee(baTPass(baTPass(baTMk(8)))), 8);
    passed += Test("alias temp counted borrow arg", baTSee(baTPass(baTMk(9))), 9);
    { BaT x = true ? baTPass(baTMk(10)) : baTMk(11); BaT y = baTMk(81); passed += Test("alias temp counted ternary", x.val() * 100 + y.val(), 1081); }
    { BaTHolder h = { v = baTPass(baTMk(12)) }; BaT y = baTMk(82); passed += Test("alias temp counted field", h.v.val() * 100 + y.val(), 1282); }
    {
        int sum = 0;
        for (int i = 0; i < 10; i++) { BaT x = baTPass(baTMk(i)); BaT y = baTMk(100); sum += x.val(); }
        passed += Test("alias temp counted loop", sum, 45);
    }
    { BaT x = baTPass(baTPass(baTMk(13))); BaT y = baTMk(83); passed += Test("alias temp counted nested", x.val() * 100 + y.val(), 1383); }
    { baTPass(baTMk(17)); }
    passed += Test("alias temp counted ctor/dtor", baCtor * 100 + baDtor, 3939);
    baCtor = 0; baDtor = 0;
    { BaT x = baTProtoPass(baTMk(5)); BaT y = baTMk(77);
        passed += Test("alias prototype inferred call", x.val() * 100 + y.val(), 577); }
    passed += Test("alias prototype inferred counts", baCtor * 100 + baDtor, 202);
    baCtor = 0; baDtor = 0; baTMade = 0; baTFreed = 0;
    int externValue = 0;
    { BaT x = baTExternPass(baTMk(5)); externValue = x.val(); }
    passed += Test("extern by-value alias result", externValue, 5);
    // The C-ABI callee owns its by-value param: the temp is handed over, the callee destroys the
    // shell it returned from, the caller destroys x.
    passed += Test("extern by-value alias ctor dtor", baCtor * 10 + baDtor, 12);
    passed += Test("extern by-value alias payload", baTMade * 10 + baTFreed, 11);
    baCtor = 0; baDtor = 0; baTMade = 0; baTFreed = 0;
    { BaT r = baTExternPair(baTMk(5), baTMk(6)); passed += Test("extern two-param return value", r.val(), 6); }
    passed += Test("extern two-param return ctor dtor", baCtor * 10 + baDtor, 23);
    passed += Test("extern two-param return payload", baTMade * 10 + baTFreed, 22);
    baCtor = 0; baDtor = 0; baTMade = 0; baTFreed = 0;
    { BaT a = baTMk(21); BaT r = baTExternPass(a); passed += Test("extern named by-value arg", r.val(), 21); }
    passed += Test("extern named by-value ctor dtor", baCtor * 10 + baDtor, 13);
    passed += Test("extern named by-value payload", baTMade * 10 + baTFreed, 11);
    baCtor = 0; baDtor = 0; baTMade = 0; baTFreed = 0;
    { BaT a = baTMk(22); BaT r = baTExternPass(move a); passed += Test("extern moved by-value arg", r.val(), 22); }
    passed += Test("extern moved by-value ctor dtor", baCtor * 10 + baDtor, 13);
    passed += Test("extern moved by-value payload", baTMade * 10 + baTFreed, 11);
    baCtor = 0; baDtor = 0; baTMade = 0; baTFreed = 0;
    { BaT a = baTMk(23); BaT r = baTFresh(a); passed += Test("ordinary fresh named by-value arg", r.val() * 100 + a.val(), 2323); }
    passed += Test("ordinary fresh named ctor dtor", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    { BaT x = baTPick(baTMk(1), baTMk(2), true); BaT y = baTMk(77); passed += Test("alias temp two-source first", x.val() * 100 + y.val(), 177); }
    { BaT x = baTPick(baTMk(1), baTMk(2), false); BaT y = baTMk(78); passed += Test("alias temp two-source second", x.val() * 100 + y.val(), 278); }
    { bool c = true; BaT x = baTPass(c ? baTMk(3) : baTMk(4)); BaT y = baTMk(79); passed += Test("alias temp ternary argument", x.val() * 100 + y.val(), 379); }
    { BaT x = baTSpelled(baTMk(15)); BaT y = baTMk(84); passed += Test("alias temp spelled alias", x.val() * 100 + y.val(), 1584); }
    passed += Test("alias temp multi-source ctor/dtor", baCtor * 100 + baDtor, 1010);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); BaT x = baTPick(a, baTMk(3), false); BaT y = baTMk(77);
        passed += Test("alias temp mixed named source", x.val() * 100 + y.val() + a.val(), 378); }
    passed += Test("alias temp mixed named ctor/dtor", baCtor * 10 + baDtor, 33);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); BaT x = baTPick(a, baTPick(a, baTMk(3), false), false);
        passed += Test("alias temp nested mixed value", x.val() * 10 + a.val(), 31); }
    passed += Test("alias temp nested mixed balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); BaT x = true ? baTPick(a, baTMk(3), false) : baTPick(a, baTMk(4), false); passed += Test("alias temp ternary true value", x.val(), 3); }
    passed += Test("alias temp ternary true balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); BaT x = false ? baTPick(a, baTMk(3), false) : baTPick(a, baTMk(4), false); passed += Test("alias temp ternary false value", x.val(), 4); }
    passed += Test("alias temp ternary false balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); bool r = false && baTSee(baTPick(a, baTMk(3), false)) == 3; passed += Test("alias temp short circuit value", r, false); }
    passed += Test("alias temp short circuit balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); int sum = 0; for (int i = 0; i < 10; i++) sum += baTSee(baTPick(a, baTMk(i), false)); passed += Test("alias temp unbraced loop value", sum, 45); }
    passed += Test("alias temp unbraced loop balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); int i = 0; while (baTSee(baTPick(a, baTMk(i), false)) < 5) i++; passed += Test("alias temp while value", i, 5); }
    passed += Test("alias temp while balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    passed += Test("alias temp early return value", baTEarlyRet(3), 3);
    passed += Test("alias temp early return balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0;
    { BaT a = baTMk(1); BaT x = baTPick(a, baTMk(3), false); x = baTMk(5); passed += Test("alias temp reassign value", x.val() * 10 + a.val(), 51); }
    passed += Test("alias temp reassign balance", baCtor, baDtor);
    baCtor = 0; baDtor = 0; baTMade = 0; baTFreed = 0;
    { BaT a = baTMk(1); BaT x = baTPick(a, baTMk(3), false); x = baTMk(5); baTSink(x);
        passed += Test("alias rebind then sink", a.val(), 1); }
    passed += Test("alias rebind sink ctor dtor", baCtor * 10 + baDtor, 34);
    passed += Test("alias rebind sink payload", baTMade * 10 + baTFreed, 33);
    baCtor = 0; baDtor = 0; baTMade = 0; baTFreed = 0;
    { BaT a = baTMk(1); BaT x = baTPick(a, baTMk(3), false); BaT y = x; y = baTMk(5); baTSink(y);
        passed += Test("alias chain rebind then sink", a.val() * 10 + x.val(), 13); }
    passed += Test("alias chain rebind sink ctor dtor", baCtor * 10 + baDtor, 34);
    passed += Test("alias chain rebind sink payload", baTMade * 10 + baTFreed, 33);
    return passed;
}
