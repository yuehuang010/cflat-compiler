import "test_helper.cb";
import "list.cb";
import "string.cb";
import "dictionary.cb";

// ── Named functions used throughout ──────────────────────────────────────────

int add(int a, int b)     { return a + b; }
int sub(int a, int b)     { return a - b; }
int mul(int a, int b)     { return a * b; }
int doubleIt(int x)       { return x * 2; }
int square(int x)         { return x * x; }
int negate(int x)         { return -x; }
int clamp100(int x)       { return x > 100 ? 100 : (x < 0 ? 0 : x); }
bool isEven(int x)        { return x % 2 == 0; }
void doNothing()          { }

// ── Higher-order named helpers ────────────────────────────────────────────────

int apply(Lambda<int(int, int)> f, int a, int b) { return f(a, b); }
int transform(Lambda<int(int)> f, int x)         { return f(x); }
bool applyPred(Lambda<bool(int)> f, int x)       { return f(x); }
void callVoid(Lambda<void()> f)                   { f(); }

// Reduce: fold an array with a binary function
int reduce(Lambda<int(int, int)> f, int* arr, int len, int init)
{
    int acc = init;
    for (int i = 0; i < len; i++)
        acc = f(acc, arr[i]);
    return acc;
}

// Map-and-sum: apply unary f to each element then sum
int mapSum(Lambda<int(int)> f, int* arr, int len)
{
    int total = 0;
    for (int i = 0; i < len; i++)
        total = total + f(arr[i]);
    return total;
}

// Apply f n times to x
int applyN(Lambda<int(int)> f, int x, int n)
{
    int v = x;
    for (int i = 0; i < n; i++)
        v = f(v);
    return v;
}

// Count elements satisfying predicate
int countIf(Lambda<bool(int)> pred, int* arr, int len)
{
    int count = 0;
    for (int i = 0; i < len; i++)
        if (pred(arr[i])) count++;
    return count;
}

// ─────────────────────────────────────────────────────────────────────────────
// FUNCTION POINTER TESTS
// ─────────────────────────────────────────────────────────────────────────────

bool testExplicitFunctionPointer()
{
    bool result = true;

    Lambda<int(int, int)> f = add;
    result &= Test("explicit add",    f(3, 4),  7);

    f = mul;
    result &= Test("reassign to mul", f(3, 4), 12);

    f = sub;
    result &= Test("reassign to sub", f(10, 3), 7);

    Lambda<int(int)> g = doubleIt;
    result &= Test("unary funcptr",          g(6),  12);

    g = square;
    result &= Test("unary reassign square",  g(5),  25);

    g = negate;
    result &= Test("negate funcptr", g(7), -7);

    Lambda<bool(int)> pred = isEven;
    result &= Test("bool funcptr even", pred(4), true);
    result &= Test("bool funcptr odd",  pred(7), false);

    return result;
}

bool testBareFunctionPointer()
{
    bool result = true;

    function f = add;
    result &= Test("bare add",     f(10, 5), 15);

    function g = doubleIt;
    result &= Test("bare doubleIt", g(9),    18);

    return result;
}

bool testFunctionPointerAsArgument()
{
    bool result = true;

    result &= Test("pass add",           apply(add,     6, 7), 13);
    result &= Test("pass mul",           apply(mul,     6, 7), 42);
    result &= Test("pass sub",           apply(sub,    10, 4),  6);
    result &= Test("transform doubleIt", transform(doubleIt, 7), 14);
    result &= Test("transform square",   transform(square,   5), 25);
    result &= Test("predicate even",     applyPred(isEven, 8), true);
    result &= Test("predicate odd",      applyPred(isEven, 9), false);

    return result;
}

bool testFunctionPointerInLoop()
{
    bool result = true;

    int* vals = new int[5];
    vals[0] = 1; vals[1] = 2; vals[2] = 3; vals[3] = 4; vals[4] = 5;
    int n5 = 5; int n1 = 1; int n0 = 0; int n7 = 7;

    // reduce with add -> sum 1..5 = 15
    result &= Test("reduce add",       reduce(add, vals, n5, n0), 15);
    // reduce with mul -> product 1..5 = 120
    result &= Test("reduce mul",       reduce(mul, vals, n5, n1), 120);
    // mapSum doubleIt -> 2+4+6+8+10 = 30
    result &= Test("mapSum double",    mapSum(doubleIt, vals, n5), 30);
    // mapSum square -> 1+4+9+16+25 = 55
    result &= Test("mapSum square",    mapSum(square,   vals, n5), 55);
    // applyN doubleIt 3 times on 1 -> 1*2*2*2 = 8
    int n3 = 3;
    result &= Test("applyN 3x double", applyN(doubleIt, n1, n3), 8);
    // applyN 0 times -> identity
    result &= Test("applyN 0x",        applyN(doubleIt, n7, n0), 7);

    delete vals;
    return result;
}

bool testFunctionPointerCountIf()
{
    bool result = true;

    int* vals = new int[6];
    vals[0] = 1; vals[1] = 2; vals[2] = 3; vals[3] = 4; vals[4] = 5; vals[5] = 6;
    int n6 = 6;

    result &= Test("countIf even", countIf(isEven, vals, n6), 3);

    delete vals;
    return result;
}

bool testVoidFunctionPointer()
{
    bool result = true;

    Lambda<void()> f = doNothing;
    callVoid(f);
    callVoid(doNothing);
    result &= Test("void funcptr", 1, 1);

    return result;
}

bool testFunctionPointerClamp()
{
    bool result = true;

    Lambda<int(int)> f = clamp100;
    result &= Test("clamp mid",  f(50),   50);
    result &= Test("clamp high", f(200), 100);
    result &= Test("clamp low", f(-5), 0);

    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// LAMBDA TESTS
// ─────────────────────────────────────────────────────────────────────────────

bool testLambdaBasic()
{
    bool result = true;

    Lambda<int(int, int)> addL = (int a, int b) => { return a + b; };
    result &= Test("lambda add",   addL(3, 4),  7);
    result &= Test("lambda add 0", addL(0, 0),  0);

    Lambda<int(int, int)> mulL = (int a, int b) => { return a * b; };
    result &= Test("lambda mul",   mulL(3, 4), 12);
    result &= Test("lambda mul 7", mulL(7, 7), 49);

    Lambda<int()> getK = () => { return 42; };
    result &= Test("zero-param lambda", getK(), 42);

    return result;
}

bool testLambdaControlFlow()
{
    bool result = true;

    // Lambda with if/else
    Lambda<int(int, int)> maxL = (int a, int b) => {
        if (a > b) return a;
        return b;
    };
    result &= Test("lambda max(3,7)", maxL(3, 7), 7);
    result &= Test("lambda max(9,2)", maxL(9, 2), 9);
    result &= Test("lambda max(5,5)", maxL(5, 5), 5);

    // Lambda with multi-branch if/else
    Lambda<int(int)> sign = (int x) => {
        if (x > 0) return 1;
        if (x < 0) return -1;
        return 0;
    };
    result &= Test("sign positive", sign(42),  1);
    result &= Test("sign negative", sign(-7), -1);
    result &= Test("sign zero",     sign(0),   0);

    return result;
}

bool testLambdaLocalVars()
{
    bool result = true;

    // Lambda that uses local variables in its body
    Lambda<int(int, int)> hypoSq = (int a, int b) => {
        int aa = a * a;
        int bb = b * b;
        return aa + bb;
    };
    result &= Test("hypoSq 3,4",   hypoSq(3, 4),   25);
    result &= Test("hypoSq 5,12",  hypoSq(5, 12), 169);

    // Lambda with a loop body
    Lambda<int(int)> sumTo = (int n) => {
        int s = 0;
        for (int i = 1; i <= n; i++)
            s = s + i;
        return s;
    };
    result &= Test("sumTo 5",  sumTo(5),   15);
    result &= Test("sumTo 10", sumTo(10),  55);

    return result;
}

bool testLambdaCallsNamedFunction()
{
    bool result = true;

    // Lambda body calling regular functions
    Lambda<int(int)> doubleSq = (int x) => { return square(doubleIt(x)); };
    result &= Test("doubleSq 3", doubleSq(3),  36);   // square(6)=36
    result &= Test("doubleSq 5", doubleSq(5), 100);   // square(10)=100

    // isEven(square(x)): even input -> even square; odd input -> odd square
    Lambda<bool(int)> evenSquare = (int x) => { return isEven(square(x)); };
    result &= Test("evenSquare even",  evenSquare(4), true);   // square(4)=16, even
    result &= Test("evenSquare odd",   evenSquare(3), false);  // square(3)=9, odd

    return result;
}

bool testLambdaBoolReturn()
{
    bool result = true;

    Lambda<bool(int)> gt10  = (int x) => { return x > 10; };
    Lambda<bool(int)> ltNeg = (int x) => { return x < 0; };

    result &= Test("gt10 true",   gt10(15),   true);
    result &= Test("gt10 false",  gt10(5),    false);
    result &= Test("ltNeg true", ltNeg(-1), true);
    result &= Test("ltNeg false", ltNeg(0), false);

    return result;
}

bool testLambdaReassignment()
{
    bool result = true;

    Lambda<int(int)> f = (int x) => { return x + 1; };
    result &= Test("lambda f=x+1",    f(5),  6);

    // Reassign to a different lambda
    f = (int x) => { return x * 3; };
    result &= Test("lambda f=x*3",    f(5), 15);

    // Reassign to a named function
    f = doubleIt;
    result &= Test("lambda f=doubleIt", f(5), 10);

    // Reassign back to another lambda
    f = (int x) => { return x - 2; };
    result &= Test("lambda f=x-2",    f(5),  3);

    return result;
}

bool testLambdaAsArgument()
{
    bool result = true;

    result &= Test("lambda arg add",    apply((int a, int b) => { return a + b; }, 5, 6),  11);
    result &= Test("lambda arg mul",    apply((int a, int b) => { return a * b; }, 5, 6),  30);
    result &= Test("lambda arg sub",    apply((int a, int b) => { return a - b; }, 9, 4),   5);
    result &= Test("lambda unary arg",  transform((int x) => { return x + 10; }, 7),       17);
    result &= Test("lambda square arg", transform((int x) => { return x * x; }, 6),        36);
    result &= Test("lambda pred even",  applyPred((int x) => { return x % 2 == 0; }, 8), true);
    result &= Test("lambda pred odd",   applyPred((int x) => { return x % 2 == 0; }, 7), false);

    return result;
}

bool testLambdaInHigherOrder()
{
    bool result = true;

    int* vals = new int[5];
    vals[0] = 1; vals[1] = 2; vals[2] = 3; vals[3] = 4; vals[4] = 5;
    int n5 = 5; int n0 = 0; int n1 = 1; int n3 = 3; int n4 = 4;

    // reduce with lambdas
    result &= Test("reduce lambda add",  reduce((int a, int b) => { return a + b; }, vals, n5, n0), 15);
    result &= Test("reduce lambda max",  reduce((int a, int b) => { return a > b ? a : b; }, vals, n5, n0), 5);

    // mapSum with lambda
    result &= Test("mapSum +1", mapSum((int x) => { return x + 1; }, vals, n5), 20); // 2+3+4+5+6
    result &= Test("mapSum sq", mapSum((int x) => { return x * x; }, vals, n5), 55); // 1+4+9+16+25

    // applyN with lambda
    result &= Test("applyN +2 x3", applyN((int x) => { return x + 2; }, n0, n3),  6); // 0->2->4->6
    result &= Test("applyN *2 x4", applyN((int x) => { return x * 2; }, n1, n4), 16); // 1->2->4->8->16

    // countIf with lambda
    result &= Test("countIf >3", countIf((int x) => { return x > 3; }, vals, n5), 2);
    result &= Test("countIf <3", countIf((int x) => { return x < 3; }, vals, n5), 2);

    delete vals;

    return result;
}

bool testLambdaThreeParam()
{
    bool result = true;

    // Lambda with 3 parameters
    Lambda<int(int, int, int)> fmaL = (int a, int b, int c) => { return a * b + c; };
    result &= Test("fma 2*3+4", fmaL(2, 3, 4),  10);
    result &= Test("fma 5*5+1", fmaL(5, 5, 1),  26);
    result &= Test("fma 0*9+7", fmaL(0, 9, 7),   7);

    Lambda<int(int, int, int)> clampL = (int v, int lo, int hi) => {
        if (v < lo) return lo;
        if (v > hi) return hi;
        return v;
    };
    result &= Test("clampL mid",  clampL(5,  0, 10),  5);
    result &= Test("clampL low", clampL(-3, 0, 10), 0);
    result &= Test("clampL high", clampL(15, 0, 10), 10);

    return result;
}

bool testVoidLambda()
{
    bool result = true;

    Lambda<void()> noopLambda = () => { };
    callVoid(noopLambda);
    callVoid(() => { doNothing(); });
    result &= Test("void lambda", 1, 1);

    return result;
}

// ── Returning a lambda LITERAL directly from a function ───────────────────────
// Regression: `return () => {...};` once failed module verification ("ret i32 in
// void function") because the return handler did not thread the function's
// declared Lambda<> return type into the lambda's expected type. It must also
// move the closure env to the caller (not free it as a returning temp).

Lambda<int()> makeConst()           { return () => { return 7; }; }
Lambda<int(int)> makeAdder(int n)   { return (int x) => { return x + n; }; }
Lambda<int()> makeLen(string s)     { return () => { return s.length(); }; }

bool testReturnLambdaLiteral()
{
    bool result = true;

    Lambda<int()> k = makeConst();
    result &= Test("return lambda const", k(), 7);

    Lambda<int(int)> add5 = makeAdder(5);
    result &= Test("return lambda capture int", add5(10), 15);

    Lambda<int()> len = makeLen("hello");
    result &= Test("return lambda capture string", len(), 5);

    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// LAMBDA CAPTURE TESTS
// ─────────────────────────────────────────────────────────────────────────────

struct Counter {
    int value = 0;
};

struct Stats {
    float min   = 0.0f;
    float max   = 0.0f;
    int   count = 0;
};

interface ITransform {
    int apply(int x);
};

class Multiplier : ITransform {
    int factor = 1;
    int apply(int x) { return x * factor; }
};

class Adder : ITransform {
    int offset = 0;
    int apply(int x) { return x + offset; }
};

bool testCapturePrimitives()
{
    bool result = true;

    // int - value copy; outer mutation does not affect captured snapshot
    {
        int x = 10;
        Lambda<int()> getX = () => { return x; };
        result &= Test("int capture",        getX(), 10);
        x = 99;
        result &= Test("int capture stable", getX(), 10);
    }

    // float - value copy
    {
        float factor = 2.5f;
        Lambda<float(float)> scale = (float v) => { return v * factor; };
        result &= Test("float capture",        scale(4.0f), 10.0f);
        factor = 999.0f;
        result &= Test("float capture stable", scale(4.0f), 10.0f);
    }

    // bool - value copy
    {
        bool enabled = true;
        Lambda<bool()> check = () => { return enabled; };
        result &= Test("bool capture", check(), true);
        enabled = false;
        result &= Test("bool capture stable", check(), true);
    }

    // i64 - value copy
    {
        i64 big = 4000000000;
        Lambda<i64()> getBig = () => { return big; };
        result &= Test("i64 capture",        getBig(), 4000000000);
        big = 0;
        result &= Test("i64 capture stable", getBig(), 4000000000);
    }

    // char* - pointer copy; both sides read the same bytes
    {
        char* msg = "hello";
        Lambda<int()> getLen = () => { return strlen(msg); };
        result &= Test("char* capture", getLen(), 5);
    }

    // int* - pointer copy; writes through shared pointer are visible
    {
        int* p = new int;
        *p = 42;
        Lambda<int()> read = () => { return *p; };
        result &= Test("int* initial",  read(), 42);
        *p = 77;
        result &= Test("int* mutation", read(), 77);
        delete p;
    }

    return result;
}

bool testCaptureString()
{
    bool result = true;

    // string - value copy taken at capture time; outer reassignment invisible
    {
        string label = "world";
        Lambda<int()> getLen = () => { return label.length(); };
        result &= Test("string capture len",    getLen(), 5);
        label = "hi";
        result &= Test("string capture stable", getLen(), 5);
    }

    // string equality check inside lambda
    {
        string greeting = "hello";
        Lambda<bool(string)> matches = (string s) => { return greeting == s; };
        result &= Test("string eq match",    matches("hello"), true);
        result &= Test("string eq no-match", matches("world"), false);
    }

    // string data() access inside lambda
    {
        string word = "abc";
        Lambda<char*()> getPtr = () => { return word.data(); };
        char* ptr = getPtr();
        result &= Test("string data() non-null", ptr != nullptr, true);
        result &= Test("string data() len",      strlen(ptr),    3);
    }

    return result;
}

// A lambda's by-value capture of an OWNING value type lives in the closure env, which owns it
// and frees it exactly once through its cleanup fn. The body's unpacked local therefore only
// BORROWS that buffer, so `return <capture>` must hand the caller an INDEPENDENT copy. Before
// the fix the local carried the env's OWNED bit and was returned raw: the caller and the env
// both freed one buffer (rc 133 after printing the right text), and where the env died first
// the caller read freed memory (the empty-string legs below).
string capturedThroughFrame(string p)
{
    Lambda<string()> g = () => p;
    return g();      // g (and its env) is destructed on the way out - the result must survive
}

// The same borrow reached through a FIELD of a captured owning struct.
class CapFieldBox { string s = default; ~CapFieldBox() { } };
Lambda<int()> globalOwningValueCapture = default;

int storeGlobalOwningValueCapture(int seed)
{
    string s = seed.toString();
    globalOwningValueCapture = () => { return s.length(); };
    return globalOwningValueCapture();
}

int storeStaticOwningValueCapture(int seed)
{
    string s = seed.toString();
    static Lambda<int()> local = default;
    local = () => { return s.length(); };
    return local();
}

struct StaticOriginNode { int value = 7; };

int consumeStaticOriginNode(move StaticOriginNode* node)
{
    int result = node->value;
    delete node;
    return result;
}

int runStaticOriginProbe()
{
    static StaticOriginNode* node = new StaticOriginNode();
    int result = node->value;
    consumeStaticOriginNode(move node);
    return result;
}

string capturedFieldThroughFrame(string p)
{
    CapFieldBox b = default;
    b.s = p;
    Lambda<string()> g = () => b.s;
    return g();
}

bool testReturnCapturedOwningValue()
{
    bool result = true;

    // The filed repro, both spellings. Both strings must be alive and correct afterwards.
    {
        string s = "xyz";
        Lambda<string()> g = () => s;
        string r = g();
        result &= Test("captured string returned (expr body)", r, "xyz");
        result &= Test("captured string source intact",        s, "xyz");
    }

    // By-value captures remain safe when stored in global or static program-lifetime slots.
    result &= Test("global owning-value capture", storeGlobalOwningValueCapture(11), 2);
    result &= Test("static owning-value capture", storeStaticOwningValueCapture(22), 2);
    {
        string s = "xyz";
        Lambda<string()> g = () => { return s; };
        string r = g();
        result &= Test("captured string returned (block body)", r, "xyz");
        result &= Test("captured string source intact 2",       s, "xyz");
    }

    // Independence, the fact the values alone cannot show: two calls must yield two distinct
    // buffers, and neither may be the env's or the source's. Pre-fix all four pointers aliased.
    {
        string s = "xyz";
        Lambda<string()> g = () => s;
        string r1 = g();
        string r2 = g();
        result &= Test("double call value 1",       r1, "xyz");
        result &= Test("double call value 2",       r2, "xyz");
        result &= Test("double call distinct bufs", r1.data() != r2.data(), true);
        result &= Test("returned buf not source",   r1.data() != s.data(),  true);
    }

    // Capture SEMANTICS anchor - a by-value capture is a COPY: writes inside the lambda are
    // invisible outside, and each call re-reads the env's own copy. This must not change.
    {
        string s = "xyz";
        Lambda<int()> g = () => { s = "abcd"; return s.length(); };
        result &= Test("mutated capture inner len", g(),        4);
        result &= Test("mutated capture outer len", s.length(), 3);
        result &= Test("mutated capture outer val", s,          "xyz");
        result &= Test("mutated capture is per-call", g(),      4);
    }

    // Rebinding the unpacked capture to a fresh concatenation must restore its local cleanup.
    // The capture still owns the original environment value, while each new result is owned by
    // the lambda body and must not be left on the heap after the call returns.
    {
        string s = "xyz";
        Lambda<string()> g = () => { s = s + "!"; return s; };
        string r1 = g();
        string r2 = g();
        result &= Test("rebound capture value 1", r1, "xyz!");
        result &= Test("rebound capture value 2", r2, "xyz!");
        result &= Test("rebound capture source intact", s, "xyz");
    }

    // The env dies BEFORE the result is read. Pre-fix these returned freed storage and
    // printed the empty string - a silent wrong value, not only the double free.
    {
        string s = "xyz";
        result &= Test("capture returned past its frame", capturedThroughFrame(s), "xyz");
        result &= Test("capture arg intact",              s,                       "xyz");
    }
    {
        string s = "xyz";
        Lambda<string()> outer = () => { Lambda<string()> inner = () => s; return inner(); };
        result &= Test("nested capture returned outward", outer(), "xyz");
    }

    // A FIELD of a captured owning STRUCT is the same borrow one level down: the returned copy
    // must be an owned, independent buffer. Pre-fix the env's frame-death leg read freed storage
    // and yielded the empty string; a copy left classified as a borrow would leak instead.
    {
        string s = "xyz";
        CapFieldBox b = default;
        b.s = s;
        Lambda<string()> g = () => b.s;
        string r = g();
        // These four assert the VALUE and the buffer distinctness, which the inserted copy
        // gives on its own - they do NOT discriminate the borrow-bit retirement beside it
        // (mutation-tested: delete it and this file still passes 78/78, leaking 32 bytes).
        // The retirement's only tripwire is `leaks --atExit` on scratch/rev_p2_sf_loop.cb.
        result &= Test("captured struct field returned",       r, "xyz");
        result &= Test("captured struct field src intact",     b.s, "xyz");
        result &= Test("captured struct field buf distinct",   r.data() != b.s.data(), true);
        result &= Test("captured struct field past its frame", capturedFieldThroughFrame(s), "xyz");
    }

    // A captured CLOSURE (__closure_fat_ptr, the other owned-bit carve-out) returned the same
    // way: pre-fix the raw tagged env escaped and the program died in the allocator.
    {
        string s = "xyz";
        Lambda<string()> inner = () => s;
        Lambda<Lambda<string()>()> outer = () => inner;
        Lambda<string()> got = outer();
        result &= Test("captured closure returned", got(), "xyz");
    }

    // Owning CONTAINER siblings are not this bug: list<T>/dictionary<K,V> captured and returned
    // are rejected outright by the alias-borrow return gate (no string/closure carve-out), so
    // they never reach the runtime owned-bit path. Reading them stays legal.
    {
        list<int> v = default; v.add(4); v.add(6);
        Lambda<int()> total = () => { int t = 0; for (int i = 0; i < v.count(); i = i + 1) t = t + v.get(i); return t; };
        result &= Test("captured list read not returned", total(), 10);
    }

    return result;
}

bool testCaptureStructRef()
{
    bool result = true;

    // struct (Counter) - reference capture; lambda mutations visible to caller
    {
        Counter c;
        Lambda<void()> inc = () => { c.value = c.value + 1; };
        inc(); inc(); inc();
        result &= Test("struct ref capture", c.value, 3);
    }

    // struct (Stats) - reference capture of multi-field struct
    {
        Stats s;
        Lambda<void(float)> observe = (float v) => {
            if (s.count == 0 || v < s.min) s.min = v;
            if (s.count == 0 || v > s.max) s.max = v;
            s.count = s.count + 1;
        };
        observe(3.0f);
        observe(1.0f);
        observe(5.0f);
        result &= Test("stats count", s.count, 3);
        result &= Test("stats min",   s.min,   1.0f);
        result &= Test("stats max",   s.max,   5.0f);
    }

    // class (Multiplier) - reference capture; caller mutations visible in lambda
    {
        Multiplier m;
        m.factor = 3;
        Lambda<int(int)> tripleIt = (int x) => { return m.apply(x); };
        result &= Test("class ref factor=3", tripleIt(7), 21);
        m.factor = 5;
        result &= Test("class ref factor=5", tripleIt(7), 35);
    }

    // class (Adder) - reference capture with method call
    {
        Adder a;
        a.offset = 100;
        Lambda<int(int)> add100 = (int x) => { return a.apply(x); };
        result &= Test("adder +100 5",  add100(5),  105);
        result &= Test("adder +100 -3", add100(-3),  97);
    }

    // interface - value capture (fat ptr {vtable,data} copied)
    {
        Multiplier m;
        m.factor = 4;
        ITransform t = m;
        Lambda<int(int)> callT = (int x) => { return t.apply(x); };
        result &= Test("iface capture 6", callT(6), 24);
        result &= Test("iface capture 3", callT(3), 12);
    }

    return result;
}

// Regression: a by-reference capture is a BORROW - the source's own scope exit is the single
// owner. The invoker used to register the capture as an ordinary struct local, so its scope-exit
// destructor ran through the borrowed pointer and EVERY call destructed the caller's struct.
// A pointer field is what forces the by-reference path (ClosureCaptureDeepCopyable bails on it).
int refCapCountOnlyDtors = 0;
int refCapOwningDtors = 0;
struct RefCapNode { int v = 0; };

// Counting-only dtor: isolates the call-count multiplication without a real double-free.
struct RefCapCounted
{
    RefCapNode* slot = nullptr;
    ~RefCapCounted() { refCapCountOnlyDtors++; }
};

// The real owning shape (json.cb / ComPtr): deletes and does NOT null. This is the variant
// that actually double-freed - a dtor that nulls masks the bug.
struct RefCapOwning
{
    RefCapNode* slot = nullptr;
    ~RefCapOwning() { refCapOwningDtors++; if (slot != nullptr) delete slot; }
};

bool testCaptureStructRefBorrows()
{
    bool result = true;

    // Counting-only: 3 calls must not multiply the destructor (was 3 in-body + 1 at exit = 4).
    refCapCountOnlyDtors = 0;
    {
        RefCapNode n = default;
        RefCapCounted h = default;
        h.slot = &n;
        Lambda<int()> f = () => { return h.slot->v; };
        f(); f(); f();
        result &= Test("borrowed capture not destructed while live", refCapCountOnlyDtors, 0);
    }
    result &= Test("borrowed capture destructed once", refCapCountOnlyDtors, 1);

    // Real owning shape: reads stay valid across calls and the pointee is freed exactly once.
    refCapOwningDtors = 0;
    {
        RefCapOwning h = default;
        h.slot = new RefCapNode();
        h.slot->v = 3;
        Lambda<int()> f = () => { return h.slot->v; };
        result &= Test("owning borrow read 1", f(), 3);
        result &= Test("owning borrow read 2", f(), 3);   // was a use-after-free: call 1 freed slot
        result &= Test("owning borrow read 3", f(), 3);
        result &= Test("owning borrow live dtors", refCapOwningDtors, 0);
    }
    result &= Test("owning borrow freed once", refCapOwningDtors, 1);

    /*
     * The by-reference capture is the CARVE-OUT of the alias-borrow guards: it is marked
     * IsAliasBorrow like an `alias`-return local, but its storage IS the outer owner's address, so
     * consuming a field through it really does move out of the one owner and re-binding it really
     * does drop the outer's old value. Both spellings must stay ACCEPTED (the `alias`-return twins
     * are rejected / drop-old-suppressed - see Test/errors/err_move.cb's `aliasBorrowFieldMove`).
     */
    // `move` of a captured struct's field: the pointee is freed exactly once, by the sink.
    refCapOwningDtors = 0;
    {
        RefCapOwning h = default;
        h.slot = new RefCapNode();
        h.slot->v = 4;
        Lambda<int()> f = () => { RefCapNode* taken = move h.slot; int v = taken->v; delete taken; return v; };
        result &= Test("refcap_field_move_value", f(), 4);
        result &= Test("refcap_field_move_outer_nulled", h.slot == nullptr, true);
    }
    // ~RefCapOwning ran once and found a nulled slot: no second free of the moved-out node.
    result &= Test("refcap_field_move_owner_dtor_once", refCapOwningDtors, 1);

    // Re-binding the captured struct writes THROUGH to the outer, so its drop-old must still run.
    refCapOwningDtors = 0;
    {
        RefCapOwning h = default;
        h.slot = new RefCapNode();
        h.slot->v = 5;
        Lambda<int()> g = () => { RefCapOwning n = default; n.slot = new RefCapNode(); n.slot->v = 6; h = n; return h.slot->v; };
        result &= Test("refcap_rebind_value", g(), 6);
        // 2 = the outer's OLD value dropped through the capture + the body's moved-from local.
        // Suppressing the drop-old here (as the `alias`-return twin does) would read 1 and leak.
        result &= Test("refcap_rebind_old_dropped", refCapOwningDtors, 2);
        result &= Test("refcap_rebind_outer_sees_new", h.slot->v, 6);
    }
    result &= Test("refcap_rebind_total_dtors", refCapOwningDtors, 3);

    return result;
}

// Owning value type captured by an ESCAPING closure must be DEEP-COPIED into the env so
// the closure owns an independent buffer that outlives the source scope. Before the fix,
// list/dictionary/owning-struct captures were shallow by-reference and dangled (UAF under
// --asan) once the source block closed.
struct OwningBag
{
    string name = default;
    list<int> nums = default;
};

bool testCaptureOwningContainerEscapes()
{
    bool result = true;

    // list<int> captured by a closure that outlives the defining block.
    {
        Lambda<int()> sumV = default;
        {
            list<int> v = default; v.add(10); v.add(20); v.add(30);
            sumV = () => { int s = 0; for (int i = 0; i < v.count(); i = i + 1) s = s + v.get(i); return s; };
        }
        result &= Test("escaping list capture", sumV(), 60);
    }

    // dictionary<string,int> captured by an escaping closure.
    {
        Lambda<int()> sumD = default;
        {
            dictionary<string, int> d = default;
            d.set("a", 10); d.set("b", 20); d.set("c", 30);
            sumD = () => { return d.get("a") + d.get("b") + d.get("c"); };
        }
        result &= Test("escaping dict capture", sumD(), 60);
    }

    // user struct with owning (string + list) fields captured by an escaping closure.
    {
        Lambda<int()> useBag = default;
        {
            OwningBag b = default;
            b.name = "hi";
            b.nums.add(5); b.nums.add(7);
            useBag = () => { int s = b.name.length(); for (int i = 0; i < b.nums.count(); i = i + 1) s = s + b.nums.get(i); return s; };
        }
        result &= Test("escaping owning-struct capture", useBag(), 14);
    }

    // Clone the closure, invoke both, and let both be destructed (no double free of the env buffer).
    {
        Lambda<int()> first = default;
        {
            list<int> v = default; v.add(1); v.add(2); v.add(3);
            first = () => { int s = 0; for (int i = 0; i < v.count(); i = i + 1) s = s + v.get(i); return s; };
        }
        Lambda<int()> second = first;
        result &= Test("clone escaping closure a", first(),  6);
        result &= Test("clone escaping closure b", second(), 6);
    }

    // A nested closure (an inner closure with its own heap env) captured by an ESCAPING outer
    // closure must be DEEP-COPIED via __closure_fat_ptr.copy so the outer owns an independent
    // clone of the inner env. Before the fix the inner fat pointer was shallow-copied and its env
    // dangled (UAF under --asan) once the inner closure's block closed.
    {
        Lambda<int()> callAdder = default;
        {
            int base = 100;
            Lambda<int(int)> adder = (int x) => x + base;
            callAdder = () => { return adder(5); };
        }
        result &= Test("escaping nested-closure capture", callAdder(), 105);
    }

    // Clone-of-clone of an escaping outer closure over a heap-env inner: each clone must own an
    // independent inner env (no shared alias, no double-free of the inner env buffer).
    {
        Lambda<int()> outer = default;
        {
            int base = 200;
            Lambda<int(int)> adder = (int x) => x + base;
            outer = () => { return adder(3); };
        }
        Lambda<int()> clone = outer;
        result &= Test("clone nested-closure a", outer(), 203);
        result &= Test("clone nested-closure b", clone(), 203);
    }

    return result;
}

bool testCaptureMultiple()
{
    bool result = true;

    // int + float + struct
    {
        int base = 10;
        float rate = 1.5f;
        Counter total;
        Lambda<void(int)> accumulate = (int n) => {
            total.value = total.value + (int)(n * rate) + base;
        };
        accumulate(2);   // (int)(2*1.5) + 10 = 3+10 = 13
        accumulate(4);   // (int)(4*1.5) + 10 = 6+10 = 16  -> total=29
        result &= Test("multi int+float+struct", total.value, 29);
    }

    // string (value) + Counter (reference)
    {
        string prefix = "item_";
        Counter counter;
        Lambda<int()> nextId = () => {
            counter.value = counter.value + 1;
            return prefix.length() + counter.value;
        };
        result &= Test("multi str+counter 1", nextId(), 6);
        result &= Test("multi str+counter 2", nextId(), 7);
        result &= Test("multi counter value", counter.value, 2);
    }

    // lambda passed as argument, captures struct
    {
        Counter c;
        Lambda<int(int)> addToC = (int n) => { c.value = c.value + n; return c.value; };
        result &= Test("capture in arg 5",     transform(addToC, 5), 5);
        result &= Test("capture in arg 3",     transform(addToC, 3), 8);
        result &= Test("capture struct after",  c.value,              8);
    }

    // Lambda<T> variable - value capture of fat struct
    {
        int base = 100;
        Lambda<int(int)> addBase = (int x) => { return x + base; };
        Lambda<int(int)> doubleAndAdd = (int x) => { return addBase(x * 2); };
        result &= Test("nested lambda 5", doubleAndAdd(5),  110);
        result &= Test("nested lambda 0", doubleAndAdd(0),  100);
    }

    return result;
}

// A lambda inside a method auto-captures the implicit 'this' pointer.
class ThisBox
{
    int v = 0;
    Lambda<void()> makeInc() { return () => { this.v = this.v + 1; }; }
    Lambda<int()>  makeGet() { return () => { return this.v; }; }
    // Capture 'this' AND a value-captured parameter together.
    Lambda<int(int)> makeAddBoth(int base) { return (int n) => { return this.v + base + n; }; }
};

bool testCaptureThis()
{
    bool result = true;

    // void lambda mutating a field through captured 'this'
    ThisBox b;
    b.v = 0;
    Lambda<void()> inc = b.makeInc();
    inc(); inc();
    result &= Test("capture this void", b.v, 2);

    // value-returning lambda reading a field through captured 'this'
    Lambda<int()> get = b.makeGet();
    result &= Test("capture this value-return", get(), 2);

    // mixed: captured 'this' plus a captured parameter
    ThisBox c;
    c.v = 10;
    Lambda<int(int)> addBoth = c.makeAddBoth(5);
    result &= Test("capture this + param", addBoth(3), 18);  // 10 + 5 + 3

    return result;
}

// A nested lambda must not clobber the enclosing function's recorded return type:
// an interface-returning function with a lambda before 'return <implementer>'.
interface IValueFP { int getValue(); };
class ValueHolderFP : IValueFP
{
    int n = 0;
    int getValue() { return this.n; }
};

// 'move' return: ownership of the heap ValueHolderFP transfers to the caller through the
// interface. Without 'move' the compiler now rejects this (the caller could not see it owns
// the boxed object). Interface locals are not auto-destructed, so the caller still 'delete's it.
move IValueFP makeValueHolderWithLambda(int x)
{
    ValueHolderFP* vh = new ValueHolderFP();
    vh.n = x;
    Lambda<void()> noop = () => { };
    noop();
    return vh;   // must box into IValueFP, not the lambda's 'void'
}

bool testInterfaceReturnWithLambda()
{
    bool result = true;
    IValueFP v = makeValueHolderWithLambda(42);
    result &= Test("iface return after lambda", v.getValue(), 42);
    delete v;   // v owns the heap ValueHolderFP returned through the interface
    return result;
}

bool testCaptureRegression()
{
    bool result = true;

    // Regression: lambda before list<string>->add(string) must not corrupt overload
    // resolution. lastLambdaType was not cleared after ParsePostfixExpression consumed
    // it, causing CompareUpconvert on a struct arg to return -1 (no match).
    {
        Lambda<void(int)> cb = (int x) => { };

        list<string>* L = new list<string>;
        string s = "world";
        L->add(s);
        result &= Test("lambda before list<string> add", L->count(), 1);
        delete L;
    }

    return result;
}

// Regression: a captured local whose NAME collides with an in-scope function or
// method must still be captured - the local shadows the callable. The capture
// collector used to skip any identifier present in the function table, so a captured
// local that shared a name with a function/method was dropped, and the body then
// referenced the OUTER frame's storage across the closure boundary (LLVM verify:
// "instruction does not dominate all uses"). Surfaced by mc_pi.cb capturing `seed`
// while random.cb's Random.seed method was in scope.
bool testCaptureNameCollidesWithFunction()
{
    bool result = true;

    // 'doubleIt' is a top-level function in this file; the same-named local must
    // shadow it and be captured by value.
    int doubleIt = 21;
    Lambda<int()> f = () => { return doubleIt + doubleIt; };
    result &= Test("capture shadows function name", f(), 42);

    // The bug only bit when a struct ctor/method call sat between the capture
    // unpack and the captured use (Random's ctor in mc_pi). Mirror that: capture a
    // local across a struct local + method-style write, with the captured name
    // colliding with a function ('square').
    int square = 5;
    Counter acc;
    acc.value = 0;
    Lambda<void()> g = () => { acc.value = acc.value + square; };
    g();
    g();
    result &= Test("capture name collision w/ struct local", acc.value, 10);

    return result;
}

// Regression: capturing a local T arr[N] by reference must store T* in the closure
// (element pointer), not [N x T]*.  Wrong type caused GEP to stride by N*sizeof(T)
// instead of sizeof(T), so arr[1], arr[2], etc. read from garbage addresses.
bool testCaptureLocalArray()
{
    bool result = true;

    Counter[3] pts;
    pts[0].value = 10;
    pts[1].value = 20;
    pts[2].value = 30;

    // Use a Counter (struct, captured by reference) to accumulate so writes
    // from the lambda are visible to the caller.
    Counter acc;
    int i = 0;
    while (i < 3)
    {
        callVoid(() => { acc.value = acc.value + pts[i].value; });
        i++;
    }
    result &= Test("capture array sum", acc.value, 60);

    return result;
}

// Regression: closure alloca created inside a loop body must be hoisted to the
// function entry block.  Loop-body allocas grow the stack on every iteration,
// causing stack overflow (0xC00000FD) on large trip counts.
bool testLambdaAllocaInLoop()
{
    bool result = true;

    Counter c;
    int n = 5;
    for (int i = 0; i < n; i++)
    {
        int delta = i + 1;
        Lambda<void()> inc = () => { c.value = c.value + delta; };
        inc();
    }
    // 1+2+3+4+5 = 15
    result &= Test("lambda alloca in loop", c.value, 15);

    return result;
}

// Regression: a capture-bond (lambda holding &source by address) must NOT block
// reassigning the captured source. The closure stores the alloca address, so writing
// a new value into a still-live slot is safe - the canonical double-buffer swap idiom.
// Previously rejected with "cannot reassign 'a' while 'f' holds a bonded reference to
// it". The bond's escape guard still fires for both bond kinds; only the in-frame
// reassignment block is lifted for by-address capture-bonds.
bool testCaptureBondReassign()
{
    bool result = true;

    Counter a; a.value = 1;
    Counter b; b.value = 2;

    // Build the closure ONCE, capturing both struct locals by reference.
    Lambda<int()> f = () => { return a.value + b.value; };

    // Double-buffer swap: reassign the captured sources. Must compile without the
    // spurious bond-reassignment error; the closure observes the new slot contents.
    Counter tmp = a;
    a = b;
    b = tmp;

    // After swap a.value==2, b.value==1, so f() returns 3.
    result &= Test("capture-bond swap then call", f(), 3);

    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// GENERIC FUNCTION POINTER TESTS
// ─────────────────────────────────────────────────────────────────────────────

// Read a T through a void* and return it as int.
int readAs<T>(void* raw) {
    T* p = (T*)raw;
    return (int)*p;
}

// Write val into a T through a void*.
int writeAs<T>(void* raw) {
    T* p = (T*)raw;
    *p = (T)7;
    return 0;
}

// Return sizeof(T) - uses a type parameter in sizeof(), not in a pointer cast.
int sizeOf<T>(void* ignored) {
    return (int)sizeof(T);
}

// Multiply the value at raw by 2 in-place.
int doubleInPlace<T>(void* raw) {
    T* p = (T*)raw;
    T v = *p;
    *p = v + v;
    return 0;
}

bool testGenericFuncPtrBasic()
{
    bool result = true;

    Lambda<int(void*)> fn = readAs<int>;
    int x = 42;
    result &= Test("generic read int", fn((void*)&x), 42);

    fn = readAs<i64>;
    i64 big = 123;
    result &= Test("generic read i64", fn((void*)&big), 123);

    return result;
}

bool testGenericFuncPtrSizeof()
{
    bool result = true;

    Lambda<int(void*)> fn = sizeOf<int>;
    result &= Test("sizeof<int>",  fn(nullptr), 4);

    fn = sizeOf<i64>;
    result &= Test("sizeof<i64>",  fn(nullptr), 8);

    fn = sizeOf<bool>;
    result &= Test("sizeof<bool>", fn(nullptr), 1);

    return result;
}

bool testGenericFuncPtrWrite()
{
    bool result = true;

    Lambda<int(void*)> fn = writeAs<int>;
    int x = 0;
    fn((void*)&x);
    result &= Test("generic write int", x, 7);

    return result;
}

bool testGenericFuncPtrDoubleInPlace()
{
    bool result = true;

    Lambda<int(void*)> fn = doubleInPlace<int>;
    int v = 5;
    fn((void*)&v);
    result &= Test("doubleInPlace<int>", v, 10);

    fn = doubleInPlace<i64>;
    i64 big = 3;
    fn((void*)&big);
    result &= Test("doubleInPlace<i64>", (int)big, 6);

    return result;
}

// Pass a generic-instantiated function pointer through a regular higher-order function.
bool testGenericFuncPtrHigherOrder()
{
    bool result = true;

    Lambda<int(void*)> fn = readAs<int>;
    int a = 99;
    result &= Test("higher order int", fn((void*)&a), 99);

    fn = readAs<i64>;
    i64 b = 77;
    result &= Test("higher order i64", fn((void*)&b), 77);

    // Switch between two unrelated generic functions via reassignment.
    fn = sizeOf<int>;
    result &= Test("switch to sizeOf<int>", fn(nullptr), 4);

    fn = readAs<int>;
    int x = 55;
    result &= Test("switch back to readAs<int>", fn((void*)&x), 55);

    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// FUNCTION POINTER IN STRUCT FIELD TESTS
// ─────────────────────────────────────────────────────────────────────────────

struct Handler {
    Lambda<int(int)> fn = default;
};

struct VoidHandler {
    Lambda<void()> fn = default;
};

// Regression: a method parameter whose name collides with a global core function
// (e.g. `release`, defined in runtime.cb) must shadow it - `field = release;` had
// mis-resolved the RHS to the global function instead of the parameter, silently
// storing the wrong callable (or a no-op) into the field.
struct ShadowSetter {
    function<int(int)> releaseImage = default;
    bool hasRelease = false;

    void init(function<int(int)> release) {
        releaseImage = release;   // 'release' is a parameter here, not core's release()
        hasRelease = true;
    }
};

bool testFuncPtrInStructField()
{
    bool result = true;

    Handler h;
    h.fn = doubleIt;
    result &= Test("struct field call doubleIt", h.fn(6), 12);

    h.fn = square;
    result &= Test("struct field reassign square", h.fn(5), 25);

    h.fn = (int x) => { return x + 100; };
    result &= Test("struct field lambda", h.fn(3), 103);

    // Parameter name shadows a same-named global core function on field assign.
    ShadowSetter s;
    s.init(doubleIt);
    result &= Test("param shadows global fn: hasRelease", s.hasRelease ? 1 : 0, 1);
    result &= Test("param shadows global fn: field call", s.releaseImage(6), 12);

    return result;
}

bool testFuncPtrInStructFieldVoid()
{
    bool result = true;

    // Void function pointer stored in struct field.  Use doNothing (no capture
    // needed) to avoid the known limitation where captures through struct-field
    // closures are not yet propagated correctly.
    VoidHandler vh;
    vh.fn = doNothing;
    vh.fn();
    result &= Test("void struct field call", 1, 1);

    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// DISPATCH TABLE TESTS
// ─────────────────────────────────────────────────────────────────────────────

struct DispatchEntry {
    Lambda<int(void*)> fn  = default;
    void*                ctx = nullptr;
};

bool testDispatchTable()
{
    bool result = true;

    int[4] vals;
    vals[0] = 1; vals[1] = 2; vals[2] = 3; vals[3] = 4;

    DispatchEntry[4] table;
    table[0].fn = readAs<int>; table[0].ctx = (void*)&vals[0];
    table[1].fn = readAs<int>; table[1].ctx = (void*)&vals[1];
    table[2].fn = readAs<int>; table[2].ctx = (void*)&vals[2];
    table[3].fn = readAs<int>; table[3].ctx = (void*)&vals[3];

    int sum = 0;
    int i = 0;
    while (i < 4) {
        sum = sum + table[i].fn(table[i].ctx);
        i++;
    }
    result &= Test("dispatch table sum", sum, 10);  // 1+2+3+4

    return result;
}

// A fixed-size array of thin `function<T>` values. Regression for a miscompile where
// `GetType()` returned the bare scalar function-pointer type for `function<T>[N]`,
// ignoring ConstArraySize; the alloca was under-sized and invoking two or more elements
// corrupted the block, silently truncating the rest of the enclosing function body.
// Takes the array as a 'function<T>[]' array-view so the subscript has to be honoured
// on the callee side; a dropped subscript would return n copies of fns[0].
int applyAllFuncPtrs(function<int(int)>[] fns, int n, int v)
{
    int sum = 0;
    for (int i = 0; i < n; i++)
        sum += fns[i](v);
    return sum;
}

// A scalar 'function<T>*' out-parameter: the declarator's '*' must survive
// ParseDeclarationSpecifiers, or the store-through writes the wrong location.
void selectFuncPtr(function<int(int)>* slot, int which)
{
    if (which == 0) *slot = doubleIt;
    else            *slot = square;
}

bool testFuncPtrArray()
{
    bool result = true;

    function<int(int)>[3] fns;
    fns[0] = doubleIt;
    fns[1] = square;
    fns[2] = negate;

    result &= Test("func ptr array[0](5)", fns[0](5), 10);
    result &= Test("func ptr array[1](5)", fns[1](5), 25);
    result &= Test("func ptr array[2](5)", fns[2](5), -5);

    int sum = fns[0](2) + fns[1](2) + fns[2](2);
    result &= Test("func ptr array sum of all elements", sum, 4 + 4 - 2);

    // A 'function<T>[]' array-view parameter must GEP by the subscript, not drop it.
    result &= Test("func ptr array view param", applyAllFuncPtrs(fns, 3, 3), 6 + 9 - 3);

    // 'function<T>*' out-parameter: the callee writes back through the pointer.
    function<int(int)> slot = negate;
    selectFuncPtr(&slot, 0);
    result &= Test("func ptr out-param writes doubleIt", slot(5), 10);
    selectFuncPtr(&slot, 1);
    result &= Test("func ptr out-param writes square", slot(5), 25);

    return result;
}

// The 'using Cb = function<R(Args)>' alias spelling goes through a different
// ParseDeclarationSpecifiers branch, which must capture '[N]' the same way.
using IntFnPtr = function<int(int)>;

bool testFuncPtrAliasArray()
{
    bool result = true;

    IntFnPtr[3] arr;
    arr[0] = doubleIt;
    arr[1] = square;
    arr[2] = negate;

    result &= Test("alias func ptr array[0](3)", arr[0](3), 6);
    result &= Test("alias func ptr array[1](3)", arr[1](3), 9);
    result &= Test("alias func ptr array[2](3)", arr[2](3), -3);

    int sum = arr[0](2) + arr[1](2) + arr[2](2);
    result &= Test("alias func ptr array sum of all elements", sum, 4 + 4 - 2);

    // An alias array must also survive being passed as a 'function<T>[]' view.
    result &= Test("alias func ptr array view param", applyAllFuncPtrs(arr, 3, 3), 6 + 9 - 3);

    // Multi-dimensional through the alias spelling.
    IntFnPtr[2][3] grid;
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 3; j++)
            grid[i][j] = doubleIt;
    grid[1][2] = square;
    result &= Test("alias func ptr array 2d [1][2](3)", grid[1][2](3), 9);
    result &= Test("alias func ptr array 2d [0][0](3)", grid[0][0](3), 6);

    return result;
}

// Multi-dimensional 'function<T>[N][M]': every dimension after the first must survive
// ParseDeclarationSpecifiers, or the storage is under-sized and writes smash the stack.
bool testFuncPtrArray2D()
{
    bool result = true;

    function<int(int)>[2][3] grid;
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 3; j++)
            grid[i][j] = doubleIt;
    grid[1][2] = negate;
    grid[0][1] = square;

    result &= Test("func ptr array 2d [0][0](5)", grid[0][0](5), 10);
    result &= Test("func ptr array 2d [0][1](5)", grid[0][1](5), 25);
    result &= Test("func ptr array 2d [1][2](5)", grid[1][2](5), -5);
    result &= Test("func ptr array 2d last row untouched", grid[1][0](5), 10);

    int sum = 0;
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 3; j++)
            sum += grid[i][j](2);
    result &= Test("func ptr array 2d sum of all 6 elements", sum, 4 + 4 + 4 + 4 + 4 - 2);

    return result;
}

// Regression: 'function<T>' and 'function<T>*' are DISTINCT overloads. Both the mangled key
// (ToUniqueString skipped Pointer for function-pointer types) and the overload scorer (which
// scored any function-compatible argument as a perfect match) ignored the '*', so the second
// declaration collided onto the first and both calls jumped through the wrong one (SIGSEGV).
// The two arms apply different constants, so a collapse onto one overload changes the value.
int applyFnPtrOverload(function<int(int)> f)  { return f(3); }
int applyFnPtrOverload(function<int(int)>* f) { return (*f)(4); }

// Declared pointer-arm-FIRST: the winner must not depend on declaration order.
int applyFnPtrOverloadRev(function<int(int)>* f) { return (*f)(4); }
int applyFnPtrOverloadRev(function<int(int)> f)  { return f(3); }

// Regression: 'function<T>[]' (array view) and 'function<T>*' (pointer) are DISTINCT arms too.
// The trailing int literal is only a PROMOTION match, which demotes every arm out of the
// perfect tier - and that tier ignored per-argument quality, so the winner was decided by
// declaration position. A fixed array then bound the '*' arm and was read as if the array
// itself were the pointer, silently and with no diagnostic. The +100/+200 tags turn a wrong
// bind into a wrong VALUE, and both declaration orders are pinned.
int pickFnPtrShape(function<int(int)>[] fns, int n) { return 100 + fns[0](n); }
int pickFnPtrShape(function<int(int)>* f, int n)    { return 200 + (*f)(n); }

int pickFnPtrShapeRev(function<int(int)>* f, int n)    { return 200 + (*f)(n); }
int pickFnPtrShapeRev(function<int(int)>[] fns, int n) { return 100 + fns[0](n); }

bool testFuncPtrPointerOverload()
{
    bool result = true;

    function<int(int)> g = doubleIt;
    result &= Test("func ptr by-value overload", applyFnPtrOverload(g), 6);
    result &= Test("func ptr pointer overload", applyFnPtrOverload(&g), 8);

    result &= Test("func ptr by-value overload (rev decl order)", applyFnPtrOverloadRev(g), 6);
    result &= Test("func ptr pointer overload (rev decl order)", applyFnPtrOverloadRev(&g), 8);

    // A named function binds the by-value arm, never the pointer arm.
    result &= Test("func ptr overload takes named function by value", applyFnPtrOverload(square), 9);

    // The pointer arm is a real out-parameter path: writing through it must be visible here.
    selectFuncPtr(&g, 1);
    result &= Test("func ptr pointer overload sees out-param write", applyFnPtrOverload(&g), 16);

    // '[]' vs '*': a fixed array must bind the array-view arm, a '&' the pointer arm, in
    // either declaration order. doubleIt(3) = 6 -> 106; square(3) = 9 -> 209.
    function<int(int)>[2] shapeArr;
    shapeArr[0] = doubleIt;
    shapeArr[1] = negate;
    function<int(int)> one = square;

    result &= Test("fixed array binds the '[]' arm", pickFnPtrShape(shapeArr, 3), 106);
    result &= Test("pointer binds the '*' arm", pickFnPtrShape(&one, 3), 209);
    result &= Test("fixed array binds '[]' arm (rev decl order)", pickFnPtrShapeRev(shapeArr, 3), 106);
    result &= Test("pointer binds '*' arm (rev decl order)", pickFnPtrShapeRev(&one, 3), 209);

    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// LIST SORT TESTS
// ─────────────────────────────────────────────────────────────────────────────

bool testListSortAscending()
{
    bool result = true;

    list<int> nums;
    nums.add(5); nums.add(2); nums.add(8); nums.add(1); nums.add(9); nums.add(3);
    nums.sort((int a, int b) => { return a < b; });

    result &= Test("sort[0]==1", nums.get(0), 1);
    result &= Test("sort[1]==2", nums.get(1), 2);
    result &= Test("sort[2]==3", nums.get(2), 3);
    result &= Test("sort[3]==5", nums.get(3), 5);
    result &= Test("sort[4]==8", nums.get(4), 8);
    result &= Test("sort[5]==9", nums.get(5), 9);

    return result;
}

bool testListSortDescending()
{
    bool result = true;

    list<int> nums;
    nums.add(5); nums.add(2); nums.add(8); nums.add(1); nums.add(9); nums.add(3);
    nums.sort((int a, int b) => { return a > b; });

    result &= Test("desc[0]==9", nums.get(0), 9);
    result &= Test("desc[1]==8", nums.get(1), 8);
    result &= Test("desc[2]==5", nums.get(2), 5);
    result &= Test("desc[3]==3", nums.get(3), 3);
    result &= Test("desc[4]==2", nums.get(4), 2);
    result &= Test("desc[5]==1", nums.get(5), 1);

    return result;
}

bool testListSortEdgeCases()
{
    bool result = true;

    // Single element
    list<int> one;
    one.add(42);
    one.sort((int a, int b) => { return a < b; });
    result &= Test("single elem", one.get(0), 42);

    // Already sorted
    list<int> sorted;
    sorted.add(1); sorted.add(2); sorted.add(3);
    sorted.sort((int a, int b) => { return a < b; });
    result &= Test("already sorted[0]", sorted.get(0), 1);
    result &= Test("already sorted[2]", sorted.get(2), 3);

    // Reverse sorted
    list<int> rev;
    rev.add(3); rev.add(2); rev.add(1);
    rev.sort((int a, int b) => { return a < b; });
    result &= Test("reverse sorted[0]", rev.get(0), 1);
    result &= Test("reverse sorted[2]", rev.get(2), 3);

    return result;
}

bool testListSortNamedComparator()
{
    bool result = true;

    list<int> nums;
    nums.add(7); nums.add(3); nums.add(5);

    Lambda<bool(int, int)> asc = (int a, int b) => { return a < b; };
    nums.sort(asc);

    result &= Test("named cmp[0]", nums.get(0), 3);
    result &= Test("named cmp[1]", nums.get(1), 5);
    result &= Test("named cmp[2]", nums.get(2), 7);

    return result;
}

// ── 'move' in function pointer signatures ────────────────────────────────────
// Lambda<R(move T*)> is a distinct type from Lambda<R(T*)>. Calling through
// such a pointer transfers ownership of the matching argument to the callee
// (the caller's storage is auto-nulled), and the named function used to
// initialize the pointer must declare the same 'move' modifier on that param.

int g_move_fp_dtor_count = 0;
struct MovePayload {
    int value = 0;
    ~MovePayload() { g_move_fp_dtor_count = g_move_fp_dtor_count + 1; }
};

int consume_payload(move MovePayload* p) {
    int v = p->value;
    delete p;
    return v;
}

bool testFuncPtrMoveSignature()
{
    g_move_fp_dtor_count = 0;
    Lambda<int(move MovePayload*)> fp = consume_payload;
    MovePayload* p = new MovePayload();
    p->value = 7;
    int got = fp(p);
    // Caller's pointer is auto-nulled by the funcptr's 'move' contract; scope-exit cleanup is a no-op.
    return got == 7 && g_move_fp_dtor_count == 1;
}

// ── Non-capturing lambda across the C ABI ────────────────────────────────────
// A C function pointer is a bare code address with no env slot. The closure ABI is
// env-last, so the invoker of a *non-capturing* lambda is directly callable as a
// C callback - the C caller never supplies the trailing (unused) env arg. A capturing
// lambda or a Lambda<> variable still cannot cross the C ABI (see err_lambda_to_c_funcptr).

extern void qsort(void* base, u64 num, u64 size, Lambda<int(void*, void*)> cmp);

bool testNonCapturingLambdaToCFuncPtr()
{
    bool result = true;

    int[5] a = {5, 2, 8, 1, 9};
    // Non-capturing comparator: references only its own parameters, captures nothing.
    qsort(&a[0], 5u, (u64)sizeof(int), (void* x, void* y) => {
        int* ix = (int*)x;
        int* iy = (int*)y;
        return *ix - *iy;
    });

    result &= Test("c-funcptr lambda sort[0]", a[0], 1);
    result &= Test("c-funcptr lambda sort[1]", a[1], 2);
    result &= Test("c-funcptr lambda sort[2]", a[2], 5);
    result &= Test("c-funcptr lambda sort[3]", a[3], 8);
    result &= Test("c-funcptr lambda sort[4]", a[4], 9);

    return result;
}

// ── Lambda<T>.toFunction(): fat closure -> thin C function pointer ───────────
// Returns the bare code ptr when the closure does not capture (env null), or a
// null thin pointer when it captures. The null return IS the contract - a
// capturing closure has no C-ABI representation.

int tf_add1(int x) { return x + 1; }

bool testFuncToFunction()
{
    bool result = true;

    // Non-capturing Lambda (named function) -> non-null callable thin ptr.
    Lambda<int(int)> f = tf_add1;
    function<int(int)> g = f.toFunction();
    result &= Test("toFunction non-capturing non-null", g != nullptr ? 1 : 0, 1);
    result &= Test("toFunction non-capturing call",     g(41),               42);

    // Capturing Lambda -> null thin ptr (fails closed; caller must null-check).
    int base = 100;
    Lambda<int(int)> cap = (int x) => { return x + base; };
    function<int(int)> h = cap.toFunction();
    result &= Test("toFunction capturing is null", h == nullptr ? 1 : 0, 1);

    // thin -> Lambda -> toFunction round-trip: widening stores {code, null}, so the
    // thin ptr is recovered intact and stays callable.
    function<int(int)> t = tf_add1;
    Lambda<int(int)> wide = t;
    function<int(int)> back = wide.toFunction();
    result &= Test("toFunction round-trip non-null", back != nullptr ? 1 : 0, 1);
    result &= Test("toFunction round-trip call",     back(7),              8);

    return result;
}

// ── Cast a raw code address to a thin function<...> (the COM/foreign-vtable shape) ──
// A thin `function<...>` is a single bare C function pointer, so a raw address can be
// reinterpreted into one and called directly with no env arg. This is the supported
// path for invoking a method loaded out of a foreign object's vtable.

int tf_castA(void* self, int d) { return d + 1; }
int tf_castB(void* self, int d) { return d * 2; }

bool testCastAddrToThinFnPtr()
{
    bool result = true;

    // Cast form: (function<...>)addr - reinterprets a void* as a thin callable.
    void* addr = (void*)tf_castA;
    function<int(void*, int)> f = (function<int(void*, int)>)addr;
    result &= Test("cast addr to thin fnptr", f(nullptr, 41), 42);

    // Load bare code addresses out of a fabricated vtable and call with explicit this.
    void*[2] vtbl = default;
    vtbl[0] = (void*)tf_castA;
    vtbl[1] = (void*)tf_castB;
    function<int(void*, int)> m0 = (function<int(void*, int)>)vtbl[0];
    function<int(void*, int)> m1 = (function<int(void*, int)>)vtbl[1];
    result &= Test("vtable slot 0 call", m0(nullptr, 20), 21);
    result &= Test("vtable slot 1 call", m1(nullptr, 21), 42);

    return result;
}

// ── function-type aliases (using Cb = Lambda<R(Args)>) ──────────────────────
// A `using` alias whose RHS is a function type is usable everywhere a Lambda<...>
// type is: parameter, local variable, struct field, and return type. The alias
// expands to the closure type, so ownership (capture/copy/free) flows through it.
using IntUnaryOp = Lambda<int(int)>;          // HANDLE/EVENT-style: Lambda<void(void*)> etc.

struct AliasHandlerBox { IntUnaryOp op = default; };   // alias as a struct field type

int callAlias(IntUnaryOp f, int x) { return f(x); }    // alias as a parameter type

IntUnaryOp makeAliasAdder(int base)                    // alias as a return type
{
    IntUnaryOp f = (int x) => x + base;
    return f;                                          // escape via variable
}

bool testFunctionTypeAlias()
{
    bool result = true;
    // alias as a local var type + non-capturing lambda
    IntUnaryOp inc = (int x) => x + 1;
    result &= Test("alias local non-capturing", inc(41), 42);

    // alias as a parameter type, capturing lambda passed by value
    int cap = 100;
    result &= Test("alias param capturing arg", callAlias((int x) => x + cap, 5), 105);

    // alias as a return type (capturing closure escapes the helper frame)
    IntUnaryOp add1000 = makeAliasAdder(1000);
    result &= Test("alias return capturing", add1000(1), 1001);

    // alias as a struct field type, assigned a capturing lambda
    AliasHandlerBox box = default;
    int bias = 7;
    box.op = (int x) => x + bias;
    result &= Test("alias struct field", box.op(3), 10);
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// Closure / generics monomorphization (gap a: closure as generic arg; gap b: generic
// type inside a closure signature). See internal/plan/closure-generics-monomorphization.md.
// ─────────────────────────────────────────────────────────────────────────────

using IntUnary = Lambda<int(int)>;

struct KeyMaker
{
    Lambda<list<string>()> make = default;
};

// gap b: a closure whose return type is a generic instantiation, as a parameter.
list<string> runMaker(Lambda<list<string>()> mk) { return mk(); }

bool testClosureGenericSigReturn()
{
    bool result = true;

    // local: Lambda<list<string>()> returning a freshly-built list<string>
    Lambda<list<string>()> mk = () => { list<string> r; r.add("a"); r.add("bb"); return r; };
    list<string> got = mk();
    result &= Test("gap-b local count", got.count(), 2);
    result &= Test("gap-b local[0]",   got.get(0), "a");
    result &= Test("gap-b local[1]",   got.get(1), "bb");

    // parameter
    list<string> got2 = runMaker(() => { list<string> r; r.add("x"); r.add("y"); r.add("z"); return r; });
    result &= Test("gap-b param count", got2.count(), 3);

    // struct field
    KeyMaker km = default;
    km.make = () => { list<string> r; r.add("f1"); r.add("f2"); return r; };
    list<string> got3 = km.make();
    result &= Test("gap-b field count", got3.count(), 2);
    result &= Test("gap-b field[1]",    got3.get(1), "f2");

    return result;
}

bool testClosureListFat()
{
    bool result = true;

    // list<Lambda<int(int)>>: three capturing lambdas with distinct captured offsets.
    int a = 100; int b = 200; int c = 300;
    list<Lambda<int(int)>> fns;
    fns.add((int x) => x + a);
    fns.add((int x) => x + b);
    fns.add((int x) => x + c);
    result &= Test("gap-a fat f0", fns.get(0)(1), 101);
    result &= Test("gap-a fat f1", fns.get(1)(1), 201);
    result &= Test("gap-a fat f2", fns.get(2)(1), 301);

    // Reassign an element: the old env must be freed exactly once (heap-audit verifies).
    fns.set(1, (int x) => x * b);
    result &= Test("gap-a fat f1 reassigned", fns.get(1)(2), 400);

    // list destruct here frees all three envs.
    return result;
}

bool testClosureListThin()
{
    bool result = true;

    // list<function<int(int)>>: thin C fn ptrs via named functions.
    list<function<int(int)>> fns;
    fns.add(doubleIt);   // x * 2
    fns.add(square);     // x * x
    result &= Test("gap-a thin f0", fns.get(0)(10), 20);
    result &= Test("gap-a thin f1", fns.get(1)(10), 100);

    return result;
}

bool testClosureListAliasUnify()
{
    bool result = true;

    // `list<IntUnary>` (alias spelling) must be the SAME instantiation as
    // `list<Lambda<int(int)>>` (direct) - same encoded element type.
    int cap = 5;
    list<IntUnary> fns;
    fns.add((int x) => x + cap);
    result &= Test("gap-a alias-unify", fns.get(0)(10), 15);

    return result;
}

// Takes the `int` spelling; the caller below hands it the `i32` spelling. A POINTER parameter,
// so nothing is copied or transferred - the leg is about type IDENTITY, not ownership.
int countIntUnaryList(list<Lambda<int(int)>>* p) { return p->count(); }

bool testClosureListSpellingUnify()
{
    bool result = true;

    // `list<Lambda<i32(i32)>>` must be the SAME instantiation as `list<Lambda<int(int)>>`:
    // `int` and `i32` are one type, so the encoded element name must not fork on the spelling.
    // They used to encode as __fatfn_1_3_int_3_int and __fatfn_1_3_i32_3_i32 - two container
    // types of identical layout that did not interconvert.
    int cap = 5;
    list<Lambda<i32(i32)>> fns;
    fns.add((int x) => x + cap);
    result &= Test("gap-a spelling-unify call",  fns.get(0)(10),           15);
    result &= Test("gap-a spelling-unify ident", countIntUnaryList(&fns),   1);

    return result;
}

// A sugar target: any struct in scope, with Lambda fields of non-void return type.
struct FnHolder
{
    Lambda<int(int)>      unary  = default;
    Lambda<int(int, int)> binary = default;
    Lambda<string(int)>   label  = default;
};

// A lambda passed as a <Tag/> ATTRIBUTE must infer its return type from the target
// field, exactly as the equivalent field assignment does. Void-returning attributes
// always worked; a value-returning one inferred void and emitted a bad `ret`.
bool testSugarLambdaAttrReturnType()
{
    bool result = true;

    FnHolder* h = <FnHolder unary={(int x) => { return x * 3; }}
                            binary={(int a, int b) => { return a + b; }}
                            label={(int n) => { return "n=" + n.toString(); }} />;

    result &= Test("sugar attr int(int)",      h.unary(5),     15);
    result &= Test("sugar attr int(int,int)",  h.binary(2, 3), 5);

    string s = h.label(7);
    result &= Test("sugar attr string(int)", s, "n=7");

    delete h;
    return result;
}

// A by-reference capture is marked as a borrow to stop the env destructing the caller's value.
// That marking lands on every struct that is not deep-copyable - which includes plain PODs. A POD
// copy owns nothing and cannot dangle, so storing a captured POD into a field must stay legal:
// the borrow-into-field reject applies only to pointers and owning value types.
struct CapPoint  { int x = 0; int y = 0; };
struct CapHolder { CapPoint p = default; };

bool testClosureCapturedPodIntoField()
{
    bool result = true;

    CapPoint src = default;
    src.x = 5;
    src.y = 9;

    Lambda<int()> f = () => { CapHolder h = default; h.p = src; return h.p.x + h.p.y; };
    result &= Test("captured POD stored into field", f(), 14);

    // The capture borrows: the source is untouched and still readable after the call.
    result &= Test("captured POD source intact", src.x, 5);
    return result;
}

// Brace-init of a closure FIELD from a named source. Brace-init is a SECOND, independent
// field-store path, so it must auto-clone the env exactly as the `=` store does (Option A
// clone-by-default). Aliasing it instead left the source local and the field owning one env,
// which the source's scope-exit destructor then freed under the field (use-after-free).
struct BraceClosureBox { Lambda<int(int)> f = default; };

bool testClosureBraceInitClonesEnv()
{
    bool result = true;

    int cap = 7;
    Lambda<int(int)> src = (int x) => { return x + cap; };
    BraceClosureBox b = { f = src };

    result &= Test("brace-init closure field call", b.f(1), 8);
    // The clone is independent: the source is still live and callable after the store.
    result &= Test("brace-init closure source intact", src(2), 9);
    return result;
}

// Reading a closure FIELD into a LOCAL (`Lambda<...> h = t.get;`) and RETURNING one
// (`return p->get;`) are the two paths that fell outside the whole-variable clone: the source's
// TAGGED OWNED env was shallow-copied, so the local's scope-exit destructor and the struct's
// field destructor both freed it (silent double free - correct output, then SIGBUS/SIGSEGV at
// teardown). Both now clone (Option A), so each side owns an independent env.
struct FieldClosureBox { Lambda<int()> get = default; };

Lambda<int()> takeBoxClosure(FieldClosureBox* p) { return p->get; }

bool testClosureFieldReadIntoLocal()
{
    bool result = true;

    int cap = 7;

    // Stack struct: field -> local.
    FieldClosureBox t = default;
    t.get = () => { return cap; };
    Lambda<int()> h = t.get;
    result &= Test("stack field closure into local", h(), 7);
    result &= Test("stack field still callable",     t.get(), 7);

    // Heap struct: field -> local.
    FieldClosureBox* p = new FieldClosureBox();
    p->get = () => { return cap + 1; };
    Lambda<int()> h2 = p->get;
    result &= Test("heap field closure into local", h2(), 8);
    result &= Test("heap field still callable",     p->get(), 8);

    // Returning a closure field from a function.
    Lambda<int()> h3 = takeBoxClosure(p);
    result &= Test("returned field closure",      h3(), 8);
    result &= Test("field intact after return",   p->get(), 8);

    delete p;
    return result;
}

// A nested (inner) lambda that references a local of the ENCLOSING FUNCTION reaches it
// TRANSITIVELY through the outer lambda. The outer lambda must capture it too, so the inner
// closure reads it out of the outer env (which dominates in the outer body) rather than the
// enclosing function's alloca (which does not) - previously a module-verification failure.
// See internal/issue/nested-closure-transitive-capture-verify-failure.md.
struct NestPair { int a = 0; int b = 0; };

bool testNestedClosureTransitiveCapture()
{
    bool result = true;

    // Inner captures an enclosing-function primitive local.
    int o = 2;
    Lambda<int()> g = () => { Lambda<int()> h = () => { return o; }; return h(); };
    result &= Test("nested transitive capture int", g(), 2);

    // Inner captures an enclosing struct local (by value).
    NestPair p = default; p.a = 7; p.b = 3;
    Lambda<int()> gs = () => { Lambda<int()> h = () => { return p.a + p.b; }; return h(); };
    result &= Test("nested transitive capture struct", gs(), 10);

    // Three levels deep: the capture bubbles up one frame at a time.
    int q = 4;
    Lambda<int()> g3 = () => {
        Lambda<int()> h3 = () => { Lambda<int()> i3 = () => { return q * 10; }; return i3(); };
        return h3();
    };
    result &= Test("nested transitive capture 3-level", g3(), 40);

    // Inner captures the OUTER lambda's own parameter (no enclosing-function frame involved).
    Lambda<int(int)> gp = (int base) => { Lambda<int()> h = () => { return base * 2; }; return h(); };
    result &= Test("nested capture outer param", gp(21), 42);

    // Inner captures NOTHING from the outer scope - the outer lambda gets no transitive capture.
    Lambda<int()> gn = () => { Lambda<int()> h = () => { return 5; }; return h(); };
    result &= Test("nested no-capture", gn(), 5);

    return result;
}

// A lambda PARAMETER whose name matches a local (or parameter) of the ENCLOSING function must
// shadow it: references inside the lambda resolve to the parameter, not the enclosing binding.
// Resolving to the enclosing alloca produced a module-verification failure (the inner function
// loaded storage that does not dominate). See internal/issue (lambda-param-shadows-enclosing-local).
int shadowOuter(int o) { Lambda<int(int)> h = (int o) => { return o + 1; }; return h(41); }

bool testLambdaParamShadowsEnclosing()
{
    bool result = true;

    // Param shadows an enclosing LOCAL of the same name.
    int o = 99;
    Lambda<int(int)> h = (int o) => { return o + 1; };
    result &= Test("lambda param shadows enclosing local", h(41), 42);

    // Param shadows an enclosing PARAMETER of the same name.
    result &= Test("lambda param shadows enclosing param", shadowOuter(999), 42);

    // Nested: the inner lambda's param shadows the enclosing-function local; the outer lambda
    // must not transitively capture the (shadowed) name.
    int q = 7;
    Lambda<int()> g = () => { Lambda<int(int)> hi = (int q) => { return q + 1; }; return hi(41); };
    result &= Test("nested lambda param shadows enclosing local", g(), 42);

    // A same-named enclosing local is still captured normally when NOT shadowed by a param.
    int base = 100;
    Lambda<int(int)> cap = (int x) => { return x + base; };
    result &= Test("no-shadow capture still works", cap(42), 142);

    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────────────────────

// -- Argument provenance / signature gating (must-keep-working side) ---------
//
// Two rejections were added for function-pointer arguments: a provable DATA pointer into a thin
// `function<>` slot, and a function pointer whose SIGNATURE disagrees with the parameter's. Both
// reject only what they can PROVE, so every legal spelling below must still bind and produce its
// value. A ternary join is a select/phi and a `??` join is a load from an alloca - neither
// carries any closure evidence, so an allowlist-shaped gate would false-reject them.

int thinCall(function<int(int)> f)   { return f(5); }
int fatCall(Lambda<int(int)> f)      { return f(5); }
int fatCall(double d)                { return 300 + (int)d; }   // same arity: forces the scorer

// Two candidates of the SAME arity: the funcptr arm must still win for a MATCHING signature.
// (A distinct arity would let the arity filter decide and prove nothing about the scorer.)
int sigPick(function<int(int)> f)    { return 100 + f(5); }
int sigPick(double d)                { return 200 + (int)d; }

int add10FnPtr(int x)                { return x + 10; }

// Signature EQUIVALENCE across spellings. The compiler treats int/i32, long/i64 and any two
// pointer types as one type, so a differing SPELLING is not evidence of a differing type and
// must still bind - on the scorer, on the single-candidate path, and through a vtable slot.
int spellCall(function<i32(i32)> f)  { return f(5); }
int spellCall(double d)              { return 400 + (int)d; }   // same arity: forces the scorer
int spellCallOnly(function<i32(i32)> f)  { return f(5); }
long add10Long(long x)               { return x + (long)10; }
int spellCallI64(function<i64(i64)> f)   { return (int)f((i64)5); }
void takeVoidPtr(void* p)            { int* ip = (int*)p; ip[0] = 15; }
int spellCallVoidPtr(function<void(void*)> f) { int q = 0; f(&q); return q; }

interface ISpell { int lam(function<i32(i32)> f); };
class SpellImpl : ISpell { int lam(function<i32(i32)> f) { return f(5); } };

// The signature proof compares canonical COMPONENTS, so every equivalence the compiler already
// honours has to survive component-wise or these legal calls become hard errors. `string` carries
// Pointer == false yet interconverts with `char*`, so it must normalize to `char*` BEFORE the
// pointer shape is read; a `using` alias must resolve to its target first; an unsubstituted
// generic parameter and an interface are NOT proof of anything and must keep binding.
// Each pair below has a same-arity `double` sibling on purpose, so the overload SCORER decides.
using SigInt = int;
int add10Alias(SigInt x)                     { return x + 10; }
int spellCallAlias(function<int(int)> f)     { return f(5); }
int spellCallAlias(double d)                 { return 700 + (int)d; }

int onCharPtrArg(char* s)                    { return 17; }
int spellCallString(function<int(string)> f) { return f("hi"); }
int spellCallString(double d)                { return 700 + (int)d; }

int onStringArg(string s)                    { return 18; }
int spellCallCharPtr(function<int(char*)> f) { return f("hi"); }
int spellCallCharPtr(double d)               { return 700 + (int)d; }

// A struct component proves only its OWN identity - the same struct spelled through an alias is
// one type, and must still bind. (The rejection this guards is in err_data_pointer_to_closure_param.cb.)
struct SigRec { int v = default; };
using SigRecAlias = SigRec;
void onSigRec(SigRecAlias* r)                { r->v = 24; }
int spellCallRec(function<void(SigRec*)> f)  { SigRec r; f(&r); return r.v; }
int spellCallRec(double d)                   { return 700 + (int)d; }

interface IShapeSig { int sides(); };
class SigTri : IShapeSig { int sides() { return 22; } };
int onSigShape(IShapeSig s)                  { return s.sides(); }
int spellCallIface(function<int(IShapeSig)> f) { SigTri t; IShapeSig s = t; return f(s); }
int spellCallIface(double d)                 { return 700 + (int)d; }

int gCallSig<T>(function<T(T)> f, T v)       { return (int)f(v); }

// SIGNEDNESS is not part of an llvm::FunctionType - `u32(u32)` and `i32(i32)` both lower to
// `i32(i32)` - so a signedness difference must BIND, at scalar and at pointee level alike.
// An earlier revision put signedness in the canonical token and hard-errored on all four of
// these; core/com.cb and core/ui_native/winui.cb are dense with `function<u32(...)>` slots.
int add10Signed(int x)                       { return x + 10; }
int spellCallU32(function<u32(u32)> f)       { return (int)f((u32)5); }
int spellCallU32(double d)                   { return 700 + (int)d; }

i64 add10I64(i64 x)                          { return x + 10; }
int spellCallU64(function<u64(u64)> f)       { return (int)f((u64)5); }
int spellCallU64(double d)                   { return 700 + (int)d; }

int onCharPtrSigned(char* s)                 { return 65; }
int spellCallU8Ptr(function<int(u8*)> f)     { return f((u8*)"hi"); }
int spellCallU8Ptr(double d)                 { return 700 + (int)d; }

// A signature records the SOURCE SPELLING, so a bare `Pt` written inside `namespace SigNs` and
// the global `Pt` are the same string at comparison time. That ambiguity must resolve to "no
// proof" and BIND - guessing the global would reject this legal program.
struct SigPt { int a = default; };
namespace SigNs
{
    struct SigPt { int a = default; int b = default; int c = default; };
    void touchNs(SigPt* p)                   { p->a = 5; }
    int runNs(function<void(SigPt*)> f)      { SigPt q; f(&q); return q.a; }
}

// A GENERIC INSTANTIATION as a pointee. A signature records the MANGLED key (`Box__i32`), and
// monomorphization keeps signedness and the target-native widths, so `SigBox<i32>` and
// `SigBox<u32>` are two instantiations - correct at the source level, since `u32` divides and
// prints differently. Neither difference changes LAYOUT, though, so all three crossings below
// must BIND. `SigBox<double>` vs `SigBox<i32>` DOES change layout and is the reject leg in
// Test/errors/err_data_pointer_to_closure_param.cb.
struct SigBox<T> { T v = default; };
void onSigBoxInt(SigBox<int>* b)                  { b->v = 51; }
int  sigBoxI32(function<void(SigBox<i32>*)> f)    { SigBox<i32> q = default; f(&q); return (int)q.v; }
int  sigBoxI32(double d)                          { return 700 + (int)d; }

void onSigBoxU32(SigBox<u32>* b)                  { b->v = (u32)51; }
int  sigBoxIntSlot(function<void(SigBox<int>*)> f) { SigBox<int> q = default; f(&q); return q.v; }
int  sigBoxIntSlot(double d)                      { return 700 + (int)d; }

void onSigBoxLong(SigBox<long>* b)                { b->v = (long)51; }
int  sigBoxI64(function<void(SigBox<i64>*)> f)    { SigBox<i64> q = default; f(&q); return (int)q.v; }
int  sigBoxI64(double d)                          { return 700 + (int)d; }

// A function-pointer / closure VALUE does not implicitly convert to a `void*` parameter - it is
// code, not data, and ISO C has no function-to-object-pointer conversion either. Without that gate
// a candidate refuted on its SIGNATURE simply rebound onto this pointer-absorbing sibling and the
// call ran silently (rejecting in the scorer is a PREFERENCE verdict, not a validation one). The
// two legs below assert both halves: the void* arm must not steal a matching function-pointer
// call, and it must still take a real DATA pointer. The mismatched-signature call is now a reject
// leg in Test/errors/err_data_pointer_to_closure_param.cb.
int rebindProbe(function<int(int)> f) { return f(5); }
int rebindProbe(void* p)              { return 999; }

// The same accept set one parameter type over. The gate above was keyed on the pointee NAME, so a
// refuted candidate rebound onto any OTHER pointer sibling instead; it is now on the ARGUMENT
// being code and covers every data-pointer parameter, including the non-pointer `string` one
// reached through the implicit char* -> string coercion. Widening a rejection breaks its accept
// set first, so each shape that must KEEP binding a data parameter is a leg below.
struct RebindRec { int a = default; int b = default; };
int rebindRecProbe(function<int(int)> f) { return f(5); }
int rebindRecProbe(RebindRec* r)         { return 909; }
int rebindStrProbe(function<int(int)> f) { return f(5); }
int rebindStrProbe(string s)             { return 500 + (int)s.length(); }

// A VARIADIC candidate is taken as a fallback with no per-argument scoring, so the gate had to be
// repeated in that short-circuit. Only the DECLARED parameters are judged there - an argument in
// the `...` tail has no parameter to disagree with, and C passes function pointers through `...`
// routinely. These are the shapes that must keep binding; the reject legs are in
// Test/errors/err_data_pointer_to_closure_param.cb.
int rebindVarProbe(RebindRec* r, ...)          { return 920 + r->a; }
int rebindVarFn(function<int(int)> f, ...)     { return 100 + f(5); }

// A MONOMORPHIZED generic parameter carries the LITERAL `__closure_fat_ptr` TypeName, which is not
// in IsEncodedClosureType's map, so a parameter-side predicate spelled only from that map
// false-rejects a generic variadic taking a closure - with a self-refuting message, since the dump
// prints `__closure_fat_ptr` for both the argument and the parameter. The value is forwarded to a
// `Lambda<>` callee so the leg proves the closure arrives intact rather than merely binding.
int rebindGenApply(Lambda<int(int)> f) { return f(41); }
int rebindGenVar<T>(T v, ...)          { return rebindGenApply(v); }
int rebindGenPlain<T>(T v)             { return rebindGenApply(v); }

// Two slots that differ ONLY in how many '*' a signature component carries. They must be two
// distinct overloads, and each must select the arm whose depth matches.
void depthWriteOne(int* p)   { *p = 1; }
void depthWriteTwo(int** pp) { **pp = 2; }
int  depthSlot(function<void(int*)> f)  { int v = 0; f(&v); return 10 + v; }
int  depthSlot(function<void(int**)> f) { int v = 0; int* q = &v; f(&q); return 20 + v; }

// A NAMED function argument carries its signature in the function table, not on the argument, so
// the component proof used to be skipped for it entirely: `sigPickSlot(sigPickDbl)` scored the
// `int(int)` slot as a perfect match and entered a `double(double)` body through it, returning
// 101 - a plausible wrong number, exit 0, no diagnostic.
int    sigPickInt(int x)    { return x + 1; }
double sigPickDbl(double x) { return x + 1.0; }
int sigPickSlot(function<int(int)> f)       { return 100 + f(1); }
int sigPickSlot(function<double(double)> f) { return 200 + (int)f(1.0); }

// A callback taking FEWER parameters than the slot supplies. Load-bearing, not an accident: the
// synthesized `onStdout` field is `void(char*, int)` and doc/LANGUAGE.md documents the
// one-parameter form (Test/test_program.cb binds exactly that). Under cdecl the caller cleans up,
// so the argument the callee never reads is ignored. The declaration-site signature proof must
// keep accepting it - the reject legs it DOES fire on are in
// Test/errors/err_data_pointer_to_closure_param.cb. The MIRROR direction is unsafe and is refused.
int g_prefixArityCalls = 0;
void prefixArityOne(char* s) { g_prefixArityCalls = g_prefixArityCalls + 1; }

bool testFuncPtrArgProvenanceAccepts()
{
    bool result = true;

    // A thin `function<>` value into a FAT `Lambda<>` parameter: the signature comparison must
    // ignore the thin/fat flavour, or this legal widening (WidenThinToFat) would be rejected.
    function<int(int)> thin = add10FnPtr;
    result &= Test("thin value into fat param", fatCall(thin), 15);

    // A `?:` join carries no closure evidence at all.
    function<int(int)> a = add10FnPtr;
    function<int(int)> b = doubleIt;
    int k = 1;
    result &= Test("ternary join into thin param", thinCall(k > 0 ? a : b), 15);
    result &= Test("ternary join other arm",       thinCall(k > 0 ? b : a), 10);

    // A `??` join lowers to a load from an alloca, not a select.
    function<int(int)>? maybe = add10FnPtr;
    result &= Test("null-coalesce join into thin param", thinCall(maybe ?? doubleIt), 15);

    // A matching signature still binds the function-pointer arm over a same-arity double arm.
    result &= Test("matching signature picks the funcptr arm", sigPick(thin), 115);
    result &= Test("double still picks the double arm",        sigPick(2.0), 202);

    // int vs i32 is ONE type spelled two ways. All three proof sites must stay permissive:
    // the overload scorer (two same-arity candidates), the single-candidate direct path, and
    // the interface lone-slot arm. A spelling-level comparison hard-errors on every one.
    result &= Test("int/i32 crossing, scorer",           spellCall(thin),     15);
    result &= Test("int/i32 crossing, single candidate", spellCallOnly(thin), 15);
    SpellImpl si;
    ISpell iso = si;
    result &= Test("int/i32 crossing, interface slot",   iso.lam(thin),       15);

    // `long` is TARGET-NATIVE - i32 under Windows LLP64, i64 under LP64 - so the crossing leg
    // pairs it with whichever fixed-width spelling names the same type on this target.
    function<long(long)> gl = add10Long;
    if const (__WINDOWS__)
    {
        result &= Test("long/i32 crossing", spellCall(gl), 15);
    }
    else
    {
        result &= Test("long/i64 crossing", spellCallI64(gl), 15);
    }
    // Any two pointer types are one class under opaque pointers.
    function<void(int*)> gp = takeVoidPtr;
    result &= Test("int*/void* crossing", spellCallVoidPtr(gp), 15);

    // Component-wise equivalences. A `string`/`char*` pair compared shape-first false-rejects
    // (string has Pointer == false); an alias compared before resolution false-rejects; a struct
    // or interface or unsubstituted generic component is not proof and must keep binding.
    function<SigInt(SigInt)> ga = add10Alias;
    result &= Test("alias hop crossing",     spellCallAlias(ga), 15);
    function<int(char*)> gs = onCharPtrArg;
    result &= Test("char*/string crossing",  spellCallString(gs), 17);
    function<int(string)> gt = onStringArg;
    result &= Test("string/char* crossing",  spellCallCharPtr(gt), 18);
    function<void(SigRecAlias*)> gr = onSigRec;
    result &= Test("struct pointee via alias", spellCallRec(gr), 24);
    function<int(IShapeSig)> gi = onSigShape;
    result &= Test("interface component binds", spellCallIface(gi), 22);
    function<int(int)> gg = add10FnPtr;
    result &= Test("generic component binds", gCallSig<int>(gg, 5), 15);

    // Signedness-only crossings - the isolated axis, with no width difference to carry them.
    function<int(int)> gu = add10Signed;
    result &= Test("u32/int crossing",     spellCallU32(gu), 15);
    function<i64(i64)> gu64 = add10I64;
    result &= Test("u64/i64 crossing",     spellCallU64(gu64), 15);
    function<int(char*)> gcp = onCharPtrSigned;
    result &= Test("char*/u8* crossing",   spellCallU8Ptr(gcp), 65);

    // Bare vs qualified struct spelling with a same-named global in scope.
    function<void(SigNs.SigPt*)> gns = SigNs.touchNs;
    result &= Test("namespace-ambiguous pointee binds", SigNs.runNs(gns), 5);

    // Generic-instantiation pointees whose type args are one type spelled two ways, or differ
    // only in signedness / a target-native width. All three are layout-identical, so all three
    // bind; each hard-errored before the mangled key was ABI-canonicalized.
    function<void(SigBox<int>*)> gbi = onSigBoxInt;
    result &= Test("SigBox int/i32 crossing",  sigBoxI32(gbi),     51);
    function<void(SigBox<u32>*)> gbu = onSigBoxU32;
    result &= Test("SigBox u32/int crossing",  sigBoxIntSlot(gbu), 51);
    // Same target-native split as the scalar leg above: `SigBox<long>` is `SigBox<i32>` on
    // Windows and `SigBox<i64>` on LP64.
    function<void(SigBox<long>*)> gbl = onSigBoxLong;
    if const (__WINDOWS__)
    {
        result &= Test("SigBox long/i32 crossing", sigBoxI32(gbl), 51);
    }
    else
    {
        result &= Test("SigBox long/i64 crossing", sigBoxI64(gbl), 51);
    }

    // The double arms prove each crossing set is a real two-candidate overload set, so the
    // legs above are testing the scorer rather than a lone candidate that binds regardless.
    result &= Test("SigBox set keeps double arm A", sigBoxI32(5.0),     705);
    result &= Test("SigBox set keeps double arm B", sigBoxIntSlot(6.0), 706);
    result &= Test("SigBox set keeps double arm C", sigBoxI64(7.0),     707);

    // The double arm of the crossing overload set is still reachable.
    result &= Test("crossing set keeps its double arm", spellCall(3.0), 403);
    result &= Test("component set keeps double arm",    spellCallAlias(1.0), 701);
    result &= Test("fat crossing set keeps double arm", fatCall(4.0),   304);

    // A MATCHING signature must still beat the pointer-absorbing sibling - the rejection is
    // per candidate, so the void* arm must not start stealing legal function-pointer calls.
    result &= Test("matching signature beats the void* sibling", rebindProbe(thin), 15);
    // ... and the gate is on the ARGUMENT's function-ness, not on the parameter: a real DATA
    // pointer still binds the void* arm. 999 is only reachable through that arm, so this leg
    // fails if the gate is ever widened from "is code" to "the parameter is void*".
    int rebindData = 3;
    result &= Test("data pointer still binds the void* sibling", rebindProbe(&rebindData), 999);
    // The two SHAPES that are data even though their pointee is code: the ADDRESS of a function
    // pointer slot, and an array of them. A first cut of the gate keyed on "the argument carries
    // function evidence" and rejected both - programs master compiles and runs.
    function<int(int)> rebindSlot = add10FnPtr;
    result &= Test("address of a funcptr slot binds void*", rebindProbe(&rebindSlot), 999);
    function<int(int)>[2] rebindArr = default;
    rebindArr[0] = add10FnPtr;
    result &= Test("array of funcptrs binds void*", rebindProbe(rebindArr), 999);

    // The same three shapes against a STRUCT-pointer sibling, plus the matching-signature half.
    // 909 is reachable only through the `RebindRec*` arm and 15 only through the funcptr arm, so
    // a gate that widens from "the argument is code" to "the parameter is a pointer" fails here.
    result &= Test("matching signature beats the struct sibling", rebindRecProbe(thin), 15);
    RebindRec rebindRecData = default;
    result &= Test("data pointer still binds the struct sibling", rebindRecProbe(&rebindRecData), 909);
    result &= Test("address of a funcptr slot binds struct sibling", rebindRecProbe(&rebindSlot), 909);
    result &= Test("array of funcptrs binds struct sibling", rebindRecProbe(rebindArr), 909);

    // A `string` parameter is not a pointer, so it is reached by the char* -> string coercion.
    // Both halves: a real char buffer still coerces, and a matching signature still wins.
    char[8] rebindBuf = default;
    rebindBuf[0] = 'x'; rebindBuf[1] = 'y'; rebindBuf[2] = (char)0;
    result &= Test("char* still coerces to the string sibling", rebindStrProbe(&rebindBuf[0]), 502);
    string rebindStrVal = "hello";
    result &= Test("string value still binds the string sibling", rebindStrProbe(rebindStrVal), 505);
    result &= Test("matching signature beats the string sibling", rebindStrProbe(thin), 15);

    // The variadic accept set. 923 is reachable only through the declared `RebindRec*`, and the
    // tail leg passes a function pointer through `...` - the shape a gate applied to the whole
    // argument list instead of the declared prefix breaks first.
    rebindRecData.a = 3;
    result &= Test("data pointer still binds a variadic data param", rebindVarProbe(&rebindRecData), 923);
    result &= Test("funcptr through the ... tail still binds", rebindVarProbe(&rebindRecData, add10FnPtr), 923);
    // The tail's other two argument shapes. The leg above passes a NAMED function; a `function<>`
    // VALUE and a FAT `Lambda<T>` value are what the variadic gate actually inspects, and both
    // already compile and return 923 on a pre-fix binary - so widening that gate to judge the
    // whole argument list, or to judge a scalar in the tail, breaks these first.
    result &= Test("funcptr VALUE through the ... tail still binds", rebindVarProbe(&rebindRecData, thin), 923);
    Lambda<int(int)> rebindFatTail = (int x) => { return x + 1; };
    result &= Test("fat closure through the ... tail still binds", rebindVarProbe(&rebindRecData, rebindFatTail), 923);

    // The generic-variadic closure shape. Only the variadic spelling crosses the gate; the twin is
    // the control that the shape works without it. 42 is reachable only if the closure survives.
    Lambda<int(int)> rebindGenClosure = (int x) => { return x + 1; };
    result &= Test("generic variadic takes a fat closure", rebindGenVar(rebindGenClosure), 42);
    result &= Test("generic non-variadic takes a fat closure", rebindGenPlain(rebindGenClosure), 42);
    result &= Test("matching signature binds a variadic funcptr param", rebindVarFn(thin), 115);

    return result;
}

int spAcceptDbl(int x) { return x * 2; }
int spAcceptSq(int x)  { return x * x; }
int spTakesPtrAccept(function<int(int)>* fp) { return (*fp)(4); }
int spOnlyAccept(function<int(int)> f) { return f(3); }
int spCheckPtrNull(function<int(int)>* fp) { return fp == nullptr ? -1 : 0; }
double spSumViewAccept(function<int(int)>[] fs) { return fs == nullptr ? -1.0 : 0.0; }

// The gate is applied at virtual dispatch and to an ENCODED (monomorphized generic) closure
// parameter too, so the shape-0 -> shape-0 crossing must keep binding through both.
interface ISpShape { int only(function<int(int)> f); };
class SpShapeImpl : ISpShape { int only(function<int(int)> f) { return f(3); } };

// Accept set for the shape-mismatch gate (fix/shape-arg): every crossing that must stay legal
// once `function<T>`, `function<T>*` and `function<T>[]` mismatches start being rejected.
// Frozen BEFORE the reject was written (per internal/skill/fix-issue - build the accept set
// first), then re-run after: every leg here passed on the pre-fix binary too.
bool testFuncPtrShapeGateAccepts()
{
    bool result = true;

    // shape 2 (ARRAY) -> shape 1 (POINTER): a fixed `function<T>[N]` decays to the address of
    // its own element 0, which IS what a `function<T>*` parameter wants - the array's own
    // address and `&arr[0]` are the same bits. Must stay legal: only ARRAY -> VALUE (a plain
    // `function<T>` slot, which needs the callable itself, not an address) is the live bug.
    function<int(int)>[2] spArrAccept = { spAcceptDbl, spAcceptSq };
    result &= Test("shape_array_into_pointer_decay", spTakesPtrAccept(spArrAccept), 8);

    // shape 0 (an array ELEMENT, not the array itself) -> shape 0 (VALUE): `arr[0]` is a plain
    // value read (a GEP, not the whole allocation), so it must keep binding a value parameter.
    result &= Test("shape_array_element_into_value", spOnlyAccept(spArrAccept[1]), 9);

    // nullptr into every pointer/view shape: a null literal carries no shape flags at all and
    // must not be mistaken for a shape-0 value (it is never called, only compared).
    result &= Test("shape_nullptr_into_pointer", spCheckPtrNull(nullptr), -1);
    result &= Test("shape_nullptr_into_view", (int)spSumViewAccept(nullptr), -1);

    // Two-arm overload ranking by shape (the pre-existing 4000fa1 behaviour) must be unaffected:
    // the correctly-shaped arm is chosen, so the gate (which only fires on a SELECTED mismatch)
    // never sees a disagreement here.
    function<int(int)>[2] spShapeArr;
    spShapeArr[0] = spAcceptDbl;
    spShapeArr[1] = spAcceptSq;
    function<int(int)> spShapeOne = spAcceptSq;
    result &= Test("shape_overload_picks_array_arm", pickFnPtrShape(spShapeArr, 3), 106);
    result &= Test("shape_overload_picks_pointer_arm", pickFnPtrShape(&spShapeOne, 3), 209);

    // VIRTUAL dispatch: the same gate runs in CallInterfaceMethod, so a matching value->value
    // crossing through a vtable slot must stay legal - both the variable and the bare-name
    // spelling. The rejecting faces of the same slot are legs in err_data_pointer_to_closure_param.
    SpShapeImpl spImpl;
    ISpShape spIface = spImpl;
    function<int(int)> spIfaceVal = spAcceptDbl;
    result &= Test("shape_iface_value_into_value", spIface.only(spIfaceVal), 6);
    result &= Test("shape_iface_named_into_value", spIface.only(spAcceptDbl), 6);

    // ENCODED closure parameter (list<function<int(int)>>::add's `T value`): the gate's parameter
    // predicate now covers it, so a plain value must still bind and remain callable.
    list<function<int(int)>> spList;
    spList.add(spIfaceVal);
    spList.add(spAcceptSq);
    result &= Test("shape_encoded_closure_value_into_value", spList[0](3), 6);
    result &= Test("shape_encoded_closure_named_into_value", spList[1](3), 9);

    return result;
}

// --- A `function<>` CALL RESULT passed to a closure parameter -----------------
// The call result carried the CALLEE's name in CallerName, and the fat-closure argument arm
// re-resolved that name to the callee's own address - so the closure's code slot became the
// PRODUCER (`makeFree`) instead of the produced value, and the call returned a function
// address printed as an int. Every producer spelling below feeds the same fat slot, since the
// defect keys on the name resolving in the function table, not on how the value was made.

int callResultDbl(int x)                 { return x * 2; }
function<int(int)> makeCallResult()      { return callResultDbl; }
using CallResultCb = function<int(int)>;
CallResultCb makeCallResultAlias()       { return callResultDbl; }
// Overloaded producer whose other arm has a DIFFERENT arity - the shape the single-overload
// early return in GetFunctionForFuncPtr cannot see.
function<int(int)> makeCallResultOv()    { return callResultDbl; }
int makeCallResultOv(int a, int b)       { return a + b; }

// Producer with a SAME-ARITY sibling of the same name. The worst pre-fix shape in this family:
// re-resolving picked the sibling and the call returned a PLAUSIBLE 1005, not a stray address.
function<int(int)> callResultProd()      { return callResultDbl; }
int callResultProd(int x)                { return x + 1000; }

// A local `function<>` whose NAME collides with a global function: the name resolved in the
// function table, so the local's value was discarded and the global was called instead.
int callResultShadow(int x)              { return x * 100; }
int callResultTrip(int x)                { return x * 3; }

// The re-resolve's own two jobs, which the guard must NOT disable for a bare function name.
// (1) arity: TWO overloads exist, so the single-overload early return is escaped and the arity
//     filter picks. The 2-arg arm is declared FIRST, so a count-blind pick returns it.
int callResultOvf(int a, int b)          { return a + b; }
int callResultOvf(int x)                 { return x * 2; }
// (2) 'move' modifiers: same name, same arity, differing only in `move`.
int callResultCons(MovePayload* p)       { return p->value + 1; }
int callResultCons(move MovePayload* p)  { int v = p->value; delete p; return v + 2; }
int callResultTakeMove(Lambda<int(move MovePayload*)> f)
{
    MovePayload* q = new MovePayload();
    q->value = 7;
    return f(q);
}

namespace CallResultNs
{
    function<int(int)> makeNs()          { return callResultDbl; }
    int nsFat(Lambda<int(int)> f)        { return f(5); }
}

class CallResultMaker
{
    int tag = default;
    function<int(int)> makeMethod()        { return callResultDbl; }
    static function<int(int)> makeStatic() { return callResultDbl; }
};

interface ICallResult { int lam(Lambda<int(int)> f); };
class CallResultTaker : ICallResult
{
    int tag = default;
    int lam(Lambda<int(int)> f)   { return f(5); }
    int thin(function<int(int)> f) { return f(5); }
};

// Taker shapes other than "fat parameter at index 0 of a plain method".
int callResultFatAt1(int a, Lambda<int(int)> f)   { return a + f(5); }
class CallResultG<T> { int tag = default; int lam(Lambda<int(int)> f) { return f(5); } };

bool testFuncPtrCallResultIntoClosureParam()
{
    bool result = true;

    CallResultTaker t;
    ICallResult io = t;
    CallResultMaker m;

    // The reported shape: a free producer into a fat `Lambda<>` method parameter.
    result &= Test("call result -> fat method",      t.lam(makeCallResult()),   10);
    result &= Test("call result -> fat free fn",     fatCall(makeCallResult()), 10);
    // The interface path was already correct; keep it as the parity leg.
    result &= Test("call result -> fat interface",   io.lam(makeCallResult()),  10);

    // Producer kind must not matter.
    result &= Test("method result -> fat",           t.lam(m.makeMethod()),              10);
    result &= Test("static result -> fat",           t.lam(CallResultMaker.makeStatic()), 10);
    result &= Test("namespaced result -> fat",       t.lam(CallResultNs.makeNs()),       10);
    result &= Test("alias-typed result -> fat",      t.lam(makeCallResultAlias()),       10);
    result &= Test("overloaded producer -> fat",     t.lam(makeCallResultOv()),          10);
    result &= Test("overloaded producer other arm",  makeCallResultOv(3, 4),             7);

    // The THIN destination takes a different arm; assert it rather than assume parity.
    result &= Test("call result -> thin method",     t.thin(makeCallResult()),   10);
    result &= Test("call result -> thin free fn",    thinCall(makeCallResult()), 10);

    // Taker shape must not matter either: a fat parameter that is not argument 0, a method on a
    // GENERIC class, and a namespaced free function all reach the same arm.
    result &= Test("call result -> fat param at index 1", callResultFatAt1(100, callResultProd()), 110);
    CallResultG<int> gi;
    result &= Test("call result -> generic class method",  gi.lam(callResultProd()),         10);
    result &= Test("call result -> namespaced taker",      CallResultNs.nsFat(callResultProd()), 10);

    // A producer with a SAME-ARITY sibling of its own name returned a plausible wrong answer
    // (1005) rather than an obvious address - the shape least likely to be noticed.
    result &= Test("producer with same-arity sibling",     fatCall(callResultProd()),        10);

    // A local closure whose NAME collides with a global function: the local's VALUE must win.
    function<int(int)> callResultShadow = callResultTrip;
    result &= Test("local shadowing a function name",      fatCall(callResultShadow),        15);

    // A NAMED function argument must still re-resolve. Both legs need TWO OVERLOADS of the name,
    // or GetFunctionForFuncPtr's single-overload early return answers first and the
    // multi-candidate arm that does the picking is never reached at all.
    result &= Test("named arg re-resolves by arity",       fatCall(callResultOvf),           10);
    g_move_fp_dtor_count = 0;
    result &= Test("named arg re-resolves by move flags",  callResultTakeMove(callResultCons), 9);
    result &= Test("the move overload really ran",         g_move_fp_dtor_count,             1);

    // POINTER DEPTH is part of the signature. The reject side lives in
    // Test/errors/err_data_pointer_to_closure_param.cb; these are the must-still-BIND legs, and
    // without them a blanket ban on `**` would look identical to the narrowing that was intended.
    // Depth also has to reach the overload NAME: before it did, these two slots mangled to one
    // symbol, so the second was a redefinition of the first rather than a sibling overload.
    function<void(int*)>  d1 = depthWriteOne;
    function<void(int**)> d2 = depthWriteTwo;
    result &= Test("matching depth 1 binds",     depthSlot(d1), 11);
    result &= Test("matching depth 2 binds",     depthSlot(d2), 22);
    // The NAMED-function form resolves through the function table rather than a stored value, so
    // it carries depth by a different route and needs its own leg.
    result &= Test("named arg picks by depth",   depthSlot(depthWriteTwo), 22);

    // ...and the same route has to pick by the whole signature, not just by depth. Both legs are
    // needed: one alone passes if the scorer simply always takes the FIRST slot.
    result &= Test("named arg picks int slot",    sigPickSlot(sigPickInt), 102);
    result &= Test("named arg picks double slot", sigPickSlot(sigPickDbl), 202);

    // The DECLARATION site now proves the destination's signature too. This is the leg that keeps
    // that proof from becoming a blanket ban on any arity difference.
    g_prefixArityCalls = 0;
    function<void(char*, int)> pa = prefixArityOne;
    pa("hi", 2);
    result &= Test("declaration-site prefix arity", g_prefixArityCalls, 1);

    return result;
}

/*
 * Accept set for the code-value STORE gate (a code VALUE into a data-pointer destination at a
 * declarator initializer, an assignment - which also carries the field, element and global stores
 * - and a `return`). Widening a rejection breaks its accept set first, so every neighbouring shape
 * that master compiles and runs correctly is a value leg here.
 *
 * These legs pass on the pre-fix binary too, by construction: they discriminate against an
 * OVER-BROAD guard, not against master. The reject half lives in
 * Test/errors/err_data_pointer_to_closure_param.cb and is what fails on the pre-fix binary.
 */
struct StoreRec { int a = default; int b = default; };
struct StoreBox { StoreRec* p = default; function<double(double)> f = default; };
using StoreCb = function<double(double)>;

double storeRo(double x)  { return x + 1000.0; }
double storeR2(double x)  { return x + 2000.0; }

// A function pointer whose RETURN TYPE is a data pointer: the call RESULT is genuine data and must
// keep reaching every destination the gate reads. This is the shape a source-side predicate that
// looked at the recorded signature (rather than at the value's shape) would false-reject.
StoreRec* storeMakeRec(int v) { StoreRec* r = new StoreRec(); r->a = v; return r; }
StoreRec* storeFwdCall(function<StoreRec*(int)> f) { return f(9); }

// `function<T>*` is the ADDRESS of a slot and `function<T>[N]` decays to one - both are real DATA
// pointers. A wholesale rejection of `function<T>*` was landed once and had to be reverted.
void storeSetThrough(function<double(double)>* out) { *out = storeRo; }
void* storeRawSlot(function<double(double)>* a)     { return a; }
double storeSumView(function<double(double)>[] fs)  { return fs[0](1.0) + fs[1](1.0); }

bool testCodeValueStoreAccepts()
{
    bool result = true;

    StoreCb w = storeRo;

    // An EXPLICIT cast is the escape hatch the rejection's message points at; it must keep working
    // at every destination shape. Assert non-null rather than a value: the address is the point.
    StoreRec* castRec = (StoreRec*)w;
    void*     castVoid = (void*)w;
    result &= Test("cvs_cast_rec_nonnull",  castRec  == nullptr ? 0 : 1, 1);
    result &= Test("cvs_cast_void_nonnull", castVoid == nullptr ? 0 : 1, 1);

    // A code value into a FUNCTION-TYPED destination, in every spelling the gate can see:
    // decl-init, assignment, struct field, alias-typed local, and a returned call result.
    StoreCb declInit = storeRo;
    StoreCb assigned = default; assigned = storeR2;
    StoreBox box = default; box.f = storeRo;
    StoreCb aliased = default; aliased = declInit;
    result &= Test("cvs_fn_declinit", (int)declInit(1.0), 1001);
    result &= Test("cvs_fn_assign",   (int)assigned(1.0), 2001);
    result &= Test("cvs_fn_field",    (int)box.f(1.0),    1001);
    result &= Test("cvs_fn_alias",    (int)aliased(1.0),  1001);

    // `function<T>*` out-parameter: a real store-through, not a constant fold.
    StoreCb outSlot = default;
    storeSetThrough(&outSlot);
    result &= Test("cvs_fnptr_out_param", (int)outSlot(1.0), 1001);

    // `function<T>*` into a `void*` DESTINATION - the pointer-to-a-slot is data, so the gate's
    // shape check (not just its destination check) is what has to let this through.
    void* rawSlot = storeRawSlot(&outSlot);
    result &= Test("cvs_fnptr_ptr_into_voidstar", rawSlot == nullptr ? 0 : 1, 1);

    // `function<T>[N]` element stores, the array as a view argument, and `&arr[0]` into `void*`.
    function<double(double)>[2] arr = default;
    arr[0] = storeRo;
    arr[1] = storeR2;
    void* arrAddr = &arr[0];
    result &= Test("cvs_fnptr_array_elem0", (int)arr[0](1.0), 1001);
    result &= Test("cvs_fnptr_array_elem1", (int)arr[1](1.0), 2001);
    result &= Test("cvs_fnptr_array_view",  (int)storeSumView(arr), 3002);
    result &= Test("cvs_fnptr_array_addr_into_voidstar", arrAddr == nullptr ? 0 : 1, 1);

    // The CALL RESULT of a function pointer returning a data pointer, at every gated destination.
    function<StoreRec*(int)> maker = storeMakeRec;
    StoreRec* fromInit = maker(7);
    StoreRec* fromAssign = nullptr; fromAssign = maker(8);
    StoreBox holder = default; holder.p = maker(3);
    StoreRec* fromReturn = storeFwdCall(maker);
    result &= Test("cvs_callret_declinit", fromInit->a,   7);
    result &= Test("cvs_callret_assign",   fromAssign->a, 8);
    result &= Test("cvs_callret_field",    holder.p->a,   3);
    result &= Test("cvs_callret_return",   fromReturn->a, 9);
    StoreRec* heldOut = move holder.p;
    delete fromInit;
    delete fromAssign;
    delete heldOut;
    delete fromReturn;

    // A plain data pointer into every destination the gate reads - the control that the gate is
    // not simply refusing pointer stores.
    StoreRec plain = default; plain.a = 42;
    StoreRec* borrowed = &plain;
    StoreBox plainBox = default; plainBox.p = borrowed;
    result &= Test("cvs_plain_ptr_declinit", borrowed->a,    42);
    result &= Test("cvs_plain_ptr_field",    plainBox.p->a,  42);

    return result;
}

/*
 * Accept set for the AGGREGATE and DEFAULT store spellings (brace field init, array aggregate,
 * struct/class field default, parameter default). Those are four more lowering paths the gate now
 * reads, and each one's rejection has to leave the legal neighbour compiling: a code value into a
 * FUNCTION-typed slot, and a real data pointer into a data slot, through the same syntax.
 *
 * These pass on the pre-fix binary too, by construction - they discriminate against an over-broad
 * guard. Measured on the merge base before the guard was written.
 */
struct AggRec { int a = default; int b = default; };
struct AggBoxFn  { function<double(double)> f = default; int n = default; };
struct AggBoxPtr { AggRec* p = default; int n = default; };
// Field DEFAULTS of function type, in both declaration kinds - struct and class have separate
// default-constructor emitters, so both are legs.
struct AggDefS { function<double(double)> f = aggRo; int n = 4; };
class  AggDefC { function<double(double)> f = aggRo; int n = 5; };

double aggRo(double x) { return x + 1000.0; }
double aggR2(double x) { return x + 2000.0; }

// A function-typed PARAMETER default: the omitted-argument wrapper is its own store path.
double aggCallDefault(function<double(double)> f = aggRo) { return f(1.0); }

bool testCodeValueAggregateStoreAccepts()
{
    bool result = true;

    // Brace-init of a FUNCTION-typed field, in all three brace spellings.
    AggBoxFn braceEq = { f = aggRo, n = 3 };
    AggBoxFn braceBare { f = aggR2, n = 4 };
    AggBoxFn* braceNew = new AggBoxFn { f = aggRo, n = 5 };
    result &= Test("cvs_brace_fn_field_eq",   (int)braceEq.f(1.0),   1001);
    result &= Test("cvs_brace_fn_field_bare", (int)braceBare.f(1.0), 2001);
    result &= Test("cvs_brace_fn_field_new",  (int)braceNew->f(1.0), 1001);
    result &= Test("cvs_brace_fn_field_n",    braceNew->n,           5);
    delete braceNew;

    // Brace-init of a POINTER field and a pointer array aggregate with REAL data pointers - the
    // control that the new aggregate gates are not simply refusing pointer slots.
    AggRec target = default; target.a = 42;
    AggBoxPtr bracePtr = { p = &target, n = 7 };
    AggRec*[2] arrPtr = { &target, &target };
    result &= Test("cvs_brace_ptr_field", bracePtr.p->a, 42);
    result &= Test("cvs_brace_ptr_n",     bracePtr.n,     7);
    result &= Test("cvs_agg_ptr_elem0",   arrPtr[0]->a,  42);
    result &= Test("cvs_agg_ptr_elem1",   arrPtr[1]->a,  42);

    // An array aggregate of FUNCTION values.
    function<double(double)>[2] arrFn = { aggRo, aggR2 };
    result &= Test("cvs_agg_fn_elem0", (int)arrFn[0](1.0), 1001);
    result &= Test("cvs_agg_fn_elem1", (int)arrFn[1](1.0), 2001);

    // The length-inferred array VIEW, whose gate is live through a `string` element (a pointer
    // element never reaches it - a pre-existing guard fires first). This is the accept twin of
    // that reject leg: a real string and a literal must both still land.
    string aggStr = "aa";
    string[] strView = { aggStr, "b" };
    result &= Test("cvs_agg_view_string_elem0", (int)strView[0].length(), 2);
    result &= Test("cvs_agg_view_string_elem1", (int)strView[1].length(), 1);

    // Field DEFAULTS of function type, struct and class.
    AggDefS ds = default;
    AggDefC dc = default;
    result &= Test("cvs_fielddefault_fn_struct", (int)ds.f(1.0), 1001);
    result &= Test("cvs_fielddefault_fn_class",  (int)dc.f(1.0), 1001);
    result &= Test("cvs_fielddefault_n_struct",  ds.n, 4);
    result &= Test("cvs_fielddefault_n_class",   dc.n, 5);

    // Parameter default of function type, omitted and supplied.
    result &= Test("cvs_paramdefault_fn_omitted",  (int)aggCallDefault(),       1001);
    result &= Test("cvs_paramdefault_fn_supplied", (int)aggCallDefault(aggR2),  2001);

    return result;
}

/*
 * Accept set for the JOIN spellings. The code-value gates now resolve a '?:' PHI and a '??' join
 * through a per-value code ledger, so the programs in the same neighbourhood that a join is the
 * NORMAL way to write must keep compiling and keep their values: a join of two code values into a
 * function slot, a join of two data pointers, a join whose code arm was explicitly cast, and a
 * join of CALL RESULTS whose return type happens to be a data pointer.
 *
 * These pass on the pre-fix binary too, by construction - they discriminate against an over-broad
 * guard, and each one was measured on the merge base before the resolution was written.
 */
struct JoinAcc    { int a = default; int b = default; };
struct JoinAccBox { function<double(double)> f = default; };

JoinAcc* joinAccMake(int v) { JoinAcc* r = new JoinAcc(); r->a = v; return r; }
double joinAccRo(double x) { return x + 1000.0; }
double joinAccR2(double x) { return x + 2000.0; }
double joinAccApply(function<double(double)> f) { return f(1.0); }
// TWO-argument sibling for the occurrence-keying accept legs: proves a cast at one argument
// position keeps laundering ITS OWN argument even when a sibling argument in the same call
// ALSO carries an explicit cast of the same shared function constant.
JoinAcc* joinAccTwoCast(JoinAcc* a, JoinAcc* b) { return a; }
// Non-dereferencing probe: the nested-join accept legs cast a CODE value to JoinAcc*, so the
// result is not a valid struct - only pointer identity may be tested, never a field read.
int joinAccOne(JoinAcc* p) { return p == nullptr ? 0 : 1; }
struct JoinAccNested { JoinAcc* p = default; int k = default; };
// An overload SET the join argument is scored against. The code-value rule is read by the
// scorer's refute arm, so a set is the shape where it can change WHICH candidate is chosen.
int joinAccPickOv(JoinAcc* p) { return p == nullptr ? 0 : p->a; }
int joinAccPickOv(function<double(double)> f) { return (int)f(1.0); }
int joinAccDataOv(JoinAcc* p) { return p == nullptr ? 0 : p->a; }
int joinAccDataOv(double d) { return 99; }
double joinAccPick(int c, function<double(double)> a, function<double(double)> b)
{
    function<double(double)> p = c > 0 ? a : b;
    return p(1.0);
}
// PER-ARM occurrence accept fixtures. Each '?:' / '??' arm now evaluates under its OWN cast
// occurrence id, so these shapes are the ones an over-eager per-arm scope would false-reject.
class JoinAccRes  { int v = default; ~JoinAccRes() { } };
class JoinAccNode { int v = default; int get() { return v; } };
// Instantiated more than once below: the arm ids are minted fresh on every monomorphization,
// so identical join SYNTAX must keep resolving the same way in each instantiation.
int joinAccGenJoin<T>(T seed, int c)
{
    JoinAcc* castJoin = c > 0 ? (JoinAcc*)joinAccRo : (JoinAcc*)joinAccR2;
    JoinAcc gx = default; gx.a = 11;
    JoinAcc gy = default; gy.a = 12;
    JoinAcc* dataJoin = c > 0 ? &gx : &gy;
    return (castJoin == nullptr ? 0 : 1) + dataJoin->a;
}

/*
 * ACCEPT SET for the MIRROR resolution: a '?:' / '??' join into a fat `Lambda<>` or thin
 * `function<>` PARAMETER. The closure-widen gate rejects only what is PROVABLY data, and a join
 * carries no declared facts, so it is resolved through the DATA ledger with the EVERY-arm
 * quantifier: the widen is refused only when every arm is proven data. The legs below are the
 * shapes an ANY-arm quantifier would false-reject - every one of them was measured running
 * correctly on the merge base first, and each flips to a hard error if the quantifier is inverted.
 * Discriminator for the mixed legs: exactly one arm is proven data, so ANY-arm rejects and
 * EVERY-arm accepts; the all-code legs discriminate against a guard that refuses joins outright.
 */
int djInc(int x) { return x + 1; }
int djDec(int x) { return x - 1; }
int djApplyFat(Lambda<int(int)> f) { return f(5); }
int djApplyThin(function<int(int)> f) { return f(5); }
Lambda<int(int)> djMake() { return djInc; }
class DjBox { int lam(Lambda<int(int)> f) { return f(5); } };
interface IDjBox { int lam(Lambda<int(int)> f); };
class DjIface : IDjBox { int lam(Lambda<int(int)> f) { return f(5); } };
// A MIXED join: one arm is a `void*` PARAMETER, which IS proven data (its declared type says so,
// exactly as a local's does), and the other is a proven code value. EVERY-arm leaves this accepted
// and the code arm is the one taken; ANY-arm would refuse it.
int djMixedUnknownArm(void* u, int c)
{
    function<int(int)> a = djInc;
    return djApplyFat(c > 0 ? a : u);
}
// The ESCAPE HATCH the rejection's message advises, in its JOIN spelling: an explicit cast to the
// thin `function<>` is the user's own assertion and must launder the whole join, not only an arm.
// A ptr->ptr cast is a no-op under opaque pointers, so the value reaching the gate is still the
// PHI - without the mirror launder this spelling is refused while the per-arm one is accepted.

bool testDataJoinClosureAccepts()
{
    bool result = true;
    int c = 1;

    // Two `function<>` values joined into one fat `Lambda<>` parameter - the first accept cell.
    function<int(int)> a = djInc;
    function<int(int)> b = djDec;
    result &= Test("dj_tern_two_function_values", djApplyFat(c > 0 ? a : b), 6);
    result &= Test("dj_tern_two_function_values_else", djApplyFat(c > 1 ? a : b), 4);
    result &= Test("dj_coal_two_function_values",  djApplyFat(a ?? b), 6);
    result &= Test("dj_tern_two_named_functions",  djApplyFat(c > 0 ? djInc : djDec), 6);
    result &= Test("dj_thin_two_function_values",  djApplyThin(c > 0 ? a : b), 6);

    // Two lambda VALUES, and a join whose arms are a call result (unledgered) and a lambda.
    Lambda<int(int)> la = (int x) => { return x + 1; };
    Lambda<int(int)> lb = (int x) => { return x - 1; };
    result &= Test("dj_tern_two_lambdas",     djApplyFat(c > 0 ? la : lb), 6);
    result &= Test("dj_tern_call_result_arm", djApplyFat(c > 0 ? djMake() : lb), 6);

    // MIXED: one proven-data arm and one code arm. ANY-arm rejects these; EVERY-arm must not.
    int q = 1;
    void* vp = &q;
    result &= Test("dj_tern_mixed_code_then_data", djApplyFat(c > 0 ? a : vp), 6);
    result &= Test("dj_tern_mixed_data_then_code", djApplyFat(c > 1 ? vp : a), 6);
    result &= Test("dj_tern_unknown_param_arm",    djMixedUnknownArm(nullptr, 1), 6);

    // The escape hatch, both placements: the cast OVER the whole join and the cast per ARM. Both
    // run on the merge base; the whole-join spelling is the one an arm-only launder false-rejects.
    void* fp = (void*)djInc;
    void* fq = (void*)djInc;
    result &= Test("dj_cast_over_join",  djApplyFat((function<int(int)>)(c > 0 ? fp : fq)), 6);
    result &= Test("dj_cast_in_each_arm", djApplyFat(c > 0 ? (function<int(int)>)fp
                                                           : (function<int(int)>)fq), 6);

    // The same accept, through the METHOD and VIRTUAL-dispatch spellings of the one gate.
    DjBox d;
    DjIface impl;
    IDjBox io = impl;
    result &= Test("dj_method_two_function_values", d.lam(c > 0 ? a : b), 6);
    result &= Test("dj_iface_two_function_values",  io.lam(c > 0 ? a : b), 6);

    return result;
}

bool testCodeValueJoinAccepts()
{
    bool result = true;
    int c = 1;

    // A join of two CODE values into a FUNCTION-typed slot - the destination accepts code, so no
    // gate may fire. Both join spellings, plus the call-argument and named-parameter positions.
    function<double(double)> w = joinAccRo;
    function<double(double)> w2 = joinAccR2;
    function<double(double)> empty = default;
    function<double(double)> ternIntoFn = c > 0 ? w : w2;
    function<double(double)> coalIntoFn = empty ?? w;
    result &= Test("cvj_tern_into_fn_slot",  (int)ternIntoFn(1.0),          1001);
    result &= Test("cvj_coal_into_fn_slot",  (int)coalIntoFn(1.0),          1001);
    result &= Test("cvj_tern_fn_argument",   (int)joinAccApply(c > 0 ? w : w2), 1001);
    result &= Test("cvj_tern_fn_parameter",  (int)joinAccPick(0, w, w2),    2001);

    // The arms read through the spellings the ledger records at: a struct FIELD and a fixed-array
    // ELEMENT are both code values, and a join of them into a code slot is still legal.
    JoinAccBox box = default; box.f = joinAccRo;
    function<double(double)>[2] arr = default;
    arr[0] = joinAccRo; arr[1] = joinAccR2;
    function<double(double)> fromField = c > 0 ? box.f : w2;
    function<double(double)> fromElem  = c > 0 ? arr[1] : arr[0];
    result &= Test("cvj_tern_field_arm", (int)fromField(1.0), 1001);
    result &= Test("cvj_tern_elem_arm",  (int)fromElem(1.0),  2001);

    // The EXPLICIT cast is the escape hatch the rejection's message advises, and a ptr->ptr cast is
    // a no-op under opaque pointers - so the cast result IS the ledgered arm value. Both placements
    // must survive: the cast INSIDE an arm, and the cast OVER the whole join.
    JoinAcc* castInArm = c > 0 ? (JoinAcc*)w : nullptr;
    JoinAcc* castOverJoin = (JoinAcc*)(c > 0 ? w : w2);
    void*    castVoidInArm = c > 0 ? (void*)w : nullptr;
    // The PARENTHESIZED operand is the spelling that actually exercises the launder: `(T*)w`
    // materializes its own unledgered load, while `(T*)(w)` casts the ledgered read itself.
    JoinAcc* castParenInArm = c > 0 ? (JoinAcc*)(w) : nullptr;
    result &= Test("cvj_cast_in_arm_nonnull",    castInArm      == nullptr ? 0 : 1, 1);
    result &= Test("cvj_cast_over_join_nonnull", castOverJoin   == nullptr ? 0 : 1, 1);
    result &= Test("cvj_cast_void_in_arm",       castVoidInArm  == nullptr ? 0 : 1, 1);
    result &= Test("cvj_cast_paren_in_arm",      castParenInArm == nullptr ? 0 : 1, 1);

    // OCCURRENCE-KEYED accept legs: each call argument's cast launders ONLY its own occurrence,
    // never a sibling argument's - these two DO carry their own explicit cast at every position,
    // so they must stay accepted even though they read the SAME shared function constant twice
    // in one statement. Distinct from the reject legs in err_data_pointer_to_closure_param.cb,
    // which use a BARE (uncast) sibling mention - that is the collision this fix closes.
    JoinAcc* twoCastArgsSameStmt = joinAccTwoCast((JoinAcc*)joinAccRo, (JoinAcc*)joinAccRo);
    JoinAcc* castArgPlusCastJoinArm =
        joinAccTwoCast((JoinAcc*)joinAccRo, c > 0 ? (JoinAcc*)joinAccRo : nullptr);
    result &= Test("cvj_two_cast_args_same_stmt",     twoCastArgsSameStmt    == nullptr ? 0 : 1, 1);
    result &= Test("cvj_cast_arg_plus_cast_join_arm", castArgPlusCastJoinArm == nullptr ? 0 : 1, 1);

    // NESTED-JOIN accept legs: the cast sits on the INNERMOST arm of a join nested two levels
    // deep, itself passed as a call argument or brace-init field. The gate that reads a call
    // argument's own value mid-evaluation (LoadNamedVariable -> ArgumentIsCodeValue) must ask
    // under the AMBIENT occurrence, not an unstamped 0, or the inner join's own load wrongly
    // poisons the value-only codeValues_ ledger and the outer join is false-rejected.
    JoinAcc* nn = nullptr;
    int nestedJoinInArg = joinAccOne(c > 0 ? (c > 0 ? (JoinAcc*)(w) : nn) : nn);
    int nestedNamedInArg = joinAccOne(c > 0 ? (c > 0 ? (JoinAcc*)joinAccRo : nn) : nn);
    JoinAccNested nestedBox = { p = c > 0 ? (c > 0 ? (JoinAcc*)(w) : nn) : nn, k = 3 };
    result &= Test("cvj_nested_join_in_call_arg",   nestedJoinInArg  == 0 ? 0 : 1, 1);
    result &= Test("cvj_nested_named_in_call_arg",  nestedNamedInArg == 0 ? 0 : 1, 1);
    result &= Test("cvj_nested_join_brace_field",   nestedBox.p == nullptr ? 0 : 1, 1);

    // A join of two DATA pointers into a data pointer - the control proving the resolution is not
    // simply refusing pointer joins. Both join spellings, decl-init and argument.
    JoinAcc x = default; x.a = 5;
    JoinAcc y = default; y.a = 6;
    JoinAcc* px = &x;
    JoinAcc* py = &y;
    JoinAcc* nothing = nullptr;
    JoinAcc* ternData = c > 0 ? px : py;
    JoinAcc* coalData = nothing ?? py;
    result &= Test("cvj_tern_data_ptr", ternData->a, 5);
    result &= Test("cvj_coal_data_ptr", coalData->a, 6);

    // The CALL RESULT of a function pointer whose return type is a data pointer. The callee is a
    // ledgered code value; its result is not, and joining results must stay legal.
    function<JoinAcc*(int)> maker = joinAccMake;
    JoinAcc* ternCall = c > 0 ? maker(7) : nothing;
    JoinAcc* coalCall = nothing ?? maker(8);
    result &= Test("cvj_tern_call_result", ternCall->a, 7);
    result &= Test("cvj_coal_call_result", coalCall->a, 8);
    delete ternCall;
    delete coalCall;

    // `function<T>*` is the ADDRESS of a slot, so it is genuinely data and a join of two of them
    // into `void*` must keep converting - the shape check, not the ledger, is what allows this.
    function<double(double)>* slot = &w;
    function<double(double)>* noSlot = nullptr;
    void* slotAddr = c > 0 ? slot : noSlot;
    result &= Test("cvj_fnptr_slot_join_into_voidstar", slotAddr == nullptr ? 0 : 1, 1);

    // A join argument scored against an overload SET. The code-value rule is read by the scorer's
    // REFUTE arm, so a set is where it can move resolution - and it must only ever refute, never
    // re-select. A set that CONTAINS a candidate accepting code still binds that candidate (the
    // value discriminates: the funcptr overload returns 1001, the pointer one 0), and a set of
    // data candidates still binds on a data join.
    result &= Test("cvj_overload_set_binds_funcptr", joinAccPickOv(c > 0 ? w : w2), 1001);
    result &= Test("cvj_overload_set_binds_data",    joinAccDataOv(c > 0 ? px : py), 5);

    // '??=' is its own store path - it emits its own compare/branch/store and returns before the
    // plain '=' gate. A code value into a FUNCTION slot, and data into data, must stay legal.
    function<double(double)> coalSlot = default;
    coalSlot ??= joinAccRo;
    function<double(double)> coalFromLocal = default;
    coalFromLocal ??= w2;
    JoinAcc* coalPtr = nullptr;
    coalPtr ??= px;
    JoinAcc* coalCast = nullptr;
    coalCast ??= (JoinAcc*)w;
    // A LAMBDA LITERAL through '??='. The expected-type threading and the fat-to-thin coercion
    // both live in the shared store tail, which '??=' used to return before, so on the merge base
    // this was rejected with "cannot assign a struct value to a pointer variable". The value 5
    // (not 4) is what proves the lambda's own body ran through the thin slot.
    function<int(int)> coalLambda = default;
    coalLambda ??= (int a) => a + 1;
    result &= Test("cvj_nullassign_fn_lambda", coalLambda(4), 5);

    result &= Test("cvj_nullassign_fn_slot",   (int)coalSlot(1.0),      1001);
    result &= Test("cvj_nullassign_fn_local",  (int)coalFromLocal(1.0), 2001);
    result &= Test("cvj_nullassign_data_ptr",  coalPtr->a,              5);
    result &= Test("cvj_nullassign_cast",      coalCast == nullptr ? 0 : 1, 1);

    // A '?:' arm harmonized into `string`: legal for a real string and for a raw char*, refused
    // only when the pointer arm is PROVEN code. These are the accept twins of that rejection.
    string sa = "aa";
    char*  raw = "raw";
    string ternStr = c > 0 ? sa : "0";
    string ternRaw = c > 0 ? raw : sa;
    result &= Test("cvj_tern_string_literal_arm", (int)ternStr.length(), 2);
    result &= Test("cvj_tern_string_charptr_arm", (int)ternRaw.length(), 3);

    /*
     * PER-ARM OCCURRENCE accept legs. Each join arm is now evaluated under its own cast
     * occurrence id so a cast on one arm stops laundering its BARE sibling (the reject legs live
     * in err_join_arm_cast_launders_sibling.cb). Everything below is a legal join that the
     * per-arm scope must NOT refuse - all of it was measured accepted on the pre-fix binary too.
     */

    // A generic instantiated THREE times over two type arguments. The occurrence ids are minted
    // fresh per monomorphization, so identical join syntax must resolve identically every time.
    result &= Test("cvj_arm_generic_inst_int",    joinAccGenJoin<int>(1, c),      12);
    result &= Test("cvj_arm_generic_inst_double", joinAccGenJoin<double>(1.5, c), 12);
    result &= Test("cvj_arm_generic_inst_again",  joinAccGenJoin<int>(2, c),      12);

    // A join off OWNING pointers, and a join feeding a `move` sink through list.add.
    JoinAccRes* ra = new JoinAccRes(); ra.v = 3;
    JoinAccRes* rb = new JoinAccRes(); rb.v = 4;
    JoinAccRes* rpick = c > 0 ? ra : rb;
    result &= Test("cvj_arm_join_owning_ptrs", rpick->v, 3);
    delete ra;
    delete rb;
    string js1 = "one";
    string js2 = "twos";
    list<string> jl = default;
    jl.add(c > 0 ? js1 : js2);
    result &= Test("cvj_arm_join_string_move_sink", (int)jl.get(0).length(), 3);

    // The `?.` null-safe form feeding `??` - both are join shapes the arm scope also wraps.
    JoinAccNode* jn = new JoinAccNode(); jn.v = 7;
    JoinAccNode? jnq = jn;
    JoinAccNode? jnn = nullptr;
    result &= Test("cvj_arm_qdot_join",      jnq?.get() ?? -1, 7);
    result &= Test("cvj_arm_qdot_join_null", jnn?.get() ?? -1, -1);
    delete jn;

    // A LOOP-carried join whose value differs per iteration, plus an all-cast join in the same
    // body: the ledger is re-consulted on every iteration's codegen of one syntactic arm.
    int loopTotal = 0;
    for (int i = 0; i < 3; i++)
    {
        JoinAcc* lp = i % 2 == 0 ? px : py;
        JoinAcc* lc = i > 0 ? (JoinAcc*)w : (JoinAcc*)w2;
        loopTotal += lp->a + (lc == nullptr ? 0 : 1);
    }
    result &= Test("cvj_arm_loop_carried_join", loopTotal, 19);

    // Two independently-gated argument slots in one call, one a plain data join and one an
    // all-cast join: neither slot's arm ids may leak into the other's.
    JoinAcc* twoSlotA = joinAccTwoCast(c > 0 ? px : py,
                                       c > 0 ? (JoinAcc*)joinAccRo : (JoinAcc*)joinAccRo);
    JoinAcc* twoSlotB = joinAccTwoCast(c > 1 ? py : px, nothing);
    result &= Test("cvj_arm_two_slots_plain_and_cast", twoSlotA->a, 5);
    result &= Test("cvj_arm_two_slots_data_only",      twoSlotB->a, 5);

    return result;
}

// --- Generic producers of function<> / Lambda<> ------------------------------
// Emitting a GENERIC function's body happens mid-body of its CALLER (monomorphization),
// through SaveBuilderState/RestoreBuilderState. Before the fix that pair snapshotted three of
// the four `currentFunctionReturn*` fields and left `currentFunctionReturnTV` behind, so the
// producer's function<>/Lambda<> return type stayed live and steered the CALLER's own `return`
// through CoerceToFuncPtrReturn. Every leg below therefore asserts the ENCLOSING function's
// value, not the producer's. Pre-fix behaviour is per-leg, recorded in the comments.

int gfpDouble(int x) { return x * 2; }
int gfpTriple(int x) { return x * 3; }

function<int(int)> gfpMk<T>(T seed)    { return gfpDouble; }
function<int(int)> gfpMk2<T>(T seed)   { return gfpTriple; }
function<T(T)>     gfpMkT<T>(T seed)   { return gfpDouble; }
Lambda<int(int)>   gfpMkFat<T>(T seed) { return gfpDouble; }
function<int(int)> gfpOuter<U>(U seed) { function<int(int)> q = gfpMk<U>(seed); return q; }
function<int(int)> gfpMkPlain(int seed) { return gfpDouble; }

struct GfpBox { int a = default; };

// Pre-fix: `ret ptr %thinret` against an i32 return -> module verification failure.
int gfpEnclInt()  { function<int(int)> g = gfpMk<int>(1); return g(5); }
// Pre-fix: `bitcast i1 ... to ptr` -> module verification failure.
bool gfpEnclBool() { function<int(int)> g = gfpMk<int>(1); return g(5) == 10; }
// Pre-fix: COMPILER SIGSEGV (exit 139, zero output) - the struct-value return path.
GfpBox gfpEnclStruct() { function<int(int)> g = gfpMk<int>(1); GfpBox b = default; b.a = g(5); return b; }
// Pre-fix: false rejection "a closure that may carry captured state cannot become a C
// function pointer" - the returned `string` struct hit the fat-closure arm of the coercion.
string gfpEnclString() { function<int(int)> g = gfpMk<int>(1); string s = "ok"; return s; }
// Same false rejection on an OWNING CONTAINER return - the shape is any struct-by-value return,
// not `string` specifically. Pre-fix: the same ".toFunction() instead" diagnostic.
list<int> gfpEnclOwned() { function<int(int)> g = gfpMk<int>(1); list<int> l; l.add(g(5)); return l; }
// The other direction: a legitimately function<>-returning caller must keep its own shape.
// Pre-fix with a Lambda<> producer: `ret %__closure_fat_ptr` against a ptr return.
function<int(int)> gfpEnclThinFromFat() { Lambda<int(int)> g = gfpMkFat<int>(1); return gfpTriple; }
// Pre-fix: `ret ptr @gfpTriple` against a __closure_fat_ptr return.
Lambda<int(int)> gfpEnclFatFromThin() { function<int(int)> g = gfpMk<int>(1); return gfpTriple; }
// Same shape both sides: passes pre-fix too. Accept-set leg, kept so the fix cannot break it.
function<int(int)> gfpEnclThinFromThin() { function<int(int)> g = gfpMk<int>(1); return gfpTriple; }
// Pre-fix: `ret ptr bitcast (i8 42 to ptr)` - merely CALLING the producer poisoned the return,
// the result is never bound. This leg is what proves usage is irrelevant.
int gfpEnclDiscard() { gfpMk<int>(1); return 42; }
int gfpEnclTwice() { function<int(int)> g = gfpMk<int>(1); function<int(int)> h = gfpMk<int>(2); return g(5) + h(1); }
int gfpEnclTwoProducers() { function<int(int)> g = gfpMk<int>(1); function<int(int)> h = gfpMk2<int>(2); return g(5) + h(1); }
// Two DIFFERENT instantiations of the same template in one body.
int gfpEnclTwoT() { function<int(int)> g = gfpMk<int>(1); function<int(int)> h = gfpMk<double>(2.0); return g(5) + h(1); }
// Instantiation inside a nested block / loop rather than at statement top level.
int gfpEnclNested(int n)
{
    int acc = 0;
    if (n > 0) { for (int i = 0; i < n; i++) { function<int(int)> g = gfpMk<int>(i); acc = acc + g(1); } }
    return acc;
}
// A generic ENCLOSING function (its own body is itself emitted mid-caller).
U gfpEnclGeneric<U>(U v) { function<int(int)> g = gfpMk<int>(1); return v + g(5); }
// A producer that itself instantiates another producer - two nested save/restore frames.
int gfpEnclNestedGen() { function<int(int)> g = gfpOuter<int>(1); return g(5); }
// The producer's return type MENTIONS T.
int gfpEnclTSig() { function<int(int)> g = gfpMkT<int>(1); return g(5); }
// Fat producer into a fat local, plain int return. Measured to pass pre-fix as well: the leaked
// Lambda<> TV is not thin, so the coercion took the widen arm, which no-ops on an i32. Accept-set.
int gfpEnclFatProducer() { Lambda<int(int)> g = gfpMkFat<int>(1); return g(5); }
// Non-generic producer control: worked pre-fix (its body is not emitted mid-caller) and must
// keep working - this is the leg that pins the fix to the generic path only.
int gfpEnclNonGeneric() { function<int(int)> g = gfpMkPlain(1); return g(5); }
// Call-context legs that already worked pre-fix (accept set).
int gfpUse(function<int(int)> f) { return f(5); }
int gfpEnclAsArg()     { return gfpUse(gfpMk<int>(1)); }
int gfpEnclImmediate() { return gfpMk<int>(1)(5); }
function<int(int)> gfpEnclReturnDirect() { return gfpMk<int>(1); }

class GfpHolder
{
    int k = default;
    int probe() { function<int(int)> g = gfpMk<int>(1); return k + g(5); }
};

// A THIN `function<T>*` used as a GENERIC TYPE ARGUMENT. Generic substitution used to DROP the
// declarator's '*', so the element type came out as the encoded closure VALUE and every store of
// an address into it was rejected as "cannot store a pointer value into struct storage".
struct TgpBox<T> { T item = default; };
// Separate template so its body is only instantiated for the callable-pointer element.
struct TgpCaller<T> { T item = default;
    int use(int v) { return (*item)(v); } };
struct TgpOuter<T> { TgpBox<T*> inner = default; };
using TgpAlias = function<int(int)>;
namespace TgpNs { struct Box<T> { T item = default; }; }

bool testThinFuncPtrGenericArg()
{
    bool result = true;

    // Store an address into the generic field, then call THROUGH it. Pre-fix the dropped '*' made
    // the field the encoded closure VALUE, so this store was rejected as "into struct storage".
    function<int(int)> g = doubleIt;
    TgpBox<function<int(int)>*> b = default;
    b.item = &g;
    result &= Test("tgp_box_call",   (*b.item)(6), 12);
    TgpCaller<function<int(int)>*> c = default;
    c.item = &g;
    result &= Test("tgp_box_method", c.use(6),     12);

    // Reseat the borrowed target: the field must be a real pointer slot, so pointing it at a
    // different function<> changes the answer (square gives 36, not 12).
    function<int(int)> g2 = square;
    b.item = &g2;
    result &= Test("tgp_box_reseat", (*b.item)(6), 36);

    // A local of the pointee type read back out of the generic field.
    b.item = &g;
    function<int(int)>* p = b.item;
    result &= Test("tgp_box_load",   (*p)(6), 12);

    // Nested generic: the pointer argument is resolved by the recursive inner-generic arm.
    TgpBox<TgpBox<function<int(int)>*>> nested = default;
    nested.item.item = &g;
    result &= Test("tgp_nested",     (*nested.item.item)(6), 12);

    // The pointer reaches Box<T*> only after T is SUBSTITUTED - the encoded-name funnel, a
    // different arm from the spellings above. This one already worked pre-fix: it is here as a
    // must-still-work leg, because that funnel is where the FAT rejection was added.
    TgpOuter<function<int(int)>> o = default;
    o.inner.item = &g;
    result &= Test("tgp_subst",      (*o.inner.item)(6), 12);

    // Function-type ALIAS spelling of the same argument (the functionTypeAliases arm).
    TgpBox<TgpAlias*> ab = default;
    ab.item = &g;
    result &= Test("tgp_alias",      (*ab.item)(6), 12);

    // Namespace-qualified template, and a double pointer.
    TgpNs.Box<function<int(int)>*> nb = default;
    nb.item = &g;
    result &= Test("tgp_namespace",  (*nb.item)(6), 12);
    function<int(int)>* pp = &g;
    TgpBox<function<int(int)>**> db = default;
    db.item = &pp;
    result &= Test("tgp_double_ptr", (**db.item)(6), 12);

    // A container instantiated on the pointer element.
    list<function<int(int)>*> l;
    l.add(&g);
    l.add(&g2);
    function<int(int)>* e0 = l.get(0);
    function<int(int)>* e1 = l.get(1);
    result &= Test("tgp_list_0",     (*e0)(6), 12);
    result &= Test("tgp_list_1",     (*e1)(6), 36);

    return result;
}

// A closure stored BY VALUE in a generic instantiation. A THIN `function<T>` element used to get
// a `{ i8* }` STRUCT backing while a `function<T>` value is a bare code pointer, so every field
// store was rejected ("cannot store a pointer value into struct storage"), reading one back or
// passing one on hit the module verifier, and two spellings crashed the compiler outright. The
// thin encoded element is now the same bare code pointer the non-generic spelling is.
struct CbvBox<T> { T item = default; };
class CbvCls<T> { T item = default; };
struct CbvOuter<T> { CbvBox<T> inner = default; };
struct CbvPlainFat  { Lambda<int(int)>   item = default; };
struct CbvPlainThin { function<int(int)> item = default; };
int cbvTakesFat(Lambda<int(int)> f)  { return f(5); }
int cbvTakesThin(function<int(int)> f) { return f(5); }
function<int(int)> cbvUnwrap(CbvBox<function<int(int)>> b) { return b.item; }

bool testClosureByValueGenericArg()
{
    bool result = true;

    // Field store of a NAMED function, then invoke through the substituted field.
    // Pre-fix: "cannot store a pointer value into struct storage" (hard error, exit 1).
    CbvBox<function<int(int)>> b = default;
    b.item = doubleIt;
    result &= Test("cbv_thin_store_named", b.item(6), 12);

    // Store a thin `function<>` VALUE (not a bare name) - the other source spelling.
    function<int(int)> g = square;
    b.item = g;
    result &= Test("cbv_thin_store_value", b.item(6), 36);

    // Read the substituted field back into a local of the spelled type.
    // Pre-fix: "cannot assign a struct value to a pointer variable".
    function<int(int)> back = b.item;
    result &= Test("cbv_thin_field_to_local", back(6), 36);

    // The field as an ARGUMENT, to a fat `Lambda<>` slot and to a thin `function<>` slot.
    // Pre-fix both were unreachable (the store above already errored).
    b.item = doubleIt;
    result &= Test("cbv_thin_to_fat_param",  cbvTakesFat(b.item),  10);
    result &= Test("cbv_thin_to_thin_param", cbvTakesThin(b.item), 10);

    // The whole instantiation passed by value, and a substituted field RETURNED.
    // `cbvUnwrap` was a compiler SIGSEGV (exit 139, no output) pre-fix.
    result &= Test("cbv_thin_return_field", cbvUnwrap(b)(6), 12);

    // Generic CLASS and NESTED generic spellings of the same store.
    CbvCls<function<int(int)>> c;
    c.item = doubleIt;
    result &= Test("cbv_thin_class_store", c.item(6), 12);
    CbvOuter<function<int(int)>> o = default;
    o.inner.item = square;
    result &= Test("cbv_thin_nested_store", o.inner.item(6), 36);

    // A lambda LITERAL assigned to a substituted field: its return type is inferred from the
    // element's signature. Fat pre-fix was an UNLOCATED module-verifier dump ("Found return
    // instr that returns non-void ... ret i32"); thin was "cannot cast an aggregate value".
    CbvBox<Lambda<int(int)>> fb = default;
    fb.item = (int x) => x + 1;
    result &= Test("cbv_fat_literal", fb.item(5), 6);
    CbvBox<function<int(int)>> tb = default;
    tb.item = (int x) => x + 3;
    result &= Test("cbv_thin_literal", tb.item(5), 8);

    // A named function into a FAT field / a fat CONTAINER: both widen to {code, null}.
    // Pre-fix the field store errored and `add` was an unlocated verifier dump.
    fb.item = doubleIt;
    result &= Test("cbv_fat_store_named", fb.item(6), 12);
    list<Lambda<int(int)>> fl;
    fl.add(square);
    result &= Test("cbv_fat_list_named", fl.get(0)(6), 36);

    // Container element passed ON to a closure parameter - the filed `list<function<>>` repro.
    // Pre-fix: the fat slot was an unlocated verifier dump, the thin slot a compiler SIGSEGV.
    list<function<int(int)>> tl;
    tl.add(doubleIt);
    result &= Test("cbv_list_elem_to_fat",  cbvTakesFat(tl.get(0)),  10);
    result &= Test("cbv_list_elem_to_thin", cbvTakesThin(tl.get(0)), 10);
    function<int(int)> elem = tl.get(0);
    result &= Test("cbv_list_elem_to_local", elem(6), 12);

    // A lambda literal INTO the thin container (pre-fix: unlocated verifier dump).
    list<function<int(int)>> tl2;
    tl2.add((int x) => x + 4);
    result &= Test("cbv_list_thin_literal", tl2.get(0)(5), 9);

    // Must-still-work: the brace-init spelling with a NAMED function, which worked pre-fix.
    CbvBox<function<int(int)>> bi = { item = doubleIt };
    result &= Test("cbv_thin_brace_init", bi.item(6), 12);

    // Brace-init with a lambda LITERAL. The brace path never threaded the target field's closure
    // signature into the literal, so its return type came out `void` and the module verifier
    // rejected the whole module with no source location - on the NON-generic field too, which is
    // why the two plain-struct legs below are here rather than in a generics-only test.
    CbvBox<Lambda<int(int)>>   fbi = { item = (int x) => x + 1 };
    CbvBox<function<int(int)>> tbi = { item = (int x) => x + 2 };
    result &= Test("cbv_fat_brace_literal",  fbi.item(5), 6);
    result &= Test("cbv_thin_brace_literal", tbi.item(5), 7);
    CbvPlainFat  pf = { item = (int x) => x + 3 };
    CbvPlainThin pt = { item = (int x) => x + 4 };
    result &= Test("cbv_plain_fat_brace_literal",  pf.item(5), 8);
    result &= Test("cbv_plain_thin_brace_literal", pt.item(5), 9);

    // A CAPTURING literal into a FAT generic field. The ownership-transfer arm keyed on the
    // spelling "__closure_fat_ptr", so a substituted field skipped it and the env was freed at
    // end-of-full-expression while the field still pointed at it - wrong value, then SIGSEGV.
    int cap = 10;
    CbvBox<Lambda<int(int)>> cb = default;
    cb.item = (int x) => { return x + cap; };
    result &= Test("cbv_fat_capturing_store", cb.item(1), 11);
    cb.item = (int x) => { return x + cap + cap; };
    result &= Test("cbv_fat_capturing_reassign", cb.item(1), 21);
    result &= Test("cbv_fat_capturing_to_param", cbvTakesFat(cb.item), 25);

    CbvCls<Lambda<int(int)>> cc = default;
    cc.item = (int x) => { return x + cap; };
    result &= Test("cbv_fat_capturing_class", cc.item(1), 11);

    CbvOuter<Lambda<int(int)>> co = default;
    co.inner.item = (int x) => { return x + cap; };
    result &= Test("cbv_fat_capturing_nested", co.inner.item(1), 11);

    CbvBox<Lambda<int(int)>>* cp = new CbvBox<Lambda<int(int)>>();
    cp->item = (int x) => { return x + cap; };
    result &= Test("cbv_fat_capturing_heapptr", cp->item(1), 11);
    delete cp;

    CbvBox<Lambda<int(int)>> cbi = { item = (int x) => { return x + cap; } };
    result &= Test("cbv_fat_capturing_brace", cbi.item(1), 11);

    return result;
}

// A legal closure source (named fn or thin function<> value) as a fat Lambda<> FIELD default
// was stored unwidened - the raw code pointer landed straight in the {code, env} struct with
// no wrap, so the call read garbage env and crashed. See
// internal/issue/interface-issue-queue.md, fix/fat-widen landed record.
int fwAddOne(int x) { return x + 1; }
function<int(int)> fwThinAddOne = fwAddOne;
Lambda<int(int)> fwLamAddOne = fwAddOne;
struct FwFieldDefaultNamedFn { Lambda<int(int)> f = fwAddOne; };
struct FwFieldDefaultThinVal { Lambda<int(int)> f = fwThinAddOne; };
struct FwFieldDefaultLamVal  { Lambda<int(int)> f = fwLamAddOne; };
struct FwFieldDefaultNull    { Lambda<int(int)> f = nullptr; };
class  FwFieldDefaultNamedFnClass { Lambda<int(int)> f = fwAddOne; };
// Generic-encoded fat field default fed a bare named function - the same widen must apply
// through the encoded-element path GetEncodedClosureType resolves.
struct FwGenericFieldDefault<T> { T item = fwAddOne; };

bool testFatFieldDefaultWidensLegalSource()
{
    bool result = true;

    // Named function as a struct field default - pre-fix: compiles clean, SIGSEGVs at the call.
    FwFieldDefaultNamedFn s1 = default;
    result &= Test("fwfd_named_fn_struct", s1.f(30), 31);

    // Thin function<> VALUE as a struct field default - same bug, not named-fn-specific.
    FwFieldDefaultThinVal s2 = default;
    result &= Test("fwfd_thin_value_struct", s2.f(30), 31);

    // Lambda<> value source - already worked pre-fix; must stay byte-identical.
    FwFieldDefaultLamVal s3 = default;
    result &= Test("fwfd_lambda_value_regression", s3.f(30), 31);

    // nullptr default - already worked pre-fix; must stay byte-identical.
    FwFieldDefaultNull s4 = default;
    result &= Test("fwfd_nullptr_regression", s4.f == nullptr ? 1 : 0, 1);

    // Named function as a CLASS field default - the class default-ctor emitter is separate.
    FwFieldDefaultNamedFnClass s5 = default;
    result &= Test("fwfd_named_fn_class", s5.f(30), 31);

    // Named function into a generic-substituted fat field default.
    FwGenericFieldDefault<Lambda<int(int)>> s6 = default;
    result &= Test("fwfd_named_fn_generic", s6.item(30), 31);

    return result;
}

// Calling a CLOSURE member of a `union`. Pre-fix the member call loaded the whole union value
// where a closure was expected: the fat arm SIGSEGVed the compiler (exit 139) and the thin arm
// died in module verification ("Invalid bitcast %cfn_ptr = bitcast %UT %2 to ptr"). Separately
// the union default ctor discarded every field initializer, so a union field default read 0, and
// the synthesized full destructor walked a union PER FIELD - a GEP past the one-slot union body,
// destructing the `int` arm as a closure. That last one is why these locals must reach SCOPE EXIT:
// removing the capturing leg below hides it (the crash is in teardown, after every leg passes).
union UcThin { function<int(int)> f = fwAddOne; int i; };
union UcFat  { Lambda<int(int)> f = fwAddOne;   int i; };
union UcNoDefault { Lambda<int(int)> f = default; int i; };
union UcInt  { int i = 41; float x; };
int ucmNodeDtors = 0;
struct UcNode  { int v = default;   ~UcNode()  { ucmNodeDtors = ucmNodeDtors + 1; } };

// WRONG-ARM-LIVE at scope exit, destructible arm at index >= 1. The program writes the i64 arm
// and leaves it live; if the union destructed its index-1 arm anyway it would `delete` 12345
// (rc 134) or, for the closure arm, read 12345 as an OWNED tagged env and make a wild indirect
// call through it (rc 139). Master refuses both unions outright, so compiling them AND
// destructing would be new reachability for a wild free. These must simply run.
struct UcWrongArmBox { unique UcNode* p = default; };
union UcWrongArmUnique  { i64 raw; UcWrongArmBox b; };
union UcWrongArmClosure { i64 raw; Lambda<int(int)> f; };
// Bind through a local: returning `u.raw` directly elides the scope-exit destruct, which
// would make these legs vacuous - the whole point is to reach the union's scope exit.
i64 ucmWrongArmUnique()  { UcWrongArmUnique u = default;  u.raw = (i64)12345; i64 r = u.raw; return r; }
i64 ucmWrongArmClosure() { UcWrongArmClosure u = default; u.raw = (i64)12345; i64 r = u.raw; return r; }
struct UcPoint { int px = 7; int py = 9; };
union UcStructArm { UcPoint p = default; int i; };
struct UcNested { UcThin u = default; int tag = default; };

int ucmDoublePx(UcPoint p) { return p.px * 2; }

bool testUnionClosureMember()
{
    bool result = true;

    // The filed repro, both arms: a named-function default called straight off the member.
    UcThin ut = default;
    result &= Test("ucm_thin_call", ut.f(1), 2);
    UcFat uf = default;
    result &= Test("ucm_fat_call", uf.f(1), 2);

    // Assigned (not defaulted) member, then called - the same mis-typed load.
    UcNoDefault un = default;
    un.f = fwAddOne;
    result &= Test("ucm_fat_assign_call", un.f(1), 2);

    // Member read into a local: the fat arm went through the closure-clone path, which handed
    // `copy()` the union alloca and failed verification.
    Lambda<int(int)> g = uf.f;
    result &= Test("ucm_fat_copy_call", g(10), 11);
    function<int(int)> h = ut.f;
    result &= Test("ucm_thin_copy_call", h(10), 11);

    // A capturing lambda into a fat union member.
    int cap = 5;
    un.f = (int x) => x + cap;
    result &= Test("ucm_fat_capturing_call", un.f(1), 6);

    // Receiver spellings that reach the same member-call lowering.
    UcThin* pt = &ut;
    result &= Test("ucm_thin_ptr_call", pt.f(1), 2);
    result &= Test("ucm_thin_paren_call", (ut).f(1), 2);
    UcNested nested = default;
    result &= Test("ucm_nested_call", nested.u.f(1), 2);
    UcFat[2] arr = default;
    arr[0].f = fwAddOne;
    result &= Test("ucm_array_call", arr[0].f(1), 2);

    // The union default ctor now applies one field initializer instead of zeroing everything.
    UcInt ui = default;
    result &= Test("ucm_union_int_default", ui.i, 41);
    UcStructArm us = default;
    result &= Test("ucm_union_struct_default_x", us.p.px, 7);
    result &= Test("ucm_union_struct_default_y", us.p.py, 9);

    // The wrong-arm-live witnesses. These are VALUE legs only incidentally: what they really
    // assert is that the process is still alive to compare - an index >= 1 destructor would have
    // aborted (rc 134) or segfaulted (rc 139) inside the call, taking the whole suite with it.
    result &= Test("ucm_wrongarm_unique_survives",  (int)ucmWrongArmUnique(),  12345);
    result &= Test("ucm_wrongarm_closure_survives", (int)ucmWrongArmClosure(), 12345);
    ucmNodeDtors = 0; ucmWrongArmUnique();
    result &= Test("ucm_wrongarm_no_wrong_free", ucmNodeDtors, 0);

    // A UFCS free-function call whose receiver is a union member takes the receiver BY VALUE:
    // pre-fix the whole union value was handed to a member-typed parameter (verifier failure).
    UcPoint recv = default;
    UcStructArm ur = default;
    ur.p.px = 6;
    result &= Test("ucm_byvalue_receiver", ucmDoublePx(ur.p), 12);
    result &= Test("ucm_byvalue_receiver_ufcs", ur.p.ucmDoublePx(), 12);
    result &= Test("ucm_unused_recv", recv.px, 7);

    // '++' on a union member: the read-modify-write must use the MEMBER type, not the union's.
    UcInt ui2 = default;
    ui2.i++;
    result &= Test("ucm_member_increment", ui2.i, 42);

    return result;
}

bool testGenericFuncPtrProducer()
{
    bool result = true;

    result &= Test("gfp_encl_int",        gfpEnclInt(),        10);
    result &= Test("gfp_encl_bool",       gfpEnclBool(),       true);
    result &= Test("gfp_encl_struct",     gfpEnclStruct().a,   10);
    result &= Test("gfp_encl_string",     (int)gfpEnclString().length(), 2);
    result &= Test("gfp_encl_owned",      gfpEnclOwned().get(0), 10);
    result &= Test("gfp_encl_discard",    gfpEnclDiscard(),    42);
    result &= Test("gfp_encl_twice",      gfpEnclTwice(),      12);
    result &= Test("gfp_encl_two_prod",   gfpEnclTwoProducers(), 13);
    result &= Test("gfp_encl_two_t",      gfpEnclTwoT(),       12);
    result &= Test("gfp_encl_nested",     gfpEnclNested(3),    6);
    result &= Test("gfp_encl_generic",    gfpEnclGeneric<int>(1), 11);
    result &= Test("gfp_encl_nested_gen", gfpEnclNestedGen(),  10);
    result &= Test("gfp_encl_tsig",       gfpEnclTSig(),       10);
    result &= Test("gfp_encl_fat_prod",   gfpEnclFatProducer(), 10);
    result &= Test("gfp_encl_nongeneric", gfpEnclNonGeneric(), 10);

    // The caller's own function-pointer return shape must survive the producer call in BOTH
    // flavours - x3 distinguishes it from the producer's x2, so a clobber cannot read as 10.
    function<int(int)> t1 = gfpEnclThinFromFat();
    Lambda<int(int)>   t2 = gfpEnclFatFromThin();
    function<int(int)> t3 = gfpEnclThinFromThin();
    result &= Test("gfp_thin_from_fat",   t1(5), 15);
    result &= Test("gfp_fat_from_thin",   t2(5), 15);
    result &= Test("gfp_thin_from_thin",  t3(5), 15);

    // A producer call inside a LAMBDA body and inside a class METHOD.
    Lambda<int(int)> inLam = (int x) => { function<int(int)> g = gfpMk<int>(1); return x + g(5); };
    result &= Test("gfp_in_lambda_body",  inLam(1), 11);
    GfpHolder h = default;
    h.k = 1;
    result &= Test("gfp_in_method",       h.probe(), 11);

    // Call-context accept set (each already worked pre-fix).
    function<int(int)> direct = gfpEnclReturnDirect();
    result &= Test("gfp_as_argument",     gfpEnclAsArg(),      10);
    result &= Test("gfp_immediate_call",  gfpEnclImmediate(),  10);
    result &= Test("gfp_return_direct",   direct(5),           10);

    return result;
}

// An owning struct temp produced inside an EXPRESSION-BODY lambda (`=> expr`) must be
// destructed at the end of that body, exactly as the block-body twin and the free-function
// twin already were. Pre-fix the expression body called CreateReturnCall directly and never
// reached the return path's owned-temp flush, so every *_destructed leg below read 0 and the
// program leaked (16 bytes for the box cell, 32 for the string cell).
int lamTempDtors = 0;
class LamDt { int v = default; ~LamDt() { lamTempDtors = lamTempDtors + 1; } };
struct LamBox<T> { T t = default; };
LamBox<unique LamDt*> lamMakeBox(int v)
{
    LamBox<unique LamDt*> b = default;
    b.t = new LamDt();
    b.t->v = v;
    return b;
}

int lamSDtors = 0;
class LamSBox { string s = default; ~LamSBox() { lamSDtors = lamSDtors + 1; } };
int lamN = 3;
LamSBox lamMakeS() { LamSBox b = default; b.s = "hello" + "world" + lamN.toString(); return b; }

struct LamPlain { string s = default; };
LamPlain lamMakePlain() { LamPlain p = default; p.s = "own" + lamN.toString(); return p; }

list<int> lamMakeList() { list<int> l = default; l.add(7); l.add(9); return l; }

bool testLambdaExprBodyOwnedTemp()
{
    bool result = true;

    // The filed shape, made legal by reading an int THROUGH the temp's unique field rather
    // than letting the pointer escape (the escaping spelling is err_lambda_expr_temp_escape.cb).
    lamTempDtors = 0;
    Lambda<int()> f = () => lamMakeBox(70).t->v;
    int v = f();
    result &= Test("lamexpr_temp_value",      v,            70);
    result &= Test("lamexpr_temp_destructed", lamTempDtors,  1);

    // Block-body twin - already correct pre-fix; frozen so the two spellings cannot drift.
    lamTempDtors = 0;
    Lambda<int()> g = () => { return lamMakeBox(8).t->v; };
    result &= Test("lamblock_temp_value",      g(),          8);
    result &= Test("lamblock_temp_destructed", lamTempDtors, 1);

    lamSDtors = 0;
    Lambda<int()> s = () => lamMakeS().s.length();
    result &= Test("lamexpr_string_temp_len",        s(),      11);
    result &= Test("lamexpr_string_temp_destructed", lamSDtors, 1);

    // A nested expression-body lambda: the inner body owns the temp, and the outer body's
    // flush must not be what frees it (the inner invoker is a separate function).
    lamSDtors = 0;
    Lambda<int()> n = () => (() => lamMakeS().s.length())();
    result &= Test("lamexpr_nested_len",        n(),      11);
    result &= Test("lamexpr_nested_destructed", lamSDtors, 1);

    // Accept set: shapes that already worked and must keep working.
    Lambda<int()> l = () => lamMakeList().get(1);
    result &= Test("lamexpr_list_elem", l(), 9);

    Lambda<LamPlain()> p = () => lamMakePlain();
    LamPlain got = p();
    result &= Test("lamexpr_returns_owning_value", got.s, "own3");

    string cap = "hello";
    Lambda<int()> c = () => cap.length();
    result &= Test("lamexpr_captures_owning_local", c(), 5);

    return result;
}

// A VOID lambda's `=> expr` is a DISCARDED full expression, not a return. Pre-fix the arm
// emitted a `ret <value>` into a void function and every cell below died in the module
// verifier ("Found return instr that returns non-void ...") with no source location.
int vebHits = 0;
int vebCalls = 0;
void vebBump()          { vebHits = vebHits + 1; }
void vebBumpN(int n)    { vebHits = vebHits + n; }
int  vebGives(int n)    { vebCalls = vebCalls + 1; return n * 2; }
void vebInvoke(Lambda<void(int)> f, int v) { f(v); }
int vebSeen = 0;
void vebShow(int len)   { vebSeen = len; }
int vebPlainCalls = 0;
int vebStore = 7;
void* vebGiveP() { return (void*)&vebStore; }
using VebVoid = void;
using VebVoidP = void*;
struct VebPod { int a = default; int b = default; };
VebPod vebMakePod() { vebPlainCalls = vebPlainCalls + 1; VebPod p = default; p.a = 4; return p; }

// A void expression-body lambda inside a GENERIC function body, instantiated twice.
int vebGeneric<T>(T v)
{
    Lambda<void()> g = () => vebBumpN(1);
    g();
    return vebHits;
}

bool testLambdaVoidExprBody()
{
    bool result = true;

    vebHits = 0;
    Lambda<void()> g = () => vebBump();
    g();
    result &= Test("veb_void_callee", vebHits, 1);

    // Block-body twin - correct pre-fix; frozen so the two spellings cannot drift.
    vebHits = 0;
    Lambda<void()> gb = () => { vebBump(); };
    gb();
    result &= Test("veb_block_twin", vebHits, 1);

    vebHits = 0;
    Lambda<void(int)> h = (int n) => vebBumpN(n);
    h(5);
    result &= Test("veb_param_form", vebHits, 5);

    // A NON-void callee in a void body: the value is discarded like an expression statement,
    // but the call must still run (vebCalls is the discriminator, not the returned value).
    vebCalls = 0;
    Lambda<void()> d = () => vebGives(4);
    d();
    result &= Test("veb_int_callee_discarded", vebCalls, 1);

    // An owning temp CONSUMED inside a void body must be destructed by the body's own flush,
    // exactly as in the block-body and expression-statement spellings.
    lamSDtors = 0; vebSeen = 0;
    Lambda<void()> o = () => vebShow(lamMakeS().s.length());
    o();
    result &= Test("veb_owning_temp_value",      vebSeen,    11);
    result &= Test("veb_owning_temp_destructed", lamSDtors,   1);

    lamSDtors = 0; vebSeen = 0;
    Lambda<void()> ob = () => { vebShow(lamMakeS().s.length()); };
    ob();
    result &= Test("veb_owning_temp_block_twin", lamSDtors, 1);

    // A POD struct (no destructor, no owning field) discarded in a void body: the call still runs.
    vebPlainCalls = 0;
    Lambda<void()> pl = () => vebMakePod();
    pl();
    result &= Test("veb_plain_struct_discarded", vebPlainCalls, 1);

    // Thin `function<void()>` (funcptr) versus the fat Lambda<> spelling.
    vebHits = 0;
    function<void()> t = () => vebBump();
    t();
    result &= Test("veb_thin_funcptr", vebHits, 1);

    // Nested void expression bodies: the inner invoker is its own function.
    vebHits = 0;
    Lambda<void()> n = () => (() => vebBump())();
    n();
    result &= Test("veb_nested", vebHits, 1);

    // A capturing void body - the capture is read, not returned.
    vebSeen = 0;
    string cap = "hello";
    Lambda<void()> c = () => vebShow(cap.length());
    c();
    result &= Test("veb_capture", vebSeen, 5);

    // Passed as an argument and invoked in the callee.
    vebHits = 0;
    vebInvoke((int n) => vebBumpN(n), 4);
    result &= Test("veb_passed_as_argument", vebHits, 4);

    // A non-call expression body: evaluated and discarded, like `x + 1;`.
    vebHits = 7;
    Lambda<void()> e = () => vebHits + 1;
    e();
    result &= Test("veb_noncall_expr_discarded", vebHits, 7);

    // A parenthesized ASSIGNMENT body is a real side effect, not a discard.
    vebHits = 0;
    Lambda<void()> a = () => (vebHits = 5);
    a();
    result &= Test("veb_assignment_body", vebHits, 5);

    // ACCEPT SET, and the guard's exact boundary: `void*` shares the "void" TypeName but
    // returns a real value, so it must stay on the RETURN lowering. Both spellings worked
    // pre-fix; a discard arm keyed on the TypeName alone silently returns nothing here.
    Lambda<void*()> vp = () => vebGiveP();
    result &= Test("veb_voidptr_expr_body_returns",  vebGiveP() == vp()  ? 1 : 0, 1);
    Lambda<void*()> vb = () => { return vebGiveP(); };
    result &= Test("veb_voidptr_block_body_returns", vebGiveP() == vb()  ? 1 : 0, 1);

    // Two instantiations of the same generic body: each gets its own lowered invoker.
    vebHits = 0;
    result &= Test("veb_generic_inst_int",    vebGeneric<int>(1),    1);
    result &= Test("veb_generic_inst_double", vebGeneric<double>(2.0), 2);

    // The ALIAS spelling of the return type reaches the same arm. Unresolved, `Lambda<VebVoid()>`
    // died in the module verifier on the expression body and got a false "missing return
    // statement" on the block body; both spellings must behave as plain `void`.
    vebHits = 0;
    Lambda<VebVoid()> av = () => vebBump();
    av();
    result &= Test("veb_alias_void_expr_body", vebHits, 1);
    vebHits = 0;
    Lambda<VebVoid()> ab = () => { vebBump(); };
    ab();
    result &= Test("veb_alias_void_block_body", vebHits, 1);

    // An alias whose TARGET spells a pointer keeps the return lowering - it is not "void".
    Lambda<VebVoidP()> ap = () => vebGiveP();
    result &= Test("veb_alias_voidptr_returns", vebGiveP() == ap() ? 1 : 0, 1);

    // An immediately-invoked literal has no expected type; a VOID-yielding body is still a
    // genuine discard and must run (the value-yielding form is rejected - see
    // Test/errors/err_lambda_expr_temp_escape.cb).
    vebHits = 0;
    (() => vebBump())();
    result &= Test("veb_iife_void_body", vebHits, 1);

    return result;
}

/*
 * `void f() { return g(); }` on a VOID g - the one void-ness crossing C keeps legal. It
 * evaluates the call for its effects and then returns nothing. Every spelling below died in
 * the LLVM module verifier before fix/retvoid ("Found return instr that returns non-void in
 * Function of void return type!"), with no source location, so these are value legs for a gate
 * whose whole job is to admit them; the rejections are in Test/errors/err_return_*.cb.
 */
int rvxHits = 0;
void rvxBump()           { rvxHits = rvxHits + 1; }
void rvxNamed()          { return rvxBump(); }
Lambda<void()> rvxClosure = default;
// A void CLOSURE call yields no LLVM value at all - a different void-ness detection than the
// direct call above, and the only spelling that exercises it on the accept side.
void rvxThroughClosure() { return rvxClosure(); }

void rvxSink<T>(T v)     { rvxHits = rvxHits + (int)v; }
void rvxGeneric()        { return rvxSink<int>(2); }
int  rvxId<T>(T v)       { return v; }

struct RvxBox
{
    int n = default;
    void bump() { n = n + 1; }
    void go()   { return bump(); }
};

// A `(void)` CAST is the third way void-ness reaches the return. On a CONSTANT operand it folds
// to LLVM's token 'none' rather than to a void-typed value, so it needs its own detection - the
// `(void)voidCall()` twin arrives as an ordinary void value. (`(void)<non-constant>` is a
// separate pre-existing defect - see internal/issue/p3.)
void rvxCastConst()    { rvxHits = rvxHits + 1; return (void)0; }
void rvxCastVoidCall() { return (void)rvxBump(); }

bool testReturnVoidExprFromVoid()
{
    bool result = true;

    rvxHits = 0;
    rvxNamed();
    result &= Test("rvx_named_void_crossing", rvxHits, 1);

    rvxHits = 0;
    rvxClosure = () => { rvxHits = rvxHits + 5; };
    rvxThroughClosure();
    result &= Test("rvx_closure_void_crossing", rvxHits, 5);

    rvxHits = 0;
    rvxGeneric();
    result &= Test("rvx_generic_void_crossing", rvxHits, 2);

    {
        RvxBox b = default;
        b.go();
        b.go();
        result &= Test("rvx_method_void_crossing", b.n, 2);
    }

    // `return (void)<constant>;` and `return (void)<void call>;` from a void function. The
    // counter proves the body ran and the function returned normally, not merely that it built.
    rvxHits = 0;
    rvxCastConst();
    rvxCastConst();
    result &= Test("rvx_cast_const_void_crossing", rvxHits, 2);

    rvxHits = 0;
    rvxCastVoidCall();
    result &= Test("rvx_cast_voidcall_void_crossing", rvxHits, 1);

    // The same cast inside a DECLARED-void lambda body.
    rvxHits = 0;
    {
        Lambda<void()> g = () => { rvxHits = rvxHits + 3; return (void)0; };
        g();
        result &= Test("rvx_cast_const_in_lambda", rvxHits, 3);
    }

    // The same crossing inside a DECLARED-void lambda's block body.
    rvxHits = 0;
    {
        Lambda<void()> g = () => { return rvxBump(); };
        g();
        g();
        g();
        result &= Test("rvx_lambda_block_void_crossing", rvxHits, 3);
    }

    // An INFERRED-void lambda (immediately-invoked, no expected type) holding a TYPED inner
    // lambda that returns a value: the inner `return 4;` must be judged against the inner
    // invoker, not against the outer literal's inferred void. Discriminates against a
    // mid-work regression (leaked inference state), not against master - master compiles it.
    rvxHits = 0;
    (() => { Lambda<int()> inner = () => { return 4; }; rvxHits = inner(); })();
    result &= Test("rvx_iife_void_body_inner_lambda_value", rvxHits, 4);

    // Same question for a GENERIC instantiated mid-body: its `return v;` belongs to its own
    // declared int return type, not to the enclosing inferred-void literal. Also a mid-work
    // tripwire rather than a master-discriminating leg.
    rvxHits = 0;
    (() => { rvxHits = rvxId<int>(6); })();
    result &= Test("rvx_iife_generic_body_value", rvxHits, 6);

    return result;
}

/*
 * ACCEPT SET of the void-closure-call gate (fix/voidcall). Consuming a void closure call's
 * result is now a diagnostic (Test/errors/err_void_closure_call_consumed.cb); every DISCARD
 * position below must keep compiling and running. These are the positions the gate's
 * `ResultUse` threading has to reach - a discard forwarding that stops one level short turns
 * any of them into a false rejection, which is the failure mode these legs exist to catch.
 * All of them ran correctly pre-fix, so they discriminate against the fix's own polarity, not
 * against master.
 */
int vdcHits = 0;
void vdcBump()             { vdcHits = vdcHits + 1; }
auto vdcAutoVoid<T>(T value) { vdcBump(); return vdcBump(); }
void vdcRun(Lambda<void()> f) { f(); }
void vdcRunG<T>(T v, Lambda<void()> f) { f(); }
struct VdcHold { Lambda<void()> f = default; };
using VdcVoid = void;
Lambda<VdcVoid()> vdcAliasCrossing = default;
struct VboDiscard {
    int n = default;
    void operator+(VboDiscard other) { vdcHits = vdcHits + 1; }
};
// The one legal void crossing, spelled through the alias: EmitReturnExpression resolves it.
void vdcAliasReturn() { return vdcAliasCrossing(); }

bool testVoidClosureCallDiscarded()
{
    bool result = true;

    vdcHits = 0;
    Lambda<void()> g = () => { vdcBump(); };
    g();
    result &= Test("vdc_bare_statement", vdcHits, 1);

    vdcHits = 0;
    vdcAutoVoid<int>(1);
    result &= Test("vdc_auto_return_void_expr", vdcHits, 2);

    // Thin `function<>` is the OTHER arm of CreateIndirectCall; it has to discard too.
    vdcHits = 0;
    function<void()> t = () => { vdcBump(); };
    t();
    result &= Test("vdc_bare_statement_thin", vdcHits, 1);

    // A for-INCREMENT is a discard position reached by its own ParseAssignmentExpressionNamed
    // call, not by the expression-statement one.
    vdcHits = 0;
    for (int i = 0; i < 3; g()) { i = i + 1; }
    result &= Test("vdc_for_increment", vdcHits, 3);

    // Loop body / nested lambda body: the discard has to survive one more block level.
    vdcHits = 0;
    while (vdcHits < 4) { g(); }
    result &= Test("vdc_while_body", vdcHits, 4);

    vdcHits = 0;
    Lambda<void()> twice = () => { g(); g(); };
    twice();
    result &= Test("vdc_nested_lambda_body", vdcHits, 2);

    // A void `=> expr` body whose expression IS a void closure call - the discard path landed
    // by the void-expression-body fix, routed through the new ResultUse::Discard spelling.
    vdcHits = 0;
    Lambda<void()> fwd = () => g();
    fwd();
    result &= Test("vdc_void_expr_body_forwards", vdcHits, 1);

    // Through a PARAMETER and through a FIELD - the two non-local closure spellings whose
    // value-position twins are rejected legs.
    vdcHits = 0;
    vdcRun(g);
    result &= Test("vdc_through_parameter", vdcHits, 1);

    vdcHits = 0;
    vdcRunG<int>(1, g);
    result &= Test("vdc_through_generic_parameter", vdcHits, 1);

    vdcHits = 0;
    {
        VdcHold h = default;
        h.f = () => { vdcBump(); };
        h.f();
        result &= Test("vdc_through_field", vdcHits, 1);
    }

    // A NON-void closure call discarded as a statement must still run - the gate keys on
    // void-ness, so an int-returning closure has to be untouched in the very same position.
    vdcHits = 0;
    Lambda<int()> gi = () => { vdcBump(); return 9; };
    gi();
    result &= Test("vdc_nonvoid_discarded_still_runs", vdcHits, 1);
    result &= Test("vdc_nonvoid_value_still_consumable", gi(), 9);

    // PARENTHESES are not an operator, so a discard behind them is still a discard. Review found
    // all three newly rejected by the first cut of the gate - the ResultUse rode only the
    // single-child chain and a '(' expression ')' primary re-entered at the Value default.
    vdcHits = 0;
    (g());
    result &= Test("vdc_paren_statement", vdcHits, 1);

    vdcHits = 0;
    ((g()));
    result &= Test("vdc_double_paren_statement", vdcHits, 1);

    vdcHits = 0;
    Lambda<void()> pw = () => (g());
    pw();
    result &= Test("vdc_void_expr_body_paren", vdcHits, 1);

    // A chained call: the parenthesized producer is consumed as a VALUE (it yields a closure),
    // and only the outer call is the discard. The `childLimit == 1` guard that stops the thread
    // at a suffix admits nothing either way - dropping it leaves `(g())();`, `(g())[0];` and
    // `(g()).n;` rejected - but it decides WHICH message they get: with the guard they name the
    // void consumption, without it they misreport as "unknown function '(g())'" / "Undefined
    // variable n". So this leg freezes the chained shape; the guard's own value is diagnostic.
    vdcHits = 0;
    Lambda<Lambda<void()>()> mk = () => { return g; };
    (mk())();
    result &= Test("vdc_paren_then_call", vdcHits, 1);

    // `void` reached through a `using` ALIAS - the discard side of the alias resolution whose
    // reject side is vccAlias/vccAliasThin in the error file.
    vdcHits = 0;
    Lambda<VdcVoid()> av = () => { vdcBump(); };
    av();
    result &= Test("vdc_alias_void_discarded", vdcHits, 1);

    vdcHits = 0;
    vdcAliasCrossing = () => { vdcBump(); };
    vdcAliasReturn();
    result &= Test("vdc_alias_void_return_crossing", vdcHits, 1);

    // `void*` shares the "void" TypeName but returns a real value: consuming it is legal and
    // must NOT be rejected. This is the gate's exact boundary.
    Lambda<void*()> vp = () => vebGiveP();
    void* pv = vp();
    result &= Test("vdc_voidptr_result_consumable", pv == vebGiveP() ? 1 : 0, 1);

    // A ternary used as a statement discards BOTH arms. This reaches the conditional parser
    // instead of the old single-child ResultUse path.
    vdcHits = 0;
    VboDiscard va = default;
    VboDiscard vb = default;
    true ? va + vb : va + vb;
    result &= Test("vdc_ternary_void_binary_discarded", vdcHits, 1);

    return result;
}

int lambdaDefaultPlusTwo(function<int(int)> cb = (int x) => x + 2) { return cb(1); }

bool testLambdaDefaultLiteral()
{
    return Test("lambda_default_literal", lambdaDefaultPlusTwo(), 3) == 1;
}

int nlcHits = 0;
int nlcBump(int by) { nlcHits = nlcHits + by; return nlcHits; }
int nlcApply(function<int(int)> g, int v) { return g(v); }
int nlcAssign = 0;
struct NlcBox { int value = default; };
int nlcTakeText(string s) { return s == "ok" ? 1 : 0; }
int nlcReturnsInvoked(int x) { return ((int y) => { return y + 1; })(x); }
// The EXPRESSION-body spelling must agree with the block-body one above: both read the
// enclosing function's return type, so neither is "uninferable".
int nlcReturnsInvokedExpr(int x) { return ((int y) => y + 1)(x); }
// Two levels deep: the inner literal reads the OUTER LITERAL's return type, not the
// `Lambda<int()>` the variable was declared with.
int nlcNestedInLambdaBody()
{
    Lambda<int()> n = () => (() => 41)() + 1;
    return n();
}
// An OWNING destination must ride the synthesized signature, not just its spelling.
class NlcDt { int v = default; ~NlcDt() { nlcHits = nlcHits + 1; } };
int nlcOwningIife()
{
    unique NlcDt* p = (() => { unique NlcDt* q = new NlcDt(); q->v = 9; return q; })();
    return p->v;
}

// A lambda literal nested inside another literal's body used to read the ENCLOSING
// lambdaExpectedType. An immediately-invoked inner literal now takes its return type from how
// ITS call result is used - void when discarded, the destination type in a value context.
bool testNestedLambdaOwnContext()
{
    bool result = true;

    // Inner literal has a VOID body and its invocation is DISCARDED, inside an outer literal
    // declared to return int. Pre-fix the inner inherited the outer's 'int' and was rejected
    // with "Lambda '__lambda_1' missing return statement."
    nlcHits = 0;
    function<int(int)> voidInner = (int x) => { ((int y) => { nlcBump(y); })(x); return x + 1; };
    result &= Test("nlc_void_inner_discarded", voidInner(4), 5);
    result &= Test("nlc_void_inner_ran", nlcHits, 4);

    // Inner literal RETURNS A VALUE into an int destination, inside an outer literal declared
    // to return void. Pre-fix the inner inherited 'void' and was rejected with "cannot return a
    // value from a function whose return type is 'void'".
    nlcHits = 0;
    function<void(int)> valueInner = (int x) => { int v = ((int y) => { return y * 2; })(x); nlcBump(v); };
    valueInner(5);
    result &= Test("nlc_value_inner_in_void_outer", nlcHits, 10);

    // Two levels of nesting: the innermost discarded invocation must not inherit either of the
    // two enclosing literals. Pre-fix: "Lambda '__lambda_2' missing return statement."
    nlcHits = 0;
    function<int(int)> twoDeep = (int x) => {
        ((int y) => { ((int z) => { nlcBump(z); })(y); })(x);
        return x;
    };
    result &= Test("nlc_two_deep_discarded", twoDeep(9), 9);
    result &= Test("nlc_two_deep_inner_ran", nlcHits, 9);

    // ACCEPT SET - these already worked and must keep working, because the value context still
    // reaches an inner literal by inheritance where no destination type supersedes it.
    // Outer EXPRESSION body: the inner call IS the outer's return operand.
    function<int(int)> exprBody = (int x) => ((int y) => { return y + 1; })(x);
    result &= Test("nlc_expr_body_outer", exprBody(7), 8);

    // Inner literal passed as an ARGUMENT (not immediately invoked): the parameter-matching
    // path supplies its type, and this change must not disturb it.
    function<int(int)> asArg = (int x) => { return nlcApply((int y) => { return y * 5; }, x); };
    result &= Test("nlc_inner_as_argument", asArg(3), 15);

    // Inner and outer both void.
    nlcHits = 0;
    function<void(int)> bothVoid = (int x) => { ((int y) => { nlcBump(y); })(x); };
    bothVoid(2);
    result &= Test("nlc_both_void", nlcHits, 2);

    // Every DESTINATION position supplies the context, not just a declarator. Each of the four
    // below reported an error pre-fix, and each names a different site.

    // ASSIGNMENT target: pre-fix "cannot return a value from a function whose return type is
    // 'void'" - the inner literal read the enclosing void literal instead of the int target.
    nlcAssign = 0;
    function<void(int)> toAssign = (int x) => { nlcAssign = ((int z) => { return z * 2; })(x); };
    toAssign(5);
    result &= Test("nlc_assignment_target", nlcAssign, 10);

    // BRACE-INIT FIELD: same pre-fix message, at the field-initializer site.
    nlcAssign = 0;
    function<void(int)> toField = (int x) => {
        NlcBox t = { value = ((int z) => { return z * 3; })(x) };
        nlcAssign = t.value;
    };
    toField(4);
    result &= Test("nlc_brace_init_field", nlcAssign, 12);

    // An index has its own integer destination. It must not inherit the final string element's
    // type, while the string array element remains a valid value destination for the declaration.
    string[2] nlcIndexed = { "left", "right" };
    result &= Test("nlc_index_context", nlcIndexed[((() => { return 1; })())], "right");

    // RETURN of a plain named function: pre-fix "cannot infer the return type of lambda" - the
    // return type only propagated when it was a function pointer.
    result &= Test("nlc_named_function_return", nlcReturnsInvoked(6), 7);

    // Inside a call ARGUMENT the matched PARAMETER wins over the enclosing declaration's type.
    // Pre-fix "cannot infer"; with the declaration context alone it would be forced to 'int'
    // and reject the string the parameter actually takes.
    int viaArg = nlcTakeText(((int y) => { return "ok"; })(1));
    result &= Test("nlc_argument_parameter_wins", viaArg, 1);

    // The block-body and expression-body spellings of the same return must agree.
    result &= Test("nlc_named_function_return_expr", nlcReturnsInvokedExpr(6), 7);

    // An inner immediately-invoked literal reads its enclosing LITERAL's return type.
    result &= Test("nlc_nested_in_lambda_body", nlcNestedInLambdaBody(), 42);

    // Ownership rides the synthesized signature: the returned pointer stays owning, so the
    // destructor runs exactly once at scope exit rather than the value being copied out raw.
    nlcHits = 0;
    result &= Test("nlc_owning_iife_value", nlcOwningIife(), 9);
    result &= Test("nlc_owning_iife_dtor_once", nlcHits, 1);

    return result;
}

struct CallbackCtx
{
    list<int> seen = default;
    int calls = default;
};

// Mimics a C enumeration API: a bare stdcall code address plus an opaque context slot.
extern stdcall i32 cbCollectItem(void* handle, i64 context)
{
    CallbackCtx* ctx = (CallbackCtx*)context;
    ctx.seen.add((int)(i64)handle);
    ctx.calls = ctx.calls + 1;
    return 1;
}

int cbEnumerate(i64 context)
{
    for (int i = 1; i <= 3; i++) cbCollectItem((void*)(i64)i, context);
    return 0;
}

bool testCallbackContextSlot()
{
    bool result = true;
    CallbackCtx ctx;
    // `(i64)&ctx` is a BORROW: it must not consume ctx nor its owning `list<int>` member.
    cbEnumerate((i64)&ctx);
    result &= Test("cbctx_calls", ctx.calls, 3);
    result &= Test("cbctx_count", ctx.seen.count(), 3);
    result &= Test("cbctx_first", ctx.seen[0], 1);
    result &= Test("cbctx_last", ctx.seen[2], 3);
    // The context is still fully usable after the enumeration - no move happened.
    ctx.seen.add(9);
    result &= Test("cbctx_live_after", ctx.seen.count(), 4);
    return result;
}

extern int main(int argc, char** argv)
{
    // The tooling regression harness passes one argument and calls this twice. The second call
    // must report the first call's move location, rather than a generic null dereference.
    if (argc > 1)
    {
        runStaticOriginProbe();
        runStaticOriginProbe();
        return 0;
    }

    int passed = 0;
    int total  = 0;

    // Function pointer tests
    total++; passed += testExplicitFunctionPointer()   ? 1 : 0;
    total++; passed += testBareFunctionPointer()       ? 1 : 0;
    total++; passed += testFunctionPointerAsArgument() ? 1 : 0;
    total++; passed += testFunctionPointerInLoop()     ? 1 : 0;
    total++; passed += testFunctionPointerCountIf()    ? 1 : 0;
    total++; passed += testVoidFunctionPointer()       ? 1 : 0;
    total++; passed += testFunctionPointerClamp()      ? 1 : 0;

    // Lambda tests
    total++; passed += testLambdaBasic()               ? 1 : 0;
    total++; passed += testLambdaControlFlow()         ? 1 : 0;
    total++; passed += testLambdaLocalVars()           ? 1 : 0;
    total++; passed += testLambdaCallsNamedFunction()  ? 1 : 0;
    total++; passed += testLambdaBoolReturn()          ? 1 : 0;
    total++; passed += testLambdaReassignment()        ? 1 : 0;
    total++; passed += testLambdaAsArgument()          ? 1 : 0;
    total++; passed += testLambdaInHigherOrder()       ? 1 : 0;
    total++; passed += testLambdaThreeParam()          ? 1 : 0;
    total++; passed += testVoidLambda()               ? 1 : 0;
    total++; passed += testReturnLambdaLiteral()       ? 1 : 0;

    // Lambda capture tests
    total++; passed += testCapturePrimitives()         ? 1 : 0;
    total++; passed += testCaptureString()             ? 1 : 0;
    total++; passed += testCaptureStructRef()          ? 1 : 0;
    total++; passed += testCaptureStructRefBorrows()   ? 1 : 0;
    total++; passed += testCaptureOwningContainerEscapes() ? 1 : 0;
    total++; passed += testCaptureMultiple()           ? 1 : 0;
    total++; passed += testCaptureRegression()         ? 1 : 0;
    total++; passed += testCaptureNameCollidesWithFunction() ? 1 : 0;
    total++; passed += testCaptureLocalArray()         ? 1 : 0;
    total++; passed += testLambdaAllocaInLoop()        ? 1 : 0;
    total++; passed += testCaptureBondReassign()       ? 1 : 0;
    total++; passed += testCaptureThis()               ? 1 : 0;
    total++; passed += testNestedClosureTransitiveCapture() ? 1 : 0;
    total++; passed += testLambdaParamShadowsEnclosing()  ? 1 : 0;
    total++; passed += testInterfaceReturnWithLambda()  ? 1 : 0;
    total++; passed += testLambdaExprBodyOwnedTemp()    ? 1 : 0;
    total++; passed += testLambdaVoidExprBody()         ? 1 : 0;

    // Generic function pointer tests
    total++; passed += testGenericFuncPtrBasic()       ? 1 : 0;
    total++; passed += testGenericFuncPtrSizeof()      ? 1 : 0;
    total++; passed += testGenericFuncPtrWrite()       ? 1 : 0;
    total++; passed += testGenericFuncPtrDoubleInPlace() ? 1 : 0;
    total++; passed += testGenericFuncPtrHigherOrder() ? 1 : 0;

    // Function pointer in struct field tests
    total++; passed += testFuncPtrInStructField()      ? 1 : 0;
    total++; passed += testFuncPtrInStructFieldVoid()  ? 1 : 0;

    // Dispatch table tests
    total++; passed += testDispatchTable()             ? 1 : 0;

    // Fixed-size array of function<T> values (multiple element invokes)
    total++; passed += testFuncPtrArray()               ? 1 : 0;
    total++; passed += testFuncPtrArray2D()             ? 1 : 0;
    total++; passed += testFuncPtrAliasArray()          ? 1 : 0;
    total++; passed += testFuncPtrPointerOverload()     ? 1 : 0;

    // 'move' in function pointer signatures
    total++; passed += testFuncPtrMoveSignature()      ? 1 : 0;

    // Non-capturing lambda across the C ABI
    total++; passed += testNonCapturingLambdaToCFuncPtr() ? 1 : 0;

    // Lambda<T>.toFunction() fat -> thin lowering
    total++; passed += testFuncToFunction()             ? 1 : 0;

    // Cast a raw code address to a thin function<...> (COM/foreign-vtable shape)
    total++; passed += testCastAddrToThinFnPtr()        ? 1 : 0;

    // List sort tests
    total++; passed += testListSortAscending()         ? 1 : 0;
    total++; passed += testListSortDescending()        ? 1 : 0;
    total++; passed += testListSortEdgeCases()         ? 1 : 0;
    total++; passed += testListSortNamedComparator()   ? 1 : 0;

    // Function-type aliases (using Cb = Lambda<R(Args)>)
    total++; passed += testFunctionTypeAlias()          ? 1 : 0;

    // Closure / generics monomorphization (gap a: closure as generic arg; gap b: generic in sig)
    total++; passed += testClosureGenericSigReturn()    ? 1 : 0;
    total++; passed += testClosureListFat()             ? 1 : 0;
    total++; passed += testClosureListThin()            ? 1 : 0;
    total++; passed += testClosureListAliasUnify()      ? 1 : 0;
    total++; passed += testClosureListSpellingUnify()   ? 1 : 0;

    // <Tag/> sugar: lambda attribute return-type inference
    total++; passed += testSugarLambdaAttrReturnType()  ? 1 : 0;

    // By-reference capture of a POD stored into a field (must not be rejected as a borrow)
    total++; passed += testClosureCapturedPodIntoField() ? 1 : 0;

    // Brace-init of a closure field auto-clones the env, same as the `=` store
    total++; passed += testClosureBraceInitClonesEnv()   ? 1 : 0;
    total++; passed += testClosureFieldReadIntoLocal()   ? 1 : 0;

    // Function-pointer argument provenance / signature gating: legal spellings still bind
    total++; passed += testFuncPtrArgProvenanceAccepts()  ? 1 : 0;

    // Accept set for the shape-mismatch gate (fix/shape-arg): array->pointer decay, an array
    // element (shape 0), nullptr into pointer/view, and two-arm shape ranking stay legal.
    total++; passed += testFuncPtrShapeGateAccepts()       ? 1 : 0;

    // A `function<>` CALL RESULT into a closure parameter (fat and thin)
    total++; passed += testFuncPtrCallResultIntoClosureParam() ? 1 : 0;

    // Accept set for the code-value STORE gate (decl-init / assignment / field / return)
    total++; passed += testCodeValueStoreAccepts()        ? 1 : 0;

    // Accept set for the AGGREGATE / DEFAULT store spellings (brace, array, field/param default)
    total++; passed += testCodeValueAggregateStoreAccepts() ? 1 : 0;

    // Accept set for the JOIN spellings ('?:' and '??', into code slots, casts, data joins)
    total++; passed += testCodeValueJoinAccepts()          ? 1 : 0;

    // Accept set for a JOIN into a closure PARAMETER (the widen gate's EVERY-arm data question)
    total++; passed += testDataJoinClosureAccepts()        ? 1 : 0;

    // A GENERIC function returning function<>/Lambda<> must not poison its CALLER's return
    total++; passed += testGenericFuncPtrProducer()        ? 1 : 0;

    // A THIN 'function<T>*' as a GENERIC TYPE ARGUMENT (the fat twin is rejected in
    // Test/errors/err_lambda_array_view.cb)
    total++; passed += testThinFuncPtrGenericArg()         ? 1 : 0;
    total++; passed += testClosureByValueGenericArg()      ? 1 : 0;

    // Fat Lambda<> FIELD default widening: a legal bare/thin source is stored {code, null},
    // not the raw pointer that crashed the call (fix/fat-widen).
    total++; passed += testFatFieldDefaultWidensLegalSource() ? 1 : 0;

    // A closure member of a UNION: calling it crashed the compiler (fat) / failed module
    // verification (thin), and union field defaults were discarded entirely.
    total++; passed += testUnionClosureMember()            ? 1 : 0;

    // Returning a lambda's BY-VALUE capture of an owning value type must hand the caller an
    // independent copy: the env owns its capture and frees it exactly once (fix/lamcap).
    total++; passed += testReturnCapturedOwningValue()     ? 1 : 0;

    // `void f() { return g(); }` on a VOID g - the one void-ness crossing that stays legal
    // now that a disagreeing `return` is a diagnostic instead of a verifier dump (fix/retvoid).
    total++; passed += testReturnVoidExprFromVoid()        ? 1 : 0;

    // Accept set of the void-closure-call gate: every DISCARD position keeps working
    // now that consuming a void closure call's result is a diagnostic (fix/voidcall).
    total++; passed += testVoidClosureCallDiscarded()      ? 1 : 0;
    total++; passed += testLambdaDefaultLiteral()           ? 1 : 0;

    // An immediately-invoked lambda literal nested in another literal's body takes its return
    // type from its OWN call context, not from the enclosing literal (fix/q15).
    total++; passed += testNestedLambdaOwnContext()         ? 1 : 0;

    // A `stdcall` callback cannot capture, so the sanctioned way to carry state is to round-trip
    // the ADDRESS of a context struct through the API's integer context slot (Win32 `lParam`,
    // `void* userdata`, ...). The cast out must borrow, not consume: the context stays live and
    // owning members survive. Documented in doc/C_INTEROP.md.
    total++; passed += testCallbackContextSlot()            ? 1 : 0;

    printf("Function pointer / lambda tests: %d/%d passed.\n", passed, total);
    return passed == total ? 0 : 1;
}
