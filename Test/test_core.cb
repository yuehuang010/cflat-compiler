// ── dictionary: rehash stress ─────────────────────────────────────────────────

int testDictRehash()
{
    int passed = 0;

    dictionary<int, int> d;
    int i = 0;
    while (i < 100) { d.add(i, i * 3); i++; }
    passed += Test("d-rehash count 100",   d.count(),       100);
    passed += Test("d-rehash get 0",       d.get(0),        0);
    passed += Test("d-rehash get 99",      d.get(99),       297);
    passed += Test("d-rehash missing 100", d.contains(100), false);

    i = 0;
    while (i < 100) { if (i % 2 == 0) d.set(i, i * -1); i++; }
    passed += Test("d-rehash updated 0",  d.get(0),   0);
    passed += Test("d-rehash updated 2",  d.get(2),   -2);
    passed += Test("d-rehash updated 98", d.get(98),  -98);
    passed += Test("d-rehash odd 1",      d.get(1),   3);
    passed += Test("d-rehash odd 99",     d.get(99),  297);

    return passed;
}

// -- dictionary/hashset: insert-remove churn (tombstone saturation) -----------
// Regression: tombstones were not counted toward the load factor, so a rehash never
// fired during churn.  Deleted slots accumulated until zero empty slots were left and
// the `while (_status[slot] != 0)` probe loops spun forever (map paint path hang).

int testDictChurn()
{
    int passed = 0;

    // Mimics the map's per-frame markVisible/cancelNotIn: pin 8 keys, drop them, shift.
    dictionary<u64, bool> pinned;
    u64 base = 0;
    int round = 0;
    while (round < 5000)
    {
        int i = 0;
        while (i < 8) { pinned.set(base + (u64)i, true); i++; }
        i = 0;
        while (i < 8) { pinned.remove(base + (u64)i); i++; }
        base = base + 4;
        round++;
    }
    passed += Test ("d-churn completes",  round,          5000);
    passed += Test ("d-churn empty",      pinned.count(), 0);

    // The table must still be correct (and bounded) after all that churn.
    pinned.set(42, true);
    passed += Test("d-churn set after",   pinned.contains(42), true);
    passed += Test("d-churn get after",   pinned.get(42),      true);
    passed += Test("d-churn miss after",  pinned.contains(43), false);
    passed += Test ("d-churn count after", pinned.count(),      1);

    // Churn with a live working set that is repeatedly overwritten and re-keyed.
    dictionary<int, int> d;
    int r = 0;
    while (r < 2000)
    {
        int i = 0;
        while (i < 16) { d.set(r * 8 + i, r + i); i++; }
        i = 0;
        while (i < 16) { d.remove(r * 8 + i); i++; }
        r++;
    }
    passed += Test ("d-churn2 empty", d.count(), 0);

    // A retained set of keys must survive churn around it with values intact.
    dictionary<int, int> keep;
    int k = 0;
    while (k < 10) { keep.set(k, k * 100); k++; }
    r = 0;
    while (r < 2000)
    {
        keep.set(1000 + r, r);
        keep.remove(1000 + r);
        r++;
    }
    passed += Test ("d-churn3 count",  keep.count(), 10);
    passed += Test ("d-churn3 get 0",  keep.get(0),  0);
    passed += Test ("d-churn3 get 7",  keep.get(7),  700);
    passed += Test ("d-churn3 get 9",  keep.get(9),  900);
    passed += Test("d-churn3 miss",   keep.contains(1500), false);

    return passed;
}

int testHashsetChurn()
{
    int passed = 0;

    hashset<i64> s;
    i64 base = 0;
    int round = 0;
    while (round < 5000)
    {
        int i = 0;
        while (i < 8) { s.add(base + (i64)i); i++; }
        i = 0;
        while (i < 8) { s.remove(base + (i64)i); i++; }
        base = base + 4;
        round++;
    }
    passed += Test ("hs-churn completes", round,     5000);
    passed += Test ("hs-churn empty",     s.count(), 0);

    // Retained elements survive surrounding churn.
    hashset<int> keep;
    int k = 0;
    while (k < 10) { keep.add(k); k++; }
    int r = 0;
    while (r < 2000)
    {
        keep.add(1000 + r);
        keep.remove(1000 + r);
        r++;
    }
    passed += Test ("hs-churn keep count", keep.count(),        10);
    passed += Test("hs-churn keep 0",     keep.contains(0),    true);
    passed += Test("hs-churn keep 9",     keep.contains(9),    true);
    passed += Test("hs-churn miss",       keep.contains(1500), false);

    return passed;
}

// ── string / stringbuilder / string_view ─────────────────────────────────────

// A static table of string literals at file scope: each element folds to a borrowed
// {ptr,len} constant, the same shape a scalar `string g = "x";` global takes.
string[2] g_symbolTable = { "AAPL", "MSFT" };

struct StringRow { string name = default; };

struct CPToken { string text = default; };

CPToken makeCPToken(string t)
{
    CPToken tk = default;
    tk.text = "" + t;
    return tk;
}

char* giveCharPtr()
{
    return "wxyz";
}

int lenOfString(string s)
{
    return (int)s.length();
}

int testString()
{
    int passed = 0;

    string s = "hello";
    passed += Test("string literal length", s.length(), 5);
    passed += Test("string literal data",   s.data(),   "hello");

    string empty = "";
    passed += Test("empty string length", empty.length(), 0);

    stringbuilder sb;
    passed += Test("sb initial length", sb.length(), 0);

    sb.appendCStr("foo");
    passed += Test("sb after appendCStr length", sb.length(), 3);
    passed += Test("sb after appendCStr data",   sb.data(),   "foo");

    sb.appendChar('!');
    passed += Test("sb after appendChar length", sb.length(), 4);
    passed += Test("sb after appendChar data",   sb.data(),   "foo!");

    string view = sb.toString();
    passed += Test("sb toString length", view.length(), 4);
    passed += Test("sb toString data",   view.data(),   "foo!");

    sb.clear();
    passed += Test("sb after clear length", sb.length(), 0);

    // char* -> string coercion must apply on ASSIGNMENT to an existing string, not just
    // on initialization: `s = buf;` and `r.name = buf;` must route through operator
    // string(const char*) so _len = strlen(buf), not stay 0 (raw-pointer store bug).
    char[16] cbuf = {'a', 'b', 'c', '\0'};

    string assignInit = cbuf;
    passed += Test("char* init length", assignInit.length(), 3);

    string assignLocal = default;
    assignLocal = cbuf;
    passed += Test("char* assign local length", assignLocal.length(), 3);
    passed += Test("char* assign local data",   assignLocal.data(),   "abc");

    StringRow row;
    row.name = cbuf;
    passed += Test("char* assign field length", row.name.length(), 3);
    passed += Test("char* assign field data",   row.name.data(),   "abc");

    // Method-call syntax on a char* / char[N] receiver dispatches to
    // toString(const char* self), yielding an OWNED string copy of the C bytes.
    char* litPtr = "abc";
    string fromPtr = litPtr.toString();
    passed += Test("char* toString length", fromPtr.length(), 3);
    passed += Test("char* toString data",   fromPtr.data(),   "abc");

    char[16] mbuf = {'a', 'b', 'c', '\0'};
    string fromArr = mbuf.toString();
    passed += Test("char[N] toString length", fromArr.length(), 3);
    passed += Test("char[N] toString data",   fromArr.data(),   "abc");

    // The call copies the bytes and leaves the source buffer untouched.
    passed += Test("char[N] toString source intact", (int)mbuf[0], (int)'a');

    // The result is owned: mutating the source after the call must not change it
    // (a non-owning wrap would alias the buffer and change with it).
    mbuf[0] = 'Z';
    passed += Test("char[N] toString owned", fromArr.data(), "abc");

    // Assigning a runtime (non-literal) char* to a string must derive the length via
    // strlen/operator string, not silently leave it at 0 (charptr-to-string-conversion
    // bug). Covers: struct-field char* on declaration-init, char* returned from a
    // function, and the ternary unification path.
    CPToken tk = makeCPToken("hello");
    string s1 = tk.text.data();
    passed += Test("charptr field assign length", s1.length(), 5);

    string s2 = giveCharPtr();
    passed += Test("charptr from function length", s2.length(), 4);

    function<int(string)> fp = lenOfString;
    int viaFp = fp(giveCharPtr());
    passed += Test("charptr via function<> indirect call length", viaFp, 4);

    bool trueCond = true;
    string s3 = trueCond ? tk.text.data() : tk.text;
    passed += Test("charptr ternary length", s3.length(), 5);

    return passed;
}

int testStringConcat()
{
    int passed = 0;

    string a = "hello";
    string b = " world";

    string c = a + b;
    passed += Test("concat length",  c.length(), 11);
    passed += Test("concat data",    c.data(),   "hello world");
    passed += Test("parenthesized concat data", (a + " " + b).data(), "hello  world");
    passed += Test("nested parenthesized concat data", ((a + " " + b)).data(), "hello  world");
    passed += Test("parenthesized literal data", ("literal").data(), "literal");
    passed += Test("parenthesized concat chain data", (a + " " + b).copy().data(), "hello  world");

    string d = a + " there";
    passed += Test("concat char* length", d.length(), 11);
    passed += Test("concat char* data",   d.data(),   "hello there");

    string e = c + b;
    passed += Test("chained concat length", e.length(), 17);
    passed += Test("chained concat data",   e.data(),   "hello world world");

    string empty = "";
    string f = empty + a;
    passed += Test("empty + s length", f.length(), 5);
    passed += Test("empty + s data",   f.data(),   "hello");

    string g = a + empty;
    passed += Test("s + empty length", g.length(), 5);
    passed += Test("s + empty data",   g.data(),   "hello");

    return passed;
}

class StringGreeting : IString
{
    string ToString()
    {
        string s = "world";
        return s;
    }
};

int testStringIString()
{
    int passed = 0;

    string prefix = "hello ";
    StringGreeting g;

    string result = prefix + g;
    passed += Test("istring concat length", result.length(), 11);
    passed += Test("istring concat data",   result.data(),   "hello world");

    string result2 = "goodbye " + g;
    passed += Test("istring literal concat length", result2.length(), 13);
    passed += Test("istring literal concat data",   result2.data(),   "goodbye world");

    return passed;
}

class StringColor : IString
{
    i32 r = 0;
    i32 g = 0;
    i32 b = 0;

    string ToString()
    {
        return "rgb({r},{g},{b})";
    }
};

int testStringInterpolation()
{
    int passed = 0;

    string name = "World";
    passed += Test("interp_simple",    "Hello {name}!",  "Hello World!");

    string a = "foo";
    string b = "bar";
    passed += Test("interp_two_vars",  "{a} and {b}",    "foo and bar");

    string mid = "mid";
    passed += Test("interp_sandwich",  "pre-{mid}-suf",  "pre-mid-suf");

    i32 n = 42;
    passed += Test("interp_int",       "n={n}",          "n=42");

    StringColor c;
    c.r = 255;
    c.g = 128;
    c.b = 0;
    passed += Test("interp_istring",   "color={c}",      "color=rgb(255,128,0)");

    string label = "score";
    i32 value = 99;
    passed += Test("interp_mixed",     "{label}={value}", "score=99");

    // An EMPTY brace pair is not interpolated: the literal stays a plain char*. PRE, the label
    // failed overload resolution and 'emptyPair' failed pointer initialization ('string' source).
    char* emptyPair = "a = {} b";
    passed += Test("interp_empty_pair_is_charptr = {} in label", emptyPair, "a = {} b");

    // A '{' with no matching '}' is a plain character for the same reason.
    char* unmatched = "unmatched { brace";
    passed += Test("interp_unmatched_brace_is_charptr", unmatched, "unmatched { brace");

    // Accept-set freeze (passes on both binaries by design): a literal that DOES interpolate
    // is unchanged, and the empty pair stays ordinary text inside it.
    i32 seven = 7;
    passed += Test("interp_empty_pair_with_segment", "a {} b {seven}", "a {} b 7");

    // Deliberate PRE->POST change: on the plain path an empty pair's trailing '}' now folds
    // with the next one per the '}}' escape rule (PRE read "a {}} b").
    char* braceRun = "a {}} b";
    passed += Test("interp_empty_pair_brace_run", braceRun, "a {} b");

    return passed;
}

int testStringSwitch()
{
    int passed = 0;

    string fruit = "Apple";
    int result = -1;
    switch (fruit)
    {
        case "Apple":  result = 1; break;
        case "Banana": result = 2; break;
        case "Cherry": result = 3; break;
        default:       result = 0; break;
    }
    passed += Test("switch_match_apple", result, 1);

    fruit = "Banana";
    result = -1;
    switch (fruit)
    {
        case "Apple":  result = 1; break;
        case "Banana": result = 2; break;
        case "Cherry": result = 3; break;
        default:       result = 0; break;
    }
    passed += Test("switch_match_banana", result, 2);

    fruit = "Mango";
    result = -1;
    switch (fruit)
    {
        case "Apple":  result = 1; break;
        case "Banana": result = 2; break;
        case "Cherry": result = 3; break;
        default:       result = 0; break;
    }
    passed += Test("switch_default", result, 0);

    string sa = "hello";
    string sb = "hello";
    string sc = "world";
    passed += Test("str_eq_same",  sa == sb, true);
    passed += Test("str_eq_diff",  sa == sc, false);
    passed += Test("str_neq_diff", sa != sc, true);

    return passed;
}

int testStringBuilder()
{
    int passed = 0;

    stringbuilder sb;
    string s = "hello";
    sb.append(s);
    passed += Test("sb_append_str_len",  sb.length(), 5);
    passed += Test("sb_append_str_data", sb.toString(), "hello");

    sb.append(", world");
    passed += Test("sb_append_cstr_len",  sb.length(), 12);
    passed += Test("sb_append_cstr_data", sb.toString(), "hello, world");

    sb.clear();
    sb.append(42);
    passed += Test("sb_append_int_pos",  sb.toString(), "42");

    sb.clear();
    sb.append(0);
    passed += Test("sb_append_int_zero", sb.toString(), "0");

    sb.clear();
    sb.append(-7);
    passed += Test("sb_append_int_neg",  sb.toString(), "-7");

    // Regression: append(i64) negated before formatting, which overflows at
    // INT64_MIN and emitted "-(" instead of the correct decimal digits.
    sb.clear();
    sb.append((i64)0);
    passed += Test("sb_append_i64_zero", sb.toString(), "0");

    sb.clear();
    sb.append((i64)(-1));
    passed += Test("sb_append_i64_neg_one", sb.toString(), "-1");

    sb.clear();
    sb.append((i64)9223372036854775807);
    passed += Test("sb_append_i64_max", sb.toString(), "9223372036854775807");

    sb.clear();
    sb.append((i64)(-9223372036854775807 - 1));
    passed += Test("sb_append_i64_min", sb.toString(), "-9223372036854775808");

    sb.clear();
    sb.append(true);
    passed += Test("sb_append_bool_true",  sb.toString(), "true");

    sb.clear();
    sb.append(false);
    passed += Test("sb_append_bool_false", sb.toString(), "false");

    sb.clear();
    sb.appendLine("hello");
    passed += Test("sb_appendLine_cstr_len",  sb.length(), 6);
    passed += Test("sb_appendLine_cstr_data", sb.toString(), "hello\n");

    sb.clear();
    string line = "world";
    sb.appendLine(line);
    passed += Test("sb_appendLine_str_len",  sb.length(), 6);
    passed += Test("sb_appendLine_str_data", sb.toString(), "world\n");

    sb.clear();
    sb.append("abc");
    passed += Test("sb_ToString", sb.ToString(), "abc");

    sb.clear();
    sb.append("score=");
    sb.append(99);
    sb.append(",done=");
    sb.append(true);
    passed += Test("sb_mixed_build", sb.toString(), "score=99,done=true");

    sb.clear();
    sb.appendLine("line1");
    sb.appendLine("line2");
    passed += Test("sb_multi_line_len",  sb.length(), 12);
    passed += Test("sb_multi_line_data", sb.toString(), "line1\nline2\n");

    sb.clear();
    int i = 0;
    while (i < 10)
    {
        sb.append("01234567890123456789");
        i++;
    }
    passed += Test("sb_growth_len", sb.length(), 200);

    sb.clear();
    passed += Test("sb_clear_len",  sb.length(), 0);
    sb.append("reused");
    passed += Test("sb_reuse_data", sb.toString(), "reused");

    return passed;
}

int testStringView()
{
    int passed = 0;

    string source = "hello world";

    string_view* wholeView = source.view();
    passed += Test("view_length", wholeView->length(), 11);
    passed += Test("view_data",   wholeView->data(),   "hello world");
    delete wholeView;

    string_view* wordView = source.span(6, 11);
    passed += Test("span_mid_length", wordView->length(), 5);
    passed += Test("span_mid_get0",   wordView->get(0), 'w');
    passed += Test("span_mid_get4",   wordView->get(4), 'd');
    delete wordView;

    string_view* prefixView = source.span(0, 5);
    passed += Test("span_prefix_length", prefixView->length(), 5);
    passed += Test("span_prefix_get0",   prefixView->get(0), 'h');
    passed += Test("span_prefix_get4",   prefixView->get(4), 'o');
    delete prefixView;

    string_view* emptyView = source.span(3, 3);
    passed += Test("span_empty_length", emptyView->length(), 0);
    delete emptyView;

    string_view* clampedView = source.span(-5, 100);
    passed += Test("span_clamp_length", clampedView->length(), 11);
    delete clampedView;

    string_view* invertedView = source.span(7, 3);
    passed += Test("span_inv_length", invertedView->length(), 0);
    delete invertedView;

    string emptySource = "";
    string_view* emptyStringView = emptySource.view();
    passed += Test("view_empty_length", emptyStringView->length(), 0);
    delete emptyStringView;

    // string_view(ptr, len): the (char*, int) chunk a C callback hands over, with no copy.
    // The literal length argument is typed i8, so this also pins the widening to i32.
    char* raw = "hello world";
    string_view chunk = string_view(raw, 5);
    passed += Test("view_ptr_len_length", chunk.length(), 5);
    passed += Test("view_ptr_len_get0", chunk.get(0), 'h');
    passed += Test("view_ptr_len_get4", chunk.get(4), 'o');
    string_view tailChunk = string_view(raw + 6, 5);
    string owned = tailChunk.toString();
    passed += Test("view_ptr_len_toString", owned, "world");
    passed += Test("view_ptr_len_toString_length", owned.length(), 5);
    string_view defaulted = default;
    passed += Test("view_default_still_empty", defaulted.length(), 0);

    passed += Test("global string array element 0", g_symbolTable[0], "AAPL");
    passed += Test("global string array element 1", g_symbolTable[1], "MSFT");

    return passed;
}

// ── string API (Phases 1-4) ──────────────────────────────────────────────────

// Consumes an owned string (e.g. a chained-concat result) by value-move and returns
// its length. Exercises the move-string-parameter ownership-transfer path of the
// chained-concat temporary cleanup: the callee frees the buffer, so the caller must
// NOT also free it. Regression for the chained-concat intermediate leak
// (see internal/string-concat-temp-flush.md).
int consumeMoveLen(move string s)
{
    return s.length();
}

// Helper for the if/else owned-string regression below: returns an owned copy
// chosen by branch. The helper-return form was the customer's known-good workaround.
move string pickName(u32 i)
{
    if (i == 0u) { string a = "known"; return a.copy(); }
    else         { string b = "other"; return b.copy(); }
}

// Helper for the owned-string ternary regression below. `name` is an owned heap
// buffer; `pick` returns a ternary whose non-default branch reads that field. The
// select used to shallow-alias the field's buffer (owned bit rode along), so the
// caller's owned-bit-gated dtor freed a buffer the field still owned (use-after-free).
class TernBox {
    string name = default;
    void set(string s) { this.name = s; }
    string pick(bool cond) { string who = cond ? this.name : "-"; return who.copy(); }
};

// Return-by-value of a struct whose destructor frees owned string fields. The local
// `o`'s destructor must be SKIPPED on the return (ownership moves to the caller) or the
// returned value dangles and the caller's destruction double-frees. g_owned_ret_dtor
// proves the struct is destructed exactly once (the returned `r`, not the local `o`).
// Regression for the return-by-value-of-dtor-bearing-struct fix + the string-field
// assignment ownership-transfer fix (internal/plan/string-ownership-fixes.md).
int g_owned_ret_dtor = 0;
struct OwnedRet {
    string a = default;
    string b = default;
    ~OwnedRet() {
        g_owned_ret_dtor++;
        if (a._ptr != nullptr) { i8* p = move a._ptr; delete p; }
        if (b._ptr != nullptr) { i8* p = move b._ptr; delete p; }
    }
};

OwnedRet makeOwnedRet()
{
    OwnedRet o;
    string s1 = "first-field";
    string s2 = "second-field";
    o.a = s1.copy();      // owned temp -> string field: ownership transfers to the field
    o.b = s2.copy();
    return o;             // by-value move-out: `o`'s dtor must not run here
}

// Owning-POINTER return helpers for the no-discard consumption regression. g_ptr_dtor proves an
// owning pointer return is freed exactly once when consumed - no double-free from the value-identity
// owned-return tracking, no missed free.
int g_ptr_dtor = 0;
class PtrOwned { int v = default; ~PtrOwned() { g_ptr_dtor++; } };
move PtrOwned* makePtrOwned() { return new PtrOwned; }
void sinkPtr(move PtrOwned* p) { delete p; }
move string makeOwnedStr() { string s = "hello"; return s.copy(); }
int viaClosureLen(function<int(string)> f, string s) { return f(s); }

// -- p2: a STRING LITERAL is a valid method receiver, and a `?.` chain that yields an
// owned string temp must not free it before the enclosing expression reads it.
struct P2Person {
    string name = default;
    move string label() { return "hi-" + name; }
};

int testLiteralReceiverAndNullChain()
{
    int passed = 0;

    // Pre-fix: "the function '\"\"' is not known." - the literal was read as the callee name.
    string empty = "".copy();
    passed += Test("litrecv empty copy length", empty.length(), 0);
    passed += Test("litrecv literal length", "abc".length(), 3);
    passed += Test("litrecv chained toLower", "HeLLo".toLower(), "hello");
    passed += Test("litrecv chained substring", "abcdef".substring(2), "cdef");
    string joined = "ab".copy() + "cd";
    passed += Test("litrecv copy then concat", joined, "abcd");

    // Pre-fix: printed garbage - the chain's owned string temp was freed at the '?.' merge,
    // before .data() was read. Compare the BYTES, so a dangling pointer cannot pass.
    P2Person person = default;
    person.name = "world";
    P2Person* p = &person;
    passed += Test("nullchain owned string data", p?.label().data(), "hi-world");
    passed += Test("nullchain owned string length", (int)p?.label().length(), 8);

    // The null arm still short-circuits, and running the shape many times must not
    // double-free (a double free aborts the process, so reaching the leg is the assertion).
    P2Person* nil = nullptr;
    int nilLen = 0;
    int liveTotal = 0;
    for (int i = 0; i < 64; i++)
    {
        nilLen = nilLen + (int)nil?.label().length();
        liveTotal = liveTotal + (int)p?.label().length();
    }
    passed += Test("nullchain null arm length", nilLen, 0);
    passed += Test("nullchain repeated live arm", liveTotal, 512);

    return passed;
}

// -- p2: `default` is a VALUE, not just an initializer. `p = default` re-defaults in place
// and must DESTRUCT the old contents first (an owning field would otherwise leak).
struct P2Def     { int a = 5; int b = 7; };
struct P2DefOwn  { string s = default; int n = 3; };
int g_p2_ternary_dtor = 0;
int g_p2_ternary_buffer_dtor = 0;
struct P2TernaryOwn
{
    string s = default;
    int n = 3;
    ~P2TernaryOwn()
    {
        g_p2_ternary_dtor++;
        if (s._ptr != nullptr) g_p2_ternary_buffer_dtor++;
    }
};
int g_p2_ternary_eager = true ? default : 4;
// Both arms 'default' is pointless but logically correct: the destination type is known, so the
// join takes its type from there rather than reporting an untyped 'default'.
int g_p2_ternary_both_default = true ? default : default;

P2Def p2TernaryReturn(bool h)
{
    P2Def other = default;
    other.a = 9;
    return h ? default : other;
}

P2Def p2TernaryArgument(P2Def value) { return value; }
T p2TernaryGeneric<T>(T value) { return value; }

// Both arms owning, so the join keeps ownership: whichever arm runs must be destructed exactly
// once. A 'default' arm mis-scored as borrowing would suppress the join and skip the destructor.
P2TernaryOwn p2TernaryMakeOwn()
{
    P2TernaryOwn made = default;
    made.s = "made".copy();
    made.n = 8;
    return made;
}

bool p2TernaryPick(int k) { return k > 0; }

// -- p3: `return default;` is the same VALUE as `T x = default;`. It used to lower to a flat
// zero of the return type, so every field initializer below was skipped on the return leg only.
struct RdNest { int x = 7; int y = 8; };
struct RdOuter { RdNest inner = default; int w = 9; };
struct RdCtor { int a = 0; int b = 0; RdCtor() { a = 11; b = 12; } };
struct RdBox<T> { T v = default; int tag = 6; };
class RdCls { int a = 2; int b = 6; };
namespace RdNs { struct RdQ { int a = 2; int b = 5; }; }
int g_rd_own_dtor = 0;
int g_rd_own_buffer = 0;
struct RdOwn
{
    string s = "seedseed".copy();
    int n = 3;
    ~RdOwn() { g_rd_own_dtor++; if (s._ptr != nullptr) g_rd_own_buffer++; }
};
int g_rd_node_dtor = 0;
class RdNode { int v = 4; ~RdNode() { g_rd_node_dtor++; } };
struct RdHold { unique RdNode* n = new RdNode(); int k = 9; };

P2Def   rdReturnDefault()        { return default; }
RdOuter rdReturnNested()         { return default; }
RdCtor  rdReturnCtor()           { return default; }
RdBox<int> rdReturnBox()         { return default; }
RdCls   rdReturnClass()          { return default; }
RdNs.RdQ rdReturnNamespaced()    { return default; }
P2DefOwn rdReturnStringField()   { return default; }
RdOwn   rdReturnOwning()         { return default; }
RdHold  rdReturnUnique()         { return default; }
T       rdReturnGeneric<T>()     { return default; }
int     rdReturnPrimitive()      { return default; }
P2Def*  rdReturnPointer()        { return default; }
struct RdFactory
{
    P2Def make() { return default; }
};
struct RdGenFactory<T>
{
    T make() { return default; }
};

int testDefaultAsExpression()
{
    int passed = 0;

    // Pre-fix: "found '=' but expected ';'" - `default` was initializer-only.
    P2Def p = default;
    p.a = 100; p.b = 200;
    p = default;
    passed += Test("default_assign_field_a", p.a, 5);
    passed += Test("default_assign_field_b", p.b, 7);

    // Re-defaulting an accumulator between iterations - the reporter's real shape.
    int rounds = 0;
    for (int i = 0; i < 3; i++)
    {
        p.a = p.a + 1;
        rounds = rounds + p.a;
        p = default;
    }
    passed += Test("default_assign_in_loop", rounds, 18);   // 6 three times
    passed += Test("default_assign_after_loop", p.a, 5);

    // An OWNING field: `= default` must run the destructor for the old buffer and leave an
    // empty string, not a dangling one. test.sh's leak pass covers the free itself.
    P2DefOwn o = default;
    o.s = "hello-world-buffer".copy();
    o.n = 9;
    passed += Test("default_own_before", o.s.length(), 18);
    o = default;
    passed += Test("default_own_cleared", o.s.length(), 0);
    passed += Test("default_own_scalar_reset", o.n, 3);

    P2Def other = default;
    other.a = 11;
    bool h = true;
    P2Def trueArm = h ? default : other;
    passed += Test("default_ternary_true_arm", trueArm.a, 5);
    h = false;
    P2Def falseArm = h ? other : default;
    passed += Test("default_ternary_false_arm", falseArm.a, 5);

    bool k = true;
    P2Def nestedTrue = h ? other : (k ? default : other);
    passed += Test("default_ternary_nested_true", nestedTrue.a, 5);
    k = false;
    P2Def nestedFalse = h ? other : (k ? other : default);
    passed += Test("default_ternary_nested_false", nestedFalse.a, 5);

    h = true;
    trueArm.a = 9;
    trueArm = h ? default : other;
    passed += Test("default_ternary_assignment", trueArm.a, 5);
    passed += Test("default_ternary_return", p2TernaryReturn(true).a, 5);
    passed += Test("default_ternary_argument", p2TernaryArgument(h ? default : other).a, 5);
    passed += Test("default_ternary_generic_argument",
        p2TernaryGeneric<P2Def>(h ? default : other).a, 5);

    int primitive = h ? default : 4;
    passed += Test("default_ternary_primitive_true", primitive, 0);
    h = false;
    primitive = h ? 4 : default;
    passed += Test("default_ternary_primitive_false", primitive, 0);
    passed += Test("default_ternary_global_eager", g_p2_ternary_eager, 0);

    // Both arms 'default': the destination type is known on every one of these, so each arm takes
    // its value from the declared type - field initializers for a struct, zero for a primitive.
    h = true;
    P2Def bothDefaultTrue = h ? default : default;
    passed += Test("default_ternary_both_default_a", bothDefaultTrue.a, 5);
    passed += Test("default_ternary_both_default_b", bothDefaultTrue.b, 7);
    h = false;
    P2Def bothDefaultFalse = h ? default : default;
    passed += Test("default_ternary_both_default_false", bothDefaultFalse.a, 5);
    int bothDefaultPrimitive = h ? default : default;
    passed += Test("default_ternary_both_default_primitive", bothDefaultPrimitive, 0);
    string bothDefaultString = h ? default : default;
    passed += Test("default_ternary_both_default_string", bothDefaultString.length(), 0);
    P2Def* bothDefaultPointer = h ? default : default;
    passed += Test("default_ternary_both_default_pointer", bothDefaultPointer == nullptr, true);
    passed += Test("default_ternary_both_default_global", g_p2_ternary_both_default, 0);

    string stringOther = "ternary";
    h = true;
    string stringResult = h ? default : stringOther;
    passed += Test("default_ternary_string_default", stringResult.length(), 0);

    P2Def* pointerOther = nullptr;
    P2Def* pointerResult = pointerOther ?? default;
    passed += Test("default_coalesce_pointer_default", pointerResult == nullptr, true);

    list<int> listOther;
    listOther.add(7);
    list<int> listResult = h ? default : listOther;
    passed += Test("default_ternary_generic_default", listResult.count(), 0);

    P2Def parenthesized = default;
    parenthesized.a = 9;
    passed += Test("default_ternary_parenthesized", (h ? default : parenthesized).a, 5);

    dictionary<string, P2Def> map;
    map.add("key", other);
    h = true;
    P2Def customerTrue = h ? map.get("key") : default;
    passed += Test("default_ternary_customer_true", customerTrue.a, 11);
    h = false;
    P2Def customer = h ? map.get("key") : default;
    passed += Test("default_ternary_customer_default", customer.a, 5);

    g_p2_ternary_dtor = 0;
    g_p2_ternary_buffer_dtor = 0;
    {
        P2TernaryOwn owningOther = default;
        owningOther.s = "owned".copy();
        bool owningChoose = true;
        P2TernaryOwn owningResult = owningChoose ? default : owningOther;
        passed += Test("default_ternary_owning_source_live", owningOther.s.length(), 5);
        passed += Test("default_ternary_owning_no_early_dtor", g_p2_ternary_dtor, 0);
        passed += Test("default_ternary_owning_string_value", owningResult.s.length(), 0);
        passed += Test("default_ternary_owning_struct_value", owningResult.n, 3);
    }
    passed += Test("default_ternary_owning_destructors", g_p2_ternary_dtor, 1);
    passed += Test("default_ternary_owning_buffers", g_p2_ternary_buffer_dtor, 1);

    // Both arms own, so the joined value is owned: exactly one destructor and exactly one heap
    // buffer freed on the call arm, one destructor and no buffer on the 'default' arm.
    g_p2_ternary_dtor = 0;
    g_p2_ternary_buffer_dtor = 0;
    {
        P2TernaryOwn ownedCall = p2TernaryPick(1) ? p2TernaryMakeOwn() : default;
        passed += Test("default_ternary_owned_join_call_value", ownedCall.n, 8);
        passed += Test("default_ternary_owned_join_call_string", ownedCall.s.length(), 4);
        passed += Test("default_ternary_owned_join_call_no_early_dtor", g_p2_ternary_dtor, 0);
    }
    passed += Test("default_ternary_owned_join_call_dtor", g_p2_ternary_dtor, 1);
    passed += Test("default_ternary_owned_join_call_buffer", g_p2_ternary_buffer_dtor, 1);

    g_p2_ternary_dtor = 0;
    g_p2_ternary_buffer_dtor = 0;
    {
        P2TernaryOwn ownedDefault = p2TernaryPick(0) ? p2TernaryMakeOwn() : default;
        passed += Test("default_ternary_owned_join_default_value", ownedDefault.n, 3);
        passed += Test("default_ternary_owned_join_default_string", ownedDefault.s.length(), 0);
        passed += Test("default_ternary_owned_join_default_no_early_dtor", g_p2_ternary_dtor, 0);
    }
    passed += Test("default_ternary_owned_join_default_dtor", g_p2_ternary_dtor, 1);
    passed += Test("default_ternary_owned_join_default_buffer", g_p2_ternary_buffer_dtor, 0);

    // Nested owning join: the inner 'default' arm still joins as owned through the outer join.
    g_p2_ternary_dtor = 0;
    g_p2_ternary_buffer_dtor = 0;
    {
        P2TernaryOwn ownedNested = p2TernaryPick(0)
            ? p2TernaryMakeOwn()
            : (p2TernaryPick(0) ? p2TernaryMakeOwn() : default);
        passed += Test("default_ternary_owned_join_nested_value", ownedNested.n, 3);
    }
    passed += Test("default_ternary_owned_join_nested_dtor", g_p2_ternary_dtor, 1);
    passed += Test("default_ternary_owned_join_nested_buffer", g_p2_ternary_buffer_dtor, 0);

    // -- p3: `return default;` runs the field initializers. Every leg below read 0 pre-fix
    // (a flat zero of the return type) while its `= default` twin already read the initializer.
    P2Def returned = rdReturnDefault();
    passed += Test("default_return_field_a", returned.a, 5);
    passed += Test("default_return_field_b", returned.b, 7);

    RdOuter returnedNested = rdReturnNested();
    passed += Test("default_return_nested_inner_x", returnedNested.inner.x, 7);
    passed += Test("default_return_nested_inner_y", returnedNested.inner.y, 8);
    passed += Test("default_return_nested_outer_w", returnedNested.w, 9);

    // A user-written default ctor, not just field initializers: pre-fix its body never ran.
    RdCtor returnedCtor = rdReturnCtor();
    passed += Test("default_return_ctor_a", returnedCtor.a, 11);
    passed += Test("default_return_ctor_b", returnedCtor.b, 12);

    RdBox<int> returnedBox = rdReturnBox();
    passed += Test("default_return_generic_tag", returnedBox.tag, 6);
    passed += Test("default_return_generic_v", returnedBox.v, 0);

    RdCls returnedClass = rdReturnClass();
    passed += Test("default_return_class_a", returnedClass.a, 2);
    passed += Test("default_return_class_b", returnedClass.b, 6);

    RdNs.RdQ returnedNs = rdReturnNamespaced();
    passed += Test("default_return_namespaced_a", returnedNs.a, 2);
    passed += Test("default_return_namespaced_b", returnedNs.b, 5);

    P2Def returnedGeneric = rdReturnGeneric<P2Def>();
    passed += Test("default_return_generic_function_a", returnedGeneric.a, 5);
    passed += Test("default_return_generic_function_b", returnedGeneric.b, 7);

    RdFactory factory = default;
    P2Def methodReturned = factory.make();
    passed += Test("default_return_method_a", methodReturned.a, 5);
    RdGenFactory<P2Def> genFactory = default;
    P2Def genMethodReturned = genFactory.make();
    passed += Test("default_return_generic_method_a", genMethodReturned.a, 5);

    function<P2Def()> lambdaReturn = () => { return default; };
    P2Def lambdaReturned = lambdaReturn();
    passed += Test("default_return_lambda_a", lambdaReturned.a, 5);
    passed += Test("default_return_lambda_b", lambdaReturned.b, 7);

    // An owning string FIELD whose default allocates: the returned value must own the buffer,
    // and it must be destructed exactly once (no early free, no leak, no double free).
    P2DefOwn returnedStringField = rdReturnStringField();
    passed += Test("default_return_string_field_len", returnedStringField.s.length(), 0);
    passed += Test("default_return_string_field_scalar", returnedStringField.n, 3);

    g_rd_own_dtor = 0;
    g_rd_own_buffer = 0;
    {
        RdOwn returnedOwning = rdReturnOwning();
        passed += Test("default_return_owning_string", returnedOwning.s.length(), 8);
        passed += Test("default_return_owning_scalar", returnedOwning.n, 3);
        passed += Test("default_return_owning_no_early_dtor", g_rd_own_dtor, 0);
    }
    passed += Test("default_return_owning_dtor", g_rd_own_dtor, 1);
    passed += Test("default_return_owning_buffer", g_rd_own_buffer, 1);

    // A unique-pointer field default: the returned struct owns the node and frees it once.
    g_rd_node_dtor = 0;
    {
        RdHold returnedUnique = rdReturnUnique();
        passed += Test("default_return_unique_scalar", returnedUnique.k, 9);
        passed += Test("default_return_unique_value", returnedUnique.n->v, 4);
        passed += Test("default_return_unique_no_early_dtor", g_rd_node_dtor, 0);
    }
    passed += Test("default_return_unique_dtor", g_rd_node_dtor, 1);

    // Accept set: a primitive and a pointer return still default to zero / null.
    passed += Test("default_return_primitive", rdReturnPrimitive(), 0);
    passed += Test("default_return_pointer", rdReturnPointer() == nullptr, true);

    return passed;
}

int testStringAPI()
{
    int passed = 0;

    // -- Phase 1: Non-allocating queries --

    string hello = "hello";
    string empty = "";

    passed += Test("isEmpty false",     hello.isEmpty(), false);
    passed += Test("isEmpty true",      empty.isEmpty(), true);

    passed += Test("charAt 0",          hello.charAt(0), (i8)'h');
    passed += Test("charAt 4",          hello.charAt(4), (i8)'o');
    passed += Test("charAt clamp neg",  hello.charAt(-1), (i8)'h');
    passed += Test("charAt clamp over", hello.charAt(99), (i8)'o');
    passed += Test("charAt empty",      empty.charAt(0),  (i8)0);

    string hay = "abcabc";
    passed += Test("indexOf found",     hay.indexOf("bc"), 1);
    passed += Test("indexOf from",      hay.indexOf("bc", 2), 4);
    passed += Test("indexOf absent",    hay.indexOf("xyz"), -1);
    passed += Test("indexOf empty hay", empty.indexOf("x"), -1);
    passed += Test("indexOf char",      hay.indexOf((i8)'c'), 2);

    passed += Test("lastIndexOf found",  hay.lastIndexOf("bc"), 4);
    passed += Test("lastIndexOf absent", hay.lastIndexOf("zz"), -1);
    passed += Test("lastIndexOf char",   hay.lastIndexOf((i8)'a'), 3);

    passed += Test("contains yes",  hay.contains("abc"), true);
    passed += Test("contains no",   hay.contains("xyz"), false);
    passed += Test("contains empty haystack", empty.contains("x"), false);

    string prefix = "hello world";
    passed += Test("startsWith yes",    prefix.startsWith("hello"), true);
    passed += Test("startsWith no",     prefix.startsWith("world"), false);
    passed += Test("startsWith empty",  prefix.startsWith(""), true);
    passed += Test("endsWith yes",      prefix.endsWith("world"), true);
    passed += Test("endsWith no",       prefix.endsWith("hello"), false);
    passed += Test("endsWith empty",    prefix.endsWith(""), true);

    passed += Test("compare equal",  compare("abc", "abc"), 0);
    passed += Test("compare less",   compare("abc", "abd") < 0, true);
    passed += Test("compare greater",compare("abd", "abc") > 0, true);
    passed += Test("compare len",    compare("ab", "abc") < 0, true);

    string sa = "alpha";
    string sb = "beta";
    passed += Test("operator< yes",  sa < sb, true);
    passed += Test("operator< no",   sb < sa, false);
    passed += Test("operator> yes",  sb > sa, true);
    passed += Test("operator> no",   sa > sb, false);

    // sort a list<string> using < to verify ordering
    list<string> words;
    words.add("cherry"); words.add("apple"); words.add("banana");
    // bubble sort
    int n = words.count();
    int ii = 0;
    while (ii < n - 1)
    {
        int jj = 0;
        while (jj < n - 1 - ii)
        {
            if (words.get(jj) > words.get(jj + 1))
            {
                string tmp = words.get(jj).copy();
                words.set(jj, words.get(jj + 1).copy());
                words.set(jj + 1, tmp);
            }
            jj++;
        }
        ii++;
    }
    passed += Test("sort[0]", words.get(0), "apple");
    passed += Test("sort[1]", words.get(1), "banana");
    passed += Test("sort[2]", words.get(2), "cherry");

    // -- Phase 2: Allocating transforms --

    string src = "Hello World";
    string sub1 = src.substring(6);
    passed += Test("substring from",    sub1, "World");
    string sub2 = src.substring(0, 5);
    passed += Test("substring 0,5",     sub2, "Hello");
    string sub3 = src.substring(0, 0);
    passed += Test("substring len0",    sub3, "");
    string sub4 = src.substring(100);
    passed += Test("substring clamp",   sub4, "");
    string sub5 = empty.substring(0);
    passed += Test("substring empty",   sub5, "");

    string repSrc1 = "aabbcc";
    string rep1 = repSrc1.replace("bb", "XX");
    passed += Test("replace mid",       rep1, "aaXXcc");
    string repSrc2 = "aaaa";
    string rep2 = repSrc2.replace("aa", "b");
    passed += Test("replace overlap",   rep2, "bb");
    string repSrc3 = "hello";
    string rep3 = repSrc3.replace("xyz", "abc");
    passed += Test("replace absent",    rep3, "hello");
    string rep4 = repSrc3.replace("", "x");
    passed += Test("replace empty old", rep4, "hello");

    string upSrc = "Hello World";
    string up1 = upSrc.toUpper();
    passed += Test("toUpper",  up1, "HELLO WORLD");
    string lo1 = upSrc.toLower();
    passed += Test("toLower",  lo1, "hello world");
    string up2 = empty.toUpper();
    passed += Test("toUpper empty", up2, "");

    string trimSrc1 = "  hello  ";
    string trim1 = trimSrc1.trim();
    passed += Test("trim",      trim1, "hello");
    string trimSrc2 = "  hello";
    string trim2 = trimSrc2.trimStart();
    passed += Test("trimStart", trim2, "hello");
    string trimSrc3 = "hello  ";
    string trim3 = trimSrc3.trimEnd();
    passed += Test("trimEnd",   trim3, "hello");
    string trim4 = empty.trim();
    passed += Test("trim empty", trim4, "");
    string trimSrc4 = "   ";
    string trim5 = trimSrc4.trim();
    passed += Test("trim all space", trim5, "");

    string padSrc1 = "hi";
    string pl1 = padSrc1.padLeft(5);
    passed += Test("padLeft",       pl1, "   hi");
    string padSrc2 = "hello";
    string pl2 = padSrc2.padLeft(3);
    passed += Test("padLeft no-op", pl2, "hello");
    string pr1 = padSrc1.padRight(5);
    passed += Test("padRight",      pr1, "hi   ");
    string pr2 = padSrc2.padRight(3);
    passed += Test("padRight no-op",pr2, "hello");

    // reversed concat: "lit" + string
    string revPart = src.substring(6);
    string rev1 = "Hello, " + revPart;
    passed += Test("reverse concat",    rev1, "Hello, World");

    // -- Phase 3: split / join --

    string splitSrc1 = "a,b,c";
    list<string> parts = splitSrc1.split(",");
    passed += Test("split count",   parts.count(), 3);
    passed += Test("split[0]",      parts.get(0),  "a");
    passed += Test("split[1]",      parts.get(1),  "b");
    passed += Test("split[2]",      parts.get(2),  "c");

    string splitSrc2 = "a,b,";
    list<string> trail = splitSrc2.split(",");
    passed += Test("split trailing count", trail.count(), 3);
    passed += Test("split trailing last",  trail.get(2),  "");

    string splitSrc3 = "hello";
    list<string> noSep = splitSrc3.split(",");
    passed += Test("split no match count", noSep.count(), 1);
    passed += Test("split no match[0]",    noSep.get(0),  "hello");

    list<string> emptyParts = empty.split(",");
    passed += Test("split empty input count", emptyParts.count(), 1);
    passed += Test("split empty input[0]",    emptyParts.get(0),  "");

    // split by char
    string splitSrc4 = "x:y:z";
    list<string> byChar = splitSrc4.split((i8)':');
    passed += Test("split char count", byChar.count(), 3);
    passed += Test("split char[0]",    byChar.get(0),  "x");
    passed += Test("split char[2]",    byChar.get(2),  "z");

    // join round-trip
    string joined = join(",", parts);
    passed += Test("join round-trip", joined, "a,b,c");

    list<string> one;
    one.add("only");
    string j1 = join(",", one);
    passed += Test("join single",  j1, "only");

    list<string> none;
    string j2 = join(",", none);
    passed += Test("join empty",   j2, "");

    // -- Phase 4: toString conversions (primitive -> string) --

    i64 n64 = 9876543210;
    string si64 = n64.toString();
    passed += Test("toString i64", si64, "9876543210");

    u64 nu64 = 18446744073709551615;
    string su64 = nu64.toString();
    passed += Test("toString u64", su64, "18446744073709551615");

    double dblVal = 3.14;
    string sdbl = dblVal.toString();
    passed += Test("toString double", sdbl, "3.14");

    bool trueVal = true;
    bool falseVal = false;
    string sbt = trueVal.toString();
    passed += Test("toString bool true",  sbt, "true");
    string sbf = falseVal.toString();
    passed += Test("toString bool false", sbf, "false");

    // toString(base): radix conversion (hex / binary)
    i64 hexVal = 255;
    string shex = hexVal.toString(16);
    passed += Test("toString base16", shex, "ff");

    // interpolation with i64 / double / bool
    i64 bigN = 123456789012345;
    passed += Test("interp i64", "{bigN}", "123456789012345");

    double pi = 3.14159;
    passed += Test("interp double", "{pi}", "3.14159");

    bool flag = true;
    passed += Test("interp bool", "{flag}", "true");

    // stringbuilder: append(i64), append(double)
    stringbuilder sbb;
    sbb.append((i64)1234567890123);
    passed += Test("sb append i64", sbb.toString(), "1234567890123");

    sbb.clear();
    sbb.append(2.718);
    passed += Test("sb append double", sbb.toString(), "2.718");

    // stringbuilder: append(string_view)
    string svsrc = "hello world";
    string_view* sv = svsrc.view();
    sbb.clear();
    sbb.append(*sv);
    passed += Test("sb append string_view", sbb.toString(), "hello world");
    delete sv;

    // ownership: result of allocating fn bound to inner scope, confirmed freed
    // (UFCS on a string literal works for single-arg calls but use a variable to be safe)
    {
        string padSrc = "  padded  ";
        string inner = padSrc.trim();
        passed += Test("ownership inner scope", inner, "padded");
    }

    // chained concat: the unnamed intermediates (e.g. (a+b) of a+b+c) must be freed
    // at end-of-expression while the final result stays correct. Regression for the
    // chained-concat intermediate leak (see internal/string-concat-temp-flush.md;
    // run under --asan / HeapAudit to confirm the intermediates are freed, not just
    // that the result is right).
    {
        string ca = "foo";
        string cb = "bar";
        string cc = "baz";
        string cd = "qux";
        string chain3 = ca + cb + cc;
        passed += Test("concat chain3", chain3, "foobarbaz");
        string chain4 = ca + cb + cc + cd;
        passed += Test("concat chain4", chain4, "foobarbazqux");
        // a chain consumed directly by a move string parameter (ownership transfers
        // to the callee; the caller must drop the temporary from its cleanup list).
        passed += Test("concat chain move-param", consumeMoveLen(ca + cb + cc), 9);
    }

    // Item 1: operator== must honor the tracked byte length (memcmp), not stop at an
    // embedded NUL the way strcmp does. Build the strings by hand via _ptr/_len so the
    // bytes after the NUL differ. The heap buffers are owned i8* locals - freed at block
    // exit; the strings are non-owning wrappers over them (no double free).
    {
        i8* nb1 = new i8[4]; nb1[0] = (i8)'a'; nb1[1] = (i8)0; nb1[2] = (i8)'b'; nb1[3] = (i8)0;
        i8* nb2 = new i8[4]; nb2[0] = (i8)'a'; nb2[1] = (i8)0; nb2[2] = (i8)'c'; nb2[3] = (i8)0;
        i8* nb3 = new i8[4]; nb3[0] = (i8)'a'; nb3[1] = (i8)0; nb3[2] = (i8)'b'; nb3[3] = (i8)0;
        string en1 = default; en1._ptr = nb1; en1._len = 3;
        string en2 = default; en2._ptr = nb2; en2._len = 3;
        string en3 = default; en3._ptr = nb3; en3._len = 3;
        passed += Test("embedded-NUL == differ",       en1 == en2, false);
        passed += Test("embedded-NUL compare nonzero",  en1.compare(en2) != 0, true);
        passed += Test("embedded-NUL == equal",         en1 == en3, true);
        // en1/en2/en3 are non-owning wrappers over the raw buffers - free the buffers explicitly.
        delete[] nb1; delete[] nb2; delete[] nb3;
    }

    // Item 5: a borrowed (non-owning) string wrapped from a char* and moved into a list
    // is heap-copied at the move call site, so the list owns its own copy. Freeing the
    // list on scope exit must not touch the borrowed literal buffer (ASan-clean). Also
    // exercises Item 2: (string)charPtr value-compares a string by content.
    {
        char* rawLit = "borrowed-buf";
        {
            list<string> bl = default;
            string bw = (string)rawLit;
            bl.add(move bw);
            passed += Test("borrowed into list survives", bl.get(0), "borrowed-buf");
            passed += Test("(string)charPtr == string",   (string)rawLit == bl.get(0), true);
            // bl destructor frees its owned element copy here.
        }
        // The borrowed literal buffer must still be valid after the list is destroyed.
        passed += Test("borrowed buffer still alive", (string)rawLit, "borrowed-buf");
    }

    // Item 3: char* + char* concatenates (operator+(const char*, const char*)) instead of
    // erroring with the old toString() advice. char* + literal and chained concat too; the
    // owned intermediates are freed at end-of-expression (ASan-clean).
    {
        char* cp = "foo";
        char* cq = "bar";
        string cc1 = cp + cq;
        passed += Test("charptr + charptr", cc1, "foobar");
        string cc2 = cp + "X";
        passed += Test("charptr + literal", cc2, "fooX");
        string cc3 = cp + cq + cp;
        passed += Test("charptr concat chain", cc3, "foobarfoo");
    }

    // Regression (plan-01): assigning an owned string to the SAME pre-declared local
    // in both branches of an if/else inside a loop. The stale lastCallReturnsOwned
    // flag from the if-branch assignment used to leak into the else-branch's
    // `string b = ...;` declaration, falsely marking that literal-backed local as
    // owning - its scope-exit destructor then freed a string literal -> heap
    // corruption (0xC0000374) on the second iteration. ASan-clean now.
    {
        u32 i = 0u;
        i32 hits = 0;
        string last = default;
        while (i < 4u)
        {
            string name = default;
            if (i == 0u) { string a = "known"; name = a.copy(); }
            else         { string b = "other"; name = b.copy(); }
            if (!name.isEmpty()) hits = hits + 1;
            last = name.copy();
            i = i + 1u;
        }
        passed += Test("if/else owned-string loop iterations", hits, 4);
        passed += Test("if/else owned-string last value", last, "other");
    }
    // Bare-if override form (assign unconditionally, then override in a bare if) -
    // the customer reported this variant ran clean; keep it as a guard.
    {
        u32 i = 0u;
        string name = default;
        while (i < 2u)
        {
            name = "default";
            if (i == 1u) { string c = "override"; name = c.copy(); }
            i = i + 1u;
        }
        passed += Test("bare-if override owned-string", name, "override");
    }
    // Helper-return form (each branch returns an owned string from a helper).
    {
        string n0 = pickName(0u);
        string n1 = pickName(1u);
        passed += Test("helper-return owned-string 0", n0, "known");
        passed += Test("helper-return owned-string 1", n1, "other");
    }
    // No-discard owning-return consumption: a `move string` return (pickName) must still
    // compile when its result is CONSUMED - bound to a local, or passed straight into a
    // move-sink parameter. Only DISCARDING such a call in statement position is the hard
    // error (regression: Test/errors/err_discard_owning_return.cb).
    {
        string bound = pickName(0u);                              // bound - freed at scope exit
        passed += Test("no-discard: bound owning return", bound, "known");
        passed += Test("no-discard: owning return into move-sink", consumeMoveLen(pickName(1u)), 5);
    }
    // Owned-string TERNARY regression: a conditional whose branch reads an owning
    // string field/local used to shallow-alias that buffer, then free it at scope
    // exit (use-after-free / heap corruption). The ternary now deep-copies its
    // string result into an independent owned buffer. ASan-clean.
    {
        TernBox* tb = new TernBox();
        tb->set("hel" + (2).toString());          // owned heap buffer, not a literal
        string a = tb->pick(true);                // field branch selected
        string b = tb->pick(false);               // literal branch selected
        passed += Test("ternary field-branch owned", a, "hel2");
        passed += Test("ternary literal-branch owned", b, "-");
        passed += Test("ternary source field intact", tb->name, "hel2");
        delete tb;                                 // frees name exactly once

        // Substring branch: an owned temp on one side, a literal on the other.
        string src = "hello world";
        bool cond = true;
        string sub = cond ? src.substring(0, 5) : "-";
        passed += Test("ternary substring-branch", sub, "hello");
        passed += Test("ternary substring source intact", src, "hello world");
    }
    // Regression (plan-03): a method call on a parenthesized (cast) expression. The
    // receiver is a by-value struct with no addressable storage; it used to fail with
    // "unknown function '((string)buf)'". Materializing it to a temp now lets the method
    // dispatch find the struct receiver.
    {
        char[8] cbuf = default;
        cbuf[0] = (char)'h'; cbuf[1] = (char)'i'; cbuf[2] = (char)0;
        string ms = ((string)cbuf).copy();
        passed += Test("method on cast expr (copy)", ms, "hi");
        passed += Test("method on cast expr (length)", ((string)cbuf).length(), 2);
        string pv = "wrapped";
        passed += Test("method on parenthesized value", (pv).copy(), "wrapped");
    }

    // Return-by-value of a struct whose dtor frees owned string fields.
    {
        g_owned_ret_dtor = 0;
        {
            OwnedRet r = makeOwnedRet();
            passed += Test("ret-struct owned field a", r.a, "first-field");
            passed += Test("ret-struct owned field b", r.b, "second-field");
        } // r destructs here - exactly one destruction, no double-free
        passed += Test("ret-struct single destruction", g_owned_ret_dtor, 1);
    }

    return passed;
}

// ── discard target `_` ───────────────────────────────────────────────────────
// A bare discarded call and `_ = expr` both evaluate the RHS for its side effects
// and destruct an owning-struct rvalue exactly once at end of the full expression
// (regression: the discarded temp used to leak - no field-access site hooked it).
int g_discard_side = 0;
int discardSide(int x) { g_discard_side++; return x; }

int testDiscard()
{
    int passed = 0;

    // A bare `makeOwnedRet();` is now a compile error (mandatory nodiscard - see
    // Test/errors/err_discard_owning_return.cb). `_ = expr` is the explicit discard and still
    // destructs the owning-struct temp exactly once (no double-free).
    g_owned_ret_dtor = 0;
    { _ = makeOwnedRet(); }
    passed += Test("'_ =' discard destructs once", g_owned_ret_dtor, 1);

    // `_ = expr` still evaluates the RHS for its side effects.
    g_discard_side = 0;
    _ = discardSide(7);
    passed += Test("'_ =' runs RHS side effect", g_discard_side, 1);

    // Consuming an owning POINTER return must compile and free exactly once (no double-free from
    // the value-identity owned-return tracking, no missed free). Bind+delete, then a move-sink arg.
    g_ptr_dtor = 0;
    { PtrOwned* p = makePtrOwned(); delete p; }
    passed += Test("owning ptr bound+deleted frees once", g_ptr_dtor, 1);
    g_ptr_dtor = 0;
    sinkPtr(makePtrOwned());
    passed += Test("owning ptr into move-sink frees once", g_ptr_dtor, 1);

    // An owning return passed as a closure / function<> ARGUMENT is consumed by the call and must
    // NOT be flagged as discarded (regression for the closure-arg false positive).
    passed += Test("owning str into closure arg", viaClosureLen((string s) => s.length(), makeOwnedStr()), 5);

    // A CONSUMED owning call in for-INIT position (assigned to a local) compiles and frees once;
    // a bare owning call in for-init errors instead (Test/errors/err_discard_owning_return.cb).
    g_ptr_dtor = 0;
    PtrOwned* fp = default;
    int fi = 0;
    for (fp = makePtrOwned(); fi < 0; fi = fi + 1) { }
    delete fp;
    passed += Test("owning ptr consumed in for-init frees once", g_ptr_dtor, 1);

    return passed;
}

// Owned-string producers for the direct-return ownership regression below.
string retInner(const char* suffix) { string k = "key"; return k + suffix; }
string retDirect(const char* suffix) { return retInner(suffix); }        // direct call-result return
string retChainB(const char* suffix) { return retInner(suffix); }
string retChainA(const char* suffix) { return retChainB(suffix); }       // chained direct returns
string retEcho(string s) { return s; }                                   // borrowed-param passthrough
string retTernary(int n) { return n > 0 ? retInner("pos") : retInner("neg"); }

int testDirectReturnOwnership()
{
    int passed = 0;

    // Directly returning an owned call-result must transfer ownership to the caller.
    // Regression: the returned buffer used to leak - its runtime OWNED bit was cleared
    // as if it were a borrow, so the caller never freed it.
    string a = retDirect("1");
    passed += Test("direct call-result return", a.data(), "key1");

    // Chained direct returns (A returns B returns inner) still transfer ownership once.
    string c = retChainA("3");
    passed += Test("chained direct return", c.data(), "key3");

    // Returning a borrowed string param (a literal here) passes the value through unchanged.
    string e = retEcho("literal");
    passed += Test("borrowed-param return", e.data(), "literal");

    // Passing an OWNED string to a borrow param and retaining the passthrough return must
    // NOT double-free: the return is a BORROW (the caller's original still owns the buffer).
    // Regression: the owned bit rode through the borrow param, so both the original and the
    // retained return destructed the same buffer at scope exit.
    string owned = retInner("1");
    string borrowed = retEcho(owned);
    passed += Test("owned-input passthrough return", borrowed.data(), "key1");
    passed += Test("owned-input original still valid", owned.data(), "key1");

    // Ternary of owned call-results returns an owned value (no leak).
    string t = retTernary(4);
    passed += Test("ternary owned return", t.data(), "keypos");

    return passed;
}

// ── main ─────────────────────────────────────────────────────────────────────

// The C `long` bindings in core/cruntime.cb (atol/strtol/strtoul, the abs family) and the
// `long`/`ulong` keywords must carry the TARGET's native C long width: 32-bit on Windows
// (LLP64), 64-bit on LP64. A 32-bit binding on LP64 truncated atol's result to garbage.
int testCLongWidth()
{
    int passed = 0;

    passed += Test("sizeof(int) == 4",       (i64)sizeof(int),       (i64)4);
    passed += Test("sizeof(long long) == 8", (i64)sizeof(long long), (i64)8);

    if const (__WINDOWS__)
    {
        // LLP64: long is 32-bit, matching MSVC. The parse functions saturate past 2^31-1.
        passed += Test("sizeof(long) == 4",  (i64)sizeof(long),  (i64)4);
        passed += Test("sizeof(ulong) == 4", (i64)sizeof(ulong), (i64)4);
        passed += Test("atol max i32",   (i64)atol("2147483647"),                  (i64)2147483647);
        passed += Test("strtol max i32", (i64)strtol("2147483647", nullptr, 10),   (i64)2147483647);
        passed += Test("strtoul max u32",(i64)strtoul("4294967295", nullptr, 10),  (i64)4294967295);
    }
    else
    {
        // LP64: long is 64-bit. These three all truncated to 32 bits before the fix.
        passed += Test("sizeof(long) == 8",  (i64)sizeof(long),  (i64)8);
        passed += Test("sizeof(ulong) == 8", (i64)sizeof(ulong), (i64)8);
        passed += Test("atol 2^32",    (i64)atol("4294967296"),                  (i64)4294967296);
        passed += Test("strtol 2^32",  (i64)strtol("4294967296", nullptr, 10),   (i64)4294967296);
        passed += Test("strtoul 2^33", (i64)strtoul("8589934592", nullptr, 10),  (i64)8589934592);
    }

    // Small values and the endptr tail behave identically on both ABIs.
    passed += Test("atol small",     (i64)atol("123"),                       (i64)123);
    passed += Test("strtol negative",(i64)strtol("-456", nullptr, 10),       (i64)-456);
    passed += Test("strtol hex",     (i64)strtol("ff", nullptr, 16),         (i64)255);
    char* end = nullptr;
    i64 parsed = (i64)strtol("42abc", &end, 10);
    passed += Test("strtol endptr value", parsed,     (i64)42);
    passed += Test("strtol endptr tail",  (i64)*end,  (i64)'a');

    // C's abs family is one function per width; each binding must match its true C width.
    passed += Test("abs(-7)",   (i64)abs(-7),              (i64)7);
    passed += Test("labs(-7)",  (i64)labs(-7),             (i64)7);
    passed += Test("llabs 2^33",(i64)llabs(-8589934592),   (i64)8589934592);

    return passed;
}

int g_raw_count_dtors = 0;
int g_raw_count_order = 0;
int g_raw_count_sum = 0;
int g_raw_count_resource_dtors = 0;

class RawCountElem
{
    int id = 0;
    ~RawCountElem()
    {
        g_raw_count_dtors++;
        g_raw_count_order = g_raw_count_order * 10 + id;
        g_raw_count_sum += id;
    }
};

class RawCountResource
{
    int id = 0;
    ~RawCountResource() { g_raw_count_resource_dtors++; }
};

class RawCountOwnerElem
{
    unique RawCountResource* resource = new RawCountResource();
    ~RawCountOwnerElem() { g_raw_count_dtors++; }
};

void resetRawCountState()
{
    g_raw_count_dtors = 0;
    g_raw_count_order = 0;
    g_raw_count_sum = 0;
}

void runRawCountIfElse(int choose)
{
    unique RawCountElem* values = nullptr;
    int a = 2;
    int b = 4;
    if (choose != 0)
    {
        values = new RawCountElem[a];
        values[0].id = 10; values[1].id = 20;
    }
    else
    {
        values = new RawCountElem[b];
        values[0].id = 1; values[1].id = 2;
        values[2].id = 3; values[3].id = 4;
    }
}

void runRawCountConditionalMove(int choose)
{
    unique RawCountElem* source = nullptr;
    int n = 3;
    if (choose != 0)
    {
        source = new RawCountElem[n];
        source[0].id = 4; source[1].id = 5; source[2].id = 6;
    }
    unique RawCountElem* destination = move source;
}

int runRawCountStaticView(int choose)
{
    static int[3] fixed = {4, 5, 6};
    static int[1] initial = {99};
    static int[] view = initial;
    if (choose != 0) view = fixed;
    int count = 0;
    int sum = 0;
    for (int value in view) { count++; sum += value; }
    return count * 100 + sum;
}

int runRawCountJoinDecl(int choose)
{
    resetRawCountState();
    {
        int a = 2;
        int b = 4;
        unique RawCountElem* values = choose != 0
            ? new RawCountElem[a] : new RawCountElem[b];
        int i = 0;
        int n = choose != 0 ? a : b;
        while (i < n) { values[i].id = i + 1; i++; }
    }
    return g_raw_count_dtors * 100 + g_raw_count_sum;
}

int runRawCountJoinAssign(int choose)
{
    resetRawCountState();
    {
        unique RawCountElem* values = nullptr;
        values = choose != 0
            ? new RawCountElem[2] : new RawCountElem[4];
    }
    return g_raw_count_dtors;
}

int runRawCountJoinNested(int mode)
{
    resetRawCountState();
    {
        unique RawCountElem* values = mode == 0
            ? new RawCountElem[2]
            : (mode == 1 ? new RawCountElem[3] : new RawCountElem[4]);
    }
    return g_raw_count_dtors;
}

int runRawCountJoinNullScalar(int mode)
{
    resetRawCountState();
    {
        unique RawCountElem* values = mode == 0
            ? new RawCountElem[2]
            : (mode == 1 ? nullptr : new RawCountElem());
    }
    return g_raw_count_dtors;
}

int runRawCountJoinCoalesce(int choose)
{
    resetRawCountState();
    {
        unique RawCountElem* values =
            ((choose != 0 ? new RawCountElem[2] : nullptr) ?? new RawCountElem[4]);
    }
    return g_raw_count_dtors;
}

int runRawCountJoinZero(int choose)
{
    resetRawCountState();
    {
        unique RawCountElem* values = choose != 0
            ? new RawCountElem[0] : new RawCountElem[2];
    }
    return g_raw_count_dtors;
}

int runRawCountJoinResources(int choose)
{
    resetRawCountState();
    g_raw_count_resource_dtors = 0;
    {
        unique RawCountOwnerElem* values = choose != 0
            ? new RawCountOwnerElem[2] : new RawCountOwnerElem[4];
    }
    return g_raw_count_dtors * 10 + g_raw_count_resource_dtors;
}

int runRawCountJoinAligned(int choose)
{
    resetRawCountState();
    {
        unique RawCountElem* values = nullptr;
        values = choose != 0
            ? new RawCountElem[2] alignas(0, 64)
            : new RawCountElem[4] alignas(0, 64);
    }
    return g_raw_count_dtors;
}

int runRawCountJoinView(int choose)
{
    int count = 0;
    int[] values = choose != 0 ? new int[2] : new int[4];
    for (int value in values) count++;
    delete[_] values;
    return count;
}

void rawCountSink(move RawCountElem* values) {}
void rawCountForward(move RawCountElem* values) { rawCountSink(move values); }
void rawCountGenericSink<T>(move T* values) {}
void rawCountAlignedSink(move alignas(0, 64) RawCountElem* values) {}
void rawCountOwnerSink(move RawCountOwnerElem* values) {}
move RawCountElem* rawCountReturn(move RawCountElem* values) { return move values; }

interface RawCountSinkInterface
{
    void sink(move RawCountElem* values);
    move RawCountElem* pass(move RawCountElem* values);
};

class RawCountSinkImpl : RawCountSinkInterface
{
    void sink(move RawCountElem* values) {}
    move RawCountElem* pass(move RawCountElem* values) { return move values; }
};

int runRawCountMoveDirect(int n)
{
    resetRawCountState();
    { unique RawCountElem* values = new RawCountElem[n]; rawCountSink(move values); }
    return g_raw_count_dtors;
}

int runRawCountMoveScalarNull(int scalar)
{
    resetRawCountState();
    {
        unique RawCountElem* values = scalar != 0 ? new RawCountElem() : nullptr;
        rawCountSink(move values);
    }
    return g_raw_count_dtors;
}

int runRawCountMoveIndirect(int n)
{
    resetRawCountState();
    {
        function<void(move RawCountElem*)> sink = rawCountSink;
        unique RawCountElem* values = new RawCountElem[n];
        sink(move values);
    }
    return g_raw_count_dtors;
}

int runRawCountMoveGeneric(int n)
{
    resetRawCountState();
    {
        unique RawCountElem* values = new RawCountElem[n];
        rawCountGenericSink<RawCountElem>(move values);
    }
    return g_raw_count_dtors;
}

int runRawCountMoveInterface(int n)
{
    resetRawCountState();
    {
        RawCountSinkInterface sink = new RawCountSinkImpl();
        unique RawCountElem* values = new RawCountElem[n];
        sink.sink(move values);
        delete sink;
    }
    return g_raw_count_dtors;
}

int runRawCountMoveForwardReturn(int n, int returnIt)
{
    resetRawCountState();
    {
        unique RawCountElem* values = new RawCountElem[n];
        if (returnIt != 0)
        {
            unique RawCountElem* result = rawCountReturn(move values);
        }
        else
        {
            rawCountForward(move values);
        }
    }
    return g_raw_count_dtors;
}

int runRawCountMoveReturnDispatch(int n, int interfaceCall)
{
    resetRawCountState();
    {
        unique RawCountElem* values = new RawCountElem[n];
        if (interfaceCall != 0)
        {
            RawCountSinkInterface sink = new RawCountSinkImpl();
            unique RawCountElem* result = sink.pass(move values);
            delete sink;
        }
        else
        {
            function<move RawCountElem*(move RawCountElem*)> pass = rawCountReturn;
            unique RawCountElem* result = pass(move values);
        }
    }
    return g_raw_count_dtors;
}

int runRawCountMoveResources(int n)
{
    resetRawCountState();
    g_raw_count_resource_dtors = 0;
    {
        unique RawCountOwnerElem* values = new RawCountOwnerElem[n];
        rawCountOwnerSink(move values);
    }
    return g_raw_count_dtors * 10 + g_raw_count_resource_dtors;
}

int runRawCountMoveAligned(int n)
{
    resetRawCountState();
    {
        unique alignas(0, 64) RawCountElem* values =
            new RawCountElem[n] alignas(0, 64);
        rawCountAlignedSink(move values);
    }
    return g_raw_count_dtors;
}

int runRawCountMoveReassign()
{
    resetRawCountState();
    {
        unique RawCountElem* values = new RawCountElem[2];
        values = new RawCountElem[4];
        rawCountSink(move values);
    }
    return g_raw_count_dtors;
}

// Accept-set for the local `alignas(0, N)` reassignment guard: every shape below stays legal.
int runLocalAlignAcceptSet()
{
    resetRawCountState();
    {
        unique alignas(0, 64) RawCountElem* wide;
        unique alignas(0, 64) RawCountElem* source = new RawCountElem[2] alignas(0, 64);
        wide = move source;
    }
    {
        // A plain `new` on the reassignment door inherits the local's declared clause.
        unique alignas(0, 64) RawCountElem* values;
        values = new RawCountElem[3];
    }
    {
        unique alignas(0, 64) RawCountElem* values = new RawCountElem[1] alignas(0, 64);
        values = nullptr;
    }
    return g_raw_count_dtors;
}

// A clause-FREE local records whatever the source carried and frees it through the matching
// deallocator, so receiving an over-aligned block needs no diagnostic.
int runLocalAlignPlainDestAccept()
{
    resetRawCountState();
    {
        unique alignas(0, 64) RawCountElem* owner = new RawCountElem[2] alignas(0, 64);
        unique RawCountElem* plain = nullptr;
        plain = move owner;
    }
    return g_raw_count_dtors;
}

// Regression for the false-rejection bug: the reassignment guard used to compare only the
// source's TRACKED block alignment (NamedVariable.AllocAlignment), which is never established
// for a plain (non-move) read of a parameter, global, or ternary-join arm - so a correctly
// aligned source of any of those three shapes was rejected with an untrue "ordinary alignment"
// diagnostic. The guard must also accept on the source's DECLARED 'alignas' clause, and must
// fail open when neither the tracked field nor the declared clause carries any evidence.
void runLocalAlignParamSink(alignas(0, 64) RawCountElem* src)
{
    alignas(0, 64) RawCountElem* p;
    p = src;
}
int runLocalAlignParamAccept()
{
    resetRawCountState();
    {
        unique alignas(0, 64) RawCountElem* owner = new RawCountElem[2] alignas(0, 64);
        runLocalAlignParamSink(owner);
    }
    return g_raw_count_dtors;
}

unique alignas(0, 64) RawCountElem* g_local_align_wide = default;
int runLocalAlignGlobalAccept()
{
    resetRawCountState();
    g_local_align_wide = new RawCountElem[2] alignas(0, 64);
    {
        alignas(0, 64) RawCountElem* p;
        p = g_local_align_wide;
    }
    g_local_align_wide = nullptr;
    return g_raw_count_dtors;
}

int runLocalAlignTernaryAccept(int choose)
{
    resetRawCountState();
    {
        unique alignas(0, 64) RawCountElem* a = new RawCountElem[2] alignas(0, 64);
        unique alignas(0, 64) RawCountElem* b = new RawCountElem[2] alignas(0, 64);
        alignas(0, 64) RawCountElem* p;
        p = choose != 0 ? a : b;
    }
    return g_raw_count_dtors;
}

int testRawArrayRuntimeCount()
{
    int passed = 0;

    resetRawCountState();
    {
        int n = 3;
        unique RawCountElem* values = new RawCountElem[n];
        values[0].id = 1; values[1].id = 2; values[2].id = 3;
    }
    passed += Test("raw count declaration init order", g_raw_count_order, 321);

    resetRawCountState();
    {
        unique RawCountElem* values = nullptr;
        int n = 3;
        values = new RawCountElem[n];
        values[0].id = 1; values[1].id = 2; values[2].id = 3;
    }
    passed += Test("raw count later assignment order", g_raw_count_order, 321);

    resetRawCountState();
    {
        unique RawCountElem* values = nullptr;
        int n = 3;
        if (n > 0)
        {
            values = new RawCountElem[n];
            values[0].id = 1; values[1].id = 2; values[2].id = 3;
        }
    }
    passed += Test("raw count if-only cleanup", g_raw_count_order, 321);

    resetRawCountState();
    runRawCountIfElse(1);
    passed += Test("raw count if-else true arm", g_raw_count_dtors * 100 + g_raw_count_sum, 230);
    resetRawCountState();
    runRawCountIfElse(0);
    passed += Test("raw count if-else false arm", g_raw_count_dtors * 100 + g_raw_count_sum, 410);

    resetRawCountState();
    {
        unique RawCountElem* values = new RawCountElem[1];
        values[0].id = 1;
        int i = 0;
        while (i < 2)
        {
            int n = i + 2;
            values = new RawCountElem[n];
            int j = 0;
            while (j < n) { values[j].id = 10 * n + j; j++; }
            i++;
        }
    }
    passed += Test("raw count loop reassignment", g_raw_count_dtors * 1000 + g_raw_count_sum, 6135);

    resetRawCountState();
    runRawCountConditionalMove(1);
    passed += Test("raw count conditional move live", g_raw_count_dtors * 100 + g_raw_count_sum, 315);
    resetRawCountState();
    runRawCountConditionalMove(0);
    passed += Test("raw count conditional move null", g_raw_count_dtors, 0);

    resetRawCountState();
    int nullMarker = 0;
    {
        unique RawCountElem* values = new RawCountElem[2];
        values[0].id = 1; values[1].id = 2;
        values = nullptr;
        nullMarker = values == nullptr ? g_raw_count_order : -1;
    }
    passed += Test("raw count null assignment releases old", nullMarker, 21);
    passed += Test("raw count null assignment clears state", g_raw_count_order, 21);

    resetRawCountState();
    RawCountElem* nullValues = nullptr;
    int nullCount = 3;
    delete[nullCount] nullValues;
    passed += Test("delete[n] null counted destruction", g_raw_count_dtors, 0);

    resetRawCountState();
    {
        unique alignas(0, 64) RawCountElem* values;
        int n = 2;
        if (n > 0)
            values = new RawCountElem[n] alignas(0, 64);
    }
    passed += Test("raw count aligned conditional cleanup", g_raw_count_dtors, 2);

    resetRawCountState();
    int moveSourceNull = 0;
    {
        unique RawCountElem* source = new RawCountElem[3];
        source[0].id = 1; source[1].id = 2; source[2].id = 3;
        unique RawCountElem* destination = move source;
        moveSourceNull = source == nullptr ? 1 : 0;
    }
    passed += Test("raw count direct move source null", moveSourceNull, 1);
    passed += Test("raw count direct move destination order", g_raw_count_order, 321);

    resetRawCountState();
    {
        unique RawCountElem* values = new RawCountElem[2];
        values[0].id = 1; values[1].id = 2;
        values = new RawCountElem[3];
        values[0].id = 3; values[1].id = 4; values[2].id = 5;
    }
    passed += Test("raw count array reassignment order", g_raw_count_order, 21543);

    resetRawCountState();
    g_raw_count_resource_dtors = 0;
    {
        unique RawCountOwnerElem* source = new RawCountOwnerElem[3];
        unique RawCountOwnerElem* destination = move source;
    }
    passed += Test("raw count move element resources", g_raw_count_dtors * 10 + g_raw_count_resource_dtors, 33);

    int[] view = new int[1];
    view[0] = 99;
    int chooseView = 1;
    if (chooseView != 0)
    {
        int n = 4;
        view = new int[n];
        view[0] = 1; view[1] = 2; view[2] = 3; view[3] = 4;
    }
    int viewSum = 0;
    int viewCount = 0;
    for (int value in view) { viewSum += value; viewCount++; }
    delete[_] view;
    passed += Test("raw count conditional view range", viewCount * 100 + viewSum, 410);

    int[3] fixedViewSource = {1, 2, 3};
    int[1] initialViewSource = {99};
    int[] fixedView = initialViewSource;
    fixedView = fixedViewSource;
    int fixedViewSum = 0;
    int fixedViewCount = 0;
    for (int value in fixedView) { fixedViewSum += value; fixedViewCount++; }
    passed += Test("raw count fixed-array view rebind", fixedViewCount * 100 + fixedViewSum, 306);

    int staticViewFirst = runRawCountStaticView(1);
    int staticViewSecond = runRawCountStaticView(0);
    passed += Test("raw count static view rebind persists",
                   staticViewFirst * 1000 + staticViewSecond, 315315);

    resetRawCountState();
    int zeroMoveSourceNull = 0;
    {
        int n = 0;
        unique RawCountElem* source = new RawCountElem[n];
        unique RawCountElem* destination = move source;
        zeroMoveSourceNull = source == nullptr ? 1 : 0;
    }
    passed += Test("raw count zero move source null", zeroMoveSourceNull, 1);
    passed += Test("raw count zero move cleanup", g_raw_count_dtors, 0);

    passed += Test("raw count ternary declaration both arms",
        runRawCountJoinDecl(1) * 1000 + runRawCountJoinDecl(0), 203410);
    passed += Test("raw count ternary assignment both arms",
        runRawCountJoinAssign(1) * 10 + runRawCountJoinAssign(0), 24);
    passed += Test("raw count nested ternary all arms",
        runRawCountJoinNested(0) * 100 + runRawCountJoinNested(1) * 10
            + runRawCountJoinNested(2), 234);
    passed += Test("raw count ternary null and scalar sentinels",
        runRawCountJoinNullScalar(0) * 100 + runRawCountJoinNullScalar(1) * 10
            + runRawCountJoinNullScalar(2), 201);
    passed += Test("raw count coalesce both arms",
        runRawCountJoinCoalesce(1) * 10 + runRawCountJoinCoalesce(0), 24);
    passed += Test("raw count zero-length ternary",
        runRawCountJoinZero(1) * 10 + runRawCountJoinZero(0), 2);
    passed += Test("raw count ternary owning resources",
        runRawCountJoinResources(1) * 100 + runRawCountJoinResources(0), 2244);
    passed += Test("raw count ternary aligned allocations",
        runRawCountJoinAligned(1) * 10 + runRawCountJoinAligned(0), 24);
    passed += Test("raw count ternary array view ranges",
        runRawCountJoinView(1) * 10 + runRawCountJoinView(0), 24);
    passed += Test("raw count move parameter direct zero and counts",
        runRawCountMoveDirect(0) * 100 + runRawCountMoveDirect(2) * 10
            + runRawCountMoveDirect(4), 24);
    passed += Test("raw count move parameter scalar and null",
        runRawCountMoveScalarNull(1) * 10 + runRawCountMoveScalarNull(0), 10);
    passed += Test("raw count move parameter indirect and generic",
        runRawCountMoveIndirect(2) * 1000 + runRawCountMoveIndirect(4) * 100
            + runRawCountMoveGeneric(2) * 10 + runRawCountMoveGeneric(4), 2424);
    passed += Test("raw count move parameter interface",
        runRawCountMoveInterface(2) * 10 + runRawCountMoveInterface(4), 24);
    passed += Test("raw count move parameter forward and return",
        runRawCountMoveForwardReturn(2, 0) * 1000
            + runRawCountMoveForwardReturn(4, 0) * 100
            + runRawCountMoveForwardReturn(2, 1) * 10
            + runRawCountMoveForwardReturn(4, 1), 2424);
    passed += Test("raw count move return indirect and interface",
        runRawCountMoveReturnDispatch(2, 0) * 1000
            + runRawCountMoveReturnDispatch(4, 0) * 100
            + runRawCountMoveReturnDispatch(2, 1) * 10
            + runRawCountMoveReturnDispatch(4, 1), 2424);
    passed += Test("raw count move parameter owning resources",
        runRawCountMoveResources(2) * 100 + runRawCountMoveResources(4), 2244);
    passed += Test("raw count move parameter alignment",
        runRawCountMoveAligned(2) * 10 + runRawCountMoveAligned(4), 24);
    passed += Test("raw count move parameter after reassignment",
        runRawCountMoveReassign(), 6);
    passed += Test("local alignas reassignment accept-set",
        runLocalAlignAcceptSet(), 6);
    passed += Test("local alignas clause-free destination accepted",
        runLocalAlignPlainDestAccept(), 2);
    passed += Test("local alignas reassignment from a same-clause parameter",
        runLocalAlignParamAccept(), 2);
    passed += Test("local alignas reassignment from a same-clause global",
        runLocalAlignGlobalAccept(), 1);
    passed += Test("local alignas reassignment from a same-clause ternary join",
        runLocalAlignTernaryAccept(1), 4);

    return passed;
}

