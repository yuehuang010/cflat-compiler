    r = testStringAPI();        passed += r; total += 116;
    r = testDiscard();          passed += r; total += 6;
    r = testDirectReturnOwnership(); passed += r; total += 6;
    r = testCLongWidth();       passed += r; total += 15;
    r = testRawArrayRuntimeCount(); passed += r; total += 44;
    r = testDictEnumeration();  passed += r; total += 12;
    r = testLiteralReceiverAndNullChain(); passed += r; total += 9;
    r = testDefaultAsExpression(); passed += r; total += 82;

    printf("\n%d / %d tests passed.\n", passed, total);
    return passed == total ? 0 : 1;
}
