// Ownership validation for list<T>: the six quadrants of the borrow-by-default rule.
//
// The claim under test: bare BORROWS and `unique` OWNS, uniformly for pointers AND
// interface values. Aligning on OWN instead is impossible, because boxing a STACK value
// into an interface is idiomatic and freeing a stack-boxed interface value aborts.
// Every ownership assertion is backed by a destructor count AND the HeapAudit
// leak oracle, since the failure mode of an ownership rule is a leak or a double free,
// neither of which a plain value assertion would catch. HeapAudit needs an -o build.
//
// Also covers the trade-off list accepts: value-type insertion COPIES (the caller's
// value stays intact), with `move` at the call site to transfer instead.
import "string.cb";
import "list.cb";
import "dictionary.cb";
import "queue.cb";
import "stack.cb";
import "diagnostic/heap_audit.cb";
import "test_helper.cb";

int g_dtor = 0;

class Res
{
    int id = default;
    Res(int i) { id = i; }
    ~Res() { g_dtor = g_dtor + 1; }
};

// g_ctor counts DEFAULT constructions only - a memberwise copy into a list slot does not run
// the constructor, so ctor and dtor totals differ by the number of copies, not by leaked slots.
int g_ctor = 0;
class Val
{
    int id = default;
    Val() { g_ctor = g_ctor + 1; }
    ~Val() { g_dtor = g_dtor + 1; }
};

struct AliasRow { int value = default; string text = default; };
// A pointer VIEW over an element the list owns. `&rows[0]` is a plain borrowed pointer - the
// same value the accessor spelling hands back - so storing it in a field or a global is legal.
struct AliasView { AliasRow* row = nullptr; };
AliasRow* g_aliasRow = nullptr;

// A user-written alias accessor hands out the same live-slot lvalue the container
// accessors do, so assigning through it must drop the old owner exactly as `l[0] = v` does.
class AliasHolder
{
    string t = default;
    alias string get() { return this->t; }
};

// An owned TEMP source: a returned local is moved out, so the assignment has no named
// source slot to fall back on - the destination must drop its own old value.
Val makeVal(int id)
{
    Val v = default;
    v.id = id;
    return v;
}


// A non-copyable value type: it owns a `unique` pointer and has no copy(), so copy
// synthesis is refused. is_copyable(NonCopyable) is 0 and list accepts it move-only.
class NonCopyable
{
    unique Res* r = default;
};

// Transitive: the unique pointer is one level down, reached through a by-value member.
// Pins the recursive walk in TypeOwnsUniquePointer, not just the direct-field case.
class NestedNonCopyable
{
    NonCopyable inner = default;
};

// A user-written copy() opts a unique-owning type back in to copyability.
class CopyableOwner
{
    unique Res* r = default;
    CopyableOwner copy() { CopyableOwner c; return move c; }
};

interface IShape { int area(); };

class Sq : IShape
{
    int s = default;
    Sq(int v) { s = v; }
    int area() { return s * s; }
    ~Sq() { g_dtor = g_dtor + 1; }
};

// --- primitives -----------------------------------------------------------------

int testPrimitives()
{
    int passed = 0;
    list<int> l = default;
    l.add(10);
    l.add(20);
    l.add(30);
    passed += Test("list<int> count", l.count(), 3);
    passed += Test("list<int> [0]", l[0], 10);
    passed += Test("list<int> get(2)", l.get(2), 30);
    passed += Test("list<int> count is 3", l.count(), 3);
    l.removeAt(l.count() - 1);
    passed += Test("list<int> count after removeAt last", l.count(), 2);
    l.removeAt(0);
    passed += Test("list<int> count after removeAt", l.count(), 1);
    passed += Test("list<int> [0] after removeAt", l[0], 20);
    l.clear();
    passed += Test("list<int> count after clear", l.count(), 0);
    return passed;
}

// --- alias PARAMETERS ------------------------------------------------------------
//
// A non-pointer `alias T` parameter borrows the CALLER's object, so it is passed as a
// pointer to it: `&param` is the caller's address, writes reach the caller, and the
// address may leave the callee (the caller's storage is not frame-local). Pre-fix every
// leg below saw the callee's frame copy: the address legs answered 0 and the mutation
// legs left the caller unchanged.
i64 apAddrRow(alias AliasRow r)       { return (i64)&r; }
i64 apAddrInt(alias int v)            { return (i64)&v; }
i64 apAddrStr(alias string s)         { return (i64)&s; }
i64 apAddrGeneric<T>(alias T x)       { return (i64)&x; }
i64 apAddrForward(alias AliasRow r)   { return apAddrRow(r); }
AliasRow* apReturnAddr(alias AliasRow r) { return &r; }
// The accept-set contrast: a PLAIN by-value parameter is still a COPY, so its address is
// its own frame slot. This leg fails if the pointer ABI is ever widened past `alias`.
i64 apAddrByValue(AliasRow r)         { return (i64)&r; }
void apBumpRow(alias AliasRow r)      { r.value = r.value + 5; }
void apBumpInt(alias int v)           { v = v + 5; }
void apWriteThroughPtr(AliasRow* p)   { p->value = 77; }
void apPassAddr(alias AliasRow r)     { apWriteThroughPtr(&r); }
int  apReadText(alias AliasRow r)     { return r.text.length(); }
int  apDtorProbe(alias Res r)         { return r.id; }

int testAliasParameterBorrows()
{
    int passed = 0;

    AliasRow row = default;
    row.value = 30;
    row.text = "alias";

    passed += Test("alias struct param address is the caller's",
        apAddrRow(row) == (i64)&row ? 1 : 0, 1);
    passed += Test("alias struct param forwarded keeps the caller's address",
        apAddrForward(row) == (i64)&row ? 1 : 0, 1);
    passed += Test("alias param address returned is the caller's",
        apReturnAddr(row) == &row ? 1 : 0, 1);
    passed += Test("by-value param address is NOT the caller's",
        apAddrByValue(row) == (i64)&row ? 1 : 0, 0);

    apBumpRow(row);
    passed += Test("write through an alias struct param reaches the caller", row.value, 35);
    apPassAddr(row);
    passed += Test("address of an alias param passed on writes the caller", row.value, 77);
    passed += Test("alias param reads the caller's owning field", apReadText(row), 5);

    int n = 40;
    passed += Test("alias primitive param address is the caller's",
        apAddrInt(n) == (i64)&n ? 1 : 0, 1);
    apBumpInt(n);
    passed += Test("write through an alias primitive param reaches the caller", n, 45);

    string s = "borrowed";
    passed += Test("alias string param address is the caller's",
        apAddrStr(s) == (i64)&s ? 1 : 0, 1);

    passed += Test("generic alias param address is the caller's (struct)",
        apAddrGeneric<AliasRow>(row) == (i64)&row ? 1 : 0, 1);
    passed += Test("generic alias param address is the caller's (primitive)",
        apAddrGeneric<int>(n) == (i64)&n ? 1 : 0, 1);

    // The address may also be stored OUT of the callee: the caller's slot outlives the call.
    g_aliasRow = apReturnAddr(row);
    g_aliasRow->value = 78;
    passed += Test("alias param address stored in a global writes the caller", row.value, 78);
    g_aliasRow = nullptr;

    // The borrow must not destruct the caller's object: the parameter owns nothing.
    int before = g_dtor;
    Res* r = new Res(9);
    int id = apDtorProbe(*r);
    passed += Test("alias param reads the borrowed object", id, 9);
    passed += Test("alias param runs no destructor", g_dtor - before, 0);
    delete r;
    passed += Test("the real owner still destructs once", g_dtor - before, 1);

    return passed;
}

// --- alias parameter TEMPS (resource legs) ---------------------------------------
//
// An RVALUE bound to an `alias` parameter has no named owner and the borrow never frees it,
// so the materialized argument slot must be destructed at end-of-full-expression. Pre-fix
// (commit 2fa0bb0) every ApRes leg below counted 0 destructor runs and leaked its pointee;
// the by-value control counted 1 all along, and the HeapAudit oracle in main() saw the leak.
int g_apDtor = 0;
struct ApRes
{
    int* p = nullptr;
    ~ApRes() { g_apDtor = g_apDtor + 1; if (p != nullptr) delete p; }
};
ApRes apMakeRes(int v) { ApRes r = default; r.p = new int; *r.p = v; return r; }
struct ApHolder { int id = default; ApRes make(int v) { return apMakeRes(v); } };
int apTakeAliasRes(alias ApRes r) { return *r.p; }
int apTakeValueRes(ApRes r)       { return *r.p; }
int apAliasIsNull(alias ApRes r)  { return r.p == nullptr ? 1 : 0; }
int apNestForward(alias ApRes r)  { return apTakeAliasRes(r); }
int apAliasStrLen(alias string s) { return s.length(); }
int apAliasIntPlus(alias int v)   { return v + 1; }

int testAliasParameterTempsDestruct()
{
    int passed = 0;

    g_apDtor = 0;
    passed += Test("rvalue temp read through an alias param", apTakeAliasRes(apMakeRes(7)), 7);
    passed += Test("rvalue temp bound to an alias param is destructed", g_apDtor, 1);

    // Accept-set contrast: the by-value spelling already destructed its temp.
    g_apDtor = 0;
    passed += Test("by-value control reads the temp", apTakeValueRes(apMakeRes(7)), 7);
    passed += Test("by-value control destructs the temp once", g_apDtor, 1);

    // A literal has no destructor: these pin that the registration is TYPE-gated (an owning
    // struct only) and neither fires nor mis-lowers on a string / primitive argument.
    passed += Test("string literal into an alias string param", apAliasStrLen("hello"), 5);
    passed += Test("int literal into an alias int param", apAliasIntPlus(3), 4);

    // A temp produced by a '?.' chain reaches the argument as a MERGED load, not a CallInst,
    // so the registration must consult IsProducedTempValue rather than isa<CallInst>.
    g_apDtor = 0;
    ApHolder h = default;
    ApHolder* hp = &h;
    passed += Test("'?.' temp read through an alias param", apTakeAliasRes(hp?.make(11)), 11);
    passed += Test("'?.' temp bound to an alias param is destructed", g_apDtor, 1);

    // The null-receiver twin: the merged record is zeroed, so its destructor runs once and
    // frees nothing (a null `p`).
    g_apDtor = 0;
    ApHolder* hnull = nullptr;
    passed += Test("null '?.' temp into an alias param is the zero value",
        apAliasIsNull(hnull?.make(5)), 1);
    passed += Test("null '?.' temp destructs its zeroed record once", g_apDtor, 1);

    // Forwarding an alias param to another alias param hands over the SAME slot, so the temp
    // must be destructed exactly ONCE - a second registration would double-free and abort
    // the HeapAudit oracle.
    g_apDtor = 0;
    passed += Test("temp forwarded through two alias params", apNestForward(apMakeRes(21)), 21);
    passed += Test("temp forwarded through two alias params destructs once", g_apDtor, 1);

    return passed;
}

// Non-pointer alias returns are reference lvalues. Exercise direct access and declared alias
// bindings over an owning struct and a primitive element. HeapAudit below proves the alias views
// do not become owners.
int testAliasLvalueSemantics()
{
    int passed = 0;

    list<AliasRow> rows = default;
    AliasRow row = default;
    row.value = 10;
    row.text = "alias";
    rows.add(row);

    rows[0].value = 11;
    passed += Test("alias list index writes live slot", rows.get(0).value, 11);

    alias AliasRow byBinding = rows.get(0);
    byBinding.value = 12;
    passed += Test("alias local writes source slot", rows[0].value, 12);
    passed += Test("alias local reads owning fields", byBinding.text.length(), 5);

    list<int> values = default;
    values.add(20);
    alias int byPrimitive = values.get(0);
    byPrimitive = 21;
    passed += Test("alias primitive binding writes live slot", values[0], 21);

    // Address-of an alias element, stored into a struct field and into a global. Both write the
    // list's live slot; neither view owns it (the heap audit below covers the teardown).
    AliasView view = default;
    view.row = &rows[0];
    view.row->value = 13;
    passed += Test("alias element address in a field writes live slot", rows.get(0).value, 13);
    passed += Test("alias element address in a field reads owning field", view.row->text.length(), 5);

    g_aliasRow = &rows.get(0);
    g_aliasRow->value = 14;
    passed += Test("alias element address in a global writes live slot", rows[0].value, 14);
    g_aliasRow = nullptr;

    // `.copy()` is exactly what the return-escape diagnostic tells the user to reach for, so it
    // has to compile through an alias lvalue: the receiver is a by-value argument read OUT of
    // the borrowed slot, not the slot's address. Passing the address emitted an unverifiable
    // module, so both legs below are unreachable unless the argument is loaded.
    AliasRow copied = rows.get(0).copy();
    copied.value = 99;
    passed += Test("alias result copy carries owning field", copied.text.length(), 5);
    passed += Test("alias result copy leaves the element alone", rows[0].value, 14);

    return passed;
}

// Assigning THROUGH an alias-result lvalue overwrites a LIVE element the container handed
// out - unlike `_data[i] = v` inside container code, which fills an EMPTY slot. The old owner
// must therefore be dropped exactly once: skipping it leaks the old buffer, doing it twice
// double-destructs. The two RESOURCE legs are what discriminate the leak fix - each leaked its
// old buffer before it, and only the HeapAudit oracle in main() sees that (both value
// assertions passed while leaking). The two VALUE legs are the destructor-count tripwire for
// the opposite direction, a widened drop-old destructing the slot twice.
int testAliasLvalueAssignDropsOldOwner()
{
    int passed = 0;

    // string element, OWNED TEMP source. The old "alpha" buffer has no other owner.
    {
        list<string> l = default;
        l.add("alpha".copy());
        l[0] = "beta".copy();
        passed += Test("alias index assign temp replaces string element", l[0].length(), 4);
    }

    // Same shape through a user `alias string get()` rather than a container accessor.
    {
        AliasHolder h = default;
        h.t = "alpha".copy();
        h.get() = "beta".copy();
        passed += Test("user alias accessor assign replaces string", h.t.length(), 4);
    }

    // Value element with a side-effecting destructor, OWNED TEMP source. This leg does NOT
    // discriminate the leak fix (it counted 2 before it too): it is the tripwire for the
    // OPPOSITE failure - widening the drop-old so the slot is destructed a second time, which
    // is how an earlier attempt double-freed `list<Val>`. The two destructs here are the
    // replaced element and the moved-out temp, in exactly that number.
    {
        g_dtor = 0;
        list<Val> l = default;
        l.add(makeVal(1));
        g_dtor = 0;
        l[0] = makeVal(2);
        passed += Test("alias index assign temp destructs old value once", g_dtor, 2);
        passed += Test("alias index assign temp stores new value", l[0].id, 2);
    }

    // Value element with a NAMED source: the copy path already dropped the old element, so
    // this leg is the tripwire against a widened drop-old destructing it a second time.
    {
        list<Val> l = default;
        Val a = default;
        a.id = 1;
        l.add(a);
        Val b = default;
        b.id = 2;
        g_dtor = 0;
        l.get(0) = b;
        passed += Test("alias get assign named source destructs old once", g_dtor, 1);
        passed += Test("alias get assign named source keeps source live", b.id, 2);
        passed += Test("alias get assign named source stores value", l.get(0).id, 2);
    }

    return passed;
}

// --- value types: insertion COPIES -----------------------------------------------

int testValueCopySemantics()
{
    int passed = 0;
    g_dtor = 0;
    g_ctor = 0;
    {
        list<Val> l = default;
        Val a = default;
        a.id = 1;
        l.add(a);
        passed += Test("list<Val> stored value", l[0].id, 1);
        // Mutating the source must not touch the stored copy - proves a deep copy, not an alias.
        a.id = 42;
        passed += Test("list<Val> copy is independent", l[0].id, 1);
        passed += Test("list<Val> source intact", a.id, 42);
    }
    // Six destructors for six live Val objects: the source local, the copy in slot 0, and the
    // FOUR slots of the cap-4 backing buffer, which `new Val[4]` default-CONSTRUCTS. Only the
    // first two ran before the container drain fix - the buffer's four were never destructed at
    // all, which is a leak for any element type whose construction acquires. The ctor/dtor pair
    // is the real assertion: 5 default constructions + 1 memberwise copy = 6 destructions.
    passed += Test("list<Val> ctor count", g_ctor, 5);
    passed += Test("list<Val> dtor count", g_dtor, 6);
    return passed;
}

int testStringCopySemantics()
{
    int passed = 0;
    {
        list<string> l = default;
        string s = "hel" + "lo";
        l.add(s);
        passed += Test("list<string> source intact after add", s.length(), 5);
        passed += Test("list<string> stored", l[0].length(), 5);
    }
    return passed;
}

// A `move` at the call site transfers instead of copying - the opt-in escape from the
// copy default. Reading `s` afterwards is a compile error, so the assertion is on the
// stored value plus leak-freedom.
int testStringMoveSemantics()
{
    int passed = 0;
    {
        list<string> l = default;
        string s = "wor" + "ld";
        l.add(move s);
        passed += Test("list<string> stored after move", l[0].length(), 5);
    }
    return passed;
}

// --- string read out of a TEMPORARY: borrow in rvalue position, implicit COPY when bound ---
//
// The 2026-08-21 ruling (was internal/issue/p3 string-field-read-from-container-element-requires-copy).
// `bars.get(0).date` and `fields.get(0)` name a buffer the CONTAINER owns. Consumed inside the full
// expression it is a plain BORROW; bound to anything that outlives the expression it is copied, so
// the binding owns an independent buffer. Mutating the copy must leave the element untouched - that
// is what separates a real copy from the borrow the compiler used to store silently - and the
// HeapAudit oracle in main() is what proves the copy is neither leaked nor double-freed.

struct TBar { string date = default; int n = 0; };
struct TBox { string slot = default; };

// An owning STRUCT (not a bare string) read out of a temporary in brace-init member position.
// The `=` twin has always rejected the BORROW spelling and implied-moved the MOVE-temp one;
// the brace spelling did neither, so it read a freed buffer (reject legs in
// Test/errors/err_temp_field_store.cb) and double-freed the move-temp one (leg 8 below).
struct TWrap { TBar inner = default; };
struct THold { TBar slot = default; };
TWrap makeTWrap() { TWrap w = default; w.inner.date = "2020-" + "01-01"; w.inner.n = 1; return w; }

// A bare STRING field (not the owning struct itself) read out of a temporary in brace-init
// member position. `braceMoveTempField` used to fire for `string` fields too - the string
// store path already deep-copies, so the extra zero-store on the temp's field orphaned the
// copy's buffer (leak, not a double free; see legs 9/10 below).
struct Tok   { string text  = default; };
struct SHold { string s     = default; };
Tok mkTok() { Tok t = default; t.text = "c" + "d"; return t; }
struct TokWrap { Tok inner = default; };
TokWrap mkTokWrap() { TokWrap w = default; w.inner.text = "c" + "d"; return w; }

string tbarDate(alias list<TBar> l) { return l.get(0).date; }
// A whole ELEMENT returned through two levels: neither level may hand back a borrow.
string telemFirstInner(alias list<string> l) { return l.get(0); }
string telemFirst(alias list<string> l) { return telemFirstInner(l); }
int tbarLen(string s) { return (int)s.length(); }

int testStringTempFieldCopy()
{
    int passed = 0;
    {
        list<TBar> bars = default;
        TBar b = default; b.date = "2020-" + "01-01"; b.n = 1; bars.add(b);

        // 1. local init, and the copy is INDEPENDENT of the element.
        string d = bars.get(0).date;
        passed += Test("temp string field binds to a local", d, "2020-01-01");
        d = d + "-MUT";
        passed += Test("mutating the copy leaves the element intact", bars.get(0).date, "2020-01-01");

        // 2. assignment to an existing string local.
        string e = "old";
        e = bars.get(0).date;
        passed += Test("temp string field assigns to a local", e, "2020-01-01");

        // 3. struct field store, and 4. brace-init member.
        TBox f = default;
        f.slot = bars.get(0).date;
        passed += Test("temp string field stores into a field", f.slot, "2020-01-01");
        TBox g = { slot = bars.get(0).date };
        passed += Test("temp string field brace-initializes a field", g.slot, "2020-01-01");

        // 5. return.
        passed += Test("temp string field returns by copy", tbarDate(bars), "2020-01-01");

        // The whole element is still intact after all five bindings.
        passed += Test("element unchanged after five copies", bars.get(0).date, "2020-01-01");
    }
    {
        // 6/7. Brace-init of an OWNING STRUCT field from sources that are NOT a borrowed temp:
        // a named local's field and an explicit `.copy()` both stay legal and independent.
        TWrap named = default; named.inner.date = "2020-" + "01-01"; named.inner.n = 1;
        THold fromNamed = { slot = named.inner };
        passed += Test("named local owning field brace-initializes a field", fromNamed.slot.date, "2020-01-01");
        THold fromCopy = { slot = named.inner.copy() };
        passed += Test("copied owning field brace-initializes a field", fromCopy.slot.date, "2020-01-01");

        // 8. A MOVE temp OWNS its field, so the brace store takes the same implied move the `=`
        // path takes: the temp's field is nulled and the buffer is freed exactly once. Before the
        // fix this aborted with a double free (rc 134) while the `=` spelling was already correct.
        THold fromMoveTemp = { slot = makeTWrap().inner };
        passed += Test("move-temp owning field brace-initializes a field", fromMoveTemp.slot.date, "2020-01-01");

        // 9. A bare `string` field read off a MOVE temp binds by implicit COPY (the string
        // store path already deep-copies) - it must NOT also take the struct-field implied
        // move, or the extra zero-store orphans the copy's buffer (leak).
        SHold fromMoveTempStr = { s = mkTok().text };
        passed += Test("move-temp string field brace-initializes by copy", fromMoveTempStr.s, "cd");

        // 10. Same shape one level deeper: `mk().inner.text` - the nested owning struct is
        // itself the move temp's field, and `.text` is a string field of THAT struct.
        SHold fromNestedMoveTempStr = { s = mkTokWrap().inner.text };
        passed += Test("nested move-temp string field brace-initializes by copy",
                        fromNestedMoveTempStr.s, "cd");
    }
    return passed;
}

// The whole-element sibling: `fields.get(0)` on a list<string> is the same borrow without a
// field access, and the two BINDING spellings that used to be rejected are the field stores.
int testStringTempElementCopy()
{
    int passed = 0;
    {
        list<string> fields = default;
        fields.add("el" + "em0");
        TBox a = default;
        a.slot = fields.get(0);
        passed += Test("temp string element stores into a field", a.slot, "elem0");
        TBox b = { slot = fields.get(0) };
        passed += Test("temp string element brace-initializes a field", b.slot, "elem0");
        a.slot = a.slot + "-MUT";
        passed += Test("mutating the field copy leaves the element intact", fields.get(0), "elem0");

        // The three BINDING sites for the ELEMENT itself. Each must own an independent buffer:
        // `clear()` frees the one the container owns, and every binding must still read back.
        string c = fields[0];                 // local init, index spelling
        string d = fields.get(0);             // local init, accessor spelling
        string e = "old"; e = fields.get(0);  // assignment
        string h = telemFirst(fields);        // return
        fields.clear();
        passed += Test("bound element survives clear (local init, [])", c, "elem0");
        passed += Test("bound element survives clear (local init, get)", d, "elem0");
        passed += Test("bound element survives clear (assignment)", e, "elem0");
        passed += Test("bound element survives clear (return)", h, "elem0");
        d = d + "-MUT";
        passed += Test("mutating one bound copy leaves the others intact", c, "elem0");
    }
    return passed;
}

// RVALUE position: consumed inside the full expression, so it stays a BORROW - no copy, no
// diagnostic. These spellings must keep working and must not start allocating.
int testStringTempFieldBorrow()
{
    int passed = 0;
    {
        list<TBar> bars = default;
        TBar b = default; b.date = "2020-" + "01-01"; bars.add(b);
        passed += Test("concat operand", "date=" + bars.get(0).date, "date=2020-01-01");
        passed += Test("function argument", tbarLen(bars.get(0).date), 10);
        passed += Test("comparison operand", bars.get(0).date == "2020-01-01", true);
        passed += Test("method receiver", (int)bars.get(0).date.length(), 10);
    }
    return passed;
}

// --- bare pointer: BORROWS --------------------------------------------------------

int testBarePointerBorrows()
{
    int passed = 0;
    g_dtor = 0;
    // The owner is spelled `unique`: that is what makes "someone else owns this element" a
    // DECLARED fact, so handing it to a borrowing container is legal. A bare `Res* p = new Res(1)`
    // is an owning local with no policy and the add-site rule rejects it (err_delete_borrowed_owned_element).
    {
        unique Res* p = new Res(1);
        {
            list<Res*> l = default;
            l.add(p);
            // The source is NOT consumed - a borrowing container leaves it usable.
            passed += Test("list<T*> source usable after add", p.id, 1);
            passed += Test("list<T*> stored", l[0].id, 1);
            l.clear();
            passed += Test("list<T*> clear frees nothing", g_dtor, 0);
        }
        passed += Test("list<T*> dtor frees nothing", g_dtor, 0);
    }
    passed += Test("list<T*> caller frees exactly once", g_dtor, 1);
    return passed;
}

// The spelling `list<alias Res*>` was removed; a bare pointer element already borrows.
// These are the same borrow assertions, re-pointed at the surviving spelling.
int testBorrowedPointerElementBorrows()
{
    int passed = 0;
    g_dtor = 0;
    {
        unique Res* p = new Res(2);
        {
            list<Res*> l = default;
            l.add(p);
            passed += Test("borrowed list<T*> source usable", p.id, 2);
            passed += Test("borrowed list<T*> stored", l[0].id, 2);
        }
        passed += Test("borrowed list<T*> dtor frees nothing", g_dtor, 0);
    }
    passed += Test("borrowed list<T*> caller frees once", g_dtor, 1);
    return passed;
}

// list<alias T*> is the pure-borrow spelling: behaviorally identical to a bare pointer element
// (never frees), but a delete of a get()/[] result bound to a local is rejected (see
// err_delete_alias_borrow). Here nothing deletes a borrow; the real owners free exactly once.
int testAliasPointerElementBorrows()
{
    int passed = 0;
    g_dtor = 0;
    Res* p1 = new Res(3);
    Res* p2 = new Res(4);
    {
        list<alias Res*> l = default;
        l.add(p1);
        l.add(p2);
        passed += Test("alias list<T*> count", l.count(), 2);
        Res* g0 = l.get(0);
        passed += Test("alias list<T*> get()", g0.id, 3);
        passed += Test("alias list<T*> [1]", l[1].id, 4);
        int sum = 0;
        for (int i = 0; i < l.count(); i = i + 1)
            sum = sum + l[i].id;
        passed += Test("alias list<T*> iterate sum", sum, 7);
        passed += Test("alias list<T*> sources usable", p1.id + p2.id, 7);
    }
    passed += Test("alias list<T*> dtor frees nothing", g_dtor, 0);
    delete p1;
    delete p2;
    passed += Test("alias list<T*> owners free once each", g_dtor, 2);
    return passed;
}

// --- unique pointer: OWNS ---------------------------------------------------------

int testUniquePointerOwns()
{
    int passed = 0;
    g_dtor = 0;
    {
        list<unique Res*> l = default;
        l.add(new Res(1));
        l.add(new Res(2));
        passed += Test("list<unique T*> count", l.count(), 2);
        l.removeAt(l.count() - 1);
        passed += Test("list<unique T*> removeAt frees", g_dtor, 1);
    }
    passed += Test("list<unique T*> dtor frees the rest", g_dtor, 2);
    return passed;
}

int testUniquePointerSetFreesOld()
{
    int passed = 0;
    g_dtor = 0;
    {
        list<unique Res*> l = default;
        l.add(new Res(1));
        l.set(0, new Res(2));
        passed += Test("list<unique T*> set frees old element", g_dtor, 1);
    }
    passed += Test("list<unique T*> set total dtors", g_dtor, 2);
    return passed;
}

// Self-assign of a thin `unique T*` local (`a = a`) is a no-op: the slot keeps its
// pointee (no spurious free, no zeroed slot). Regression for the self-move segfault.
int testUniquePointerSelfAssign()
{
    int passed = 0;
    g_dtor = 0;
    {
        unique Res* a = new Res(5);
        a = a;
        passed += Test("unique self-assign keeps value", a->id, 5);
        passed += Test("unique self-assign no premature free", g_dtor, 0);
    }
    passed += Test("unique self-assign frees once at scope exit", g_dtor, 1);
    return passed;
}

// Reassigning a live `unique T*` local from another (`b = a`) is a move: it must free b's
// OLD pointee at the store (or it leaks), mark a moved, and leave exactly one surviving
// pointee to free at scope exit. Regression for the unique-local reassign leak.
int testUniquePointerReassignFreesOld()
{
    int passed = 0;
    g_dtor = 0;
    {
        unique Res* a = new Res(1);
        unique Res* b = new Res(2);
        b = a;
        // b's old pointee (id 2) is freed right at the store; a is now moved into b.
        passed += Test("unique reassign frees old pointee at store", g_dtor, 1);
        passed += Test("unique reassign keeps moved value", b->id, 1);
    }
    // The surviving pointee (originally a's, now b's) frees once at scope exit.
    passed += Test("unique reassign two total dtors", g_dtor, 2);
    return passed;
}

// Reassigning into a NON-owning `unique T*` local (`b = nullptr; b = a;`) must make the
// destination adopt ownership, or the transferred pointee is skipped at scope exit and
// leaks. Exactly one destruction at scope exit, 0 leaks.
int testUniquePointerReassignNullDest()
{
    int passed = 0;
    g_dtor = 0;
    {
        unique Res* a = new Res(3);
        unique Res* b = nullptr;
        b = a;
        // b's old pointee is null, so nothing frees at the store.
        passed += Test("unique reassign null-dest no store free", g_dtor, 0);
        passed += Test("unique reassign null-dest keeps value", b->id, 3);
    }
    // The transferred pointee frees exactly once at scope exit (b now owns it).
    passed += Test("unique reassign null-dest one dtor", g_dtor, 1);
    return passed;
}

// Storing a named owning `unique T*` local into a `unique T*` struct FIELD (`w.f = a`) must
// TRANSFER, not alias: the field becomes the sole owner and `a` is consumed (nulled + marked
// moved). Without the transfer both handles co-owned one pointee (silent alias; UAF one
// perturbation away) - the refcount-alias path was never consulted at the field free.
struct WrapRes { unique Res* f = default; };
int testUniquePointerFieldStoreTransfers()
{
    int passed = 0;
    g_dtor = 0;
    {
        WrapRes w = default;
        unique Res* a = new Res(7);
        w.f = a;
        // a is now moved into the field; nothing frees at the store, one live pointee remains.
        passed += Test("unique field store no premature free", g_dtor, 0);
        passed += Test("unique field store field owns value", w.f->id, 7);
    }
    // The field's sole pointee frees exactly once at w's teardown (a was consumed, frees nothing).
    passed += Test("unique field store one dtor at scope exit", g_dtor, 1);
    return passed;
}

// --- interfaces: the alignment claim ----------------------------------------------

// The case list<T> cannot support: a bare interface container holding a STACK value.
// Freeing it would abort, so bare MUST borrow - and list borrows bare pointers too,
// which is the whole point of the design.
int testBareInterfaceBorrows()
{
    int passed = 0;
    g_dtor = 0;
    {
        Sq q = default;
        q.s = 3;
        {
            list<IShape> l = default;
            l.add(q);
            passed += Test("list<IShape> virtual dispatch", l[0].area(), 9);
            l.clear();
            passed += Test("list<IShape> clear frees nothing", g_dtor, 0);
        }
        passed += Test("list<IShape> dtor frees nothing", g_dtor, 0);
        passed += Test("list<IShape> stack source still usable", q.area(), 9);
    }
    // Only the stack Sq's own destructor runs.
    passed += Test("list<IShape> stack source dtor once", g_dtor, 1);
    return passed;
}

int testUniqueInterfaceOwns()
{
    int passed = 0;
    g_dtor = 0;
    {
        list<unique IShape> l = default;
        l.add(new Sq(7));
        passed += Test("list<unique IShape> virtual dispatch", l[0].area(), 49);
    }
    passed += Test("list<unique IShape> dtor frees", g_dtor, 1);
    return passed;
}

// --- copy() -----------------------------------------------------------------------

int testCopyValue()
{
    int passed = 0;
    {
        list<Val> src = default;
        Val a = default;
        a.id = 5;
        src.add(a);
        list<Val> dst = src.copy();
        passed += Test("list<Val> copy count", dst.count(), 1);
        passed += Test("list<Val> copy value", dst[0].id, 5);
        passed += Test("list<Val> copy source intact", src[0].id, 5);
    }
    return passed;
}

int testCopyBorrowedPointer()
{
    int passed = 0;
    g_dtor = 0;
    {
        unique Res* p = new Res(9);
        {
            list<Res*> src = default;
            src.add(p);
            list<Res*> dst = src.copy();
            passed += Test("list<T*> copy count", dst.count(), 1);
            // Both containers borrow the SAME pointee - a borrowing copy is a shallow alias.
            passed += Test("list<T*> copy aliases same element", dst[0].id, 9);
            passed += Test("list<T*> copy source intact", src[0].id, 9);
        }
        passed += Test("list<T*> two borrowing copies free nothing", g_dtor, 0);
    }
    passed += Test("list<T*> owner frees exactly once", g_dtor, 1);
    return passed;
}

// --- IList<T> contract -----------------------------------------------------------

// list satisfies IList with no `move` anywhere in the contract; calls through the
// interface must behave identically to direct calls.
int testIListContract()
{
    int passed = 0;
    g_dtor = 0;
    Res* p = new Res(4);
    {
        list<Res*> concrete = default;
        IList<Res*> l = concrete;
        l.add(p);
        passed += Test("IList count through interface", l.count(), 1);
        passed += Test("IList get() through interface", l.get(0).id, 4);
        passed += Test("IList count through interface", l.count(), 1);
        // Insertion through the contract borrows too - no move in the signature.
        passed += Test("IList add did not consume source", p.id, 4);
        l.clear();
        passed += Test("IList clear through interface", l.count(), 0);
        passed += Test("IList clear freed nothing", g_dtor, 0);
    }
    delete p;
    passed += Test("IList owner frees once", g_dtor, 1);
    return passed;
}

// --- take(): remove-and-return, ownership defers to T ---------------------------

// A value struct that owns a heap resource (a string) - the case a plain `return v` of a
// move-initialized local used to double-free. take() now relies on implicit-move-on-return
// (plain `return v` transfers), so this pins the moved element survives the hand-off intact.
struct TakeRow { string s = default; TakeRow copy() { TakeRow r; r.s = s.copy(); return move r; } };

// take() is a single bare `T take(int)` - no `if const`, no keyword at the call site.
// Ownership defers to T: unique transfers out, a bare pointer returns a borrow, a value
// (incl. heap-owning) transfers. The same holds through the IList<T> interface.
int testTake()
{
    int passed = 0;
    // unique element: take transfers ownership to the caller.
    g_dtor = 0;
    {
        list<unique Res*> l = default;
        l.add(new Res(1)); l.add(new Res(2)); l.add(new Res(3));
        Res* taken = l.take(1);                       // take the middle
        passed += Test("take unique leaves list smaller", l.count(), 2);
        passed += Test("take unique freed nothing yet", g_dtor, 0);
        delete taken;                                 // caller owns it
        passed += Test("take unique caller frees once", g_dtor, 1);
    }                                                  // list frees the remaining 2
    passed += Test("take unique list frees rest at teardown", g_dtor, 3);

    // bare pointer element: take returns a borrow; the real owner frees.
    g_dtor = 0;
    {
        unique Res* owner = new Res(9);
        {
            list<Res*> l = default;
            l.add(owner);
            Res* borrowed = l.take(0);
            passed += Test("take borrow returns the element", borrowed.id, 9);
        }                                              // list frees nothing (borrow)
        passed += Test("take borrow list freed nothing", g_dtor, 0);
    }
    passed += Test("take borrow owner frees once", g_dtor, 1);

    // unique element through the IList<T> interface (virtual dispatch preserves ownership).
    g_dtor = 0;
    {
        list<unique Res*> concrete = default;
        concrete.add(new Res(5));
        IList<unique Res*> l = concrete;
        Res* taken = l.take(0);
        delete taken;
    }
    passed += Test("take unique via interface frees once", g_dtor, 1);

    // value element owning heap: take transfers the value, no double-free of the moved-from slot.
    {
        list<TakeRow> l = default;
        TakeRow a = default; a.s = "aa" + "aa"; l.add(a);
        TakeRow b = default; b.s = "bb" + "bb"; l.add(b);
        TakeRow got = l.take(0);
        passed += Test("take value-heap returns the element", got.s == "aaaa", true);
        passed += Test("take value-heap leaves list smaller", l.count(), 1);
    }
    return passed;
}

// --- implicit move on return ----------------------------------------------------

// A `move` owning-struct parameter returned by a PLAIN `return h` transfers implicitly
// (implicit-move-on-return): the caller becomes the sole owner, no double-free. NonCopyable
// has no copy(), so this body compiles ONLY because the plain return is treated as a move -
// a copy would be rejected. Pins the behavior that once required an explicit `return move h`.
move NonCopyable fwdOwner(move NonCopyable h) { return h; }

int testImplicitMoveReturn()
{
    int passed = 0;
    g_dtor = 0;
    {
        NonCopyable src = default;
        src.r = new Res(4);
        NonCopyable dst = fwdOwner(move src);          // src -> param -> dst, one owner throughout
        passed += Test("implicit-move return kept the resource", dst.r->id, 4);
        passed += Test("implicit-move return freed nothing yet", g_dtor, 0);
    }                                                  // dst's scope exit frees exactly once
    passed += Test("implicit-move return frees exactly once", g_dtor, 1);
    return passed;
}

// --- non-copyable element type: move-only insertion -----------------------------

int testNonCopyableMoveOnly()
{
    int passed = 0;
    g_dtor = 0;
    {
        list<NonCopyable> l = default;
        NonCopyable h = default;
        h.r = new Res(7);
        // add(T) is poisoned for a non-copyable T; the move overload must still work.
        l.add(move h);
        passed += Test("non-copyable move add count", l.count(), 1);
        passed += Test("non-copyable move add freed nothing yet", g_dtor, 0);
    }
    passed += Test("non-copyable element freed exactly once", g_dtor, 1);
    return passed;
}

// --- sort() ----------------------------------------------------------------------

// sort is orthogonal to ownership - it permutes slots in place and must neither free
// nor copy elements. Exercised on a value leg and on the borrowing pointer leg.
int testSort()
{
    int passed = 0;
    g_dtor = 0;
    list<int> li = default;
    li.add(30); li.add(10); li.add(20);
    li.sort((int a, int b) => { return a < b; });
    passed += Test("sort<int> [0]", li[0], 10);
    passed += Test("sort<int> [2]", li[2], 30);

    {
        unique Res* r1 = new Res(3);
        unique Res* r2 = new Res(1);
        unique Res* r3 = new Res(2);
        {
            list<Res*> lp = default;
            lp.add(r1); lp.add(r2); lp.add(r3);
            lp.sort((Res* a, Res* b) => { return a.id < b.id; });
            passed += Test("sort<T*> [0]", lp[0].id, 1);
            passed += Test("sort<T*> [2]", lp[2].id, 3);
            passed += Test("sort<T*> freed nothing", g_dtor, 0);
        }
        passed += Test("sort<T*> dtor freed nothing", g_dtor, 0);
    }
    passed += Test("sort<T*> owner frees each once", g_dtor, 3);
    return passed;
}

// is_copyable(T) must agree with the compiler's own copy refusal for every T.
class CopyProbe<T>
{
    int copyable()
    {
        if const (is_copyable(T)) return 1;
        else                      return 0;
    }
};

int testIsCopyable()
{
    int passed = 0;
    CopyProbe<int> a = default;
    CopyProbe<Res*> b = default;
    CopyProbe<unique Res*> c = default;
    CopyProbe<string> e = default;
    CopyProbe<IShape> f = default;
    CopyProbe<Val> g = default;
    CopyProbe<NonCopyable> h = default;
    CopyProbe<NestedNonCopyable> i = default;
    CopyProbe<CopyableOwner> j = default;
    passed += Test("is_copyable(int)", a.copyable(), 1);
    passed += Test("is_copyable(Res*)", b.copyable(), 1);
    passed += Test("is_copyable(unique Res*)", c.copyable(), 1);
    passed += Test("is_copyable(string)", e.copyable(), 1);
    passed += Test("is_copyable(IShape)", f.copyable(), 1);
    passed += Test("is_copyable(Val)", g.copyable(), 1);
    passed += Test("is_copyable(NonCopyable)", h.copyable(), 0);
    passed += Test("is_copyable(NestedNonCopyable)", i.copyable(), 0);
    passed += Test("is_copyable(CopyableOwner)", j.copyable(), 1);
    return passed;
}

// insert(index, value): shifting must not copy, destruct or drop an element, so a
// `unique` element list is the real test - the ids must survive the shift and be freed once.
int testInsert()
{
    int passed = 0;
    g_dtor = 0;
    list<int> li = default;
    li.add(1); li.add(3);
    li.insert(1, 2);            // middle
    li.insert(0, 0);            // front
    li.insert(4, 4);            // index == count() appends
    passed += Test("insert<int> count", li.count(), 5);
    passed += Test("insert<int> front", li[0], 0);
    passed += Test("insert<int> middle", li[2], 2);
    passed += Test("insert<int> end", li[4], 4);

    list<int> empty = default;
    empty.insert(0, 9);
    passed += Test("insert into empty list", empty[0], 9);

    list<string> ls = default;
    ls.add("b");
    ls.insert(0, "a");
    passed += Test("insert<string> front", ls[0], "a");
    passed += Test("insert<string> shifted", ls[1], "b");

    {
        list<unique Res*> lu = default;
        lu.add(new Res(1));
        lu.add(new Res(3));
        lu.insert(1, new Res(2));
        passed += Test("insert<unique T*> shifted element survives", lu[2].id, 3);
        passed += Test("insert<unique T*> inserted element", lu[1].id, 2);
        passed += Test("insert<unique T*> shift frees nothing", g_dtor, 0);
    }
    passed += Test("insert<unique T*> owns each element once", g_dtor, 3);
    return passed;
}

// --- add-site rule: an owning local needs `move` -----------------------------------
//
// A bare `list<T*>` neither owns nor frees its elements, so handing it a LIVE OWNING named
// local by borrow is rejected at the add (err_delete_borrowed_owned_element.cb pins the
// rejections). These are the shapes that must STAY accepted, each with its own free count.
int testAddSiteAcceptSet()
{
    int passed = 0;

    // Idiom F: the rvalue has no other handle, so the element IS the sole handle and the
    // manual free through get() is the one free.
    g_dtor = 0;
    {
        list<Res*> l = default;
        l.add(new Res(1));
        Res* o = l.get(0);
        passed += Test("add(rvalue) stored", o.id, 1);
        delete o;
    }
    passed += Test("add(rvalue) frees exactly once", g_dtor, 1);

    // `move` hands the sole handle to the container: the local is nulled, so the caller's
    // scope exit frees nothing and the manual free through get() is again the one free.
    g_dtor = 0;
    {
        list<Res*> l = default;
        Res* p = new Res(2);
        l.add(move p);
        Res* o = l.get(0);
        passed += Test("add(move p) stored", o.id, 2);
        delete o;
    }
    passed += Test("add(move p) frees exactly once", g_dtor, 1);

    // A borrowed PARAMETER is the caller's business - accepted (the filed residual).
    g_dtor = 0;
    {
        unique Res* p = new Res(3);
        list<Res*> l = default;
        addBorrowedParam(&l, p);
        passed += Test("add(borrowed param) stored", l[0].id, 3);
        passed += Test("add(borrowed param) frees nothing yet", g_dtor, 0);
    }
    passed += Test("add(borrowed param) owner frees once", g_dtor, 1);

    // An owning element with a DECLARED policy: `unique` on the container consumes the local
    // with no `move` keyword, and `move` is accepted there too.
    g_dtor = 0;
    {
        list<unique Res*> l = default;
        Res* p = new Res(4);
        l.add(p);
        unique Res* q = new Res(5);
        l.add(move q);
        passed += Test("unique element list count", l.count(), 2);
        passed += Test("unique element frees nothing yet", g_dtor, 0);
    }
    passed += Test("unique element list frees both", g_dtor, 2);

    // The same rule and the same `move` remedy on dictionary and queue.
    g_dtor = 0;
    {
        dictionary<int, Res*> d = default;
        Res* p = new Res(6);
        d.add(1, move p);
        Res* o = d.get(1);
        passed += Test("dictionary add(move p) stored", o.id, 6);
        delete o;
    }
    passed += Test("dictionary add(move p) frees exactly once", g_dtor, 1);

    g_dtor = 0;
    {
        queue<Res*> q = default;
        Res* p = new Res(7);
        q.enqueue(move p);
        Res* o = q.dequeue();
        passed += Test("queue enqueue(move p) stored", o.id, 7);
        delete o;
    }
    passed += Test("queue enqueue(move p) frees exactly once", g_dtor, 1);

    return passed;
}

// A USER-DEFINED container of the same name as a core one is none of the borrow rule's
// business: only a template DECLARED in a core library file carries the borrow semantics the
// add-site rule encodes. `stack<T>` here re-declares the core stack (stack.cb IS imported
// above), so this also exercises that the stale "core" origin marker left behind by the core
// registration gets erased when the user's global template overwrites it - otherwise the
// add-site rule would still see this as the core container. `mylib.list<T>` is a distinct
// namespaced template - both store a plain pointer and must accept a live owning local
// without a `move`.
class stack<T>
{
    T item = default;
    void push(T value) { item = value; }
    T peek() { return item; }
};

namespace mylib
{
    class list<T>
    {
        T item = default;
        void add(T value) { item = value; }
        T get() { return item; }
    };
}

int testUserDefinedContainersAccept()
{
    int passed = 0;

    g_dtor = 0;
    {
        stack<Res*> s = default;
        Res* p = new Res(11);
        s.push(p);
        passed += Test("user stack push(p) stored", s.peek().id, 11);
        delete p;
    }
    passed += Test("user stack push(p) frees exactly once", g_dtor, 1);

    g_dtor = 0;
    {
        mylib.list<Res*> l = default;
        Res* p = new Res(12);
        l.add(p);
        passed += Test("user namespaced list add(p) stored", l.get().id, 12);
        delete p;
    }
    passed += Test("user namespaced list add(p) frees exactly once", g_dtor, 1);

    return passed;
}

// The residual the rule deliberately accepts: inside this function the argument is a BORROWED
// parameter, so the add is legal here and the caller stays responsible for the object.
void addBorrowedParam(list<Res*>* l, Res* borrowed)
{
    l->add(borrowed);
}

extern int main()
{
    HeapAudit.enable();

    int passed = 0;
    int total  = 0;

    total += 8;  passed += testPrimitives();
    total += 9;  passed += testAliasLvalueSemantics();
    total += 16; passed += testAliasParameterBorrows();
    total += 12; passed += testAliasParameterTempsDestruct();
    total += 7;  passed += testAliasLvalueAssignDropsOldOwner();
    total += 5;  passed += testValueCopySemantics();
    total += 2;  passed += testStringCopySemantics();
    total += 1;  passed += testStringMoveSemantics();
    total += 12; passed += testStringTempFieldCopy();
    total += 8;  passed += testStringTempElementCopy();
    total += 4;  passed += testStringTempFieldBorrow();
    total += 5;  passed += testBarePointerBorrows();
    total += 4;  passed += testBorrowedPointerElementBorrows();
    total += 7;  passed += testAliasPointerElementBorrows();
    total += 3;  passed += testUniquePointerOwns();
    total += 2;  passed += testUniquePointerSetFreesOld();
    total += 3;  passed += testUniquePointerSelfAssign();
    total += 3;  passed += testUniquePointerReassignFreesOld();
    total += 3;  passed += testUniquePointerReassignNullDest();
    total += 3;  passed += testUniquePointerFieldStoreTransfers();
    total += 5;  passed += testBareInterfaceBorrows();
    total += 2;  passed += testUniqueInterfaceOwns();
    total += 3;  passed += testCopyValue();
    total += 5;  passed += testCopyBorrowedPointer();
    total += 7;  passed += testIListContract();
    total += 10; passed += testTake();
    total += 3;  passed += testImplicitMoveReturn();
    total += 3;  passed += testNonCopyableMoveOnly();
    total += 9;  passed += testIsCopyable();
    total += 7;  passed += testSort();
    total += 11; passed += testInsert();
    total += 14; passed += testAddSiteAcceptSet();
    total += 4;  passed += testUserDefinedContainersAccept();

    // Every ownership rule above is only meaningful if nothing leaked.
    int leaks = (int)HeapAudit.reportLeaks();
    total += 1;
    passed += Test("list no leaks across all cases", leaks, 0);

    printf("%d/%d tests passed.\n", passed, total);
    return passed == total ? 0 : 1;
}
