import "list.cb";
import "stack.cb";
import "queue.cb";
import "dictionary.cb";
import "test_helper.cb";

int dtorCount = 0;

struct Resource
{
    int id = 0;
    ~Resource()
    {
        dtorCount = dtorCount + 1;
    }
};

struct Container
{
    Resource* item = nullptr;

    void reset()
    {
        if (item != nullptr) { delete item; item = nullptr; }
    }

    ~Container()
    {
        if (item != nullptr)
            delete item;
    }
};

// `unique` field ownership: the compiler-synthesized destructor deletes the pointer,
// so this needs none of ~Container's hand-written free above.
struct UniqueBox
{
    unique Resource* item = nullptr;

    // Bare self-field assign inside a method. This carries no FieldName (it resolves through
    // GetMemberVariable), so the reassignment free is skipped by a runtime old-vs-new compare
    // rather than by name matching; without it this frees and then stores a dangling pointer.
    void selfAssignBare() { item = item; }
};

// `unique` composes with a hand-written destructor. The user dtor runs FIRST, so releasing
// the field early leaves the synthesized delete looking at nullptr - not a double free.
// Stage 2 note: this used to spell the release `delete item; item = nullptr;`. A hand-written
// delete of a `unique` field is now rejected outright (err_unique_delete_field) because the
// un-nulled form of it is a double-free, and it is no longer needed - assigning nullptr frees
// the pointee on its own, which is exactly what this exercises.
struct UniqueFreesItself
{
    unique Resource* item = nullptr;

    ~UniqueFreesItself()
    {
        item = nullptr;
    }
};

// Transitive: deleting the outer `unique` field runs UniqueBox's synthesized
// destructor, which in turn deletes its own `unique` field.
struct UniqueOuter
{
    unique UniqueBox* inner = nullptr;
};

/*
 * `unique` on an INTERFACE field. Ownership has to live in the contract: a store through the
 * interface's byte-offset slot is dispatched dynamically, so the concrete type is unknown and
 * the access site can only learn the slot is owning from the interface itself. Both sides must
 * agree - the two disagreements are rejected (err_unique_iface_field_impl_only /
 * err_unique_iface_field_iface_only). This is the field analogue of `push(move T item)`.
 */
interface IUniqueBox
{
    unique Resource* item;
    int tag();
};

class UniqueIfaceBox : IUniqueBox
{
    unique Resource* item = nullptr;
    int tag() { return 1; }
};

// Fixture for the cross-block `unique <interface>` deref regression below: a plain interface
// (no owning field), so its dtor is a no-op and does not perturb dtorCount.
interface IGuardBox { int tag(); };
class GuardBoxImpl : IGuardBox { int tag() { return 42; } };

// Returns false, but not as a compile-time-foldable literal: keeps the 'if' below a genuine
// runtime branch (not eliminated) for the cross-block interface regression.
int gGuardFlag = 0;
bool RuntimeFalse() { return gGuardFlag != 0; }

// A wrapper that never returns on ANY path. It carries no LLVM 'noreturn' attribute, so the
// moved-deref analysis has to PROVE it (nulldf::FunctionNeverReturns) for a `if (c) { dieNow(); }`
// guard to suppress. Never actually called - the guard below is behind RuntimeFalse().
void dieNow() { printf("unreachable handoff\n"); exit(1); }

// Reassign through the interface's field slot: the old pointee is freed here, not orphaned.
int storeViaIface(IUniqueBox h)
{
    h.item = new Resource();
    h.item->id = 21;
    return h.tag();
}

// `nullptr` through the interface slot is the same release-early idiom as on a direct field.
void releaseViaIface(IUniqueBox h)
{
    h.item = nullptr;
}

// Composite-ownership shape: 'Bag' owns its 'item' (a Resource*) and an array
// of 'RouteEntry' (each of which owns its own 'name' Resource*). Each layer's
// destructor frees only its own fields; cross-layer cleanup happens by chained
// destructor invocation ('delete[n] entries' calls ~RouteEntry on every slot).
struct RouteEntry
{
    Resource* name = nullptr;
    ~RouteEntry()
    {
        if (name != nullptr) delete name;
    }
};

struct Bag
{
    Resource*    item    = nullptr;
    RouteEntry*  entries = nullptr;

    ~Bag()
    {
        if (item != nullptr) delete item;
        if (entries != nullptr) delete[3] entries;
    }
};

// Worker-style payload: pointer to an external observer slot plus a value.
// Mirrors Test/repro_new_struct.cb but stays single-threaded so the test
// is hermetic. The caller hands the owning pointer to 'workerMove' which
// performs the side effect through ->slot, then ownership ends at the
// callee's scope exit - exactly the pattern repro_new_struct.cb needs.
struct Slot
{
    int* slot  = nullptr;
    int  value = 0;
    ~Slot()
    {
        dtorCount = dtorCount + 1;
    }
};

// Move param: side-effects through the pointer, never calls 'delete'.
// Ownership ends when the function returns (scope-exit cleanup frees it).
int workerMove(move Slot* s)
{
    *s->slot = s->value;
    return s->value;
}

// Move param with an explicit 'delete': proves that an in-body delete
// nulls the parameter's alloca so the scope-exit cleanup does not
// double-free. This is the safe analogue of the unsafe pattern in
// Test/errors/err_delete_borrowed_via_cast.cb.
int workerMoveDelete(move Slot* s)
{
    *s->slot = s->value;
    int v = s->value;
    delete s;
    return v;
}

// move parameter takes ownership - Resource is deleted when consume returns
void consume(move Resource* r)
{
    // use r inside the function
    int x = r->id;
}

// non-move parameter borrows - caller still owns
void borrow(Resource* r)
{
    int x = r->id;
}

// D4: a `unique` parameter is a synthesized move parameter - it takes ownership and
// frees the Resource when the function returns, exactly like `consume(move Resource*)`.
void sinkUnique(unique Resource* r)
{
    int x = r->id;
}

// Move/borrow overload pair: 'move' participates in mangling and overload selection.
// probe(move Resource*) returns 100 + id and takes ownership (deletes r).
// probe(Resource*)      returns 200 + id and borrows.
int probe(move Resource* r)
{
    int id = r->id;
    delete r;
    return 100 + id;
}

int probe(Resource* r)
{
    return 200 + r->id;
}

// Helper: r is a borrowed (non-move) parameter, so probe(r) must pick the borrow overload.
int delegateProbe(Resource* r)
{
    return probe(r);
}

// Helper for the explicit-move readable-as-null regression below: a plain read/pass of a
// moved-out pointer (no dereference) must stay legal, so this only compares against nullptr.
int isNullResource(Resource* r)
{
    return r == nullptr ? 1 : 0;
}

// Helper for the address-escape cross-block regression below: rewrites *slot through an
// escaped address, exercising the AddressEscaped latch on the caller's moved-out local.
void refillResource(Resource** slot, int id)
{
    *slot = new Resource();
    (*slot)->id = id;
}

// move T* return type - ownership propagates to caller
move Resource* createResource(int id)
{
    Resource* r = new Resource();
    r->id = id;
    return r;
}

move Resource* forwardResource(move Resource* r)
{
    return r;
}

// ── list<string> helpers ──────────────────────────────────────────────────────
// Passing list<string> value/pointer as a free-function parameter is a known
// limitation; these helpers operate on extracted string values instead.

string echoString(string s)
{
    return s;
}

// Two-hop relay: string passes through two function calls
string relayString(string s)
{
    return echoString(s);
}

// Three-hop relay
string relayStringDeep(string s)
{
    return relayString(s);
}

int testListStringMove()
{
    int passed = 0;

    // Basic list<string> operations: add, count, get
    {
        list<string> words;
        string a = "" + "apple";
        string b = "" + "banana";
        string c = "" + "cherry";
        words.add(a);
        words.add(b);
        words.add(c);
        passed += Test("list_string_count", words.count(), 3);
        passed += Test("list_string_get0",  words.get(0), "apple");
        passed += Test("list_string_get1",  words.get(1), "banana");
        passed += Test("list_string_get2",  words.get(2), "cherry");
    }

    // removeAt: verify element is removed and count updates
    {
        list<string> words;
        string a = "" + "first";
        string b = "" + "second";
        string c = "" + "third";
        words.add(a);
        words.add(b);
        words.add(c);
        words.removeAt(1);
        passed += Test("list_string_remove_count", words.count(), 2);
        passed += Test("list_string_remove_get0",  words.get(0), "first");
        passed += Test("list_string_remove_get1",  words.get(1), "third");
    }

    // Strings extracted from list survive passing through function calls
    // (regression: string values were corrupted when passed across functions)
    {
        list<string> words;
        string w1 = "" + "hello";
        string w2 = "" + "world";
        words.add(w1);
        words.add(w2);

        string r1 = echoString(words.get(0));     // one hop
        string r2 = relayString(words.get(1));    // two hops
        string r3 = relayStringDeep(words.get(0)); // three hops
        passed += Test("list_string_one_hop",   r1, "hello");
        passed += Test("list_string_two_hop",   r2, "world");
        passed += Test("list_string_three_hop", r3, "hello");
    }

    return passed;
}

// ── recursive owning-pointer-tree free (X4 Part 2 regression) ─────────────────
// Passing a FIELD (node->left / node->right) to a 'move' parameter must mark only
// that field as moved, not the whole base 'node' - otherwise the second field
// access is wrongly rejected as "use of moved variable 'node'". This is the
// canonical Huffman/AST shape: a recursive free over an owning pointer tree.
struct TreeNode
{
    TreeNode* left  = nullptr;
    TreeNode* right = nullptr;
    ~TreeNode()
    {
        dtorCount = dtorCount + 1;
    }
};

void freeTree(move TreeNode* node)
{
    if (node == nullptr) return;
    freeTree(node->left);    // moving node->left must NOT poison node ...
    freeTree(node->right);   // ... so this line still compiles.
    delete node;
}

int testRecursiveTreeFree()
{
    int passed = 0;

    // 3-level full binary tree: 1 root + 2 children + 4 grandchildren = 7 nodes.
    dtorCount = 0;
    {
        TreeNode* root = new TreeNode();
        root->left  = new TreeNode();
        root->right = new TreeNode();
        root->left->left   = new TreeNode();
        root->left->right  = new TreeNode();
        root->right->left  = new TreeNode();
        root->right->right = new TreeNode();
        freeTree(root);
        // root is moved into freeTree; scope exit is a no-op. Every node freed once.
    }
    passed += Test("recursive_tree_free_all_freed_once", dtorCount, 7);

    return passed;
}

// A destructor that recursively deletes its own children. Leaf children are null,
// so 'delete left'/'delete right' must treat a null pointer as a no-op rather than
// invoking the destructor on null (which would dereference null and crash).
struct CascadeNode
{
    CascadeNode* left  = nullptr;
    CascadeNode* right = nullptr;
    ~CascadeNode()
    {
        dtorCount = dtorCount + 1;
        delete left;    // null on leaves: delete must be a safe no-op
        delete right;
    }
};

int testDeleteNullCascade()
{
    int passed = 0;

    // root + 2 children; grandchildren are null. 'delete root' cascades through the
    // destructor, hitting 'delete nullptr' on every leaf. All three freed once, no crash.
    dtorCount = 0;
    {
        CascadeNode* root = new CascadeNode();
        root->left  = new CascadeNode();
        root->right = new CascadeNode();
        delete root;
    }
    passed += Test("delete_null_cascade_frees_all", dtorCount, 3);

    return passed;
}

// Recursive container: a node owns its children in a `list<TreeBox*>` field. Because
// TreeBox's own field forces `list<TreeBox*>` to be monomorphized while TreeBox is still
// incomplete, the generic list destructor used to bind its element `delete` to a null
// destructor and leak the entire subtree. The deferred delete-site destructor fix makes
// `~list<TreeBox*>` free each element (recursing through this destructor).
struct TreeBox
{
    int id = 0;
    list<unique TreeBox*> children = default;
    ~TreeBox()
    {
        dtorCount = dtorCount + 1;
    }
};

int testRecursiveContainerFree()
{
    int passed = 0;

    // 3-deep chain held through list<TreeBox*> fields: root -> child -> grandchild.
    // When 'roots' goes out of scope, ~list frees root; ~TreeBox destructs root.children,
    // which frees child; and so on. All three freed exactly once.
    dtorCount = 0;
    {
        list<unique TreeBox*> roots;
        TreeBox* root  = new TreeBox(); root->id  = 1;
        TreeBox* child = new TreeBox(); child->id = 2;
        TreeBox* grand = new TreeBox(); grand->id = 3;
        child->children.add(grand);
        root->children.add(child);
        roots.add(root);
    }
    passed += Test("recursive_container_frees_all", dtorCount, 3);

    return passed;
}

// Same self-referential-element hazard as TreeBox, applied to dictionary/stack/queue
// teardown and to list's other non-dtor release paths (clear/removeAt). Each element
// struct monomorphizes its own container field while the struct is still incomplete.
struct DictNode
{
    int id = 0;
    dictionary<int, unique DictNode*> kids = default;
    ~DictNode()
    {
        dtorCount = dtorCount + 1;
    }
};

struct StkNode
{
    int id = 0;
    stack<unique StkNode*> kids = default;
    ~StkNode()
    {
        dtorCount = dtorCount + 1;
    }
};

struct QueNode
{
    int id = 0;
    queue<unique QueNode*> kids = default;
    ~QueNode()
    {
        dtorCount = dtorCount + 1;
    }
};

int testSelfRefContainerRelease()
{
    int passed = 0;

    // dictionary teardown: scope exit frees the whole root -> child -> grand chain.
    dtorCount = 0;
    {
        dictionary<int, unique DictNode*> roots;
        DictNode* root  = new DictNode(); root->id  = 1;
        DictNode* child = new DictNode(); child->id = 2;
        DictNode* grand = new DictNode(); grand->id = 3;
        child->kids.set(0, grand);
        root->kids.set(0, child);
        roots.set(0, root);
    }
    passed += Test("dict_selfref_dtor_frees_all", dtorCount, 3);

    // dictionary remove(): the removed entry's subtree is freed immediately, before scope exit.
    dtorCount = 0;
    {
        dictionary<int, unique DictNode*> roots;
        DictNode* root  = new DictNode(); root->id  = 1;
        DictNode* child = new DictNode(); child->id = 2;
        DictNode* grand = new DictNode(); grand->id = 3;
        child->kids.set(0, grand);
        root->kids.set(0, child);
        roots.set(0, root);
        roots.remove(0);
        passed += Test("dict_selfref_remove_frees_all", dtorCount, 3);
    }

    // stack teardown: scope exit frees the whole chain.
    dtorCount = 0;
    {
        stack<unique StkNode*> roots;
        StkNode* root  = new StkNode(); root->id  = 1;
        StkNode* child = new StkNode(); child->id = 2;
        StkNode* grand = new StkNode(); grand->id = 3;
        child->kids.push(grand);
        root->kids.push(child);
        roots.push(root);
    }
    passed += Test("stack_selfref_dtor_frees_all", dtorCount, 3);

    // queue teardown: scope exit frees the whole chain.
    dtorCount = 0;
    {
        queue<unique QueNode*> roots;
        QueNode* root  = new QueNode(); root->id  = 1;
        QueNode* child = new QueNode(); child->id = 2;
        QueNode* grand = new QueNode(); grand->id = 3;
        child->kids.enqueue(grand);
        root->kids.enqueue(child);
        roots.enqueue(root);
    }
    passed += Test("queue_selfref_dtor_frees_all", dtorCount, 3);

    // list clear(): the whole chain is freed immediately, before scope exit.
    dtorCount = 0;
    {
        list<unique TreeBox*> roots;
        TreeBox* root  = new TreeBox(); root->id  = 1;
        TreeBox* child = new TreeBox(); child->id = 2;
        TreeBox* grand = new TreeBox(); grand->id = 3;
        child->children.add(grand);
        root->children.add(child);
        roots.add(root);
        roots.clear();
        passed += Test("list_selfref_clear_frees_all", dtorCount, 3);
    }

    // list removeAt(0): same shape, freed via removeAt instead of clear().
    dtorCount = 0;
    {
        list<unique TreeBox*> roots;
        TreeBox* root  = new TreeBox(); root->id  = 1;
        TreeBox* child = new TreeBox(); child->id = 2;
        TreeBox* grand = new TreeBox(); grand->id = 3;
        child->children.add(grand);
        root->children.add(child);
        roots.add(root);
        roots.removeAt(0);
        passed += Test("list_selfref_removeat_frees_all", dtorCount, 3);
    }

    return passed;
}

int testUniqueField()
{
    int passed = 0;

    // The synthesized destructor frees the `unique` field - UniqueBox has no user dtor.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
    }
    passed += Test("unique_field_freed_by_synth_dtor", dtorCount, 1);

    // A `unique` field left null is skipped by the null check, not freed.
    dtorCount = 0;
    {
        UniqueBox b;
    }
    passed += Test("unique_null_field_not_freed", dtorCount, 0);

    // Stage 2 - the user dtor's `item = nullptr` frees it, leaving the synthesized delete
    // a no-op: composition without a double free.
    dtorCount = 0;
    {
        UniqueFreesItself u;
        u.item = new Resource();
    }
    passed += Test("unique_composes_with_user_dtor", dtorCount, 1);

    // Outer deletes inner; inner's synthesized dtor deletes its own `unique` field.
    dtorCount = 0;
    {
        UniqueOuter o;
        o.inner = new UniqueBox();
        o.inner->item = new Resource();
    }
    passed += Test("unique_transitive_chain_freed", dtorCount, 1);

    // Heap-owned struct: `delete` routes through the synthesized full destructor.
    dtorCount = 0;
    {
        UniqueBox* hb = new UniqueBox();
        hb->item = new Resource();
        delete hb;
        passed += Test("unique_field_freed_on_delete", dtorCount, 1);
    }
    passed += Test("unique_no_double_free_after_delete", dtorCount, 1);

    // Brace-init is a second field-store path (EmitOneFieldInit): storing an owning local into a
    // `unique` field must transfer ownership exactly as `=` does, or BOTH the local's scope-exit
    // cleanup and the field's synthesized destructor free the one pointee (a double free).
    dtorCount = 0;
    {
        Resource* r = new Resource();
        UniqueBox b = { item = r };
        passed += Test("unique_brace_init_alive_before_teardown", dtorCount, 0);
    }
    passed += Test("unique_brace_init_owning_local_freed_once", dtorCount, 1);

    // Stage 2 - reassignment destructs first: overwriting a live `unique` field frees the
    // old pointee rather than orphaning it. 3 stores => 2 freed on reassign, 1 at teardown.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item = new Resource();
        b.item = new Resource();
        passed += Test("unique_reassign_frees_old", dtorCount, 2);
    }
    passed += Test("unique_reassign_last_freed_at_teardown", dtorCount, 3);

    // Stage 2 - assigning nullptr releases the pointee early (the sanctioned idiom, and the
    // reason a hand-written `delete` on a unique field is both unnecessary and rejected).
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item = nullptr;
        passed += Test("unique_nullptr_releases_early", dtorCount, 1);
    }
    passed += Test("unique_nullptr_release_no_double_free", dtorCount, 1);

    // Stage 2 - self-assign must not free-then-store a dangling pointer.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item = b.item;
        passed += Test("unique_self_assign_does_not_free", dtorCount, 0);
    }
    passed += Test("unique_self_assign_freed_once_at_teardown", dtorCount, 1);

    // Stage 2 - same, spelled bare inside a method (no FieldName to match on).
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.selfAssignBare();
        passed += Test("unique_bare_self_assign_does_not_free", dtorCount, 0);
    }
    passed += Test("unique_bare_self_assign_freed_once_at_teardown", dtorCount, 1);

    // Stage 2 - `move` transfers ownership into a unique field (the accepted spelling of
    // the borrow that err_unique_borrow_into_field rejects). Freed once, by the field.
    dtorCount = 0;
    {
        UniqueBox b;
        Resource* fresh = new Resource();
        b.item = move fresh;
        passed += Test("unique_move_into_field_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_move_into_field_freed_once", dtorCount, 1);

    // Stage 3 (Trap B) - `move` OUT of a unique field is the sanctioned extraction: it nulls
    // the field, so the local owns the pointee and the synthesized dtor finds nothing to free.
    // This is the counterpart to err_unique_delete_alias, where a plain copy is rejected.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item->id = 7;
        Resource* owned = move b.item;
        passed += Test("unique_move_out_field_id_intact", owned->id, 7);
        passed += Test("unique_move_out_field_not_freed_yet", dtorCount, 0);
        delete owned;
        passed += Test("unique_move_out_field_freed_by_local", dtorCount, 1);
        // Scope exit: the field was nulled by the move, so the synthesized delete is a no-op.
    }
    passed += Test("unique_move_out_field_no_double_free", dtorCount, 1);

    // Stage 3 (Trap B) - a local aliasing a `unique` field is a borrow, not an owner: reading
    // and writing THROUGH it stays legal, and it is the field that frees, exactly once. Only
    // `delete alias` is rejected.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        Resource* alias = b.item;
        alias->id = 42;
        passed += Test("unique_alias_read_through", b.item->id, 42);
        passed += Test("unique_alias_borrow_does_not_free", dtorCount, 0);
    }
    passed += Test("unique_alias_freed_once_by_field", dtorCount, 1);

    // Stage 3 (Trap B) - the borrow marking must not leak into an ordinary pointer field:
    // `Container.item` is not `unique`, so laundering it through a local and deleting the
    // local stays legal (the ~254 unmarked pointer fields keep today's semantics exactly).
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
        Resource* a = c.item;
        delete a;
        c.item = nullptr;   // ~Container would otherwise free the same pointer
        passed += Test("plain_field_alias_delete_still_legal", dtorCount, 1);
    }
    passed += Test("plain_field_alias_delete_freed_once", dtorCount, 1);

    // Brace-init is a second, independent field-store path (EmitOneFieldInit). A fresh
    // allocation through it is owned by the field and freed exactly once at teardown - the
    // borrow spelling is rejected (err_unique_brace_init_borrow).
    dtorCount = 0;
    {
        UniqueBox b = { item = new Resource() };
        b.item->id = 5;
        passed += Test("unique_brace_init_fresh_id", b.item->id, 5);
        passed += Test("unique_brace_init_fresh_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_brace_init_fresh_freed_once", dtorCount, 1);

    // Brace-init with an explicit `move`: ownership transfers to the field, which frees once.
    dtorCount = 0;
    {
        Resource* fresh = new Resource();
        UniqueBox b = { item = move fresh };
        passed += Test("unique_brace_init_move_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_brace_init_move_freed_once", dtorCount, 1);

    // The brace-init guards are keyed on `unique`, so an ORDINARY pointer field brace-initialized
    // from a borrow is untouched - it stores the borrow and frees nothing, exactly as before.
    dtorCount = 0;
    {
        Resource* owned = new Resource();
        owned->id = 11;
        {
            Container c = { item = owned };
            passed += Test("plain_brace_init_borrow_reads_through", c.item->id, 11);
            c.item = nullptr;   // ~Container would otherwise free the borrow
        }
        passed += Test("plain_brace_init_borrow_not_freed_by_field", dtorCount, 0);
        delete owned;
        passed += Test("plain_brace_init_borrow_freed_by_owner", dtorCount, 1);
    }

    // `move` between two `unique` fields is the sanctioned transfer: it nulls the source, so
    // only the destination frees. The plain copy `c.item = a.item` is rejected
    // (err_unique_field_to_field) precisely because it would leave both fields owning.
    dtorCount = 0;
    {
        UniqueBox a;
        UniqueBox c;
        a.item = new Resource();
        a.item->id = 13;
        c.item = move a.item;
        passed += Test("unique_field_to_field_move_id_intact", c.item->id, 13);
        passed += Test("unique_field_to_field_move_source_nulled", a.item == nullptr ? 1 : 0, 1);
        passed += Test("unique_field_to_field_move_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_field_to_field_move_freed_once", dtorCount, 1);

    // Explicit 'move' of a whole thin `unique` pointer LOCAL (not a field): the source is nulled
    // but, by design, stays plain-readable - only a SAME-BLOCK DEREFERENCE of it is a compile
    // error (see Test/errors/err_move.cb's dereference-of-explicitly-moved-pointer legs). Covers
    // a nullptr comparison, passing it to a function, and comparing it as an int - none of these
    // are dereferences, so all must still compile and run correctly.
    dtorCount = 0;
    {
        unique Resource* p = new Resource();
        p->id = 7;
        unique Resource* q = move p;
        passed += Test("explicit_move_local_dest_intact", q->id, 7);
        passed += Test("explicit_move_local_source_nulled", p == nullptr ? 1 : 0, 1);
        passed += Test("explicit_move_local_source_pass_to_function", isNullResource(p), 1);
        passed += Test("explicit_move_local_source_compare_as_int", (int)(p == nullptr), 1);
        passed += Test("explicit_move_local_not_freed_early", dtorCount, 0);

        // Reassigning the moved-out source makes it live again: a subsequent DEREFERENCE
        // must compile and run correctly (the deref guard only fires while still moved-null).
        p = new Resource();
        p->id = 9;
        passed += Test("explicit_move_local_reassign_then_deref", p->id, 9);
    }
    passed += Test("explicit_move_local_freed_once_each", dtorCount, 2);

    // Cross-block positive legs: neither the same-block predicate nor the MAY-null fixpoint may
    // fire on these (see internal/issue/deref-of-moved-pointer-guard-inside-callee.md):
    dtorCount = 0;
    {
        // F1 shape: a null-guarded deref in a DIFFERENT block from the move (an 'if', which
        // actually branches - unlike '?:', which lowers to an eager select in the SAME block
        // and so is NOT covered; see the ternary caveat in the issue file). The move's block-id
        // latch means the guard cannot see this, so it must compile and run correctly.
        unique Resource* g = new Resource();
        g->id = 11;
        unique Resource* g2 = move g;
        int guarded = -1;
        if (g != nullptr) { guarded = g->id; }
        passed += Test("cross_block_null_guarded_deref", guarded, -1);

        // F2 shape: the address of a moved-out local escapes to an out-parameter that may
        // rewrite it; a later deref must compile and run correctly (AddressEscaped latch).
        unique Resource* h = new Resource();
        unique Resource* h2 = move h;
        refillResource(&h, 13);
        passed += Test("address_escape_then_deref", h->id, 13);

        // F3 shape: move happens only inside one conditional arm (decl-init, not a reassignment -
        // reassigning a previously-nullptr `unique` local via 'move' is a separate, pre-existing
        // ownership-tracking gap, out of scope here and not exercised by this regression); a
        // GUARDED deref after the branch merges must compile and run correctly (the same-block
        // predicate never sees the branch's block). Uses 'if', not '?:' - see the ternary caveat
        // above: '?:' lowers to an eager select that evaluates BOTH arms unconditionally, so a
        // ternary-guarded deref of a pointer that is null in the untaken arm crashes regardless
        // of this fix (also pre-existing, also out of scope).
        unique Resource* k = new Resource();
        k->id = 17;
        if (k != nullptr) { unique Resource* k2 = move k; }
        int afterBranch = -1;
        if (k != nullptr) { afterBranch = k->id; }
        passed += Test("cross_block_conditional_move_then_deref", afterBranch, -1);

        // F3 shape, `unique <interface>` local: a moved interface local is nulled but plain-
        // readable, exactly like a moved thin pointer, so the same null-check escape hatch
        // applies. The GUARDED deref after the conditional move must compile and run correctly;
        // the unguarded form is a compile error (err_move.cb).
        unique IGuardBox ig = new GuardBoxImpl();
        if (RuntimeFalse()) { unique IGuardBox ig2 = move ig; }
        int ifaceGuarded = -1;
        if (ig != nullptr) { ifaceGuarded = ig.tag(); }
        passed += Test("cross_block_conditional_move_then_deref_interface", ifaceGuarded, 42);
    }
    passed += Test("cross_block_legs_no_leak", dtorCount, 4);

    // Guard legs for the cross-block moved-deref analysis. Every leg below dereferences a local
    // that IS maybe-moved on the merged path, but under a guard - so the deref sits inside a
    // branch the move was not under, and the control-dependence rule must suppress it. A
    // regression shows up here as a COMPILE ERROR, not as a wrong value.
    dtorCount = 0;
    {
        unique Resource* n1 = new Resource();
        n1->id = 19;
        if (RuntimeFalse()) { unique Resource* n1b = move n1; }
        int narrowed = -1;
        if (n1 == nullptr) { narrowed = -2; } else { narrowed = n1->id; }
        passed += Test("cross_block_else_branch_narrowing", narrowed, 19);

        // The guard is the loop's own condition, which reads the pointer - the read alone
        // suppresses, and the body may dereference even though it moves the local out.
        unique Resource* n2 = new Resource();
        n2->id = 23;
        int loopSeen = 0;
        while (n2 != nullptr)
        {
            loopSeen = n2->id;
            unique Resource* n2b = move n2;
        }
        passed += Test("loop_condition_narrowing_then_deref", loopSeen, 23);

        // A guarded move followed by a guarded deref: the deref's branch is not one the move
        // was under, so it is suppressed.
        unique Resource* n3 = new Resource();
        n3->id = 29;
        if (n3 != nullptr) { unique Resource* n3b = move n3; }
        int afterGuardedMove = -1;
        if (n3 != nullptr) { afterGuardedMove = n3->id; }
        passed += Test("guarded_move_then_guarded_deref", afterGuardedMove, -1);

        // The `x == nullptr` repair guard with NO else. The merge block is NOT control-dependent
        // on that branch, so this leg is carried by the read-kill: forming the guard reads the
        // pointer, and a read between the move and the deref suppresses the report.
        unique Resource* n4 = new Resource();
        n4->id = 31;
        if (RuntimeFalse()) { unique Resource* n4b = move n4; }
        if (n4 == nullptr) { n4 = new Resource(); n4->id = 37; }
        passed += Test("repair_guard_narrowing_then_deref", n4->id, 31);

        // Short-circuit '&&' OUTSIDE a branch condition (here an initializer). The RHS block is
        // control-dependent on the LHS test, and the LHS reads the pointer - suppressed twice
        // over, with no special-casing of '&&' anywhere in the compiler.
        unique Resource* n5 = new Resource();
        n5->id = 41;
        if (RuntimeFalse()) { unique Resource* n5b = move n5; }
        bool shortCircuit = n5 != nullptr && n5->id == 41;
        passed += Test("short_circuit_and_outside_condition", shortCircuit ? 1 : 0, 1);

        // The null guard hoisted into a bool local. No alias tracking is involved: the deref
        // simply sits inside `if (live)`, a branch the move was not under.
        unique Resource* n6 = new Resource();
        n6->id = 43;
        if (RuntimeFalse()) { unique Resource* n6b = move n6; }
        bool live = n6 != nullptr;
        int viaBool = -1;
        if (live) { viaBool = n6->id; }
        passed += Test("bool_alias_guard_narrowing", viaBool, 43);

        // The same through the opposite polarity, with the deref in the else arm.
        unique Resource* n7 = new Resource();
        n7->id = 47;
        if (RuntimeFalse()) { unique Resource* n7b = move n7; }
        bool gone = n7 == nullptr;
        int viaNegBool = -1;
        if (gone) { viaNegBool = -2; } else { viaNegBool = n7->id; }
        passed += Test("bool_alias_negated_guard_narrowing", viaNegBool, 47);

        // An INDIRECT guard bool: the null test happens inside a helper, so nothing about the
        // guard is interpretable - which is exactly the point, the rule never interprets it.
        unique Resource* n8 = new Resource();
        n8->id = 53;
        if (RuntimeFalse()) { unique Resource* n8b = move n8; }
        bool present = isNullResource(n8) == 0;
        int viaHelper = -1;
        if (present) { viaHelper = n8->id; }
        passed += Test("indirect_bool_guard_narrowing", viaHelper, 53);

        // The correlated-scrutinee guard: the move and the deref are guarded by two conditions on
        // the SAME unrelated value, and the pointer is never mentioned in either. No amount of
        // guard recognition can see this one - only the fact that the deref sits under a branch
        // the move was not under. This is the shape that defeats every read-based rule.
        int sel = RuntimeFalse() ? 200 : 1;
        unique Resource* n9 = new Resource();
        n9->id = 59;
        if (sel > 100) { unique Resource* n9b = move n9; }
        int viaCorrelated = -1;
        if (sel <= 100) { viaCorrelated = n9->id; }
        passed += Test("correlated_scrutinee_guard", viaCorrelated, 59);

        // A TERMINATING guard rather than a skipping one: the branch does not step around the
        // deref, it ends the process. Control dependence alone cannot see that (the deref still
        // post-dominates the branch), so ComputePostDominators has to treat an exit()/abort()
        // block as an end of the program. The exit is never reached at runtime here - the point
        // of the leg is that it COMPILES.
        unique Resource* n10 = new Resource();
        n10->id = 61;
        bool handedOff = false;
        if (RuntimeFalse()) { unique Resource* n10b = move n10; handedOff = true; }
        if (handedOff) { printf("unreachable handoff\n"); exit(1); }
        passed += Test("terminating_guard_then_deref", n10->id, 61);

        // Same terminating guard, but routed through a wrapper instead of a literal exit() call.
        // Suppression here depends on the wrapper having been PROVEN never-returning when its
        // body completed, which is why dieNow is defined above this function and not below it.
        unique Resource* n11 = new Resource();
        n11->id = 67;
        bool handedOff2 = false;
        if (RuntimeFalse()) { unique Resource* n11b = move n11; handedOff2 = true; }
        if (handedOff2) { dieNow(); }
        passed += Test("terminating_wrapper_guard_then_deref", n11->id, 67);
    }
    passed += Test("guard_legs_no_leak", dtorCount, 11);

    // A `unique` field reached through an interface's byte-offset slot gets the same store-site
    // guards as a direct field read: the flag rides the interface's field declaration, which the
    // access site binds from. Reassigning through the slot frees the old pointee.
    dtorCount = 0;
    {
        UniqueIfaceBox b;
        b.item = new Resource();
        storeViaIface(b);
        passed += Test("unique_iface_slot_reassign_frees_old", dtorCount, 1);
        passed += Test("unique_iface_slot_reassign_writes_same_slot", b.item->id, 21);
    }
    passed += Test("unique_iface_slot_reassign_freed_at_teardown", dtorCount, 2);

    // Releasing early through the interface slot frees once, and leaves the synthesized
    // destructor looking at nullptr rather than double-freeing.
    dtorCount = 0;
    {
        UniqueIfaceBox b;
        b.item = new Resource();
        releaseViaIface(b);
        passed += Test("unique_iface_slot_nullptr_releases_early", dtorCount, 1);
    }
    passed += Test("unique_iface_slot_release_no_double_free", dtorCount, 1);

    return passed;
}

int testFieldOwnership()
{
    int passed = 0;

    // Destructor frees its own field exactly once.
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
    }
    passed += Test("dtor_frees_own_field", dtorCount, 1);

    // Member method frees the field; destructor sees nullptr and does nothing.
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
        c.reset();
        passed += Test("method_reset_freed", dtorCount, 1);
        // Scope exit: ~Container runs; c.item == nullptr so no second free.
    }
    passed += Test("no_double_free_after_reset", dtorCount, 1);

    // External code extracts the field via 'move' and frees the local. The
    // owner's field is nulled by the move, so its destructor is a no-op.
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
        {
            Resource* taken = move c.item;
            passed += Test("field_nulled_after_move", c.item == nullptr, true);
            delete taken;
        }
        passed += Test("move_then_delete_frees_once", dtorCount, 1);
        // Scope exit: ~Container runs; c.item == nullptr so dtorCount stays 1.
    }
    passed += Test("owner_dtor_skips_moved_field", dtorCount, 1);

    // Move from a heap-owned container pointer works the same way.
    dtorCount = 0;
    {
        Container* hc = new Container();
        hc->item = new Resource();
        Resource* taken = move hc->item;
        delete taken;
        delete hc;
    }
    passed += Test("move_from_heap_container", dtorCount, 1);

    return passed;
}

// ── owning-string by-value param stored into a field (param -> field regression) ──────
// A factory that stores a plain (non-move) by-value `string` parameter into a struct field
// must give the field an INDEPENDENT owned buffer. The argument is typically an owning concat
// temp that the CALLER frees at its end-of-statement cleanup; a shallow store would alias that
// buffer into the field, leaving it dangling - and silently corrupted once a later allocation
// reuses the freed block - after the factory returns. (A true move is impossible from the
// callee, so the param -> field store deep-copies.)
struct Labelled
{
    string label = default;
};

Labelled* makeLabelled(string s)
{
    Labelled* n = new Labelled();
    n.label = s;            // plain by-value param -> field: must deep-copy, not alias
    return n;
}

int testParamStringToField()
{
    int bad = 0;
    for (int i = 0; i < 1000; i++)
    {
        // Owning concat temp as the argument; the caller frees it after makeLabelled returns.
        Labelled* n = makeLabelled("item-" + i.toString());
        // A subsequent string allocation reuses the block freed if ownership leaked.
        string churn = "blah-" + i.toString() + "-padding-padding-padding";
        string want = "item-" + i.toString();
        if (n.label.indexOf(want) != 0) { bad = bad + 1; }
        delete n;           // ~Labelled frees the owned field copy exactly once
    }
    int passed = 0;
    passed += Test("param_string_to_field_survives", bad, 0);
    return passed;
}

// ── borrowed owning-string field read into a local (field -> local regression) ────────
// `string snap = obj.method()` (a plain method returning a field) and `string snap = obj.field`
// (a direct field read) both bind a non-owning BORROW of the field's buffer. A later store to
// the same field frees that buffer, so the local must hold an INDEPENDENT owned copy to survive
// (and so a heap object can be deleted while a snapshot is still live). Regression: before the
// fix the local aliased the field buffer and read garbage after a reassignment, and corrupted
// the heap on delete (a non-heap/pool pointer got freed).
class LabelHolder
{
    string lbl = default;
    string label() { return lbl; }
    void setLabel(string s) { lbl = s; }
};

interface ILabel
{
    string label();
    void setLabel(string s);
};

class HeapLabel : ILabel
{
    string lbl = default;
    string label() { return lbl; }
    void setLabel(string s) { lbl = s; }
    ~HeapLabel() { }
};

int testBorrowStringFieldIntoLocal()
{
    int passed = 0;

    // A method return is a BORROW of the field, so an independent snapshot needs `.copy()`;
    // it then survives a later setter store to the same field.
    {
        LabelHolder p;
        p.setLabel("final");
        string snap = p.label().copy();
        p.setLabel("changed");
        passed += Test("borrow_field_method_read_survives", snap, "final");
    }

    // Snapshot taken via a direct field read survives a later setter store.
    {
        LabelHolder q;
        q.setLabel("final");
        string snapQ = q.lbl;
        q.setLabel("changed");
        passed += Test("borrow_field_direct_read_survives", snapQ, "final");
    }

    // Heap object via an interface: a `.copy()` snapshot survives delete (no crash, no corruption);
    // the field's owned buffer is freed exactly once by the destructor on delete.
    {
        ILabel b = new HeapLabel();
        b.setLabel("final");
        string snap = b.label().copy();
        b.setLabel("changed");
        delete b;
        passed += Test("borrow_field_heap_snapshot_after_delete", snap, "final");
    }

    return passed;
}

// ── THE FLIP: copyable owners COPY on assign (Part 4) ─────────────────────────────────
// A copyable owner (string, list<T>) assigned from a NAMED source COPIES an independent
// duplicate and leaves the source LIVE - the opposite of the old move-on-assign. Mutating
// one side must not disturb the other. Covers every flipped site: decl-init, local reassign,
// field-to-field, owned-local-into-field, plain container store, and brace-init.
struct FlipRow  { string name = default; };
struct FlipBag  { list<int> xs = default; };

int testCopyOnAssignFlip()
{
    int passed = 0;

    // decl-init copy: source string stays live and independent of the copy.
    {
        string a = "he" + "llo";
        string b = a;
        b = b + "!";
        passed += Test("flip_declinit_string_src_live", a, "hello");
        passed += Test("flip_declinit_string_copy_indep", b, "hello!");
    }

    // local reassign copy: list source stays live; growing the copy does not grow the source.
    {
        list<int> xs = default; xs.add(1); xs.add(2);
        list<int> ys = default;
        ys = xs;
        ys.add(3);
        passed += Test("flip_reassign_list_src_count", xs.count(), 2);
        passed += Test("flip_reassign_list_copy_count", ys.count(), 3);
    }

    // field-to-field string copy: independent buffers.
    {
        FlipRow r1 = default; r1.name = ("wor" + "ld");
        FlipRow r2 = default;
        r2.name = r1.name;
        r2.name = r2.name + "!";
        passed += Test("flip_field_to_field_src", r1.name, "world");
        passed += Test("flip_field_to_field_copy", r2.name, "world!");
    }

    // owned string LOCAL into field copies; the local stays usable afterward.
    {
        FlipRow r = default;
        string tmp = "fre" + "sh";
        r.name = tmp;
        tmp = tmp + "!";
        passed += Test("flip_local_into_field_field", r.name, "fresh");
        passed += Test("flip_local_into_field_src", tmp, "fresh!");
    }

    // plain container store into field copies; the source list stays independent.
    {
        list<int> xs = default; xs.add(5); xs.add(6);
        FlipBag h = default;
        h.xs = xs;
        xs.add(7);
        passed += Test("flip_plainstore_bag_count", h.xs.count(), 2);
        passed += Test("flip_plainstore_src_count", xs.count(), 3);
    }

    // brace-init container into field copies; the source list stays independent.
    {
        list<int> ys = default; ys.add(8);
        FlipBag h2 = { xs = ys };
        ys.add(9);
        passed += Test("flip_braceinit_bag_count", h2.xs.count(), 1);
        passed += Test("flip_braceinit_src_count", ys.count(), 2);
    }

    return passed;
}

// ── value struct with an owning string field, moved into a list<T> via add() ──────────
// `list<T>.add(move T value)` MOVES the struct into `_data[i]`, so the list becomes the
// sole owner of each element's owning string field. Reading elements back - especially via
// `for (Holder h in list)`, which binds a by-value copy of each element to the loop variable
// and destructs it at loop exit - must NOT free the buffer the list still owns. `alias T get`
// returns a borrow whose owning-field OWNED bits are cleared, so a destructed copy is a no-op.
// Regression: before the fix the loop-variable copy freed the field, dangling the list element
// and double-freeing on teardown (process exit 127). Verifies the stored data is intact across
// later allocations and that teardown frees each buffer exactly once (reaching this point at
// all proves no double-free; data integrity proves no premature free).
struct Holder
{
    int id = 0;
    string name = default;
};

int testStructWithStringFieldIntoList()
{
    int bad = 0;
    int sumLen = 0;
    {
        list<Holder> holders;
        for (int i = 0; i < 50; i++)
        {
            Holder h = default;
            h.id = i;
            h.name = "holder-" + i.toString();   // owning string field
            holders.add(h);                       // MOVE struct into the list
        }
        // for-in binds a by-value copy per element and destructs it at loop exit; the
        // borrowed owning-string field must survive (no double-free, no corruption).
        for (Holder h in holders)
            sumLen = sumLen + h.name.length();
        // Churn allocations would reuse any buffer wrongly freed by the loop copies.
        for (int i = 0; i < 50; i++)
        {
            string churn = "padding-padding-padding-" + i.toString();
            if (churn.length() < 1) { bad = bad + 1; }
        }
        // Read back through indexing after the churn: every element must be intact.
        for (int i = 0; i < holders.count(); i++)
        {
            string want = "holder-" + i.toString();
            if (holders.get(i).name.indexOf(want) != 0) { bad = bad + 1; }
            if (holders.get(i).id != i) { bad = bad + 1; }
        }
        // `holders` (and every owned element string) is destructed here - exactly once.
    }
    int passed = 0;
    passed += Test("struct_string_field_into_list_intact", bad, 0);
    passed += Test("struct_string_field_into_list_sumlen", sumLen, 440); // 10*len("holder-N") + 40*len("holder-NN")
    return passed;
}

// D4/D5: `unique` on a local/parameter. A `unique X*` local is an owning location; a
// `unique X*` parameter is a synthesized move parameter. All checks are dtor-count based.
// A `move` parameter of a struct type OWNS its copy, so assigning it into an owning slot must
// TRANSFER (exactly as an owned local does). Copying instead left two owners of one `unique`
// pointer and double-freed when the parameter destructed at function exit.
struct MoveParamHolder { unique Resource* p = nullptr; };
MoveParamHolder moveParamSink = default;
void stashOwnedHolder(move MoveParamHolder h) { moveParamSink = h; }

// The two POINTER-return factory modes must both stay legal. Returning a fresh allocation
// through a BARE `FactoryHolder*` is rejected (the caller gets no ownership signal); the two
// annotated forms below are the sanctioned spellings and must keep working.
struct FactoryHolder { unique Resource* p = nullptr; };
// C / manual mode: 'alias' opts out of ownership tracking - the caller frees by hand.
alias FactoryHolder* makeManual() { return new FactoryHolder(); }
// RAII mode: a 'move' pointer return transfers ownership to a `unique` local.
move FactoryHolder* makeOwning() { return new FactoryHolder(); }

// An unannotated by-value struct return whose every path hands back a borrowed parameter is
// inferred as an 'alias' (borrow) return, so the caller does not become a second owner.
struct AliasInferHolder { unique Resource* p = nullptr; };
AliasInferHolder passthruHolder(AliasInferHolder h) { return h; }

// Gate guard: the uniformity rule fires only for a return type that owns a 'unique' pointer.
// A COPYABLE struct duplicates no ownership, so MIXED returns stay legal for it.
struct CopyableHolder { int v = 0; };
CopyableHolder pickCopyable(CopyableHolder h, int c)
{
    if (c != 0)
        return h;
    CopyableHolder t = default;
    t.v = 99;
    return t;
}

int testUniqueLocalAndParam()
{
    int passed = 0;

    // Inferred 'alias' return: 'a' stays the only owner, so the payload is freed exactly once.
    dtorCount = 0;
    {
        AliasInferHolder a = default;
        a.p = new Resource();
        AliasInferHolder b = passthruHolder(a);
        int touch = b.p->id;
    }
    passed += Test("inferred_alias_return_freed_once", dtorCount, 1);

    // Copyable gate: mixed borrowed/owned returns remain legal and both branches are correct.
    {
        CopyableHolder src = default;
        src.v = 7;
        passed += Test("copyable_mixed_return_borrow_branch", pickCopyable(src, 1).v, 7);
        passed += Test("copyable_mixed_return_owned_branch", pickCopyable(src, 0).v, 99);
    }

    // C escape hatch: bare pointer return, explicit `delete` frees the payload exactly once.
    dtorCount = 0;
    {
        FactoryHolder* m = makeManual();
        m->p = new Resource();
        delete m;
    }
    passed += Test("alias_ptr_factory_manual_delete", dtorCount, 1);

    // RAII mode: `move` pointer return adopted by a `unique` local, freed once at scope exit.
    dtorCount = 0;
    {
        unique FactoryHolder* o = makeOwning();
        o->p = new Resource();
    }
    passed += Test("move_ptr_factory_unique_local", dtorCount, 1);

    // Assignment from a `move` struct parameter transfers: nothing is freed while the pointee
    // is still owned, and clearing the destination field frees it exactly once.
    dtorCount = 0;
    {
        MoveParamHolder a = default;
        a.p = new Resource();
        stashOwnedHolder(move a);
    }
    passed += Test("move_param_struct_assign_transfers", dtorCount, 0);
    moveParamSink.p = nullptr;
    passed += Test("move_param_struct_assign_freed_once", dtorCount, 1);

    // D5: unique local from new is an owning location - freed exactly once at scope exit.
    dtorCount = 0;
    { unique Resource* a = new Resource(); }
    passed += Test("unique_local_from_new_freed_once", dtorCount, 1);

    // D5: loading from a unique location without move yields a borrow - the borrowed local
    // is not freed, so the owner frees once (no double free).
    dtorCount = 0;
    {
        unique Resource* b = new Resource();
        Resource* borrowed = b;
        int x = borrowed->id;
    }
    passed += Test("unique_borrow_out_no_double_free", dtorCount, 1);

    // D4: passing a named unique value to a unique (synthesized move) parameter transfers
    // ownership - the callee frees it; the caller must not (no double free).
    dtorCount = 0;
    {
        unique Resource* c = new Resource();
        sinkUnique(c);
    }
    passed += Test("unique_synth_move_param_freed_once", dtorCount, 1);

    // D4: passing a unique value to a plain-pointer parameter is a borrow - the caller keeps
    // ownership and frees once at scope exit.
    dtorCount = 0;
    {
        unique Resource* d = new Resource();
        borrow(d);
    }
    passed += Test("unique_to_plain_param_borrows", dtorCount, 1);

    return passed;
}

// RAII factory used by the reassignment tests: a `move` pointer return is an owned source,
// so a `unique` local adopts it whether it lands via decl-init or plain reassignment.
move Resource* makeOwnedResource() { return new Resource(); }

// Hands back its FIRST parameter unchanged - a pure BORROW, owning nothing. The second
// parameter exists only so a `new` can be evaluated as a call ARGUMENT: ownership must be
// judged from the RHS itself, not from a sticky "something allocated" flag the argument set.
Resource* borrowFirstResource(Resource* a, Resource* b) { return a; }

// Same borrow return, but the second parameter ESCAPES into a global, so the argument-release
// path registers nothing and the declaration's own classification is the only thing standing
// between the borrow return and a double free.
Resource* g_retainedResource = nullptr;
Resource* retainSecondResource(Resource* a, Resource* b) { g_retainedResource = b; return a; }

// Reassigning a `unique` pointer LOCAL through plain `=` (not a decl-initializer) must
// transfer ownership exactly as `unique R* b = move a;` does. Before the fix the destination
// stayed non-owning, so scope exit skipped it and the moved-in object leaked.
int testUniqueLocalReassignMove()
{
    int passed = 0;

    // Plain '=' reassignment from an explicit `move`: the destination adopts ownership and
    // frees the pointee exactly once at scope exit (used to leak - nothing was freed).
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 17;
        unique Resource* b = nullptr;
        b = move a;
        passed += Test("unique_reassign_move_value_survives", b->id, 17);
        passed += Test("unique_reassign_move_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("unique_reassign_move_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_move_freed_once", dtorCount, 1);

    // Destination ALREADY owns a live object (the case decl-init cannot reach): the old
    // pointee is freed at the assignment - not leaked - and the moved-in one at scope exit.
    // Two objects, two destructor runs: no leak, no double free.
    dtorCount = 0;
    {
        unique Resource* src = new Resource();
        src->id = 20;
        unique Resource* dst = new Resource();
        dst->id = 21;
        dst = move src;
        passed += Test("unique_reassign_move_drops_old_at_assign", dtorCount, 1);
        passed += Test("unique_reassign_move_holds_new", dst->id, 20);
    }
    passed += Test("unique_reassign_move_old_and_new_freed_once", dtorCount, 2);

    // A direct `new` RHS is an owned source too - the same adoption applies.
    dtorCount = 0;
    {
        unique Resource* c = nullptr;
        c = new Resource();
    }
    passed += Test("unique_reassign_new_freed_once", dtorCount, 1);

    // A move-returning call is an owned source - parity with `unique R* x = makeOwnedResource();`.
    dtorCount = 0;
    {
        unique Resource* d = nullptr;
        d = makeOwnedResource();
    }
    passed += Test("unique_reassign_move_call_freed_once", dtorCount, 1);

    // Chained reassignment moves: ownership walks to the last holder, freed exactly once.
    dtorCount = 0;
    {
        unique Resource* e0 = new Resource();
        e0->id = 30;
        unique Resource* e1 = nullptr;
        unique Resource* e2 = nullptr;
        e1 = move e0;
        e2 = move e1;
        passed += Test("unique_reassign_chain_value", e2->id, 30);
    }
    passed += Test("unique_reassign_chain_freed_once", dtorCount, 1);

    // A moved-from source is live again after being reassigned: both objects are freed once.
    dtorCount = 0;
    {
        unique Resource* f0 = new Resource();
        unique Resource* f1 = nullptr;
        f1 = move f0;
        f0 = new Resource();
    }
    passed += Test("unique_reassign_revived_source_freed_once", dtorCount, 2);

    // Release-early: assigning nullptr frees the old pointee at the assignment, and the
    // now-empty owning slot is a no-op at scope exit.
    dtorCount = 0;
    {
        unique Resource* g = new Resource();
        g = nullptr;
        passed += Test("unique_reassign_null_releases_now", dtorCount, 1);
    }
    passed += Test("unique_reassign_null_no_double_free", dtorCount, 1);

    // A BORROW-returning call must not be mistaken for an owned source just because a `new`
    // was evaluated as one of its ARGUMENTS. `h` and the return value name one pointee; if the
    // unique local adopted it, scope exit would free it twice. The `b` parameter of
    // borrowFirstResource provably does not retain its argument, so the unnamed argument
    // allocation is released at end-of-full-expression (it used to leak): one destructor runs
    // there, and `h` accounts for the second at scope exit.
    dtorCount = 0;
    {
        unique Resource* h = new Resource();
        h->id = 5;
        unique Resource* borrowed = nullptr;
        borrowed = borrowFirstResource(h, new Resource());
        passed += Test("unique_reassign_borrow_call_value", borrowed->id, 5);
        passed += Test("unique_reassign_borrow_call_arg_temp_freed", dtorCount, 1);
    }
    passed += Test("unique_reassign_borrow_call_not_adopted", dtorCount, 2);

    // A '?:' is a transparent wrapper: an owning `new` in the TAKEN arm reaches the assignment
    // as the ternary's RESULT value, so the unique local adopts it and frees it exactly once.
    dtorCount = 0;
    {
        bool takeNew = true;
        unique Resource* t0 = nullptr;
        t0 = takeNew ? new Resource() : nullptr;
        passed += Test("unique_reassign_ternary_new_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_ternary_new_freed_once", dtorCount, 1);

    // The other arm is taken at runtime: nothing was allocated, so nothing may be freed.
    dtorCount = 0;
    {
        bool takeNew = false;
        unique Resource* t1 = nullptr;
        t1 = takeNew ? new Resource() : nullptr;
    }
    passed += Test("unique_reassign_ternary_untaken_arm_no_free", dtorCount, 0);

    // Both arms allocate, but '?:' branches for real - only the selected arm runs, so exactly
    // one object exists and it is freed once.
    dtorCount = 0;
    {
        bool takeFirst = true;
        unique Resource* t2 = nullptr;
        t2 = takeFirst ? new Resource() : new Resource();
    }
    passed += Test("unique_reassign_ternary_both_arms_freed_once", dtorCount, 1);

    // The ternary's owning bit must ride the RESULT value only: a `new` wrapped in a '?:' that
    // sits in ARGUMENT position still feeds a BORROW return, which must not be adopted. The
    // selected arm's allocation is a non-retained argument temp, so it is freed at
    // end-of-full-expression (null-guarded, so the nullptr arm frees nothing); `t3` is the second.
    dtorCount = 0;
    {
        bool useNew = true;
        unique Resource* t3 = new Resource();
        t3->id = 9;
        unique Resource* t4 = nullptr;
        t4 = borrowFirstResource(t3, useNew ? new Resource() : nullptr);
        passed += Test("unique_reassign_ternary_arg_borrow_value", t4->id, 9);
    }
    passed += Test("unique_reassign_ternary_arg_borrow_not_adopted", dtorCount, 2);

    // Same shape with the nullptr arm selected: nothing was allocated for the argument, so the
    // end-of-expression release is a no-op and only `t5` is destroyed.
    dtorCount = 0;
    {
        bool useNew = false;
        unique Resource* t5 = new Resource();
        t5->id = 11;
        unique Resource* t6 = nullptr;
        t6 = borrowFirstResource(t5, useNew ? new Resource() : nullptr);
        passed += Test("unique_reassign_ternary_arg_null_borrow_value", t6->id, 11);
        passed += Test("unique_reassign_ternary_arg_null_no_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_ternary_arg_null_arm_freed_once", dtorCount, 1);

    // Same question at a DECLARATION, which used to read the sticky flag instead of the RHS.
    // A plain `T*` declared from a BORROW-returning call adopted the return whenever a `new` had
    // run anywhere in the ARGUMENT list, so the local and the real owner freed one pointee twice.
    // borrowFirstResource does not retain, so the argument allocation is released at
    // end-of-full-expression (one destructor); `h` accounts for the second at scope exit.
    dtorCount = 0;
    {
        unique Resource* h = new Resource();
        h->id = 21;
        Resource* res = borrowFirstResource(h, new Resource());
        passed += Test("decl_borrow_call_arg_new_value", res->id, 21);
        passed += Test("decl_borrow_call_arg_new_temp_freed", dtorCount, 1);
    }
    passed += Test("decl_borrow_call_arg_new_owner_freed_once", dtorCount, 2);

    // The same shape with a RETAINING callee, which is the form that aborted: the argument
    // allocation escapes into a global, so no end-of-expression release runs and the only
    // destructor inside the scope would be a wrong one. `h` is freed once at scope exit; the
    // retained allocation is the global's to delete.
    dtorCount = 0;
    {
        unique Resource* h = new Resource();
        h->id = 22;
        Resource* res = retainSecondResource(h, new Resource());
        passed += Test("decl_retaining_call_arg_new_value", res->id, 22);
        passed += Test("decl_retaining_call_arg_new_no_early_free", dtorCount, 0);
    }
    passed += Test("decl_retaining_call_arg_new_owner_freed_once", dtorCount, 1);
    delete g_retainedResource;
    g_retainedResource = nullptr;
    passed += Test("decl_retaining_call_arg_new_retained_freed", dtorCount, 2);

    // Nested-`?:` flavour of the same leak-through: the `new` sits inside a ternary that is itself
    // an ARGUMENT, and the selected path never reaches it. The declaration must still borrow.
    dtorCount = 0;
    {
        unique Resource* keep = new Resource();
        keep->id = 23;
        Resource* live = keep;
        Resource* res = borrowFirstResource(
            keep, identityBool(false) ? (identityBool(true) ? new Resource() : live) : nullptr);
        passed += Test("decl_nested_ternary_arg_borrow_value", res->id, 23);
        passed += Test("decl_nested_ternary_arg_no_early_free", dtorCount, 0);
    }
    passed += Test("decl_nested_ternary_arg_owner_freed_once", dtorCount, 1);

    // The value-identity gate must not cost a DIRECT allocation its adoption: a plain `T*` and a
    // `unique T*` declared from `new` both own, and free exactly once at scope exit.
    dtorCount = 0;
    {
        Resource* plain = new Resource();
        plain->id = 24;
        passed += Test("decl_direct_new_plain_value", plain->id, 24);
    }
    passed += Test("decl_direct_new_plain_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        unique Resource* owned = new Resource();
        owned->id = 25;
    }
    passed += Test("decl_direct_new_unique_freed_once", dtorCount, 1);

    // A move-returning call and a top-level `move` are owned sources at a declaration too.
    dtorCount = 0;
    {
        Resource* fromCall = makeOwnedResource();
        fromCall->id = 26;
    }
    passed += Test("decl_move_return_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        unique Resource* src = new Resource();
        src->id = 27;
        Resource* dst = move src;
        passed += Test("decl_top_level_move_value", dst->id, 27);
        passed += Test("decl_top_level_move_source_nulled", src == nullptr ? 1 : 0, 1);
    }
    passed += Test("decl_top_level_move_freed_once", dtorCount, 1);

    // A non-mixed '?:' join of `move` arms owns, and the REASSIGNMENT path must adopt it exactly
    // as the declaration path does. It is in neither the owning-`new` nor the owning-return ledger
    // (a move has no free-site type), so before the value-identity leg the destination stayed
    // non-owning and the moved-out object was owned by nobody - a leak, not a double free.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 28;
        unique Resource* b = nullptr;
        b = identityBool(true) ? move a : nullptr;
        passed += Test("unique_reassign_move_join_value", b->id, 28);
        passed += Test("unique_reassign_move_join_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("unique_reassign_move_join_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_move_join_freed_once", dtorCount, 1);

    // Same through a NESTED join, where the inner join's ownership must survive the outer one.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 29;
        unique Resource* b = nullptr;
        b = identityBool(true) ? (identityBool(true) ? move a : nullptr) : nullptr;
        passed += Test("unique_reassign_nested_move_join_value", b->id, 29);
    }
    passed += Test("unique_reassign_nested_move_join_freed_once", dtorCount, 1);

    // The safety direction: a MIXED join never enters the ledger, so a reassignment still BORROWS
    // it. Adopting would free a pointee `owner` frees again at scope exit.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 30;
        Resource* live = owner;
        Resource* b = nullptr;
        b = identityBool(false) ? makeOwnedResource() : live;
        passed += Test("unique_reassign_mixed_join_borrow_value", b->id, 30);
        passed += Test("unique_reassign_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_mixed_join_owner_freed_once", dtorCount, 1);

    return passed;
}

// Explicit `move` on a VALUE-type call argument (string / owning struct / closure) defers
// the ownership transfer until the callee's parameter move-ness is known. Passing to a
// BORROWING param must leave the source intact (the eager zeroing used to consume it and
// leak the buffer with no diagnostic), and an explicit `move` must select the `move`
// overload rather than the plain one.
int movePlain(string s)      { return (int)s.length(); }
int moveOwns(move string s)  { return (int)s.length(); }

int ovlPick(string s)        { return 1; }
int ovlPick(move string s)   { return 2; }

int testValueMoveArgDeferred()
{
    int passed = 0;

    // Borrowing param: the source keeps its buffer after the call.
    {
        string a = "hel" + "lo";
        int seen = movePlain(a);
        passed += Test("value_move_borrow_callee_sees_len", seen, 5);
        passed += Test("value_move_borrow_source_intact", (int)a.length(), 5);
    }

    // move param: ownership transfers, the source is left empty (moved-from).
    {
        string b = "wor" + "ld";
        int seen = moveOwns(move b);
        passed += Test("value_move_owner_callee_sees_len", seen, 5);
    }

    // Overload selection: a plain argument BORROWS, an explicit `move` picks the move
    // overload. This pair used to resolve exactly backwards.
    {
        string c = "abc" + "de";
        passed += Test("value_move_ovl_plain_arg_borrows", ovlPick(c), 1);
        string d = "fgh" + "ij";
        passed += Test("value_move_ovl_explicit_move_owns", ovlPick(move d), 2);
    }

    return passed;
}

// ---------------------------------------------------------------------------
// Move/borrow overload IDENTITY tests. These deliberately assert WHICH overload
// ran (via a distinct return code / copy counter), never a call count: a counting
// oracle cannot see a fully INVERTED borrow/move pair.
// ---------------------------------------------------------------------------

// Generic-substituted pointer params: Box<T>.put(T) borrows, put(move T) owns.
struct Box<T>
{
    int lastPick = 0;
    int put(T p)      { lastPick = 1; return 1; }
    int put(move T p) { lastPick = 2; delete p; return 2; }
};

int g_rvalCopies = 0;
class Tracked
{
    int id = default;
    Tracked copy() { g_rvalCopies = g_rvalCopies + 1; Tracked t = default; t.id = id; return t; }
};
Tracked makeTracked() { Tracked t = default; t.id = 9; return t; }

// Borrow overload deep-copies (as a copy-by-default container would); move transfers.
int rvalPick(Tracked v)      { Tracked keep = v.copy(); return 1; }
int rvalPick(move Tracked v) { return 2; }

int testPtrMoveOverloadIdentity()
{
    int passed = 0;

    // Plain call on an owning pointer BORROWS: the callee must not free it, and the
    // caller's pointer must NOT be marked moved (it is still readable afterwards).
    dtorCount = 0;
    {
        Resource* a = new Resource();
        a->id = 7;
        passed += Test("ptr_ovl_plain_picks_borrow", probe(a), 207);
        passed += Test("ptr_ovl_plain_not_moved", a->id, 7);   // still usable: not consumed
        passed += Test("ptr_ovl_plain_not_freed_yet", dtorCount, 0);
    }
    passed += Test("ptr_ovl_plain_freed_at_scope_exit", dtorCount, 1);

    // Explicit move picks the MOVE overload, which frees exactly once inside the call.
    dtorCount = 0;
    {
        Resource* b = new Resource();
        b->id = 8;
        passed += Test("ptr_ovl_explicit_move_picks_move", probe(move b), 108);
        passed += Test("ptr_ovl_explicit_move_freed_in_callee", dtorCount, 1);
    }
    passed += Test("ptr_ovl_explicit_move_freed_once", dtorCount, 1);

    // Same rules through a generic substitution (T = Resource*).
    dtorCount = 0;
    {
        Box<Resource*> box;
        Resource* c = new Resource();
        c->id = 3;
        passed += Test("generic_ptr_ovl_plain_picks_borrow", box.put(c), 1);
        passed += Test("generic_ptr_ovl_plain_not_freed", dtorCount, 0);
        delete c;
    }
    passed += Test("generic_ptr_ovl_borrow_freed_by_caller", dtorCount, 1);

    dtorCount = 0;
    {
        Box<Resource*> box;
        Resource* d = new Resource();
        d->id = 4;
        passed += Test("generic_ptr_ovl_explicit_move_picks_move", box.put(move d), 2);
        passed += Test("generic_ptr_ovl_move_freed_in_callee", dtorCount, 1);
    }
    passed += Test("generic_ptr_ovl_move_freed_once", dtorCount, 1);

    return passed;
}

int testRValuePrefersMoveOverload()
{
    int passed = 0;

    // An unnamed temporary prefers the MOVE overload (nothing to preserve), so the
    // borrow overload's deep copy is not paid.
    g_rvalCopies = 0;
    passed += Test("rvalue_arg_picks_move", rvalPick(makeTracked()), 2);
    passed += Test("rvalue_arg_no_copy", g_rvalCopies, 0);

    // A named lvalue still BORROWS - that is the semantics, and it must not regress.
    Tracked t = default;
    t.id = 3;
    g_rvalCopies = 0;
    passed += Test("named_lvalue_arg_picks_borrow", rvalPick(t), 1);
    passed += Test("named_lvalue_arg_copies", g_rvalCopies, 1);

    // Explicit move on a named lvalue picks the move overload, no copy.
    Tracked u = default;
    u.id = 4;
    g_rvalCopies = 0;
    passed += Test("named_lvalue_explicit_move_picks_move", rvalPick(move u), 2);
    passed += Test("named_lvalue_explicit_move_no_copy", g_rvalCopies, 0);

    return passed;
}

/*
 * Reassignment of a `unique <interface>` LOCAL. The owning-source test for this leg used the
 * sticky global `lastOwningResult`, which a `new` ANYWHERE in the RHS sets - including in call
 * ARGUMENT position - so `k = pick(g, new SqMove())` adopted a borrow of `g` and both handles
 * freed it (exit 134). The reject is now keyed to the RHS shape itself, and the borrow form is
 * a compile error (err_unique_iface_stack_box). These legs pin that the three genuinely owning
 * forms still transfer and free exactly once.
 */
interface IShapeMove { int area(); };
int sqMoveCtorCount = 0;
class SqMove : IShapeMove
{
    int s = 0;
    SqMove() { sqMoveCtorCount = sqMoveCtorCount + 1; }
    int area() { return s * s; }
    ~SqMove() { dtorCount = dtorCount + 1; }
};

move IShapeMove makeShapeMove() { return new SqMove(); }

int ciMoveCtorCount = 0;
class CiMove : IShapeMove
{
    int r = 0;
    CiMove() { ciMoveCtorCount = ciMoveCtorCount + 1; }
    int area() { return r + 7; }
    ~CiMove() { dtorCount = dtorCount + 1; }
};

bool identityBool(bool b) { return b; }

/*
 * A '?:' RHS bound to an INTERFACE slot. The ternary result carries no concrete TypeName, so the
 * struct -> fat-pointer upcast used to be skipped and a raw pointer was bitcast into the fat
 * struct (invalid IR). Each arm is now boxed inside its own branch, so arms with different
 * concrete classes work too - and only the taken arm allocates.
 */
int testUniqueInterfaceTernary()
{
    int passed = 0;

    // Declaration initializer, non-null arm taken: adopted, freed exactly once.
    dtorCount = 0;
    {
        unique IShapeMove k = identityBool(true) ? new SqMove() : nullptr;
        passed += Test("unique_iface_ternary_decl_area", k.area(), 0);
        passed += Test("unique_iface_ternary_decl_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_ternary_decl_freed_once", dtorCount, 1);

    // Null arm taken: nothing allocated, nothing freed.
    dtorCount = 0;
    {
        unique IShapeMove k = identityBool(false) ? new SqMove() : nullptr;
    }
    passed += Test("unique_iface_ternary_decl_null_no_free", dtorCount, 0);

    // Reassignment leg: the old (null) box is released, the new one adopted and freed once.
    dtorCount = 0;
    {
        unique IShapeMove k = nullptr;
        k = identityBool(true) ? new SqMove() : nullptr;
        passed += Test("unique_iface_ternary_assign_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_ternary_assign_freed_once", dtorCount, 1);

    // Different concrete classes per arm: only the taken arm is constructed and freed.
    dtorCount = 0;
    ciMoveCtorCount = 0;
    sqMoveCtorCount = 0;
    {
        unique IShapeMove k = identityBool(false) ? new SqMove() : new CiMove();
        passed += Test("unique_iface_ternary_mixed_area", k.area(), 7);
        passed += Test("unique_iface_ternary_mixed_taken_arm", ciMoveCtorCount, 1);
        passed += Test("unique_iface_ternary_mixed_untaken_arm", sqMoveCtorCount, 0);
    }
    passed += Test("unique_iface_ternary_mixed_freed_once", dtorCount, 1);

    // Both arms null: owns nothing, no free, no crash.
    dtorCount = 0;
    {
        unique IShapeMove k = identityBool(true) ? nullptr : nullptr;
    }
    passed += Test("unique_iface_ternary_both_null", dtorCount, 0);

    // Non-unique interface local takes the same upcast path; it does not own, so free by hand.
    dtorCount = 0;
    {
        IShapeMove k = identityBool(true) ? new SqMove() : nullptr;
        passed += Test("iface_ternary_plain_decl_area", k.area(), 0);
        delete k;
    }
    passed += Test("iface_ternary_plain_decl_freed_once", dtorCount, 1);

    // MIXED fat-pointer join: one arm allocates, the other yields a LIVE borrow of a `unique`
    // interface local. Which arm runs is not knowable, so the join owns nothing a receiver may
    // free - a plain local only borrows it. It used to adopt whichever arm the phi selected and
    // destroy the owner's box, which the owner then destroyed again (abort). The allocating arm
    // leaks when selected; that is the accepted trade. The `unique` receiver spelling of this is
    // a compile error (Test/errors/err_move.cb).
    dtorCount = 0;
    {
        unique IShapeMove owner = new SqMove();
        IShapeMove borrowed = owner;
        {
            IShapeMove k = identityBool(false) ? makeShapeMove() : borrowed;
            passed += Test("iface_ternary_mixed_join_borrow_value", k.area(), 0);
            passed += Test("iface_ternary_mixed_join_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_mixed_join_no_adoption", dtorCount, 0);
        passed += Test("iface_ternary_mixed_join_owner_alive", owner.area(), 0);
    }
    passed += Test("iface_ternary_mixed_join_owner_freed_once", dtorCount, 1);

    return passed;
}

int testUniqueInterfaceReassign()
{
    int passed = 0;

    // Direct `new` RHS: the local adopts the box and frees it once at scope exit.
    dtorCount = 0;
    {
        unique IShapeMove k = nullptr;
        k = new SqMove();
        passed += Test("unique_iface_reassign_new_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_reassign_new_freed_once", dtorCount, 1);

    // A move-returning call transfers ownership through lastCallReturnsOwned.
    dtorCount = 0;
    {
        unique IShapeMove k = nullptr;
        k = makeShapeMove();
        passed += Test("unique_iface_reassign_movecall_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_reassign_movecall_freed_once", dtorCount, 1);

    // `move` of an OWNING interface local: the source is consumed, so exactly one free.
    dtorCount = 0;
    {
        unique IShapeMove g = new SqMove();
        unique IShapeMove k = nullptr;
        k = move g;
        passed += Test("unique_iface_reassign_move_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_reassign_move_freed_once", dtorCount, 1);

    // Reassigning an already-owning slot frees the OLD box at the store, the new one at exit.
    dtorCount = 0;
    {
        unique IShapeMove k = new SqMove();
        k = new SqMove();
        passed += Test("unique_iface_reassign_drops_old_at_assign", dtorCount, 1);
    }
    passed += Test("unique_iface_reassign_old_and_new_freed_once", dtorCount, 2);

    return passed;
}

/*
 * `unique <interface>` move as a plain-readable null (bf26a15, design record
 * internal/plan/unique-interface-move-readable-null.md): explicit `move` of an interface local
 * zeroes both fat-pointer slots and leaves the source LEGAL TO READ (comparisons, reassignment,
 * pass-along) - only a DEREFERENCE is rejected (Test/errors/err_move.cb's `ui` leg). These legs
 * pin the runtime behaviour of the readable-null contract itself, mirroring the thin-pointer
 * `explicit_move_local_*` and `cross_block_*` legs in testUniqueField above.
 */
int testUniqueInterfaceMoveExtra()
{
    int passed = 0;

    // Readable-after-move basics: source compares null both ways, dest dispatches, one free.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        passed += Test("iface_move_source_eq_null", a == nullptr ? 1 : 0, 1);
        passed += Test("iface_move_source_neq_null", a != nullptr ? 1 : 0, 0);
        passed += Test("iface_move_dest_dispatches", b.area(), 0);
        passed += Test("iface_move_no_early_free", dtorCount, 0);
    }
    passed += Test("iface_move_freed_once", dtorCount, 1);

    // Move-of-moved: the second move's receiver is null too, no dtor effect, no crash.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        unique IShapeMove c = move a;
        passed += Test("iface_move_of_moved_dest_null", c == nullptr ? 1 : 0, 1);
        passed += Test("iface_move_of_moved_no_early_free", dtorCount, 0);
    }
    passed += Test("iface_move_of_moved_freed_once", dtorCount, 1);

    // Reassignment after move: the local is re-owned and dispatches; both boxes freed once each.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        a = new SqMove();
        passed += Test("iface_move_reassign_dispatches", a.area(), 0);
    }
    passed += Test("iface_move_reassign_freed_twice", dtorCount, 2);

    // Guarded cross-block deref, move NOT taken: guard passes, real dispatch value.
    dtorCount = 0;
    {
        unique IShapeMove ig = new SqMove();
        if (RuntimeFalse()) { unique IShapeMove ig2 = move ig; }
        int t = -1;
        if (ig != nullptr) { t = ig.area(); }
        passed += Test("iface_guard_not_taken_dispatches", t, 0);
    }
    passed += Test("iface_guard_not_taken_freed_once", dtorCount, 1);

    // Guarded cross-block deref, move TAKEN (a genuine runtime-true branch): guard fails, the
    // sentinel path runs, no crash - the moved-to inner local frees the box.
    dtorCount = 0;
    {
        unique IShapeMove ig = new SqMove();
        if (identityBool(true)) { unique IShapeMove ig2 = move ig; }
        int t = -1;
        if (ig != nullptr) { t = ig.area(); }
        passed += Test("iface_guard_taken_sentinel", t, -1);
    }
    passed += Test("iface_guard_taken_freed_once", dtorCount, 1);

    // Loop-carried move under a guard: the move only fires on the second iteration, and the
    // post-loop guarded deref sees the (by-then-moved) local and takes the sentinel path.
    dtorCount = 0;
    {
        unique IShapeMove ig = new SqMove();
        for (int i = 0; i < 2; i++)
        {
            if (ig != nullptr && identityBool(i == 1)) { unique IShapeMove ig2 = move ig; }
        }
        int t = -1;
        if (ig != nullptr) { t = ig.area(); }
        passed += Test("iface_loop_carried_guard_sentinel", t, -1);
    }
    passed += Test("iface_loop_carried_guard_freed_once", dtorCount, 1);

    // Pass-along of a moved (null) interface local: plain assignability to a non-unique
    // interface local stays legal (a read, not a dereference) and observes the null.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        IShapeMove d = a;
        passed += Test("iface_move_assign_to_plain_is_null", d == nullptr ? 1 : 0, 1);
    }
    passed += Test("iface_move_assign_to_plain_freed_once", dtorCount, 1);

    // `?.` on a maybe-moved `unique <interface>` receiver: the deref sites skip the Deref
    // event under nullConditionalPending (the '?.' legitimately tolerates null), so this
    // must compile without the cross-block moved-deref diagnostic firing, and must dispatch
    // correctly on both the not-moved and moved (null) paths. CiMove.area() (r+7, r=0) is a
    // NONZERO real result, distinct from the '?.' short-circuit's zero default, so '?? -1'
    // unambiguously tells which path ran.
    dtorCount = 0;
    {
        unique IShapeMove ig = new CiMove();
        if (RuntimeFalse()) { unique IShapeMove ig2 = move ig; }
        int t = ig?.area() ?? -1;
        passed += Test("iface_nullcond_guard_not_taken_dispatches", t, 7);
    }
    passed += Test("iface_nullcond_guard_not_taken_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        unique IShapeMove ig = new CiMove();
        if (identityBool(true)) { unique IShapeMove ig2 = move ig; }
        int t = ig?.area() ?? -1;
        passed += Test("iface_nullcond_guard_taken_short_circuits", t, -1);
    }
    passed += Test("iface_nullcond_guard_taken_freed_once", dtorCount, 1);

    return passed;
}

/*
 * `_ = <call>();` on a `move T*`-returning function. The discarded thing is the RETURNED
 * POINTER, so the destructor must run against that pointer and the block must be freed. It
 * used to spill the pointer VALUE into a temp and destruct the pointer's own bits as if they
 * were the object: the real allocation leaked and the dtor body ran on a wild address.
 */
int discardDtorCount = 0;
int discardSeenValue = 0;

struct DiscardProbe
{
    int v = 0;
    ~DiscardProbe()
    {
        discardDtorCount = discardDtorCount + 1;
        discardSeenValue = v;
    }
};

move DiscardProbe* makeDiscardProbe()
{
    DiscardProbe* p = new DiscardProbe();
    p->v = 7;
    return p;
}

int discardOwnerDtorCount = 0;
int discardOwnerNameOk = 0;

// Owning-member variant: the generated teardown frees `name`. If the dtor ran against a wild
// address this would free an arbitrary pointer instead of this object's buffer.
struct DiscardOwner
{
    string name = default;
    int tag = 0;
    ~DiscardOwner()
    {
        discardOwnerDtorCount = discardOwnerDtorCount + 1;
        if (name == "payload" && tag == 9)
            discardOwnerNameOk = 1;
    }
};

move DiscardOwner* makeDiscardOwner()
{
    DiscardOwner* p = new DiscardOwner();
    p->name = "pay" + "load";
    p->tag = 9;
    return p;
}

int testDiscardMoveReturningCall()
{
    int passed = 0;

    discardDtorCount = 0;
    discardSeenValue = 0;
    _ = makeDiscardProbe();
    passed += Test("discard_move_ptr_freed_once", discardDtorCount, 1);
    passed += Test("discard_move_ptr_dtor_sees_field", discardSeenValue, 7);

    discardOwnerDtorCount = 0;
    discardOwnerNameOk = 0;
    _ = makeDiscardOwner();
    passed += Test("discard_move_owner_freed_once", discardOwnerDtorCount, 1);
    passed += Test("discard_move_owner_member_intact", discardOwnerNameOk, 1);

    // Two discards in a row: each call frees its OWN result, no cross-talk.
    discardDtorCount = 0;
    discardSeenValue = 0;
    _ = makeDiscardProbe();
    _ = makeDiscardProbe();
    passed += Test("discard_move_ptr_freed_each_time", discardDtorCount, 2);
    passed += Test("discard_move_ptr_field_still_right", discardSeenValue, 7);

    return passed;
}

// `move` of a BORROWED parameter transfers nothing: nulling the callee's copy leaves the CALLER
// the sole owner. Neither helper may adopt the join - the pointee is still the caller's, and
// freeing it here destroys a live object the caller frees again at its own scope exit.
int borrowedMoveJoinsNull(Resource* borrowed, bool c)
{
    Resource* b = nullptr;
    b = c ? move borrowed : nullptr;
    return b == nullptr ? -1 : b->id;
}

// The same borrowed move paired with a genuinely OWNING arm, which is the shape that used to
// abort: the borrow arm fails join-eligibility, so the join is mixed and the result borrows.
int borrowedMoveJoinsOwning(Resource* borrowed, bool c)
{
    Resource* v = c ? move borrowed : makeOwnedResource();
    return v->id;
}

// The borrowed-move join laundered through a NESTED '?:' into a PLAIN pointer. A plain pointer
// only ever borrows, so this stays legal - the rejection added for a `unique` receiver keys on
// the destination being an owning location, not on the join.
int borrowedMoveNestedJoinsNull(Resource* borrowed, bool c)
{
    Resource* b = nullptr;
    b = c ? (c ? move borrowed : nullptr) : nullptr;
    return b == nullptr ? -1 : b->id;
}

// A borrowed move paired with a LIVE BORROW arm is a MIXED join: which arm runs is not knowable,
// so it is not provably non-owning and keeps the existing silent-borrow behaviour even into a
// `unique` local. Nothing is adopted, so both callers' objects survive and each is freed once.
int borrowedMoveMixedJoinIntoUnique(Resource* borrowed, Resource* other, bool c)
{
    unique Resource* b = nullptr;
    b = c ? move borrowed : other;
    return b == nullptr ? -1 : b->id;
}

// The FIELD boundary of the same rule. The all-borrowed-move-or-null join into a `unique` field is
// now rejected (it aborted: the field freed the caller's live pointee), but this MIXED join is not
// in the ledger, so it still stores and the field owns the arm that actually ran.
void borrowedMoveMixedJoinIntoField(UniqueBox* box, Resource* borrowed, bool c)
{
    box->item = c ? move borrowed : makeOwnedResource();
}

// The BRACE-INIT store path (EmitOneFieldInit) is the third destination that rejects the laundered
// borrow, so its mixed-join spelling must stay accepted too - the two field paths run the same rule.
int borrowedMoveMixedBraceInit(Resource* borrowed, bool c)
{
    UniqueBox box = { item = c ? move borrowed : makeOwnedResource() };
    return box.item != nullptr ? 1 : 0;
}

// A ternary evaluates ONLY the selected arm. It used to compute both arms eagerly and combine
// them with LLVM's `select`, so a `move` or an owning call in the not-taken arm still ran.
int testTernaryArmsShortCircuit()
{
    int passed = 0;

    // False condition: the `move` arm never runs, so the source keeps its object and frees
    // it exactly once at scope exit.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 21;
        bool c = false;
        unique Resource* b = c ? move a : nullptr;
        passed += Test("ternary_untaken_move_source_intact", a == nullptr ? 1 : 0, 0);
        passed += Test("ternary_untaken_move_value_survives", a->id, 21);
        passed += Test("ternary_untaken_move_dest_null", b == nullptr ? 1 : 0, 1);
        passed += Test("ternary_untaken_move_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_untaken_move_freed_once", dtorCount, 1);

    // True condition: ownership transfers through the ternary, still exactly one free.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 22;
        bool c = true;
        unique Resource* b = c ? move a : nullptr;
        passed += Test("ternary_taken_move_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("ternary_taken_move_value_moved", b->id, 22);
    }
    passed += Test("ternary_taken_move_freed_once", dtorCount, 1);

    // An owning-returning CALL in the not-taken arm must never be invoked.
    dtorCount = 0;
    {
        bool c = false;
        unique Resource* a = c ? makeOwnedResource() : nullptr;
        passed += Test("ternary_untaken_owning_call_not_run", a == nullptr ? 1 : 0, 1);
    }
    passed += Test("ternary_untaken_owning_call_no_free", dtorCount, 0);

    // ... and when it IS taken the result is adopted and freed exactly once.
    dtorCount = 0;
    {
        bool c = true;
        unique Resource* a = c ? makeOwnedResource() : nullptr;
        a->id = 23;
        passed += Test("ternary_taken_owning_call_adopted", a->id, 23);
    }
    passed += Test("ternary_taken_owning_call_freed_once", dtorCount, 1);

    // A bare `new` in an arm is adopted by the unique local, freed once.
    dtorCount = 0;
    {
        bool c = true;
        unique Resource* a = c ? new Resource() : nullptr;
        passed += Test("ternary_new_arm_alive", a == nullptr ? 1 : 0, 0);
    }
    passed += Test("ternary_new_arm_freed_once", dtorCount, 1);

    // MIXED pointer join: one arm allocates, the other yields a LIVE borrow. The join owns
    // nothing the receiver may free (which arm ran is not knowable at the declaration), so the
    // local borrows - it used to adopt whichever arm the phi picked and double-free the owner's
    // pointee. The allocating arm leaks when selected; that is the accepted trade.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 31;
        bool takeOwning = false;
        Resource* mixed = takeOwning ? makeOwnedResource() : owner;
        passed += Test("ternary_mixed_join_borrow_value", mixed->id, 31);
        passed += Test("ternary_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_mixed_join_owner_freed_once", dtorCount, 1);

    // Same through a NESTED '?:' - the inner mixed join is suppressed, and the suppression must
    // survive the outer join instead of being overruled by the outer arm's `new`.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 32;
        bool outer = true;
        bool inner = false;
        Resource* mixed = outer ? (inner ? makeOwnedResource() : owner) : new Resource();
        passed += Test("ternary_nested_mixed_join_borrow_value", mixed->id, 32);
        passed += Test("ternary_nested_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_mixed_join_owner_freed_once", dtorCount, 1);

    // A mixed join whose BORROW arm merely CONTAINS a `new` in ARGUMENT position. That `new` does
    // not make the arm own its result, so the join stays mixed; scoring the arm owning turned the
    // borrow into a freeable temp and double-freed the real owner. The argument temp itself is a
    // non-retained allocation, freed at end-of-full-expression.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 33;
        bool c = true;
        Resource* joined = c ? borrowFirstResource(owner, new Resource()) : makeOwnedResource();
        passed += Test("ternary_mixed_join_arg_new_borrow_value", joined->id, 33);
        passed += Test("ternary_mixed_join_arg_new_temp_freed", dtorCount, 1);
    }
    passed += Test("ternary_mixed_join_arg_new_owner_freed_once", dtorCount, 2);

    // A PARENTHESIZED `move` arm. Arm ownership is answered by value identity, so a wrapper around
    // the move cannot turn it into a borrow - scoring it one left the moved-out object owned by
    // nobody (leak) and made a `unique` receiver a spurious borrow-init error.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 41;
        bool c = true;
        Resource* b = c ? (move a) : nullptr;
        passed += Test("ternary_paren_move_arm_value", b->id, 41);
        passed += Test("ternary_paren_move_arm_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_paren_move_arm_freed_once", dtorCount, 1);

    // Same wrapper in the FALSE arm, adopted by a `unique` receiver.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 42;
        bool c = false;
        unique Resource* b = c ? nullptr : (move a);
        passed += Test("ternary_paren_move_false_arm_value", b->id, 42);
        passed += Test("ternary_paren_move_false_arm_source_nulled", a == nullptr ? 1 : 0, 1);
    }
    passed += Test("ternary_paren_move_false_arm_freed_once", dtorCount, 1);

    // A NESTED non-mixed join whose inner arm is a `move`. Arm ownership is answered from the
    // joined value, so the inner join must hand its detachment out to the OUTER join or the outer
    // one scores mixed - which rejected this as a borrow-into-unique and left the object unowned.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 43;
        unique Resource* v = identityBool(true) ? (identityBool(true) ? move a : nullptr) : nullptr;
        passed += Test("ternary_nested_move_join_value", v->id, 43);
        passed += Test("ternary_nested_move_join_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("ternary_nested_move_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_move_join_freed_once", dtorCount, 1);

    // Same nesting with an allocating outer arm: both arms own, so the join owns and only the
    // selected arm ever runs - exactly one object exists and it is freed once.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 44;
        unique Resource* v = identityBool(true) ? (identityBool(true) ? move a : nullptr) : new Resource();
        passed += Test("ternary_nested_move_new_join_value", v->id, 44);
        passed += Test("ternary_nested_move_new_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_move_new_join_freed_once", dtorCount, 1);

    // Safety direction for the same shape: pair the owning inner join with a LIVE BORROW arm and
    // the outer join is mixed again, so the receiver borrows. The untaken `move` never runs, so
    // `a` keeps its object and `owner` keeps its own - two destructors, no double free.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 45;
        unique Resource* a = new Resource();
        a->id = 46;
        Resource* v = identityBool(false) ? (identityBool(true) ? move a : nullptr) : owner;
        passed += Test("ternary_nested_move_mixed_join_borrow_value", v->id, 45);
        passed += Test("ternary_nested_move_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_move_mixed_join_both_freed_once", dtorCount, 2);

    // A `move` of a BORROWED parameter is the one move that owns NOTHING, so it must not make its
    // arm join-eligible. Scoring it owning made the join uniform, the receiver adopted it, and the
    // caller's live object was destroyed inside the callee (use-after-free on return, then a second
    // destructor at the caller's scope exit). The caller stays the sole owner: one destructor.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 47;
        passed += Test("ternary_borrowed_move_join_null_value", borrowedMoveJoinsNull(owner, true), 47);
        passed += Test("ternary_borrowed_move_join_null_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_join_null_owner_alive", owner->id, 47);
    }
    passed += Test("ternary_borrowed_move_join_null_owner_freed_once", dtorCount, 1);

    // Same borrowed move paired with an OWNING arm - the join is mixed, so the result borrows and
    // the untaken allocating arm never runs.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 48;
        passed += Test("ternary_borrowed_move_mixed_join_value", borrowedMoveJoinsOwning(owner, true), 48);
        passed += Test("ternary_borrowed_move_mixed_join_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_mixed_join_owner_alive", owner->id, 48);
    }
    passed += Test("ternary_borrowed_move_mixed_join_owner_freed_once", dtorCount, 1);

    // Nested laundering of the same borrowed move into a PLAIN pointer: still a borrow, and the
    // caller stays the sole owner. The `unique` spelling of this is now a compile error
    // (Test/errors/err_unique_borrow_into_unique.cb); the plain one must keep compiling.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 49;
        passed += Test("ternary_borrowed_move_nested_join_value",
                       borrowedMoveNestedJoinsNull(owner, true), 49);
        passed += Test("ternary_borrowed_move_nested_join_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_nested_join_owner_alive", owner->id, 49);
    }
    passed += Test("ternary_borrowed_move_nested_join_owner_freed_once", dtorCount, 1);

    // The boundary of that rejection: a borrowed move MIXED with a live borrow arm still assigns
    // into a `unique` local and still borrows. Neither object is adopted, so each owner frees its
    // own exactly once.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 50;
        unique Resource* other = new Resource();
        other->id = 51;
        passed += Test("ternary_borrowed_move_mixed_unique_value",
                       borrowedMoveMixedJoinIntoUnique(owner, other, false), 51);
        passed += Test("ternary_borrowed_move_mixed_unique_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_mixed_unique_owner_alive", owner->id, 50);
    }
    passed += Test("ternary_borrowed_move_mixed_unique_both_freed_once", dtorCount, 2);

    // Same boundary for a `unique` FIELD destination: the mixed join still stores, the field owns
    // the arm that ran and frees it once at teardown, and the borrowed caller keeps its own object.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 52;
        {
            UniqueBox box = default;
            borrowedMoveMixedJoinIntoField(&box, owner, false);
            passed += Test("ternary_borrowed_move_mixed_field_value",
                           box.item != nullptr ? 1 : 0, 1);
            passed += Test("ternary_borrowed_move_mixed_field_no_early_free", dtorCount, 0);
        }
        passed += Test("ternary_borrowed_move_mixed_field_freed_once", dtorCount, 1);
        passed += Test("ternary_borrowed_move_mixed_field_owner_alive", owner->id, 52);
    }
    passed += Test("ternary_borrowed_move_mixed_field_owner_freed_once", dtorCount, 2);

    // Same boundary on the brace-init field path: the mixed join still initializes the field, which
    // frees the allocated arm when the holder dies, and the borrowed caller keeps its own object.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 53;
        passed += Test("brace_borrowed_move_mixed_field_value",
                       borrowedMoveMixedBraceInit(owner, false), 1);
        passed += Test("brace_borrowed_move_mixed_field_freed_once", dtorCount, 1);
        passed += Test("brace_borrowed_move_mixed_field_owner_alive", owner->id, 53);
    }
    passed += Test("brace_borrowed_move_mixed_field_owner_freed_once", dtorCount, 2);

    // String arms: an owning FIELD read in an arm is deep-copied, never aliased, so the
    // field still owns its own buffer after the ternary result goes out of scope.
    {
        FlipRow row = default;
        row.name = "" + "fieldval";
        bool c = true;
        {
            string picked = c ? row.name : "-";
            passed += Test("ternary_string_field_arm_value", picked == "fieldval" ? 1 : 0, 1);
        }
        passed += Test("ternary_string_field_survives", row.name == "fieldval" ? 1 : 0, 1);
        string other = !c ? row.name : "-";
        passed += Test("ternary_string_literal_arm_value", other == "-" ? 1 : 0, 1);
    }

    // A string-returning CALL in an arm: only the selected call runs and its temp is freed.
    {
        bool c = true;
        string s = c ? echoString("left") : echoString("right");
        passed += Test("ternary_string_call_arm_value", s == "left" ? 1 : 0, 1);
    }

    return passed;
}

extern int main()
{
    int passed = 0;
    int total  = 0;

    // Test 1: move param causes destructor to fire when function returns
    dtorCount = 0;
    {
        Resource* r = new Resource();
        r->id = 42;
        borrow(r);
        consume(r);
    }
    passed += Test("move_borrow_no_dtor", dtorCount, 1);
    total++;

    // Test 2: move param with null - no crash (null check in cleanup)
    dtorCount = 0;
    {
        Resource* r = new Resource();
        consume(r);
    }
    passed += Test("move_null_safe", dtorCount, 1);
    total++;

    // Test 3: new-allocated local auto-freed at scope exit (no escape)
    dtorCount = 0;
    {
        Resource* r = new Resource();
    }
    passed += Test("new_local_auto_free", dtorCount, 1);
    total++;

    // Test 4: new local assigned to struct field - not freed early; freed when owner is destroyed
    dtorCount = 0;
    {
        Container* c = new Container();
        {
            Resource* r = new Resource();
            c->item = r;
            // r exits scope: refcount 2->1, no free
        }
        passed += Test("stack_to_field_no_early_free", dtorCount, 0);
        total++;
        // c exits scope: auto-freed, ~Container() frees c->item -> dtorCount = 1
    }
    passed += Test("stack_to_field_freed_with_owner", dtorCount, 1);
    total++;

    passed += testListStringMove();
    total += 10;

    // Test 5: move T* return - caller receives ownership, pointer freed at scope exit
    dtorCount = 0;
    {
        Resource* r = createResource(7);
    }
    passed += Test("move_return_new_freed", dtorCount, 1);
    total++;

    // Test 6: move T* return - forward through move param, freed once
    dtorCount = 0;
    {
        Resource* r = createResource(8);
        Resource* r2 = forwardResource(r);
    }
    passed += Test("move_return_forward_freed_once", dtorCount, 1);
    total++;

    // Test 6a: move-in-loop with reassign each iteration. The reassignment revives the
    // pointer across the back-edge, so this is NOT a loop-carried use-after-move and must
    // compile clean (guards the move-dataflow pass against a false positive).
    dtorCount = 0;
    {
        Resource* r = new Resource();
        int i = 0;
        while (i < 3)
        {
            consume(r);          // moves + frees r (dtor +1)
            r = new Resource();  // revive: fresh owner for the next iteration
            i = i + 1;
        }
        consume(r);              // free the last one
    }
    passed += Test("move_loop_reassign_revive", dtorCount, 4);
    total++;

    // Test 6b: fresh owning local declared inside the loop each iteration - the binding
    // dominates every use, so no loop-carried move; must compile clean.
    dtorCount = 0;
    {
        int i = 0;
        while (i < 3)
        {
            Resource* q = new Resource();
            consume(q);
            i = i + 1;
        }
    }
    passed += Test("move_loop_fresh_local", dtorCount, 3);
    total++;

    // Worker-style ownership transfer (mirrors repro_new_struct.cb without threads).
    // Caller 'new's a Slot, hands it to a function via 'move'; callee writes through
    // ->slot and returns. Expect exactly one destructor, observed value updated.
    dtorCount = 0;
    {
        int observed = 0;
        Slot* p = new Slot();
        p->slot  = &observed;
        p->value = 42;
        int got = workerMove(p);
        passed += Test("worker_move_return", got, 42);
        total++;
        passed += Test("worker_move_observed", observed, 42);
        total++;
        // p is nulled by 'move'; scope exit is a no-op. Exactly one free inside workerMove.
    }
    passed += Test("worker_move_freed_once", dtorCount, 1);
    total++;

    // Same shape, but the callee calls 'delete' explicitly. ParseDeleteExpression
    // nulls the parameter's alloca so scope-exit cleanup skips - still one free.
    dtorCount = 0;
    {
        int observed = 0;
        Slot* p = new Slot();
        p->slot  = &observed;
        p->value = 7;
        int got = workerMoveDelete(p);
        passed += Test("worker_move_delete_return", got, 7);
        total++;
        passed += Test("worker_move_delete_observed", observed, 7);
        total++;
    }
    passed += Test("worker_move_delete_freed_once", dtorCount, 1);
    total++;

    // Test 7: list<unique T*> OWNS its elements - removeAt frees one in place, the
    // destructor frees the rest. take() went away with the borrow-by-default list:
    // extraction from an owning container is deliberately undesigned (plan item 5).
    dtorCount = 0;
    {
        list<unique Resource*> items;
        Resource* a = new Resource();
        Resource* b = new Resource();
        items.add(a);
        items.add(b);
        items.removeAt(0);
        passed += Test("list_removeAt_owned_freed", dtorCount, 1);
        total++;
        // list goes out of scope; remaining element (b) freed by list destructor
    }
    passed += Test("list_dtor_remaining_freed", dtorCount, 2);
    total++;

    // Test 8: move-vs-borrow overload selection via a second, unrelated function
    // (delegateProbe). probe()'s own plain/move overload pair is covered by
    // testPtrMoveOverloadIdentity() below (ptr_ovl_plain_picks_borrow /
    // ptr_ovl_explicit_move_picks_move), which also asserts the borrowed pointer stays
    // usable after the call - removed the redundant probe() duplicate that used to sit here.
    // Borrowed pointer (non-move param) -> picks 'borrow' overload (returns 200+id, no free).
    dtorCount = 0;
    {
        Resource* b = new Resource();
        b->id = 9;
        int v = delegateProbe(b);
        passed += Test("probe_picks_borrow_for_non_owning", v, 209);
        total++;
        // b still owned here; freed at scope exit.
    }
    passed += Test("probe_borrow_freed_at_scope_exit", dtorCount, 1);
    total++;

    // Test 9: composite-ownership cleanup. Bag owns 'item' (Resource*) and
    // 'entries' (RouteEntry[3]). Each layer's destructor frees only its own
    // fields; ~Bag's 'delete[3] entries' invokes ~RouteEntry on every slot,
    // which frees its own 'name'. No layer reaches into another's fields.
    dtorCount = 0;
    {
        Bag bag;
        bag.item = new Resource();
        bag.item->id = 1;
        bag.entries = new RouteEntry[3];
        int i = 0;
        while (i < 3)
        {
            bag.entries[i].name = new Resource();
            bag.entries[i].name->id = i + 10;
            i = i + 1;
        }
        // 4 Resources alive: bag.item plus three entry names.
        // Scope exit -> ~Bag frees item, delete[3] entries -> ~RouteEntry per slot
        // frees each name. dtorCount should reach 4.
    }
    passed += Test("composite_dtor_chain_frees_all", dtorCount, 4);
    total++;

    passed += testRecursiveTreeFree();
    total += 1;

    passed += testDeleteNullCascade();
    total += 1;

    passed += testRecursiveContainerFree();
    total += 1;

    passed += testSelfRefContainerRelease();
    total += 6;

    passed += testFieldOwnership();
    total += 7;

    passed += testUniqueField();
    total += 68;

    passed += testParamStringToField();
    total += 1;

    passed += testStructWithStringFieldIntoList();
    total += 2;

    passed += testBorrowStringFieldIntoLocal();
    total += 3;

    passed += testCopyOnAssignFlip();
    total += 12;

    passed += testUniqueLocalAndParam();
    total += 11;

    passed += testUniqueLocalReassignMove();
    total += 52;

    passed += testValueMoveArgDeferred();
    total += 5;

    passed += testPtrMoveOverloadIdentity();
    total += 13;

    passed += testRValuePrefersMoveOverload();
    total += 6;

    passed += testTernaryArmsShortCircuit();
    total += 68;

    passed += testUniqueInterfaceReassign();
    total += 8;

    passed += testUniqueInterfaceTernary();
    total += 18;

    passed += testUniqueInterfaceMoveExtra();
    total += 22;

    passed += testDiscardMoveReturningCall();
    total += 6;

    printf("\n%d / %d tests passed.\n", passed, total);
    return passed == total ? 0 : 1;
}
