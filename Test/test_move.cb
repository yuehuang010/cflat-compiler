import "function.cb";
import "list.cb";
import "stack.cb";
import "queue.cb";
import "dictionary.cb";
import "test_helper.cb";

int dtorCount = 0;

struct Resource
{
    int id = 0;
    ~Resource()
    {
        dtorCount = dtorCount + 1;
    }
    // A method that RETURNS `this`: the receiver escapes into the result, so an owning receiver
    // temp must never be released at the statement boundary.
    Resource* self() { return this; }
    // A method that only READS through `this`: the receiver provably cannot outlive the call.
    int idOf() { return id; }
    // Reads an argument only; used as the '?.' guarded-chain receiver in the arm-flush legs.
    int readId(int v) { return v; }
};

struct Container
{
    Resource* item = nullptr;

    void reset()
    {
        if (item != nullptr) { delete item; item = nullptr; }
    }

    ~Container()
    {
        if (item != nullptr)
            delete item;
    }
};

// `unique` field ownership: the compiler-synthesized destructor deletes the pointer,
// so this needs none of ~Container's hand-written free above.
struct UniqueBox
{
    unique Resource* item = nullptr;

    // Bare self-field assign inside a method. This carries no FieldName (it resolves through
    // GetMemberVariable), so the reassignment free is skipped by a runtime old-vs-new compare
    // rather than by name matching; without it this frees and then stores a dangling pointer.
    void selfAssignBare() { item = item; }
};

// `unique` composes with a hand-written destructor. The user dtor runs FIRST, so releasing
// the field early leaves the synthesized delete looking at nullptr - not a double free.
// Stage 2 note: this used to spell the release `delete item; item = nullptr;`. A hand-written
// delete of a `unique` field is now rejected outright (err_unique_delete_field) because the
// un-nulled form of it is a double-free, and it is no longer needed - assigning nullptr frees
// the pointee on its own, which is exactly what this exercises.
struct UniqueFreesItself
{
    unique Resource* item = nullptr;

    ~UniqueFreesItself()
    {
        item = nullptr;
    }
};

// Transitive: deleting the outer `unique` field runs UniqueBox's synthesized
// destructor, which in turn deletes its own `unique` field.
struct UniqueOuter
{
    unique UniqueBox* inner = nullptr;
};

/*
 * `unique` on an INTERFACE field. Ownership has to live in the contract: a store through the
 * interface's byte-offset slot is dispatched dynamically, so the concrete type is unknown and
 * the access site can only learn the slot is owning from the interface itself. Both sides must
 * agree - the two disagreements are rejected (err_unique_iface_field_impl_only /
 * err_unique_iface_field_iface_only). This is the field analogue of `push(move T item)`.
 */
interface IUniqueBox
{
    unique Resource* item;
    int tag();
};

class UniqueIfaceBox : IUniqueBox
{
    unique Resource* item = nullptr;
    int tag() { return 1; }
};

// Fixture for the cross-block `unique <interface>` deref regression below: a plain interface
// (no owning field), so its dtor is a no-op and does not perturb dtorCount.
interface IGuardBox { int tag(); };
class GuardBoxImpl : IGuardBox { int tag() { return 42; } };

// Returns false, but not as a compile-time-foldable literal: keeps the 'if' below a genuine
// runtime branch (not eliminated) for the cross-block interface regression.
int gGuardFlag = 0;
bool RuntimeFalse() { return gGuardFlag != 0; }

// A wrapper that never returns on ANY path. It carries no LLVM 'noreturn' attribute, so the
// moved-deref analysis has to PROVE it (nulldf::FunctionNeverReturns) for a `if (c) { dieNow(); }`
// guard to suppress. Never actually called - the guard below is behind RuntimeFalse().
void dieNow() { printf("unreachable handoff\n"); exit(1); }

// Two INTERFACE PARAMETER receivers of the implicit move. This shape ABORTED (rc 134) before the
// 2026-08-10 ruling: neither parameter resolves to a box, so the store aliased one pointee.
// Returns the moved-in id, or -1 when the source was not nulled.
int uimStealAcrossIfaceParams(IUniqueBox ia, IUniqueBox ic)
{
    ic.item = ia.item;
    return ia.item == nullptr ? ic.item->id : -1;
}

// Reassign through the interface's field slot: the old pointee is freed here, not orphaned.
int storeViaIface(IUniqueBox h)
{
    h.item = new Resource();
    h.item->id = 21;
    return h.tag();
}

// `nullptr` through the interface slot is the same release-early idiom as on a direct field.
void releaseViaIface(IUniqueBox h)
{
    h.item = nullptr;
}

// Composite-ownership shape: 'Bag' owns its 'item' (a Resource*) and an array
// of 'RouteEntry' (each of which owns its own 'name' Resource*). Each layer's
// destructor frees only its own fields; cross-layer cleanup happens by chained
// destructor invocation ('delete[n] entries' calls ~RouteEntry on every slot).
struct RouteEntry
{
    Resource* name = nullptr;
    ~RouteEntry()
    {
        if (name != nullptr) delete name;
    }
};

struct Bag
{
    Resource*    item    = nullptr;
    RouteEntry*  entries = nullptr;

    ~Bag()
    {
        if (item != nullptr) delete item;
        if (entries != nullptr) delete[3] entries;
    }
};

// Worker-style payload: pointer to an external observer slot plus a value.
// Mirrors Test/repro_new_struct.cb but stays single-threaded so the test
// is hermetic. The caller hands the owning pointer to 'workerMove' which
// performs the side effect through ->slot, then ownership ends at the
// callee's scope exit - exactly the pattern repro_new_struct.cb needs.
struct Slot
{
    int* slot  = nullptr;
    int  value = 0;
    ~Slot()
    {
        dtorCount = dtorCount + 1;
    }
};

// Move param: side-effects through the pointer, never calls 'delete'.
// Ownership ends when the function returns (scope-exit cleanup frees it).
int workerMove(move Slot* s)
{
    *s->slot = s->value;
    return s->value;
}

// Move param with an explicit 'delete': proves that an in-body delete
// nulls the parameter's alloca so the scope-exit cleanup does not
// double-free. This is the safe analogue of the unsafe pattern in
// Test/errors/err_delete_borrowed_via_cast.cb.
int workerMoveDelete(move Slot* s)
{
    *s->slot = s->value;
    int v = s->value;
    delete s;
    return v;
}

// move parameter takes ownership - Resource is deleted when consume returns
void consume(move Resource* r)
{
    // use r inside the function
    int x = r->id;
}

// non-move parameter borrows - caller still owns
void borrow(Resource* r)
{
    int x = r->id;
}

// D4: a `unique` parameter is a synthesized move parameter - it takes ownership and
// frees the Resource when the function returns, exactly like `consume(move Resource*)`.
void sinkUnique(unique Resource* r)
{
    int x = r->id;
}

// Move/borrow overload pair: 'move' participates in mangling and overload selection.
// probe(move Resource*) returns 100 + id and takes ownership (deletes r).
// probe(Resource*)      returns 200 + id and borrows.
int probe(move Resource* r)
{
    int id = r->id;
    delete r;
    return 100 + id;
}

int probe(Resource* r)
{
    return 200 + r->id;
}

// Helper: r is a borrowed (non-move) parameter, so probe(r) must pick the borrow overload.
int delegateProbe(Resource* r)
{
    return probe(r);
}

// Helper for the explicit-move readable-as-null regression below: a plain read/pass of a
// moved-out pointer (no dereference) must stay legal, so this only compares against nullptr.
int isNullResource(Resource* r)
{
    return r == nullptr ? 1 : 0;
}

// Helper for the address-escape cross-block regression below: rewrites *slot through an
// escaped address, exercising the AddressEscaped latch on the caller's moved-out local.
void refillResource(Resource** slot, int id)
{
    *slot = new Resource();
    (*slot)->id = id;
}

// move T* return type - ownership propagates to caller
move Resource* createResource(int id)
{
    Resource* r = new Resource();
    r->id = id;
    return r;
}

move Resource* forwardResource(move Resource* r)
{
    return r;
}

// ── list<string> helpers ──────────────────────────────────────────────────────
// Passing list<string> value/pointer as a free-function parameter is a known
// limitation; these helpers operate on extracted string values instead.

string echoString(string s)
{
    return s;
}

// Two-hop relay: string passes through two function calls
string relayString(string s)
{
    return echoString(s);
}

// Three-hop relay
string relayStringDeep(string s)
{
    return relayString(s);
}

int testListStringMove()
{
    int passed = 0;

    // Basic list<string> operations: add, count, get
    {
        list<string> words;
        string a = "" + "apple";
        string b = "" + "banana";
        string c = "" + "cherry";
        words.add(a);
        words.add(b);
        words.add(c);
        passed += Test("list_string_count", words.count(), 3);
        passed += Test("list_string_get0",  words.get(0), "apple");
        passed += Test("list_string_get1",  words.get(1), "banana");
        passed += Test("list_string_get2",  words.get(2), "cherry");
    }

    // removeAt: verify element is removed and count updates
    {
        list<string> words;
        string a = "" + "first";
        string b = "" + "second";
        string c = "" + "third";
        words.add(a);
        words.add(b);
        words.add(c);
        words.removeAt(1);
        passed += Test("list_string_remove_count", words.count(), 2);
        passed += Test("list_string_remove_get0",  words.get(0), "first");
        passed += Test("list_string_remove_get1",  words.get(1), "third");
    }

    // Strings extracted from list survive passing through function calls
    // (regression: string values were corrupted when passed across functions)
    {
        list<string> words;
        string w1 = "" + "hello";
        string w2 = "" + "world";
        words.add(w1);
        words.add(w2);

        string r1 = echoString(words.get(0));     // one hop
        string r2 = relayString(words.get(1));    // two hops
        string r3 = relayStringDeep(words.get(0)); // three hops
        passed += Test("list_string_one_hop",   r1, "hello");
        passed += Test("list_string_two_hop",   r2, "world");
        passed += Test("list_string_three_hop", r3, "hello");
    }

    return passed;
}

// ── recursive owning-pointer-tree free (X4 Part 2 regression) ─────────────────
// Passing a FIELD (node->left / node->right) to a 'move' parameter must mark only
// that field as moved, not the whole base 'node' - otherwise the second field
// access is wrongly rejected as "use of moved variable 'node'". This is the
// canonical Huffman/AST shape: a recursive free over an owning pointer tree.
struct TreeNode
{
    TreeNode* left  = nullptr;
    TreeNode* right = nullptr;
    ~TreeNode()
    {
        dtorCount = dtorCount + 1;
    }
};

void freeTree(move TreeNode* node)
{
    if (node == nullptr) return;
    freeTree(node->left);    // moving node->left must NOT poison node ...
    freeTree(node->right);   // ... so this line still compiles.
    delete node;
}

int testRecursiveTreeFree()
{
    int passed = 0;

    // 3-level full binary tree: 1 root + 2 children + 4 grandchildren = 7 nodes.
    dtorCount = 0;
    {
        TreeNode* root = new TreeNode();
        root->left  = new TreeNode();
        root->right = new TreeNode();
        root->left->left   = new TreeNode();
        root->left->right  = new TreeNode();
        root->right->left  = new TreeNode();
        root->right->right = new TreeNode();
        freeTree(root);
        // root is moved into freeTree; scope exit is a no-op. Every node freed once.
    }
    passed += Test("recursive_tree_free_all_freed_once", dtorCount, 7);

    return passed;
}

// A destructor that recursively deletes its own children. Leaf children are null,
// so 'delete left'/'delete right' must treat a null pointer as a no-op rather than
// invoking the destructor on null (which would dereference null and crash).
struct CascadeNode
{
    CascadeNode* left  = nullptr;
    CascadeNode* right = nullptr;
    ~CascadeNode()
    {
        dtorCount = dtorCount + 1;
        delete left;    // null on leaves: delete must be a safe no-op
        delete right;
    }
};

int testDeleteNullCascade()
{
    int passed = 0;

    // root + 2 children; grandchildren are null. 'delete root' cascades through the
    // destructor, hitting 'delete nullptr' on every leaf. All three freed once, no crash.
    dtorCount = 0;
    {
        CascadeNode* root = new CascadeNode();
        root->left  = new CascadeNode();
        root->right = new CascadeNode();
        delete root;
    }
    passed += Test("delete_null_cascade_frees_all", dtorCount, 3);

    return passed;
}

// Recursive container: a node owns its children in a `list<TreeBox*>` field. Because
// TreeBox's own field forces `list<TreeBox*>` to be monomorphized while TreeBox is still
// incomplete, the generic list destructor used to bind its element `delete` to a null
// destructor and leak the entire subtree. The deferred delete-site destructor fix makes
// `~list<TreeBox*>` free each element (recursing through this destructor).
struct TreeBox
{
    int id = 0;
    list<unique TreeBox*> children = default;
    ~TreeBox()
    {
        dtorCount = dtorCount + 1;
    }
};

int testRecursiveContainerFree()
{
    int passed = 0;

    // 3-deep chain held through list<TreeBox*> fields: root -> child -> grandchild.
    // When 'roots' goes out of scope, ~list frees root; ~TreeBox destructs root.children,
    // which frees child; and so on. All three freed exactly once.
    dtorCount = 0;
    {
        list<unique TreeBox*> roots;
        TreeBox* root  = new TreeBox(); root->id  = 1;
        TreeBox* child = new TreeBox(); child->id = 2;
        TreeBox* grand = new TreeBox(); grand->id = 3;
        child->children.add(grand);
        root->children.add(child);
        roots.add(root);
    }
    passed += Test("recursive_container_frees_all", dtorCount, 3);

    return passed;
}

// Same self-referential-element hazard as TreeBox, applied to dictionary/stack/queue
// teardown and to list's other non-dtor release paths (clear/removeAt). Each element
// struct monomorphizes its own container field while the struct is still incomplete.
struct DictNode
{
    int id = 0;
    dictionary<int, unique DictNode*> kids = default;
    ~DictNode()
    {
        dtorCount = dtorCount + 1;
    }
};

struct StkNode
{
    int id = 0;
    stack<unique StkNode*> kids = default;
    ~StkNode()
    {
        dtorCount = dtorCount + 1;
    }
};

struct QueNode
{
    int id = 0;
    queue<unique QueNode*> kids = default;
    ~QueNode()
    {
        dtorCount = dtorCount + 1;
    }
};

int testSelfRefContainerRelease()
{
    int passed = 0;

    // dictionary teardown: scope exit frees the whole root -> child -> grand chain.
    dtorCount = 0;
    {
        dictionary<int, unique DictNode*> roots;
        DictNode* root  = new DictNode(); root->id  = 1;
        DictNode* child = new DictNode(); child->id = 2;
        DictNode* grand = new DictNode(); grand->id = 3;
        child->kids.set(0, grand);
        root->kids.set(0, child);
        roots.set(0, root);
    }
    passed += Test("dict_selfref_dtor_frees_all", dtorCount, 3);

    // dictionary remove(): the removed entry's subtree is freed immediately, before scope exit.
    dtorCount = 0;
    {
        dictionary<int, unique DictNode*> roots;
        DictNode* root  = new DictNode(); root->id  = 1;
        DictNode* child = new DictNode(); child->id = 2;
        DictNode* grand = new DictNode(); grand->id = 3;
        child->kids.set(0, grand);
        root->kids.set(0, child);
        roots.set(0, root);
        roots.remove(0);
        passed += Test("dict_selfref_remove_frees_all", dtorCount, 3);
    }

    // stack teardown: scope exit frees the whole chain.
    dtorCount = 0;
    {
        stack<unique StkNode*> roots;
        StkNode* root  = new StkNode(); root->id  = 1;
        StkNode* child = new StkNode(); child->id = 2;
        StkNode* grand = new StkNode(); grand->id = 3;
        child->kids.push(grand);
        root->kids.push(child);
        roots.push(root);
    }
    passed += Test("stack_selfref_dtor_frees_all", dtorCount, 3);

    // queue teardown: scope exit frees the whole chain.
    dtorCount = 0;
    {
        queue<unique QueNode*> roots;
        QueNode* root  = new QueNode(); root->id  = 1;
        QueNode* child = new QueNode(); child->id = 2;
        QueNode* grand = new QueNode(); grand->id = 3;
        child->kids.enqueue(grand);
        root->kids.enqueue(child);
        roots.enqueue(root);
    }
    passed += Test("queue_selfref_dtor_frees_all", dtorCount, 3);

    // list clear(): the whole chain is freed immediately, before scope exit.
    dtorCount = 0;
    {
        list<unique TreeBox*> roots;
        TreeBox* root  = new TreeBox(); root->id  = 1;
        TreeBox* child = new TreeBox(); child->id = 2;
        TreeBox* grand = new TreeBox(); grand->id = 3;
        child->children.add(grand);
        root->children.add(child);
        roots.add(root);
        roots.clear();
        passed += Test("list_selfref_clear_frees_all", dtorCount, 3);
    }

    // list removeAt(0): same shape, freed via removeAt instead of clear().
    dtorCount = 0;
    {
        list<unique TreeBox*> roots;
        TreeBox* root  = new TreeBox(); root->id  = 1;
        TreeBox* child = new TreeBox(); child->id = 2;
        TreeBox* grand = new TreeBox(); grand->id = 3;
        child->children.add(grand);
        root->children.add(child);
        roots.add(root);
        roots.removeAt(0);
        passed += Test("list_selfref_removeat_frees_all", dtorCount, 3);
    }

    return passed;
}

int testUniqueField()
{
    int passed = 0;

    // The synthesized destructor frees the `unique` field - UniqueBox has no user dtor.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
    }
    passed += Test("unique_field_freed_by_synth_dtor", dtorCount, 1);

    // A `unique` field left null is skipped by the null check, not freed.
    dtorCount = 0;
    {
        UniqueBox b;
    }
    passed += Test("unique_null_field_not_freed", dtorCount, 0);

    // Stage 2 - the user dtor's `item = nullptr` frees it, leaving the synthesized delete
    // a no-op: composition without a double free.
    dtorCount = 0;
    {
        UniqueFreesItself u;
        u.item = new Resource();
    }
    passed += Test("unique_composes_with_user_dtor", dtorCount, 1);

    // Outer deletes inner; inner's synthesized dtor deletes its own `unique` field.
    dtorCount = 0;
    {
        UniqueOuter o;
        o.inner = new UniqueBox();
        o.inner->item = new Resource();
    }
    passed += Test("unique_transitive_chain_freed", dtorCount, 1);

    // Heap-owned struct: `delete` routes through the synthesized full destructor.
    dtorCount = 0;
    {
        UniqueBox* hb = new UniqueBox();
        hb->item = new Resource();
        delete hb;
        passed += Test("unique_field_freed_on_delete", dtorCount, 1);
    }
    passed += Test("unique_no_double_free_after_delete", dtorCount, 1);

    // Brace-init is a second field-store path (EmitOneFieldInit): storing an owning local into a
    // `unique` field must transfer ownership exactly as `=` does, or BOTH the local's scope-exit
    // cleanup and the field's synthesized destructor free the one pointee (a double free).
    dtorCount = 0;
    {
        Resource* r = new Resource();
        UniqueBox b = { item = r };
        passed += Test("unique_brace_init_alive_before_teardown", dtorCount, 0);
    }
    passed += Test("unique_brace_init_owning_local_freed_once", dtorCount, 1);

    // Stage 2 - reassignment destructs first: overwriting a live `unique` field frees the
    // old pointee rather than orphaning it. 3 stores => 2 freed on reassign, 1 at teardown.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item = new Resource();
        b.item = new Resource();
        passed += Test("unique_reassign_frees_old", dtorCount, 2);
    }
    passed += Test("unique_reassign_last_freed_at_teardown", dtorCount, 3);

    // Stage 2 - assigning nullptr releases the pointee early (the sanctioned idiom, and the
    // reason a hand-written `delete` on a unique field is both unnecessary and rejected).
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item = nullptr;
        passed += Test("unique_nullptr_releases_early", dtorCount, 1);
    }
    passed += Test("unique_nullptr_release_no_double_free", dtorCount, 1);

    // Stage 2 - self-assign must not free-then-store a dangling pointer.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item = b.item;
        passed += Test("unique_self_assign_does_not_free", dtorCount, 0);
    }
    passed += Test("unique_self_assign_freed_once_at_teardown", dtorCount, 1);

    // Stage 2 - same, spelled bare inside a method (no FieldName to match on).
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.selfAssignBare();
        passed += Test("unique_bare_self_assign_does_not_free", dtorCount, 0);
    }
    passed += Test("unique_bare_self_assign_freed_once_at_teardown", dtorCount, 1);

    // Stage 2 - `move` transfers ownership into a unique field (the accepted spelling of
    // the borrow that err_unique_borrow_into_field rejects). Freed once, by the field.
    dtorCount = 0;
    {
        UniqueBox b;
        Resource* fresh = new Resource();
        b.item = move fresh;
        passed += Test("unique_move_into_field_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_move_into_field_freed_once", dtorCount, 1);

    // Stage 3 (Trap B) - `move` OUT of a unique field is the sanctioned extraction: it nulls
    // the field, so the local owns the pointee and the synthesized dtor finds nothing to free.
    // This is the counterpart to err_unique_delete_alias, where a plain copy is rejected.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        b.item->id = 7;
        Resource* owned = move b.item;
        passed += Test("unique_move_out_field_id_intact", owned->id, 7);
        passed += Test("unique_move_out_field_not_freed_yet", dtorCount, 0);
        delete owned;
        passed += Test("unique_move_out_field_freed_by_local", dtorCount, 1);
        // Scope exit: the field was nulled by the move, so the synthesized delete is a no-op.
    }
    passed += Test("unique_move_out_field_no_double_free", dtorCount, 1);

    // Stage 3 (Trap B) - a local aliasing a `unique` field is a borrow, not an owner: reading
    // and writing THROUGH it stays legal, and it is the field that frees, exactly once. Only
    // `delete alias` is rejected.
    dtorCount = 0;
    {
        UniqueBox b;
        b.item = new Resource();
        Resource* alias = b.item;
        alias->id = 42;
        passed += Test("unique_alias_read_through", b.item->id, 42);
        passed += Test("unique_alias_borrow_does_not_free", dtorCount, 0);
    }
    passed += Test("unique_alias_freed_once_by_field", dtorCount, 1);

    // Stage 3 (Trap B) - the borrow marking must not leak into an ordinary pointer field:
    // `Container.item` is not `unique`, so laundering it through a local and deleting the
    // local stays legal (the ~254 unmarked pointer fields keep today's semantics exactly).
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
        Resource* a = c.item;
        delete a;
        c.item = nullptr;   // ~Container would otherwise free the same pointer
        passed += Test("plain_field_alias_delete_still_legal", dtorCount, 1);
    }
    passed += Test("plain_field_alias_delete_freed_once", dtorCount, 1);

    // Brace-init is a second, independent field-store path (EmitOneFieldInit). A fresh
    // allocation through it is owned by the field and freed exactly once at teardown - the
    // borrow spelling is rejected (err_unique_brace_init_borrow).
    dtorCount = 0;
    {
        UniqueBox b = { item = new Resource() };
        b.item->id = 5;
        passed += Test("unique_brace_init_fresh_id", b.item->id, 5);
        passed += Test("unique_brace_init_fresh_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_brace_init_fresh_freed_once", dtorCount, 1);

    // Brace-init with an explicit `move`: ownership transfers to the field, which frees once.
    dtorCount = 0;
    {
        Resource* fresh = new Resource();
        UniqueBox b = { item = move fresh };
        passed += Test("unique_brace_init_move_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_brace_init_move_freed_once", dtorCount, 1);

    // The brace-init guards are keyed on `unique`, so an ORDINARY pointer field brace-initialized
    // from a borrow is untouched - it stores the borrow and frees nothing, exactly as before.
    dtorCount = 0;
    {
        Resource* owned = new Resource();
        owned->id = 11;
        {
            Container c = { item = owned };
            passed += Test("plain_brace_init_borrow_reads_through", c.item->id, 11);
            c.item = nullptr;   // ~Container would otherwise free the borrow
        }
        passed += Test("plain_brace_init_borrow_not_freed_by_field", dtorCount, 0);
        delete owned;
        passed += Test("plain_brace_init_borrow_freed_by_owner", dtorCount, 1);
    }

    // `move` between two `unique` fields is the sanctioned transfer: it nulls the source, so
    // only the destination frees. The plain copy `c.item = a.item` is rejected
    // (err_unique_field_to_field) precisely because it would leave both fields owning.
    dtorCount = 0;
    {
        UniqueBox a;
        UniqueBox c;
        a.item = new Resource();
        a.item->id = 13;
        c.item = move a.item;
        passed += Test("unique_field_to_field_move_id_intact", c.item->id, 13);
        passed += Test("unique_field_to_field_move_source_nulled", a.item == nullptr ? 1 : 0, 1);
        passed += Test("unique_field_to_field_move_not_freed_early", dtorCount, 0);
    }
    passed += Test("unique_field_to_field_move_freed_once", dtorCount, 1);

    // Explicit 'move' of a whole thin `unique` pointer LOCAL (not a field): the source is nulled
    // but, by design, stays plain-readable - only a SAME-BLOCK DEREFERENCE of it is a compile
    // error (see Test/errors/err_move.cb's dereference-of-explicitly-moved-pointer legs). Covers
    // a nullptr comparison, passing it to a function, and comparing it as an int - none of these
    // are dereferences, so all must still compile and run correctly.
    dtorCount = 0;
    {
        unique Resource* p = new Resource();
        p->id = 7;
        unique Resource* q = move p;
        passed += Test("explicit_move_local_dest_intact", q->id, 7);
        passed += Test("explicit_move_local_source_nulled", p == nullptr ? 1 : 0, 1);
        passed += Test("explicit_move_local_source_pass_to_function", isNullResource(p), 1);
        passed += Test("explicit_move_local_source_compare_as_int", (int)(p == nullptr), 1);
        passed += Test("explicit_move_local_not_freed_early", dtorCount, 0);

        // Reassigning the moved-out source makes it live again: a subsequent DEREFERENCE
        // must compile and run correctly (the deref guard only fires while still moved-null).
        p = new Resource();
        p->id = 9;
        passed += Test("explicit_move_local_reassign_then_deref", p->id, 9);
    }
    passed += Test("explicit_move_local_freed_once_each", dtorCount, 2);

    // Cross-block positive legs: neither the same-block predicate nor the MAY-null fixpoint may
    // fire on these (see internal/issue/deref-of-moved-pointer-guard-inside-callee.md):
    dtorCount = 0;
    {
        // F1 shape: a null-guarded deref in a DIFFERENT block from the move (an 'if', which
        // actually branches - unlike '?:', which lowers to an eager select in the SAME block
        // and so is NOT covered; see the ternary caveat in the issue file). The move's block-id
        // latch means the guard cannot see this, so it must compile and run correctly.
        unique Resource* g = new Resource();
        g->id = 11;
        unique Resource* g2 = move g;
        int guarded = -1;
        if (g != nullptr) { guarded = g->id; }
        passed += Test("cross_block_null_guarded_deref", guarded, -1);

        // F2 shape: the address of a moved-out local escapes to an out-parameter that may
        // rewrite it; a later deref must compile and run correctly (AddressEscaped latch).
        unique Resource* h = new Resource();
        unique Resource* h2 = move h;
        refillResource(&h, 13);
        passed += Test("address_escape_then_deref", h->id, 13);

        // F3 shape: move happens only inside one conditional arm (decl-init, not a reassignment -
        // reassigning a previously-nullptr `unique` local via 'move' is a separate, pre-existing
        // ownership-tracking gap, out of scope here and not exercised by this regression); a
        // GUARDED deref after the branch merges must compile and run correctly (the same-block
        // predicate never sees the branch's block). Uses 'if', not '?:' - see the ternary caveat
        // above: '?:' lowers to an eager select that evaluates BOTH arms unconditionally, so a
        // ternary-guarded deref of a pointer that is null in the untaken arm crashes regardless
        // of this fix (also pre-existing, also out of scope).
        unique Resource* k = new Resource();
        k->id = 17;
        if (k != nullptr) { unique Resource* k2 = move k; }
        int afterBranch = -1;
        if (k != nullptr) { afterBranch = k->id; }
        passed += Test("cross_block_conditional_move_then_deref", afterBranch, -1);

        // F3 shape, `unique <interface>` local: a moved interface local is nulled but plain-
        // readable, exactly like a moved thin pointer, so the same null-check escape hatch
        // applies. The GUARDED deref after the conditional move must compile and run correctly;
        // the unguarded form is a compile error (err_move.cb).
        unique IGuardBox ig = new GuardBoxImpl();
        if (RuntimeFalse()) { unique IGuardBox ig2 = move ig; }
        int ifaceGuarded = -1;
        if (ig != nullptr) { ifaceGuarded = ig.tag(); }
        passed += Test("cross_block_conditional_move_then_deref_interface", ifaceGuarded, 42);
    }
    passed += Test("cross_block_legs_no_leak", dtorCount, 4);

    // Guard legs for the cross-block moved-deref analysis. Every leg below dereferences a local
    // that IS maybe-moved on the merged path, but under a guard - so the deref sits inside a
    // branch the move was not under, and the control-dependence rule must suppress it. A
    // regression shows up here as a COMPILE ERROR, not as a wrong value.
    dtorCount = 0;
    {
        unique Resource* n1 = new Resource();
        n1->id = 19;
        if (RuntimeFalse()) { unique Resource* n1b = move n1; }
        int narrowed = -1;
        if (n1 == nullptr) { narrowed = -2; } else { narrowed = n1->id; }
        passed += Test("cross_block_else_branch_narrowing", narrowed, 19);

        // The guard is the loop's own condition, which reads the pointer - the read alone
        // suppresses, and the body may dereference even though it moves the local out.
        unique Resource* n2 = new Resource();
        n2->id = 23;
        int loopSeen = 0;
        while (n2 != nullptr)
        {
            loopSeen = n2->id;
            unique Resource* n2b = move n2;
        }
        passed += Test("loop_condition_narrowing_then_deref", loopSeen, 23);

        // A guarded move followed by a guarded deref: the deref's branch is not one the move
        // was under, so it is suppressed.
        unique Resource* n3 = new Resource();
        n3->id = 29;
        if (n3 != nullptr) { unique Resource* n3b = move n3; }
        int afterGuardedMove = -1;
        if (n3 != nullptr) { afterGuardedMove = n3->id; }
        passed += Test("guarded_move_then_guarded_deref", afterGuardedMove, -1);

        // The `x == nullptr` repair guard with NO else. The merge block is NOT control-dependent
        // on that branch, so this leg is carried by the read-kill: forming the guard reads the
        // pointer, and a read between the move and the deref suppresses the report.
        unique Resource* n4 = new Resource();
        n4->id = 31;
        if (RuntimeFalse()) { unique Resource* n4b = move n4; }
        if (n4 == nullptr) { n4 = new Resource(); n4->id = 37; }
        passed += Test("repair_guard_narrowing_then_deref", n4->id, 31);

        // Short-circuit '&&' OUTSIDE a branch condition (here an initializer). The RHS block is
        // control-dependent on the LHS test, and the LHS reads the pointer - suppressed twice
        // over, with no special-casing of '&&' anywhere in the compiler.
        unique Resource* n5 = new Resource();
        n5->id = 41;
        if (RuntimeFalse()) { unique Resource* n5b = move n5; }
        bool shortCircuit = n5 != nullptr && n5->id == 41;
        passed += Test("short_circuit_and_outside_condition", shortCircuit ? 1 : 0, 1);

        // The null guard hoisted into a bool local. No alias tracking is involved: the deref
        // simply sits inside `if (live)`, a branch the move was not under.
        unique Resource* n6 = new Resource();
        n6->id = 43;
        if (RuntimeFalse()) { unique Resource* n6b = move n6; }
        bool live = n6 != nullptr;
        int viaBool = -1;
        if (live) { viaBool = n6->id; }
        passed += Test("bool_alias_guard_narrowing", viaBool, 43);

        // The same through the opposite polarity, with the deref in the else arm.
        unique Resource* n7 = new Resource();
        n7->id = 47;
        if (RuntimeFalse()) { unique Resource* n7b = move n7; }
        bool gone = n7 == nullptr;
        int viaNegBool = -1;
        if (gone) { viaNegBool = -2; } else { viaNegBool = n7->id; }
        passed += Test("bool_alias_negated_guard_narrowing", viaNegBool, 47);

        // An INDIRECT guard bool: the null test happens inside a helper, so nothing about the
        // guard is interpretable - which is exactly the point, the rule never interprets it.
        unique Resource* n8 = new Resource();
        n8->id = 53;
        if (RuntimeFalse()) { unique Resource* n8b = move n8; }
        bool present = isNullResource(n8) == 0;
        int viaHelper = -1;
        if (present) { viaHelper = n8->id; }
        passed += Test("indirect_bool_guard_narrowing", viaHelper, 53);

        // The correlated-scrutinee guard: the move and the deref are guarded by two conditions on
        // the SAME unrelated value, and the pointer is never mentioned in either. No amount of
        // guard recognition can see this one - only the fact that the deref sits under a branch
        // the move was not under. This is the shape that defeats every read-based rule.
        int sel = RuntimeFalse() ? 200 : 1;
        unique Resource* n9 = new Resource();
        n9->id = 59;
        if (sel > 100) { unique Resource* n9b = move n9; }
        int viaCorrelated = -1;
        if (sel <= 100) { viaCorrelated = n9->id; }
        passed += Test("correlated_scrutinee_guard", viaCorrelated, 59);

        // A TERMINATING guard rather than a skipping one: the branch does not step around the
        // deref, it ends the process. Control dependence alone cannot see that (the deref still
        // post-dominates the branch), so ComputePostDominators has to treat an exit()/abort()
        // block as an end of the program. The exit is never reached at runtime here - the point
        // of the leg is that it COMPILES.
        unique Resource* n10 = new Resource();
        n10->id = 61;
        bool handedOff = false;
        if (RuntimeFalse()) { unique Resource* n10b = move n10; handedOff = true; }
        if (handedOff) { printf("unreachable handoff\n"); exit(1); }
        passed += Test("terminating_guard_then_deref", n10->id, 61);

        // Same terminating guard, but routed through a wrapper instead of a literal exit() call.
        // Suppression here depends on the wrapper having been PROVEN never-returning when its
        // body completed, which is why dieNow is defined above this function and not below it.
        unique Resource* n11 = new Resource();
        n11->id = 67;
        bool handedOff2 = false;
        if (RuntimeFalse()) { unique Resource* n11b = move n11; handedOff2 = true; }
        if (handedOff2) { dieNow(); }
        passed += Test("terminating_wrapper_guard_then_deref", n11->id, 67);
    }
    passed += Test("guard_legs_no_leak", dtorCount, 11);

    // A `unique` field reached through an interface's byte-offset slot gets the same store-site
    // guards as a direct field read: the flag rides the interface's field declaration, which the
    // access site binds from. Reassigning through the slot frees the old pointee.
    dtorCount = 0;
    {
        UniqueIfaceBox b;
        b.item = new Resource();
        storeViaIface(b);
        passed += Test("unique_iface_slot_reassign_frees_old", dtorCount, 1);
        passed += Test("unique_iface_slot_reassign_writes_same_slot", b.item->id, 21);
    }
    passed += Test("unique_iface_slot_reassign_freed_at_teardown", dtorCount, 2);

    // Releasing early through the interface slot frees once, and leaves the synthesized
    // destructor looking at nullptr rather than double-freeing.
    dtorCount = 0;
    {
        UniqueIfaceBox b;
        b.item = new Resource();
        releaseViaIface(b);
        passed += Test("unique_iface_slot_nullptr_releases_early", dtorCount, 1);
    }
    passed += Test("unique_iface_slot_release_no_double_free", dtorCount, 1);

    return passed;
}

int testFieldOwnership()
{
    int passed = 0;

    // Destructor frees its own field exactly once.
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
    }
    passed += Test("dtor_frees_own_field", dtorCount, 1);

    // Member method frees the field; destructor sees nullptr and does nothing.
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
        c.reset();
        passed += Test("method_reset_freed", dtorCount, 1);
        // Scope exit: ~Container runs; c.item == nullptr so no second free.
    }
    passed += Test("no_double_free_after_reset", dtorCount, 1);

    // External code extracts the field via 'move' and frees the local. The
    // owner's field is nulled by the move, so its destructor is a no-op.
    dtorCount = 0;
    {
        Container c;
        c.item = new Resource();
        {
            Resource* taken = move c.item;
            passed += Test("field_nulled_after_move", c.item == nullptr, true);
            delete taken;
        }
        passed += Test("move_then_delete_frees_once", dtorCount, 1);
        // Scope exit: ~Container runs; c.item == nullptr so dtorCount stays 1.
    }
    passed += Test("owner_dtor_skips_moved_field", dtorCount, 1);

    // Move from a heap-owned container pointer works the same way.
    dtorCount = 0;
    {
        Container* hc = new Container();
        hc->item = new Resource();
        Resource* taken = move hc->item;
        delete taken;
        delete hc;
    }
    passed += Test("move_from_heap_container", dtorCount, 1);

    return passed;
}

// ── owning-string by-value param stored into a field (param -> field regression) ──────
// A factory that stores a plain (non-move) by-value `string` parameter into a struct field
// must give the field an INDEPENDENT owned buffer. The argument is typically an owning concat
// temp that the CALLER frees at its end-of-statement cleanup; a shallow store would alias that
// buffer into the field, leaving it dangling - and silently corrupted once a later allocation
// reuses the freed block - after the factory returns. (A true move is impossible from the
// callee, so the param -> field store deep-copies.)
struct Labelled
{
    string label = default;
};

Labelled* makeLabelled(string s)
{
    Labelled* n = new Labelled();
    n.label = s;            // plain by-value param -> field: must deep-copy, not alias
    return n;
}

int testParamStringToField()
{
    int bad = 0;
    for (int i = 0; i < 1000; i++)
    {
        // Owning concat temp as the argument; the caller frees it after makeLabelled returns.
        Labelled* n = makeLabelled("item-" + i.toString());
        // A subsequent string allocation reuses the block freed if ownership leaked.
        string churn = "blah-" + i.toString() + "-padding-padding-padding";
        string want = "item-" + i.toString();
        if (n.label.indexOf(want) != 0) { bad = bad + 1; }
        delete n;           // ~Labelled frees the owned field copy exactly once
    }
    int passed = 0;
    passed += Test("param_string_to_field_survives", bad, 0);
    return passed;
}

// ── borrowed owning-string field read into a local (field -> local regression) ────────
// `string snap = obj.method()` (a plain method returning a field) and `string snap = obj.field`
// (a direct field read) both bind a non-owning BORROW of the field's buffer. A later store to
// the same field frees that buffer, so the local must hold an INDEPENDENT owned copy to survive
// (and so a heap object can be deleted while a snapshot is still live). Regression: before the
// fix the local aliased the field buffer and read garbage after a reassignment, and corrupted
// the heap on delete (a non-heap/pool pointer got freed).
class LabelHolder
{
    string lbl = default;
    string label() { return lbl; }
    void setLabel(string s) { lbl = s; }
};

interface ILabel
{
    string label();
    void setLabel(string s);
};

class HeapLabel : ILabel
{
    string lbl = default;
    string label() { return lbl; }
    void setLabel(string s) { lbl = s; }
    ~HeapLabel() { }
};

int testBorrowStringFieldIntoLocal()
{
    int passed = 0;

    // A method return is a BORROW of the field, so an independent snapshot needs `.copy()`;
    // it then survives a later setter store to the same field.
    {
        LabelHolder p;
        p.setLabel("final");
        string snap = p.label().copy();
        p.setLabel("changed");
        passed += Test("borrow_field_method_read_survives", snap, "final");
    }

    // Snapshot taken via a direct field read survives a later setter store.
    {
        LabelHolder q;
        q.setLabel("final");
        string snapQ = q.lbl;
        q.setLabel("changed");
        passed += Test("borrow_field_direct_read_survives", snapQ, "final");
    }

    // Heap object via an interface: a `.copy()` snapshot survives delete (no crash, no corruption);
    // the field's owned buffer is freed exactly once by the destructor on delete.
    {
        ILabel b = new HeapLabel();
        b.setLabel("final");
        string snap = b.label().copy();
        b.setLabel("changed");
        delete b;
        passed += Test("borrow_field_heap_snapshot_after_delete", snap, "final");
    }

    return passed;
}

// ── THE FLIP: copyable owners COPY on assign (Part 4) ─────────────────────────────────
// A copyable owner (string, list<T>) assigned from a NAMED source COPIES an independent
// duplicate and leaves the source LIVE - the opposite of the old move-on-assign. Mutating
// one side must not disturb the other. Covers every flipped site: decl-init, local reassign,
// field-to-field, owned-local-into-field, plain container store, and brace-init.
struct FlipRow  { string name = default; };
struct FlipBag  { list<int> xs = default; };

int testCopyOnAssignFlip()
{
    int passed = 0;

    // decl-init copy: source string stays live and independent of the copy.
    {
        string a = "he" + "llo";
        string b = a;
        b = b + "!";
        passed += Test("flip_declinit_string_src_live", a, "hello");
        passed += Test("flip_declinit_string_copy_indep", b, "hello!");
    }

    // local reassign copy: list source stays live; growing the copy does not grow the source.
    {
        list<int> xs = default; xs.add(1); xs.add(2);
        list<int> ys = default;
        ys = xs;
        ys.add(3);
        passed += Test("flip_reassign_list_src_count", xs.count(), 2);
        passed += Test("flip_reassign_list_copy_count", ys.count(), 3);
    }

    // field-to-field string copy: independent buffers.
    {
        FlipRow r1 = default; r1.name = ("wor" + "ld");
        FlipRow r2 = default;
        r2.name = r1.name;
        r2.name = r2.name + "!";
        passed += Test("flip_field_to_field_src", r1.name, "world");
        passed += Test("flip_field_to_field_copy", r2.name, "world!");
    }

    // owned string LOCAL into field copies; the local stays usable afterward.
    {
        FlipRow r = default;
        string tmp = "fre" + "sh";
        r.name = tmp;
        tmp = tmp + "!";
        passed += Test("flip_local_into_field_field", r.name, "fresh");
        passed += Test("flip_local_into_field_src", tmp, "fresh!");
    }

    // plain container store into field copies; the source list stays independent.
    {
        list<int> xs = default; xs.add(5); xs.add(6);
        FlipBag h = default;
        h.xs = xs;
        xs.add(7);
        passed += Test("flip_plainstore_bag_count", h.xs.count(), 2);
        passed += Test("flip_plainstore_src_count", xs.count(), 3);
    }

    // brace-init container into field copies; the source list stays independent.
    {
        list<int> ys = default; ys.add(8);
        FlipBag h2 = { xs = ys };
        ys.add(9);
        passed += Test("flip_braceinit_bag_count", h2.xs.count(), 1);
        passed += Test("flip_braceinit_src_count", ys.count(), 2);
    }

    return passed;
}

// ── value struct with an owning string field, moved into a list<T> via add() ──────────
// `list<T>.add(move T value)` MOVES the struct into `_data[i]`, so the list becomes the
// sole owner of each element's owning string field. Reading elements back - especially via
// `for (Holder h in list)`, which binds a by-value copy of each element to the loop variable
// and destructs it at loop exit - must NOT free the buffer the list still owns. `alias T get`
// returns a borrow whose owning-field OWNED bits are cleared, so a destructed copy is a no-op.
// Regression: before the fix the loop-variable copy freed the field, dangling the list element
// and double-freeing on teardown (process exit 127). Verifies the stored data is intact across
// later allocations and that teardown frees each buffer exactly once (reaching this point at
// all proves no double-free; data integrity proves no premature free).
struct Holder
{
    int id = 0;
    string name = default;
};

int testStructWithStringFieldIntoList()
{
    int bad = 0;
    int sumLen = 0;
    {
        list<Holder> holders;
        for (int i = 0; i < 50; i++)
        {
            Holder h = default;
            h.id = i;
            h.name = "holder-" + i.toString();   // owning string field
            holders.add(h);                       // MOVE struct into the list
        }
        // for-in binds a by-value copy per element and destructs it at loop exit; the
        // borrowed owning-string field must survive (no double-free, no corruption).
        for (Holder h in holders)
            sumLen = sumLen + h.name.length();
        // Churn allocations would reuse any buffer wrongly freed by the loop copies.
        for (int i = 0; i < 50; i++)
        {
            string churn = "padding-padding-padding-" + i.toString();
            if (churn.length() < 1) { bad = bad + 1; }
        }
        // Read back through indexing after the churn: every element must be intact.
        for (int i = 0; i < holders.count(); i++)
        {
            string want = "holder-" + i.toString();
            if (holders.get(i).name.indexOf(want) != 0) { bad = bad + 1; }
            if (holders.get(i).id != i) { bad = bad + 1; }
        }
        // `holders` (and every owned element string) is destructed here - exactly once.
    }
    int passed = 0;
    passed += Test("struct_string_field_into_list_intact", bad, 0);
    passed += Test("struct_string_field_into_list_sumlen", sumLen, 440); // 10*len("holder-N") + 40*len("holder-NN")
    return passed;
}

// D4/D5: `unique` on a local/parameter. A `unique X*` local is an owning location; a
// `unique X*` parameter is a synthesized move parameter. All checks are dtor-count based.
// A `move` parameter of a struct type OWNS its copy, so assigning it into an owning slot must
// TRANSFER (exactly as an owned local does). Copying instead left two owners of one `unique`
// pointer and double-freed when the parameter destructed at function exit.
struct MoveParamHolder { unique Resource* p = nullptr; };
MoveParamHolder moveParamSink = default;
void stashOwnedHolder(move MoveParamHolder h) { moveParamSink = h; }

// The two POINTER-return factory modes must both stay legal. Returning a fresh allocation
// through a BARE `FactoryHolder*` is rejected (the caller gets no ownership signal); the two
// annotated forms below are the sanctioned spellings and must keep working.
struct FactoryHolder { unique Resource* p = nullptr; };
// C / manual mode: 'alias' opts out of ownership tracking - the caller frees by hand.
alias FactoryHolder* makeManual() { return new FactoryHolder(); }
// RAII mode: a 'move' pointer return transfers ownership to a `unique` local.
move FactoryHolder* makeOwning() { return new FactoryHolder(); }

// An unannotated by-value struct return whose every path hands back a borrowed parameter is
// inferred as an 'alias' (borrow) return, so the caller does not become a second owner.
struct AliasInferHolder { unique Resource* p = nullptr; };
AliasInferHolder passthruHolder(AliasInferHolder h) { return h; }

// Gate guard: the uniformity rule fires only for a return type that owns a 'unique' pointer.
// A COPYABLE struct duplicates no ownership, so MIXED returns stay legal for it.
struct CopyableHolder { int v = 0; };
CopyableHolder pickCopyable(CopyableHolder h, int c)
{
    if (c != 0)
        return h;
    CopyableHolder t = default;
    t.v = 99;
    return t;
}


/*
 * ACCEPT set for the unique-field borrow provenance (the reject legs are in
 * Test/errors/err_move.cb). The proof is "EVERY pointer return reads a live `unique` FIELD" and
 * nothing weaker, so each accessor below must keep laundering exactly as it did before: a PLAIN
 * field owns nothing to double-free, a MIXED accessor proves nothing, and an indirect call has no
 * callee to read. Unknown ACCEPTS is the polarity - a false rejection here is the blocker.
 */
struct PlainBorrowWrap
{
    Resource* p = nullptr;
    alias Resource* borrowPlain() { return this.p; }
};
struct MixedBorrowWrap
{
    unique Resource* owned = nullptr;
    Resource* plain = nullptr;
    // One return proves the field read, the other does not: the fact retires for good.
    alias Resource* borrowEither(bool c) { if (c) { return this.owned; } return this.plain; }
};
struct IndirectBorrowWrap { unique Resource* p = nullptr; };
struct FieldBorrowAcceptWrap
{
    unique Resource* item = nullptr;
    alias Resource* borrowItem() { return this.item; }
};

int testUniqueLocalAndParam()
{
    int passed = 0;

    // Inferred 'alias' return: 'a' stays the only owner, so the payload is freed exactly once.
    dtorCount = 0;
    {
        AliasInferHolder a = default;
        a.p = new Resource();
        AliasInferHolder b = passthruHolder(a);
        int touch = b.p->id;
    }
    passed += Test("inferred_alias_return_freed_once", dtorCount, 1);

    // Copyable gate: mixed borrowed/owned returns remain legal and both branches are correct.
    {
        CopyableHolder src = default;
        src.v = 7;
        passed += Test("copyable_mixed_return_borrow_branch", pickCopyable(src, 1).v, 7);
        passed += Test("copyable_mixed_return_owned_branch", pickCopyable(src, 0).v, 99);
    }

    /*
     * A PLAIN field is not an owner, so adopting the accessor's result into a `unique` local is
     * the only thing that ever frees it - rejecting it would leak. The `unique`-field twin of
     * this exact program is the filed double-free and is rejected in err_move.cb.
     */
    dtorCount = 0;
    PlainBorrowWrap pw = default;
    Resource* pwLeaked = nullptr;
    {
        pw.p = new Resource();
        pwLeaked = pw.p;
        pw.p->id = 61;
        Resource* pk = pw.borrowPlain();
        unique Resource* adopted = nullptr;
        adopted = pk;
        passed += Test("plain_field_borrow_adopt_value", adopted->id, 61);
        passed += Test("plain_field_borrow_adopt_no_early_free", dtorCount, 0);
    }
    // The store does not TRANSFER (a plain field read is no owning source), so nothing frees it -
    // a LEAK, and the pre-existing behaviour this change must leave alone. The `unique`-field twin
    // of the same program freed it TWICE and is the rejection in err_move.cb.
    passed += Test("plain_field_borrow_adopt_not_freed", dtorCount, 0);
    delete pwLeaked;
    passed += Test("plain_field_borrow_adopt_freed_by_hand", dtorCount, 1);

    // A MIXED accessor proves nothing: one return is a plain field, so the fact never arms and
    // the caller keeps today's behaviour (the `unique` field still frees its own pointee once).
    dtorCount = 0;
    {
        MixedBorrowWrap mw = default;
        mw.plain = new Resource();
        mw.plain->id = 62;
        Resource* mk = mw.borrowEither(false);
        passed += Test("mixed_borrow_accessor_value", mk->id, 62);
        delete mk;
        passed += Test("mixed_borrow_accessor_freed_once", dtorCount, 1);
    }
    passed += Test("mixed_borrow_accessor_no_second_free", dtorCount, 1);

    // No callee to read: an indirect call through a `function<>` value proves nothing, so the
    // read stays legal and the field remains the single owner.
    dtorCount = 0;
    {
        IndirectBorrowWrap iw = default;
        iw.p = new Resource();
        iw.p->id = 63;
        function<Resource*(IndirectBorrowWrap*)> pick = (IndirectBorrowWrap* q) => { return q->p; };
        Resource* ik = pick(&iw);
        passed += Test("indirect_borrow_accessor_value", ik->id, 63);
        passed += Test("indirect_borrow_accessor_no_early_free", dtorCount, 0);
    }
    passed += Test("indirect_borrow_accessor_freed_once_by_field", dtorCount, 1);

    // READING through a proven borrow (never adopting it) is untouched: the field frees it once.
    dtorCount = 0;
    {
        FieldBorrowAcceptWrap fw = default;
        fw.item = new Resource();
        fw.item->id = 64;
        Resource* fk = fw.borrowItem();
        passed += Test("proven_borrow_read_through", fk->id, 64);
        passed += Test("proven_borrow_read_no_early_free", dtorCount, 0);
    }
    passed += Test("proven_borrow_read_freed_once_by_field", dtorCount, 1);

    // C escape hatch: bare pointer return, explicit `delete` frees the payload exactly once.
    dtorCount = 0;
    {
        FactoryHolder* m = makeManual();
        m->p = new Resource();
        delete m;
    }
    passed += Test("alias_ptr_factory_manual_delete", dtorCount, 1);

    // RAII mode: `move` pointer return adopted by a `unique` local, freed once at scope exit.
    dtorCount = 0;
    {
        unique FactoryHolder* o = makeOwning();
        o->p = new Resource();
    }
    passed += Test("move_ptr_factory_unique_local", dtorCount, 1);

    // Assignment from a `move` struct parameter transfers: nothing is freed while the pointee
    // is still owned, and clearing the destination field frees it exactly once.
    dtorCount = 0;
    {
        MoveParamHolder a = default;
        a.p = new Resource();
        stashOwnedHolder(move a);
    }
    passed += Test("move_param_struct_assign_transfers", dtorCount, 0);
    moveParamSink.p = nullptr;
    passed += Test("move_param_struct_assign_freed_once", dtorCount, 1);

    // D5: unique local from new is an owning location - freed exactly once at scope exit.
    dtorCount = 0;
    { unique Resource* a = new Resource(); }
    passed += Test("unique_local_from_new_freed_once", dtorCount, 1);

    // D5: loading from a unique location without move yields a borrow - the borrowed local
    // is not freed, so the owner frees once (no double free).
    dtorCount = 0;
    {
        unique Resource* b = new Resource();
        Resource* borrowed = b;
        int x = borrowed->id;
    }
    passed += Test("unique_borrow_out_no_double_free", dtorCount, 1);

    // D4: passing a named unique value to a unique (synthesized move) parameter transfers
    // ownership - the callee frees it; the caller must not (no double free).
    dtorCount = 0;
    {
        unique Resource* c = new Resource();
        sinkUnique(c);
    }
    passed += Test("unique_synth_move_param_freed_once", dtorCount, 1);

    // D4: passing a unique value to a plain-pointer parameter is a borrow - the caller keeps
    // ownership and frees once at scope exit.
    dtorCount = 0;
    {
        unique Resource* d = new Resource();
        borrow(d);
    }
    passed += Test("unique_to_plain_param_borrows", dtorCount, 1);

    return passed;
}

// RAII factory used by the reassignment tests: a `move` pointer return is an owned source,
// so a `unique` local adopts it whether it lands via decl-init or plain reassignment.
move Resource* makeOwnedResource() { return new Resource(); }
move Resource* makeIdResource(int id) { Resource* r = new Resource(); r->id = id; return r; }

// Hands back its FIRST parameter unchanged - a pure BORROW, owning nothing. The second
// parameter exists only so a `new` can be evaluated as a call ARGUMENT: ownership must be
// judged from the RHS itself, not from a sticky "something allocated" flag the argument set.
Resource* borrowFirstResource(Resource* a, Resource* b) { return a; }

// Same borrow return, but the second parameter ESCAPES into a global, so the argument-release
// path registers nothing and the declaration's own classification is the only thing standing
// between the borrow return and a double free.
Resource* g_retainedResource = nullptr;
Resource* retainSecondResource(Resource* a, Resource* b) { g_retainedResource = b; return a; }

// The return-identity alias-proof corpus. Each of these is a discriminator the proof must get
// right; the proof is "EVERY return is EXACTLY this argument, and it escapes nowhere else".
Resource* identityResource(Resource* p) { return p; }
Resource* mixedReturnResource(Resource* p, bool takeIt) { if (takeIt) { return p; } return nullptr; }
struct Holder51 { Resource* kid = nullptr; };
Resource* holderKid(Holder51* h) { return h->kid; }
move Holder51* makeHolder51(int id) { Holder51* h = new Holder51(); h->kid = makeIdResource(id); return h; }
Resource* g_stashedResource = nullptr;
Resource* stashAndReturnResource(Resource* p) { g_stashedResource = p; return p; }

// "Does not retain PAST my call": setTag replaces one FIELD through `this` (the field's
// destructor, then a store back over it); disposeTagged frees the WHOLE object instead.
struct Tagged
{
    string tag = default;
    int id = 0;
    ~Tagged() { dtorCount = dtorCount + 1; }
    void setTag(string s) { tag = s.copy(); }
};
move Tagged* makeTagged(int id) { Tagged* t = new Tagged(); t->id = id; string st = "start"; t->tag = st.copy(); return t; }
void disposeTagged(move Tagged* t) { delete t; }

// A holder that OWNS its resource. `borrowKid` hands back a pointer read THROUGH the holder, so
// the holder's destructor would free what the caller is left holding: releasing an owning holder
// temp at the statement boundary is a use-after-free, not a leak fix.
struct ResHolder
{
    unique Resource* kid = nullptr;
    string tag = "";
    Resource* borrowKid() { return kid; }
    string borrowTag() { return tag; }
    // Reads a pointer-bearing field without handing it out - the temp is still freeable.
    int tagLen() { return (int)tag.length(); }
};

// A by-value SNAPSHOT of the pointee copies its pointer-bearing fields out (an `llvm.mem*` whose
// source is the receiver), so the receiver temp must survive the copy.
struct BigRes
{
    string tag = "";
    int n = 0;
    ~BigRes() { dtorCount = dtorCount + 1; }
    BigRes snapshot() { return *this; }
    int justN() { return n; }
};
move BigRes* makeBig()
{
    BigRes* g = new BigRes();
    string t = "snap";
    g->tag = t.copy();
    g->n = 9;
    return g;
}

// Parking a pointer INTO the pointee. `adoptKid` takes a borrow the CALLER still owns, so the
// receiver temp must not be freed; `takeKid` takes ownership, so it may be.
struct RawHolder
{
    Resource* kid = nullptr;
    ~RawHolder() { if (kid != nullptr) { delete kid; } }
    void adoptKid(Resource* c) { kid = c; }
    void takeKid(move Resource* c) { kid = c; }
};
move RawHolder* makeRawHolder() { return new RawHolder(); }
move ResHolder* makeHolder(int id)
{
    ResHolder* h = new ResHolder();
    h->kid = new Resource();
    h->kid->id = id;
    string t = "held";
    h->tag = t.copy();
    return h;
}
// Same question in ARGUMENT position, one level out from the receiver.
Resource* kidOfHolder(ResHolder* h) { return h->kid; }

// Reassigning a `unique` pointer LOCAL through plain `=` (not a decl-initializer) must
// transfer ownership exactly as `unique R* b = move a;` does. Before the fix the destination
// stayed non-owning, so scope exit skipped it and the moved-in object leaked.
int testUniqueLocalReassignMove()
{
    int passed = 0;

    // Plain '=' reassignment from an explicit `move`: the destination adopts ownership and
    // frees the pointee exactly once at scope exit (used to leak - nothing was freed).
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 17;
        unique Resource* b = nullptr;
        b = move a;
        passed += Test("unique_reassign_move_value_survives", b->id, 17);
        passed += Test("unique_reassign_move_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("unique_reassign_move_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_move_freed_once", dtorCount, 1);

    // Destination ALREADY owns a live object (the case decl-init cannot reach): the old
    // pointee is freed at the assignment - not leaked - and the moved-in one at scope exit.
    // Two objects, two destructor runs: no leak, no double free.
    dtorCount = 0;
    {
        unique Resource* src = new Resource();
        src->id = 20;
        unique Resource* dst = new Resource();
        dst->id = 21;
        dst = move src;
        passed += Test("unique_reassign_move_drops_old_at_assign", dtorCount, 1);
        passed += Test("unique_reassign_move_holds_new", dst->id, 20);
    }
    passed += Test("unique_reassign_move_old_and_new_freed_once", dtorCount, 2);

    // A direct `new` RHS is an owned source too - the same adoption applies.
    dtorCount = 0;
    {
        unique Resource* c = nullptr;
        c = new Resource();
    }
    passed += Test("unique_reassign_new_freed_once", dtorCount, 1);

    // A move-returning call is an owned source - parity with `unique R* x = makeOwnedResource();`.
    dtorCount = 0;
    {
        unique Resource* d = nullptr;
        d = makeOwnedResource();
    }
    passed += Test("unique_reassign_move_call_freed_once", dtorCount, 1);

    // Chained reassignment moves: ownership walks to the last holder, freed exactly once.
    dtorCount = 0;
    {
        unique Resource* e0 = new Resource();
        e0->id = 30;
        unique Resource* e1 = nullptr;
        unique Resource* e2 = nullptr;
        e1 = move e0;
        e2 = move e1;
        passed += Test("unique_reassign_chain_value", e2->id, 30);
    }
    passed += Test("unique_reassign_chain_freed_once", dtorCount, 1);

    // A moved-from source is live again after being reassigned: both objects are freed once.
    dtorCount = 0;
    {
        unique Resource* f0 = new Resource();
        unique Resource* f1 = nullptr;
        f1 = move f0;
        f0 = new Resource();
    }
    passed += Test("unique_reassign_revived_source_freed_once", dtorCount, 2);

    // Release-early: assigning nullptr frees the old pointee at the assignment, and the
    // now-empty owning slot is a no-op at scope exit.
    dtorCount = 0;
    {
        unique Resource* g = new Resource();
        g = nullptr;
        passed += Test("unique_reassign_null_releases_now", dtorCount, 1);
    }
    passed += Test("unique_reassign_null_no_double_free", dtorCount, 1);

    // A BORROW-returning call must not be mistaken for an owned source just because a `new`
    // was evaluated as one of its ARGUMENTS. `h` and the return value name one pointee; if the
    // unique local adopted it, scope exit would free it twice. The `b` parameter of
    // borrowFirstResource provably does not retain its argument, so the unnamed argument
    // allocation is released at end-of-full-expression (it used to leak): one destructor runs
    // there, and `h` accounts for the second at scope exit.
    dtorCount = 0;
    {
        unique Resource* h = new Resource();
        h->id = 5;
        unique Resource* borrowed = nullptr;
        borrowed = borrowFirstResource(h, new Resource());
        passed += Test("unique_reassign_borrow_call_value", borrowed->id, 5);
        passed += Test("unique_reassign_borrow_call_arg_temp_freed", dtorCount, 1);
    }
    passed += Test("unique_reassign_borrow_call_not_adopted", dtorCount, 2);

    // A '?:' is a transparent wrapper: an owning `new` in the TAKEN arm reaches the assignment
    // as the ternary's RESULT value, so the unique local adopts it and frees it exactly once.
    dtorCount = 0;
    {
        bool takeNew = true;
        unique Resource* t0 = nullptr;
        t0 = takeNew ? new Resource() : nullptr;
        passed += Test("unique_reassign_ternary_new_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_ternary_new_freed_once", dtorCount, 1);

    // The other arm is taken at runtime: nothing was allocated, so nothing may be freed.
    dtorCount = 0;
    {
        bool takeNew = false;
        unique Resource* t1 = nullptr;
        t1 = takeNew ? new Resource() : nullptr;
    }
    passed += Test("unique_reassign_ternary_untaken_arm_no_free", dtorCount, 0);

    // Both arms allocate, but '?:' branches for real - only the selected arm runs, so exactly
    // one object exists and it is freed once.
    dtorCount = 0;
    {
        bool takeFirst = true;
        unique Resource* t2 = nullptr;
        t2 = takeFirst ? new Resource() : new Resource();
    }
    passed += Test("unique_reassign_ternary_both_arms_freed_once", dtorCount, 1);

    // The ternary's owning bit must ride the RESULT value only: a `new` wrapped in a '?:' that
    // sits in ARGUMENT position still feeds a BORROW return, which must not be adopted. The
    // selected arm's allocation is a non-retained argument temp, so it is freed at
    // end-of-full-expression (null-guarded, so the nullptr arm frees nothing); `t3` is the second.
    dtorCount = 0;
    {
        bool useNew = true;
        unique Resource* t3 = new Resource();
        t3->id = 9;
        unique Resource* t4 = nullptr;
        t4 = borrowFirstResource(t3, useNew ? new Resource() : nullptr);
        passed += Test("unique_reassign_ternary_arg_borrow_value", t4->id, 9);
    }
    passed += Test("unique_reassign_ternary_arg_borrow_not_adopted", dtorCount, 2);

    // Same shape with the nullptr arm selected: nothing was allocated for the argument, so the
    // end-of-expression release is a no-op and only `t5` is destroyed.
    dtorCount = 0;
    {
        bool useNew = false;
        unique Resource* t5 = new Resource();
        t5->id = 11;
        unique Resource* t6 = nullptr;
        t6 = borrowFirstResource(t5, useNew ? new Resource() : nullptr);
        passed += Test("unique_reassign_ternary_arg_null_borrow_value", t6->id, 11);
        passed += Test("unique_reassign_ternary_arg_null_no_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_ternary_arg_null_arm_freed_once", dtorCount, 1);

    // Same question at a DECLARATION, which used to read the sticky flag instead of the RHS.
    // A plain `T*` declared from a BORROW-returning call adopted the return whenever a `new` had
    // run anywhere in the ARGUMENT list, so the local and the real owner freed one pointee twice.
    // borrowFirstResource does not retain, so the argument allocation is released at
    // end-of-full-expression (one destructor); `h` accounts for the second at scope exit.
    dtorCount = 0;
    {
        unique Resource* h = new Resource();
        h->id = 21;
        Resource* res = borrowFirstResource(h, new Resource());
        passed += Test("decl_borrow_call_arg_new_value", res->id, 21);
        passed += Test("decl_borrow_call_arg_new_temp_freed", dtorCount, 1);
    }
    passed += Test("decl_borrow_call_arg_new_owner_freed_once", dtorCount, 2);

    // The same shape with a RETAINING callee, which is the form that aborted: the argument
    // allocation escapes into a global, so no end-of-expression release runs and the only
    // destructor inside the scope would be a wrong one. `h` is freed once at scope exit; the
    // retained allocation is the global's to delete.
    dtorCount = 0;
    {
        unique Resource* h = new Resource();
        h->id = 22;
        Resource* res = retainSecondResource(h, new Resource());
        passed += Test("decl_retaining_call_arg_new_value", res->id, 22);
        passed += Test("decl_retaining_call_arg_new_no_early_free", dtorCount, 0);
    }
    passed += Test("decl_retaining_call_arg_new_owner_freed_once", dtorCount, 1);
    delete g_retainedResource;
    g_retainedResource = nullptr;
    passed += Test("decl_retaining_call_arg_new_retained_freed", dtorCount, 2);

    // Nested-`?:` flavour of the same leak-through: the `new` sits inside a ternary that is itself
    // an ARGUMENT, and the selected path never reaches it. The declaration must still borrow.
    dtorCount = 0;
    {
        unique Resource* keep = new Resource();
        keep->id = 23;
        Resource* live = keep;
        Resource* res = borrowFirstResource(
            keep, identityBool(false) ? (identityBool(true) ? new Resource() : live) : nullptr);
        passed += Test("decl_nested_ternary_arg_borrow_value", res->id, 23);
        passed += Test("decl_nested_ternary_arg_no_early_free", dtorCount, 0);
    }
    passed += Test("decl_nested_ternary_arg_owner_freed_once", dtorCount, 1);

    // The value-identity gate must not cost a DIRECT allocation its adoption: a plain `T*` and a
    // `unique T*` declared from `new` both own, and free exactly once at scope exit.
    dtorCount = 0;
    {
        Resource* plain = new Resource();
        plain->id = 24;
        passed += Test("decl_direct_new_plain_value", plain->id, 24);
    }
    passed += Test("decl_direct_new_plain_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        unique Resource* owned = new Resource();
        owned->id = 25;
    }
    passed += Test("decl_direct_new_unique_freed_once", dtorCount, 1);

    // A move-returning call and a top-level `move` are owned sources at a declaration too.
    dtorCount = 0;
    {
        Resource* fromCall = makeOwnedResource();
        fromCall->id = 26;
    }
    passed += Test("decl_move_return_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        unique Resource* src = new Resource();
        src->id = 27;
        Resource* dst = move src;
        passed += Test("decl_top_level_move_value", dst->id, 27);
        passed += Test("decl_top_level_move_source_nulled", src == nullptr ? 1 : 0, 1);
    }
    passed += Test("decl_top_level_move_freed_once", dtorCount, 1);

    // A non-mixed '?:' join of `move` arms owns, and the REASSIGNMENT path must adopt it exactly
    // as the declaration path does. It is in neither the owning-`new` nor the owning-return ledger
    // (a move has no free-site type), so before the value-identity leg the destination stayed
    // non-owning and the moved-out object was owned by nobody - a leak, not a double free.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 28;
        unique Resource* b = nullptr;
        b = identityBool(true) ? move a : nullptr;
        passed += Test("unique_reassign_move_join_value", b->id, 28);
        passed += Test("unique_reassign_move_join_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("unique_reassign_move_join_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_move_join_freed_once", dtorCount, 1);

    // Same through a NESTED join, where the inner join's ownership must survive the outer one.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 29;
        unique Resource* b = nullptr;
        b = identityBool(true) ? (identityBool(true) ? move a : nullptr) : nullptr;
        passed += Test("unique_reassign_nested_move_join_value", b->id, 29);
    }
    passed += Test("unique_reassign_nested_move_join_freed_once", dtorCount, 1);

    // The safety direction: a MIXED join never enters the ledger, so a reassignment still BORROWS
    // it. Adopting would free a pointee `owner` frees again at scope exit.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 30;
        Resource* live = owner;
        Resource* b = nullptr;
        b = identityBool(false) ? makeOwnedResource() : live;
        passed += Test("unique_reassign_mixed_join_borrow_value", b->id, 30);
        passed += Test("unique_reassign_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("unique_reassign_mixed_join_owner_freed_once", dtorCount, 1);

    // An owning temp used as a METHOD-CALL RECEIVER is the same question as an owning temp in
    // ARGUMENT position - `this` IS argument 0 - so the escape analysis decides it. `idOf` only
    // reads through `this`, so the temp is released at end-of-full-expression instead of leaking.
    dtorCount = 0;
    int recvRead = makeIdResource(40)->idOf();
    passed += Test("recv_temp_nonescaping_value", recvRead, 40);
    passed += Test("recv_temp_nonescaping_freed_once", dtorCount, 1);

    // `self()` RETURNS the receiver and does nothing else with it, so the return-identity alias
    // proof holds: the call RESULT and the owning temp name ONE object, and the callee kept no
    // second handle. `b` therefore ADOPTS the result. No release may run at the statement
    // boundary - that would be a use-after-free through `b`, which the dispatch leg proves is
    // still live - and scope exit frees it exactly once (it used to leak; the proof closed it).
    dtorCount = 0;
    {
        unique Resource* b = nullptr;
        b = makeIdResource(41)->self();
        passed += Test("recv_temp_escaping_value", b->id, 41);
        passed += Test("recv_temp_escaping_not_freed_at_stmt", dtorCount, 0);
        passed += Test("recv_temp_escaping_still_dispatchable", b->idOf(), 41);
    }
    passed += Test("recv_temp_escaping_adopted_freed_once", dtorCount, 1);

    // Every discriminator the alias proof has to fail, each with the owning temp reaching an
    // owning destination the same way. All still LEAK by design (0 destructors): a free would
    // need a proof none of them supplies, and the value legs prove each result is still live.
    dtorCount = 0;
    {
        unique Resource* m = nullptr;
        m = mixedReturnResource(makeIdResource(51), true);   // one return is not the argument
        passed += Test("alias_proof_mixed_return_value", m->id, 51);
    }
    passed += Test("alias_proof_mixed_return_not_adopted", dtorCount, 0);

    dtorCount = 0;
    {
        unique Resource* f = nullptr;
        f = holderKid(makeHolder51(52));   // returns a FIELD of the argument, not the argument
        passed += Test("alias_proof_field_return_value", f->id, 52);
    }
    passed += Test("alias_proof_field_return_not_adopted", dtorCount, 0);

    dtorCount = 0;
    {
        unique Resource* s = nullptr;
        s = stashAndReturnResource(makeIdResource(53));       // retained in a global as well
        passed += Test("alias_proof_second_handle_value", s->id, 53);
    }
    passed += Test("alias_proof_second_handle_not_adopted", dtorCount, 0);
    delete g_stashedResource;
    g_stashedResource = nullptr;
    passed += Test("alias_proof_second_handle_global_freed", dtorCount, 1);

    // Chained laundering: the proof carries the ownership along the chain, one free at the end.
    dtorCount = 0;
    {
        unique Resource* c2 = nullptr;
        c2 = makeIdResource(54)->self()->self();
        passed += Test("alias_proof_chained_value", c2->id, 54);
        passed += Test("alias_proof_chained_no_early_free", dtorCount, 0);
    }
    passed += Test("alias_proof_chained_freed_once", dtorCount, 1);

    // A free FUNCTION whose only statement returns its parameter proves the same thing, and the
    // owning temp may be a raw `new` in ARGUMENT position - the RESULT VALUE is what carries the
    // ownership. The sibling below is the discriminator that must NOT adopt: borrowFirstResource
    // returns its FIRST parameter, so the `new` in the second slot is never the result.
    dtorCount = 0;
    {
        unique Resource* i0 = nullptr;
        i0 = identityResource(new Resource());
        passed += Test("alias_proof_identity_fn_no_early_free", dtorCount, 0);
    }
    passed += Test("alias_proof_identity_fn_freed_once", dtorCount, 1);

    // A callee defined BELOW its call site has no readable body yet, so no proof - the accepted
    // unknown-accepts caveat. It keeps leaking rather than being adopted and freed twice.
    dtorCount = 0;
    {
        unique Resource* lateB = nullptr;
        lateB = identityResourceDefinedBelow(makeIdResource(55));
        passed += Test("alias_proof_callee_below_value", lateB->id, 55);
    }
    passed += Test("alias_proof_callee_below_no_proof_leaks", dtorCount, 0);

    // "Does not retain PAST my call": `setTag`-style field replacement runs the FIELD's
    // destructor through `this` and stores the replacement back over it. That is a use that
    // ends, not a handle kept, so the receiver temp is released at the statement boundary.
    dtorCount = 0;
    makeTagged(61)->setTag("replaced");
    passed += Test("retains_past_call_field_overwrite_freed", dtorCount, 1);

    // The discriminator: a callee that frees the WHOLE object through the tracked pointer keeps
    // answering "retains", or the caller-side release would free it a second time.
    dtorCount = 0;
    disposeTagged(makeTagged(62));
    passed += Test("retains_past_call_whole_object_freed_once", dtorCount, 1);

    // The receiver hands back a pointer READ THROUGH itself, and it OWNS that pointee: releasing
    // the holder temp would run its destructor and leave `kid` dangling. It must leak instead.
    dtorCount = 0;
    {
        Resource* kid = makeHolder(42)->borrowKid();
        passed += Test("recv_temp_owned_field_not_freed", dtorCount, 0);
        passed += Test("recv_temp_owned_field_readable", kid->id, 42);
    }
    // Pinned AFTER scope exit too: the holder is owned by nobody, so it leaks - it must not be
    // freed late either, which would be the same use-after-free one statement further on.
    passed += Test("recv_temp_owned_field_leaks_after_scope", dtorCount, 0);

    // Same hazard through a `string` field: the {ptr,len} copy names the holder's buffer.
    dtorCount = 0;
    {
        string heldTag = makeHolder(43)->borrowTag();
        passed += Test("recv_temp_string_field_not_freed", dtorCount, 0);
        passed += Test("recv_temp_string_field_readable", heldTag == "held" ? 1 : 0, 1);
    }
    passed += Test("recv_temp_string_field_leaks_after_scope", dtorCount, 0);

    // And one level out, in ARGUMENT position rather than receiver position.
    dtorCount = 0;
    {
        Resource* argKid = kidOfHolder(makeHolder(44));
        passed += Test("arg_temp_owned_field_not_freed", dtorCount, 0);
        passed += Test("arg_temp_owned_field_readable", argKid->id, 44);
    }
    passed += Test("arg_temp_owned_field_leaks_after_scope", dtorCount, 0);

    // Reading a pointer-bearing field WITHOUT handing it out keeps the temp freeable: the
    // aggregate is followed through its projections, and a length read is a scalar.
    dtorCount = 0;
    int heldLen = makeHolder(45)->tagLen();
    passed += Test("recv_temp_projected_scalar_value", heldLen, 4);
    passed += Test("recv_temp_projected_scalar_freed_once", dtorCount, 1);

    // A by-value SNAPSHOT of the pointee: the copy carries the holder's string buffer out, so the
    // receiver temp must survive it (it leaks). The snapshot's own destructor is the only one
    // that runs at scope exit; reading the copied fields proves nothing was freed under it.
    dtorCount = 0;
    {
        BigRes snap = makeBig()->snapshot();
        passed += Test("recv_temp_snapshot_not_freed", dtorCount, 0);
        passed += Test("recv_temp_snapshot_tag_readable", snap.tag == "snap" ? 1 : 0, 1);
        passed += Test("recv_temp_snapshot_scalar_readable", snap.n, 9);
    }
    passed += Test("recv_temp_snapshot_copy_freed_once", dtorCount, 1);

    // A method that only reads a scalar out of the same struct still frees the temp.
    dtorCount = 0;
    int bigN = makeBig()->justN();
    passed += Test("recv_temp_scalar_getter_value", bigN, 9);
    passed += Test("recv_temp_scalar_getter_freed_once", dtorCount, 1);

    // Parking a CALLER-owned borrow inside the receiver: freeing the receiver temp would run its
    // destructor over `mine`, which the caller frees again at scope exit (a double free that used
    // to abort). Nothing is freed at the statement, and `mine` is freed exactly once.
    dtorCount = 0;
    {
        unique Resource* mine = new Resource();
        mine->id = 46;
        makeRawHolder()->adoptKid(mine);
        passed += Test("recv_temp_parked_borrow_not_freed", dtorCount, 0);
        passed += Test("recv_temp_parked_borrow_readable", mine->id, 46);
    }
    passed += Test("recv_temp_parked_borrow_freed_once", dtorCount, 1);

    // Same shape with a `move` parameter: the callee owns what it parks, so the receiver temp is
    // released at the statement and its destructor frees the transferred resource exactly once.
    dtorCount = 0;
    makeRawHolder()->takeKid(new Resource());
    passed += Test("recv_temp_parked_move_param_freed_once", dtorCount, 1);

    return passed;
}

// Explicit `move` on a VALUE-type call argument (string / owning struct / closure) defers
// the ownership transfer until the callee's parameter move-ness is known. Passing to a
// BORROWING param must leave the source intact (the eager zeroing used to consume it and
// leak the buffer with no diagnostic), and an explicit `move` must select the `move`
// overload rather than the plain one.
int movePlain(string s)      { return (int)s.length(); }
int moveOwns(move string s)  { return (int)s.length(); }

int ovlPick(string s)        { return 1; }
int ovlPick(move string s)   { return 2; }

int testValueMoveArgDeferred()
{
    int passed = 0;

    // Borrowing param: the source keeps its buffer after the call.
    {
        string a = "hel" + "lo";
        int seen = movePlain(a);
        passed += Test("value_move_borrow_callee_sees_len", seen, 5);
        passed += Test("value_move_borrow_source_intact", (int)a.length(), 5);
    }

    // move param: ownership transfers, the source is left empty (moved-from).
    {
        string b = "wor" + "ld";
        int seen = moveOwns(move b);
        passed += Test("value_move_owner_callee_sees_len", seen, 5);
    }

    // Overload selection: a plain argument BORROWS, an explicit `move` picks the move
    // overload. This pair used to resolve exactly backwards.
    {
        string c = "abc" + "de";
        passed += Test("value_move_ovl_plain_arg_borrows", ovlPick(c), 1);
        string d = "fgh" + "ij";
        passed += Test("value_move_ovl_explicit_move_owns", ovlPick(move d), 2);
    }

    return passed;
}

// ---------------------------------------------------------------------------
// Move/borrow overload IDENTITY tests. These deliberately assert WHICH overload
// ran (via a distinct return code / copy counter), never a call count: a counting
// oracle cannot see a fully INVERTED borrow/move pair.
// ---------------------------------------------------------------------------

// Generic-substituted pointer params: Box<T>.put(T) borrows, put(move T) owns.
struct Box<T>
{
    int lastPick = 0;
    int put(T p)      { lastPick = 1; return 1; }
    int put(move T p) { lastPick = 2; delete p; return 2; }
};

int g_rvalCopies = 0;
class Tracked
{
    int id = default;
    Tracked copy() { g_rvalCopies = g_rvalCopies + 1; Tracked t = default; t.id = id; return t; }
};
Tracked makeTracked() { Tracked t = default; t.id = 9; return t; }

// Borrow overload deep-copies (as a copy-by-default container would); move transfers.
int rvalPick(Tracked v)      { Tracked keep = v.copy(); return 1; }
int rvalPick(move Tracked v) { return 2; }

int testPtrMoveOverloadIdentity()
{
    int passed = 0;

    // Plain call on an owning pointer BORROWS: the callee must not free it, and the
    // caller's pointer must NOT be marked moved (it is still readable afterwards).
    dtorCount = 0;
    {
        Resource* a = new Resource();
        a->id = 7;
        passed += Test("ptr_ovl_plain_picks_borrow", probe(a), 207);
        passed += Test("ptr_ovl_plain_not_moved", a->id, 7);   // still usable: not consumed
        passed += Test("ptr_ovl_plain_not_freed_yet", dtorCount, 0);
    }
    passed += Test("ptr_ovl_plain_freed_at_scope_exit", dtorCount, 1);

    // Explicit move picks the MOVE overload, which frees exactly once inside the call.
    dtorCount = 0;
    {
        Resource* b = new Resource();
        b->id = 8;
        passed += Test("ptr_ovl_explicit_move_picks_move", probe(move b), 108);
        passed += Test("ptr_ovl_explicit_move_freed_in_callee", dtorCount, 1);
    }
    passed += Test("ptr_ovl_explicit_move_freed_once", dtorCount, 1);

    // Same rules through a generic substitution (T = Resource*).
    dtorCount = 0;
    {
        Box<Resource*> box;
        Resource* c = new Resource();
        c->id = 3;
        passed += Test("generic_ptr_ovl_plain_picks_borrow", box.put(c), 1);
        passed += Test("generic_ptr_ovl_plain_not_freed", dtorCount, 0);
        delete c;
    }
    passed += Test("generic_ptr_ovl_borrow_freed_by_caller", dtorCount, 1);

    dtorCount = 0;
    {
        Box<Resource*> box;
        Resource* d = new Resource();
        d->id = 4;
        passed += Test("generic_ptr_ovl_explicit_move_picks_move", box.put(move d), 2);
        passed += Test("generic_ptr_ovl_move_freed_in_callee", dtorCount, 1);
    }
    passed += Test("generic_ptr_ovl_move_freed_once", dtorCount, 1);

    return passed;
}

int testRValuePrefersMoveOverload()
{
    int passed = 0;

    // An unnamed temporary prefers the MOVE overload (nothing to preserve), so the
    // borrow overload's deep copy is not paid.
    g_rvalCopies = 0;
    passed += Test("rvalue_arg_picks_move", rvalPick(makeTracked()), 2);
    passed += Test("rvalue_arg_no_copy", g_rvalCopies, 0);

    // A named lvalue still BORROWS - that is the semantics, and it must not regress.
    Tracked t = default;
    t.id = 3;
    g_rvalCopies = 0;
    passed += Test("named_lvalue_arg_picks_borrow", rvalPick(t), 1);
    passed += Test("named_lvalue_arg_copies", g_rvalCopies, 1);

    // Explicit move on a named lvalue picks the move overload, no copy.
    Tracked u = default;
    u.id = 4;
    g_rvalCopies = 0;
    passed += Test("named_lvalue_explicit_move_picks_move", rvalPick(move u), 2);
    passed += Test("named_lvalue_explicit_move_no_copy", g_rvalCopies, 0);

    return passed;
}

/*
 * Reassignment of a `unique <interface>` LOCAL. The owning-source test for this leg used the
 * sticky global `lastOwningResult`, which a `new` ANYWHERE in the RHS sets - including in call
 * ARGUMENT position - so `k = pick(g, new SqMove())` adopted a borrow of `g` and both handles
 * freed it (exit 134). The reject is now keyed to the RHS shape itself, and the borrow form is
 * a compile error (err_unique_iface_stack_box). These legs pin that the three genuinely owning
 * forms still transfer and free exactly once.
 */
interface IShapeMove { int area(); };
int sqMoveCtorCount = 0;
class SqMove : IShapeMove
{
    int s = 0;
    SqMove() { sqMoveCtorCount = sqMoveCtorCount + 1; }
    int area() { return s * s; }
    ~SqMove() { dtorCount = dtorCount + 1; }
};

move IShapeMove makeShapeMove() { return new SqMove(); }

int ciMoveCtorCount = 0;
class CiMove : IShapeMove
{
    int r = 0;
    CiMove() { ciMoveCtorCount = ciMoveCtorCount + 1; }
    int area() { return r + 7; }
    ~CiMove() { dtorCount = dtorCount + 1; }
};

bool identityBool(bool b) { return b; }

// A PROVABLY-BORROWED interface box and an OWNED one live in the SAME function. Rejecting
// 'delete' of a borrowed box must not poison the OWNED box's delete: the provenance tag is per
// VARIABLE, not per function. `p` stays the caller's to free; `owned` is freed here.
int borrowAndOwnShape(CiMove* p)
{
    IShapeMove borrowed = p;
    IShapeMove owned = new SqMove();
    int both = borrowed.area() + owned.area();
    delete owned;
    return both;
}

move CiMove* makeCiMovePtr() { CiMove* m = new CiMove(); return move m; }

/*
 * The OWNERSHIP-ACQUISITION axis for the borrowed-box 'delete' guard. A pointer that received its
 * `new` in a LATER statement is the box's ONLY owner, so deleting the box is correct - and
 * `IsOwning` is set at declaration-with-initializer ONLY, so it is absent here for a reason that
 * has nothing to do with borrowing. An early cut read that absence as proof of a borrow and
 * hard-errored on every function below, with advice ("let the source release it") that LEAKS: the
 * source releases nothing. dtorCount is the discriminator - a leak shows as a MISSING free.
 */
int lateAssignedOwnerBox()
{
    CiMove* c = nullptr;
    c = new CiMove();
    IShapeMove s = c;
    int a = s.area();
    delete s;
    return a;
}

// The same late assignment reaching the box through an 'as' CAST rather than a plain initializer.
int lateAssignedAsCastBox()
{
    CiMove* c = nullptr;
    c = new CiMove();
    IShapeMove s = c as IShapeMove;
    int a = s.area();
    delete s;
    return a;
}

// Assigned inside a BRANCH, from a move-returning factory on one side and a bare `new` on the
// other. Both arms leave the box as sole owner.
int branchAssignedOwnerBox(bool k)
{
    CiMove* c = nullptr;
    if (k) { c = makeCiMovePtr(); } else { c = new CiMove(); }
    IShapeMove s = c;
    int a = s.area();
    delete s;
    return a;
}

// Assigned inside a LOOP: the binding site is walked once but reached three times.
int loopAssignedOwnerBox()
{
    int total = 0;
    for (int i = 0; i < 3; i = i + 1)
    {
        CiMove* c = nullptr;
        c = new CiMove();
        IShapeMove s = c;
        total = total + s.area();
        delete s;
    }
    return total;
}

/*
 * `alias` means the binding OPTS OUT of ownership tracking - its own scope-exit free is
 * SUPPRESSED, so it frees NOTHING and the receiver is expected to delete it by hand. An early cut
 * read that flag as "someone else frees it", which is backwards: it false-rejected this function
 * and its advice ("let the source release it") leaked, since the source releases nothing.
 */
alias CiMove* aliasMakeCiMove() { CiMove* n = new CiMove(); return n; }

int aliasReturnOwnerBox()
{
    CiMove* e = aliasMakeCiMove();
    IShapeMove s = e;
    int a = s.area();
    delete s;
    return a;
}

// An `alias` call result REASSIGNED to a fresh allocation. Whatever the declaration established is
// stale; the local is now the sole owner. A plain `list<T*>` owns nothing, so its element is freed
// by hand here too - which is what makes the expected count exactly 2.
int aliasResultReassignedBox()
{
    list<CiMove*> l = default;
    l.add(new CiMove());
    CiMove* e = l.get(0);
    e = new CiMove();
    IShapeMove s = e;
    int a = s.area();
    delete s;
    CiMove* kept = l.get(0);
    delete kept;
    return a;
}

// A local SHADOWING a parameter's name is a DIFFERENT binding and the sole owner of its own
// allocation. A name-only parameter lookup classified it as the borrowed parameter and rejected
// it - the caller's object is a second, unrelated allocation and frees separately.
int shadowedParamNameBox(CiMove* p)
{
    int t = 0;
    { CiMove* p = nullptr; p = new CiMove(); IShapeMove s = p; t = s.area(); delete s; }
    return t + p->area();
}

// A PARAMETER pointed somewhere else before being boxed. "This is a borrowed parameter" is true of
// the DECLARATION and false from the reassignment on: the frame is now the sole owner.
int paramReassignedBox(CiMove* p)
{
    p = new CiMove();
    IShapeMove s = p;
    int a = s.area();
    delete s;
    return a;
}

// A parameter given a fallback allocation with '??='. That is a JOIN of "still the caller's borrow"
// and "a fresh sole owner", so the provenance afterwards is UNKNOWN and the polarity rule accepts
// it. Rejecting it was a false rejection whose only offered remedy - dropping the delete - LEAKED
// (measured dtor=0). The cost of accepting is the other arm: called with a non-null argument this
// same function double-frees, which is why the leg passes nullptr and nothing else.
int coalesceAssignedOwnerBox(CiMove* p)
{
    p ??= new CiMove();
    IShapeMove s = p;
    int a = s.area();
    delete s;
    return a;
}

// A `list<unique T*>` element borrow given a fallback with '??='. The element was null, so the
// frame's own allocation is the only object and the box's delete is the only free. `??=` returns
// before the element-borrow refresh the plain '=' path runs, so the DECLARATION's element fact is
// stale here; consulting it false-rejected this - which master compiles and runs at dtor=1 - and
// the offered remedy leaked. The RAW `delete e;` spelling is left exactly as master has it.
int coalesceElemFallbackBox()
{
    int a = 0;
    {
        list<unique CiMove*> lk = default;
        lk.add(nullptr);
        CiMove* ek = lk.get(0);
        ek ??= new CiMove();
        IShapeMove s = ek;
        a = s.area();
        delete s;
    }
    return a;
}

// The LHS is already the SOLE owner when '??=' runs, so the not-taken arm frees nothing on its own
// (`IsOwning` is declaration-with-initializer only, and this local got its `new` in a later
// statement) and the box's delete is the ONLY free. This is the leg that forces the join rule:
// blaming the RHS alone would reject it, and its remedy would leak. `caller_alive` proves the
// argument's object was never touched.
int coalesceSoleOwnerLhsBox(CiMove* q)
{
    CiMove* c = nullptr;
    c = new CiMove();
    c ??= q;
    IShapeMove s = c;
    int a = s.area();
    delete s;
    return a;
}

// The same sole-owner-LHS shape with a CAST on the RHS. The cast erases the source binding, so the
// RHS owner is recovered from the boxed VALUE's slot; that fallback must not over-reject - the LHS
// proves nothing here, so the join stays empty and the box's delete is still the only free of `c`'s
// object. The reject side is the sCoalesceCast leg in err_delete_borrowed_interface_box.cb.
int coalesceCastSoleOwnerLhsBox()
{
    CiMove* aOwn = new CiMove();
    aOwn->r = 5;
    CiMove* c = nullptr;
    c = new CiMove();
    c ??= (CiMove*)aOwn;
    IShapeMove s = c;
    int a = s.area();
    delete s;
    return a;
}

/*
 * REVIVAL of a moved-out local through '??='. `move` nulls the source, so the '??=' null test is
 * always TRUE for a moved-from pointer and the store always happens - which makes reviving it the
 * same fact the plain '=' records (MarkVariableUnmoved / MarkVariableNotExplicitlyMovedNull), and
 * makes the null test itself a guard read the null dataflow must see. On the merge base '??='
 * returned before both, so this FALSE-REJECTED with "dereference of moved variable 'a'" while the
 * '=' and the desugared `if (a == nullptr) { a = ...; }` spellings both compiled and ran. The two
 * `r` values differ, so an aliased revival cannot pass for a fresh one.
 */
int coalesceRevivesMovedLocal()
{
    CiMove* a = new CiMove();
    a->r = 2;
    CiMove* b = move a;
    a ??= new CiMove();
    a->r = 3;
    int total = a->area() + b->area();
    delete a;
    delete b;
    return total;
}

// A one-hop COPY of a borrowed parameter, then REASSIGNED to a fresh allocation. This is the exact
// case that once justified dropping IsBorrowed from the proof. It is covered by the reassignment
// retirement instead, so IsBorrowed could be restored - which is what closes the laundering leg
// borrowHop in Test/errors/err_delete_borrowed_interface_box.cb - at no cost here. The caller's
// object must survive: `caller_alive` is what separates "reassigned correctly" from "aliased".
int hopReassignedBox(CiMove* p)
{
    CiMove* b = p;
    b = new CiMove();
    IShapeMove s = b;
    int a = s.area();
    delete s;
    return a;
}

// ---- Plain COPY of an OWNING LOCAL (`T* b = c;`), the RETIREMENT half of that guard. The reject
// half is the copyOfOwner* legs in Test/errors/err_delete_borrowed_interface_box.cb. Both ends of
// the alias retire the fact, and each of these programs frees every object exactly once on master
// too - they exist to catch the guard growing one cell wider than the aliasing it can prove.

// The COPY reassigned: `b` is the sole owner of its own allocation. The two objects carry different
// `r`, so the returned sum proves both are live and distinct rather than one aliased twice.
int copyOfOwnerReassignedCopy()
{
    CiMove* c = new CiMove();
    CiMove* b = c;
    b = new CiMove();
    b->r = 3;
    int a = b->area() + c->area();
    delete b;
    return a;
}

// The SOURCE reassigned instead: `c` owns a DIFFERENT object now, so `b` holds the ONLY reference
// to the original and `delete b` is the only thing that frees it. Rejecting this would LEAK.
int copyOfOwnerReassignedSource()
{
    CiMove* c = new CiMove();
    CiMove* b = c;
    c = new CiMove();
    c->r = 4;
    int a = b->area() + c->area();
    delete b;
    return a;
}

// The boxed spelling of the same retirement - the boxing proof and the raw guard must agree here
// too, so a source reassignment leaves the box deletable.
int copyOfOwnerReassignedSourceBox()
{
    CiMove* c = new CiMove();
    CiMove* b = c;
    c = new CiMove();
    c->r = 5;
    IShapeMove s = b;
    int a = s.area() + c->area();
    delete s;
    return a;
}

// The copy is only READ and the OWNER is deleted, which is always correct. Tagging the copy must
// not disturb the owner's own delete.
int copyOfOwnerDeleteOwner()
{
    CiMove* c = new CiMove();
    CiMove* b = c;
    int a = b->area();
    delete c;
    return a;
}

// A `list<unique T*>` ELEMENT borrow reassigned to a fresh allocation before being boxed. The
// element proof is REFRESHED by that same store (cleared, here), which is what makes it safe to
// ask it ahead of the reassignment retirement - the ordering the borrowElemAssign leg pins from the
// reject side. Count is 2: the boxed allocation freed by `delete s`, the element by the list's dtor.
int elemBorrowReassignedBox()
{
    int a = 0;
    {
        list<unique CiMove*> lg = default;
        lg.add(new CiMove());
        CiMove* e = lg.get(0);
        e = new CiMove();
        IShapeMove s = e;
        a = s.area();
        delete s;
    }
    return a;
}

class PlainHolderMove { CiMove* h = default; };

// A PLAIN pointer field read is ACCEPTED because nothing at the boxing site can prove another
// owner frees it - not because it is provably safe. A holder with a hand-written destructor that
// frees the same field WOULD double-free and is an open gap, identical on master. A `unique` field
// carries that proof and IS rejected; see Test/errors/err_delete_borrowed_interface_box.cb.
int plainFieldReadBox(PlainHolderMove* hh)
{
    IShapeMove s = hh.h;
    int a = s.area();
    delete s;
    return a;
}

// Declared from a BORROW, then REASSIGNED to an owned box before the delete. Walk order over the
// AST is not control flow, so the reassignment poisons the tag for good rather than recomputing
// it - the delete must keep compiling. Called with `k` true, so the freed box is the owned one.
int borrowThenOwnShape(CiMove* p, bool k)
{
    IShapeMove s = p;
    if (k) { s = new SqMove(); }
    delete s;
    return 1;
}

// Interface INHERITANCE fixture for the '?:' rebox tests below: IDrawableBase extends
// IShapeBase, so a Circle's IDrawableBase vtable has an extra 'draw' slot the IShapeBase
// vtable does not - joining/rebinding across the two needs a real rebox, not a raw copy.
interface IShapeBase { int area(); };
interface IDrawableBase : IShapeBase { void draw(); };
int circleCtorCount = 0;
int circleDrawCount = 0;
class Circle : IDrawableBase
{
    int r = 4;
    Circle() { circleCtorCount = circleCtorCount + 1; }
    int area() { return r * r; }
    void draw() { circleDrawCount = circleDrawCount + 1; }
    ~Circle() { dtorCount = dtorCount + 1; }
};

/*
 * A '?:' RHS bound to an INTERFACE slot. The ternary result carries no concrete TypeName, so the
 * struct -> fat-pointer upcast used to be skipped and a raw pointer was bitcast into the fat
 * struct (invalid IR). Each arm is now boxed inside its own branch, so arms with different
 * concrete classes work too - and only the taken arm allocates.
 */
// RETURN and CALL-ARGUMENT position for an interface-bound pointer JOIN - the two spellings the
// decl-init/assignment fix did not reach. The two 'move' returns pin arm ownership (see the legs).
IShapeMove pickJoinNC(CiMove* p, CiMove* q) { return p ?? q; }
IShapeMove pickJoinMixed(CiMove* p, SqMove* q) { return p ?? q; }
int takeJoinIface(IShapeMove s) { return s.area(); }

// CHAINED joins in RETURN position. `p ?? q ?? r` parses as `p ?? (q ?? r)`, so the outer join's
// right arm is the INNER join's result - a value with no concrete class of its own.
IShapeMove pickJoinNC3(CiMove* p, CiMove* q, CiMove* r) { return p ?? q ?? r; }
IShapeMove pickJoinTernChain(CiMove* p, CiMove* q, CiMove* r, bool k, bool m)
{
    return k ? (m ? p : q) : r;
}
IShapeMove pickJoinTernInNC(CiMove* p, CiMove* q, CiMove* r, bool k) { return p ?? (k ? q : r); }

interface IJoinRunner { int run(IShapeMove s); };
class JoinRunner : IJoinRunner { int run(IShapeMove s) { return s.area(); } };

// Overload pairs that pin WHICH candidate a '??' join argument binds to. See the legs.
int joinOverload(CiMove c) { return 1000 + c.r; }
int joinOverload(IShapeMove s) { return s.area(); }
int joinPtrPref(CiMove* c) { return 7000 + c->r; }
int joinPtrPref(IShapeMove s) { return s.area(); }
int joinVoidPref(void* p) { return 500; }
int joinVoidPref(IShapeMove s) { return s.area(); }
int joinCharPref(char* p) { return 400; }
int joinCharPref(IShapeMove s) { return s.area(); }
int joinIntPref(int* p) { return 401; }
int joinIntPref(IShapeMove s) { return s.area(); }

move IShapeMove ownJoinTernary(bool c)
{
    unique CiMove* p = new CiMove(); p->r = 1;
    unique CiMove* q = new CiMove(); q->r = 20;
    return c ? p : q;
}

move IShapeMove ownJoinNC()
{
    unique CiMove* p = new CiMove(); p->r = 2;
    unique CiMove* q = new CiMove(); q->r = 30;
    return p ?? q;
}

int testUniqueInterfaceTernary()
{
    int passed = 0;

    // Declaration initializer, non-null arm taken: adopted, freed exactly once.
    dtorCount = 0;
    {
        unique IShapeMove k = identityBool(true) ? new SqMove() : nullptr;
        passed += Test("unique_iface_ternary_decl_area", k.area(), 0);
        passed += Test("unique_iface_ternary_decl_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_ternary_decl_freed_once", dtorCount, 1);

    // Null arm taken: nothing allocated, nothing freed.
    dtorCount = 0;
    {
        unique IShapeMove k = identityBool(false) ? new SqMove() : nullptr;
    }
    passed += Test("unique_iface_ternary_decl_null_no_free", dtorCount, 0);

    // Reassignment leg: the old (null) box is released, the new one adopted and freed once.
    dtorCount = 0;
    {
        unique IShapeMove k = nullptr;
        k = identityBool(true) ? new SqMove() : nullptr;
        passed += Test("unique_iface_ternary_assign_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_ternary_assign_freed_once", dtorCount, 1);

    // Different concrete classes per arm: only the taken arm is constructed and freed.
    dtorCount = 0;
    ciMoveCtorCount = 0;
    sqMoveCtorCount = 0;
    {
        unique IShapeMove k = identityBool(false) ? new SqMove() : new CiMove();
        passed += Test("unique_iface_ternary_mixed_area", k.area(), 7);
        passed += Test("unique_iface_ternary_mixed_taken_arm", ciMoveCtorCount, 1);
        passed += Test("unique_iface_ternary_mixed_untaken_arm", sqMoveCtorCount, 0);
    }
    passed += Test("unique_iface_ternary_mixed_freed_once", dtorCount, 1);

    // Both arms null: owns nothing, no free, no crash.
    dtorCount = 0;
    {
        unique IShapeMove k = identityBool(true) ? nullptr : nullptr;
    }
    passed += Test("unique_iface_ternary_both_null", dtorCount, 0);

    // Non-unique interface local takes the same upcast path; it does not own, so free by hand.
    dtorCount = 0;
    {
        IShapeMove k = identityBool(true) ? new SqMove() : nullptr;
        passed += Test("iface_ternary_plain_decl_area", k.area(), 0);
        delete k;
    }
    passed += Test("iface_ternary_plain_decl_freed_once", dtorCount, 1);

    // MIXED fat-pointer join: one arm allocates, the other yields a LIVE borrow of a `unique`
    // interface local. Which arm runs is not knowable, so the join owns nothing a receiver may
    // free - a plain local only borrows it. It used to adopt whichever arm the phi selected and
    // destroy the owner's box, which the owner then destroyed again (abort). The allocating arm
    // leaks when selected; that is the accepted trade. The `unique` receiver spelling of this is
    // a compile error (Test/errors/err_move.cb).
    dtorCount = 0;
    {
        unique IShapeMove owner = new SqMove();
        IShapeMove borrowed = owner;
        {
            IShapeMove k = identityBool(false) ? makeShapeMove() : borrowed;
            passed += Test("iface_ternary_mixed_join_borrow_value", k.area(), 0);
            passed += Test("iface_ternary_mixed_join_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_mixed_join_no_adoption", dtorCount, 0);
        passed += Test("iface_ternary_mixed_join_owner_alive", owner.area(), 0);
    }
    passed += Test("iface_ternary_mixed_join_owner_freed_once", dtorCount, 1);

    /*
     * BORROWED THIN-POINTER arm bound to a PLAIN interface local. The borrow arm is a plain load,
     * so it is in no `new`-site ledger and its class used to be unresolvable - the upcast bailed
     * and a raw `ptr` was bitcast into the fat struct (module verification failure, no source
     * location). The arm is now boxed from its DECLARED type. The join is still MIXED, so a plain
     * receiver only borrows it: no adoption, no release, and the owner frees its box exactly once.
     */
    // The two arms carry DIFFERENT concrete classes (area 0 vs 7), so the returned value alone
    // pins WHICH arm ran and that each arm was boxed with its own vtable.
    dtorCount = 0;
    sqMoveCtorCount = 0;
    ciMoveCtorCount = 0;
    {
        unique CiMove* owner = new CiMove();
        {
            // false: the BORROWED arm is selected - the receiver must not free the owner's box.
            IShapeMove k = identityBool(false) ? new SqMove() : owner;
            passed += Test("iface_ternary_thin_borrow_arm_value", k.area(), 7);
            passed += Test("iface_ternary_thin_borrow_arm_untaken_new", sqMoveCtorCount, 0);
            passed += Test("iface_ternary_thin_borrow_arm_owner_ctor", ciMoveCtorCount, 1);
            passed += Test("iface_ternary_thin_borrow_arm_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_thin_borrow_arm_no_adoption", dtorCount, 0);
        passed += Test("iface_ternary_thin_borrow_arm_owner_alive", owner->area(), 7);
    }
    passed += Test("iface_ternary_thin_borrow_arm_owner_freed_once", dtorCount, 1);

    // Same shape, condition inverted: the `new` arm runs (its area 0 proves it was selected) and
    // leaks by accepted design; the borrowed owner is still freed exactly once at its own exit.
    dtorCount = 0;
    sqMoveCtorCount = 0;
    {
        unique CiMove* owner = new CiMove();
        {
            IShapeMove k = identityBool(true) ? new SqMove() : owner;
            passed += Test("iface_ternary_thin_new_arm_value", k.area(), 0);
            passed += Test("iface_ternary_thin_new_arm_taken_new", sqMoveCtorCount, 1);
            passed += Test("iface_ternary_thin_new_arm_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_thin_new_arm_no_adoption", dtorCount, 0);
        passed += Test("iface_ternary_thin_new_arm_owner_alive", owner->area(), 7);
    }
    passed += Test("iface_ternary_thin_new_arm_owner_freed_once", dtorCount, 1);

    // Both arms the SAME class: the value cannot discriminate here, so this leg pins the ownership
    // accounting - a borrowed same-class arm is still not adopted and the owner frees exactly once.
    dtorCount = 0;
    {
        unique SqMove* owner = new SqMove();
        {
            IShapeMove k = identityBool(false) ? new SqMove() : owner;
            passed += Test("iface_ternary_thin_borrow_same_class_value", k.area(), 0);
            passed += Test("iface_ternary_thin_borrow_same_class_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_thin_borrow_same_class_no_adoption", dtorCount, 0);
    }
    passed += Test("iface_ternary_thin_borrow_same_class_owner_freed_once", dtorCount, 1);

    // A BORROWED already-FAT arm (a plain interface-local read, not a thin pointer) mixed with a
    // THIN 'new' arm - the fat/thin harmonizer branch, not the all-thin boxing path above. A plain
    // receiver only borrows the join: no adoption, no double free, owner freed once at its exit.
    dtorCount = 0;
    {
        unique IShapeMove owner = new SqMove();
        IShapeMove borrowed = owner;
        sqMoveCtorCount = 0;
        {
            IShapeMove k = identityBool(true) ? borrowed : new SqMove();
            passed += Test("iface_ternary_fat_borrow_vs_new_value", k.area(), 0);
            passed += Test("iface_ternary_fat_borrow_vs_new_untaken_new", sqMoveCtorCount, 0);
            passed += Test("iface_ternary_fat_borrow_vs_new_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_fat_borrow_vs_new_no_adoption", dtorCount, 0);
        passed += Test("iface_ternary_fat_borrow_vs_new_owner_alive", owner.area(), 0);
    }
    passed += Test("iface_ternary_fat_borrow_vs_new_owner_freed_once", dtorCount, 1);

    /*
     * `move` of an interface-TYPED local mixed with a THIN arm (`new SqMove()` / `nullptr`). The
     * move evaluates directly to the fat {vtable,data} struct (no lazy-boxing step for an
     * already-fat-typed local), while the sibling arm is still thin at the point the ternary
     * harmonizer runs - the fat-vs-thin case UnifyTernaryArmTypes now boxes the thin arm in its
     * own block instead of rejecting the pair as "incompatible types".
     */

    // move-arm TAKEN: g's box transfers to k (one free, at k's scope exit); the untaken 'new' arm
    // never runs (short-circuit); g reads as null afterward (readable-null move contract).
    dtorCount = 0;
    {
        unique IShapeMove g = new SqMove();
        sqMoveCtorCount = 0;
        {
            unique IShapeMove k = identityBool(true) ? move g : new SqMove();
            passed += Test("iface_ternary_move_vs_new_taken_area", k.area(), 0);
            passed += Test("iface_ternary_move_vs_new_taken_new_arm_not_run", sqMoveCtorCount, 0);
            passed += Test("iface_ternary_move_vs_new_taken_g_reads_null", g == nullptr ? 1 : 0, 1);
            passed += Test("iface_ternary_move_vs_new_taken_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_move_vs_new_taken_freed_once", dtorCount, 1);
    }
    passed += Test("iface_ternary_move_vs_new_taken_g_exit_noop", dtorCount, 1);

    // move-arm NOT taken: the 'new' arm runs and is adopted by k (freed once at k's scope exit);
    // g's own object is untouched and still dispatches, freed once at its own scope exit. g is a
    // CiMove (area 7): a SqMove's default field is 0, so area()==0 cannot tell "g alive" apart
    // from "g zeroed" - CiMove's nonzero area proves the real object, not a zeroed box.
    dtorCount = 0;
    sqMoveCtorCount = 0;
    {
        unique IShapeMove g = new CiMove();
        sqMoveCtorCount = 0;
        {
            unique IShapeMove k = identityBool(false) ? move g : new SqMove();
            passed += Test("iface_ternary_move_vs_new_untaken_new_ran", sqMoveCtorCount, 1);
            passed += Test("iface_ternary_move_vs_new_untaken_g_not_null", g == nullptr ? 1 : 0, 0);
            int gArea = -1;
            if (g != nullptr) { gArea = g.area(); }
            passed += Test("iface_ternary_move_vs_new_untaken_g_area", gArea, 7);
            passed += Test("iface_ternary_move_vs_new_untaken_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_move_vs_new_untaken_k_freed_once", dtorCount, 1);
    }
    passed += Test("iface_ternary_move_vs_new_untaken_g_freed_too", dtorCount, 2);

    // Arm order reversed (`new` first, `move` second): same accounting, other arm order.
    dtorCount = 0;
    {
        unique IShapeMove g = new SqMove();
        {
            unique IShapeMove k = identityBool(false) ? new SqMove() : move g;
            passed += Test("iface_ternary_new_vs_move_taken_area", k.area(), 0);
            passed += Test("iface_ternary_new_vs_move_taken_g_reads_null", g == nullptr ? 1 : 0, 1);
        }
        passed += Test("iface_ternary_new_vs_move_taken_freed_once", dtorCount, 1);
    }
    passed += Test("iface_ternary_new_vs_move_taken_g_exit_noop", dtorCount, 1);

    // `nullptr` as the thin arm, move TAKEN: same one-free/readable-null accounting as the
    // `new` sibling above.
    dtorCount = 0;
    {
        unique IShapeMove g = new SqMove();
        {
            unique IShapeMove k = identityBool(true) ? move g : nullptr;
            passed += Test("iface_ternary_move_vs_null_taken_area", k.area(), 0);
            passed += Test("iface_ternary_move_vs_null_taken_g_reads_null", g == nullptr ? 1 : 0, 1);
            passed += Test("iface_ternary_move_vs_null_taken_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_move_vs_null_taken_freed_once", dtorCount, 1);
    }
    passed += Test("iface_ternary_move_vs_null_taken_g_exit_noop", dtorCount, 1);

    // `nullptr` as the thin arm, move NOT taken: k is null (frees nothing), g stays alive and is
    // freed exactly once at its own scope exit. g is a CiMove (area 7) for the same
    // discriminating-value reason as the leg above (a SqMove's area is 0 either way).
    dtorCount = 0;
    {
        unique IShapeMove g = new CiMove();
        {
            unique IShapeMove k = identityBool(false) ? move g : nullptr;
            passed += Test("iface_ternary_move_vs_null_untaken_k_null", k == nullptr ? 1 : 0, 1);
            int gAliveArea = -1;
            if (g != nullptr) { gAliveArea = g.area(); }
            passed += Test("iface_ternary_move_vs_null_untaken_g_alive", gAliveArea, 7);
            passed += Test("iface_ternary_move_vs_null_untaken_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_ternary_move_vs_null_untaken_k_null_no_free", dtorCount, 0);
    }
    passed += Test("iface_ternary_move_vs_null_untaken_g_freed_once", dtorCount, 1);

    /*
     * BINDING-ERASED sources. Every guard on the class->interface boxing path used to key off the
     * source's NamedVariable, so a spelling that carries no binding - parentheses around the
     * operand, with or without 'as' - skipped the ownership transfer entirely. The box and the
     * source both owned the object and it was freed twice (SIGTRAP/SIGABRT, no diagnostic). The
     * transfer is keyed on the VALUE now, so every spelling agrees with the plain `k = owner` one.
     * dtorCount is the discriminator: exactly one free, and the second free would abort the run.
     */
    dtorCount = 0;
    {
        CiMove* pOwner = new CiMove();
        IShapeMove pk = (pOwner);
        passed += Test("iface_paren_box_value", pk.area(), 7);
        passed += Test("iface_paren_box_no_early_free", dtorCount, 0);
        delete pk;
        passed += Test("iface_paren_box_freed_once", dtorCount, 1);
    }
    passed += Test("iface_paren_box_source_not_freed_again", dtorCount, 1);

    dtorCount = 0;
    {
        CiMove* aOwner = new CiMove();
        IShapeMove ak = (aOwner) as IShapeMove;
        passed += Test("iface_paren_as_box_value", ak.area(), 7);
        delete ak;
        passed += Test("iface_paren_as_box_freed_once", dtorCount, 1);
    }
    passed += Test("iface_paren_as_box_source_not_freed_again", dtorCount, 1);

    // The assignment-STATEMENT spelling of the same erasure. It is a different code path from the
    // declaration initializer and was open-coded until it was routed through the shared helper.
    dtorCount = 0;
    {
        CiMove* sOwner = new CiMove();
        IShapeMove sk = nullptr;
        sk = (sOwner);
        passed += Test("iface_paren_assign_box_value", sk.area(), 7);
        delete sk;
        passed += Test("iface_paren_assign_box_freed_once", dtorCount, 1);
    }
    passed += Test("iface_paren_assign_box_source_not_freed_again", dtorCount, 1);

    /*
     * FALSE-REJECTION tripwires for the borrowed-box 'delete' guard (the reject half lives in
     * Test/errors/err_delete_borrowed_interface_box.cb, which cannot assert values). Every leg
     * here compiles and gives these values on master too - they exist to catch the guard growing
     * one cell too wide, which is how this area has failed before. Values, not "it compiled":
     * SqMove.area() is 0 and CiMove.area() is 7, so the sums pin WHICH box each leg read, and
     * dtorCount pins that each object is freed exactly once and never early.
     */
    dtorCount = 0;
    {
        CiMove* bOwner = new CiMove();
        // 7 (borrowed CiMove) + 0 (owned SqMove); only the SqMove is freed inside the call.
        passed += Test("delete_borrowed_box_owned_sibling_value", borrowAndOwnShape(bOwner), 7);
        passed += Test("delete_borrowed_box_owned_sibling_freed_once", dtorCount, 1);
        passed += Test("delete_borrowed_box_borrow_source_alive", bOwner->area(), 7);
        delete bOwner;
        passed += Test("delete_borrowed_box_borrow_source_freed_once", dtorCount, 2);
    }

    dtorCount = 0;
    {
        CiMove* rOwner = new CiMove();
        passed += Test("delete_borrowed_box_reassigned_local", borrowThenOwnShape(rOwner, true), 1);
        // Exactly one free inside the call: the SqMove the reassignment allocated.
        passed += Test("delete_borrowed_box_reassigned_freed_once", dtorCount, 1);
        passed += Test("delete_borrowed_box_reassigned_source_alive", rOwner->area(), 7);
        delete rOwner;
        passed += Test("delete_borrowed_box_reassigned_source_freed_once", dtorCount, 2);
    }

    // Every way a local can come to own a heap object before being boxed. All of these compile and
    // free exactly once on master; the guard must not take any of them away. CiMove.area() is 7.
    dtorCount = 0;
    passed += Test("delete_box_late_assigned_value", lateAssignedOwnerBox(), 7);
    passed += Test("delete_box_late_assigned_freed_once", dtorCount, 1);

    dtorCount = 0;
    passed += Test("delete_box_late_ascast_value", lateAssignedAsCastBox(), 7);
    passed += Test("delete_box_late_ascast_freed_once", dtorCount, 1);

    dtorCount = 0;
    passed += Test("delete_box_branch_assigned_factory_arm", branchAssignedOwnerBox(true), 7);
    passed += Test("delete_box_branch_assigned_new_arm", branchAssignedOwnerBox(false), 7);
    passed += Test("delete_box_branch_assigned_freed_twice", dtorCount, 2);

    dtorCount = 0;
    passed += Test("delete_box_loop_assigned_total", loopAssignedOwnerBox(), 21);
    passed += Test("delete_box_loop_assigned_freed_thrice", dtorCount, 3);

    dtorCount = 0;
    {
        PlainHolderMove* ph = new PlainHolderMove();
        ph->h = new CiMove();
        passed += Test("delete_box_plain_field_read", plainFieldReadBox(ph), 7);
        passed += Test("delete_box_plain_field_freed_once", dtorCount, 1);
        delete ph;
        // This holder frees nothing of its own, so the count stays at 1. That is what makes the
        // probe well-defined - it is NOT a proof that a plain-field box is always safe to delete.
        passed += Test("delete_box_plain_field_holder_frees_nothing", dtorCount, 1);
    }

    /*
     * The two shapes a NEGATIVE read of an ownership flag false-rejected. Both compile and free
     * exactly once on master, and in both the rejected local was the SOLE owner - so the advice
     * "let the source release it" would have leaked. Free counts, not compilation, are what
     * discriminates: a leg that only checked that these compile would not have caught either.
     */
    dtorCount = 0;
    passed += Test("delete_box_alias_return_owner_value", aliasReturnOwnerBox(), 7);
    passed += Test("delete_box_alias_return_owner_freed_once", dtorCount, 1);

    dtorCount = 0;
    passed += Test("delete_box_alias_result_reassigned_value", aliasResultReassignedBox(), 7);
    passed += Test("delete_box_alias_result_reassigned_freed_twice", dtorCount, 2);

    dtorCount = 0;
    {
        CiMove* outer = new CiMove();
        // 7 from the shadowing local's own object + 7 from the caller's, proving both are live.
        passed += Test("delete_box_shadowed_param_value", shadowedParamNameBox(outer), 14);
        passed += Test("delete_box_shadowed_param_freed_once", dtorCount, 1);
        passed += Test("delete_box_shadowed_param_caller_alive", outer->area(), 7);
        delete outer;
        passed += Test("delete_box_shadowed_param_freed_twice", dtorCount, 2);
    }

    dtorCount = 0;
    {
        CiMove* held = new CiMove();
        passed += Test("delete_box_param_reassigned_value", paramReassignedBox(held), 7);
        passed += Test("delete_box_param_reassigned_freed_once", dtorCount, 1);
        passed += Test("delete_box_param_reassigned_caller_alive", held->area(), 7);
        delete held;
        passed += Test("delete_box_param_reassigned_freed_twice", dtorCount, 2);
    }

    dtorCount = 0;
    passed += Test("delete_box_coalesce_assigned_value", coalesceAssignedOwnerBox(nullptr), 7);
    passed += Test("delete_box_coalesce_assigned_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        CiMove* kept = new CiMove();
        passed += Test("delete_box_hop_reassigned_value", hopReassignedBox(kept), 7);
        passed += Test("delete_box_hop_reassigned_freed_once", dtorCount, 1);
        passed += Test("delete_box_hop_reassigned_caller_alive", kept->area(), 7);
        delete kept;
        passed += Test("delete_box_hop_reassigned_freed_twice", dtorCount, 2);
    }

    // Copy-of-an-owning-local retirement. Each leg's value pins WHICH objects were read (the
    // reassigned object carries a distinct `r`), and the free counts pin that both objects are
    // released exactly once - a leg checking only that these compile would miss the leak direction.
    dtorCount = 0;
    passed += Test("delete_copy_owner_reassign_copy_value", copyOfOwnerReassignedCopy(), 17);
    passed += Test("delete_copy_owner_reassign_copy_freed_twice", dtorCount, 2);

    dtorCount = 0;
    passed += Test("delete_copy_owner_reassign_source_value", copyOfOwnerReassignedSource(), 18);
    passed += Test("delete_copy_owner_reassign_source_freed_twice", dtorCount, 2);

    dtorCount = 0;
    passed += Test("delete_copy_owner_reassign_source_box_value", copyOfOwnerReassignedSourceBox(), 19);
    passed += Test("delete_copy_owner_reassign_source_box_freed_twice", dtorCount, 2);

    dtorCount = 0;
    passed += Test("delete_copy_owner_delete_owner_value", copyOfOwnerDeleteOwner(), 7);
    passed += Test("delete_copy_owner_delete_owner_freed_once", dtorCount, 1);

    dtorCount = 0;
    passed += Test("delete_box_elem_reassigned_value", elemBorrowReassignedBox(), 7);
    passed += Test("delete_box_elem_reassigned_freed_twice", dtorCount, 2);

    dtorCount = 0;
    passed += Test("coalesce_revives_moved_local_value", coalesceRevivesMovedLocal(), 19);
    passed += Test("coalesce_revives_moved_local_freed_twice", dtorCount, 2);

    dtorCount = 0;
    passed += Test("delete_box_coalesce_elem_fallback_value", coalesceElemFallbackBox(), 7);
    passed += Test("delete_box_coalesce_elem_fallback_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        CiMove* qOwned = new CiMove();
        passed += Test("delete_box_coalesce_sole_owner_value", coalesceSoleOwnerLhsBox(qOwned), 7);
        passed += Test("delete_box_coalesce_sole_owner_freed_once", dtorCount, 1);
        passed += Test("delete_box_coalesce_sole_owner_caller_alive", qOwned->area(), 7);
        delete qOwned;
        passed += Test("delete_box_coalesce_sole_owner_freed_twice", dtorCount, 2);
    }

    // The cast-RHS twin: value 7 pins that the LHS's own object was boxed, and dtors=2 pins that
    // both it and the owning local the cast named were released exactly once.
    dtorCount = 0;
    passed += Test("delete_box_coalesce_cast_value", coalesceCastSoleOwnerLhsBox(), 7);
    passed += Test("delete_box_coalesce_cast_freed_twice", dtorCount, 2);

    /*
     * A '??' join into an interface. It joins through a SLOT rather than a phi, so its result
     * carried no class name, every boxing branch was skipped, and a raw 'ptr' was stored into the
     * fat slot - the compile died on an LLVM module-verifier dump with no source location. Both
     * arms are boxed per arm now. The two legs select DIFFERENT arms and the arms carry different
     * areas, so neither leg can pass off the other arm's box.
     */
    {
        CiMove* ncA = new CiMove(); ncA->r = 2;
        CiMove* ncB = new CiMove(); ncB->r = 30;
        CiMove* ncNull = nullptr;
        IShapeMove ncRight = ncNull ?? ncB;
        passed += Test("iface_nullcoalesce_right_arm", ncRight.area(), 37);
        IShapeMove ncLeft = ncA ?? ncB;
        passed += Test("iface_nullcoalesce_left_arm", ncLeft.area(), 9);
        delete ncA;
        delete ncB;
    }

    /*
     * The same '??' join in RETURN and CALL-ARGUMENT position - both unfixed when the decl-init
     * half landed. The return reached the module verifier with no source location; the argument
     * was a false rejection ("no overload of 'takeJoinIface' matches"), because a join carries no
     * TypeName for the scorer's interface clause to score. Each pair selects a DIFFERENT arm and
     * the arms carry different areas, so no leg can pass off the other arm's box. A compile-only
     * check would be VACUOUS here: the pre-fix failure and a fix that does not engage (the ledger
     * keys on load identity, so any intermediate spill silently misses) are both exit 1.
     */
    {
        CiMove* rA = new CiMove(); rA->r = 2;
        CiMove* rB = new CiMove(); rB->r = 30;
        CiMove* rNull = nullptr;
        passed += Test("iface_nullcoalesce_return_right_arm", pickJoinNC(rNull, rB).area(), 37);
        passed += Test("iface_nullcoalesce_return_left_arm", pickJoinNC(rA, rB).area(), 9);
        passed += Test("iface_nullcoalesce_arg_right_arm", takeJoinIface(rNull ?? rB), 37);
        passed += Test("iface_nullcoalesce_arg_left_arm", takeJoinIface(rA ?? rB), 9);
        delete rA;
        delete rB;
    }

    /*
     * Arms of DIFFERENT concrete classes through the same RETURN (each arm is boxed in its own
     * block, so each gets its own vtable - the two legs carry different areas to pin that), and a
     * '??' argument to a VIRTUALLY DISPATCHED method. The latter boxes off TypeName as well, so an
     * empty one used to reach GetOrCreateVTable as "'' does not implement 'IShapeMove::area'" -
     * that spelling failed identically on the pre-fix binary and on master.
     */
    {
        CiMove* mA = new CiMove(); mA->r = 2;
        SqMove* mB = new SqMove(); mB->s = 6;
        CiMove* mNull = nullptr;
        passed += Test("iface_nullcoalesce_return_mixed_right", pickJoinMixed(mNull, mB).area(), 36);
        passed += Test("iface_nullcoalesce_return_mixed_left", pickJoinMixed(mA, mB).area(), 9);
        IJoinRunner runner = new JoinRunner();
        passed += Test("iface_nullcoalesce_arg_virtual_dispatch", runner.run(mNull ?? mA), 9);
        // MIXED-class arms in ARGUMENT position: the target interface is resolved from the
        // candidate set and each arm boxes with its OWN vtable, so the arms need not agree.
        passed += Test("iface_nullcoalesce_arg_mixed_class", takeJoinIface(mNull ?? mB), 36);

        /*
         * WHICH candidate a '??' join argument binds to. The join is a `CiMove*`.
         * - Against `joinOverload(CiMove)` / `joinOverload(IShapeMove)` the INTERFACE candidate
         *   must win: a pointer cannot bind a by-value class parameter. An earlier cut stamped
         *   the arms' CLASS name instead of boxing, and because IsTypeMatch ignores Pointer the
         *   BY-VALUE candidate scored perfect and won - lowering a raw pointer into a struct slot
         *   (verifier dump, no location). 9 is the interface answer; 1002 would be by-value.
         * - Against a POINTER competitor the POINTER candidate must win: boxing runs BEFORE the
         *   scorer, so pre-empting one silently runs a DIFFERENT FUNCTION with no diagnostic on
         *   either side. All FOUR pointer spellings are covered on purpose - the bail was once
         *   narrowed to pointers-to-a-CLASS, which left `void*` / `char*` / `int*` competitors
         *   stolen (each returned the interface's 9 instead of its own value) while the CiMove*
         *   leg below still passed, so that leg alone is structurally blind to the defect.
         */
        passed += Test("iface_nullcoalesce_arg_interface_beats_byvalue", joinOverload(mNull ?? mA), 9);
        passed += Test("iface_nullcoalesce_arg_class_ptr_preferred", joinPtrPref(mNull ?? mA), 7002);
        passed += Test("iface_nullcoalesce_arg_void_ptr_preferred", joinVoidPref(mNull ?? mA), 500);
        passed += Test("iface_nullcoalesce_arg_char_ptr_preferred", joinCharPref(mNull ?? mA), 400);
        passed += Test("iface_nullcoalesce_arg_int_ptr_preferred", joinIntPref(mNull ?? mA), 401);
        delete mA;
        delete mB;
    }

    /*
     * CHAINED joins into an interface. `a ?? b ?? c` parses as `a ?? (b ?? c)`, so the outer
     * join's right arm is the INNER join's result - a load off the inner slot with no concrete
     * class, which ResolvePointerElementTypeName cannot name. Every position below was rejected
     * before: argument as "no overload of 'takeJoinIface' matches", the rest as "cannot convert
     * '??' arm to interface: the arm's concrete class cannot be determined".
     *
     * The arms are NOT flattened into one arm list: the inner arms' blocks branch to the INNER
     * resume block, so they are not predecessors of the outer join point and a flat phi over them
     * is invalid IR. The inner join is boxed in its own resume block and the outer phi takes THAT
     * block. Each leg below selects a DIFFERENT arm and every arm carries a different area, so no
     * leg can pass off another arm's box - which is what makes them non-vacuous: a compile-only
     * check cannot tell a correct fix from one that boxes the wrong arm.
     */
    {
        CiMove* c1 = new CiMove(); c1->r = 2;      // area 9
        CiMove* c2 = new CiMove(); c2->r = 30;     // area 37
        CiMove* c3 = new CiMove(); c3->r = 100;    // area 107
        CiMove* c4 = new CiMove(); c4->r = 50;     // area 57
        CiMove* cNull = nullptr;

        // Declaration initializer, chain length 3 - each of the three arms selected in turn.
        IShapeMove d1 = cNull ?? cNull ?? c3;
        IShapeMove d2 = cNull ?? c2 ?? c3;
        IShapeMove d3 = c1 ?? c2 ?? c3;
        passed += Test("iface_ncchain_decl_third_arm",  d1.area(), 107);
        passed += Test("iface_ncchain_decl_second_arm", d2.area(), 37);
        passed += Test("iface_ncchain_decl_first_arm",  d3.area(), 9);

        // Chain length 4: the recursion has to descend two levels, not just one.
        IShapeMove d4 = cNull ?? cNull ?? cNull ?? c4;
        passed += Test("iface_ncchain_decl_len4_fourth_arm", d4.area(), 57);

        // Call-argument position, where the target interface is resolved from the candidate set
        // before boxing - so the recursive class collection has to reach the LEAF arms.
        passed += Test("iface_ncchain_arg_third_arm",  takeJoinIface(cNull ?? cNull ?? c3), 107);
        passed += Test("iface_ncchain_arg_second_arm", takeJoinIface(cNull ?? c2 ?? c3), 37);
        passed += Test("iface_ncchain_arg_len4",       takeJoinIface(cNull ?? cNull ?? cNull ?? c4), 57);

        // Return position.
        passed += Test("iface_ncchain_return_third_arm",  pickJoinNC3(cNull, cNull, c3).area(), 107);
        passed += Test("iface_ncchain_return_second_arm", pickJoinNC3(cNull, c2, c3).area(), 37);
        passed += Test("iface_ncchain_return_first_arm",  pickJoinNC3(c1, c2, c3).area(), 9);

        // Assignment to an EXISTING interface local - a different boxing site from decl-init.
        IShapeMove asg = default;
        asg = cNull ?? c2 ?? c3;
        passed += Test("iface_ncchain_assign_second_arm", asg.area(), 37);

        // An explicitly parenthesized LEFT sub-chain: `(a ?? b) ?? c` nests the join in the
        // outer join's LEFT arm, the mirror of the shape the grammar produces on its own.
        IShapeMove pl = (cNull ?? c2) ?? c3;
        passed += Test("iface_ncchain_paren_left_second_arm", pl.area(), 37);
        passed += Test("iface_ncchain_paren_left_arg", takeJoinIface((cNull ?? cNull) ?? c3), 107);

        delete c1; delete c2; delete c3; delete c4;
    }

    /*
     * MIXED classes across a chain, and the two join spellings NESTED IN EACH OTHER. A nested arm
     * is boxed by whichever spelling it is, so `??` inside `?:` and `?:` inside `??` both work and
     * the arms need not share a class - each leaf arm gets its own vtable in its own block. The
     * '?:'-in-'?:' legs carry NO '??' at all: the same defect reached a pure ternary chain, which
     * is why this is not filed as a '??' bug. `identityBool` keeps the condition out of reach of
     * constant folding, so both arms are really emitted.
     */
    {
        CiMove* nA = new CiMove(); nA->r = 2;      // area 9
        CiMove* nB = new CiMove(); nB->r = 30;     // area 37
        SqMove* nS = new SqMove(); nS->s = 6;      // area 36
        CiMove* nNull = nullptr;

        // Chain whose surviving arm is a DIFFERENT concrete class from the earlier arms.
        IShapeMove mx = nNull ?? nNull ?? nS;
        passed += Test("iface_ncchain_mixed_class_decl", mx.area(), 36);
        passed += Test("iface_ncchain_mixed_class_arg", takeJoinIface(nNull ?? nNull ?? nS), 36);

        // '?:' nested inside a '??' arm.
        IShapeMove t1 = nNull ?? (identityBool(true) ? nA : nB);
        IShapeMove t2 = nNull ?? (identityBool(false) ? nA : nB);
        passed += Test("iface_tern_in_nc_decl_true",  t1.area(), 9);
        passed += Test("iface_tern_in_nc_decl_false", t2.area(), 37);
        passed += Test("iface_tern_in_nc_arg", takeJoinIface(nNull ?? (identityBool(false) ? nA : nS)), 36);
        passed += Test("iface_tern_in_nc_return", pickJoinTernInNC(nNull, nA, nB, false).area(), 37);

        // '??' nested inside a '?:' arm.
        IShapeMove t3 = identityBool(true) ? (nNull ?? nB) : nA;
        passed += Test("iface_nc_in_tern_decl", t3.area(), 37);
        passed += Test("iface_nc_in_tern_arg", takeJoinIface(identityBool(true) ? (nNull ?? nS) : nA), 36);

        // A pure '?:' CHAIN - no '??' anywhere - in decl, argument and return position.
        IShapeMove t4 = identityBool(true) ? (identityBool(false) ? nA : nB) : nA;
        passed += Test("iface_ternchain_decl", t4.area(), 37);
        passed += Test("iface_ternchain_arg",
                       takeJoinIface(identityBool(true) ? (identityBool(false) ? nA : nS) : nA), 36);
        passed += Test("iface_ternchain_return", pickJoinTernChain(nA, nB, nA, true, false).area(), 37);

        // A SINGLE '?:' in ARGUMENT position: the argument-side boxing helper only ever handled
        // the '??' spelling, so this was a "no overload" rejection too - not a chain at all.
        passed += Test("iface_tern_single_arg", takeJoinIface(identityBool(false) ? nA : nB), 37);

        delete nA; delete nB; delete nS;
    }

    /*
     * OWNERSHIP PIN for a 'move <interface>' RETURN of a join. The box ESCAPES the frame, so the
     * TAKEN arm's owning local is nulled inside its own arm block while the untaken arm still runs
     * its ordinary scope-exit free - hence exactly one destructor before the caller's scope ends
     * and two after. Drop that transfer (pass transferArmOwnership=false at the return site) and
     * both locals free at function exit: the '..._untaken_arm_freed' leg reads 2 and the process
     * then aborts 134 freeing the taken arm twice - measured. The '?:' leg pins the behaviour that
     * already worked; the '??' leg is new (it was a false "returned expression is not owned"
     * rejection before this join was boxed here).
     */
    dtorCount = 0;
    {
        unique IShapeMove k = ownJoinTernary(identityBool(true));
        passed += Test("iface_ternary_move_return_area", k.area(), 8);
        passed += Test("iface_ternary_move_return_untaken_arm_freed", dtorCount, 1);
    }
    passed += Test("iface_ternary_move_return_freed_once", dtorCount, 2);

    dtorCount = 0;
    {
        unique IShapeMove k = ownJoinNC();
        passed += Test("iface_nullcoalesce_move_return_area", k.area(), 9);
        passed += Test("iface_nullcoalesce_move_return_untaken_arm_freed", dtorCount, 1);
    }
    passed += Test("iface_nullcoalesce_move_return_freed_once", dtorCount, 2);

    return passed;
}

/*
 * Interface INHERITANCE mismatch through a '?:' join: the fat arm's ledgered interface differs
 * from the receiver's declared interface (derived vs parent, or parent vs derived). A derived
 * vtable is not layout-compatible with its parent's once field-offset slots exist, so an
 * un-reboxed join dispatches through the wrong vtable slot (e.g. calls 'draw' where the
 * destructor was expected). ReboxInterfaceIfNeeded/RebuildInterfaceFatValue - the same runtime
 * typedesc-matching rebox a plain (non-ternary) derived-to-parent move already used - now also
 * fires for a '?:' join via the per-arm ledger (RegisterFatInterfaceValueTypeName /
 * PropagateFatInterfaceJoin), which also fixes the PRE-EXISTING all-fat case (both arms already
 * fat, e.g. two `move`s of a derived-typed local, joined into a parent-typed receiver).
 */
int testTernaryInterfaceInheritanceRebox()
{
    int passed = 0;

    // Fat arm (move of a DERIVED-typed local) vs thin 'new' arm; receiver is the PARENT interface.
    dtorCount = 0;
    circleDrawCount = 0;
    {
        unique IDrawableBase g = new Circle();
        {
            unique IShapeBase k = identityBool(true) ? move g : new Circle();
            passed += Test("iface_inherit_move_derived_vs_new_area", k.area(), 16);
            passed += Test("iface_inherit_move_derived_vs_new_no_wrong_dispatch", circleDrawCount, 0);
            passed += Test("iface_inherit_move_derived_vs_new_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_inherit_move_derived_vs_new_freed_once", dtorCount, 1);
    }

    // Same shape, move NOT taken: the thin 'new' arm (parent-interface receiver) runs and frees
    // correctly; g (derived-typed) stays alive and frees once at its own scope exit.
    dtorCount = 0;
    circleCtorCount = 0;
    {
        unique IDrawableBase g = new Circle();
        circleCtorCount = 0;
        {
            unique IShapeBase k = identityBool(false) ? move g : new Circle();
            passed += Test("iface_inherit_move_derived_vs_new_untaken_new_ran", circleCtorCount, 1);
            passed += Test("iface_inherit_move_derived_vs_new_untaken_area", k.area(), 16);
            int gArea = -1;
            if (g != nullptr) { gArea = g.area(); }
            passed += Test("iface_inherit_move_derived_vs_new_untaken_g_alive", gArea, 16);
        }
        passed += Test("iface_inherit_move_derived_vs_new_untaken_k_freed_once", dtorCount, 1);
    }
    passed += Test("iface_inherit_move_derived_vs_new_untaken_g_freed_too", dtorCount, 2);

    // PRE-EXISTING all-fat case: both arms already fat (two derived-typed moves), receiver is the
    // PARENT interface. This miscompiled on master too (draw() called instead of the destructor);
    // the same rebox now fixes it, since PropagateFatInterfaceJoin ledgers the phi's interface.
    dtorCount = 0;
    circleDrawCount = 0;
    {
        unique IDrawableBase g1 = new Circle();
        unique IDrawableBase g2 = new Circle();
        {
            unique IShapeBase k = identityBool(true) ? move g1 : move g2;
            passed += Test("iface_inherit_allfat_area", k.area(), 16);
            passed += Test("iface_inherit_allfat_no_wrong_dispatch", circleDrawCount, 0);
        }
        passed += Test("iface_inherit_allfat_freed_once", dtorCount, 1);
    }

    // DIFFERENT-interface fat arms: one arm a PARENT-typed move, the other a DERIVED-typed move.
    // PropagateFatInterfaceJoin cannot pick either arm's name here, so it ledgers the ambiguous
    // sentinel, forcing ReboxInterfaceIfNeeded to always rebuild at the receiver - this is the
    // reviewer's exact repro (derived arm taken used to call 'draw' instead of the destructor).
    dtorCount = 0;
    circleDrawCount = 0;
    {
        unique IShapeBase gs = new Circle();
        unique IDrawableBase gd = new Circle();
        {
            unique IShapeBase k = identityBool(false) ? move gs : move gd;
            passed += Test("iface_inherit_diffarm_false_taken_area", k.area(), 16);
            passed += Test("iface_inherit_diffarm_false_taken_no_wrong_dispatch", circleDrawCount, 0);
        }
        passed += Test("iface_inherit_diffarm_false_taken_freed_once", dtorCount, 1);
    }

    // Same different-interface arms, opposite direction: the PARENT-typed arm is taken.
    dtorCount = 0;
    circleDrawCount = 0;
    {
        unique IShapeBase gs2 = new Circle();
        unique IDrawableBase gd2 = new Circle();
        {
            unique IShapeBase k = identityBool(true) ? move gs2 : move gd2;
            passed += Test("iface_inherit_diffarm_true_taken_area", k.area(), 16);
            passed += Test("iface_inherit_diffarm_true_taken_no_wrong_dispatch", circleDrawCount, 0);
        }
        passed += Test("iface_inherit_diffarm_true_taken_freed_once", dtorCount, 1);
    }

    // Reverse direction: fat arm is a PARENT-typed local, receiver is the DERIVED interface - the
    // extra 'draw' vtable slot is filled in fresh by the rebox, not inherited from the parent box.
    dtorCount = 0;
    circleDrawCount = 0;
    {
        unique IShapeBase g = new Circle();
        {
            unique IDrawableBase k = identityBool(false) ? move g : new Circle();
            passed += Test("iface_inherit_parent_vs_new_area", k.area(), 16);
            k.draw();
            passed += Test("iface_inherit_parent_vs_new_draw_ran", circleDrawCount, 1);
            passed += Test("iface_inherit_parent_vs_new_no_early_free", dtorCount, 0);
        }
        passed += Test("iface_inherit_parent_vs_new_freed_once", dtorCount, 1);
    }

    return passed;
}

// Fixtures for the '?:' join-as-by-value-call-argument regression: a ternary phi/select of two
// interface values carried no IsInterface/TypeName of its own, so overload resolution saw the
// raw "__iface_fat_ptr" LLVM struct name instead of the interface name and rejected every
// by-value interface parameter (fix: ParseAssignmentExpressionNamed's ternary fallback now
// recovers the interface name from the PropagateFatInterfaceJoin ledger).
int useShapeMoveByValue(IShapeMove s) { return s.area(); }
IShapeMove pickShapeMoveByValue(bool cond, IShapeMove a, IShapeMove b) { return cond ? a : b; }

int testIfaceTernaryByValueCallArg()
{
    int passed = 0;

    // The original repro: a '?:' join of two plain (non-unique) interface locals passed BY VALUE
    // to a function parameter typed as the interface. Used to fail overload resolution entirely
    // ("no overload of 'useShapeMoveByValue' matches the given arguments").
    dtorCount = 0;
    {
        unique IShapeMove ownerA = new SqMove();
        unique IShapeMove ownerB = new CiMove();
        IShapeMove a = ownerA;
        IShapeMove b = ownerB;
        passed += Test("iface_ternary_byval_call_arg_true", useShapeMoveByValue(identityBool(true) ? a : b), 0);
        passed += Test("iface_ternary_byval_call_arg_false", useShapeMoveByValue(identityBool(false) ? a : b), 7);
    }
    passed += Test("iface_ternary_byval_call_arg_freed_twice", dtorCount, 2);

    // Assignment to an interface local.
    dtorCount = 0;
    {
        unique IShapeMove ownerA = new SqMove();
        unique IShapeMove ownerB = new CiMove();
        IShapeMove a = ownerA;
        IShapeMove b = ownerB;
        IShapeMove c;
        c = identityBool(false) ? a : b;
        passed += Test("iface_ternary_byval_assign", c.area(), 7);
    }
    passed += Test("iface_ternary_byval_assign_freed_twice", dtorCount, 2);

    // Return of the join.
    dtorCount = 0;
    {
        unique IShapeMove ownerA = new SqMove();
        unique IShapeMove ownerB = new CiMove();
        IShapeMove a = ownerA;
        IShapeMove b = ownerB;
        IShapeMove picked = pickShapeMoveByValue(true, a, b);
        passed += Test("iface_ternary_byval_return", picked.area(), 0);
    }
    passed += Test("iface_ternary_byval_return_freed_twice", dtorCount, 2);

    // Borrowed vs owning arm mix passed by value: neither arm dominates, so the join owns
    // nothing; the by-value parameter still resolves and reads the correct arm's area().
    dtorCount = 0;
    {
        unique IShapeMove owner = new SqMove();
        IShapeMove borrowed = owner;
        passed += Test("iface_ternary_byval_mixed_owning_call_arg",
            useShapeMoveByValue(identityBool(false) ? makeShapeMove() : borrowed), 0);
    }
    passed += Test("iface_ternary_byval_mixed_owning_freed_once", dtorCount, 1);

    // Method call directly on the join (no intermediate local at all).
    dtorCount = 0;
    {
        unique IShapeMove ownerA = new SqMove();
        unique IShapeMove ownerB = new CiMove();
        IShapeMove a = ownerA;
        IShapeMove b = ownerB;
        passed += Test("iface_ternary_byval_direct_method_call", (identityBool(false) ? a : b).area(), 7);
    }
    passed += Test("iface_ternary_byval_direct_method_call_freed_twice", dtorCount, 2);

    return passed;
}

int testUniqueInterfaceReassign()
{
    int passed = 0;

    // Direct `new` RHS: the local adopts the box and frees it once at scope exit.
    dtorCount = 0;
    {
        unique IShapeMove k = nullptr;
        k = new SqMove();
        passed += Test("unique_iface_reassign_new_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_reassign_new_freed_once", dtorCount, 1);

    // A move-returning call transfers ownership through lastCallReturnsOwned.
    dtorCount = 0;
    {
        unique IShapeMove k = nullptr;
        k = makeShapeMove();
        passed += Test("unique_iface_reassign_movecall_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_reassign_movecall_freed_once", dtorCount, 1);

    // `move` of an OWNING interface local: the source is consumed, so exactly one free.
    dtorCount = 0;
    {
        unique IShapeMove g = new SqMove();
        unique IShapeMove k = nullptr;
        k = move g;
        passed += Test("unique_iface_reassign_move_alive", dtorCount, 0);
    }
    passed += Test("unique_iface_reassign_move_freed_once", dtorCount, 1);

    // Reassigning an already-owning slot frees the OLD box at the store, the new one at exit.
    dtorCount = 0;
    {
        unique IShapeMove k = new SqMove();
        k = new SqMove();
        passed += Test("unique_iface_reassign_drops_old_at_assign", dtorCount, 1);
    }
    passed += Test("unique_iface_reassign_old_and_new_freed_once", dtorCount, 2);

    return passed;
}

// By-value owning-struct producer for the '?:' join legs below: the result is a fresh owner the
// caller adopts (registered in the owning-RETURN ledger), unlike a plain load of a named local.
UniqueBox makeUniqueBox(int id)
{
    UniqueBox b;
    b.item = new Resource();
    b.item->id = id;
    return b;
}

// An `alias`-returning accessor hands back a BORROW of a field the wrapper still owns. Its call
// result must NOT score as an owning '?:' arm, or the join adopts and destroys the wrapper's value.
struct BoxWrap
{
    UniqueBox b;
    alias UniqueBox borrow() { return this.b; }
};

// `alias` is the sanctioned pass-through for a mixed join in a RETURN slot: the borrow travels to
// the caller instead of transferring, so the reject that fires for a plain return must not fire.
alias UniqueBox pickBorrowedBox(UniqueBox borrowed, bool c)
{
    return c ? makeUniqueBox(7) : borrowed;
}

// A plain by-value parameter READS a borrow without persisting it - no destructor of its own runs
// over the borrowed storage, so passing an `alias`-return local here must stay legal.
int readBoxId(UniqueBox b) { return b.item->id; }

// Handing a borrow LOCAL onward through an `alias` return: the sanctioned way to pass one along.
alias UniqueBox handBorrow(BoxWrap* w) { UniqueBox k = w->borrow(); return k; }

// A real `move` sink: the callee owns the value and frees it on return.
void sinkUniqueBox(move UniqueBox b) { }

// A `move Resource*` sink for the re-bound-borrow legs: it adopts the pointee and frees it.
void sinkBoxItem(move Resource* p) { }

// A by-value owning-struct FIELD of a temp (`makeBoxHolder(2).b`) - the fourth spelling that
// re-binds a borrow local, through the movable-temp-field arm rather than the generic drop-old.
struct BoxHolder { UniqueBox b; };
BoxHolder makeBoxHolder(int id) { BoxHolder h; h.b = makeUniqueBox(id); return h; }

// Keeps a conditional rebind genuinely conditional at run time (the flag is set at run time).
bool aliasRebindFlag = false;
bool aliasRebindTaken() { return aliasRebindFlag; }

/*
 * A '?:' joining an OWNING-VALUE STRUCT (a `unique` field, so a full field-deleting destructor is
 * synthesized) runs the same strict all-arms-owning rule the interface fat pointer does. A MIXED
 * join - one arm a move-returning call, the other a live borrowed parameter - used to be adopted
 * by the receiving local, whose scope-exit destructor deleted the BORROW arm's pointee while its
 * real owner deleted it again (abort). The join now owns nothing: the local borrows it (the
 * untaken owning arm leaks, the accepted trade), and every destination that cannot carry the
 * suppression - an existing owning local, a struct field, a return slot - rejects it outright
 * (Test/errors/err_move.cb). An ALL-OWNING join still adopts and frees exactly once.
 */
int testOwningStructTernaryJoin()
{
    int passed = 0;

    // MIXED join, BORROW arm taken: nothing is freed early and the owner survives intact.
    dtorCount = 0;
    {
        UniqueBox owner = makeUniqueBox(42);
        {
            UniqueBox k = identityBool(false) ? makeUniqueBox(7) : owner;
            passed += Test("struct_ternary_mixed_false_value", k.item->id, 42);
            passed += Test("struct_ternary_mixed_false_no_free", dtorCount, 0);
        }
        passed += Test("struct_ternary_mixed_false_no_adoption", dtorCount, 0);
        passed += Test("struct_ternary_mixed_false_owner_alive", owner.item->id, 42);
    }
    passed += Test("struct_ternary_mixed_false_owner_freed_once", dtorCount, 1);

    // MIXED join, OWNING arm taken: the receiver still only borrows, so the owner is untouched
    // and the selected arm leaks. The point is that nothing is freed TWICE.
    dtorCount = 0;
    {
        UniqueBox owner = makeUniqueBox(42);
        {
            UniqueBox k = identityBool(true) ? makeUniqueBox(7) : owner;
            passed += Test("struct_ternary_mixed_true_value", k.item->id, 7);
            passed += Test("struct_ternary_mixed_true_no_free", dtorCount, 0);
        }
        passed += Test("struct_ternary_mixed_true_no_adoption", dtorCount, 0);
        passed += Test("struct_ternary_mixed_true_owner_alive", owner.item->id, 42);
    }
    passed += Test("struct_ternary_mixed_true_owner_freed_once", dtorCount, 1);

    // ALL-BORROW join: neither arm owns, so the receiver borrows and the owner frees exactly once.
    dtorCount = 0;
    {
        UniqueBox owner = makeUniqueBox(9);
        {
            UniqueBox k = identityBool(false) ? owner : owner;
            passed += Test("struct_ternary_all_borrow_value", k.item->id, 9);
        }
        passed += Test("struct_ternary_all_borrow_no_adoption", dtorCount, 0);
        passed += Test("struct_ternary_all_borrow_owner_alive", owner.item->id, 9);
    }
    passed += Test("struct_ternary_all_borrow_owner_freed_once", dtorCount, 1);

    // ALL-OWNING join, false arm: adopted, and freed exactly once at scope exit.
    dtorCount = 0;
    {
        UniqueBox k = identityBool(false) ? makeUniqueBox(1) : makeUniqueBox(2);
        passed += Test("struct_ternary_all_owning_false_value", k.item->id, 2);
        passed += Test("struct_ternary_all_owning_false_alive", dtorCount, 0);
    }
    passed += Test("struct_ternary_all_owning_false_freed_once", dtorCount, 1);

    // ALL-OWNING join, true arm: only the taken arm is constructed, and it is freed once.
    dtorCount = 0;
    {
        UniqueBox k = identityBool(true) ? makeUniqueBox(1) : makeUniqueBox(2);
        passed += Test("struct_ternary_all_owning_true_value", k.item->id, 1);
        passed += Test("struct_ternary_all_owning_true_alive", dtorCount, 0);
    }
    passed += Test("struct_ternary_all_owning_true_freed_once", dtorCount, 1);

    // ALL-OWNING join into an EXISTING owning local: the old value is released, the join adopted,
    // and the whole sequence accounts for exactly two frees.
    dtorCount = 0;
    {
        UniqueBox k = makeUniqueBox(5);
        k = identityBool(true) ? makeUniqueBox(6) : makeUniqueBox(7);
        passed += Test("struct_ternary_all_owning_assign_value", k.item->id, 6);
        passed += Test("struct_ternary_all_owning_assign_old_freed", dtorCount, 1);
    }
    passed += Test("struct_ternary_all_owning_assign_total", dtorCount, 2);

    // ALL-MOVE join: an explicit `move` of an owning struct local detaches it (the source is
    // zeroed), so BOTH arms provably own and the join is adopted, not suppressed. The receiver
    // frees the taken arm at its scope exit; the untaken arm's own local still frees its value.
    dtorCount = 0;
    {
        UniqueBox p = makeUniqueBox(1);
        UniqueBox q = makeUniqueBox(2);
        {
            UniqueBox k = identityBool(true) ? move p : move q;
            passed += Test("struct_ternary_move_join_value", k.item->id, 1);
            passed += Test("struct_ternary_move_join_alive", dtorCount, 0);
        }
        passed += Test("struct_ternary_move_join_adopted_freed_once", dtorCount, 1);
    }
    passed += Test("struct_ternary_move_join_total", dtorCount, 2);

    // An `alias`-returning call is a BORROW, so pairing it with a genuinely owning arm is a MIXED
    // join. It used to score owning (every by-value owning-struct return entered the owning-return
    // ledger regardless of `alias`) and the receiver destroyed the wrapper's live value.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = identityBool(true) ? w.borrow() : makeUniqueBox(2);
            passed += Test("struct_ternary_alias_arm_value", k.item->id, 5);
            passed += Test("struct_ternary_alias_arm_no_free", dtorCount, 0);
        }
        passed += Test("struct_ternary_alias_arm_no_adoption", dtorCount, 0);
        passed += Test("struct_ternary_alias_arm_owner_alive", w.b.item->id, 5);
    }
    passed += Test("struct_ternary_alias_arm_owner_freed_once", dtorCount, 1);

    // The `alias` RETURN slot accepts the mixed join (the reject is gated on a non-alias return),
    // and its result borrows in the caller too - the owner is still freed exactly once.
    dtorCount = 0;
    {
        UniqueBox owner = makeUniqueBox(4);
        {
            UniqueBox k = pickBorrowedBox(owner, false);
            passed += Test("struct_ternary_alias_return_value", k.item->id, 4);
        }
        passed += Test("struct_ternary_alias_return_no_adoption", dtorCount, 0);
    }
    passed += Test("struct_ternary_alias_return_owner_freed_once", dtorCount, 1);

    /*
     * ACCEPT SET for the borrow-laundering rejects (Test/errors/err_move.cb `aliasBorrow*` legs).
     * A borrow local may be declared, chained into another DECLARATION, read, passed by value, and
     * handed on through an `alias` return - none of those hands a second destroyer to the owner's
     * storage. Each leg asserts the VALUE and the resource (dtorCount inside and after the scope).
     */
    // Chained borrow DECLARATION off an `alias`-return local: k2 propagates the borrow, adopts
    // nothing, and the wrapper still frees its value exactly once.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            UniqueBox k2 = k;
            passed += Test("alias_borrow_chain_decl_value", k2.item->id, 5);
            passed += Test("alias_borrow_chain_decl_no_free", dtorCount, 0);
        }
        passed += Test("alias_borrow_chain_decl_no_adoption", dtorCount, 0);
        passed += Test("alias_borrow_chain_decl_owner_alive", w.b.item->id, 5);
    }
    passed += Test("alias_borrow_chain_decl_owner_freed_once", dtorCount, 1);

    // Same chain off a MIXED-join local (the second way to become a borrow).
    dtorCount = 0;
    {
        UniqueBox owner = makeUniqueBox(6);
        {
            UniqueBox k = identityBool(false) ? makeUniqueBox(9) : owner;
            UniqueBox k2 = k;
            passed += Test("alias_borrow_join_chain_value", k2.item->id, 6);
            passed += Test("alias_borrow_join_chain_no_free", dtorCount, 0);
        }
        passed += Test("alias_borrow_join_chain_no_adoption", dtorCount, 0);
        passed += Test("alias_borrow_join_chain_owner_alive", owner.item->id, 6);
    }
    passed += Test("alias_borrow_join_chain_owner_freed_once", dtorCount, 1);

    // Read-only uses: a field read and a plain by-value argument. Neither persists the borrow.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(8);
        {
            UniqueBox k = w.borrow();
            passed += Test("alias_borrow_field_read", k.item->id, 8);
            passed += Test("alias_borrow_byvalue_arg", readBoxId(k), 8);
        }
        passed += Test("alias_borrow_read_no_adoption", dtorCount, 0);
    }
    passed += Test("alias_borrow_read_owner_freed_once", dtorCount, 1);

    // Handing the borrow onward through an `alias` return - the sanctioned escape hatch.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(3);
        {
            UniqueBox k = handBorrow(&w);
            passed += Test("alias_borrow_passthrough_value", k.item->id, 3);
            passed += Test("alias_borrow_passthrough_no_free", dtorCount, 0);
        }
        passed += Test("alias_borrow_passthrough_no_adoption", dtorCount, 0);
    }
    passed += Test("alias_borrow_passthrough_owner_freed_once", dtorCount, 1);

    // The guards sit in front of the owning-value MOVE and `move`-argument paths, so the plain
    // OWNER spellings they share a site with must still transfer: `dest = ownedLocal` releases the
    // old destination and consumes the source, and `move ownedLocal` into a sink transfers once.
    dtorCount = 0;
    {
        UniqueBox a = makeUniqueBox(11);
        UniqueBox b = makeUniqueBox(12);
        b = a;
        passed += Test("alias_guard_owning_assign_value", b.item->id, 11);
        passed += Test("alias_guard_owning_assign_old_freed", dtorCount, 1);
    }
    passed += Test("alias_guard_owning_assign_total", dtorCount, 2);

    dtorCount = 0;
    {
        UniqueBox a = makeUniqueBox(13);
        sinkUniqueBox(move a);
        passed += Test("alias_guard_owning_move_freed_once", dtorCount, 1);
    }
    passed += Test("alias_guard_owning_move_total", dtorCount, 1);

    /*
     * RE-BINDING the borrow local itself (`Box k = w.get(); k = makeBox(2);`). The owning-local
     * reassignment path drop-olds unconditionally, and the old destination here is a BORROW of the
     * wrapper's value - so the wrapper's object was destroyed under it (read back as garbage, then
     * a second free at teardown: abort). The drop-old is now skipped, and the borrow RETIRES so the
     * local really owns what it was just given. Every leg asserts the value, the resource inside
     * the scope, the resource after it, and that the WRAPPER's object survived intact.
     */
    // The filed spelling: a fresh owner from a call.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            k = makeUniqueBox(2);
            passed += Test("alias_rebind_call_value", k.item->id, 2);
            passed += Test("alias_rebind_call_no_drop_old", dtorCount, 0);
            passed += Test("alias_rebind_call_owner_alive", w.b.item->id, 5);
        }
        // The re-bound local OWNS its new value now, so its scope-exit destructor must run.
        passed += Test("alias_rebind_call_new_freed_at_exit", dtorCount, 1);
        passed += Test("alias_rebind_call_owner_still_alive", w.b.item->id, 5);
    }
    passed += Test("alias_rebind_call_total", dtorCount, 2);

    // Same rebind from an owning LOCAL (the consume arm) and from `move` of one.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            UniqueBox s = makeUniqueBox(3);
            k = s;
            passed += Test("alias_rebind_local_value", k.item->id, 3);
            passed += Test("alias_rebind_local_no_drop_old", dtorCount, 0);
            passed += Test("alias_rebind_local_owner_alive", w.b.item->id, 5);
        }
        passed += Test("alias_rebind_local_new_freed_at_exit", dtorCount, 1);
    }
    passed += Test("alias_rebind_local_total", dtorCount, 2);

    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            UniqueBox s = makeUniqueBox(4);
            k = move s;
            passed += Test("alias_rebind_move_value", k.item->id, 4);
            passed += Test("alias_rebind_move_no_drop_old", dtorCount, 0);
            passed += Test("alias_rebind_move_owner_alive", w.b.item->id, 5);
        }
        passed += Test("alias_rebind_move_new_freed_at_exit", dtorCount, 1);
    }
    passed += Test("alias_rebind_move_total", dtorCount, 2);

    // The movable-temp-FIELD arm (`k = makeBoxHolder(2).b`) is its own store path with its own
    // drop-old, so it needs its own leg or one spelling re-opens the hole.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            k = makeBoxHolder(6).b;
            passed += Test("alias_rebind_tempfield_value", k.item->id, 6);
            passed += Test("alias_rebind_tempfield_no_drop_old", dtorCount, 0);
            passed += Test("alias_rebind_tempfield_owner_alive", w.b.item->id, 5);
        }
        passed += Test("alias_rebind_tempfield_new_freed_at_exit", dtorCount, 1);
    }
    passed += Test("alias_rebind_tempfield_total", dtorCount, 2);

    // Re-binding TWICE: the FIRST rebind retires the borrow, so the SECOND is an ordinary owning
    // reassignment and its drop-old must come back (otherwise the middle value leaks).
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            k = makeUniqueBox(2);
            k = makeUniqueBox(3);
            passed += Test("alias_rebind_twice_value", k.item->id, 3);
            passed += Test("alias_rebind_twice_middle_dropped", dtorCount, 1);
            passed += Test("alias_rebind_twice_owner_alive", w.b.item->id, 5);
        }
        passed += Test("alias_rebind_twice_last_freed_at_exit", dtorCount, 2);
    }
    passed += Test("alias_rebind_twice_total", dtorCount, 3);

    /*
     * A CONDITIONAL rebind is deliberately NOT retired: the store does not run on every path to
     * scope exit, so retiring it would destroy the wrapper's value on the path that did not rebind.
     * The drop-old is still suppressed, so the not-taken path stays exactly correct and the taken
     * path LEAKS the new value instead of double-freeing it - the safe direction of the trade.
     */
    dtorCount = 0;
    aliasRebindFlag = false;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            if (aliasRebindTaken()) { k = makeUniqueBox(2); }
            passed += Test("alias_rebind_cond_untaken_value", k.item->id, 5);
            passed += Test("alias_rebind_cond_untaken_no_drop_old", dtorCount, 0);
        }
        passed += Test("alias_rebind_cond_untaken_no_adoption", dtorCount, 0);
        passed += Test("alias_rebind_cond_untaken_owner_alive", w.b.item->id, 5);
    }
    passed += Test("alias_rebind_cond_untaken_owner_freed_once", dtorCount, 1);

    dtorCount = 0;
    aliasRebindFlag = true;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            if (aliasRebindTaken()) { k = makeUniqueBox(2); }
            passed += Test("alias_rebind_cond_taken_value", k.item->id, 2);
            passed += Test("alias_rebind_cond_taken_no_drop_old", dtorCount, 0);
        }
        // The new value leaks (accepted trade); the WRAPPER's object is still freed exactly once.
        passed += Test("alias_rebind_cond_taken_no_adoption", dtorCount, 0);
        passed += Test("alias_rebind_cond_taken_owner_alive", w.b.item->id, 5);
    }
    passed += Test("alias_rebind_cond_taken_owner_freed_once", dtorCount, 1);
    aliasRebindFlag = false;

    // INTERACTION with the `move`-of-a-borrow's-field reject: after a rebind the local OWNS, so
    // `move k.item` is legal again and transfers exactly once. This is the accept side of
    // Test/errors/err_move.cb's `aliasBorrowFieldMove` leg.
    dtorCount = 0;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = w.borrow();
            k = makeUniqueBox(7);
            sinkBoxItem(move k.item);
            passed += Test("alias_rebind_then_move_field_sunk_once", dtorCount, 1);
            passed += Test("alias_rebind_then_move_field_owner_alive", w.b.item->id, 5);
        }
        passed += Test("alias_rebind_then_move_field_no_second_free", dtorCount, 1);
    }
    passed += Test("alias_rebind_then_move_field_total", dtorCount, 2);

    // ACCEPT SET for the `move`-of-a-borrow's-field reject: the same `move` off a local that OWNS
    // its value transfers, exactly as before.
    dtorCount = 0;
    {
        UniqueBox owned = makeUniqueBox(9);
        sinkBoxItem(move owned.item);
        passed += Test("alias_field_move_owning_local_sunk_once", dtorCount, 1);
    }
    passed += Test("alias_field_move_owning_local_total", dtorCount, 1);

    /*
     * The MIXED '?:' join is the SECOND declaration site that marks a local a borrow, so the rebind
     * fix has to reach it too. On the BORROW arm master ran the drop-old over the wrapper's value
     * (garbage read, then abort at teardown); the drop-old is now skipped and the borrow retires in
     * the declaration block, so the local frees exactly the value it was just handed.
     */
    dtorCount = 0;
    aliasRebindFlag = false;
    {
        BoxWrap w;
        w.b = makeUniqueBox(5);
        {
            UniqueBox k = aliasRebindTaken() ? makeUniqueBox(1) : w.borrow();
            k = makeUniqueBox(9);
            passed += Test("alias_join_rebind_value", k.item->id, 9);
            passed += Test("alias_join_rebind_no_drop_old", dtorCount, 0);
            passed += Test("alias_join_rebind_owner_alive", w.b.item->id, 5);
        }
        passed += Test("alias_join_rebind_new_freed_at_exit", dtorCount, 1);
    }
    passed += Test("alias_join_rebind_total", dtorCount, 2);

    return passed;
}

/*
 * `unique <interface>` move as a plain-readable null (bf26a15, design record
 * internal/plan/unique-interface-move-readable-null.md): explicit `move` of an interface local
 * zeroes both fat-pointer slots and leaves the source LEGAL TO READ (comparisons, reassignment,
 * pass-along) - only a DEREFERENCE is rejected (Test/errors/err_move.cb's `ui` leg). These legs
 * pin the runtime behaviour of the readable-null contract itself, mirroring the thin-pointer
 * `explicit_move_local_*` and `cross_block_*` legs in testUniqueField above.
 */
int testUniqueInterfaceMoveExtra()
{
    int passed = 0;

    // Readable-after-move basics: source compares null both ways, dest dispatches, one free.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        passed += Test("iface_move_source_eq_null", a == nullptr ? 1 : 0, 1);
        passed += Test("iface_move_source_neq_null", a != nullptr ? 1 : 0, 0);
        passed += Test("iface_move_dest_dispatches", b.area(), 0);
        passed += Test("iface_move_no_early_free", dtorCount, 0);
    }
    passed += Test("iface_move_freed_once", dtorCount, 1);

    // Move-of-moved: the second move's receiver is null too, no dtor effect, no crash.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        unique IShapeMove c = move a;
        passed += Test("iface_move_of_moved_dest_null", c == nullptr ? 1 : 0, 1);
        passed += Test("iface_move_of_moved_no_early_free", dtorCount, 0);
    }
    passed += Test("iface_move_of_moved_freed_once", dtorCount, 1);

    // Reassignment after move: the local is re-owned and dispatches; both boxes freed once each.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        a = new SqMove();
        passed += Test("iface_move_reassign_dispatches", a.area(), 0);
    }
    passed += Test("iface_move_reassign_freed_twice", dtorCount, 2);

    // Guarded cross-block deref, move NOT taken: guard passes, real dispatch value.
    dtorCount = 0;
    {
        unique IShapeMove ig = new SqMove();
        if (RuntimeFalse()) { unique IShapeMove ig2 = move ig; }
        int t = -1;
        if (ig != nullptr) { t = ig.area(); }
        passed += Test("iface_guard_not_taken_dispatches", t, 0);
    }
    passed += Test("iface_guard_not_taken_freed_once", dtorCount, 1);

    // Guarded cross-block deref, move TAKEN (a genuine runtime-true branch): guard fails, the
    // sentinel path runs, no crash - the moved-to inner local frees the box.
    dtorCount = 0;
    {
        unique IShapeMove ig = new SqMove();
        if (identityBool(true)) { unique IShapeMove ig2 = move ig; }
        int t = -1;
        if (ig != nullptr) { t = ig.area(); }
        passed += Test("iface_guard_taken_sentinel", t, -1);
    }
    passed += Test("iface_guard_taken_freed_once", dtorCount, 1);

    // Loop-carried move under a guard: the move only fires on the second iteration, and the
    // post-loop guarded deref sees the (by-then-moved) local and takes the sentinel path.
    dtorCount = 0;
    {
        unique IShapeMove ig = new SqMove();
        for (int i = 0; i < 2; i++)
        {
            if (ig != nullptr && identityBool(i == 1)) { unique IShapeMove ig2 = move ig; }
        }
        int t = -1;
        if (ig != nullptr) { t = ig.area(); }
        passed += Test("iface_loop_carried_guard_sentinel", t, -1);
    }
    passed += Test("iface_loop_carried_guard_freed_once", dtorCount, 1);

    // Pass-along of a moved (null) interface local: plain assignability to a non-unique
    // interface local stays legal (a read, not a dereference) and observes the null.
    dtorCount = 0;
    {
        unique IShapeMove a = new SqMove();
        unique IShapeMove b = move a;
        IShapeMove d = a;
        passed += Test("iface_move_assign_to_plain_is_null", d == nullptr ? 1 : 0, 1);
    }
    passed += Test("iface_move_assign_to_plain_freed_once", dtorCount, 1);

    // `?.` on a maybe-moved `unique <interface>` receiver: the deref sites skip the Deref
    // event under nullConditionalPending (the '?.' legitimately tolerates null), so this
    // must compile without the cross-block moved-deref diagnostic firing, and must dispatch
    // correctly on both the not-moved and moved (null) paths. CiMove.area() (r+7, r=0) is a
    // NONZERO real result, distinct from the '?.' short-circuit's zero default, so '?? -1'
    // unambiguously tells which path ran.
    dtorCount = 0;
    {
        unique IShapeMove ig = new CiMove();
        if (RuntimeFalse()) { unique IShapeMove ig2 = move ig; }
        int t = ig?.area() ?? -1;
        passed += Test("iface_nullcond_guard_not_taken_dispatches", t, 7);
    }
    passed += Test("iface_nullcond_guard_not_taken_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        unique IShapeMove ig = new CiMove();
        if (identityBool(true)) { unique IShapeMove ig2 = move ig; }
        int t = ig?.area() ?? -1;
        passed += Test("iface_nullcond_guard_taken_short_circuits", t, -1);
    }
    passed += Test("iface_nullcond_guard_taken_freed_once", dtorCount, 1);

    return passed;
}

/*
 * `_ = <call>();` on a `move T*`-returning function. The discarded thing is the RETURNED
 * POINTER, so the destructor must run against that pointer and the block must be freed. It
 * used to spill the pointer VALUE into a temp and destruct the pointer's own bits as if they
 * were the object: the real allocation leaked and the dtor body ran on a wild address.
 */
int discardDtorCount = 0;
int discardSeenValue = 0;

struct DiscardProbe
{
    int v = 0;
    ~DiscardProbe()
    {
        discardDtorCount = discardDtorCount + 1;
        discardSeenValue = v;
    }
};

move DiscardProbe* makeDiscardProbe()
{
    DiscardProbe* p = new DiscardProbe();
    p->v = 7;
    return p;
}

int discardOwnerDtorCount = 0;
int discardOwnerNameOk = 0;

// Owning-member variant: the generated teardown frees `name`. If the dtor ran against a wild
// address this would free an arbitrary pointer instead of this object's buffer.
struct DiscardOwner
{
    string name = default;
    int tag = 0;
    ~DiscardOwner()
    {
        discardOwnerDtorCount = discardOwnerDtorCount + 1;
        if (name == "payload" && tag == 9)
            discardOwnerNameOk = 1;
    }
};

move DiscardOwner* makeDiscardOwner()
{
    DiscardOwner* p = new DiscardOwner();
    p->name = "pay" + "load";
    p->tag = 9;
    return p;
}

// A generic slot whose owning-ness comes purely from SUBSTITUTION (IsUniqueTypeArg, never a
// written `unique`). Both the pointer and the fat-interface instantiations are exercised below.
struct MoveBox<T> { T t = default; };
// The WRITTEN `unique <interface>` field spelling, for the implicit-move legs.
struct WrittenIfaceMoveHolder { unique IShapeMove s = default; };

// area() returns a NON-default value, so a dispatch leg through a generic unique-interface slot
// asserts a distinguishing number rather than the type default.
class Sq7Move : IShapeMove
{
    int s = 7;
    int area() { return s * s; }
    ~Sq7Move() { dtorCount = dtorCount + 1; }
};

// The WRITTEN `unique <interface>` field spelling, for the brace-init leg below.
struct WrittenIfaceSlot { unique IShapeMove s = default; };

MoveBox<unique Resource*> makeMoveBox()
{
    MoveBox<unique Resource*> b = default;
    b.t = new Resource();
    b.t->id = 44;
    return b;
}

// An array of `unique`-owning holders: the receiver shape whose CallerName is the CONTAINER
// ("arr") on BOTH sides of a field-to-field copy, so the self-assign discriminator used to read
// two different elements as one slot. See Test/errors/err_unique_array_element_field_to_field.cb.
struct ElemHolder { unique Resource* slot = nullptr; };
struct ElemOuter { ElemHolder[2] arr = default; };
// A COPYABLE owning value with a counting destructor: the element-to-element store copies it
// rather than being rejected, so the reassignment-destruct of the OLD value is observable.
int elemBufDtor = 0;
struct ElemBuf
{
    string b = default;
    ElemBuf copy() { ElemBuf r = default; r.b = b.copy(); return r; }
    ~ElemBuf() { elemBufDtor = elemBufDtor + 1; }
};
struct ElemBufHolder { ElemBuf f = default; };

// GLOBAL (file-scope) struct receivers of the same field store. A global resolves through
// globalNamedVariable, which carries no CallerName, so BOTH sides of `gA.slot = gB.slot`
// reported caller "" and field "slot" and the whole guard stack was suppressed as a self-assign.
struct GlobHolder { unique Resource* slot = nullptr; };
GlobHolder gGH = default;
// Two more file-scope receivers, for the implicit-move legs between two DIFFERENT globals.
GlobHolder gGH2 = default;
GlobHolder gGH3 = default;
struct GlobOuter { GlobHolder inner = default; };
GlobOuter gGO = default;
namespace GlobNS { GlobHolder gN = default; }
struct GlobBufHolder { ElemBuf f = default; };
GlobBufHolder gGB1 = default;
GlobBufHolder gGB2 = default;
struct GlobStrHolder { string s = default; };
GlobStrHolder gGS1 = default;
GlobStrHolder gGS2 = default;

/*
 * GLOBAL struct receivers of a `unique` / owning field store. Two DIFFERENT globals are two
 * owners and must be rejected (pinned in Test/errors/err_unique_array_element_field_to_field.cb);
 * a global assigned from ITSELF is one owner and must keep compiling with its exact free count.
 * The owning-VALUE legs discriminate the store-side half of the guard, which EMITS the
 * reassignment-destruct: before the fix a global-to-global copy of an owning value silently
 * aliased (zero destructs) and aborted at teardown, where the local spelling destructs once.
 */
/*
 * `move` of a BORROWED pointer parameter into a PLAIN `T*` destination. The move transfers
 * nothing - it nulls only this frame's copy while the caller still owns the pointee - so a plain
 * destination, which asserts no ownership at all, must NOT adopt. It stays the borrow it was and
 * frees nothing; the caller's single free is the only one. Every helper below aborted the process
 * on a double free before this change, so the free counts are what these legs are really pinning.
 */
int bpmBareParam(Resource* p) { Resource* d = move p; return d->id; }
int bpmOneHopCopy(Resource* p) { Resource* b = p; Resource* d = move b; return d->id; }
int bpmTwoHopCopy(Resource* p) { Resource* b = p; Resource* b2 = b; Resource* d = move b2; return d->id; }
void bpmDropped(Resource* p) { Resource* d = move p; }
void bpmGenericDropped<T>(T* p) { T* d = move p; }
int bpmPrimitivePtr(int* p) { int* d = move p; return d[0]; }
Resource* bpmGlobalOwner = nullptr;
void bpmDroppedNoDelete(Resource* p) { Resource* d = move p; }

// The borrow proof RETIRES on rebinding: the binding is then the SOLE owner of the fresh object it
// holds, so the move really does transfer and the destination must adopt. Rejecting these leaks.
int bpmCopyRebound(Resource* p)
{
    Resource* b = p;
    b = new Resource();
    b->id = 91;
    Resource* d = move b;
    int v = d->id;
    delete d;
    return v;
}

int bpmParamRebound(Resource* p)
{
    p = new Resource();
    p->id = 92;
    Resource* d = move p;
    int v = d->id;
    delete d;
    return v;
}

/*
 * Owning-struct assignment from an INDIRECT source - a deref (`*ap`), a field (`w.b`), or an
 * ELEMENT (`arr[i]`). `=` and decl-init defer to T exactly as they already do for a named local
 * source: a non-copyable owner MOVES (the source lvalue is zeroed, so exactly one owner frees), a
 * copyable owner COPIES (the source stays live), a POD bit-copies. Before the fix every
 * indirect-source leg below bit-copied without consuming the source and double-freed at teardown
 * (compile 0, run SIGABRT). Only a NAMED slot source is marked moved-from; an indirect lvalue is
 * consumed silently, exactly as `move w.b` already was.
 */
struct OaiBox
{
    unique Resource* item = nullptr;
};

OaiBox oaiMake(int id)
{
    OaiBox b;
    b.item = new Resource();
    b.item->id = id;
    return b;
}

struct OaiWrap  { OaiBox b; };
struct OaiInner { OaiBox b; };
struct OaiOuter { OaiInner inner; };
struct OaiArrWrap { OaiBox[2] arr; };
struct OaiNest  { OaiBox inner; };

struct OaiBox2
{
    unique Resource* a = nullptr;
    unique Resource* b = nullptr;
};

struct OaiBox2Wrap { OaiBox2 b; };

// Copyable owner: a hand-written copy() makes `=` from any source a COPY, not a move.
struct OaiCopyBox
{
    unique Resource* item = nullptr;
    OaiCopyBox copy()
    {
        OaiCopyBox r;
        r.item = new Resource();
        r.item->id = (item == nullptr) ? -1 : item->id;
        return r;
    }
};

struct OaiCopyWrap { OaiCopyBox b; };

// POD - no owned resource, so every source shape stays a plain bit copy.
struct OaiPod    { int x = 0; };
struct OaiPodWrap { OaiPod p; };

// Owning but not unique: a string field (the axis a pointer-only dtor count cannot see).
struct OaiSBox   { string s = ""; };
struct OaiSWrap  { OaiSBox b; };

OaiBox oaiGlobal;

// The FIELD-DEFAULT brace path (EmitFieldDefaultFixedArrayBrace -> the same slot emitter as the
// local declarator). Its source has to outlive the struct declaration, so it is a global.
OaiBox oaiFdSeed;
struct OaiFdWrap { OaiBox[2] arr = { oaiFdSeed }; };

int oaiId(OaiBox b)
{
    if (b.item == nullptr) return -1;
    return b.item->id;
}

int testOwningAssignFromIndirectSource()
{
    int passed = 0;

    // 1. Deref source, reassign over a live destination (filed repro (a)).
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox* ap = &a;
        OaiBox o = oaiMake(1);
        o = *ap;
        passed += Test("oai_deref_value", oaiId(o), 5);
        passed += Test("oai_deref_old_dest_freed", dtorCount, 1);
        passed += Test("oai_deref_source_nulled", ap->item == nullptr, true);
    }
    passed += Test("oai_deref_freed_once_each", dtorCount, 2);

    // 2. Field source, reassign (filed repro (b)).
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(5);
        OaiBox o = oaiMake(1);
        o = w.b;
        passed += Test("oai_field_value", oaiId(o), 5);
        passed += Test("oai_field_old_dest_freed", dtorCount, 1);
        passed += Test("oai_field_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("oai_field_freed_once_each", dtorCount, 2);

    // 3. Nested field source.
    dtorCount = 0;
    {
        OaiOuter ot;
        ot.inner.b = oaiMake(5);
        OaiBox o = oaiMake(1);
        o = ot.inner.b;
        passed += Test("oai_nestfield_value", oaiId(o), 5);
        passed += Test("oai_nestfield_source_nulled", ot.inner.b.item == nullptr, true);
    }
    passed += Test("oai_nestfield_freed_once_each", dtorCount, 2);

    // 4. Fixed-array element source (filed repro (c)).
    dtorCount = 0;
    {
        OaiBox[2] arr;
        arr[0] = oaiMake(5);
        OaiBox o = oaiMake(1);
        o = arr[0];
        passed += Test("oai_elem_value", oaiId(o), 5);
        passed += Test("oai_elem_old_dest_freed", dtorCount, 1);
        passed += Test("oai_elem_source_nulled", arr[0].item == nullptr, true);
    }
    passed += Test("oai_elem_freed_once_each", dtorCount, 2);

    // 5. Array-VIEW element source (the view spelling of the same slot).
    dtorCount = 0;
    {
        OaiBox[2] arr;
        arr[0] = oaiMake(5);
        OaiBox[] v = arr;
        OaiBox o = oaiMake(1);
        o = v[0];
        passed += Test("oai_view_value", oaiId(o), 5);
        passed += Test("oai_view_source_nulled", arr[0].item == nullptr, true);
    }
    passed += Test("oai_view_freed_once_each", dtorCount, 2);

    // 6. Deref-then-field (`wp->b`) and element-of-field / field-of-element.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(5);
        OaiWrap* wp = &w;
        OaiBox o = oaiMake(1);
        o = wp->b;
        passed += Test("oai_arrowfield_value", oaiId(o), 5);
        passed += Test("oai_arrowfield_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("oai_arrowfield_freed_once_each", dtorCount, 2);

    dtorCount = 0;
    {
        OaiArrWrap wa;
        wa.arr[0] = oaiMake(5);
        OaiBox o = oaiMake(1);
        o = wa.arr[0];
        passed += Test("oai_elemoffield_value", oaiId(o), 5);
        passed += Test("oai_elemoffield_source_nulled", wa.arr[0].item == nullptr, true);
    }
    passed += Test("oai_elemoffield_freed_once_each", dtorCount, 2);

    dtorCount = 0;
    {
        OaiWrap[2] wa;
        wa[0].b = oaiMake(5);
        OaiBox o = oaiMake(1);
        o = wa[0].b;
        passed += Test("oai_fieldofelem_value", oaiId(o), 5);
        passed += Test("oai_fieldofelem_source_nulled", wa[0].b.item == nullptr, true);
    }
    passed += Test("oai_fieldofelem_freed_once_each", dtorCount, 2);

    // 7. GLOBAL source. GetGlobalVariableNV carries no CallerName, so the named-slot leg never
    // saw a file-scope global - it took the indirect leg and now transfers like every other slot.
    dtorCount = 0;
    {
        oaiGlobal = oaiMake(5);
        OaiBox o = oaiMake(1);
        o = oaiGlobal;
        passed += Test("oai_global_value", oaiId(o), 5);
        passed += Test("oai_global_source_nulled", oaiGlobal.item == nullptr, true);
    }
    passed += Test("oai_global_freed_once_each", dtorCount, 2);

    // 8. DECL-INIT is a separate hand-mirrored path - same three source shapes.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(5);
        OaiBox o = w.b;
        passed += Test("oai_declinit_field_value", oaiId(o), 5);
        passed += Test("oai_declinit_field_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("oai_declinit_field_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox* ap = &a;
        OaiBox o = *ap;
        passed += Test("oai_declinit_deref_value", oaiId(o), 5);
        passed += Test("oai_declinit_deref_source_nulled", ap->item == nullptr, true);
    }
    passed += Test("oai_declinit_deref_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox[2] arr;
        arr[0] = oaiMake(5);
        OaiBox o = arr[0];
        passed += Test("oai_declinit_elem_value", oaiId(o), 5);
        passed += Test("oai_declinit_elem_source_nulled", arr[0].item == nullptr, true);
    }
    passed += Test("oai_declinit_elem_freed_once", dtorCount, 1);

    // 9. Multiple unique fields, and an owning struct nested inside an owning struct.
    dtorCount = 0;
    {
        OaiBox2Wrap w;
        w.b.a = new Resource();
        w.b.a->id = 5;
        w.b.b = new Resource();
        w.b.b->id = 6;
        OaiBox2 o;
        o = w.b;
        passed += Test("oai_multiunique_first", o.a->id, 5);
        passed += Test("oai_multiunique_second", o.b->id, 6);
        passed += Test("oai_multiunique_src_first_nulled", w.b.a == nullptr, true);
        passed += Test("oai_multiunique_src_second_nulled", w.b.b == nullptr, true);
    }
    passed += Test("oai_multiunique_freed_once_each", dtorCount, 2);

    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(5);
        OaiNest n;
        n.inner = oaiMake(1);
        OaiNest o;
        o = n;
        passed += Test("oai_nestowner_value", oaiId(o.inner), 1);
        passed += Test("oai_nestowner_freed_none_yet", dtorCount, 0);
        OaiBox inner2 = o.inner;
        passed += Test("oai_nestowner_innerfield_value", oaiId(inner2), 1);
        passed += Test("oai_nestowner_innerfield_nulled", o.inner.item == nullptr, true);
    }
    passed += Test("oai_nestowner_freed_once_each", dtorCount, 2);

    // 10. COPYABLE owner: every source shape COPIES and leaves the source live and independent.
    dtorCount = 0;
    {
        OaiCopyWrap w;
        w.b.item = new Resource();
        w.b.item->id = 5;
        OaiCopyBox o;
        o.item = new Resource();
        o.item->id = 1;
        o = w.b;
        passed += Test("oai_copyable_field_value", o.item->id, 5);
        passed += Test("oai_copyable_field_old_dest_freed", dtorCount, 1);
        passed += Test("oai_copyable_field_source_live", w.b.item->id, 5);
        passed += Test("oai_copyable_field_independent", o.item != w.b.item, true);
    }
    passed += Test("oai_copyable_field_freed_once_each", dtorCount, 3);

    dtorCount = 0;
    {
        OaiCopyBox[2] arr;
        arr[0].item = new Resource();
        arr[0].item->id = 5;
        OaiCopyBox o = arr[0];
        passed += Test("oai_copyable_declinit_elem_value", o.item->id, 5);
        passed += Test("oai_copyable_declinit_elem_source_live", arr[0].item->id, 5);
        passed += Test("oai_copyable_declinit_elem_independent", o.item != arr[0].item, true);
    }
    passed += Test("oai_copyable_declinit_elem_freed_once_each", dtorCount, 2);

    // 11. ACCEPT SET, unchanged by the fix: an explicit `.copy()` off an indirect source is still
    // one copy (never a copy of a copy), and `move w.b` still transfers.
    dtorCount = 0;
    {
        OaiCopyWrap w;
        w.b.item = new Resource();
        w.b.item->id = 5;
        OaiCopyBox o;
        o = w.b.copy();
        passed += Test("oai_explicit_copy_value", o.item->id, 5);
        passed += Test("oai_explicit_copy_source_live", w.b.item->id, 5);
    }
    passed += Test("oai_explicit_copy_freed_once_each", dtorCount, 2);

    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(5);
        OaiBox o = oaiMake(1);
        o = move w.b;
        passed += Test("oai_explicit_move_value", oaiId(o), 5);
        passed += Test("oai_explicit_move_old_dest_freed", dtorCount, 1);
        passed += Test("oai_explicit_move_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("oai_explicit_move_freed_once_each", dtorCount, 2);

    // 12. ACCEPT SET: a POD source owns nothing, so every shape stays a plain bit copy that
    // leaves the source readable and unmodified.
    {
        OaiPodWrap pw;
        pw.p.x = 5;
        OaiPod o;
        o = pw.p;
        passed += Test("oai_pod_field_value", o.x, 5);
        passed += Test("oai_pod_field_source_intact", pw.p.x, 5);

        OaiPod[2] arr;
        arr[0].x = 9;
        OaiPod o2 = arr[0];
        passed += Test("oai_pod_elem_value", o2.x, 9);
        passed += Test("oai_pod_elem_source_intact", arr[0].x, 9);

        OaiPod src;
        src.x = 7;
        OaiPod* sp = &src;
        OaiPod o3;
        o3 = *sp;
        passed += Test("oai_pod_deref_value", o3.x, 7);
        passed += Test("oai_pod_deref_source_intact", sp->x, 7);
    }

    // 13. Owning-but-not-unique: a struct whose only owned resource is a HEAP string. A dtor
    // counter cannot see this axis - the assertion is that BOTH sides still read their value
    // (a bit-copy alias would leave the source dangling once the destination frees the buffer).
    {
        OaiSWrap w;
        string seed = "ab";
        w.b.s = seed + "cd";
        OaiSBox o;
        o = w.b;
        passed += Test("oai_stringowner_field_value", o.s, "abcd");
        passed += Test("oai_stringowner_field_source_live", w.b.s, "abcd");

        OaiSBox a2;
        a2.s = seed + "ef";
        OaiSBox* ap2 = &a2;
        OaiSBox o2 = *ap2;
        passed += Test("oai_stringowner_declinit_deref_value", o2.s, "abef");
        passed += Test("oai_stringowner_declinit_deref_source_live", ap2->s, "abef");
    }

    return passed;
}

/*
 * The DESTINATION-side twin of the block above: storing an owning struct into a FIXED-ARRAY
 * ELEMENT. A subscript of a fixed array is a two-index GEP over `[N x T]`, so it matched none of
 * the owning-store arms and fell to a plain bit store - the old element was never destructed
 * (leak) and the source was never consumed (double free at teardown, run rc 133 for every source
 * shape, including a plain named local). A fixed array's slots are LIVE default-constructed
 * values, so drop-old applies here - the opposite of a container's single-index slot, which
 * writes only into slots it has already released. The transfer itself defers to T exactly as the
 * whole-local store does: a copyable owner COPIES, a non-copyable owner MOVES.
 * Every leg pins the dtor COUNT as well as the value: the value alone is already correct on the
 * broken binary, so only the counts falsify the ownership change.
 */
struct AelsArrWrap  { OaiBox[2] arr; };
OaiBox[2] gAelsArr;

int aelsIndex(int n) { return n; }

// A by-value `string` parameter stored into an element: the CALLER still owns the buffer, so the
// element must take an independent copy (returns 1 when the element reads back correctly).
int aelsStrElemParam(string p)
{
    string[2] dst;
    dst[0] = p;
    return dst[0] == "abcd" ? 1 : 0;
}

// The brace-list twin of the helper above - the source's owner is another frame.
int abriStrElemParam(string p)
{
    string[2] dst = { p };
    return dst[0] == "abcd" ? 1 : 0;
}

// Read-side fixtures (legs 18-19). Once the store side made the element a real owner, every
// READ of one had to hand out an independent buffer instead of the {ptr,len,owned} pair.
string[2] gAelsStrArr;
struct AelsStrArrWrap { string[2] arr = default; };
using AelsStrAlias = string;

// The RETURN position - the only one with a wrong-VALUE symptom: the frame destroys the array
// on the way out, so the caller read freed bytes back (r=0) as well as double-freeing (rc 133).
string aelsStrElemReturn()
{
    string[2] dst;
    dst[0] = "ab" + "cd";
    return dst[0];
}

/*
 * The `T[]` VIEW spelling of the two fixed-array element blocks below. A view subscript is a
 * SINGLE-index GEP over the element type - the same shape a container's internal `T*` buffer slot
 * has - so it landed in Part 6's container-slot arm, which deliberately does NOT drop the old
 * element (a container releases a slot before writing it) and reaches no consume arm at all for an
 * INDIRECT source. A view's slots are LIVE, so the store orphaned the old element (leak, rc 0) for
 * a named source and aliased the source's owning bits (double free, rc 133) for an indirect one;
 * the READ handed a second owner the element's own {ptr,len,owned} pair (rc 133). The GEP cannot
 * separate the two, so the discriminator is NamedVariable::IsViewElement - the base binding was a
 * user-visible `T[]`. A container's raw `T*` buffer never carries it, which is what keeps the
 * list `sort`/`_partition` bit-shuffles and the dictionary rehash on their existing borrow path.
 */
OaiBox[]  aveViewOfGlobal = default;
string[2] gAveStrArr;

// A `T[]` PARAMETER views the CALLER's storage: those slots are live in another frame.
void aveStoreThroughParam(OaiBox[] v, OaiBox src) { v[0] = src; }
int aveReadThroughParam(string[] v) { string q = v[0]; return q == "abcd" ? 1 : 0; }
string aveReturnThroughParam(string[] v) { return v[0]; }

// A raw `string*` PARAMETER is the same non-owning heap array seen from the callee frame: its
// destructive `delete` is rejected there too, so its slot must borrow just like the caller's.
void rhStoreThroughParam(string* h, string s) { h[0] = s; }
string gRhStr = default;

int testOwningAssignIntoArrayViewElement()
{
    int passed = 0;

    // 1. NAMED source through a view over a FIXED array (the filed repro). The old element was
    // never destructed: dtorCount stayed 1 for two allocations, and `leaks` saw 16 orphaned bytes.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] base;
        base[0] = oaiMake(1);
        OaiBox[] v = base;
        v[0] = a;
        passed += Test("avel_named_value", v[0].item->id, 5);
        // A named source is MarkVariableMoved, so its use-after-move is pinned in
        // Test/errors/err_move.cb rather than read back here.
        passed += Test("avel_named_old_elem_freed", dtorCount, 1);
    }
    passed += Test("avel_named_freed_once_each", dtorCount, 2);

    // 2. INDIRECT (field) source - the double-free half: no consume arm ran, so the element and
    // the field both owned the same Res and both freed it (rc 133).
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(3);
        OaiBox[2] base;
        base[0] = oaiMake(1);
        OaiBox[] v = base;
        v[0] = w.b;
        passed += Test("avel_field_value", v[0].item->id, 3);
        passed += Test("avel_field_source_nulled", w.b.item == nullptr, true);
        passed += Test("avel_field_old_elem_freed", dtorCount, 1);
    }
    passed += Test("avel_field_freed_once_each", dtorCount, 2);

    // 3. A view over `new T[n]` storage, and a CALL-RESULT source (the leak-only shape - it never
    // aborted, so only the count falsifies it).
    dtorCount = 0;
    {
        OaiBox[] v = new OaiBox[2];
        v[0] = oaiMake(1);
        v[0] = oaiMake(7);
        passed += Test("avel_heapview_call_value", v[0].item->id, 7);
        passed += Test("avel_heapview_call_old_elem_freed", dtorCount, 1);
        v[0] = oaiMake(8);
        passed += Test("avel_heapview_call_freed_again", dtorCount, 2);
    }

    // 4. ELEMENT-to-ELEMENT and the SELF-assign. `v[0] = v[0]` cannot be ruled out at compile time
    // for a runtime index; the zero-source-then-drop-old order makes it degenerate safely.
    dtorCount = 0;
    {
        OaiBox[2] base;
        base[0] = oaiMake(1);
        base[1] = oaiMake(2);
        OaiBox[] v = base;
        v[0] = v[1];
        passed += Test("avel_elem_elem_value", v[0].item->id, 2);
        passed += Test("avel_elem_elem_src_nulled", v[1].item == nullptr, true);
        passed += Test("avel_elem_elem_old_freed", dtorCount, 1);
    }
    passed += Test("avel_elem_elem_freed_once_each", dtorCount, 2);

    dtorCount = 0;
    {
        OaiBox[2] base;
        base[0] = oaiMake(1);
        OaiBox[] v = base;
        v[0] = v[0];
        passed += Test("avel_self_value_survives", v[0].item->id, 1);
        passed += Test("avel_self_no_free", dtorCount, 0);
    }
    passed += Test("avel_self_freed_once", dtorCount, 1);

    // 5. A view PARAMETER (the callee's window on the caller's live storage) and a VIEW OF A VIEW.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] base;
        base[0] = oaiMake(1);
        aveStoreThroughParam(base, a);
        passed += Test("avel_param_value", base[0].item->id, 5);
        passed += Test("avel_param_old_elem_freed", dtorCount, 1);
    }
    passed += Test("avel_param_freed_once_each", dtorCount, 2);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] base;
        base[0] = oaiMake(1);
        OaiBox[] v = base;
        OaiBox[] v2 = v;
        v2[0] = a;
        passed += Test("avel_viewofview_value", v2[0].item->id, 5);
        passed += Test("avel_viewofview_old_elem_freed", dtorCount, 1);
    }
    passed += Test("avel_viewofview_freed_once_each", dtorCount, 2);

    // 6. A GLOBAL view bound to a fixed array - a global is never torn down, so the count inside
    // the block is the only thing that can see the dropped old element.
    dtorCount = 0;
    {
        OaiBox[2] base;
        base[0] = oaiMake(1);
        aveViewOfGlobal = base;
        aveViewOfGlobal[0] = oaiMake(6);
        passed += Test("avel_globalview_value", aveViewOfGlobal[0].item->id, 6);
        passed += Test("avel_globalview_old_elem_freed", dtorCount, 1);
    }

    // 7. THE FLIP, in the view spelling: a COPYABLE owner COPIES (source stays live, two
    // independent resources), and the old element is still dropped.
    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource();
        a.item->id = 5;
        OaiCopyBox[2] base;
        base[0].item = new Resource();
        base[0].item->id = 1;
        OaiCopyBox[] v = base;
        v[0] = a;
        passed += Test("avel_copyable_value", v[0].item->id, 5);
        passed += Test("avel_copyable_source_live", a.item->id, 5);
        passed += Test("avel_copyable_independent", v[0].item != a.item, true);
        passed += Test("avel_copyable_old_elem_freed", dtorCount, 1);
    }

    // 8. ACCEPT SET: a POD element owns nothing, so it stays a plain bit copy through the view,
    // and the view still writes THROUGH to the array it borrows.
    {
        OaiPod p;
        p.x = 9;
        OaiPod[2] base;
        base[0].x = 1;
        OaiPod[] v = base;
        v[0] = p;
        passed += Test("avel_pod_value", v[0].x, 9);
        passed += Test("avel_pod_source_live", p.x, 9);
        passed += Test("avel_pod_writes_through", base[0].x, 9);

        int[2] ibase;
        ibase[0] = 1;
        int[] iv = ibase;
        iv[0] = 9;
        passed += Test("avel_int_writes_through", ibase[0], 9);
    }

    // 9. A NESTED owning element (the owned resource sits one struct down).
    dtorCount = 0;
    {
        OaiNest a;
        a.inner = oaiMake(5);
        OaiNest[2] base;
        base[0].inner = oaiMake(1);
        OaiNest[] v = base;
        v[0] = a;
        passed += Test("avel_nested_value", v[0].inner.item->id, 5);
        passed += Test("avel_nested_old_elem_freed", dtorCount, 1);
    }
    passed += Test("avel_nested_freed_once_each", dtorCount, 2);

    // 10. A bare `string` element STORE through a view. Part 6's slot arm already deep-copied a
    // named source, so every leg below reads back correctly on the PRE-fix binary too - they are
    // coverage, not discriminators. What the slot arm never did was drop the OLD element, and a
    // `string` has no destructor count, so the only oracle for that half is `leaks --atExit`:
    // this store shape went 1 leak / 16 bytes -> 0 leaks / 0 bytes.
    {
        string a = "ab" + "cd";
        string[2] base;
        base[0] = "xy" + "zw";
        string[] v = base;
        v[0] = a;
        passed += Test("avel_str_value", v[0], "abcd");
        passed += Test("avel_str_source_live", a, "abcd");
        passed += Test("avel_str_independent", v[0].data() != a.data(), true);
        passed += Test("avel_str_writes_through", base[0], "abcd");

        // A temp source (no Storage) hands its buffer over directly; the old element still drops.
        v[1] = "ef" + "gh";
        v[1] = "ij" + "kl";
        passed += Test("avel_str_temp_value", v[1], "ijkl");
    }

    // 11. The READ side (the second filed issue). Both view provenances abort on the pre-fix
    // binary; the distinctness leg is what falsifies the aliasing, since the value already read
    // back correctly while both owners still pointed at one buffer.
    {
        string[2] base;
        base[0] = "ab" + "cd";
        string[] v = base;
        string q = v[0];
        passed += Test("avelr_decl_value", q, "abcd");
        passed += Test("avelr_decl_independent", q.data() != v[0].data(), true);
        passed += Test("avelr_decl_source_live", base[0], "abcd");

        string[] hv = new string[2];
        hv[0] = "ef" + "gh";
        string hq = hv[0];
        passed += Test("avelr_heapview_value", hq, "efgh");
        passed += Test("avelr_heapview_independent", hq.data() != hv[0].data(), true);

        // The brace-initialized view spelling from the filed repro.
        string bs = "mn" + "op";
        string[] bv = { bs, "q" };
        string bq = bv[0];
        passed += Test("avelr_braceview_value", bq, "mnop");
        passed += Test("avelr_braceview_independent", bq.data() != bv[0].data(), true);
    }

    // 12. The other read POSITIONS: assignment into an existing local, a read inside a `T[]`
    // callee, and `return` of a view element.
    {
        string[2] base;
        base[0] = "ab" + "cd";
        string[] v = base;
        string q = "seed";
        q = v[0];
        passed += Test("avelr_assign_value", q, "abcd");
        passed += Test("avelr_assign_independent", q.data() != v[0].data(), true);
        passed += Test("avelr_assign_source_live", base[0], "abcd");

        passed += Test("avelr_param_read", aveReadThroughParam(base), 1);
        passed += Test("avelr_return_value", aveReturnThroughParam(base), "abcd");
        passed += Test("avelr_return_source_live", base[0], "abcd");

        gAveStrArr[0] = "ef" + "gh";
        string[] gv = gAveStrArr;
        string gq = gv[0];
        passed += Test("avelr_globalview_value", gq, "efgh");
        passed += Test("avelr_globalview_independent", gq.data() != gv[0].data(), true);
    }

    // 13. Reading an OWNING STRUCT element out of a view. The fixed-array oracle already MOVED
    // (source nulled, freed once); the view spelling aliased and freed twice (rc 133).
    dtorCount = 0;
    {
        OaiBox[2] base;
        base[0] = oaiMake(1);
        OaiBox[] v = base;
        OaiBox q = v[0];
        passed += Test("avelr_owning_value", q.item->id, 1);
        passed += Test("avelr_owning_source_nulled", v[0].item == nullptr, true);
        passed += Test("avelr_owning_no_early_free", dtorCount, 0);
    }
    passed += Test("avelr_owning_freed_once", dtorCount, 1);

    // 14. ACCEPT SET for the read arm, and the LOAD-BEARING INVARIANT next to it. A raw heap
    // `string*` is not a view - `new string[n]` does not take ownership of assigned strings, so
    // its element read must stay a borrow - and a container's internal slot must keep sharing the
    // buffer through `get`, which is the contract list `sort`/`_partition` and the dictionary
    // rehash bit-shuffles depend on. Both are byte-identical before and after the fix.
    {
        string* h = new string[2];
        h[0] = "lit";
        string rq = h[0];
        passed += Test("avelr_rawheap_value", rq, "lit");
        passed += Test("avelr_rawheap_still_borrows", rq.data() == h[0].data(), true);

        list<string> ls = default;
        ls.add("aa" + "bb");
        string lq = ls.get(0);
        passed += Test("avelr_list_get_value", lq, "aabb");
        passed += Test("avelr_list_get_still_borrows", lq.data() == ls.get(0).data(), true);
    }

    /*
     * 15. The raw `new string[n]` array is a BORROW container in BOTH directions - the completion
     * of the accept legs above. The STORE of an lvalue source writes a borrowed {ptr,len} (it used
     * to deep-copy, making the slot an owner nothing ever frees), and the READ clears the owned bit
     * a slot may still carry from an owned-temp store. All three blocks are rc 133 on the merge base:
     * the local and the raw array both freed one buffer.
     */
    {
        string a = "ab" + "cd";
        string* h = new string[2];
        h[0] = a;                       // borrow: `a` stays the single owner
        string q = h[0];
        passed += Test("rhstr_named_value", q, "abcd");
        // The discriminator for the STORE half: the merge base deep-copied here, so the slot held
        // a SECOND owning buffer (`false`) that only the array's element-0 teardown ever freed.
        passed += Test("rhstr_named_slot_borrows_source", h[0].data() == a.data(), true);
        passed += Test("rhstr_named_source_live", a, "abcd");
    }
    {
        // The filed repro: an OWNED TEMP still hands its buffer to the slot, and the READ borrows
        // it, so the array's own teardown frees it exactly once. These three VALUES already read
        // back correctly on the merge base while both owners pointed at one buffer - surviving
        // teardown is the discriminator, and this block is rc 133 without the read-side clear.
        string* h = new string[2];
        h[0] = "ef" + "gh";
        string q = h[0];
        passed += Test("rhstr_temp_value", q, "efgh");
        passed += Test("rhstr_temp_borrows", q.data() == h[0].data(), true);
        string r = "seed";
        r = h[0];                       // the ASSIGN read position, same clearing
        passed += Test("rhstr_temp_assign_value", r, "efgh");
    }
    {
        // A file-scope GLOBAL source carries no CallerName, so it reaches the store arm by its
        // storage shape alone (the merge base left the global's OWNED bit in the slot and aborted
        // at teardown - survival is this leg's discriminator).
        gRhStr = "ij" + "kl";
        string* h = new string[2];
        h[0] = gRhStr;
        string q = h[0];
        passed += Test("rhstr_global_value", q, "ijkl");
        passed += Test("rhstr_global_source_live", gRhStr, "ijkl");

        string p = "mn" + "op";
        rhStoreThroughParam(h, p);
        string pq = h[0];
        // A `string*` PARAM is NOT tagged (the decay happens in the caller's frame), so its store
        // keeps the merge base's deep copy; the caller's READ of the tagged local is what stops the
        // double free here, and surviving teardown is this pair's only discriminator.
        passed += Test("rhstr_param_value", pq, "mnop");
        passed += Test("rhstr_param_source_live", p, "mnop");
        // No `delete[_]`: the param's deep copy landed in element 0, which the local's own
        // scope-exit teardown destructs - see the filed `string*`-parameter ambiguity.
    }
    {
        // ACCEPT SET for the borrow arms, which admit only a POSITIVE `new string[n]` provenance
        // (`AllocatedByRawNewArray`). A decayed FIXED array, a `?:` join and a re-assignment away
        // from the allocation are all UNTAGGED, so they keep the merge base's deep copy - those
        // slots are LIVE owning storage and a borrow there reads freed bytes once `a` dies.
        string[4] arr = default;
        string* p = arr;
        string* q = p;
        {
            string a = "ab" + "cd";
            q[0] = a;
        }
        passed += Test("rhstr_decayed_fixed_array_still_copies", arr[0] == "abcd", true);

        string[4] arr2 = default;
        string* heap2 = new string[4];
        string* j = arr2[0].length() == 0 ? arr2 : heap2;
        {
            string b = "ef" + "gh";
            j[0] = b;
        }
        passed += Test("rhstr_join_base_still_copies", arr2[0] == "efgh", true);

        string[4] arr3 = default;
        string* heap3 = new string[4];
        string* r = heap3;              // tagged by propagation ...
        r = arr3;                       // ... and the re-assignment CLEARS it again
        {
            string c2 = "ij" + "kl";
            r[0] = c2;
        }
        passed += Test("rhstr_reassigned_base_still_copies", arr3[0] == "ijkl", true);
        delete[_] heap3;
    }

    return passed;
}

int testOwningAssignIntoFixedArrayElement()
{
    int passed = 0;

    // 1. NAMED source into a LIVE element (filed repro (a)): drop the old element, move the source.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        dst[0] = a;
        passed += Test("aels_named_value", dst[0].item->id, 5);
        passed += Test("aels_named_old_elem_freed", dtorCount, 1);
    }
    passed += Test("aels_named_freed_once_each", dtorCount, 2);

    // 2. INDIRECT (field) source: same transfer, and the consumed source lvalue is left null.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(5);
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        dst[0] = w.b;
        passed += Test("aels_field_value", dst[0].item->id, 5);
        passed += Test("aels_field_old_elem_freed", dtorCount, 1);
        passed += Test("aels_field_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("aels_field_freed_once_each", dtorCount, 2);

    // 3. DEREF source.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox* ap = &a;
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        dst[0] = *ap;
        passed += Test("aels_deref_value", dst[0].item->id, 5);
        passed += Test("aels_deref_old_elem_freed", dtorCount, 1);
        passed += Test("aels_deref_source_nulled", ap->item == nullptr, true);
    }
    passed += Test("aels_deref_freed_once_each", dtorCount, 2);

    // 4. CALL-RESULT source. This one never aborted - it LEAKED the old element instead, so the
    // drop-old count is the only thing that falsifies it.
    dtorCount = 0;
    {
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        dst[0] = oaiMake(5);
        passed += Test("aels_call_value", dst[0].item->id, 5);
        passed += Test("aels_call_old_elem_freed", dtorCount, 1);
    }
    passed += Test("aels_call_freed_once_each", dtorCount, 2);

    // 5. Explicit `move` source: the move machinery already nulled the source, but the old
    // element was still orphaned.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        dst[0] = move a;
        passed += Test("aels_move_value", dst[0].item->id, 5);
        passed += Test("aels_move_old_elem_freed", dtorCount, 1);
    }
    passed += Test("aels_move_freed_once_each", dtorCount, 2);

    // 6. The array is a struct FIELD - reached on the stack and through the heap.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        AelsArrWrap w;
        w.arr[0] = oaiMake(1);
        w.arr[0] = a;
        passed += Test("aels_arrfield_value", w.arr[0].item->id, 5);
        passed += Test("aels_arrfield_old_elem_freed", dtorCount, 1);
    }
    passed += Test("aels_arrfield_freed_once_each", dtorCount, 2);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        AelsArrWrap* wp = new AelsArrWrap();
        wp->arr[0] = oaiMake(1);
        wp->arr[0] = a;
        passed += Test("aels_heaparrfield_value", wp->arr[0].item->id, 5);
        passed += Test("aels_heaparrfield_old_elem_freed", dtorCount, 1);
        delete wp;
    }
    passed += Test("aels_heaparrfield_freed_once_each", dtorCount, 2);

    // 7. A file-scope GLOBAL fixed array. Globals are never torn down, so only the drop-old
    // count is observable here.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        gAelsArr[0] = oaiMake(1);
        gAelsArr[0] = a;
        passed += Test("aels_global_value", gAelsArr[0].item->id, 5);
        passed += Test("aels_global_old_elem_freed", dtorCount, 1);
    }

    // 8. ELEMENT-to-ELEMENT within one array, distinct indices - a genuine transfer.
    dtorCount = 0;
    {
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        dst[1] = oaiMake(2);
        dst[0] = dst[1];
        passed += Test("aels_crossindex_value", dst[0].item->id, 2);
        passed += Test("aels_crossindex_old_elem_freed", dtorCount, 1);
        passed += Test("aels_crossindex_source_nulled", dst[1].item == nullptr, true);
    }
    passed += Test("aels_crossindex_freed_once_each", dtorCount, 2);

    // 9. SELF-assign, constant and RUNTIME index. No compile-time proof can rule the runtime one
    // out, so the arm zeroes the source BEFORE destructing the destination: when the two
    // addresses coincide the destructor sees a zeroed slot, frees nothing, and the store puts the
    // value straight back. Both spellings must keep the value and free nothing.
    dtorCount = 0;
    {
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        dst[0] = dst[0];
        passed += Test("aels_selfassign_const_value", dst[0].item->id, 1);
        passed += Test("aels_selfassign_const_freed_nothing", dtorCount, 0);
    }
    passed += Test("aels_selfassign_const_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        int i = aelsIndex(0);
        dst[i] = dst[i];
        passed += Test("aels_selfassign_runtime_value", dst[i].item->id, 1);
        passed += Test("aels_selfassign_runtime_freed_nothing", dtorCount, 0);
    }
    passed += Test("aels_selfassign_runtime_freed_once", dtorCount, 1);

    // 10. Old-element STATES. A never-assigned slot and a moved-from slot are both null, so the
    // drop-old must be a no-op on them rather than a second free.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst;
        dst[0] = a;
        passed += Test("aels_freshold_value", dst[0].item->id, 5);
        passed += Test("aels_freshold_freed_nothing", dtorCount, 0);
    }
    passed += Test("aels_freshold_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst;
        dst[0] = oaiMake(1);
        OaiBox t = move dst[0];
        dst[0] = a;
        passed += Test("aels_movedold_value", dst[0].item->id, 5);
        passed += Test("aels_movedold_freed_nothing", dtorCount, 0);
    }
    passed += Test("aels_movedold_freed_twice", dtorCount, 2);

    // 11. A MULTI-unique-field element: both of the old element's resources are dropped.
    dtorCount = 0;
    {
        OaiBox2 a;
        a.a = new Resource(); a.a->id = 5;
        a.b = new Resource(); a.b->id = 6;
        OaiBox2[2] dst;
        dst[0].a = new Resource();
        dst[0].b = new Resource();
        dst[0] = a;
        passed += Test("aels_multiuniq_value", dst[0].a->id, 5);
        passed += Test("aels_multiuniq_old_elem_freed_both", dtorCount, 2);
    }
    passed += Test("aels_multiuniq_freed_once_each", dtorCount, 4);

    // 12. A NESTED owning element (the owned resource sits one struct down).
    dtorCount = 0;
    {
        OaiNest a;
        a.inner = oaiMake(5);
        OaiNest[2] dst;
        dst[0].inner = oaiMake(1);
        dst[0] = a;
        passed += Test("aels_nested_value", dst[0].inner.item->id, 5);
        passed += Test("aels_nested_old_elem_freed", dtorCount, 1);
    }
    passed += Test("aels_nested_freed_once_each", dtorCount, 2);

    // 13. A COPYABLE owner copies - the source stays live and both are freed at teardown.
    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource(); a.item->id = 5;
        OaiCopyBox[2] dst;
        dst[0].item = new Resource();
        dst[0] = a;
        passed += Test("aels_copyable_value", dst[0].item->id, 5);
        passed += Test("aels_copyable_old_elem_freed", dtorCount, 1);
        passed += Test("aels_copyable_source_live", a.item->id, 5);
        passed += Test("aels_copyable_independent", dst[0].item != a.item, true);
    }
    passed += Test("aels_copyable_freed_once_each", dtorCount, 3);

    // 14. An owning struct whose resource is a STRING (the axis a pointer dtor count cannot see).
    // A bare `string` ELEMENT carries a runtime owned bit, so it takes its own arm - legs 16-17.
    {
        string aelsSeed = "ab";
        OaiSBox a;
        a.s = aelsSeed + "cd";
        OaiSBox[2] dst;
        dst[0].s = aelsSeed + "ef";
        dst[0] = a;
        passed += Test("aels_stringowner_value", dst[0].s, "abcd");
        passed += Test("aels_stringowner_source_live", a.s, "abcd");
    }

    // 15. ACCEPT SET: a POD element owns nothing, so it stays a plain bit copy with a live source.
    {
        OaiPod a;
        a.x = 5;
        OaiPod[2] dst;
        dst[0].x = 1;
        dst[0] = a;
        passed += Test("aels_pod_value", dst[0].x, 5);
        passed += Test("aels_pod_source_live", a.x, 5);
    }

    // 16. A BARE `string` element. It is neither a struct field nor a local, so both dedicated
    // string arms skipped it: every store below aborted at teardown (rc 133) before the fix,
    // and the overwrite legs additionally orphaned the old buffer (16 bytes under `leaks`).
    {
        string aelsT = "ab" + "cd";
        string[2] dst;
        dst[0] = aelsT;
        passed += Test("aels_strelem_value", dst[0], "abcd");
        passed += Test("aels_strelem_source_live", aelsT, "abcd");
        passed += Test("aels_strelem_independent", dst[0].data() != aelsT.data(), true);
        // Old-element states: a borrowed (literal) slot must not be freed, an owned one must be.
        dst[1] = "lit";
        dst[1] = aelsT;
        passed += Test("aels_strelem_over_borrowed", dst[1], "abcd");
        dst[0] = "ne" + "w";
        passed += Test("aels_strelem_over_owned", dst[0], "new");
        // Copy-FIRST order: destructing the old element before copying would free the source.
        dst[0] = dst[0];
        passed += Test("aels_strelem_self_assign", dst[0], "new");
        dst[1] = dst[0];
        passed += Test("aels_strelem_cross_index", dst[1], "new");
        passed += Test("aels_strelem_cross_independent", dst[0].data() != dst[1].data(), true);
    }

    // 17. The same element store off sources whose owner is ANOTHER frame or another object:
    // a by-value parameter (the caller still owns the buffer) and an owning string FIELD.
    {
        string aelsP = "ab" + "cd";
        passed += Test("aels_strelem_param_value", aelsStrElemParam(aelsP), 1);
        passed += Test("aels_strelem_param_caller_live", aelsP, "abcd");
        OaiSBox src;
        src.s = "ef" + "gh";
        string[2] dst;
        dst[0] = src.s;
        passed += Test("aels_strelem_field_value", dst[0], "efgh");
        passed += Test("aels_strelem_field_source_live", src.s, "efgh");
        passed += Test("aels_strelem_field_independent", dst[0].data() != src.s.data(), true);
    }

    // 18. The READ side of the same element. Handing a local the element's own {ptr,len,owned}
    // pair made both of them owners, so both freed the buffer: rc 133 at teardown for every
    // spelling below except the GLOBAL one, which aliased silently (a global is never torn
    // down). Each leg pins the VALUE and the buffer DISTINCTNESS - the value alone already read
    // back correctly on the broken binary, so only the distinctness leg falsifies the aliasing.
    {
        string[2] dst;
        dst[0] = "ab" + "cd";
        string q = dst[0];
        passed += Test("aelsr_decl_value", q, "abcd");
        passed += Test("aelsr_decl_independent", q.data() != dst[0].data(), true);
        passed += Test("aelsr_decl_source_live", dst[0], "abcd");

        // A named-local source for the element store, and a RUNTIME index on the read.
        string aelsrT = "ef" + "gh";
        dst[1] = aelsrT;
        int i = aelsIndex(1);
        string qi = dst[i];
        passed += Test("aelsr_runtime_index_value", qi, "efgh");
        passed += Test("aelsr_runtime_index_independent", qi.data() != dst[i].data(), true);
    }

    // The `using` alias spelling. The arm is keyed on the `%string` named type, not on the
    // spelled TypeName, so the alias must route through it exactly as the bare spelling does.
    {
        AelsStrAlias[2] dst;
        dst[0] = "ab" + "cd";
        AelsStrAlias q = dst[0];
        passed += Test("aelsr_alias_value", q, "abcd");
        passed += Test("aelsr_alias_independent", q.data() != dst[0].data(), true);
    }

    // MULTI-DIM (`md[0][0]`) and a struct-FIELD array (`w.arr[0]`): both are still two-index GEPs
    // over an array type, so both reach the same arm. Only the multi-dim leg discriminates - a
    // field-array element read already carried a FieldName and took the field deep-copy arm, so
    // its two legs pin behaviour that was already correct rather than falsifying the aliasing.
    {
        string[2][2] md;
        md[0][0] = "ab" + "cd";
        string q = md[0][0];
        passed += Test("aelsr_multidim_value", q, "abcd");
        passed += Test("aelsr_multidim_independent", q.data() != md[0][0].data(), true);

        AelsStrArrWrap w;
        w.arr[0] = "ef" + "gh";
        string f = w.arr[0];
        passed += Test("aelsr_arrfield_value", f, "efgh");
        passed += Test("aelsr_arrfield_independent", f.data() != w.arr[0].data(), true);
    }

    // A file-scope GLOBAL fixed array: this spelling never aborted, it aliased silently, so the
    // distinctness leg is the only thing that can falsify it.
    {
        gAelsStrArr[0] = "ab" + "cd";
        string q = gAelsStrArr[0];
        passed += Test("aelsr_global_value", q, "abcd");
        passed += Test("aelsr_global_independent", q.data() != gAelsStrArr[0].data(), true);
    }

    // 19. The other two read POSITIONS: assignment into an EXISTING local, and `return`.
    {
        string[2] dst;
        dst[0] = "ab" + "cd";
        string q = "seed";
        q = dst[0];
        passed += Test("aelsr_assign_value", q, "abcd");
        passed += Test("aelsr_assign_independent", q.data() != dst[0].data(), true);
        passed += Test("aelsr_assign_source_live", dst[0], "abcd");

        // Round-trip: read the element out, then store the local back into it. The LOCAL's value
        // did not survive that store while the read still aliased - it read back empty.
        string r = dst[0];
        dst[0] = r;
        passed += Test("aelsr_roundtrip_local", r, "abcd");
        passed += Test("aelsr_roundtrip_elem", dst[0], "abcd");
    }

    passed += Test("aelsr_return_value", aelsStrElemReturn(), "abcd");

    // ACCEPT SET for the read arm: an explicit `move` out of an element, an explicit `.copy()`,
    // and a BORROWED (literal) element all already worked and must keep working.
    {
        string[2] dst;
        dst[0] = "ab" + "cd";
        string m = move dst[0];
        passed += Test("aelsr_move_value", m, "abcd");
        dst[1] = "ef" + "gh";
        string c = dst[1].copy();
        passed += Test("aelsr_copy_value", c, "efgh");
        passed += Test("aelsr_copy_independent", c.data() != dst[1].data(), true);
        string[2] lit;
        lit[0] = "lit";
        string lq = lit[0];
        passed += Test("aelsr_literal_value", lq, "lit");
    }

    return passed;
}

/*
 * The DECL-INIT twin of the arm above: a positional brace list, `OaiBox[2] dst = { a, b };`.
 * Every owning lvalue source below bit-copied into the slot and aborted (rc 133) before the fix.
 * The slot is CONSTRUCTED here (the emitter zero-fills the array first), so there is no old
 * element to drop - the freed-once-each counts are what discriminate a transfer from an alias.
 */
int testOwningBraceInitFixedArray()
{
    int passed = 0;

    // 1. NAMED sources (the filed repro). A named source is MarkVariableMoved, so its
    // use-after-move is pinned in Test/errors/err_move.cb rather than read back here.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox b = oaiMake(6);
        OaiBox[2] dst = { a, b };
        passed += Test("abri_named_value0", dst[0].item->id, 5);
        passed += Test("abri_named_value1", dst[1].item->id, 6);
        passed += Test("abri_named_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_named_freed_once_each", dtorCount, 2);

    // 2. INDIRECT (field) source: same transfer, consumed source lvalue left null.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(5);
        OaiBox[2] dst = { w.b };
        passed += Test("abri_field_value", dst[0].item->id, 5);
        passed += Test("abri_field_source_nulled", w.b.item == nullptr, true);
        passed += Test("abri_field_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_field_freed_once_each", dtorCount, 1);

    // 3. DEREF source.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox* ap = &a;
        OaiBox[2] dst = { *ap };
        passed += Test("abri_deref_value", dst[0].item->id, 5);
        passed += Test("abri_deref_source_nulled", ap->item == nullptr, true);
    }
    passed += Test("abri_deref_freed_once_each", dtorCount, 1);

    // 4. ELEMENT source out of another fixed array.
    dtorCount = 0;
    {
        OaiBox[2] src;
        src[0] = oaiMake(5);
        OaiBox[2] dst = { src[0] };
        passed += Test("abri_elem_value", dst[0].item->id, 5);
        passed += Test("abri_elem_source_nulled", src[0].item == nullptr, true);
    }
    passed += Test("abri_elem_freed_once_each", dtorCount, 1);

    // 5. ACCEPT SET, unchanged by the fix: a CALL-RESULT element is a temp that already owned
    // its resource, so it was never aliased and must not be copied or consumed.
    dtorCount = 0;
    {
        OaiBox[2] dst = { oaiMake(5), oaiMake(6) };
        passed += Test("abri_call_value0", dst[0].item->id, 5);
        passed += Test("abri_call_value1", dst[1].item->id, 6);
        passed += Test("abri_call_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_call_freed_once_each", dtorCount, 2);

    // 6. ACCEPT SET, unchanged: an explicit `move` element keeps its own lowering.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst = { move a };
        passed += Test("abri_move_value", dst[0].item->id, 5);
    }
    passed += Test("abri_move_freed_once_each", dtorCount, 1);

    // 7. MIXED list: a consumed lvalue beside an untouched temp.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst = { a, oaiMake(7) };
        passed += Test("abri_mixed_value0", dst[0].item->id, 5);
        passed += Test("abri_mixed_value1", dst[1].item->id, 7);
        passed += Test("abri_mixed_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_mixed_freed_once_each", dtorCount, 2);

    // 8. TWO unique fields in one element - both handles transfer, neither is double-freed.
    dtorCount = 0;
    {
        OaiBox2 a;
        a.a = new Resource(); a.a->id = 5;
        a.b = new Resource(); a.b->id = 6;
        OaiBox2[2] dst = { a };
        passed += Test("abri_two_value_a", dst[0].a->id, 5);
        passed += Test("abri_two_value_b", dst[0].b->id, 6);
        passed += Test("abri_two_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_two_freed_once_each", dtorCount, 2);

    // 9. NESTED owner (the owned resource is one level down).
    dtorCount = 0;
    {
        OaiNest a;
        a.inner = oaiMake(5);
        OaiNest[2] dst = { a };
        passed += Test("abri_nested_value", dst[0].inner.item->id, 5);
        passed += Test("abri_nested_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_nested_freed_once_each", dtorCount, 1);

    // 10. A COPYABLE owner COPIES: both sources stay live with their own buffers, so teardown
    // frees four distinct resources.
    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource(); a.item->id = 5;
        OaiCopyBox b;
        b.item = new Resource(); b.item->id = 6;
        OaiCopyBox[2] dst = { a, b };
        passed += Test("abri_copyable_value0", dst[0].item->id, 5);
        passed += Test("abri_copyable_value1", dst[1].item->id, 6);
        passed += Test("abri_copyable_source_live", a.item->id, 5);
        passed += Test("abri_copyable_independent0", dst[0].item != a.item, true);
        passed += Test("abri_copyable_independent1", dst[1].item != b.item, true);
        passed += Test("abri_copyable_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_copyable_freed_once_each", dtorCount, 4);

    // 11. An owning struct whose resource is a STRING. A bare `string` ELEMENT carries a runtime
    // owned bit, so it takes its own deep-copy leg - legs 11b.
    {
        string abriSeed = "ab";
        OaiSBox a;
        a.s = abriSeed + "cd";
        OaiSBox[2] dst = { a };
        passed += Test("abri_stringowner_value", dst[0].s, "abcd");
        passed += Test("abri_stringowner_source_live", a.s, "abcd");
    }

    // 12. ACCEPT SET: a POD element owns nothing, so it stays a plain bit copy, source live.
    {
        OaiPod a;
        a.x = 5;
        OaiPod[2] dst = { a };
        passed += Test("abri_pod_value", dst[0].x, 5);
        passed += Test("abri_pod_source_live", a.x, 5);
    }

    // 11b. A BARE `string` element of a positional brace list. Every lvalue source below aborted
    // at teardown (rc 133) before the fix, and the owned-TEMP source additionally read back the
    // wrong value - the temp was freed by the end-of-statement flush the slot never claimed it from.
    {
        string abriT = "ab" + "cd";
        string abriU = "ef" + "gh";
        string[2] dst = { abriT, abriU };
        passed += Test("abri_strelem_value0", dst[0], "abcd");
        passed += Test("abri_strelem_value1", dst[1], "efgh");
        passed += Test("abri_strelem_source_live", abriT, "abcd");
        passed += Test("abri_strelem_independent", dst[0].data() != abriT.data(), true);
    }
    {
        string abriB = "cd";
        string[2] dst = { "ab" + abriB };
        passed += Test("abri_strelem_temp_value", dst[0], "abcd");
        passed += Test("abri_strelem_temp_tail_empty", dst[1], "");
    }
    {
        string abriP = "ab" + "cd";
        passed += Test("abri_strelem_param_value", abriStrElemParam(abriP), 1);
        passed += Test("abri_strelem_param_caller_live", abriP, "abcd");
        OaiSBox src;
        src.s = "ef" + "gh";
        string[2] dst = { src.s };
        passed += Test("abri_strelem_field_value", dst[0], "efgh");
        passed += Test("abri_strelem_field_source_live", src.s, "efgh");
        passed += Test("abri_strelem_field_independent", dst[0].data() != src.s.data(), true);
    }

    // 13. PARTIAL list: the trailing slot keeps its zero-fill (the value-init splat is untouched).
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst = { a };
        passed += Test("abri_partial_value", dst[0].item->id, 5);
        passed += Test("abri_partial_tail_zeroed", dst[1].item == nullptr, true);
    }
    passed += Test("abri_partial_freed_once_each", dtorCount, 1);

    // 14. The BARE-BRACE spelling of the same declaration, which reaches the emitter by a
    // different route in the declarator (initDecl->LeftBrace(), not initializer->LeftBrace()).
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox[2] dst { a };
        passed += Test("abri_barebrace_value", dst[0].item->id, 5);
        passed += Test("abri_barebrace_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_barebrace_freed_once_each", dtorCount, 1);

    // 15. The FIELD-DEFAULT brace path, the emitter's second caller. The global source is
    // consumed by the default construction exactly as a local source is.
    dtorCount = 0;
    {
        oaiFdSeed = oaiMake(5);
        OaiFdWrap w = default;
        passed += Test("abri_fielddefault_value", w.arr[0].item->id, 5);
        passed += Test("abri_fielddefault_source_nulled", oaiFdSeed.item == nullptr, true);
        passed += Test("abri_fielddefault_no_early_free", dtorCount, 0);
    }
    passed += Test("abri_fielddefault_freed_once_each", dtorCount, 1);

    return passed;
}

/*
 * The CALLER half of the arm above. A by-value owning PARAMETER used as a positional brace
 * element is consumed by the callee, so the owning-sink inference must see the brace-list site
 * and make the parameter a sink - otherwise the caller keeps its argument live and both sides
 * free one resource (rc 134). Every leg below is measured against the `dst[0] = p;` spelling,
 * which was already a sink and is carried alongside as the oracle.
 */
int bpsBrace(OaiBox p)          { OaiBox[2] dst = { p }; return dst[0].item->id; }
int bpsBraceBare(OaiBox p)      { OaiBox[2] dst { p }; return dst[0].item->id; }
int bpsAssign(OaiBox p)         { OaiBox[2] dst; dst[0] = p; return dst[0].item->id; }
int bpsBraceCond(OaiBox p, int c)
{
    if (c != 0) { OaiBox[2] dst = { p }; return dst[0].item->id; }
    return -1;
}
int bpsGenericBrace<T>(T p)     { T[2] dst = { p }; return dst[0].item->id; }
// A COPYABLE owner stays a borrow: the structural sink flag is filtered by the concrete
// copyability gate, so the caller's source must still be live after the call.
int bpsCopyBrace(OaiCopyBox p)  { OaiCopyBox[2] dst = { p }; return dst[0].item->id; }
int bpsPodBrace(OaiPod p)       { OaiPod[2] dst = { p }; return dst[0].x; }
// A field reached through a BORROWED POINTER parameter: an indirect source, consumed silently,
// and the pointer parameter itself is not sink-eligible.
int bpsPtrFieldBrace(OaiWrap* wp) { OaiBox[2] dst = { wp->b }; return dst[0].item->id; }

int testBraceInitConsumesParameter()
{
    int passed = 0;

    // 1. The filed repro: the callee's element consumes the parameter, so the caller's
    // argument must be surrendered and freed exactly once, by the callee.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("bps_brace_value", bpsBrace(a), 5);
        passed += Test("bps_brace_freed_by_callee", dtorCount, 1);
    }
    passed += Test("bps_brace_freed_once_total", dtorCount, 1);

    // 2. The assignment ORACLE, same shape: the counts must match leg 1 exactly.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("bps_assign_value", bpsAssign(a), 5);
        passed += Test("bps_assign_freed_by_callee", dtorCount, 1);
    }
    passed += Test("bps_assign_freed_once_total", dtorCount, 1);

    // 3. The bare-brace spelling hangs its list off the declarator, a second syntactic site.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("bps_barebrace_value", bpsBraceBare(a), 5);
        passed += Test("bps_barebrace_freed_by_callee", dtorCount, 1);
    }
    passed += Test("bps_barebrace_freed_once_total", dtorCount, 1);

    // 4. A TEMP argument has no named source to null, and must still be freed once.
    dtorCount = 0;
    passed += Test("bps_temp_value", bpsBrace(oaiMake(7)), 7);
    passed += Test("bps_temp_freed_once", dtorCount, 1);

    // 5. CONDITIONAL consumption. The sink is unconditional (the scan descends into the
    // branch), so the not-taken path still frees in the callee - the oracle's behaviour.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("bps_cond_taken_value", bpsBraceCond(a, 1), 5);
        passed += Test("bps_cond_taken_freed_by_callee", dtorCount, 1);
    }
    passed += Test("bps_cond_taken_freed_once_total", dtorCount, 1);
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("bps_cond_skipped_value", bpsBraceCond(a, 0), -1);
        passed += Test("bps_cond_skipped_freed_by_callee", dtorCount, 1);
    }
    passed += Test("bps_cond_skipped_freed_once_total", dtorCount, 1);

    // 6. A GENERIC function's monomorphized parameter runs the same inference.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(9);
        passed += Test("bps_generic_value", bpsGenericBrace<OaiBox>(a), 9);
        passed += Test("bps_generic_freed_by_callee", dtorCount, 1);
    }
    passed += Test("bps_generic_freed_once_total", dtorCount, 1);

    // 7. ACCEPT SET: a copyable owner's element is a COPY, so the parameter stays a borrow
    // and the caller's source is still readable and freed on its own.
    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource();
        a.item->id = 11;
        passed += Test("bps_copyable_value", bpsCopyBrace(a), 11);
        passed += Test("bps_copyable_source_live", a.item->id, 11);
    }
    passed += Test("bps_copyable_freed_all", dtorCount, 2);

    // 8. ACCEPT SET: a POD parameter owns nothing, so it is never a sink.
    {
        OaiPod a;
        a.x = 4;
        passed += Test("bps_pod_value", bpsPodBrace(a), 4);
        passed += Test("bps_pod_source_live", a.x, 4);
    }

    // 9. ACCEPT SET: the element source is a FIELD reached through a POINTER parameter, not
    // the parameter itself. The field is consumed silently (indirect lvalue), the pointer
    // parameter is not sink-eligible, and the resource is still freed exactly once.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(3);
        passed += Test("bps_ptrfieldsrc_value", bpsPtrFieldBrace(&w), 3);
        passed += Test("bps_ptrfieldsrc_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("bps_ptrfieldsrc_freed_once", dtorCount, 1);

    return passed;
}

/*
 * ACCEPT SET for the borrowed-by-value-parameter FIELD consume guard. The reject side lives in
 * Test/errors/err_move_field_out_of_borrowed_struct_param.cb: consuming `w.b` where `w` is a
 * BORROWED by-value struct parameter used to null only the callee's bit copy and double-free at
 * the caller's teardown. Every leg below is in the same syntactic neighbourhood and must KEEP
 * compiling and running - they are what a guard with the wrong polarity would take out. The
 * discriminators are named per leg: the guard fires only when the store MOVES (a non-copyable
 * owner), the source is a FIELD PATH, and that path's ROOT is a non-'move' by-value parameter.
 */
// Non-'move' by-value param, COPYABLE field: classifies as Copy, so no consume, no reject.
int cbvCopyField(OaiCopyWrap w)  { OaiCopyBox o = w.b; return o.item->id; }
// Non-'move' by-value param, POD field: not an owning value type at all.
int cbvPodField(OaiPodWrap w)    { OaiPod o = w.p; return o.x; }
// Non-'move' by-value param, STRING field: string takes its own deep-copy arm, not the move arm.
int cbvStringField(OaiSWrap w)   { string t = w.b.s; return t.length(); }
// Non-'move' by-value param, owning field READ (never stored): a borrow, not a consume.
int cbvReadField(OaiWrap w)      { return w.b.item->id; }
// Non-'move' by-value param, NESTED owning field read: the reject twin is `OaiBox o = w.inner.b`.
int cbvReadNested(OaiOuter w)    { return w.inner.b.item->id; }
// 'move' param: the callee OWNS its copy, so consuming the field is the sanctioned transfer.
int cbvMoveParamField(move OaiWrap w) { OaiBox o = w.b; return o.item->id; }
// Field of a LOCAL struct - the root is not a parameter, so the consume stays legal.
int cbvLocalField()              { OaiWrap w; w.b = oaiMake(6); OaiBox o = w.b; return o.item->id; }
// Field through a BORROWED POINTER parameter: filed separately (p2, memory-safe today) and
// deliberately NOT covered by this guard, which keys on a by-VALUE struct parameter.
int cbvPtrParamField(OaiWrap* w) { OaiBox o = w.b; return o.item->id; }
// Whole by-value param consumed (no field path): the owning-sink inference's job, not this guard.
int cbvWholeParam(OaiBox p)      { OaiBox o = p; return o.item->id; }
/*
 * SHADOWING. An inner block declares a local with the parameter's name; the local owns its own
 * storage and none of the parameter's borrow contract, so consuming ITS field is legal. The
 * guard settles this against the RESOLVED binding (storage identity) rather than the name -
 * a name-only test answers "parameter" here and false-rejects both spellings below. The
 * discriminator is that the caller's own resource must survive the call: dtorCount is 2 after
 * the block, one for the inner local's and one for the caller's, and the return value is the
 * INNER 4, proving the shadowing local (not the parameter) is what was read.
 *
 * BASELINES these legs discriminate against (measured, they are not vacuous):
 *  - cbvShadowedMove is a hard error on 6c2302c, the commit BEFORE this guard existed: the
 *    name-only defect was already live in the explicit 'move' path and is repaired here.
 *  - cbvShadowedLocal / cbvShadowedInLoop compile on 6c2302c but are hard errors on c324b09,
 *    this fix's own first round, which extended the name-only test to the implicit stores.
 */
int cbvShadowedLocal(OaiWrap w)  { { OaiWrap w; w.b = oaiMake(4); OaiBox o = w.b; return o.item->id; } }
int cbvShadowedMove(OaiWrap w)   { { OaiWrap w; w.b = oaiMake(4); OaiBox o = move w.b; return o.item->id; } }
int cbvShadowedInLoop(OaiWrap w)
{
    int s = 0;
    for (int i = 0; i < 1; i = i + 1) { OaiWrap w; w.b = oaiMake(4); OaiBox o = w.b; s = s + o.item->id; }
    return s;
}

int testConsumeOfBorrowedByValueParamField()
{
    int passed = 0;

    // 1. A copyable owner's field COPIES: the caller's source is still live afterwards, and
    // both the copy and the original are freed (2 dtors).
    dtorCount = 0;
    {
        OaiCopyWrap w;
        w.b.item = new Resource();
        w.b.item->id = 11;
        passed += Test("cbvf_copyable_value", cbvCopyField(w), 11);
        passed += Test("cbvf_copyable_source_live", w.b.item->id, 11);
    }
    passed += Test("cbvf_copyable_freed_all", dtorCount, 2);

    // 2. A POD field owns nothing.
    {
        OaiPodWrap w;
        w.p.x = 4;
        passed += Test("cbvf_pod_value", cbvPodField(w), 4);
        passed += Test("cbvf_pod_source_live", w.p.x, 4);
    }

    // 3. A string field: the owning axis a pointer dtor count cannot see.
    {
        OaiSWrap w;
        w.b.s = "hello";
        passed += Test("cbvf_string_value", cbvStringField(w), 5);
        passed += Test("cbvf_string_source_live", w.b.s.length(), 5);
    }

    // 4. Reading an owning field of a borrowed by-value param never stores it, so the caller
    // keeps ownership and frees exactly once.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(3);
        passed += Test("cbvf_read_value", cbvReadField(w), 3);
        passed += Test("cbvf_read_source_live", w.b.item->id, 3);
    }
    passed += Test("cbvf_read_freed_once", dtorCount, 1);

    // 5. The NESTED read, whose consuming twin is now rejected on the path ROOT.
    dtorCount = 0;
    {
        OaiOuter w;
        w.inner.b = oaiMake(7);
        passed += Test("cbvf_readnested_value", cbvReadNested(w), 7);
        passed += Test("cbvf_readnested_source_live", w.inner.b.item->id, 7);
    }
    passed += Test("cbvf_readnested_freed_once", dtorCount, 1);

    // 6. A 'move' parameter owns its copy: the field consume transfers, and the resource is
    // freed exactly once - by the callee, not by the surrendered caller source.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(8);
        passed += Test("cbvf_moveparam_value", cbvMoveParamField(move w), 8);
        passed += Test("cbvf_moveparam_freed_by_callee", dtorCount, 1);
    }
    passed += Test("cbvf_moveparam_freed_once_total", dtorCount, 1);

    // 7. A LOCAL struct's field: the consume nulls the one real object, so exactly one free.
    dtorCount = 0;
    passed += Test("cbvf_local_value", cbvLocalField(), 6);
    passed += Test("cbvf_local_freed_once", dtorCount, 1);

    // 8. The POINTER-parameter spelling stays green (filed as p2, out of this guard's scope):
    // the caller's field is nulled and the resource freed once.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(9);
        passed += Test("cbvf_ptrparam_value", cbvPtrParamField(&w), 9);
        passed += Test("cbvf_ptrparam_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("cbvf_ptrparam_freed_once", dtorCount, 1);

    // 9. A WHOLE by-value parameter consume has no field path, so the guard cannot see it and
    // the owning-sink inference keeps handing the callee ownership.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(10);
        passed += Test("cbvf_wholeparam_value", cbvWholeParam(a), 10);
        passed += Test("cbvf_wholeparam_freed_by_callee", dtorCount, 1);
    }
    passed += Test("cbvf_wholeparam_freed_once_total", dtorCount, 1);

    // 10. A local SHADOWING the parameter: the consume is of the local's field, so it is legal
    // and the caller's own resource must still be alive after the call (2 frees, not 1).
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(1);
        passed += Test("cbvf_shadow_value", cbvShadowedLocal(w), 4);
        passed += Test("cbvf_shadow_caller_live", w.b.item->id, 1);
        passed += Test("cbvf_shadow_inner_freed", dtorCount, 1);
    }
    passed += Test("cbvf_shadow_freed_both", dtorCount, 2);

    // 11. The EXPLICIT 'move' spelling of the same shadow, which the name-only test rejected
    // even before this guard existed.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(1);
        passed += Test("cbvf_shadowmove_value", cbvShadowedMove(w), 4);
        passed += Test("cbvf_shadowmove_caller_live", w.b.item->id, 1);
    }
    passed += Test("cbvf_shadowmove_freed_both", dtorCount, 2);

    // 12. The shadow declared in a LOOP body - a scope the guard reaches by a different route.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(1);
        passed += Test("cbvf_shadowloop_value", cbvShadowedInLoop(w), 4);
        passed += Test("cbvf_shadowloop_caller_live", w.b.item->id, 1);
    }
    passed += Test("cbvf_shadowloop_freed_both", dtorCount, 2);

    return passed;
}

/*
 * A LAMBDA literal is lowered on its own path, so it never reached ApplyOwningSinkInference: its
 * body consumed a by-value owning parameter while the caller kept the argument live, and both
 * freed one resource (rc 133). The inference now runs over the lambda's own parameter list, the
 * flags ride the closure TYPE (FuncPtrParam::IsOwningSink), and the indirect call site transfers
 * like a direct one. Every leg below is measured against the identical FUNCTION spelling
 * (bpsBrace / bpsAssign above), which was already a sink and is the oracle.
 */
using LpsAliasFn = Lambda<int(OaiBox)>;
int lpsCond = 0;
int lpsSeen = 0;

/*
 * Overload pairs for the by-NAME adoption hazard. A funcptr initialized with an overloaded
 * function name must adopt the sinks of the overload actually BOUND (shape-matched), never of
 * the first entry in the table - the two differ, and which one is first is declaration order.
 * Each pair is one BORROWING and one CONSUMING same-arity overload; the pairs are declared in
 * OPPOSITE orders so neither leg can pass by being the first-registered one.
 */
struct LpsBorrowBox { unique Resource* item = nullptr; };
struct LpsSinkBox   { unique Resource* item = nullptr; };
LpsBorrowBox lpsBorrowMake(int id) { LpsBorrowBox b; b.item = new Resource(); b.item->id = id; return b; }
LpsSinkBox   lpsSinkMake(int id)   { LpsSinkBox b;   b.item = new Resource(); b.item->id = id; return b; }
// Borrowing overload FIRST.
int lpsOv(LpsBorrowBox p) { return p.item->id; }
int lpsOv(LpsSinkBox p)   { LpsSinkBox[2] dst = { p }; return dst[0].item->id; }

struct LpsRevBorrowBox { unique Resource* item = nullptr; };
struct LpsRevSinkBox   { unique Resource* item = nullptr; };
LpsRevBorrowBox lpsRevBorrowMake(int id) { LpsRevBorrowBox b; b.item = new Resource(); b.item->id = id; return b; }
// Consuming overload FIRST - the order that turned into a false rejection.
int lpsRevOv(LpsRevSinkBox p)   { LpsRevSinkBox[2] dst = { p }; return dst[0].item->id; }
int lpsRevOv(LpsRevBorrowBox p) { return p.item->id; }

int testLambdaParamOwningSink()
{
    int passed = 0;

    // 1. The filed repro: a brace element in the lambda body, invoked through a declared
    // Lambda<> local. Pre-fix this aborted on the caller's second free.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        Lambda<int(OaiBox)> f = (OaiBox p) => { OaiBox[2] dst = { p }; return dst[0].item->id; };
        passed += Test("lps_brace_value", f(a), 5);
        passed += Test("lps_brace_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_brace_freed_once_total", dtorCount, 1);

    // 2. The ASSIGNMENT element spelling reaches the same consume arm; counts must match leg 1.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        Lambda<int(OaiBox)> f = (OaiBox p) => { OaiBox[2] dst; dst[0] = p; return dst[0].item->id; };
        passed += Test("lps_assign_value", f(a), 5);
        passed += Test("lps_assign_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_assign_freed_once_total", dtorCount, 1);

    // 3. The bare-brace declarator spelling - a second syntactic site for the same list.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        Lambda<int(OaiBox)> f = (OaiBox p) => { OaiBox[2] dst { p }; return dst[0].item->id; };
        passed += Test("lps_barebrace_value", f(a), 5);
        passed += Test("lps_barebrace_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_barebrace_freed_once_total", dtorCount, 1);

    // 4. A plain whole-value slot store into a local is the same consume, without any array.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(6);
        Lambda<int(OaiBox)> f = (OaiBox p) => { OaiBox q; q = p; return q.item->id; };
        passed += Test("lps_localstore_value", f(a), 6);
        passed += Test("lps_localstore_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_localstore_freed_once_total", dtorCount, 1);

    // 5. The EXPLICIT opt-out `move p` - the unconditional-move trigger, not the consume scan.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(7);
        Lambda<int(OaiBox)> f = (OaiBox p) => { OaiBox q; q = move p; return q.item->id; };
        passed += Test("lps_move_value", f(a), 7);
        passed += Test("lps_move_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_move_freed_once_total", dtorCount, 1);

    // 6. An IMMEDIATELY-INVOKED literal: the call reads the literal's own type, never a
    // declared one, so it is the leg that discriminates the type-carried flags from adoption.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(8);
        lpsSeen = 0;
        ((OaiBox p) => { OaiBox[2] dst = { p }; lpsSeen = dst[0].item->id; })(a);
        passed += Test("lps_immediate_value", lpsSeen, 8);
        passed += Test("lps_immediate_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_immediate_freed_once_total", dtorCount, 1);

    // 7. A declared TYPE ALIAS for the closure type - the alias branch adopts identically.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(9);
        LpsAliasFn f = (OaiBox p) => { OaiBox[2] dst = { p }; return dst[0].item->id; };
        passed += Test("lps_alias_value", f(a), 9);
        passed += Test("lps_alias_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_alias_freed_once_total", dtorCount, 1);

    // 8. CONDITIONAL consumption, branch NOT taken. The consume scan descends into runtime
    // conditionals, so the sink is unconditional and the callee still frees - the oracle's
    // behaviour (bpsBraceCond leg 5 of testBraceInitConsumesParameter).
    dtorCount = 0;
    lpsCond = 0;
    {
        OaiBox a = oaiMake(5);
        Lambda<int(OaiBox)> f = (OaiBox p) => {
            if (lpsCond != 0) { OaiBox[2] dst = { p }; return dst[0].item->id; }
            return -1;
        };
        passed += Test("lps_cond_skipped_value", f(a), -1);
        passed += Test("lps_cond_skipped_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_cond_skipped_freed_once_total", dtorCount, 1);

    // 9. A THIN function<> destination bound to a lambda literal: a different destination
    // representation reading the same adopted flags.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(4);
        function<int(OaiBox)> f = (OaiBox p) => { OaiBox[2] dst = { p }; return dst[0].item->id; };
        passed += Test("lps_thin_value", f(a), 4);
        passed += Test("lps_thin_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_thin_freed_once_total", dtorCount, 1);

    // 10. A funcptr bound to a NAMED function whose parameter the inference already made a
    // sink: the flags have to survive the function-symbol -> funcptr-type conversion too.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(3);
        function<int(OaiBox)> f = bpsBrace;
        passed += Test("lps_namedfn_value", f(a), 3);
        passed += Test("lps_namedfn_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_namedfn_freed_once_total", dtorCount, 1);

    // 11. ACCEPT SET (already correct pre-fix): a TEMP argument has no named source to null,
    // and must still be freed exactly once now that the parameter became a sink.
    dtorCount = 0;
    {
        Lambda<int(OaiBox)> f = (OaiBox p) => { OaiBox[2] dst = { p }; return dst[0].item->id; };
        passed += Test("lps_temp_value", f(oaiMake(2)), 2);
    }
    passed += Test("lps_temp_freed_once", dtorCount, 1);

    // 12. ACCEPT SET: a BORROWING body never consumes, so the parameter stays a borrow, the
    // caller keeps its argument readable after the call, and the caller frees it.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(12);
        Lambda<int(OaiBox)> f = (OaiBox p) => { return p.item->id; };
        passed += Test("lps_borrow_value", f(a), 12);
        passed += Test("lps_borrow_no_callee_free", dtorCount, 0);
        passed += Test("lps_borrow_source_live", a.item->id, 12);
    }
    passed += Test("lps_borrow_freed_once_by_caller", dtorCount, 1);

    // 13. ACCEPT SET: a COPYABLE owner's store is a copy, so the concrete gate keeps the
    // parameter a borrow and the caller's source is still live.
    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource();
        a.item->id = 13;
        Lambda<int(OaiCopyBox)> f = (OaiCopyBox p) => { OaiCopyBox[2] dst = { p }; return dst[0].item->id; };
        passed += Test("lps_copyable_value", f(a), 13);
        passed += Test("lps_copyable_source_live", a.item->id, 13);
    }
    passed += Test("lps_copyable_freed_all", dtorCount, 2);

    // 14. ACCEPT SET: a POD parameter owns nothing and is never sink-eligible.
    {
        OaiPod a;
        a.x = 14;
        Lambda<int(OaiPod)> f = (OaiPod p) => { OaiPod[2] dst = { p }; return dst[0].x; };
        passed += Test("lps_pod_value", f(a), 14);
        passed += Test("lps_pod_source_live", a.x, 14);
    }

    // 15. Only the CONSUMED parameter becomes a sink: the second one stays a borrow, so its
    // caller-side source survives the call and is freed by the caller.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(15);
        OaiBox b = oaiMake(16);
        Lambda<int(OaiBox,OaiBox)> f = (OaiBox p, OaiBox r) => {
            OaiBox[2] dst = { p };
            return dst[0].item->id + r.item->id;
        };
        passed += Test("lps_two_params_value", f(a, b), 31);
        passed += Test("lps_two_params_first_freed", dtorCount, 1);
        passed += Test("lps_two_params_second_live", b.item->id, 16);
    }
    passed += Test("lps_two_params_freed_twice_total", dtorCount, 2);

    // 16. ACCEPT SET: an owning CAPTURE is untouched by parameter-sink inference. OaiBox has no
    // copy(), so the capture is a shallow borrow (IsAliasBorrow) the env never frees: the sink
    // parameter is freed by the callee and the captured source only by its own scope - two total.
    dtorCount = 0;
    {
        OaiBox held = oaiMake(17);
        {
            OaiBox a = oaiMake(18);
            Lambda<int(OaiBox)> f = (OaiBox p) => {
                OaiBox[2] dst = { p };
                return dst[0].item->id + held.item->id;
            };
            passed += Test("lps_capture_value", f(a), 35);
            passed += Test("lps_capture_param_freed", dtorCount, 1);
        }
        passed += Test("lps_capture_source_live", held.item->id, 17);
    }
    passed += Test("lps_capture_freed_all", dtorCount, 2);

    // 17. ACCEPT SET: the BORROWING overload is bound, so no sink is adopted from its consuming
    // sibling. Reading the sinks off a by-name re-lookup instead made this a hard error
    // ("use of moved variable") as soon as the consuming overload was registered first.
    dtorCount = 0;
    {
        LpsBorrowBox a = lpsBorrowMake(21);
        function<int(LpsBorrowBox)> f = lpsOv;
        passed += Test("lps_ovl_borrow_value", f(a), 21);
        passed += Test("lps_ovl_borrow_no_callee_free", dtorCount, 0);
        passed += Test("lps_ovl_borrow_source_live", a.item->id, 21);
    }
    passed += Test("lps_ovl_borrow_freed_by_caller", dtorCount, 1);

    // 18. The same accept-set cell with the pair declared in the OPPOSITE order (the consuming
    // overload is registered first), which is the order the by-name lookup got wrong.
    dtorCount = 0;
    {
        LpsRevBorrowBox a = lpsRevBorrowMake(22);
        function<int(LpsRevBorrowBox)> f = lpsRevOv;
        passed += Test("lps_ovl_rev_borrow_value", f(a), 22);
        passed += Test("lps_ovl_rev_borrow_no_callee_free", dtorCount, 0);
        passed += Test("lps_ovl_rev_borrow_source_live", a.item->id, 22);
    }
    passed += Test("lps_ovl_rev_borrow_freed_by_caller", dtorCount, 1);

    // 19. The mirror: the CONSUMING overload is bound, so the shape-matched lookup must find its
    // sink even though the borrowing overload is registered first. Pre-fix this double-freed.
    dtorCount = 0;
    {
        LpsSinkBox a = lpsSinkMake(23);
        function<int(LpsSinkBox)> f = lpsOv;
        passed += Test("lps_ovl_sink_value", f(a), 23);
        passed += Test("lps_ovl_sink_freed_by_callee", dtorCount, 1);
    }
    passed += Test("lps_ovl_sink_freed_once_total", dtorCount, 1);

    return passed;
}

/*
 * A funcptr parameter DECLARED `move` in the funcptr TYPE did not transfer at the INDIRECT call:
 * ApplyFuncPtrSinkTransfer early-outed unless some FuncPtrParam carried IsOwningSink (an INFERRED
 * sink) and synthesized its params with IsMove = false, so nothing mapped the declared flag onto
 * the ApplyMoveParamTransfer path a direct call takes. The callee consumed and the caller's slot
 * was never zeroed - the direct oracle emits `store %OaiBox zeroinitializer` and the indirect one
 * emitted nothing - so both freed (rc 134). Every leg is measured against the identical DIRECT
 * call spelling, which is the oracle, and each aborted before the fix unless marked ACCEPT SET.
 */
int dmfSink(move OaiBox p)        { return p.item->id; }
int dmfBorrow(OaiBox p)           { return p.item->id; }
int dmfTwo(OaiBox p, move OaiBox q) { return p.item->id + q.item->id; }
// p is an INFERRED sink (a consuming store), q is a DECLARED move: both paths in one signature.
int dmfBoth(OaiBox p, move OaiBox q) { OaiBox[2] dst = { p }; return dst[0].item->id + q.item->id; }
int dmfInt(move int p)            { return p + 1; }
int dmfStr(move string s)         { return s.length(); }
int dmfAligned(move alignas(0, 64) int* p) { int v = p[0]; delete[] p; return v + 1; }
struct DmfHolder { function<int(move OaiBox)> f = nullptr; };
int dmfCallThrough(function<int(move OaiBox)> g, move OaiBox x) { return g(x); }
function<int(move OaiBox)> dmfGet() { return dmfSink; }
int dmfGeneric<T>(Lambda<int(move T)> g, move T x) { return g(x); }

int testDeclaredMoveFuncPtrParam()
{
    int passed = 0;

    // 1. The filed repro: a `function<>` local holding a named function whose parameter is
    // declared `move`. The callee frees once and the caller must NOT free again at scope exit.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        function<int(move OaiBox)> f = dmfSink;
        passed += Test("dmf_fn_value", f(a), 5);
        passed += Test("dmf_fn_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_fn_freed_once_total", dtorCount, 1);

    // 2. The direct-call ORACLE the leg above is measured against - identical counts.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("dmf_direct_value", dmfSink(a), 5);
        passed += Test("dmf_direct_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_direct_freed_once_total", dtorCount, 1);

    // 3. The FAT `Lambda<>` destination - a different closure representation, same flags.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(6);
        Lambda<int(move OaiBox)> f = dmfSink;
        passed += Test("dmf_lambda_value", f(a), 6);
        passed += Test("dmf_lambda_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_lambda_freed_once_total", dtorCount, 1);

    // 4. A funcptr STRUCT FIELD invoked as `h.f(a)` - the call reads the field's declared type.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(7);
        DmfHolder h;
        h.f = dmfSink;
        passed += Test("dmf_field_value", h.f(a), 7);
        passed += Test("dmf_field_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_field_freed_once_total", dtorCount, 1);

    // 5. The funcptr arrives as a PARAMETER and is invoked in the callee, so the declared type
    // travels through a call boundary rather than an initializer.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(8);
        passed += Test("dmf_param_value", dmfCallThrough(dmfSink, a), 8);
        passed += Test("dmf_param_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_param_freed_once_total", dtorCount, 1);

    // 6. The funcptr is RETURNED from a function and invoked through the returned value.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(9);
        function<int(move OaiBox)> f = dmfGet();
        passed += Test("dmf_returned_value", f(a), 9);
        passed += Test("dmf_returned_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_returned_freed_once_total", dtorCount, 1);

    // 7. A GENERIC `Lambda<int(move T)>` instantiated at OaiBox.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(10);
        passed += Test("dmf_generic_value", dmfGeneric<OaiBox>(dmfSink, a), 10);
        passed += Test("dmf_generic_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_generic_freed_once_total", dtorCount, 1);

    // 8. The explicit `move a` spelling of the argument at an indirect call.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(11);
        function<int(move OaiBox)> f = dmfSink;
        passed += Test("dmf_movearg_value", f(move a), 11);
        passed += Test("dmf_movearg_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_movearg_freed_once_total", dtorCount, 1);

    // 9. A FIELD-PATH argument: only the field is consumed, and the wrapper's teardown of the
    // zeroed field must be a no-op. Mirrors the direct call `dmfSink(w.b)`, which is rc 0.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(12);
        function<int(move OaiBox)> f = dmfSink;
        passed += Test("dmf_fieldpath_value", f(w.b), 12);
        passed += Test("dmf_fieldpath_freed_by_callee", dtorCount, 1);
    }
    passed += Test("dmf_fieldpath_freed_once_total", dtorCount, 1);

    // 10. MIXED signature: only the `move` parameter transfers. The borrowed one stays readable
    // in the caller after the call and is freed by the caller - two frees in total, not one.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(1);
        OaiBox b = oaiMake(2);
        function<int(OaiBox, move OaiBox)> f = dmfTwo;
        passed += Test("dmf_mixed_value", f(a, b), 3);
        passed += Test("dmf_mixed_move_freed_by_callee", dtorCount, 1);
        passed += Test("dmf_mixed_borrow_source_live", a.item->id, 1);
    }
    passed += Test("dmf_mixed_freed_twice_total", dtorCount, 2);

    // 11. A DECLARED `move` param and an INFERRED sink param in ONE signature: the declared one
    // takes the IsMove path, the inferred one keeps IsMove false, and neither doubles the other.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(1);
        OaiBox b = oaiMake(2);
        function<int(OaiBox, move OaiBox)> f = dmfBoth;
        passed += Test("dmf_both_value", f(a, b), 3);
        passed += Test("dmf_both_freed_by_callee", dtorCount, 2);
    }
    passed += Test("dmf_both_freed_twice_total", dtorCount, 2);

    // 12. ACCEPT SET (rc 0 before the fix): a TEMP argument has no named source to null and must
    // still be freed exactly once.
    dtorCount = 0;
    {
        function<int(move OaiBox)> f = dmfSink;
        passed += Test("dmf_temp_value", f(oaiMake(13)), 13);
    }
    passed += Test("dmf_temp_freed_once", dtorCount, 1);

    // 13. ACCEPT SET: a plain NON-move funcptr param is untouched - the caller keeps ownership
    // and its source is still readable after the call.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(14);
        function<int(OaiBox)> f = dmfBorrow;
        passed += Test("dmf_nonmove_value", f(a), 14);
        passed += Test("dmf_nonmove_no_callee_free", dtorCount, 0);
        passed += Test("dmf_nonmove_source_live", a.item->id, 14);
    }
    passed += Test("dmf_nonmove_freed_by_caller", dtorCount, 1);

    // 14. ACCEPT SET: `move` on a POD parameter owns no resource; the call yields the right value.
    // (Reading the source after it is a pre-existing indirect-vs-direct divergence - see p3.)
    {
        int x = 20;
        function<int(move int)> f = dmfInt;
        passed += Test("dmf_int_value", f(x), 21);
    }

    // 15. A `move string` funcptr param: the owning-string arm of the same transfer.
    {
        string s = "hello";
        function<int(move string)> f = dmfStr;
        passed += Test("dmf_string_value", f(s), 5);
    }

    // 16. A concat TEMP into a `move string` funcptr param: the transfer's
    // UnregisterOwnedStringTemp drops the caller's free, else both free (rc 134 pre-fix).
    {
        string p = "ab";
        string q = "cde";
        function<int(move string)> f = dmfStr;
        passed += Test("dmf_string_temp_value", f(p + q), 5);
    }

    // 17. An OVER-ALIGNED block into a `move` funcptr param: a funcptr TYPE cannot spell
    // `alignas`, so a synthesized param's 0 is "not recorded" - the direct oracle accepts too.
    {
        alignas(0, 64) int* b = new int[4] alignas(0, 64);
        b[0] = 9;
        function<int(move int*)> f = dmfAligned;
        passed += Test("dmf_align_accepted", f(b), 10);
    }

    return passed;
}

/*
 * Owning-sink inference through REDUNDANT PARENTHESES. The two collectors that feed
 * ApplyOwningSinkInference record the source subtree's raw text, so `(p)` used to spell "(p)"
 * and never match the parameter name `p` - the callee's semantic consume arms saw straight
 * through the parens and consumed anyway, so the caller was never told and both sides freed
 * (rc 134 in all four consuming spellings). Each leg below is measured against its
 * unparenthesized control, which is carried in testBraceInitConsumesParameter above; the
 * accept-set legs prove the peel stops at parentheses and does not normalize anything else.
 */
int pcsBrace(OaiBox p)          { OaiBox[2] dst = { (p) }; return dst[0].item->id; }
int pcsBraceBareDepth(OaiBox p) { OaiBox[2] dst { ((p)) }; return dst[0].item->id; }
int pcsAssign(OaiBox p)         { OaiBox[2] dst; dst[0] = (p); return dst[0].item->id; }
int pcsDecl(OaiBox p)           { OaiBox o = (((p))); return o.item->id; }
int pcsMove(OaiBox p)           { OaiBox o = move (p); return o.item->id; }
int pcsGenericBrace<T>(T p)     { T[2] dst = { (p) }; return dst[0].item->id; }
// ACCEPT SET: only a BARE name survives the peel. A parenthesized FIELD source, a parenthesized
// CALL, a COPYABLE owner and a POD must all behave exactly as their unparenthesized spelling.
int pcsPtrFieldBrace(OaiWrap* wp) { OaiBox[2] dst = { (wp->b) }; return dst[0].item->id; }
int pcsCallSrc(OaiBox p)        { OaiBox o = ( oaiMake(3) ); return o.item->id + p.item->id; }
int pcsCopyDecl(OaiCopyBox p)   { OaiCopyBox o = (p); return o.item->id; }
int pcsPodDecl(OaiPod p)        { OaiPod o = (p); return o.x; }
// A nested block local SHADOWING the parameter name: the scan is name-based and
// at-least-one-path, so the parenthesized spelling must over-collect exactly as the bare one does.
int pcsShadow(OaiBox p)
{
    int id = 0;
    { OaiBox p = oaiMake(9); OaiBox q = (p); id = q.item->id; }
    return id;
}

int testParenConsumeSourceSink()
{
    int passed = 0;

    // 1. Brace element `{ (p) }` - the filed repro. The callee consumes, so the caller's
    // argument is surrendered and freed exactly once, by the callee.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("pcs_brace_value", pcsBrace(a), 5);
        passed += Test("pcs_brace_freed_by_callee", dtorCount, 1);
    }
    passed += Test("pcs_brace_freed_once_total", dtorCount, 1);

    // 2. Bare-brace declarator form at paren depth 2 - a second syntactic site, and the
    // depth axis: the peel must be a loop, not a single unwrap.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("pcs_bracebare_depth2_value", pcsBraceBareDepth(a), 5);
        passed += Test("pcs_bracebare_depth2_freed_by_callee", dtorCount, 1);
    }
    passed += Test("pcs_bracebare_depth2_freed_once_total", dtorCount, 1);

    // 3. Slot store `dst[0] = (p)`.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("pcs_assign_value", pcsAssign(a), 5);
        passed += Test("pcs_assign_freed_by_callee", dtorCount, 1);
    }
    passed += Test("pcs_assign_freed_once_total", dtorCount, 1);

    // 4. Decl initializer at paren depth 3.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("pcs_decl_depth3_value", pcsDecl(a), 5);
        passed += Test("pcs_decl_depth3_freed_by_callee", dtorCount, 1);
    }
    passed += Test("pcs_decl_depth3_freed_once_total", dtorCount, 1);

    // 5. Explicit `move (p)` - the UNCONDITIONAL-move collector, a different trigger from
    // legs 1-4 (it sets IsOwningSink without the structural consume flag).
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("pcs_move_value", pcsMove(a), 5);
        passed += Test("pcs_move_freed_by_callee", dtorCount, 1);
    }
    passed += Test("pcs_move_freed_once_total", dtorCount, 1);

    // 6. A generic function's monomorphized parameter runs the same inference.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(9);
        passed += Test("pcs_generic_value", pcsGenericBrace<OaiBox>(a), 9);
        passed += Test("pcs_generic_freed_by_callee", dtorCount, 1);
    }
    passed += Test("pcs_generic_freed_once_total", dtorCount, 1);

    // 7. A TEMP argument has no named source to null, and must still be freed once.
    dtorCount = 0;
    passed += Test("pcs_temp_value", pcsBrace(oaiMake(7)), 7);
    passed += Test("pcs_temp_freed_once", dtorCount, 1);

    // 8. ACCEPT SET: `(wp->b)` peels to "wp->b", which matches no parameter name, so the
    // pointer parameter stays a borrow and the field is consumed silently - as bare `wp->b`.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(3);
        passed += Test("pcs_ptrfieldsrc_value", pcsPtrFieldBrace(&w), 3);
        passed += Test("pcs_ptrfieldsrc_source_nulled", w.b.item == nullptr, true);
    }
    passed += Test("pcs_ptrfieldsrc_freed_once", dtorCount, 1);

    // 9. ACCEPT SET: a parenthesized CALL source peels to "oaiMake(3)", never a name, so the
    // parameter is NOT made a sink and the caller's source is still live after the call.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("pcs_callsrc_value", pcsCallSrc(a), 8);
        passed += Test("pcs_callsrc_source_live", a.item->id, 5);
        passed += Test("pcs_callsrc_callee_freed_its_temp", dtorCount, 1);
    }
    passed += Test("pcs_callsrc_freed_all", dtorCount, 2);

    // 10. ACCEPT SET: a copyable owner's store is a COPY, so the concrete gate keeps the
    // parameter a borrow even though the name is now collected.
    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource();
        a.item->id = 11;
        passed += Test("pcs_copyable_value", pcsCopyDecl(a), 11);
        passed += Test("pcs_copyable_source_live", a.item->id, 11);
    }
    passed += Test("pcs_copyable_freed_all", dtorCount, 2);

    // 11. ACCEPT SET: a POD parameter owns nothing, so it is never a sink.
    {
        OaiPod a;
        a.x = 4;
        passed += Test("pcs_pod_value", pcsPodDecl(a), 4);
        passed += Test("pcs_pod_source_live", a.x, 4);
    }

    // 12. SHADOWING: the inner block's own `p` is consumed, and the name-based scan makes the
    // PARAMETER a sink too - the deliberate over-approximation, and it must be identical for
    // the parenthesized spelling. Both resources are therefore freed inside the callee.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        passed += Test("pcs_shadow_value", pcsShadow(a), 9);
        passed += Test("pcs_shadow_freed_by_callee", dtorCount, 2);
    }
    passed += Test("pcs_shadow_freed_once_total", dtorCount, 2);

    return passed;
}

/*
 * WRAPPER PROVENANCE. A parenthesis and a REDUNDANT same-type cast (`(T)x`, `x as T`) change the
 * SPELLING of an operand, never its value - but the parenthesized-primary lowering returned a raw
 * value and the cast lowering dropped the operand's Storage, so every ownership arm that keys on
 * the operand's NamedVariable went blind under a wrapper: consume arms copied instead of moving
 * (double free), the borrowed-by-value-parameter reject guard stayed silent on a program whose
 * bare twin is a hard error, moved-from marking was skipped (a null deref instead of a
 * "use of moved variable" rejection), and the owning-sink inference never fired.
 * Every leg below is measured against its BARE twin - the oracle - and each was wrong on the
 * pre-fix binary in the way its comment names.
 */
OaiBox wcpRetParen(OaiBox p)  { return (p); }        // (a) borrowed by-value param, was rc 134
OaiBox wcpRetBare(OaiBox p)   { return p; }          // the oracle
void   wcpCondMoveParen(OaiCopyBox p, int c) { OaiCopyBox o; if (c != 0) { o = move (p); } }
void   wcpCondMoveBare(OaiCopyBox p, int c)  { OaiCopyBox o; if (c != 0) { o = move p; } }
int    wcpCastDecl(OaiBox p)  { OaiBox o = (OaiBox)p;  return o.item->id; }   // (h) was rc 134
int    wcpAsDecl(OaiBox p)    { OaiBox o = p as OaiBox; return o.item->id; }  // (h) was rc 134
int    wcpCastBrace(OaiBox p) { OaiBox[2] d = { (OaiBox)p }; return d[0].item->id; }
// (h6) an owning FIELD returned through a redundant `as`: the cast dropped Storage, so the
// return-position consume arm could not see the field at all - rc 133 with a garbage id.
OaiBox wcpRetFieldAs()        { OaiWrap w; w.b = oaiMake(31); return w.b as OaiBox; }
// (f) a `string` FIELD of a dying frame under a wrapper: the deep-copy arm keys on FieldName,
// which the wrapper dropped, so the caller read back the frame's freed buffer.
string wcpRetStrParen()       { OaiSBox b; b.s = "wr" + "ap"; return (b.s); }
string wcpRetStrAs()          { OaiSBox b; b.s = "wr" + "ap"; return b.s as string; }
// (d) a `T[]` VIEW element under parens: IsViewElement was dropped, so the read aliased the live
// slot instead of consuming it and the store orphaned the old element.
int wcpViewElemRead(OaiBox[] v)  { OaiBox q = (v[0]); return q.item->id; }
// ACCEPT SET: a TYPE-CHANGING cast is not a whole-value consume and must leave the parameter a
// borrow. `(long)p.item` names neither the parameter nor its type.
int wcpTypeChangingCast(OaiBox p) { long v = (long)p.item; return v != 0 ? 1 : 0; }
// ACCEPT SET: wrappers stay inert over a POD and over a copyable owner.
int wcpPodParen(OaiPod p)         { OaiPod o = ((p)); return o.x; }
int wcpCopyParen(OaiCopyBox p)    { OaiCopyBox o = (p); return o.item->id; }

/*
 * SPELLING CANONICALIZATION. The wrapper peel compared a cast's raw TYPE SPELLING with the
 * parameter's already-canonical TypeName, so every NON-canonical spelling of the parameter's own
 * type missed: the sink was never inferred, the caller kept its argument, and both sides freed -
 * every leg below ABORTED on the pre-fix binary (measured rc 133 as a native exe, from macOS
 * malloc's double-free guard; rc 134 under `--run`). Four spelling families reach it - a `using`
 * alias, a namespace-relative name inside its own namespace, a generic instantiation (`Box<int>`
 * against the mangled `Box__int`), and a NESTED one whose argument must mangle through the same
 * funnel.
 */
using OaiAlias  = OaiBox;
using OaiAlias2 = OaiAlias;                                              // alias of an alias
int wcpAliasCast(OaiBox p)        { OaiBox o = (OaiAlias)p;  return o.item->id; }
int wcpAliasCast2(OaiBox p)       { OaiBox o = (OaiAlias2)p; return o.item->id; }
int wcpAliasAs(OaiBox p)          { OaiBox o = p as OaiAlias; return o.item->id; }
int wcpAliasParenCast(OaiBox p)   { OaiBox o = ((OaiAlias)(p)); return o.item->id; }
int wcpAliasParamCast(OaiAlias p) { OaiBox o = (OaiAlias)p;  return o.item->id; }
int wcpAliasBrace(OaiBox p)       { OaiBox[2] d = { (OaiAlias)p }; return d[0].item->id; }
int wcpAliasAssign(OaiBox p)      { OaiBox o; o = (OaiAlias)p; return o.item->id; }
// The RETURN-classification copy of the same predicate: an alias-spelled cast defeated the
// all-paths-return-a-borrowed-parameter inference, so the caller allocated a second owner.
OaiBox wcpAliasRet(OaiBox p)      { return (OaiAlias)p; }

struct WcpGBox<T> { unique Resource* item = nullptr; T tag = default; };
using WcpGAlias = WcpGBox<int>;
WcpGBox<int> wcpGMake(int id) { WcpGBox<int> b; b.item = new Resource(); b.item->id = id; return b; }
int wcpGenericCast(WcpGBox<int> p)      { WcpGBox<int> o = (WcpGBox<int>)p; return o.item->id; }
int wcpGenericAliasCast(WcpGBox<int> p) { WcpGBox<int> o = (WcpGAlias)p;    return o.item->id; }
// A NESTED instantiation: the argument itself must be mangled through the same funnel, or the
// spelling meets the declared `WcpGBox__WcpInner__i32` as `WcpGBox__WcpInner<int>` and misses.
struct WcpInner<T> { T tag = default; };
WcpGBox<WcpInner<int>> wcpGMakeNested(int id)
{ WcpGBox<WcpInner<int>> b; b.item = new Resource(); b.item->id = id; return b; }
int wcpGenericNestedCast(WcpGBox<WcpInner<int>> p)
{ WcpGBox<WcpInner<int>> o = (WcpGBox<WcpInner<int>>)p; return o.item->id; }

namespace WcpNs
{
    struct NsBox { unique Resource* item = nullptr; };
    using NsAlias = WcpNs.NsBox;
    int nsCast(NsBox p)      { NsBox o = (NsBox)p;   return o.item->id; }
    int nsAliasCast(NsBox p) { NsBox o = (NsAlias)p; return o.item->id; }
    NsBox nsRet(NsBox p)     { return (NsBox)p; }
}
WcpNs.NsBox wcpNsMake(int id) { WcpNs.NsBox b; b.item = new Resource(); b.item->id = id; return b; }

int testWrapperConsumeProvenance()
{
    int passed = 0;

    // 1. (a) `return (p)` of a BORROWED by-value owning parameter. The wrapper defeated the
    // all-paths-return-a-borrowed-parameter classification, so the return stopped being inferred
    // `alias`: the CALLER allocated a second owner and destructed it - rc 134, two frees of one
    // Resource. The bare twin beside it is the oracle and was always correct.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox r = wcpRetParen(a);
        passed += Test("wcp_retparen_value", r.item->id, 5);
        passed += Test("wcp_retparen_no_second_owner", dtorCount, 0);
    }
    passed += Test("wcp_retparen_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(5);
        OaiBox r = wcpRetBare(a);
        passed += Test("wcp_retbare_value", r.item->id, 5);
    }
    passed += Test("wcp_retbare_freed_once", dtorCount, 1);

    // 2. (b) a CONDITIONAL `move (p)` of a COPYABLE owning parameter. Both spellings collect the
    // name, and the concrete copyability gate keeps the parameter a borrow in both - the
    // divergence was INSIDE the callee: `move (p)` moved out of the caller's storage (leaving the
    // caller's source garbage, rc 134) where `move p` copies. Asserting the CALLER's source is
    // what discriminates; the callee's own value is 5 either way.
    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource();
        a.item->id = 5;
        wcpCondMoveParen(a, 1);
        passed += Test("wcp_condmove_paren_source_live", a.item->id, 5);
        passed += Test("wcp_condmove_paren_copy_freed", dtorCount, 1);
    }
    passed += Test("wcp_condmove_paren_freed_all", dtorCount, 2);

    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource();
        a.item->id = 5;
        wcpCondMoveBare(a, 1);
        passed += Test("wcp_condmove_bare_source_live", a.item->id, 5);
    }
    passed += Test("wcp_condmove_bare_freed_all", dtorCount, 2);

    // 3. (c) a parenthesized store source on a LOCAL was never marked moved-from, so reading the
    // source afterwards was a null deref (rc 139) where the bare spelling is a compile-time
    // "use of moved variable". The rejection itself is pinned in Test/errors; here the VALUE leg
    // proves the local really is consumed - the source is nulled and freed exactly once.
    dtorCount = 0;
    {
        OaiBox x = oaiMake(6);
        OaiBox o = (x);
        passed += Test("wcp_localparen_value", o.item->id, 6);
        passed += Test("wcp_localparen_no_early_free", dtorCount, 0);
    }
    // COVERAGE, not a discriminator, and measured as such: the store already NULLED the source
    // lvalue before the fix (the IR of this leg is byte-identical on both binaries), so only the
    // compile-time moved-from MARKING was missing. Its discriminator is therefore the rejection
    // leg `parenLocal` in Test/errors/err_wrapper_consume_source_use_after_move.cb, where the
    // pre-fix binary compiles the read of `x` and null-derefs at rc 139.
    passed += Test("wcp_localparen_freed_once", dtorCount, 1);

    // 4. (h) the three CAST spellings of a whole-value consume. Each freed in the callee AND left
    // the caller believing it still owned the value (rc 134). The owning-sink inference now sees
    // the peeled name, so the caller surrenders the argument and the callee frees it once.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(7);
        passed += Test("wcp_cast_decl_value", wcpCastDecl(a), 7);
        passed += Test("wcp_cast_decl_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_cast_decl_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(8);
        passed += Test("wcp_as_decl_value", wcpAsDecl(a), 8);
        passed += Test("wcp_as_decl_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_as_decl_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(9);
        passed += Test("wcp_cast_brace_value", wcpCastBrace(a), 9);
        passed += Test("wcp_cast_brace_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_cast_brace_freed_once_total", dtorCount, 1);

    // 5. (h6) an owning FIELD returned through a redundant `as`. The cast severed Storage, so the
    // return-position consume arm never ran: the field's bits were copied, the frame's struct
    // freed the pointee, and the caller read a dangling id.
    dtorCount = 0;
    {
        OaiBox r = wcpRetFieldAs();
        passed += Test("wcp_retfield_as_value", r.item->id, 31);
        passed += Test("wcp_retfield_as_no_early_free", dtorCount, 0);
    }
    passed += Test("wcp_retfield_as_freed_once", dtorCount, 1);

    // 6. (f) a `string` FIELD of a frame-local struct returned under each wrapper. The buffer is
    // freed by the frame on the way out, so a borrow hands the caller freed bytes - a SILENT
    // wrong value at rc 0. Comparing the CONTENT is the whole leg: the length survives.
    passed += Test("wcp_retstr_paren_value", wcpRetStrParen(), "wrap");
    passed += Test("wcp_retstr_as_value", wcpRetStrAs(), "wrap");

    // 7. (d) a `T[]` VIEW element read under parens. The fixed-array twin was correct in both
    // spellings; only the view lost IsViewElement, so the read aliased a slot that stays live -
    // two owners, rc 133. The source-nulled leg is the discriminator.
    dtorCount = 0;
    {
        OaiBox[2] base;
        base[0] = oaiMake(12);
        OaiBox[] v = base;
        passed += Test("wcp_viewelem_value", wcpViewElemRead(v), 12);
        passed += Test("wcp_viewelem_source_nulled", base[0].item == nullptr, true);
    }
    passed += Test("wcp_viewelem_freed_once", dtorCount, 1);

    // 8. (delete) `delete (r)` retired neither the local nor its owning bit, so the scope-exit
    // cleanup freed the same pointer a second time (rc 134).
    dtorCount = 0;
    {
        Resource* r = new Resource();
        r->id = 13;
        delete (r);
        passed += Test("wcp_delete_paren_freed_once", dtorCount, 1);
    }
    passed += Test("wcp_delete_paren_no_second_free", dtorCount, 1);

    // 9. ACCEPT SET: a TYPE-CHANGING cast is not a whole-value consume. `(long)p.item` must leave
    // the parameter a plain borrow, so the CALLER still owns and frees the resource. Identical on
    // both binaries - this leg is the false-rejection tripwire, not a discriminator.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(14);
        passed += Test("wcp_typechanging_value", wcpTypeChangingCast(a), 1);
        passed += Test("wcp_typechanging_no_callee_free", dtorCount, 0);
        passed += Test("wcp_typechanging_source_live", a.item->id, 14);
    }
    passed += Test("wcp_typechanging_freed_by_caller", dtorCount, 1);

    // 10. ACCEPT SET: wrappers stay inert over a POD and over a copyable owner (a copy duplicates
    // no ownership, so the parameter stays a borrow and the caller's source lives on).
    {
        OaiPod a;
        a.x = 15;
        passed += Test("wcp_pod_paren_value", wcpPodParen(a), 15);
        passed += Test("wcp_pod_paren_source_live", a.x, 15);
    }

    dtorCount = 0;
    {
        OaiCopyBox a;
        a.item = new Resource();
        a.item->id = 16;
        passed += Test("wcp_copy_paren_value", wcpCopyParen(a), 16);
        passed += Test("wcp_copy_paren_source_live", a.item->id, 16);
    }
    passed += Test("wcp_copy_paren_freed_all", dtorCount, 2);

    // 11. SPELLING CANONICALIZATION. Each cast names the PARAMETER'S OWN type through a
    // non-canonical spelling, so the callee consumes and the caller must surrender: exactly one
    // free in total. Every family here ABORTED on the pre-fix binary (rc 133 as a native exe, 134
    // under `--run`) - the callee freed, then the caller freed the same Resource at scope exit,
    // and the nested-generic family did the same at this fix's own first commit. The DISCRIMINATOR
    // is each `_freed_once_total` / `_freed_once` leg: the in-scope readings above are identical
    // on both binaries (the second free happens at teardown), so they are coverage, not the proof.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(41);
        passed += Test("wcp_alias_cast_value", wcpAliasCast(a), 41);
        passed += Test("wcp_alias_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_alias_cast_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(42);
        passed += Test("wcp_alias2_cast_value", wcpAliasCast2(a), 42);
        passed += Test("wcp_alias2_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_alias2_cast_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(43);
        passed += Test("wcp_alias_as_value", wcpAliasAs(a), 43);
        passed += Test("wcp_alias_as_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_alias_as_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(44);
        passed += Test("wcp_alias_paren_cast_value", wcpAliasParenCast(a), 44);
        passed += Test("wcp_alias_paren_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_alias_paren_cast_freed_once_total", dtorCount, 1);

    // The parameter itself spelled with the alias: its recorded TypeName is the RESOLVED name, so
    // this misses for the same reason the resolved-parameter spelling does.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(45);
        passed += Test("wcp_alias_param_cast_value", wcpAliasParamCast(a), 45);
        passed += Test("wcp_alias_param_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_alias_param_cast_freed_once_total", dtorCount, 1);

    // The brace-element and plain-assignment consume positions share the collector.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(46);
        passed += Test("wcp_alias_brace_value", wcpAliasBrace(a), 46);
        passed += Test("wcp_alias_brace_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_alias_brace_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox a = oaiMake(47);
        passed += Test("wcp_alias_assign_value", wcpAliasAssign(a), 47);
        passed += Test("wcp_alias_assign_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_alias_assign_freed_once_total", dtorCount, 1);

    // The RETURN classification is a second copy of the same predicate: `return (Alias)p` must
    // stay the borrow `return p` is, so no second owner is allocated and the resource dies once.
    dtorCount = 0;
    {
        OaiBox a = oaiMake(48);
        OaiBox r = wcpAliasRet(a);
        passed += Test("wcp_alias_ret_value", r.item->id, 48);
        passed += Test("wcp_alias_ret_no_second_owner", dtorCount, 0);
    }
    passed += Test("wcp_alias_ret_freed_once", dtorCount, 1);

    // A GENERIC instantiation: the parameter's TypeName is the MANGLED `WcpGBox__i32`, so even the
    // bare `(WcpGBox<int>)` spelling missed - this leg carries no alias at all.
    dtorCount = 0;
    {
        WcpGBox<int> a = wcpGMake(51);
        passed += Test("wcp_generic_cast_value", wcpGenericCast(a), 51);
        passed += Test("wcp_generic_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_generic_cast_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        WcpGBox<int> a = wcpGMake(52);
        passed += Test("wcp_generic_alias_cast_value", wcpGenericAliasCast(a), 52);
        passed += Test("wcp_generic_alias_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_generic_alias_cast_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        WcpGBox<WcpInner<int>> a = wcpGMakeNested(53);
        passed += Test("wcp_generic_nested_cast_value", wcpGenericNestedCast(a), 53);
        passed += Test("wcp_generic_nested_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_generic_nested_cast_freed_once_total", dtorCount, 1);

    // A NAMESPACE-relative spelling inside its own namespace: the parameter's TypeName is the
    // qualified `WcpNs.NsBox`, so the bare `(NsBox)` spelling missed on both halves of the fix -
    // the caller kept its argument AND the callee's own parameter copy was never nulled.
    dtorCount = 0;
    {
        WcpNs.NsBox a = wcpNsMake(61);
        passed += Test("wcp_ns_cast_value", WcpNs.nsCast(a), 61);
        passed += Test("wcp_ns_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_ns_cast_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        WcpNs.NsBox a = wcpNsMake(62);
        passed += Test("wcp_ns_alias_cast_value", WcpNs.nsAliasCast(a), 62);
        passed += Test("wcp_ns_alias_cast_freed_by_callee", dtorCount, 1);
    }
    passed += Test("wcp_ns_alias_cast_freed_once_total", dtorCount, 1);

    dtorCount = 0;
    {
        WcpNs.NsBox a = wcpNsMake(63);
        WcpNs.NsBox r = WcpNs.nsRet(a);
        passed += Test("wcp_ns_ret_value", r.item->id, 63);
        passed += Test("wcp_ns_ret_no_second_owner", dtorCount, 0);
    }
    passed += Test("wcp_ns_ret_freed_once", dtorCount, 1);

    return passed;
}

int testBorrowedPointerMoveNoAdopt()
{
    int passed = 0;

    // Bare parameter. The callee reads the right object and frees nothing; the caller frees once.
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 81;
        passed += Test("bpm_bare_param_value", bpmBareParam(owner), 81);
        passed += Test("bpm_bare_param_callee_freed_nothing", dtorCount, 0);
        delete owner;
    }
    passed += Test("bpm_bare_param_freed_once", dtorCount, 1);

    // One hop: the copy carries the borrow, so the move off the COPY must not adopt either.
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 82;
        passed += Test("bpm_one_hop_value", bpmOneHopCopy(owner), 82);
        passed += Test("bpm_one_hop_callee_freed_nothing", dtorCount, 0);
        delete owner;
    }
    passed += Test("bpm_one_hop_freed_once", dtorCount, 1);

    // Two hops: the borrow must survive an intermediate copy, not just the first one.
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 83;
        passed += Test("bpm_two_hop_value", bpmTwoHopCopy(owner), 83);
        delete owner;
    }
    passed += Test("bpm_two_hop_freed_once", dtorCount, 1);

    // The destination is never read, so only the free count can see this one.
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 84;
        bpmDropped(owner);
        passed += Test("bpm_dropped_callee_freed_nothing", dtorCount, 0);
        delete owner;
    }
    passed += Test("bpm_dropped_freed_once", dtorCount, 1);

    // The generic instantiation runs the same declaration path after substitution.
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 85;
        bpmGenericDropped<Resource>(owner);
        passed += Test("bpm_generic_callee_freed_nothing", dtorCount, 0);
        delete owner;
    }
    passed += Test("bpm_generic_freed_once", dtorCount, 1);

    // A dtor-less pointee has no free count, so pin the value: adopting used to free the array
    // out from under the caller and the read below returned garbage (or aborted).
    {
        int* nums = new int[3];
        nums[0] = 86;
        passed += Test("bpm_primitive_ptr_value", bpmPrimitivePtr(nums), 86);
        passed += Test("bpm_primitive_ptr_still_readable", nums[0], 86);
        delete[] nums;
    }

    // Retirement, copy end: `b` was rebound to a fresh object, so the move TRANSFERS and the
    // callee's delete is correct. Two frees total - the fresh object and the caller's own.
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 87;
        passed += Test("bpm_copy_rebound_value", bpmCopyRebound(owner), 91);
        passed += Test("bpm_copy_rebound_fresh_freed", dtorCount, 1);
        delete owner;
    }
    passed += Test("bpm_copy_rebound_total_frees", dtorCount, 2);

    // Retirement, parameter end: the same on the PARAMETER's own binding.
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 88;
        passed += Test("bpm_param_rebound_value", bpmParamRebound(owner), 92);
        passed += Test("bpm_param_rebound_fresh_freed", dtorCount, 1);
        delete owner;
    }
    passed += Test("bpm_param_rebound_total_frees", dtorCount, 2);

    /*
     * A GLOBAL source and no `delete` anywhere - the one shape where the old adopting behaviour
     * ran to completion instead of aborting, because a global is not auto-freed and nothing freed
     * it twice. It still freed the pointee out from under a global that keeps pointing at it, so
     * the object was dead while reachable. Non-adoption leaves it alive and owned by the global.
     */
    dtorCount = 0;
    bpmGlobalOwner = new Resource();
    bpmGlobalOwner->id = 89;
    bpmDroppedNoDelete(bpmGlobalOwner);
    passed += Test("bpm_global_nodelete_not_freed", dtorCount, 0);
    passed += Test("bpm_global_nodelete_still_alive", bpmGlobalOwner->id, 89);
    delete bpmGlobalOwner;
    bpmGlobalOwner = nullptr;
    passed += Test("bpm_global_nodelete_freed_once", dtorCount, 1);

    return passed;
}

/*
 * The ACCEPT SET of the copy-fact propagation (the fix/ptrcopy landed design record in
 * internal/issue/interface-issue-queue.md; the issue file itself is deleted, per convention).
 * Four ownership facts now cross a plain pointer DECLARATION - a copy of an owning local into a
 * `unique` FIELD, a container-ELEMENT borrow, a `move` off either, and a '?:' / '??' JOIN - and
 * each of those rejections has shapes in the SAME syntactic neighbourhood where the copy is the
 * SOLE owner. Rejecting one of those would LEAK, which is the polarity error this family has paid
 * for twice, so every leg below is a program master compiles and frees correctly and must keep
 * doing so. Values pin WHICH object was read (each object carries a distinct `id`) and the free
 * counts pin that every object is released exactly once - a leg asserting only "it compiled"
 * cannot see the leak direction.
 */
int testCopyFactPropagationAccepts()
{
    int passed = 0;

    // A LATE-ASSIGNED source: `src` never became an owning local, so the copy stored into the
    // `unique` field is the field's ONLY owner. Rejecting this store would leak the object.
    dtorCount = 0;
    {
        MoveParamHolder h = default;
        Resource* lateSrc = nullptr;
        lateSrc = new Resource();
        lateSrc->id = 61;
        Resource* lateCopy = lateSrc;
        h.p = lateCopy;
        passed += Test("uf_store_copy_late_value", h.p->id, 61);
        passed += Test("uf_store_copy_late_no_early_free", dtorCount, 0);
    }
    passed += Test("uf_store_copy_late_freed_once", dtorCount, 1);

    // The SOURCE rebound AFTER the copy: the copy then holds the ONLY reference to the original,
    // so the field is its sole owner and the rebound source owns the new object. Two objects,
    // two frees - the values prove both were read, not one aliased twice.
    dtorCount = 0;
    {
        MoveParamHolder h2 = default;
        Resource* reSrc = new Resource();
        reSrc->id = 62;
        Resource* reCopy = reSrc;
        reSrc = new Resource();
        reSrc->id = 63;
        h2.p = reCopy;
        passed += Test("uf_store_copy_src_rebound_field", h2.p->id, 62);
        passed += Test("uf_store_copy_src_rebound_src", reSrc->id, 63);
        delete reSrc;
        passed += Test("uf_store_copy_src_rebound_one_free", dtorCount, 1);
    }
    passed += Test("uf_store_copy_src_rebound_freed_twice", dtorCount, 2);

    // The COPY rebound BEFORE the store: it is the sole owner of what it now holds, so its
    // declaration-time fact is retired and the store is a genuine transfer.
    dtorCount = 0;
    {
        MoveParamHolder h3 = default;
        Resource* keepSrc = new Resource();
        keepSrc->id = 64;
        Resource* movedCopy = keepSrc;
        movedCopy = new Resource();
        movedCopy->id = 65;
        h3.p = movedCopy;
        passed += Test("uf_store_copy_rebound_field", h3.p->id, 65);
        passed += Test("uf_store_copy_rebound_src", keepSrc->id, 64);
        delete keepSrc;
        passed += Test("uf_store_copy_rebound_one_free", dtorCount, 1);
    }
    passed += Test("uf_store_copy_rebound_freed_twice", dtorCount, 2);

    // A GLOBAL source: a global owning pointer never scope-exit-frees, so it is not an owning
    // LOCAL and the field is the only owner. Untouched by the guard, exactly as before.
    dtorCount = 0;
    {
        MoveParamHolder h4 = default;
        g_retainedResource = new Resource();
        g_retainedResource->id = 66;
        Resource* globalCopy = g_retainedResource;
        h4.p = globalCopy;
        passed += Test("uf_store_copy_global_value", h4.p->id, 66);
        passed += Test("uf_store_copy_global_no_early_free", dtorCount, 0);
    }
    passed += Test("uf_store_copy_global_freed_once", dtorCount, 1);
    g_retainedResource = nullptr;

    // A copy of a container-ELEMENT borrow, REBOUND before the delete. The plain '=' refreshes
    // the element taint from the new RHS, so the copy is the sole owner of its `new` and the
    // delete is correct; the container still frees its own element.
    dtorCount = 0;
    {
        list<unique Resource*> lAcc;
        Resource* firstElem = new Resource();
        firstElem->id = 67;
        lAcc.add(firstElem);
        Resource* elemBorrow = lAcc.get(0);
        Resource* elemCopy = elemBorrow;
        elemCopy = new Resource();
        elemCopy->id = 68;
        passed += Test("elem_copy_rebound_value", elemCopy->id, 68);
        delete elemCopy;
        passed += Test("elem_copy_rebound_one_free", dtorCount, 1);
        passed += Test("elem_copy_rebound_container_alive", lAcc.get(0)->id, 67);
    }
    passed += Test("elem_copy_rebound_freed_twice", dtorCount, 2);

    // READING through a copy of an element borrow stays legal - the tag drives the delete/move
    // guards only, never plain use. The container frees its element exactly once.
    dtorCount = 0;
    {
        list<unique Resource*> lRead;
        Resource* readElem = new Resource();
        readElem->id = 69;
        lRead.add(readElem);
        Resource* readBorrow = lRead.get(0);
        Resource* readCopy = readBorrow;
        passed += Test("elem_copy_read_value", readCopy->id, 69);
        passed += Test("elem_copy_read_no_early_free", dtorCount, 0);
    }
    passed += Test("elem_copy_read_freed_once", dtorCount, 1);

    // `move` off a copy whose SOURCE was rebound: the copy holds the only reference, so the move
    // is a real transfer. The guard re-asks liveness, so this must not be rejected - the remedy a
    // rejection would name ("move the owner instead") would move the WRONG object here.
    dtorCount = 0;
    {
        Resource* mvSrc = new Resource();
        mvSrc->id = 70;
        Resource* mvCopy = mvSrc;
        mvSrc = new Resource();
        mvSrc->id = 71;
        Resource* adopted = move mvCopy;
        passed += Test("move_copy_src_rebound_value", adopted->id, 70);
        delete adopted;
        passed += Test("move_copy_src_rebound_one_free", dtorCount, 1);
        passed += Test("move_copy_src_rebound_src_alive", mvSrc->id, 71);
        delete mvSrc;
    }
    passed += Test("move_copy_src_rebound_freed_twice", dtorCount, 2);

    // `move` off a copy of a LATE-ASSIGNED source - the same sole-owner shape on the move axis.
    dtorCount = 0;
    {
        Resource* mvLate = nullptr;
        mvLate = new Resource();
        mvLate->id = 72;
        Resource* mvLateCopy = mvLate;
        Resource* lateAdopted = move mvLateCopy;
        passed += Test("move_copy_late_value", lateAdopted->id, 72);
        delete lateAdopted;
        passed += Test("move_copy_late_one_free", dtorCount, 1);
    }
    passed += Test("move_copy_late_freed_once", dtorCount, 1);

    // The DIRECT `move` of an owning local - the remedy both new move diagnostics name. It must
    // keep working or the rejections point at nothing.
    dtorCount = 0;
    {
        Resource* directOwner = new Resource();
        directOwner->id = 73;
        Resource* directAdopted = move directOwner;
        passed += Test("move_direct_owner_value", directAdopted->id, 73);
        delete directAdopted;
        passed += Test("move_direct_owner_one_free", dtorCount, 1);
    }
    passed += Test("move_direct_owner_freed_once", dtorCount, 1);

    // A MIXED '?:' join - one arm an owning local, one a fresh `new`. The BOTH-ARMS rule drops
    // the fact rather than rejecting on a may-alias, matching the per-arm interface boxing ledger.
    dtorCount = 0;
    {
        Resource* joinOwner = new Resource();
        joinOwner->id = 74;
        Resource* mixedJoin = identityBool(false) ? joinOwner : new Resource();
        mixedJoin->id = 75;
        passed += Test("join_owner_new_value", mixedJoin->id, 75);
        delete mixedJoin;
        delete joinOwner;
        passed += Test("join_owner_new_freed_twice", dtorCount, 2);
    }

    // A join of two fresh `new`s owns what it holds, so deleting it is the ONLY release.
    dtorCount = 0;
    {
        Resource* newJoin = identityBool(true) ? new Resource() : new Resource();
        newJoin->id = 76;
        passed += Test("join_two_new_value", newJoin->id, 76);
        delete newJoin;
        passed += Test("join_two_new_freed_once", dtorCount, 1);
    }

    // A join ARM nulled after the join. `b` then holds the ONLY reference, so `delete b;` is the
    // only release and rejecting it would LEAK. This is the arm-liveness axis: the join proof
    // records every arm's SLOT and re-asks it at the consumer, exactly as the copy proof re-asks
    // its source. Round 1 of this fix recorded only a rendered owner NAME, could not re-ask, and
    // false-rejected this program - the 38-leg accept set had no cell on this axis, which is how
    // it shipped. The plain-copy sibling (`assign_copy_delete_*` above) was always accepted, so
    // without these legs copy and join disagreed on the very axis the change set out to align.
    dtorCount = 0;
    {
        Resource* armOwner = new Resource();
        armOwner->id = 78;
        Resource* joinNulled = identityBool(true) ? armOwner : armOwner;
        armOwner = nullptr;
        passed += Test("join_arm_nulled_value", joinNulled->id, 78);
        delete joinNulled;
        passed += Test("join_arm_nulled_freed_once", dtorCount, 1);
    }
    passed += Test("join_arm_nulled_no_second_free", dtorCount, 1);

    // The same retirement through the '??' spelling, whose arms are recovered from the coalesce
    // ledger rather than from a PHI - both routes must retire or the two spellings disagree.
    dtorCount = 0;
    {
        Resource* coalOwner = new Resource();
        coalOwner->id = 79;
        Resource* coalJoin = coalOwner ?? coalOwner;
        coalOwner = nullptr;
        passed += Test("join_arm_nulled_coalesce_value", coalJoin->id, 79);
        delete coalJoin;
        passed += Test("join_arm_nulled_coalesce_freed_once", dtorCount, 1);
    }

    // A join arm that is a LOCAL provably parked at null is NEUTRAL - it owns nothing, exactly as
    // the null literal owns nothing. These three legs are the accept half of that classification:
    // every one compiles and runs identically before and after it, and each would LEAK if the
    // neutral arm were allowed to make an unprovable join provable.
    // First: the other arm is a fresh `new`, which resolves to no binding at all, so the join still
    // proves nothing and `nullNewJoin` is the sole owner.
    dtorCount = 0;
    {
        Resource* parkedNullA = nullptr;
        Resource* nullNewJoin = parkedNullA ?? new Resource();
        nullNewJoin->id = 90;
        passed += Test("join_nullarm_new_value", nullNewJoin->id, 90);
        delete nullNewJoin;
        passed += Test("join_nullarm_new_freed_once", dtorCount, 1);
    }
    passed += Test("join_nullarm_new_no_second_free", dtorCount, 1);

    // Second: the PROVING arm is retired after the join, so the join holds the only reference and
    // the delete is the only release. The arm re-ask retires the fact exactly as it does for the
    // literal-arm spelling; rejecting here would leak.
    dtorCount = 0;
    {
        Resource* retiredArm = new Resource();
        retiredArm->id = 91;
        Resource* parkedNullB = nullptr;
        Resource* nullRetiredJoin = parkedNullB ?? retiredArm;
        retiredArm = nullptr;
        passed += Test("join_nullarm_retired_value", nullRetiredJoin->id, 91);
        delete nullRetiredJoin;
        passed += Test("join_nullarm_retired_freed_once", dtorCount, 1);
    }
    passed += Test("join_nullarm_retired_no_second_free", dtorCount, 1);

    // Third, and the POLARITY tripwire: an arm that is null on only SOME paths is NOT provably
    // null, so it still BLOCKS and the join proves nothing. Widening "provably null" to "we could
    // not tell" would make `borrowedOther` the sole prover and reject this delete - which is a
    // false rejection, because at runtime the join holds `condArm`'s object and nothing else frees
    // it. The sibling tripwire on the same polarity is join_owner_new_* above.
    dtorCount = 0;
    {
        Resource* condArm = nullptr;
        if (identityBool(true)) { condArm = new Resource(); condArm->id = 96; }
        Resource* borrowedOther = new Resource();
        borrowedOther->id = 97;
        Resource* condJoin = condArm ?? borrowedOther;
        condArm = nullptr;
        passed += Test("join_condnull_arm_blocks_value", condJoin->id, 96);
        delete condJoin;
        passed += Test("join_condnull_arm_blocks_freed_once", dtorCount, 1);
    }
    passed += Test("join_condnull_arm_blocks_freed_twice", dtorCount, 2);

    /*
     * The ACCEPT half of the join proof on the `move` spelling (its reject half is
     * jmJoin* in Test/errors/err_move.cb). `move` now asks the same BOTH-ARMS fact the raw
     * `delete` asks, so every shape that leaves the join the sole owner must still adopt - each of
     * these leaks if the guard fires, and each is measured identical before and after the change.
     */
    // Arm retired after the join: the fact retires with it, so the move is the real transfer.
    dtorCount = 0;
    {
        Resource* mjArmOwner = new Resource();
        mjArmOwner->id = 141;
        Resource* mjArmJoin = identityBool(true) ? mjArmOwner : mjArmOwner;
        mjArmOwner = nullptr;
        Resource* mjArmAdopted = move mjArmJoin;
        passed += Test("move_join_arm_nulled_value", mjArmAdopted->id, 141);
        delete mjArmAdopted;
        passed += Test("move_join_arm_nulled_freed_once", dtorCount, 1);
    }
    passed += Test("move_join_arm_nulled_no_second_free", dtorCount, 1);

    // Two fresh `new` arms resolve to no binding at all, so the join owns what it holds.
    dtorCount = 0;
    {
        Resource* mjNewJoin = identityBool(true) ? new Resource() : new Resource();
        mjNewJoin->id = 142;
        Resource* mjNewAdopted = move mjNewJoin;
        passed += Test("move_join_two_new_value", mjNewAdopted->id, 142);
        delete mjNewAdopted;
        passed += Test("move_join_two_new_freed_once", dtorCount, 1);
    }
    passed += Test("move_join_two_new_no_second_free", dtorCount, 1);

    // The MIXED join - one owning local, one fresh `new`. The BOTH-ARMS rule records nothing, so
    // the move adopts the `new` arm and the owning local is still released by its own delete.
    dtorCount = 0;
    {
        Resource* mjMixedOwner = new Resource();
        mjMixedOwner->id = 143;
        Resource* mjMixedJoin = identityBool(false) ? mjMixedOwner : new Resource();
        mjMixedJoin->id = 144;
        Resource* mjMixedAdopted = move mjMixedJoin;
        passed += Test("move_join_mixed_value", mjMixedAdopted->id, 144);
        delete mjMixedAdopted;
        passed += Test("move_join_mixed_freed_once", dtorCount, 1);
        delete mjMixedOwner;
        passed += Test("move_join_mixed_freed_twice", dtorCount, 2);
    }

    // A provably-null local arm is neutral and the other arm is a fresh `new`, so the join still
    // proves no other owner and the move must adopt.
    dtorCount = 0;
    {
        Resource* mjParkedNull = nullptr;
        Resource* mjNullArmJoin = mjParkedNull ?? new Resource();
        mjNullArmJoin->id = 145;
        Resource* mjNullArmAdopted = move mjNullArmJoin;
        passed += Test("move_join_nullarm_new_value", mjNullArmAdopted->id, 145);
        delete mjNullArmAdopted;
        passed += Test("move_join_nullarm_new_freed_once", dtorCount, 1);
    }
    passed += Test("move_join_nullarm_new_no_second_free", dtorCount, 1);

    // An arm null on only SOME paths is NOT provably null, so it blocks and the join proves
    // nothing - the same polarity tripwire join_condnull_arm_blocks_* holds for `delete`.
    dtorCount = 0;
    {
        Resource* mjCondArm = nullptr;
        if (identityBool(true)) { mjCondArm = new Resource(); mjCondArm->id = 146; }
        Resource* mjCondOther = new Resource();
        mjCondOther->id = 147;
        Resource* mjCondJoin = mjCondArm ?? mjCondOther;
        mjCondArm = nullptr;
        Resource* mjCondAdopted = move mjCondJoin;
        passed += Test("move_join_condnull_value", mjCondAdopted->id, 146);
        delete mjCondAdopted;
        passed += Test("move_join_condnull_freed_once", dtorCount, 1);
        delete mjCondOther;
        passed += Test("move_join_condnull_freed_twice", dtorCount, 2);
    }

    // A join arm consumed by a proven `move`. The move DETACHES its source at the join, so no
    // other binding frees the object and the join's own `delete` is the only release - rejecting
    // any of these three is a false rejection whose only remedy is to leak. The demotion is keyed
    // on the arm VALUE (the moved-out ledger), never on the source binding, which keeps its
    // IsOwning flag and would otherwise be blamed for freeing a pointer that is now null.
    dtorCount = 0;
    {
        Resource* parkedNullC = nullptr;
        Resource* moveSrcTern = new Resource();
        moveSrcTern->id = 98;
        Resource* moveTernJoin = identityBool(false) ? parkedNullC : move moveSrcTern;
        passed += Test("join_movearm_tern_value", moveTernJoin->id, 98);
        passed += Test("join_movearm_tern_source_nulled", moveSrcTern == nullptr ? 1 : 0, 1);
        delete moveTernJoin;
        passed += Test("join_movearm_tern_freed_once", dtorCount, 1);
    }
    passed += Test("join_movearm_tern_no_second_free", dtorCount, 1);

    dtorCount = 0;
    {
        Resource* parkedNullD = nullptr;
        Resource* moveSrcCoal = new Resource();
        moveSrcCoal->id = 99;
        Resource* moveCoalJoin = parkedNullD ?? move moveSrcCoal;
        passed += Test("join_movearm_coalesce_value", moveCoalJoin->id, 99);
        passed += Test("join_movearm_coalesce_source_nulled", moveSrcCoal == nullptr ? 1 : 0, 1);
        delete moveCoalJoin;
        passed += Test("join_movearm_coalesce_freed_once", dtorCount, 1);
    }
    passed += Test("join_movearm_coalesce_no_second_free", dtorCount, 1);

    // The BOXED spelling of the same move arm: the per-arm boxing ledger applies the identical
    // demotion, or the raw and boxed spellings disagree on a correct program.
    dtorCount = 0;
    {
        Sq7Move* parkedNullE = nullptr;
        Sq7Move* moveSrcBoxed = new Sq7Move();
        IShapeMove moveBoxJoin = parkedNullE ?? move moveSrcBoxed;
        passed += Test("join_movearm_boxed_value", moveBoxJoin.area(), 49);
        passed += Test("join_movearm_boxed_source_nulled", moveSrcBoxed == nullptr ? 1 : 0, 1);
        delete moveBoxJoin;
        passed += Test("join_movearm_boxed_freed_once", dtorCount, 1);
    }
    passed += Test("join_movearm_boxed_no_second_free", dtorCount, 1);

    // A join arm REBOUND to a fresh object rather than nulled: the join holds the original alone
    // and the arm owns the new one, so both deletes are correct and there are two distinct frees.
    dtorCount = 0;
    {
        Resource* reboundArm = new Resource();
        reboundArm->id = 80;
        Resource* joinRebound = identityBool(true) ? reboundArm : reboundArm;
        reboundArm = new Resource();
        reboundArm->id = 81;
        passed += Test("join_arm_rebound_join_value", joinRebound->id, 80);
        passed += Test("join_arm_rebound_arm_value", reboundArm->id, 81);
        delete joinRebound;
        delete reboundArm;
        passed += Test("join_arm_rebound_freed_twice", dtorCount, 2);
    }

    // The arm-nulled retirement reaching the OTHER two consumers: the `unique`-field store and
    // the store-recorded (assignment) form of the join. Both re-ask the same slots.
    dtorCount = 0;
    {
        MoveParamHolder hj = default;
        Resource* ufArm = new Resource();
        ufArm->id = 82;
        Resource* ufJoin = identityBool(true) ? ufArm : ufArm;
        ufArm = nullptr;
        hj.p = ufJoin;
        passed += Test("join_arm_nulled_uf_store_value", hj.p->id, 82);
        passed += Test("join_arm_nulled_uf_store_no_early_free", dtorCount, 0);
    }
    passed += Test("join_arm_nulled_uf_store_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        Resource* stArm = new Resource();
        stArm->id = 83;
        Resource* stJoin = nullptr;
        stJoin = identityBool(true) ? stArm : stArm;
        stArm = nullptr;
        passed += Test("join_arm_nulled_store_form_value", stJoin->id, 83);
        delete stJoin;
        passed += Test("join_arm_nulled_store_form_freed_once", dtorCount, 1);
    }

    // The plain `p = owner;` STORE (not a declaration) IMPLIED-MOVES the pointee out of `owner`,
    // so `delete p;` is the only release and must stay legal. This leg is the tripwire for the
    // false rejection an earlier cut of this fix produced by reading InheritedKeepsOwner - which
    // this store also sets - in the raw-delete guard; the join proof is a separate field for
    // exactly that reason.
    dtorCount = 0;
    {
        Resource* implSrc = new Resource();
        implSrc->id = 77;
        Resource* implDst = nullptr;
        implDst = implSrc;
        passed += Test("assign_copy_delete_value", implDst->id, 77);
        delete implDst;
        passed += Test("assign_copy_delete_freed_once", dtorCount, 1);
    }
    passed += Test("assign_copy_delete_no_second_free", dtorCount, 1);

    return passed;
}

int testUniqueGlobalReceiverFieldStore()
{
    int passed = 0;

    // A genuine self-assign on ONE global: one owner, value intact, nothing freed early.
    dtorCount = 0;
    gGH.slot = new Resource();
    gGH.slot->id = 81;
    gGH.slot = gGH.slot;
    passed += Test("ugr_self_value", gGH.slot->id, 81);
    passed += Test("ugr_self_no_early_free", dtorCount, 0);

    // The same self-assign through a NAMESPACE-qualified global and through a NESTED global
    // field - two more spellings of the empty-CallerName receiver.
    dtorCount = 0;
    GlobNS.gN.slot = new Resource();
    GlobNS.gN.slot->id = 82;
    GlobNS.gN.slot = GlobNS.gN.slot;
    passed += Test("ugr_ns_self_value", GlobNS.gN.slot->id, 82);
    passed += Test("ugr_ns_self_no_early_free", dtorCount, 0);

    dtorCount = 0;
    gGO.inner.slot = new Resource();
    gGO.inner.slot->id = 83;
    gGO.inner.slot = gGO.inner.slot;
    passed += Test("ugr_nested_self_value", gGO.inner.slot->id, 83);
    passed += Test("ugr_nested_self_no_early_free", dtorCount, 0);

    // The store-side half: an owning VALUE field copied between two DIFFERENT globals must
    // destruct the old destination exactly once and deep-copy, like the named-local spelling.
    gGB1.f.b = "aa" + "bb";
    gGB2.f.b = "cc" + "dd";
    elemBufDtor = 0;
    gGB1.f = gGB2.f;
    passed += Test("ugr_val_reassign_destructs_old", elemBufDtor, 1);
    passed += Test("ugr_val_reassign_dest", gGB1.f.b == "ccdd" ? 1 : 0, 1);
    passed += Test("ugr_val_reassign_src_alive", gGB2.f.b == "ccdd" ? 1 : 0, 1);
    // Independence, not just equal contents: overwriting the SOURCE after the copy must not
    // reach the destination. A shallow alias reads "eeff" on both sides here.
    gGB2.f.b = "ee" + "ff";
    passed += Test("ugr_val_copy_independent_dest", gGB1.f.b == "ccdd" ? 1 : 0, 1);
    passed += Test("ugr_val_copy_independent_src", gGB2.f.b == "eeff" ? 1 : 0, 1);

    // The same owning value assigned from ITSELF is one owner: no destruct, buffer intact.
    elemBufDtor = 0;
    gGB1.f = gGB1.f;
    passed += Test("ugr_val_self_no_destruct", elemBufDtor, 0);
    passed += Test("ugr_val_self_intact", gGB1.f.b == "ccdd" ? 1 : 0, 1);

    // A `string` field between two globals: the same store path with the stdlib owner.
    gGS1.s = "ee" + "ff";
    gGS2.s = "gg" + "hh";
    gGS1.s = gGS2.s;
    passed += Test("ugr_str_dest", gGS1.s == "gghh" ? 1 : 0, 1);
    passed += Test("ugr_str_src_alive", gGS2.s == "gghh" ? 1 : 0, 1);

    return passed;
}

/*
 * Array-ELEMENT receivers of a `unique` / owning field store. The reject added for
 * element-to-element copies must prove the two slots differ before firing, so every shape whose
 * indices are NOT provably different has to keep compiling AND keep its exact free count here.
 * Each leg asserts a value and a free COUNT: a widened reject shows up as a compile error, a
 * store that silently aliased shows up as a double count.
 */
int testUniqueArrayElementFieldStore()
{
    int passed = 0;

    // Runtime index, SAME index variable - a genuine self-assign the compiler cannot distinguish
    // from a two-element copy. Must stay a no-op: one owner, value intact, freed exactly once.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        int i = 0;
        arr[i].slot = new Resource();
        arr[i].slot->id = 61;
        arr[i].slot = arr[i].slot;
        passed += Test("uae_rt_self_value", arr[i].slot->id, 61);
        passed += Test("uae_rt_self_no_early_free", dtorCount, 0);
    }
    passed += Test("uae_rt_self_freed_once", dtorCount, 1);

    // Runtime index, DIFFERENT index variables holding the SAME value. Nothing is provable here,
    // so it must be ACCEPTED - rejecting it would take away a program that frees correctly.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        int i = 0;
        int j = 0;
        arr[i].slot = new Resource();
        arr[i].slot->id = 62;
        arr[i].slot = arr[j].slot;
        passed += Test("uae_rt_diff_value", arr[i].slot->id, 62);
        passed += Test("uae_rt_diff_no_early_free", dtorCount, 0);
    }
    passed += Test("uae_rt_diff_freed_once", dtorCount, 1);

    // CONSTANT index, SAME on both sides - provably the same slot, so a real self-assign and
    // still a no-op. This is the polarity control for the reject: same offset, no rejection.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        arr[0].slot = new Resource();
        arr[0].slot->id = 63;
        arr[0].slot = arr[0].slot;
        passed += Test("uae_const_self_value", arr[0].slot->id, 63);
        passed += Test("uae_const_self_no_early_free", dtorCount, 0);
    }
    passed += Test("uae_const_self_freed_once", dtorCount, 1);

    // The remedy the new element-to-element message names, spelled with the element index.
    // It transfers, nulls the source element, and the two pointees are freed exactly twice.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        arr[0].slot = new Resource();
        arr[0].slot->id = 64;
        arr[1].slot = new Resource();
        arr[1].slot->id = 65;
        arr[0].slot = move arr[1].slot;
        passed += Test("uae_move_remedy_value", arr[0].slot->id, 65);
        passed += Test("uae_move_remedy_source_nulled", arr[1].slot == nullptr ? 1 : 0, 1);
        passed += Test("uae_move_remedy_old_freed", dtorCount, 1);
    }
    passed += Test("uae_move_remedy_freed_twice", dtorCount, 2);

    // Assigning `new` directly into an element stays a plain adoption - two elements, two owners,
    // two frees. The reject must not reach a source that is not a field read at all.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        arr[0].slot = new Resource();
        arr[0].slot->id = 66;
        arr[1].slot = new Resource();
        arr[1].slot->id = 67;
        passed += Test("uae_new_into_elem_first", arr[0].slot->id, 66);
        passed += Test("uae_new_into_elem_second", arr[1].slot->id, 67);
        passed += Test("uae_new_into_elem_no_early_free", dtorCount, 0);
    }
    passed += Test("uae_new_into_elem_freed_twice", dtorCount, 2);

    // An element through a POINTER receiver, runtime index - the base is re-loaded per access, so
    // even with one index variable nothing is provable. Must be accepted and free exactly once.
    dtorCount = 0;
    {
        ElemOuter o = default;
        ElemOuter* p = &o;
        int i = 1;
        p->arr[i].slot = new Resource();
        p->arr[i].slot->id = 68;
        p->arr[i].slot = p->arr[i].slot;
        passed += Test("uae_ptr_rt_self_value", p->arr[i].slot->id, 68);
        passed += Test("uae_ptr_rt_self_no_early_free", dtorCount, 0);
    }
    passed += Test("uae_ptr_rt_self_freed_once", dtorCount, 1);

    // An owning field copied element-to-element must destruct the OLD destination and deep-copy,
    // exactly as the named-local spelling does. A plain `string` field cannot express that here -
    // its destructor is not observable in-language and the VALUES are identical either way, so a
    // string leg would pass on every binary. ElemBuf below is the same store with a counting
    // destructor, which is what actually discriminates; see uae_elem_reassign_destructs_old.

    /*
     * The reassignment-destruct leg. `sameField` is a SECOND copy of the same name comparison and
     * gates the destruct that frees the OLD destination value; with only the first copy fixed the
     * element store stopped aborting but silently leaked the old buffer, which no value leg can
     * see. ElemBuf has a hand-written copy() (so the store copies rather than being rejected) and
     * a counting destructor, so the destruct is observable in-language: exactly one per store.
     * The named-local spelling is asserted beside it as the reference answer.
     */
    {
        ElemBufHolder[2] a = default;
        a[0].f.b = "aa" + "bb";
        a[1].f.b = "cc" + "dd";
        elemBufDtor = 0;
        a[0].f = a[1].f;
        passed += Test("uae_elem_reassign_destructs_old", elemBufDtor, 1);
        passed += Test("uae_elem_reassign_dest", a[0].f.b == "ccdd" ? 1 : 0, 1);
        passed += Test("uae_elem_reassign_src_alive", a[1].f.b == "ccdd" ? 1 : 0, 1);
    }
    {
        ElemBufHolder x = default;
        ElemBufHolder y = default;
        x.f.b = "aa" + "bb";
        y.f.b = "cc" + "dd";
        elemBufDtor = 0;
        x.f = y.f;
        passed += Test("uae_local_reassign_destructs_old", elemBufDtor, 1);
    }
    // LIMIT (owning VALUE fields only): a receiver reached through a POINTER or an array VIEW
    // re-loads its base, so the storage cannot be proven initialized and the copy/destruct is NOT
    // emitted for it (doing so SIGSEGVs on a raw-malloc'd block). Those shapes keep the pre-fix
    // aliasing and cannot be asserted here - they abort at teardown. `unique` POINTER fields are
    // unaffected: their drop-old was never gated on that proof, so the implicit move below reaches
    // every receiver shape.

    return passed;
}

/*
 * RULED 2026-08-10: a plain `=` between two `unique` fields is a UNIFORM IMPLICIT MOVE - the
 * source field is nulled, the destination's old pointee is released, and NOTHING is rejected. Every
 * leg below was a COMPILE ERROR before the ruling landed except uim_rt_*, which compiled and
 * aborted at teardown (rc 134) because the two elements aliased one pointee. Each leg asserts the
 * RESOURCE, not just the value: the moved-in id, the nulled source, and the exact free count both
 * at the store and at scope exit, so an implementation that stores without releasing (leak) or
 * without nulling (double free) fails here.
 */
int testUniqueFieldImplicitMove()
{
    int passed = 0;

    // Two named locals - the original filed spelling.
    dtorCount = 0;
    {
        ElemHolder a = default;
        ElemHolder c = default;
        a.slot = new Resource(); a.slot->id = 91;
        c.slot = new Resource(); c.slot->id = 92;
        c.slot = a.slot;
        passed += Test("uim_named_value", c.slot->id, 91);
        passed += Test("uim_named_src_nulled", a.slot == nullptr ? 1 : 0, 1);
        passed += Test("uim_named_old_freed", dtorCount, 1);
    }
    passed += Test("uim_named_freed_twice", dtorCount, 2);

    // Two elements of ONE array, CONSTANT indices - the shape the reject used to prove apart.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        arr[0].slot = new Resource(); arr[0].slot->id = 93;
        arr[1].slot = new Resource(); arr[1].slot->id = 94;
        arr[0].slot = arr[1].slot;
        passed += Test("uim_const_value", arr[0].slot->id, 94);
        passed += Test("uim_const_src_nulled", arr[1].slot == nullptr ? 1 : 0, 1);
        passed += Test("uim_const_old_freed", dtorCount, 1);
    }
    passed += Test("uim_const_freed_twice", dtorCount, 2);

    // The same pair by RUNTIME index. This one COMPILED before the ruling and double-freed at
    // teardown (rc 134) - it is the leg that fails for a reason other than a compile error.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        int i = 0;
        int j = 1;
        arr[i].slot = new Resource(); arr[i].slot->id = 95;
        arr[j].slot = new Resource(); arr[j].slot->id = 96;
        arr[i].slot = arr[j].slot;
        passed += Test("uim_rt_value", arr[i].slot->id, 96);
        passed += Test("uim_rt_src_nulled", arr[j].slot == nullptr ? 1 : 0, 1);
        passed += Test("uim_rt_old_freed", dtorCount, 1);
    }
    passed += Test("uim_rt_freed_twice", dtorCount, 2);

    // NESTED arrays: the element chain is two array GEPs deep.
    dtorCount = 0;
    {
        ElemOuter[2] no = default;
        no[0].arr[0].slot = new Resource(); no[0].arr[0].slot->id = 97;
        no[0].arr[1].slot = new Resource(); no[0].arr[1].slot->id = 98;
        no[0].arr[0].slot = no[0].arr[1].slot;
        passed += Test("uim_nested_value", no[0].arr[0].slot->id, 98);
        passed += Test("uim_nested_src_nulled", no[0].arr[1].slot == nullptr ? 1 : 0, 1);
    }
    passed += Test("uim_nested_freed_twice", dtorCount, 2);

    // An array that is a FIELD of another struct.
    dtorCount = 0;
    {
        ElemOuter o = default;
        o.arr[0].slot = new Resource(); o.arr[0].slot->id = 99;
        o.arr[1].slot = new Resource(); o.arr[1].slot->id = 100;
        o.arr[0].slot = o.arr[1].slot;
        passed += Test("uim_fieldarr_value", o.arr[0].slot->id, 100);
        passed += Test("uim_fieldarr_src_nulled", o.arr[1].slot == nullptr ? 1 : 0, 1);
    }
    passed += Test("uim_fieldarr_freed_twice", dtorCount, 2);

    // A POINTER receiver. The drop-old reads the destination slot, which is exactly the shape the
    // owning-VALUE paths refuse to touch - a `unique` field is safe because every construction
    // path zero-initializes it, the same premise the synthesized destructor already relies on.
    dtorCount = 0;
    {
        ElemOuter o = default;
        ElemOuter* p = &o;
        p->arr[0].slot = new Resource(); p->arr[0].slot->id = 101;
        p->arr[1].slot = new Resource(); p->arr[1].slot->id = 102;
        p->arr[0].slot = p->arr[1].slot;
        passed += Test("uim_ptr_value", p->arr[0].slot->id, 102);
        passed += Test("uim_ptr_src_nulled", p->arr[1].slot == nullptr ? 1 : 0, 1);
    }
    passed += Test("uim_ptr_freed_twice", dtorCount, 2);

    // An array VIEW receiver - same re-loaded-base shape through 'T[]'.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        ElemHolder[] v = arr;
        v[0].slot = new Resource(); v[0].slot->id = 103;
        v[1].slot = new Resource(); v[1].slot->id = 104;
        v[0].slot = v[1].slot;
        passed += Test("uim_view_value", v[0].slot->id, 104);
        passed += Test("uim_view_src_nulled", v[1].slot == nullptr ? 1 : 0, 1);
    }
    passed += Test("uim_view_freed_twice", dtorCount, 2);

    // Two DISTINCT local arrays - the pair the distinct-roots proof used to reject.
    dtorCount = 0;
    {
        ElemHolder[2] a = default;
        ElemHolder[2] b = default;
        a[0].slot = new Resource(); a[0].slot->id = 105;
        b[0].slot = new Resource(); b[0].slot->id = 106;
        a[0].slot = b[0].slot;
        passed += Test("uim_twoarr_value", a[0].slot->id, 106);
        passed += Test("uim_twoarr_src_nulled", b[0].slot == nullptr ? 1 : 0, 1);
    }
    passed += Test("uim_twoarr_freed_twice", dtorCount, 2);

    // Two GLOBAL named receivers. A global's teardown is not observable here, so the free COUNT
    // asserted is the one the store itself performs on the old destination.
    dtorCount = 0;
    gGH2.slot = new Resource(); gGH2.slot->id = 107;
    gGH3.slot = new Resource(); gGH3.slot->id = 108;
    gGH2.slot = gGH3.slot;
    passed += Test("uim_global_value", gGH2.slot->id, 108);
    passed += Test("uim_global_src_nulled", gGH3.slot == nullptr ? 1 : 0, 1);
    passed += Test("uim_global_old_freed", dtorCount, 1);

    // GENERIC substitution: ownership comes from the `unique Resource*` type argument, never a
    // written `unique`. The old destination used to LEAK here even for the `move` spelling.
    dtorCount = 0;
    {
        MoveBox<unique Resource*> a = default;
        MoveBox<unique Resource*> c = default;
        a.t = new Resource(); a.t->id = 109;
        c.t = new Resource(); c.t->id = 110;
        c.t = a.t;
        passed += Test("uim_generic_value", c.t->id, 109);
        passed += Test("uim_generic_src_nulled", a.t == nullptr ? 1 : 0, 1);
        passed += Test("uim_generic_old_freed", dtorCount, 1);
    }
    passed += Test("uim_generic_freed_twice", dtorCount, 2);

    // Two boxed INTERFACE receivers of the same field. Neither side carries a caller name.
    dtorCount = 0;
    {
        UniqueIfaceBox a = default;
        UniqueIfaceBox c = default;
        a.item = new Resource(); a.item->id = 111;
        c.item = new Resource(); c.item->id = 112;
        IUniqueBox ia = a;
        IUniqueBox ic = c;
        ic.item = ia.item;
        passed += Test("uim_iface_value", ic.item->id, 111);
        passed += Test("uim_iface_src_nulled", ia.item == nullptr ? 1 : 0, 1);
        passed += Test("uim_iface_old_freed", dtorCount, 1);
    }
    passed += Test("uim_iface_freed_twice", dtorCount, 2);

    // The BRACE-INIT store path is a separate lowering, so it gets its own leg. The destination
    // slot is fresh (nothing to release), but the source must still be nulled.
    dtorCount = 0;
    {
        MoveBox<unique Resource*> a = default;
        a.t = new Resource(); a.t->id = 113;
        MoveBox<unique Resource*> c = { t = a.t };
        passed += Test("uim_brace_value", c.t->id, 113);
        passed += Test("uim_brace_src_nulled", a.t == nullptr ? 1 : 0, 1);
        passed += Test("uim_brace_no_early_free", dtorCount, 0);
    }
    passed += Test("uim_brace_freed_once", dtorCount, 1);

    // SELF-ASSIGN, every spelling: nulling the source before the drop-old is what makes these a
    // no-op, since no compile-time proof can rule out i==j for a runtime index.
    dtorCount = 0;
    {
        ElemHolder a = default;
        a.slot = new Resource(); a.slot->id = 114;
        a.slot = a.slot;
        passed += Test("uim_self_named_value", a.slot == nullptr ? -1 : a.slot->id, 114);
        passed += Test("uim_self_named_no_free", dtorCount, 0);
    }
    passed += Test("uim_self_named_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        int i = 0;
        int j = 0;
        arr[i].slot = new Resource(); arr[i].slot->id = 115;
        arr[i].slot = arr[j].slot;
        passed += Test("uim_self_rt_value", arr[i].slot == nullptr ? -1 : arr[i].slot->id, 115);
        passed += Test("uim_self_rt_no_free", dtorCount, 0);
    }
    passed += Test("uim_self_rt_freed_once", dtorCount, 1);

    // A FAT-INTERFACE owning field (`Box<unique IShapeMove>::t`) - the value is a {vtable,data}
    // struct, so the source is ZEROED rather than nulled and the old destination box is released
    // through the vtable's dtor slot. This field destination has no other drop-old anywhere (only
    // the interface LOCAL leg of D5 has one), so a store without it would leak.
    dtorCount = 0;
    {
        MoveBox<unique IShapeMove> a = default; a.t = new Sq7Move();
        MoveBox<unique IShapeMove> c = default; c.t = new CiMove();
        c.t = a.t;
        passed += Test("uim_ifacefield_dispatches", c.t.area(), 49);
        passed += Test("uim_ifacefield_old_freed", dtorCount, 1);
    }
    passed += Test("uim_ifacefield_freed_twice", dtorCount, 2);

    // The WRITTEN `unique IShapeMove` field spelling of the same store.
    dtorCount = 0;
    {
        WrittenIfaceMoveHolder a = default; a.s = new Sq7Move();
        WrittenIfaceMoveHolder c = default; c.s = new CiMove();
        c.s = a.s;
        passed += Test("uim_written_ifacefield_dispatches", c.s.area(), 49);
        passed += Test("uim_written_ifacefield_old_freed", dtorCount, 1);
    }
    passed += Test("uim_written_ifacefield_freed_twice", dtorCount, 2);

    // The BRACE form of the fat-interface field store: fresh destination, source still zeroed.
    dtorCount = 0;
    {
        MoveBox<unique IShapeMove> a = default; a.t = new Sq7Move();
        MoveBox<unique IShapeMove> c = { t = a.t };
        passed += Test("uim_ifacefield_brace_dispatches", c.t.area(), 49);
        passed += Test("uim_ifacefield_brace_no_early_free", dtorCount, 0);
    }
    passed += Test("uim_ifacefield_brace_freed_once", dtorCount, 1);

    // `move` keeps working and means exactly the same thing as the plain `=` above.
    dtorCount = 0;
    {
        ElemHolder[2] arr = default;
        arr[0].slot = new Resource(); arr[0].slot->id = 116;
        arr[1].slot = new Resource(); arr[1].slot->id = 117;
        arr[0].slot = move arr[1].slot;
        passed += Test("uim_move_value", arr[0].slot->id, 117);
        passed += Test("uim_move_src_nulled", arr[1].slot == nullptr ? 1 : 0, 1);
        passed += Test("uim_move_old_freed", dtorCount, 1);
    }
    passed += Test("uim_move_freed_twice", dtorCount, 2);

    // Two INTERFACE PARAMETER receivers, and the same store inside a LAMBDA body. Both aborted
    // (rc 134) before the ruling and neither is reachable from the boxed-local leg above: the
    // parameter shape resolves no box, and a lambda body is a separate emitted function.
    dtorCount = 0;
    {
        UniqueIfaceBox a = default;
        UniqueIfaceBox c = default;
        a.item = new Resource(); a.item->id = 118;
        c.item = new Resource(); c.item->id = 119;
        passed += Test("uim_iface_param_value", uimStealAcrossIfaceParams(a, c), 118);
        passed += Test("uim_iface_param_old_freed", dtorCount, 1);
    }
    passed += Test("uim_iface_param_freed_twice", dtorCount, 2);

    dtorCount = 0;
    {
        UniqueIfaceBox a = default;
        UniqueIfaceBox c = default;
        a.item = new Resource(); a.item->id = 120;
        c.item = new Resource(); c.item->id = 121;
        IUniqueBox ia = a;
        IUniqueBox ic = c;
        Lambda<void()> f = () => { ic.item = ia.item; };
        f();
        passed += Test("uim_iface_lambda_value", ic.item->id, 120);
        passed += Test("uim_iface_lambda_src_nulled", ia.item == nullptr ? 1 : 0, 1);
        passed += Test("uim_iface_lambda_old_freed", dtorCount, 1);
    }
    passed += Test("uim_iface_lambda_freed_twice", dtorCount, 2);

    return passed;
}

// A generic body's `unique T*` local with no initializer: the monomorphized copy runs the same
// declarator path, so it must be zeroed there too.
int uqiGenericMake<T>(int seed)
{
    unique T* p;
    p = new T();
    p->id = seed;
    return p->id;
}

/*
 * An owning pointer local declared with NO initializer (`unique T* p;` / `unique T*[N] a;`). The
 * slot used to be left uninitialized, so the next assignment's drop-old and the scope-exit release
 * both read garbage and called free() on it - rc 134 at --no-opt, and silently SKIPPED statements
 * once the optimizer folded the undef load, which is the face this suite sees. Every leg therefore
 * asserts a VALUE the skipped statements compute plus the destructor COUNT, so neither face can
 * pass. `unique T* p = nullptr;` was always correct; the fix makes the bare spelling emit the
 * identical IR.
 */
int testUninitializedUniqueLocalDecl()
{
    int passed = 0;

    // Scalar. The first assignment must free NOTHING (the slot is null now, not garbage); the
    // reassignment frees exactly the first value.
    dtorCount = 0;
    {
        unique Resource* p;
        p = new Resource();
        p->id = 71;
        passed += Test("uqi_scalar_first_value", p->id, 71);
        passed += Test("uqi_scalar_first_no_free", dtorCount, 0);
        p = new Resource();
        p->id = 72;
        passed += Test("uqi_scalar_reassign_value", p->id, 72);
        passed += Test("uqi_scalar_reassign_frees_old", dtorCount, 1);
    }
    passed += Test("uqi_scalar_freed_twice", dtorCount, 2);

    // `= nullptr` into the uninitialized slot is a no-op release, not a free of garbage.
    dtorCount = 0;
    {
        unique Resource* p;
        p = nullptr;
        passed += Test("uqi_null_assign_is_null", p == nullptr ? 1 : 0, 1);
        passed += Test("uqi_null_assign_no_free", dtorCount, 0);
    }
    passed += Test("uqi_null_assign_none_freed", dtorCount, 0);

    // `move` from another owner into the uninitialized slot: source nulled, one owner, one free.
    dtorCount = 0;
    {
        unique Resource* src = new Resource();
        src->id = 73;
        unique Resource* p;
        p = move src;
        passed += Test("uqi_move_value", p->id, 73);
        passed += Test("uqi_move_source_nulled", src == nullptr ? 1 : 0, 1);
        passed += Test("uqi_move_no_early_free", dtorCount, 0);
    }
    passed += Test("uqi_move_freed_once", dtorCount, 1);

    // `unique T*[N]`: every slot is zeroed, so the scope-exit walk frees the two that were
    // assigned and skips the untouched one instead of freeing garbage out of it.
    dtorCount = 0;
    {
        unique Resource*[3] arr;
        arr[0] = new Resource();
        arr[0]->id = 74;
        arr[2] = new Resource();
        arr[2]->id = 75;
        passed += Test("uqi_array_slot0_value", arr[0]->id, 74);
        passed += Test("uqi_array_slot2_value", arr[2]->id, 75);
        passed += Test("uqi_array_untouched_slot_null", arr[1] == nullptr ? 1 : 0, 1);
        passed += Test("uqi_array_no_early_free", dtorCount, 0);
    }
    passed += Test("uqi_array_freed_twice", dtorCount, 2);

    // Loop re-entry: the declaration is re-executed per iteration, so the slot is re-zeroed each
    // time - the previous iteration's value was already released at its own scope exit.
    dtorCount = 0;
    int loopTotal = 0;
    for (int i = 0; i < 3; i++)
    {
        unique Resource* p;
        p = new Resource();
        p->id = i + 1;
        loopTotal = loopTotal + p->id;
    }
    passed += Test("uqi_loop_total", loopTotal, 6);
    passed += Test("uqi_loop_freed_each_iteration", dtorCount, 3);

    // The generic instantiation reaches the same declarator path.
    passed += Test("uqi_generic_local_value", uqiGenericMake<Resource>(76), 76);

    return passed;
}

// The generic body's `unique <interface>` local with no initializer: the monomorphized copy runs
// the same declarator path, so its fat slot must be zeroed there too.
int uqiIfaceGenericMake<T>(int seed)
{
    unique IShapeMove p;
    p = new T();
    return p.area() + seed;
}

/*
 * The FAT INTERFACE VALUE sibling of testUninitializedUniqueLocalDecl. `unique IShapeMove p;` used
 * to leave the { vtable, data } pair uninitialized, so the next assignment's drop-old dispatched
 * the release through a garbage vtable - rc 139 at --no-opt, and silently SKIPPED statements at
 * default opt. Every leg asserts a VALUE the skipped statements compute plus the destructor COUNT,
 * so neither face can pass. The declaration's zero splat carries a witness tag, so the
 * never-initialised diagnostic still fires on the `unique` spelling (err_iface_field_missing.cb).
 */
int testUninitializedUniqueIfaceLocalDecl()
{
    int passed = 0;

    // Scalar. The first assignment frees NOTHING (the slot is null now, not garbage); the
    // reassignment frees exactly the first value.
    dtorCount = 0;
    {
        unique IShapeMove p;
        p = new Sq7Move();
        passed += Test("uqif_scalar_first_value", p.area(), 49);
        passed += Test("uqif_scalar_first_no_free", dtorCount, 0);
        p = new Sq7Move();
        passed += Test("uqif_scalar_reassign_value", p.area(), 49);
        passed += Test("uqif_scalar_reassign_frees_old", dtorCount, 1);
    }
    passed += Test("uqif_scalar_freed_twice", dtorCount, 2);

    // A NESTED block's declaration: same declarator path, its own scope-exit release.
    dtorCount = 0;
    int nested = 0;
    {
        {
            unique IShapeMove p;
            p = new Sq7Move();
            nested = p.area() + 1;
        }
        passed += Test("uqif_nested_freed_at_inner_exit", dtorCount, 1);
    }
    passed += Test("uqif_nested_value", nested, 50);

    // Two locals, one initialized at the declaration and one not: the bare one must not disturb
    // its neighbour's owner, and both are freed exactly once.
    dtorCount = 0;
    {
        unique IShapeMove a = new Sq7Move();
        unique IShapeMove b;
        b = new Sq7Move();
        passed += Test("uqif_pair_value", a.area() + b.area(), 98);
        passed += Test("uqif_pair_no_early_free", dtorCount, 0);
    }
    passed += Test("uqif_pair_freed_twice", dtorCount, 2);

    // `move` from another owner into the uninitialized slot: one owner, one free.
    dtorCount = 0;
    {
        unique IShapeMove src = new Sq7Move();
        unique IShapeMove p;
        p = move src;
        passed += Test("uqif_move_value", p.area(), 49);
        passed += Test("uqif_move_no_early_free", dtorCount, 0);
    }
    passed += Test("uqif_move_freed_once", dtorCount, 1);

    // `unique I[N]`: every slot is zeroed, so the scope-exit walk frees the one that was assigned
    // and skips the untouched one instead of releasing garbage through its vtable.
    dtorCount = 0;
    {
        unique IShapeMove[2] arr;
        arr[0] = new Sq7Move();
        passed += Test("uqif_array_slot0_value", arr[0].area(), 49);
        passed += Test("uqif_array_no_early_free", dtorCount, 0);
    }
    passed += Test("uqif_array_freed_once", dtorCount, 1);

    // Loop re-entry: the declaration re-zeroes the slot each iteration, and each iteration's value
    // is released at its own scope exit.
    dtorCount = 0;
    int loopTotal = 0;
    for (int i = 0; i < 3; i++)
    {
        unique IShapeMove p;
        p = new Sq7Move();
        loopTotal = loopTotal + p.area();
    }
    passed += Test("uqif_loop_total", loopTotal, 147);
    passed += Test("uqif_loop_freed_each_iteration", dtorCount, 3);

    // The generic instantiation reaches the same declarator path.
    dtorCount = 0;
    passed += Test("uqif_generic_local_value", uqiIfaceGenericMake<Sq7Move>(3), 52);
    passed += Test("uqif_generic_freed_once", dtorCount, 1);

    return passed;
}

/*
 * The shapes deliberately left LEGAL by the `unique` field-store rejects in
 * Test/errors/err_unique_borrow_into_field.cb. Each asserts a value and a free COUNT, so a
 * reject that widened too far shows up as a compile error and a store that silently aliased
 * shows up as a double count.
 */
int testUniqueFieldStoreRemedies()
{
    int passed = 0;

    // The remedy the TEMP-source message names: bind the whole call result to a local (which
    // gives the source field an address), then `move` the field out of that local. One owner.
    dtorCount = 0;
    {
        MoveBox<unique Resource*> tmp = makeMoveBox();
        MoveBox<unique Resource*> c = default;
        c.t = move tmp.t;
        passed += Test("uniq_temp_remedy_value", c.t->id, 44);
        passed += Test("uniq_temp_remedy_source_nulled", tmp.t == nullptr ? 1 : 0, 1);
        passed += Test("uniq_temp_remedy_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_temp_remedy_freed_once", dtorCount, 1);

    // The remedy the FAT-INTERFACE message names: `new`, giving the destination its own boxed
    // object. Dispatches to a non-default value and is freed exactly once.
    dtorCount = 0;
    {
        MoveBox<unique IShapeMove> bi = default;
        bi.t = new Sq7Move();
        passed += Test("uniq_generic_iface_new_dispatches", bi.t.area(), 49);
        passed += Test("uniq_generic_iface_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_generic_iface_new_freed_once", dtorCount, 1);

    // Same remedy through the WRITTEN `unique IShapeMove` field spelling and the BRACE-INIT
    // store path - the shape whose message used to name 'move' and a "pointer". Dispatches to a
    // non-default value and frees exactly once.
    dtorCount = 0;
    {
        WrittenIfaceSlot w = { s = new Sq7Move() };
        passed += Test("uniq_written_iface_new_dispatches", w.s.area(), 49);
        passed += Test("uniq_written_iface_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_written_iface_new_freed_once", dtorCount, 1);

    // `move` between two generic `unique T*` FIELDS stays legal and single-owner - the reject
    // added for the temp source must not widen onto an addressable field source.
    dtorCount = 0;
    {
        MoveBox<unique Resource*> a = default;
        a.t = new Resource();
        a.t->id = 43;
        MoveBox<unique Resource*> c = default;
        c.t = move a.t;
        passed += Test("uniq_generic_ptr_move_value", c.t->id, 43);
        passed += Test("uniq_generic_ptr_move_source_nulled", a.t == nullptr ? 1 : 0, 1);
    }
    passed += Test("uniq_generic_ptr_move_freed_once", dtorCount, 1);

    // A boxed interface receiver assigning its own unique field to itself is ONE owner: the
    // store is a no-op, the pointee stays readable, and it is freed exactly once. (The
    // TWO-receiver form is rejected - Test/errors/err_unique_field_to_field.cb.)
    dtorCount = 0;
    {
        UniqueIfaceBox s = default;
        s.item = new Resource();
        s.item->id = 41;
        IUniqueBox isf = s;
        isf.item = isf.item;
        passed += Test("uniq_iface_selfassign_value", isf.item->id, 41);
        passed += Test("uniq_iface_selfassign_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_iface_selfassign_freed_once", dtorCount, 1);

    // `move` between two DIFFERENT boxed receivers' unique interface fields transfers and nulls
    // the source, so the one pointee is still freed exactly once.
    dtorCount = 0;
    {
        UniqueIfaceBox a = default;
        a.item = new Resource();
        a.item->id = 42;
        UniqueIfaceBox c = default;
        IUniqueBox ia = a;  IUniqueBox ic = c;
        ic.item = move ia.item;
        passed += Test("uniq_iface_move_dest_value", ic.item->id, 42);
        passed += Test("uniq_iface_move_source_nulled", ia.item == nullptr ? 1 : 0, 1);
        passed += Test("uniq_iface_move_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_iface_move_freed_once", dtorCount, 1);

    /*
     * The accept set the two-receiver reject must not swallow. Receiver identity is proved from
     * the BOXED OBJECT, never from a name or from the interface local's own storage: two boxes of
     * ONE object are two distinct allocas holding one data pointer, so the copy is a self-assign
     * and the pointee is freed exactly once. A name comparison rejected both of these.
     */
    dtorCount = 0;
    {
        UniqueIfaceBox s = default;
        s.item = new Resource();
        s.item->id = 44;
        IUniqueBox ia = s;
        IUniqueBox ib = s;
        ib.item = ia.item;
        passed += Test("uniq_iface_twobox_value", ib.item->id, 44);
        passed += Test("uniq_iface_twobox_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_iface_twobox_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        UniqueIfaceBox s = default;
        s.item = new Resource();
        s.item->id = 45;
        IUniqueBox ia = s;
        alias IUniqueBox ib = ia;
        ib.item = ia.item;
        passed += Test("uniq_iface_alias_value", ib.item->id, 45);
        passed += Test("uniq_iface_alias_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_iface_alias_freed_once", dtorCount, 1);

    /*
     * A receiver REBOUND after the store. On the second trip `ia` and `ic` box one object, so the
     * copy is a legal self-assign - which is only knowable once the whole body is lowered, and is
     * why the verdict is deferred to the end of the body rather than taken at the store.
     */
    dtorCount = 0;
    {
        UniqueIfaceBox a = default;
        a.item = new Resource();
        a.item->id = 46;
        UniqueIfaceBox c = default;
        c.item = new Resource();
        c.item->id = 47;
        IUniqueBox ia = a;
        IUniqueBox ic = c;
        for (int k = 0; k < 2; k = k + 1)
        {
            if (k > 0) { ic.item = ia.item; }
            ia = ic;
        }
        passed += Test("uniq_iface_rebound_value", ic.item->id, 47);
        passed += Test("uniq_iface_rebound_no_early_free", dtorCount, 0);
    }
    passed += Test("uniq_iface_rebound_freed_twice", dtorCount, 2);

    return passed;
}

// A dtor-LESS pointee in a generic `unique` slot - the shape the temp-escape gate is written
// for (Test/errors/err_unique_borrow_into_field.cb rejects the persisting spellings). None of
// the legs below persist the field past its statement, so every one must keep compiling and
// reading live memory. `PodItem` has no destructor, so dtorCount cannot speak for it; the
// observable resource assertion for the family is the `Resource` leg at the end plus this
// file's `leaks --atExit` allocation count.
struct PodItem { int id = 0; };

MoveBox<unique PodItem*> makePodBox()
{
    MoveBox<unique PodItem*> b = default;
    b.t = new PodItem();
    b.t->id = 61;
    return b;
}

// An owning temp carrying a BORROWING pointer field alongside its owning one. Reading the
// borrow out is legal - the temp's synthesized destructor never frees that field.
struct PodPair { unique PodItem* own = nullptr; PodItem* borrow = nullptr; };

PodItem* podKeeper = nullptr;

PodPair makePodPair()
{
    PodPair p = default;
    p.own = new PodItem();
    p.borrow = podKeeper;
    return p;
}

// Helpers for the accept set below. `readResourceId` is the read-only plain-`T*` parameter the
// call-site reject deliberately leaves alone; the two sinks state the ownership claim it reads.
int readResourceId(Resource* r) { return r->id; }
// An OWNING call result for the '??' fallback arm: the arm flush must keep the value it yields.
unique Resource* makeArmOwnedResource() { Resource* r = new Resource(); r->id = 52; return r; }
void sinkResourceUnique(unique Resource* r) { }
void sinkResourceMove(move Resource* r) { delete r; }

// Callee shapes the PLAIN-`T*` guard must NOT reject. ParameterProvablyRetainsArgument answers
// "no proof" for every one of them, which is the unknown-accepts polarity the guard is built on:
// a forwarding read, a store that lands only in a LOCAL, recursion (the walk's cycle guard),
// a vararg callee (no named parameter to judge), and a plain `return n`, which does not by
// itself outlive the call. `keepResourceGlobal` DOES store and is the polarity twin - it stays
// legal for an ordinary heap pointer, proving the guard reads the temp ledger and not the
// callee fact alone.
struct ResourceSlot { Resource* p = nullptr; };
Resource* gKeptResource = nullptr;
int forwardReadResourceId(Resource* r) { return readResourceId(r); }
int storeIntoLocalThenRead(Resource* r) { ResourceSlot s = default; s.p = r; return s.p->id; }
int recursiveReadResourceId(Resource* r, int d) { if (d > 0) { return recursiveReadResourceId(r, d - 1); } return r->id; }
void printResourcePointer(Resource* r) { snprintf(nullptr, 0, "%p", r); }
Resource* passthruResource(Resource* r) { return r; }
void keepResourceGlobal(Resource* r) { gKeptResource = r; }
// The ACCEPT twins of the joined-destination rule. A store through `c ? &a : &b` is proof only
// when EVERY arm outlives the call, so one local arm - or two - must keep compiling.
struct ResourceCell { Resource* v = nullptr; };
Resource* gKeptResource2 = nullptr;
int selLocalArmRead(Resource* r, int c)
{
    Resource* loc = nullptr;
    Resource** p = c > 0 ? &loc : &gKeptResource2;
    *p = r;
    return r->id;
}
int selBothLocalArmsRead(Resource* r, int c)
{
    Resource* a = nullptr;
    Resource* b = nullptr;
    Resource** p = c > 0 ? &a : &b;
    *p = r;
    return r->id;
}
int selFreshArmRead(Resource* r, int c)
{
    ResourceCell* fresh = new ResourceCell();
    Resource** p = c > 0 ? &fresh->v : &gKeptResource2;
    *p = r;
    int seen = r->id;
    delete fresh;
    return seen;
}
// The ACCEPT twins of the MAY-return walk. `passthruResource` above answers YES and re-ledgers
// its result; these three answer NO, so their results stay bindable to a local. Each is a shape
// the walk must NOT confuse with a passthru: another parameter, a global, a fresh allocation.
Resource* retOtherResource(Resource* a, Resource* b) { return b; }
Resource* retGlobalResource(Resource* r) { return gKeptResource; }
move Resource* retFreshResource(Resource* r) { Resource* f = new Resource(); f->id = 77; return f; }
// A join in RETURN position: the arm's temp must still be live when readResourceId reads it.
int returnJoinResourceId(int c) { Resource* nul = nullptr; return readResourceId(c > 0 ? makeMoveBox().t : nul); }
// A USER destructor that dereferences its owning field with no null check: a hoisted arm temp is
// destructed on the untaken path too, so zeroing the record alone would crash here.
int joinUserDtorCount = 0;
int joinUserDtorSaw = 0;
struct JoinUserBox
{
    unique Resource* t = nullptr;
    ~JoinUserBox() { joinUserDtorCount = joinUserDtorCount + 1; joinUserDtorSaw = joinUserDtorSaw + t->id; }
};
JoinUserBox makeJoinUserBox() { JoinUserBox b = default; b.t = new Resource(); b.t->id = 44; return b; }
void ownResourceGlobal(move Resource* r) { gKeptResource = r; }

// INTERFACE DISPATCH accept set. The virtual slot has no single callee, so it is judged against
// EVERY implementor: the store diagnostic needs ALL of them to store, and one implementor that
// only reads makes it false on that dispatch. These three are the accepts that pins that down.
interface IResourceRead { int ifaceLookRead(Resource* r); };
class ResourceReaderC : IResourceRead { int ifaceLookRead(Resource* r) { return r->id; } };
// Two implementors, one STORES and one only reads - the polarity cell. MixedStoreC is never
// instantiated on purpose: being a registered implementor is what makes the slot ambiguous.
interface IResourceMixed { int ifaceLookMixed(Resource* r); };
class MixedStoreC : IResourceMixed { Resource* p = nullptr; int ifaceLookMixed(Resource* r) { this.p = r; return r->id; } };
class MixedReadC : IResourceMixed { int ifaceLookMixed(Resource* r) { return r->id; } };
// Return side: the sole implementor hands back something OTHER than its argument, so the result
// is not the temp's field and the laundering re-ledger must not fire.
interface IResourceRet { Resource* ifacePick(Resource* r); };
class RetGlobalC : IResourceRet { Resource* ifacePick(Resource* r) { return gKeptResource; } };

// The RECEIVER shape: `makeSelfBox().t->m()`. A method whose body only READS `this` must keep
// working off a temp's unique field, and a method that DOES store `this` must keep working off
// a BORROWED container element, where nothing is freed at end of statement. The storing
// spelling off a temp is the reject leg in Test/errors/err_unique_borrow_into_field.cb.
SelfResource* gSelfResource = nullptr;
struct SelfResource
{
    int id = 0;
    ~SelfResource() { dtorCount = dtorCount + 1; }
    int readId() { return this.id; }
    void parkSelf() { gSelfResource = this; }
};
MoveBox<unique SelfResource*> makeSelfBox()
{
    MoveBox<unique SelfResource*> b = default;
    b.t = new SelfResource();
    b.t->id = 45;
    return b;
}

int testTempUniqueFieldBorrowAccepts()
{
    int passed = 0;

    // Reading THROUGH the temp's unique field does not outlive the statement: still legal.
    int v0 = makePodBox().t->id;
    passed += Test("temp_uniq_field_read_value", v0, 61);

    // The remedy the reject names: bind the whole call result to a local, then read the field
    // off that local. The local owns the box, so the pointee outlives the statement legally.
    {
        MoveBox<unique PodItem*> b = makePodBox();
        passed += Test("temp_uniq_field_bound_local_value", b.t->id, 61);
        PodItem* p = b.t;
        passed += Test("temp_uniq_field_local_borrow_value", p->id, 61);
    }

    // A BORROWED element (`l.get(0).t`, an `alias` return) leaves OwningTempParent clear:
    // nothing is freed at the end of this statement, the LIST still owns the pointee, and
    // binding it to a local is legal. This is the polarity leg - a gate keyed on
    // FromOwningTempField alone (which is set here too) would false-reject it.
    {
        list<MoveBox<unique PodItem*>> l;
        MoveBox<unique PodItem*> b = default;
        b.t = new PodItem();
        b.t->id = 62;
        l.add(move b);
        PodItem* e = l.get(0).t;
        passed += Test("temp_uniq_borrowed_elem_value", e->id, 62);
        passed += Test("temp_uniq_borrowed_elem_live", l.get(0).t->id, 62);
    }

    // A NON-unique pointer field of an owning temp: the temp's destructor does not free it, so
    // binding it to a local is legal even though the read carries the temp provenance.
    podKeeper = new PodItem();
    podKeeper->id = 63;
    {
        PodItem* borrowed = makePodPair().borrow;
        passed += Test("temp_plain_field_borrow_value", borrowed->id, 63);
    }
    delete podKeeper;
    podKeeper = nullptr;

    // The same read shape with a dtor-BEARING pointee, so the free is observable: the read is
    // legal, sees the live value, and the temp frees its pointee exactly once at the end of
    // the statement - no early free before the read, nothing left over after.
    dtorCount = 0;
    int seen = makeMoveBox().t->id;
    passed += Test("temp_uniq_field_read_resource_value", seen, 44);
    passed += Test("temp_uniq_field_read_freed_once", dtorCount, 1);

    // ------------------------------------------------------------------------------------
    // THE ACCEPT SET for the cast / join / array-aggregate / sink-parameter rejects. Each
    // cell below is a program the pre-fix binary compiles and runs correctly, frozen here
    // BEFORE those guards were written; all are byte-identical on both binaries.

    // A cast off an ORDINARY pointer carries no temp provenance and is never ledgered - the
    // ledger is keyed on the READ, so only a read off an owning temp can enter it.
    {
        PodItem* n = new PodItem();
        n->id = 71;
        PodPair castHolder = default;
        castHolder.borrow = (PodItem*)n;
        PodItem*[2] castArr = { (PodItem*)n, nullptr };
        passed += Test("temp_uniq_accept_cast_plain_field", castHolder.borrow->id, 71);
        passed += Test("temp_uniq_accept_cast_array_elem", castArr[0]->id, 71);
        delete n;
    }

    // A cast and a join off a BORROWED element's unique field. OwningTempParent is clear (the
    // LIST owns the pointee, nothing is freed at end of statement), so the read is never
    // ledgered and both spellings stay legal. This is the polarity leg for the new sites: a
    // ledger keyed on FromOwningTempField alone would false-reject every cell here.
    {
        list<MoveBox<unique PodItem*>> l;
        MoveBox<unique PodItem*> b = default;
        b.t = new PodItem();
        b.t->id = 72;
        l.add(move b);
        PodItem* castElem = (PodItem*)l.get(0).t;
        PodItem* joinElem = l.get(0).t ?? nullptr;
        passed += Test("temp_uniq_accept_cast_borrowed_elem", castElem->id, 72);
        passed += Test("temp_uniq_accept_join_borrowed_elem", joinElem->id, 72);
    }

    // Joins of two ORDINARY reads, and a cast over such a join. Neither arm was ever ledgered,
    // so the arm walk answers no - the walk must not treat "is a join" as evidence by itself.
    {
        PodItem* p1 = new PodItem(); p1->id = 73;
        PodItem* p2 = new PodItem(); p2->id = 74;
        int c = 1;
        PodItem* jt = c > 0 ? p1 : p2;
        PodItem* jc = p1 ?? p2;
        PodItem* jx = (PodItem*)(c > 0 ? p1 : p2);
        PodItem*[2] joinArr = { jt, p2 };
        passed += Test("temp_uniq_accept_ternary_plain", jt->id, 73);
        passed += Test("temp_uniq_accept_coalesce_plain", jc->id, 73);
        passed += Test("temp_uniq_accept_cast_of_plain_join", jx->id, 73);
        passed += Test("temp_uniq_accept_join_into_array", joinArr[1]->id, 74);
        delete p1;
        delete p2;
    }

    // The DECLARED REMAINDER, and the reason the call-site reject is restricted to `unique` /
    // `move` parameters: a plain `T*` parameter that only READS must keep working. The value is
    // consumed inside the statement, before the temp's destructor runs at its end - so this is
    // correct code, not a tolerated hole, and the dtor count proves the free still happens once.
    dtorCount = 0;
    passed += Test("temp_uniq_accept_plain_param_read", readResourceId(makeMoveBox().t), 44);
    passed += Test("temp_uniq_accept_plain_param_freed_once", dtorCount, 1);
    dtorCount = 0;
    passed += Test("temp_uniq_accept_plain_param_cast_read",
                   readResourceId((Resource*)makeMoveBox().t), 44);
    passed += Test("temp_uniq_accept_plain_param_cast_freed_once", dtorCount, 1);

    // INTERFACE DISPATCH, the closed-world twin of the plain-parameter accept above. The sole
    // implementor only READS, so nothing outlives the call and the temp is still freed once.
    dtorCount = 0;
    ResourceReaderC ifaceRd = default;
    IResourceRead ifaceRdI = ifaceRd;
    passed += Test("temp_uniq_accept_iface_read", ifaceRdI.ifaceLookRead(makeMoveBox().t), 44);
    passed += Test("temp_uniq_accept_iface_read_freed_once", dtorCount, 1);

    // The POLARITY cell: two implementors, one stores and one only reads. With a non-storing
    // implementor dispatchable, "the callee stores this pointer" is false, so the site is
    // ACCEPTED - the storing-only twin of this shape is the reject leg in the errors file.
    dtorCount = 0;
    MixedReadC ifaceMx = default;
    IResourceMixed ifaceMxI = ifaceMx;
    passed += Test("temp_uniq_accept_iface_mixed_implementors",
                   ifaceMxI.ifaceLookMixed(makeMoveBox().t), 44);
    passed += Test("temp_uniq_accept_iface_mixed_freed_once", dtorCount, 1);

    // Return side: the sole implementor returns a DIFFERENT pointer, so the result is not the
    // temp's field - binding it to a local stays legal and the temp is freed once.
    dtorCount = 0;
    gKeptResource = nullptr;
    RetGlobalC ifaceRet = default;
    IResourceRet ifaceRetI = ifaceRet;
    Resource* ifacePicked = ifaceRetI.ifacePick(makeMoveBox().t);
    passed += Test("temp_uniq_accept_iface_return_other", ifacePicked == nullptr ? 1 : 0, 1);
    passed += Test("temp_uniq_accept_iface_return_other_freed_once", dtorCount, 1);

    // FLIPPED by the '??' fallback-arm fix. The old pair here pinned `dtors == 0` on
    // `nul ?? makeMoveBox().t` - a deliberate tripwire on a LEAK: that arm got no per-arm
    // FlushOwnedTempsSince, so its temp was never destructed and the arm walk had to exclude it
    // to avoid a false rejection. The arm now flushes like a '?:' arm, so that store shape
    // dangles and is REJECTED - it moved to Test/errors/err_coalesce_fallback_arm_escape.cb.
    // The legs below are what stays legal, with the dtor counts the flush now produces.

    // The temp is CONSUMED inside the arm (the deref happens before the arm flush), so the value
    // is right and the temp is destructed exactly once. Pre-fix this measured dtors == 0.
    dtorCount = 0;
    {
        Resource* nul = nullptr;
        int got = nul?.id ?? makeMoveBox().t->id;
        passed += Test("coalesce_fallback_arm_consumed_value", got, 44);
        passed += Test("coalesce_fallback_arm_freed_once", dtorCount, 1);
    }

    // The arm is NOT taken: the flush lives inside `nullcoal_null`, so an unexecuted fallback
    // must free nothing. This is the polarity twin of the leg above.
    dtorCount = 0;
    {
        Resource* live = new Resource();
        live->id = 51;
        int got = live?.id ?? makeMoveBox().t->id;
        passed += Test("coalesce_fallback_arm_untaken_value", got, 51);
        passed += Test("coalesce_fallback_arm_untaken_no_free", dtorCount, 0);
        delete live;
    }

    // ACCEPT-SET freeze: an owning call result handed out of the fallback arm compiles and runs
    // correctly on both binaries and must stay that way - the arm flush passes it as `keep`, and
    // the value plus the single dtor prove the join yields a live pointee the caller frees once.
    dtorCount = 0;
    {
        Resource* nul = nullptr;
        Resource* kept = nul ?? makeArmOwnedResource();
        passed += Test("coalesce_fallback_arm_kept_result_live", kept->id, 52);
        passed += Test("coalesce_fallback_arm_kept_result_not_freed_in_arm", dtorCount, 0);
        delete kept;
        passed += Test("coalesce_fallback_arm_kept_result_freed_once", dtorCount, 1);
    }

    // The same root cause in the SHORT-CIRCUIT blocks: `falseOR` / `trueAND` do not dominate the
    // resume block either, so an owning temp in a short-circuited operand used to leak
    // (both measured dtors == 0 pre-fix). The bool result borrows nothing, so the arm frees it.
    dtorCount = 0;
    {
        Resource* live = new Resource();
        bool anyOr = (live == nullptr) || (makeMoveBox().t != nullptr);
        passed += Test("shortcircuit_or_rhs_value", anyOr ? 1 : 0, 1);
        passed += Test("shortcircuit_or_rhs_temp_freed_once", dtorCount, 1);
        dtorCount = 0;
        bool bothAnd = (live != nullptr) && (makeMoveBox().t != nullptr);
        passed += Test("shortcircuit_and_rhs_value", bothAnd ? 1 : 0, 1);
        passed += Test("shortcircuit_and_rhs_temp_freed_once", dtorCount, 1);
        delete live;
    }

    // JOIN LIFETIME. The per-arm flush ran INSIDE the arm block, which is BEFORE the joined
    // value is consumed in the resume block, so every cell below read FREED memory on the
    // pre-fix binary (garbage, with dtorCount already 1 at the read - see the `--no-opt` IR in
    // the issue this replaced). An alloca-based struct temp is now zeroed at the branch and
    // destructed at the statement boundary, exactly like the direct spelling above.
    {
        int c = 1;
        Resource* nul = nullptr;

        dtorCount = 0;
        int jt = readResourceId(c > 0 ? makeMoveBox().t : nul);
        passed += Test("join_ternary_true_arm_value", jt, 44);
        passed += Test("join_ternary_true_arm_freed_once", dtorCount, 1);

        dtorCount = 0;
        int jf = readResourceId(c < 0 ? nul : makeMoveBox().t);
        passed += Test("join_ternary_false_arm_value", jf, 44);
        passed += Test("join_ternary_false_arm_freed_once", dtorCount, 1);

        dtorCount = 0;
        int jc = readResourceId(nul ?? makeMoveBox().t);
        passed += Test("join_coalesce_arm_value", jc, 44);
        passed += Test("join_coalesce_arm_freed_once", dtorCount, 1);

        // Laundered through a BORROWING callee - the shape the escape guards accept by design,
        // and the reason the guard could not be widened instead.
        dtorCount = 0;
        int jw = readResourceId(passthruResource(c > 0 ? makeMoveBox().t : nul));
        passed += Test("join_laundered_arm_value", jw, 44);
        passed += Test("join_laundered_arm_freed_once", dtorCount, 1);

        // BOTH arms owning: only the taken arm's record is non-zero, so the untaken one's
        // destructor must no-op - `1`, not `2`.
        dtorCount = 0;
        int jb = readResourceId(c > 0 ? makeMoveBox().t : makeMoveBox().t);
        passed += Test("join_both_arms_owning_value", jb, 44);
        passed += Test("join_both_arms_owning_freed_once", dtorCount, 1);

        // POLARITY (passes on both binaries by design): the arm is not taken, so the zeroed
        // record's destructor must free nothing. Every `_freed_once` leg above is likewise the
        // RESOURCE half of a discriminating value leg - it pins that moving the destructor later
        // neither doubled it nor dropped it.
        dtorCount = 0;
        {
            Resource* live = new Resource();
            live->id = 51;
            int ju = readResourceId(c < 0 ? makeMoveBox().t : live);
            passed += Test("join_arm_untaken_value", ju, 51);
            passed += Test("join_arm_untaken_no_free", dtorCount, 0);
            delete live;
        }

        // A LOOP runs the statement twice off ONE entry-block alloca: the zeroing has to happen
        // at the branch, per execution. Zeroing only at function entry would re-destruct
        // iteration 1's record on an untaken iteration 2 (the alternating leg is that probe).
        dtorCount = 0;
        {
            int sum = 0;
            for (int i = 0; i < 2; i = i + 1)
                sum = sum + readResourceId(c > 0 ? makeMoveBox().t : nul);
            passed += Test("join_in_loop_value", sum, 88);
            passed += Test("join_in_loop_freed_twice", dtorCount, 2);
        }
        dtorCount = 0;
        {
            Resource* live = new Resource();
            live->id = 7;
            int sum = 0;
            for (int i = 0; i < 2; i = i + 1)
                sum = sum + readResourceId(i == 0 ? makeMoveBox().t : live);
            passed += Test("join_loop_alternating_value", sum, 51);
            passed += Test("join_loop_alternating_freed_once", dtorCount, 1);
            delete live;
        }

        // NESTED joins: the inner hoist re-keys the temp into a block the OUTER join then
        // re-keys again, so the ledger entry has to survive both arm flushes.
        dtorCount = 0;
        int jn = readResourceId((nul ?? makeMoveBox().t) ?? nul);
        passed += Test("join_nested_coalesce_value", jn, 44);
        passed += Test("join_nested_coalesce_freed_once", dtorCount, 1);
        dtorCount = 0;
        int jn2 = readResourceId(c > 0 ? (nul ?? makeMoveBox().t) : nul);
        passed += Test("join_coalesce_in_ternary_value", jn2, 44);
        passed += Test("join_coalesce_in_ternary_freed_once", dtorCount, 1);

        // A join nested in a SHORT-CIRCUIT RHS: that block does not dominate the join either,
        // so its own flush must pick the hoisted temp up rather than leave it.
        dtorCount = 0;
        {
            Resource* live = new Resource();
            int jsv = 0;
            // Compares against 44, not `> 0`: a freed read is garbage of either sign.
            if ((live != nullptr) && (readResourceId(c > 0 ? makeMoveBox().t : nul) == 44)) { jsv = 1; }
            passed += Test("join_in_shortcircuit_rhs_value", jsv, 1);
            passed += Test("join_in_shortcircuit_rhs_freed_once", dtorCount, 1);
            delete live;
        }

        // A join in RETURN position, where the statement boundary is the return itself.
        dtorCount = 0;
        int jr = returnJoinResourceId(1);
        passed += Test("join_in_return_value", jr, 44);
        passed += Test("join_in_return_freed_once", dtorCount, 1);

        // USER DESTRUCTOR. A hoisted temp is destructed on the path the arm did NOT take, so a
        // zeroed record alone is not enough: `~JoinUserBox` dereferences its field with no null
        // check and SEGFAULTED. A liveness flag set in the arm is what gates the call.
        {
            Resource* live = new Resource();
            live->id = 9;
            joinUserDtorCount = 0; joinUserDtorSaw = 0;
            int ua = readResourceId(c < 0 ? makeJoinUserBox().t : live);
            passed += Test("join_user_dtor_untaken_value", ua, 9);
            passed += Test("join_user_dtor_untaken_not_run", joinUserDtorCount, 0);

            joinUserDtorCount = 0; joinUserDtorSaw = 0;
            int ub = readResourceId(live ?? makeJoinUserBox().t);
            passed += Test("join_user_dtor_coalesce_untaken_value", ub, 9);
            passed += Test("join_user_dtor_coalesce_untaken_not_run", joinUserDtorCount, 0);

            // Outer arm TAKEN, inner '??' fallback NOT taken: the re-hoist must not re-arm the flag.
            joinUserDtorCount = 0; joinUserDtorSaw = 0;
            int uc = readResourceId(c > 0 ? (live ?? makeJoinUserBox().t) : nul);
            passed += Test("join_user_dtor_nested_inner_untaken_value", uc, 9);
            passed += Test("join_user_dtor_nested_inner_untaken_not_run", joinUserDtorCount, 0);

            // Taken: the destructor runs exactly once, after the read, on a LIVE record.
            joinUserDtorCount = 0; joinUserDtorSaw = 0;
            int ud = readResourceId(c > 0 ? makeJoinUserBox().t : nul);
            passed += Test("join_user_dtor_taken_value", ud, 44);
            passed += Test("join_user_dtor_taken_ran_once", joinUserDtorCount, 1);
            passed += Test("join_user_dtor_taken_saw_live_field", joinUserDtorSaw, 44);
            delete live;
        }
    }

    // TRIPWIRE, same shape and still unfixed: the '?.' guarded chain is the third block that
    // registers owning temps without a flush. `dtors == 0` pins that LEAK on purpose - see
    // internal/issue/p2/owning-temp-in-null-conditional-arm-never-destructed.md.
    dtorCount = 0;
    {
        Resource* live = new Resource();
        int got = live?.readId(makeMoveBox().t->id);
        passed += Test("null_conditional_arm_temp_value", got, 44);
        passed += Test("null_conditional_arm_temp_not_freed", dtorCount, 0);
        delete live;
    }

    // A JOIN inside that same unflushed '?.' arm: the join hoists its temp to its own branch
    // block, which still sits inside the arm, so the value is now RIGHT (it was garbage
    // pre-fix) and the temp leaks instead - the p2 gap above, not a new one.
    dtorCount = 0;
    {
        int c = 1;
        Resource* nul = nullptr;
        Resource* live = new Resource();
        int got = live?.readId(readResourceId(c > 0 ? makeMoveBox().t : nul));
        passed += Test("null_conditional_join_arm_value", got, 44);
        passed += Test("null_conditional_join_arm_not_freed", dtorCount, 0);
        delete live;
    }

    // A `unique` / `move` SINK parameter fed a genuinely OWNED argument - a fresh allocation and
    // a moved-from local. The new call-site reject asks the ledger, not the parameter kind alone,
    // so these two must be untouched; the dtor counts prove the callee frees exactly once and
    // the caller does not double-free.
    dtorCount = 0;
    sinkResourceUnique(new Resource());
    passed += Test("temp_uniq_accept_sink_unique_new_freed_once", dtorCount, 1);
    dtorCount = 0;
    {
        Resource* owned = new Resource();
        owned->id = 75;
        sinkResourceMove(move owned);
    }
    passed += Test("temp_uniq_accept_sink_move_local_freed_once", dtorCount, 1);

    // The ACCEPT SET of the plain-`T*` callee-side guard, frozen before the guard was written.
    // Each cell is a callee the escape walk cannot PROVE stores, so each must keep compiling and
    // keep the same `dtors == 1` shape as the read-only cell above: value consumed inside the
    // statement, pointee freed exactly once at the end of it.
    dtorCount = 0;
    passed += Test("temp_uniq_accept_plain_param_forwarding_read",
                   forwardReadResourceId(makeMoveBox().t), 44);
    passed += Test("temp_uniq_accept_plain_param_forwarding_freed_once", dtorCount, 1);
    dtorCount = 0;
    passed += Test("temp_uniq_accept_plain_param_local_store",
                   storeIntoLocalThenRead(makeMoveBox().t), 44);
    passed += Test("temp_uniq_accept_plain_param_local_store_freed_once", dtorCount, 1);
    dtorCount = 0;
    passed += Test("temp_uniq_accept_plain_param_recursive_read",
                   recursiveReadResourceId(makeMoveBox().t, 2), 44);
    passed += Test("temp_uniq_accept_plain_param_recursive_freed_once", dtorCount, 1);
    dtorCount = 0;
    printResourcePointer(makeMoveBox().t);
    passed += Test("temp_uniq_accept_plain_param_vararg_freed_once", dtorCount, 1);
    // `return n` alone is not proof that the pointee outlives the call, so the passthru is
    // accepted and the whole chain is still consumed inside the statement.
    dtorCount = 0;
    passed += Test("temp_uniq_accept_plain_param_passthru_read",
                   readResourceId(passthruResource(makeMoveBox().t)), 44);
    passed += Test("temp_uniq_accept_plain_param_passthru_freed_once", dtorCount, 1);
    // Two launders deep, still consumed inside the statement: the outer call's argument is the
    // inner call's re-ledgered result, so the MAY-return walk runs twice and must still accept.
    dtorCount = 0;
    passed += Test("temp_uniq_accept_chained_passthru_read",
                   readResourceId(passthruResource(passthruResource(makeMoveBox().t))), 44);
    passed += Test("temp_uniq_accept_chained_passthru_freed_once", dtorCount, 1);
    // The result DISCARDED: nothing outlives the statement, so nothing is rejected.
    dtorCount = 0;
    passthruResource(makeMoveBox().t);
    passed += Test("temp_uniq_accept_passthru_discarded_freed_once", dtorCount, 1);

    // The ACCEPT SET of the DEFERRED return half (a laundering callee defined BELOW its call
    // site). The two callees are written at the bottom of this file, so at these call sites the
    // proof is unanswerable and the escape SITE is recorded for the end-of-module resolve. These
    // three cells must still resolve to ACCEPT there, exactly as their above-defined twins do
    // (temp_uniq_accept_plain_param_passthru_discarded_freed_once and the retGlobalResource legs).
    // A deferral that answered YES for any of them would false-reject a working program.
    dtorCount = 0;
    {
        Resource* lateOther = lateRetGlobalResource(makeMoveBox().t);
        passed += Test("temp_uniq_accept_late_callee_returns_other", lateOther == nullptr ? 1 : 0, 1);
    }
    passed += Test("temp_uniq_accept_late_callee_returns_other_freed_once", dtorCount, 1);
    // The below-defined PASSTHRU with the result discarded: the callee does hand the parameter
    // back, but nothing binds it, so there is no destination and nothing to reject.
    dtorCount = 0;
    latePassthruResource(makeMoveBox().t);
    passed += Test("temp_uniq_accept_late_passthru_discarded_freed_once", dtorCount, 1);
    // The below-defined passthru over an ORDINARY heap pointer: no temp field is involved at all,
    // so the deferred site must never be recorded and the pointee must survive the statement.
    dtorCount = 0;
    {
        Resource* plainLateSrc = new Resource();
        plainLateSrc->id = 84;
        Resource* plainLate = latePassthruResource(plainLateSrc);
        passed += Test("temp_uniq_accept_late_passthru_of_plain_ptr", plainLate->id, 84);
        passed += Test("temp_uniq_accept_late_passthru_of_plain_ptr_not_freed", dtorCount, 0);
        delete plainLateSrc;
    }
    passed += Test("temp_uniq_accept_late_passthru_of_plain_ptr_freed_once", dtorCount, 1);

    // The ACCEPT SET of the joined-destination rule, frozen before that rule was written. Each
    // callee stores through a select whose arms are NOT all outliving memory, so no proof.
    dtorCount = 0;
    passed += Test("temp_uniq_accept_join_dest_local_arm",
                   selLocalArmRead(makeMoveBox().t, 1), 44);
    passed += Test("temp_uniq_accept_join_dest_local_arm_freed_once", dtorCount, 1);
    dtorCount = 0;
    passed += Test("temp_uniq_accept_join_dest_both_local_arms",
                   selBothLocalArmsRead(makeMoveBox().t, 1), 44);
    passed += Test("temp_uniq_accept_join_dest_both_local_arms_freed_once", dtorCount, 1);
    dtorCount = 0;
    passed += Test("temp_uniq_accept_join_dest_fresh_arm",
                   selFreshArmRead(makeMoveBox().t, 1), 44);
    passed += Test("temp_uniq_accept_join_dest_fresh_arm_freed_once", dtorCount, 1);

    // The MAY-return walk's own accept set, frozen before the walk was written. Each callee below
    // is a shape whose RESULT does not derive from the temp-field argument, so binding it to a
    // local must stay legal - these are the false rejections the walk must not produce. The
    // temp's pointee is still freed exactly once at the end of its own statement (dtors == 1).
    {
        Resource* liveOther = new Resource();
        liveOther->id = 81;
        dtorCount = 0;
        Resource* retOther = retOtherResource(makeMoveBox().t, liveOther);
        passed += Test("temp_uniq_accept_ret_other_param", retOther->id, 81);
        passed += Test("temp_uniq_accept_ret_other_param_temp_freed", dtorCount, 1);
        delete liveOther;
    }
    {
        gKeptResource = new Resource();
        gKeptResource->id = 82;
        dtorCount = 0;
        Resource* retGlob = retGlobalResource(makeMoveBox().t);
        passed += Test("temp_uniq_accept_ret_global", retGlob->id, 82);
        passed += Test("temp_uniq_accept_ret_global_temp_freed", dtorCount, 1);
        delete gKeptResource;
        gKeptResource = nullptr;
    }
    {
        dtorCount = 0;
        unique Resource* retFresh = retFreshResource(makeMoveBox().t);
        passed += Test("temp_uniq_accept_ret_fresh_allocation", retFresh->id, 77);
        passed += Test("temp_uniq_accept_ret_fresh_temp_freed", dtorCount, 1);
    }
    // A passthru of an ORDINARY heap pointer and of a `unique` LOCAL: the callee answers YES to
    // the MAY-return walk in both, and both must still bind, because no temp was ever ledgered.
    {
        dtorCount = 0;
        Resource* plainSrc = new Resource();
        plainSrc->id = 83;
        Resource* plainThru = passthruResource(plainSrc);
        passed += Test("temp_uniq_accept_passthru_of_plain_ptr", plainThru->id, 83);
        passed += Test("temp_uniq_accept_passthru_of_plain_ptr_not_freed", dtorCount, 0);
        delete plainSrc;
    }
    {
        dtorCount = 0;
        {
            unique Resource* uniqSrc = new Resource();
            uniqSrc->id = 84;
            Resource* uniqThru = passthruResource(uniqSrc);
            passed += Test("temp_uniq_accept_passthru_of_unique_local", uniqThru->id, 84);
            passed += Test("temp_uniq_accept_passthru_of_unique_local_live", dtorCount, 0);
        }
        passed += Test("temp_uniq_accept_passthru_of_unique_local_freed_once", dtorCount, 1);
    }
    // The REMEDY the new laundering diagnostic names, measured: bind the whole call result to a
    // local, then pass the field read off that local. Both the passthru and the by-value
    // constructor spelling the reject legs pin must compile and read LIVE memory here.
    {
        dtorCount = 0;
        MoveBox<unique Resource*> boundTemp = makeMoveBox();
        Resource* fromLocal = passthruResource(boundTemp.t);
        passed += Test("temp_uniq_accept_launder_remedy_local", fromLocal->id, 44);
        passed += Test("temp_uniq_accept_launder_remedy_local_live", dtorCount, 0);
    }
    passed += Test("temp_uniq_accept_launder_remedy_local_freed_once", dtorCount, 1);
    // The POLARITY twin: the same STORING callee that the reject legs pin, fed an ordinary heap
    // pointer instead of a temp's unique field. Nothing is ledgered, so nothing is judged - and
    // the caller still owns the pointee, which is why dtorCount is 0 until the delete below.
    dtorCount = 0;
    {
        Resource* plain = new Resource();
        plain->id = 76;
        keepResourceGlobal(plain);
        passed += Test("temp_uniq_accept_plain_ptr_into_storing_callee", gKeptResource->id, 76);
        passed += Test("temp_uniq_accept_plain_ptr_into_storing_callee_not_freed", dtorCount, 0);
        gKeptResource = nullptr;
        delete plain;
    }
    passed += Test("temp_uniq_accept_plain_ptr_into_storing_callee_freed_once", dtorCount, 1);

    // BOTH remedies the reject's message names, measured - a rejection may only recommend
    // something that actually compiles. Binding the call result to a LOCAL makes the pointee
    // outlive the statement (dtors stays 0 while the borrow is live, 1 at scope exit); a `move`
    // parameter hands ownership over instead, so the local's scope exit frees nothing.
    dtorCount = 0;
    {
        MoveBox<unique Resource*> tmp = makeMoveBox();
        keepResourceGlobal(tmp.t);
        passed += Test("temp_uniq_remedy_local_borrow_live", gKeptResource->id, 44);
        passed += Test("temp_uniq_remedy_local_borrow_not_yet_freed", dtorCount, 0);
    }
    gKeptResource = nullptr;
    passed += Test("temp_uniq_remedy_local_borrow_freed_at_scope_exit", dtorCount, 1);
    dtorCount = 0;
    {
        MoveBox<unique Resource*> tmp = makeMoveBox();
        ownResourceGlobal(move tmp.t);
        passed += Test("temp_uniq_remedy_move_param_live", gKeptResource->id, 44);
    }
    passed += Test("temp_uniq_remedy_move_param_not_freed_at_scope_exit", dtorCount, 0);
    delete gKeptResource;
    gKeptResource = nullptr;
    passed += Test("temp_uniq_remedy_move_param_freed_once", dtorCount, 1);

    // RECEIVER accepts. A read-only method off a temp's unique field is consumed inside the
    // statement (freed once at the end of it); a STORING method off a BORROWED container
    // element is legal because the list owns the pointee and nothing is freed here.
    dtorCount = 0;
    passed += Test("temp_uniq_accept_receiver_read_only_method", makeSelfBox().t->readId(), 45);
    passed += Test("temp_uniq_accept_receiver_read_only_freed_once", dtorCount, 1);
    {
        list<MoveBox<unique SelfResource*>> sl;
        MoveBox<unique SelfResource*> sb = default;
        sb.t = new SelfResource();
        sb.t->id = 46;
        sl.add(move sb);
        dtorCount = 0;
        sl.get(0).t->parkSelf();
        passed += Test("temp_uniq_accept_receiver_borrowed_elem_store", gSelfResource->id, 46);
        passed += Test("temp_uniq_accept_receiver_borrowed_elem_not_freed", dtorCount, 0);
        gSelfResource = nullptr;
    }

    return passed;
}

int testDiscardMoveReturningCall()
{
    int passed = 0;

    discardDtorCount = 0;
    discardSeenValue = 0;
    _ = makeDiscardProbe();
    passed += Test("discard_move_ptr_freed_once", discardDtorCount, 1);
    passed += Test("discard_move_ptr_dtor_sees_field", discardSeenValue, 7);

    discardOwnerDtorCount = 0;
    discardOwnerNameOk = 0;
    _ = makeDiscardOwner();
    passed += Test("discard_move_owner_freed_once", discardOwnerDtorCount, 1);
    passed += Test("discard_move_owner_member_intact", discardOwnerNameOk, 1);

    // Two discards in a row: each call frees its OWN result, no cross-talk.
    discardDtorCount = 0;
    discardSeenValue = 0;
    _ = makeDiscardProbe();
    _ = makeDiscardProbe();
    passed += Test("discard_move_ptr_freed_each_time", discardDtorCount, 2);
    passed += Test("discard_move_ptr_field_still_right", discardSeenValue, 7);

    return passed;
}

// `move` of a BORROWED parameter transfers nothing: nulling the callee's copy leaves the CALLER
// the sole owner. Neither helper may adopt the join - the pointee is still the caller's, and
// freeing it here destroys a live object the caller frees again at its own scope exit.
int borrowedMoveJoinsNull(Resource* borrowed, bool c)
{
    Resource* b = nullptr;
    b = c ? move borrowed : nullptr;
    return b == nullptr ? -1 : b->id;
}

// The same borrowed move paired with a genuinely OWNING arm, which is the shape that used to
// abort: the borrow arm fails join-eligibility, so the join is mixed and the result borrows.
int borrowedMoveJoinsOwning(Resource* borrowed, bool c)
{
    Resource* v = c ? move borrowed : makeOwnedResource();
    return v->id;
}

// The borrowed-move join laundered through a NESTED '?:' into a PLAIN pointer. A plain pointer
// only ever borrows, so this stays legal - the rejection added for a `unique` receiver keys on
// the destination being an owning location, not on the join.
int borrowedMoveNestedJoinsNull(Resource* borrowed, bool c)
{
    Resource* b = nullptr;
    b = c ? (c ? move borrowed : nullptr) : nullptr;
    return b == nullptr ? -1 : b->id;
}

// A borrowed move paired with a LIVE BORROW arm is a MIXED join: which arm runs is not knowable,
// so it is not provably non-owning and keeps the existing silent-borrow behaviour even into a
// `unique` local. Nothing is adopted, so both callers' objects survive and each is freed once.
int borrowedMoveMixedJoinIntoUnique(Resource* borrowed, Resource* other, bool c)
{
    unique Resource* b = nullptr;
    b = c ? move borrowed : other;
    return b == nullptr ? -1 : b->id;
}

// The FIELD boundary of the same rule. The all-borrowed-move-or-null join into a `unique` field is
// now rejected (it aborted: the field freed the caller's live pointee), but this MIXED join is not
// in the ledger, so it still stores and the field owns the arm that actually ran.
void borrowedMoveMixedJoinIntoField(UniqueBox* box, Resource* borrowed, bool c)
{
    box->item = c ? move borrowed : makeOwnedResource();
}

// The BRACE-INIT store path (EmitOneFieldInit) is the third destination that rejects the laundered
// borrow, so its mixed-join spelling must stay accepted too - the two field paths run the same rule.
int borrowedMoveMixedBraceInit(Resource* borrowed, bool c)
{
    UniqueBox box = { item = c ? move borrowed : makeOwnedResource() };
    return box.item != nullptr ? 1 : 0;
}

// A ternary evaluates ONLY the selected arm. It used to compute both arms eagerly and combine
// them with LLVM's `select`, so a `move` or an owning call in the not-taken arm still ran.
int testTernaryArmsShortCircuit()
{
    int passed = 0;

    // False condition: the `move` arm never runs, so the source keeps its object and frees
    // it exactly once at scope exit.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 21;
        bool c = false;
        unique Resource* b = c ? move a : nullptr;
        passed += Test("ternary_untaken_move_source_intact", a == nullptr ? 1 : 0, 0);
        passed += Test("ternary_untaken_move_value_survives", a->id, 21);
        passed += Test("ternary_untaken_move_dest_null", b == nullptr ? 1 : 0, 1);
        passed += Test("ternary_untaken_move_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_untaken_move_freed_once", dtorCount, 1);

    // True condition: ownership transfers through the ternary, still exactly one free.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 22;
        bool c = true;
        unique Resource* b = c ? move a : nullptr;
        passed += Test("ternary_taken_move_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("ternary_taken_move_value_moved", b->id, 22);
    }
    passed += Test("ternary_taken_move_freed_once", dtorCount, 1);

    // An owning-returning CALL in the not-taken arm must never be invoked.
    dtorCount = 0;
    {
        bool c = false;
        unique Resource* a = c ? makeOwnedResource() : nullptr;
        passed += Test("ternary_untaken_owning_call_not_run", a == nullptr ? 1 : 0, 1);
    }
    passed += Test("ternary_untaken_owning_call_no_free", dtorCount, 0);

    // ... and when it IS taken the result is adopted and freed exactly once.
    dtorCount = 0;
    {
        bool c = true;
        unique Resource* a = c ? makeOwnedResource() : nullptr;
        a->id = 23;
        passed += Test("ternary_taken_owning_call_adopted", a->id, 23);
    }
    passed += Test("ternary_taken_owning_call_freed_once", dtorCount, 1);

    // A bare `new` in an arm is adopted by the unique local, freed once.
    dtorCount = 0;
    {
        bool c = true;
        unique Resource* a = c ? new Resource() : nullptr;
        passed += Test("ternary_new_arm_alive", a == nullptr ? 1 : 0, 0);
    }
    passed += Test("ternary_new_arm_freed_once", dtorCount, 1);

    // MIXED pointer join: one arm allocates, the other yields a LIVE borrow. The join owns
    // nothing the receiver may free (which arm ran is not knowable at the declaration), so the
    // local borrows - it used to adopt whichever arm the phi picked and double-free the owner's
    // pointee. The allocating arm leaks when selected; that is the accepted trade.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 31;
        bool takeOwning = false;
        Resource* mixed = takeOwning ? makeOwnedResource() : owner;
        passed += Test("ternary_mixed_join_borrow_value", mixed->id, 31);
        passed += Test("ternary_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_mixed_join_owner_freed_once", dtorCount, 1);

    // Same through a NESTED '?:' - the inner mixed join is suppressed, and the suppression must
    // survive the outer join instead of being overruled by the outer arm's `new`.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 32;
        bool outer = true;
        bool inner = false;
        Resource* mixed = outer ? (inner ? makeOwnedResource() : owner) : new Resource();
        passed += Test("ternary_nested_mixed_join_borrow_value", mixed->id, 32);
        passed += Test("ternary_nested_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_mixed_join_owner_freed_once", dtorCount, 1);

    // A mixed join whose BORROW arm merely CONTAINS a `new` in ARGUMENT position. That `new` does
    // not make the arm own its result, so the join stays mixed; scoring the arm owning turned the
    // borrow into a freeable temp and double-freed the real owner. The argument temp itself is a
    // non-retained allocation, freed at end-of-full-expression.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 33;
        bool c = true;
        Resource* joined = c ? borrowFirstResource(owner, new Resource()) : makeOwnedResource();
        passed += Test("ternary_mixed_join_arg_new_borrow_value", joined->id, 33);
        passed += Test("ternary_mixed_join_arg_new_temp_freed", dtorCount, 1);
    }
    passed += Test("ternary_mixed_join_arg_new_owner_freed_once", dtorCount, 2);

    // A PARENTHESIZED `move` arm. Arm ownership is answered by value identity, so a wrapper around
    // the move cannot turn it into a borrow - scoring it one left the moved-out object owned by
    // nobody (leak) and made a `unique` receiver a spurious borrow-init error.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 41;
        bool c = true;
        Resource* b = c ? (move a) : nullptr;
        passed += Test("ternary_paren_move_arm_value", b->id, 41);
        passed += Test("ternary_paren_move_arm_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_paren_move_arm_freed_once", dtorCount, 1);

    // Same wrapper in the FALSE arm, adopted by a `unique` receiver.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 42;
        bool c = false;
        unique Resource* b = c ? nullptr : (move a);
        passed += Test("ternary_paren_move_false_arm_value", b->id, 42);
        passed += Test("ternary_paren_move_false_arm_source_nulled", a == nullptr ? 1 : 0, 1);
    }
    passed += Test("ternary_paren_move_false_arm_freed_once", dtorCount, 1);

    // A NESTED non-mixed join whose inner arm is a `move`. Arm ownership is answered from the
    // joined value, so the inner join must hand its detachment out to the OUTER join or the outer
    // one scores mixed - which rejected this as a borrow-into-unique and left the object unowned.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 43;
        unique Resource* v = identityBool(true) ? (identityBool(true) ? move a : nullptr) : nullptr;
        passed += Test("ternary_nested_move_join_value", v->id, 43);
        passed += Test("ternary_nested_move_join_source_nulled", a == nullptr ? 1 : 0, 1);
        passed += Test("ternary_nested_move_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_move_join_freed_once", dtorCount, 1);

    // Same nesting with an allocating outer arm: both arms own, so the join owns and only the
    // selected arm ever runs - exactly one object exists and it is freed once.
    dtorCount = 0;
    {
        unique Resource* a = new Resource();
        a->id = 44;
        unique Resource* v = identityBool(true) ? (identityBool(true) ? move a : nullptr) : new Resource();
        passed += Test("ternary_nested_move_new_join_value", v->id, 44);
        passed += Test("ternary_nested_move_new_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_move_new_join_freed_once", dtorCount, 1);

    // Safety direction for the same shape: pair the owning inner join with a LIVE BORROW arm and
    // the outer join is mixed again, so the receiver borrows. The untaken `move` never runs, so
    // `a` keeps its object and `owner` keeps its own - two destructors, no double free.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 45;
        unique Resource* a = new Resource();
        a->id = 46;
        Resource* v = identityBool(false) ? (identityBool(true) ? move a : nullptr) : owner;
        passed += Test("ternary_nested_move_mixed_join_borrow_value", v->id, 45);
        passed += Test("ternary_nested_move_mixed_join_no_early_free", dtorCount, 0);
    }
    passed += Test("ternary_nested_move_mixed_join_both_freed_once", dtorCount, 2);

    // A `move` of a BORROWED parameter is the one move that owns NOTHING, so it must not make its
    // arm join-eligible. Scoring it owning made the join uniform, the receiver adopted it, and the
    // caller's live object was destroyed inside the callee (use-after-free on return, then a second
    // destructor at the caller's scope exit). The caller stays the sole owner: one destructor.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 47;
        passed += Test("ternary_borrowed_move_join_null_value", borrowedMoveJoinsNull(owner, true), 47);
        passed += Test("ternary_borrowed_move_join_null_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_join_null_owner_alive", owner->id, 47);
    }
    passed += Test("ternary_borrowed_move_join_null_owner_freed_once", dtorCount, 1);

    // Same borrowed move paired with an OWNING arm - the join is mixed, so the result borrows and
    // the untaken allocating arm never runs.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 48;
        passed += Test("ternary_borrowed_move_mixed_join_value", borrowedMoveJoinsOwning(owner, true), 48);
        passed += Test("ternary_borrowed_move_mixed_join_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_mixed_join_owner_alive", owner->id, 48);
    }
    passed += Test("ternary_borrowed_move_mixed_join_owner_freed_once", dtorCount, 1);

    // Nested laundering of the same borrowed move into a PLAIN pointer: still a borrow, and the
    // caller stays the sole owner. The `unique` spelling of this is now a compile error
    // (Test/errors/err_unique_borrow_into_unique.cb); the plain one must keep compiling.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 49;
        passed += Test("ternary_borrowed_move_nested_join_value",
                       borrowedMoveNestedJoinsNull(owner, true), 49);
        passed += Test("ternary_borrowed_move_nested_join_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_nested_join_owner_alive", owner->id, 49);
    }
    passed += Test("ternary_borrowed_move_nested_join_owner_freed_once", dtorCount, 1);

    // The boundary of that rejection: a borrowed move MIXED with a live borrow arm still assigns
    // into a `unique` local and still borrows. Neither object is adopted, so each owner frees its
    // own exactly once.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 50;
        unique Resource* other = new Resource();
        other->id = 51;
        passed += Test("ternary_borrowed_move_mixed_unique_value",
                       borrowedMoveMixedJoinIntoUnique(owner, other, false), 51);
        passed += Test("ternary_borrowed_move_mixed_unique_no_free", dtorCount, 0);
        passed += Test("ternary_borrowed_move_mixed_unique_owner_alive", owner->id, 50);
    }
    passed += Test("ternary_borrowed_move_mixed_unique_both_freed_once", dtorCount, 2);

    // Same boundary for a `unique` FIELD destination: the mixed join still stores, the field owns
    // the arm that ran and frees it once at teardown, and the borrowed caller keeps its own object.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 52;
        {
            UniqueBox box = default;
            borrowedMoveMixedJoinIntoField(&box, owner, false);
            passed += Test("ternary_borrowed_move_mixed_field_value",
                           box.item != nullptr ? 1 : 0, 1);
            passed += Test("ternary_borrowed_move_mixed_field_no_early_free", dtorCount, 0);
        }
        passed += Test("ternary_borrowed_move_mixed_field_freed_once", dtorCount, 1);
        passed += Test("ternary_borrowed_move_mixed_field_owner_alive", owner->id, 52);
    }
    passed += Test("ternary_borrowed_move_mixed_field_owner_freed_once", dtorCount, 2);

    // Same boundary on the brace-init field path: the mixed join still initializes the field, which
    // frees the allocated arm when the holder dies, and the borrowed caller keeps its own object.
    dtorCount = 0;
    {
        unique Resource* owner = new Resource();
        owner->id = 53;
        passed += Test("brace_borrowed_move_mixed_field_value",
                       borrowedMoveMixedBraceInit(owner, false), 1);
        passed += Test("brace_borrowed_move_mixed_field_freed_once", dtorCount, 1);
        passed += Test("brace_borrowed_move_mixed_field_owner_alive", owner->id, 53);
    }
    passed += Test("brace_borrowed_move_mixed_field_owner_freed_once", dtorCount, 2);

    // String arms: an owning FIELD read in an arm is deep-copied, never aliased, so the
    // field still owns its own buffer after the ternary result goes out of scope.
    {
        FlipRow row = default;
        row.name = "" + "fieldval";
        bool c = true;
        {
            string picked = c ? row.name : "-";
            passed += Test("ternary_string_field_arm_value", picked == "fieldval" ? 1 : 0, 1);
        }
        passed += Test("ternary_string_field_survives", row.name == "fieldval" ? 1 : 0, 1);
        string other = !c ? row.name : "-";
        passed += Test("ternary_string_literal_arm_value", other == "-" ? 1 : 0, 1);
    }

    // A string-returning CALL in an arm: only the selected call runs and its temp is freed.
    {
        bool c = true;
        string s = c ? echoString("left") : echoString("right");
        passed += Test("ternary_string_call_arm_value", s == "left" ? 1 : 0, 1);
    }

    return passed;
}

/*
 * RETURN of an owning FIELD PATH / fixed-array ELEMENT, and of an owning `string` FIELD.
 * The six store arms consumed such a source; the RETURN path had no consume arm at all, so it
 * copied the field's bits and left the field live - the returned value and the still-live struct
 * both owned the same Resource and both freed it (rc 133, after printing a garbage id). The
 * `string` sibling is the SILENT face of the same hole: the frame's destructor freed the buffer
 * before the caller read the handed-back {ptr,len}, so the caller got an EMPTY string at rc 0.
 * The by-value-parameter spelling is the one consume spelling of `w.b` that still compiled after
 * fix/bvfield; it is now rejected, pinned in Test/errors/err_move_field_out_of_borrowed_struct_param.cb.
 */
OaiWrap rfldG;
OaiSBox rfldSG;

OaiBox rfldLocal()                    { OaiWrap w; w.b = oaiMake(41); return w.b; }
OaiBox rfldMoveParam(move OaiWrap w)  { return w.b; }
OaiBox rfldNested()                   { OaiOuter o; o.inner.b = oaiMake(43); return o.inner.b; }
OaiBox rfldGlobal()                   { return rfldG.b; }
OaiBox rfldPtr(OaiWrap* p)            { return p->b; }
OaiBox rfldArrField()                 { OaiArrWrap w; w.arr[0] = oaiMake(46); return w.arr[0]; }
OaiBox rfldElem()                     { OaiBox[2] arr; arr[0] = oaiMake(47); return arr[0]; }
OaiBox rfldAliasSrc()                 { OaiWrap w; w.b = oaiMake(48); alias OaiWrap a = w; return a.b; }
move OaiBox rfldMoveReturn()          { OaiWrap w; w.b = oaiMake(49); return w.b; }
OaiCopyBox rfldCopyable(OaiCopyWrap* p) { return p->b; }
// ACCEPT: not owning value types, so no consume decision is taken at all.
int rfldIntField(OaiWrap w)           { return w.b.item->id; }
Resource* rfldPtrField(OaiWrap w)     { return w.b.item; }

string rfldStrLocal()                 { OaiSBox b; b.s = "ab" + "cd"; return b.s; }
string rfldStrMoveParam(move OaiSBox b) { return b.s; }
string rfldStrNested()                { OaiSWrap w; w.b.s = "ef" + "gh"; return w.b.s; }
string rfldStrArrElem()               { OaiSBox[2] arr; arr[0].s = "ij" + "kl"; return arr[0].s; }
OaiSBox rfldStrAsStruct()             { OaiSWrap w; w.b.s = "mn" + "op"; return w.b; }
// ACCEPT: the struct OUTLIVES the return, so its field stays a borrow and the source stays live.
string rfldStrGlobal()                { return rfldSG.s; }
string rfldStrPtr(OaiSBox* p)         { return p->s; }
string rfldStrByValueParam(OaiSBox b) { return b.s; }

/*
 * A field path DEEPER than the frame-local walk's step budget. The walk's fall-through answer is
 * what decides the deep case, and answering "not a frame local" hands the caller the frame's
 * free()d buffer again - the original silent-empty-string bug, at rc 0. 17 levels clears the
 * original 16-step budget, so this leg is the budget's own regression test.
 */
struct RfldD0  { string s = ""; };
struct RfldD1  { RfldD0  n; };  struct RfldD2  { RfldD1  n; };  struct RfldD3  { RfldD2  n; };
struct RfldD4  { RfldD3  n; };  struct RfldD5  { RfldD4  n; };  struct RfldD6  { RfldD5  n; };
struct RfldD7  { RfldD6  n; };  struct RfldD8  { RfldD7  n; };  struct RfldD9  { RfldD8  n; };
struct RfldD10 { RfldD9  n; };  struct RfldD11 { RfldD10 n; };  struct RfldD12 { RfldD11 n; };
struct RfldD13 { RfldD12 n; };  struct RfldD14 { RfldD13 n; };  struct RfldD15 { RfldD14 n; };
struct RfldD16 { RfldD15 n; };  struct RfldD17 { RfldD16 n; };

string rfldStrDeepPath()
{
    RfldD17 w;
    w.n.n.n.n.n.n.n.n.n.n.n.n.n.n.n.n.n.s = "qr" + "st";
    return w.n.n.n.n.n.n.n.n.n.n.n.n.n.n.n.n.n.s;
}

struct RfldHolder
{
    string s = "";
    // The IMPLICIT self-field spelling. Its accept leg below pins that it stays a BORROW: the
    // receiver outlives the call, so the frame-local walk answers no and nothing is copied.
    string get() { return s; }
};

/*
 * The IMPLICIT self-field spelling of the owning-struct return (`return b;` inside a method).
 * GetMemberVariable deliberately omits FieldName / OwningStructName, so the arm's first cut -
 * which asked for a FieldName - missed it while the identical `return this.b;` was consumed:
 * rc 133 with the receiver's field still live. The arm now admits by GEP SHAPE, as the store
 * arms admit by Storage alone (`UBox x = b;` in a method already consumed on both binaries).
 * `this` is always a POINTER in CFlat (RegisterThisPointer), so no implicit self-field read can
 * ever root at a borrowed by-value parameter and RejectConsumeOfBorrowedByValueParamField is
 * structurally unreachable from here.
 */
struct RfldMHolder
{
    OaiBox b;
    int n = 0;
    OaiBox get()      { return b; }
    OaiBox getThis()  { return this.b; }
    // A LOCAL shadowing the field: name resolution reaches the local first, so this must take the
    // movableLocalReturn path and leave the FIELD untouched.
    OaiBox getShadow() { OaiBox b; b = oaiMake(56); return b; }
    int getN()        { return n; }
};

struct RfldMInner { OaiBox b; };
struct RfldMNest  { RfldMInner inner; OaiBox get() { return inner.b; } };
struct RfldMCopy  { OaiCopyBox b; OaiCopyBox get() { return b; } };
struct RfldSNest  { OaiSBox inner; string get() { return inner.s; } };

RfldMHolder rfldMG;

/*
 * COPYABLE-IN-NAME CONTAINERS returned out of a member. `list<T>` has a `copy()`, so the return
 * arm classifies Copy and calls it - which is the ratified STORE behaviour reaching the return
 * position. When T itself is non-copyable the per-instantiation compile_error fires and the
 * accessor is REJECTED; that is pinned in Test/errors/err_return_noncopyable_list_member*.cb,
 * with `move` as the escape hatch pinned below. `list<string>` / `list<int>` copy cleanly and
 * are the two shapes the arm silently repaired: on the merge base they printed these same
 * numbers and then aborted at teardown (rc 133), both owners freeing one buffer.
 */
struct RfldCBag  { list<OaiBox> items; list<OaiBox> take() { return move items; } };
struct RfldCSBag { list<string> a;     list<string> take() { return a; } };
struct RfldCIBag { list<int>    a;     list<int>    take() { return a; } };

int testReturnOfOwningField()
{
    int passed = 0;

    // 1. The filed repro and its source-shape axes. Each was rc 133 with a garbage id before the
    // fix; the id leg alone already discriminates (it read freed memory), and the dtor legs pin
    // that the pointee is freed exactly ONCE rather than by two owners.
    dtorCount = 0;
    {
        OaiBox r = rfldLocal();
        passed += Test("rfld_local_value", r.item->id, 41);
        passed += Test("rfld_local_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_local_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(42);
        OaiBox r = rfldMoveParam(move w);
        passed += Test("rfld_moveparam_value", r.item->id, 42);
        passed += Test("rfld_moveparam_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_moveparam_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox r = rfldNested();
        passed += Test("rfld_nested_value", r.item->id, 43);
        passed += Test("rfld_nested_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_nested_freed_once", dtorCount, 1);

    // 2. Sources whose owner OUTLIVES the frame. They double-freed too, so they are consumed
    // exactly as the store arms consume a global / deref source: the source lvalue is nulled.
    dtorCount = 0;
    {
        rfldG.b = oaiMake(44);
        OaiBox r = rfldGlobal();
        passed += Test("rfld_global_value", r.item->id, 44);
        passed += Test("rfld_global_source_nulled", rfldG.b.item == nullptr, true);
        passed += Test("rfld_global_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_global_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(45);
        OaiBox r = rfldPtr(&w);
        passed += Test("rfld_ptr_value", r.item->id, 45);
        passed += Test("rfld_ptr_source_nulled", w.b.item == nullptr, true);
        passed += Test("rfld_ptr_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_ptr_freed_once", dtorCount, 1);

    // 3. Fixed-array shapes: a field-array element (`w.arr[0]`) and a BARE element of a local
    // array of owning structs. The bare element carries no FieldName, so it reaches the arm
    // through the two-index-array-GEP leg rather than the field leg.
    dtorCount = 0;
    {
        OaiBox r = rfldArrField();
        passed += Test("rfld_arrfield_value", r.item->id, 46);
        passed += Test("rfld_arrfield_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_arrfield_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox r = rfldElem();
        passed += Test("rfld_elem_value", r.item->id, 47);
        passed += Test("rfld_elem_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_elem_freed_once", dtorCount, 1);

    // 4. Through an `alias` binding of the local, and under a `move` RETURN TYPE. The two
    // pre-existing move-return guards are keyed on the returned expression being a PARAMETER,
    // so a local's field reached neither and double-freed exactly like the plain return type.
    dtorCount = 0;
    {
        OaiBox r = rfldAliasSrc();
        passed += Test("rfld_aliassrc_value", r.item->id, 48);
        passed += Test("rfld_aliassrc_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_aliassrc_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        OaiBox r = rfldMoveReturn();
        passed += Test("rfld_movereturn_value", r.item->id, 49);
        passed += Test("rfld_movereturn_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_movereturn_freed_once", dtorCount, 1);

    // 5. A COPYABLE owner takes the other leg of the same decision: copy() runs, the source
    // stays live, and the two allocations are freed once each. This was rc 133 before the fix
    // too - the return path took no decision at all, so `copy()` was never called.
    dtorCount = 0;
    {
        OaiCopyWrap w;
        w.b.item = new Resource();
        w.b.item->id = 50;
        {
            OaiCopyBox r = rfldCopyable(&w);
            passed += Test("rfld_copyable_value", r.item->id, 50);
            passed += Test("rfld_copyable_source_live", w.b.item != nullptr, true);
            passed += Test("rfld_copyable_independent", r.item != w.b.item, true);
        }
        passed += Test("rfld_copyable_copy_freed", dtorCount, 1);
    }
    passed += Test("rfld_copyable_both_freed", dtorCount, 2);

    // 6. ACCEPT SET, measured green on the pre-fix binary and unchanged: a plain int field, a
    // POINTER field, and a field of an owning TEMP (which has its own arm above). None of them
    // is an owning VALUE read out of storage, so no consume decision is taken.
    dtorCount = 0;
    {
        OaiWrap w;
        w.b = oaiMake(51);
        passed += Test("rfld_intfield_value", rfldIntField(w), 51);
        passed += Test("rfld_ptrfield_value", rfldPtrField(w)->id, 51);
        passed += Test("rfld_accept_no_early_free", dtorCount, 0);
    }
    passed += Test("rfld_accept_freed_once", dtorCount, 1);

    // 7. The `string` FIELD sibling. Every leg below returned the EMPTY string before the fix
    // (rc 0), because the frame's destructor freed the buffer the caller was handed. The value
    // leg is therefore the discriminator; there is no abort to notice.
    passed += Test("rfldstr_local_value", rfldStrLocal(), "abcd");
    {
        OaiSBox b;
        b.s = "ab" + "cd";
        passed += Test("rfldstr_moveparam_value", rfldStrMoveParam(move b), "abcd");
    }
    passed += Test("rfldstr_nested_value", rfldStrNested(), "efgh");
    passed += Test("rfldstr_arrelem_value", rfldStrArrElem(), "ijkl");
    // The same owning string handed back inside a STRUCT-typed return: that spelling goes
    // through the owning-field consume arm (OaiSBox is an owning value type), not the string arm.
    {
        OaiSBox r = rfldStrAsStruct();
        passed += Test("rfldstr_asstruct_value", r.s, "mnop");
    }

    // 8. ACCEPT SET for the string arm: the struct OUTLIVES the return in each of these, so the
    // field must keep borrowing and the source must stay readable afterwards. All four were
    // already correct before the fix and must not change.
    {
        rfldSG.s = "gl" + "ob";
        string y = rfldStrGlobal();
        passed += Test("rfldstr_global_value", y, "glob");
        passed += Test("rfldstr_global_source_live", rfldSG.s, "glob");

        OaiSBox b;
        b.s = "pt" + "rr";
        passed += Test("rfldstr_ptr_value", rfldStrPtr(&b), "ptrr");
        passed += Test("rfldstr_ptr_source_live", b.s, "ptrr");

        OaiSBox c;
        c.s = "bv" + "al";
        passed += Test("rfldstr_bvparam_value", rfldStrByValueParam(c), "bval");
        passed += Test("rfldstr_bvparam_source_live", c.s, "bval");

        // Same dying-local hazard as rfldstr_local, through a path longer than the walk's budget.
        passed += Test("rfldstr_deep_path_value", rfldStrDeepPath(), "qrst");

        RfldHolder h;
        h.s = "me" + "th";
        passed += Test("rfldstr_method_value", h.get(), "meth");
        passed += Test("rfldstr_method_source_live", h.s, "meth");

        RfldSNest sn;
        sn.inner.s = "ne" + "st";
        passed += Test("rfldstr_method_nested_value", sn.get(), "nest");
        passed += Test("rfldstr_method_nested_source_live", sn.inner.s, "nest");
    }

    // 9. The IMPLICIT self-field spelling inside a method. `return b;` was rc 133 with the
    // receiver's field still live while `return this.b;` beside it consumed correctly; both
    // spellings now take the same decision. The source-nulled leg is the discriminator - the
    // value alone read back correctly on the broken binary before the double free.
    dtorCount = 0;
    {
        RfldMHolder h;
        h.b = oaiMake(52);
        OaiBox r = h.get();
        passed += Test("rfldm_implicit_value", r.item->id, 52);
        passed += Test("rfldm_implicit_source_nulled", h.b.item == nullptr, true);
        passed += Test("rfldm_implicit_no_early_free", dtorCount, 0);
    }
    passed += Test("rfldm_implicit_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        RfldMHolder h;
        h.b = oaiMake(53);
        OaiBox r = h.getThis();
        passed += Test("rfldm_explicit_value", r.item->id, 53);
        passed += Test("rfldm_explicit_source_nulled", h.b.item == nullptr, true);
    }
    passed += Test("rfldm_explicit_freed_once", dtorCount, 1);

    dtorCount = 0;
    {
        RfldMNest w;
        w.inner.b = oaiMake(54);
        OaiBox r = w.get();
        passed += Test("rfldm_nested_value", r.item->id, 54);
        passed += Test("rfldm_nested_source_nulled", w.inner.b.item == nullptr, true);
    }
    passed += Test("rfldm_nested_freed_once", dtorCount, 1);

    // A GLOBAL receiver takes the same consume as the explicit global spelling above.
    dtorCount = 0;
    {
        rfldMG.b = oaiMake(55);
        OaiBox r = rfldMG.get();
        passed += Test("rfldm_global_value", r.item->id, 55);
        passed += Test("rfldm_global_source_nulled", rfldMG.b.item == nullptr, true);
    }
    passed += Test("rfldm_global_freed_once", dtorCount, 1);

    // ACCEPT: a LOCAL shadowing the field must leave the field alone (movableLocalReturn path),
    // and an int field is not an owning value type, so no decision is taken for it at all.
    dtorCount = 0;
    {
        RfldMHolder h;
        h.b = oaiMake(57);
        h.n = 58;
        OaiBox r = h.getShadow();
        passed += Test("rfldm_shadow_value", r.item->id, 56);
        passed += Test("rfldm_shadow_field_live", h.b.item != nullptr, true);
        passed += Test("rfldm_intfield_value", h.getN(), 58);
    }
    passed += Test("rfldm_shadow_both_freed", dtorCount, 2);

    // A COPYABLE owning field read implicitly takes the copy leg: source live, buffers distinct.
    dtorCount = 0;
    {
        RfldMCopy h;
        h.b.item = new Resource();
        h.b.item->id = 59;
        {
            OaiCopyBox r = h.get();
            passed += Test("rfldm_copyable_value", r.item->id, 59);
            passed += Test("rfldm_copyable_source_live", h.b.item != nullptr, true);
            passed += Test("rfldm_copyable_independent", r.item != h.b.item, true);
        }
        passed += Test("rfldm_copyable_copy_freed", dtorCount, 1);
    }
    passed += Test("rfldm_copyable_both_freed", dtorCount, 2);

    // 10. The container-member accessor. `return move items;` is the ratified escape hatch for a
    // container whose element type is non-copyable, and it works identically on the merge base -
    // these legs pin the remedy the rejection's message names, so the message cannot go stale.
    dtorCount = 0;
    {
        RfldCBag g;
        g.items.add(oaiMake(60));
        {
            list<OaiBox> t = g.take();
            passed += Test("rfldc_move_count", t.count(), 1);
            passed += Test("rfldc_move_id", t.get(0).item->id, 60);
            passed += Test("rfldc_move_source_emptied", g.items.count(), 0);
            passed += Test("rfldc_move_no_early_free", dtorCount, 0);
        }
        passed += Test("rfldc_move_freed_once", dtorCount, 1);
    }
    passed += Test("rfldc_move_no_double_free", dtorCount, 1);

    // The two copyable instantiations. Every number below was already correct on the merge base;
    // the DISCRIMINATOR is that the process reaches the end at all, since the merge base printed
    // exactly these values and then aborted at teardown (rc 133) with two owners of one buffer.
    {
        RfldCSBag g;
        g.a.add("x" + "y");
        {
            list<string> t = g.take();
            passed += Test("rfldc_strlist_count", t.count(), 1);
            passed += Test("rfldc_strlist_value", t.get(0), "xy");
            passed += Test("rfldc_strlist_source_live", g.a.get(0), "xy");
            t.add("z");
            passed += Test("rfldc_strlist_copy_grew", t.count(), 2);
            passed += Test("rfldc_strlist_source_unchanged", g.a.count(), 1);
        }
    }

    {
        RfldCIBag g;
        g.a.add(7);
        g.a.add(8);
        {
            list<int> t = g.take();
            passed += Test("rfldc_intlist_count", t.count(), 2);
            passed += Test("rfldc_intlist_value", t.get(0), 7);
            passed += Test("rfldc_intlist_source_live", g.a.get(0), 7);
            t.add(9);
            passed += Test("rfldc_intlist_copy_grew", t.count(), 3);
            passed += Test("rfldc_intlist_source_unchanged", g.a.count(), 2);
        }
    }

    return passed;
}

// -- range-`for` over a FIXED ARRAY binds its element as a BORROW --------------------
// The loop variable's alloca is hoisted once and its destructor is emitted ONCE, in
// forRangeResume, so bit-copying an owning element's {ptr,len,owned} pair gave two owners
// of one buffer: the resume dtor freed the LAST element's buffer and the array's own
// teardown freed it again (rc 133), with the array left dangling in between. The element
// load now clears the owned bits - the same borrow `alias T get` hands back on the
// container leg - so the once-only dtor is a no-op and the array keeps every buffer.
// Every leg below is value-discriminating: churn allocations after the loop reuse any
// wrongly-freed buffer, so a premature free shows up as a corrupted array read rather
// than only as a teardown crash.
struct ForInBag { string[2] arr; };
struct ForInPod { int a = 0; int b = 0; };
struct ForInWide { int id = 0; string s = default; };
struct ForInBorrow { ForInPod* p = nullptr; };
int forInOwnerDtors = 0;
struct ForInRes { int id = 0; ~ForInRes() { forInOwnerDtors = forInOwnerDtors + 1; } };
struct ForInOwner { unique ForInRes* p = nullptr; };
interface IForInShape { int area(); };
class ForInSquare : IForInShape { int side = 0; int area() { return side * side; } };
string[2] forInGlobalArr;

int forInLenOf(string s) { return s.length(); }

void forInChurn()
{
    for (int i = 0; i < 40; i++)
    {
        string churn = "padding-padding-padding-" + i.toString();
        if (churn.length() < 1) { printf("unreachable\n"); }
    }
}

int testForInOverFixedArrayElement()
{
    int passed = 0;

    // Core repro: read-only body over `string[2]`.
    {
        string[2] dst;
        dst[0] = "ab" + "cd";
        dst[1] = "ef" + "gh";
        int n = 0;
        for (string s in dst)
            n = n + (s == "abcd" || s == "efgh" ? 1 : 0);
        forInChurn();
        passed += Test("forin_fixed_string_matches", n, 2);
        passed += Test("forin_fixed_string_first_intact", dst[0] == "abcd" ? 1 : 0, 1);
        passed += Test("forin_fixed_string_last_intact", dst[1] == "efgh" ? 1 : 0, 1);
        passed += Test("forin_fixed_string_last_len", dst[1].length(), 4);
    }

    // Struct element carrying an owning string FIELD: the field's owned bit is cleared too.
    {
        ForInWide[2] arr;
        arr[0].id = 1; arr[0].s = "ab" + "cd";
        arr[1].id = 2; arr[1].s = "ef" + "gh";
        int n = 0;
        for (ForInWide w in arr)
            n = n + w.id * 10 + w.s.length();
        forInChurn();
        passed += Test("forin_fixed_wide_sum", n, 38);
        passed += Test("forin_fixed_wide_last_intact", arr[1].s == "efgh" ? 1 : 0, 1);
        passed += Test("forin_fixed_wide_first_intact", arr[0].s == "abcd" ? 1 : 0, 1);
    }

    // A fixed-array FIELD of a struct, and the null-conditional receiver spelling.
    {
        ForInBag b;
        b.arr[0] = "ab" + "cd";
        b.arr[1] = "ef" + "gh";
        int n = 0;
        for (string s in b.arr) n = n + s.length();
        forInChurn();
        passed += Test("forin_field_array_sum", n, 8);
        passed += Test("forin_field_array_last_intact", b.arr[1] == "efgh" ? 1 : 0, 1);

        ForInBag* p = &b;
        int m = 0;
        for (string s in p?.arr) m = m + s.length();
        forInChurn();
        passed += Test("forin_nullcond_array_sum", m, 8);
        passed += Test("forin_nullcond_array_last_intact", b.arr[1] == "efgh" ? 1 : 0, 1);
    }

    // break / continue: the once-only dtor still sees a borrow on every exit edge.
    {
        string[3] dst;
        dst[0] = "ab" + "cd";
        dst[1] = "ef" + "gh";
        dst[2] = "ij" + "kl";
        int n = 0;
        for (string s in dst)
        {
            if (s == "abcd") continue;
            n = n + s.length();
            if (s == "efgh") break;
        }
        forInChurn();
        passed += Test("forin_break_continue_sum", n, 4);
        passed += Test("forin_break_continue_intact", dst[1] == "efgh" ? 1 : 0, 1);
        passed += Test("forin_break_continue_tail_intact", dst[2] == "ijkl" ? 1 : 0, 1);
    }

    // Nested iteration over the SAME array: two live borrows of one slot.
    {
        string[2] dst;
        dst[0] = "ab" + "cd";
        dst[1] = "ef" + "gh";
        int n = 0;
        for (string s in dst)
            for (string t in dst)
                n = n + s.length() + t.length();
        forInChurn();
        passed += Test("forin_nested_sum", n, 32);
        passed += Test("forin_nested_first_intact", dst[0] == "abcd" ? 1 : 0, 1);
        passed += Test("forin_nested_last_intact", dst[1] == "efgh" ? 1 : 0, 1);
    }

    // The borrow passed to a function, and the array written THROUGH while borrowed.
    {
        string[2] dst;
        dst[0] = "ab" + "cd";
        dst[1] = "efg" + "gh";
        int n = 0;
        for (string s in dst) n = n + forInLenOf(s);
        forInChurn();
        passed += Test("forin_pass_to_function_sum", n, 9);
        passed += Test("forin_pass_to_function_intact", dst[1] == "efggh" ? 1 : 0, 1);

        int i = 0;
        int m = 0;
        for (string s in dst)
        {
            dst[i] = "new" + i.toString();
            m = m + s.length();
            i = i + 1;
        }
        forInChurn();
        passed += Test("forin_write_through_sum", m, 9);
        passed += Test("forin_write_through_slot0", dst[0] == "new0" ? 1 : 0, 1);
        passed += Test("forin_write_through_slot1", dst[1] == "new1" ? 1 : 0, 1);
    }

    // The borrow stored into a structure that OUTLIVES the array: the sink must take a
    // copy, so the entries survive the array's teardown.
    {
        list<string> out;
        {
            string[2] dst;
            dst[0] = "ab" + "cd";
            dst[1] = "ef" + "gh";
            for (string s in dst) out.add(s);
        }
        forInChurn();
        passed += Test("forin_stored_count", out.count(), 2);
        passed += Test("forin_stored_first", out.get(0) == "abcd" ? 1 : 0, 1);
        passed += Test("forin_stored_last", out.get(1) == "efgh" ? 1 : 0, 1);
    }

    // A GLOBAL fixed array never crashed - globals are not destructed at teardown - but the
    // loop variable's resume dtor still freed the last element's buffer, corrupting the global.
    {
        forInGlobalArr[0] = "ab" + "cd";
        forInGlobalArr[1] = "ef" + "gh";
        int n = 0;
        for (string s in forInGlobalArr) n = n + s.length();
        forInChurn();
        passed += Test("forin_global_array_sum", n, 8);
        passed += Test("forin_global_array_intact", forInGlobalArr[1] == "efgh" ? 1 : 0, 1);
    }

    // ---- accept set: legs that were already correct and must stay byte-identical ----
    // (measured identical on the pre-fix and post-fix binaries)
    {
        int[3] a;
        a[0] = 1; a[1] = 2; a[2] = 3;
        int sum = 0;
        for (int v in a) sum = sum + v;
        passed += Test("forin_accept_int_array", sum, 6);
    }
    {
        ForInPod[2] arr;
        arr[0].a = 1; arr[0].b = 2;
        arr[1].a = 3; arr[1].b = 4;
        int sum = 0;
        for (ForInPod p in arr) sum = sum + p.a * 10 + p.b;
        passed += Test("forin_accept_pod_array", sum, 46);
    }
    {
        ForInSquare q; q.side = 2;
        ForInSquare r; r.side = 3;
        IForInShape[2] shapes;
        shapes[0] = q;
        shapes[1] = r;
        int sum = 0;
        for (IForInShape x in shapes) sum = sum + x.area();
        passed += Test("forin_accept_interface_array", sum, 13);
    }
    {
        string[2] lits;
        lits[0] = "abcd";
        lits[1] = "efgh";
        int n = 0;
        for (string s in lits) n = n + s.length();
        forInChurn();
        passed += Test("forin_accept_literal_array", n, 8);
        passed += Test("forin_accept_literal_intact", lits[1] == "efgh" ? 1 : 0, 1);
    }
    {
        list<string> l;
        l.add("ab" + "cd");
        l.add("ef" + "gh");
        int n = 0;
        for (string s in l) n = n + (s == "abcd" || s == "efgh" ? 1 : 0);
        forInChurn();
        passed += Test("forin_accept_list_matches", n, 2);
        passed += Test("forin_accept_list_last_intact", l.get(1) == "efgh" ? 1 : 0, 1);
    }
    // A non-'unique' pointer FIELD is a borrow the element already shallow-shares by design,
    // so the by-value loop variable stays legal (the reject only covers owning pointers).
    {
        ForInPod p0; p0.a = 7;
        ForInPod p1; p1.a = 9;
        ForInBorrow[2] arr;
        arr[0].p = &p0;
        arr[1].p = &p1;
        int sum = 0;
        for (ForInBorrow b in arr) sum = sum + b.p->a;
        passed += Test("forin_accept_borrow_ptr_field", sum, 16);
    }

    // The REMEDY named by the by-value rejection: index the collection and read the element
    // in place. Both spellings double-freed as `for (ForInOwner o in ...)` before the reject.
    // Dtor counts are the discriminator - a shared pointee would free twice (and abort).
    {
        forInOwnerDtors = 0;
        {
            ForInOwner[2] arr;
            arr[0].p = new ForInRes(); arr[0].p->id = 7;
            arr[1].p = new ForInRes(); arr[1].p->id = 9;
            int sum = 0;
            for (int i = 0; i < 2; i++) sum = sum + arr[i].p->id;
            passed += Test("forin_remedy_fixed_index_sum", sum, 16);
            passed += Test("forin_remedy_fixed_no_early_free", forInOwnerDtors, 0);
        }
        passed += Test("forin_remedy_fixed_freed_once", forInOwnerDtors, 2);
    }
    {
        forInOwnerDtors = 0;
        {
            list<ForInOwner> l;
            ForInOwner a; a.p = new ForInRes(); a.p->id = 7; l.add(move a);
            ForInOwner c; c.p = new ForInRes(); c.p->id = 9; l.add(move c);
            int sum = 0;
            for (int i = 0; i < l.count(); i++) sum = sum + l[i].p->id;
            passed += Test("forin_remedy_list_index_sum", sum, 16);
            passed += Test("forin_remedy_list_no_early_free", forInOwnerDtors, 0);
        }
        passed += Test("forin_remedy_list_freed_once", forInOwnerDtors, 2);
    }

    return passed;
}

/*
 * The ACCEPT set around the borrow taint a plain '=' now records (the rejects live in
 * Test/errors/err_delete_borrowed_via_cast.cb). Recording a borrow on the store must not cost the
 * programs that legally read through an assigned borrow, nor the one that re-arms ownership with
 * an owned rebind in the same block - rejecting that would leak the new object.
 */
int assignBorrowReadThrough(Resource* p)
{
    Resource* d = nullptr;
    d = p;
    return d->id;
}

int assignBorrowThenOwned(Resource* p)
{
    Resource* d = nullptr;
    d = p;                    // records the borrow of 'p'
    d = new Resource();       // same block: retires it, 'd' is now the sole owner
    d->id = 7;
    int got = d->id;
    delete d;                 // frees the new object only; 'p' stays alive for the caller
    return got;
}

int assignBorrowThenOwnedInBranch(Resource* p, int c)
{
    Resource* d = nullptr;
    if (c > 0)
    {
        d = p;
        d = new Resource();   // both stores in ONE block, so the retirement still holds
        d->id = 5;
        delete d;
    }
    return c;
}

int testAssignBorrowTaint()
{
    int passed = 0;
    dtorCount = 0;
    {
        Resource* owner = new Resource();
        owner->id = 42;
        passed += Test("assign_borrow_read_through", assignBorrowReadThrough(owner), 42);
        passed += Test("assign_borrow_read_no_free", dtorCount, 0);
        passed += Test("assign_borrow_then_owned_value", assignBorrowThenOwned(owner), 7);
        // Exactly the new object was freed - the borrowed one is untouched and still readable.
        passed += Test("assign_borrow_then_owned_freed_once", dtorCount, 1);
        passed += Test("assign_borrow_source_intact", owner->id, 42);
        passed += Test("assign_borrow_branch_ret", assignBorrowThenOwnedInBranch(owner, 1), 1);
        passed += Test("assign_borrow_branch_freed_once", dtorCount, 2);
        passed += Test("assign_borrow_source_still_intact", owner->id, 42);
        delete owner;
    }
    passed += Test("assign_borrow_owner_freed_once", dtorCount, 3);
    return passed;
}

extern int main()
{
    int passed = 0;
    int total  = 0;

    // Test 1: move param causes destructor to fire when function returns
    dtorCount = 0;
    {
        Resource* r = new Resource();
        r->id = 42;
        borrow(r);
        consume(r);
    }
    passed += Test("move_borrow_no_dtor", dtorCount, 1);
    total++;

    // Test 2: move param with null - no crash (null check in cleanup)
    dtorCount = 0;
    {
        Resource* r = new Resource();
        consume(r);
    }
    passed += Test("move_null_safe", dtorCount, 1);
    total++;

    // Test 3: new-allocated local auto-freed at scope exit (no escape)
    dtorCount = 0;
    {
        Resource* r = new Resource();
    }
    passed += Test("new_local_auto_free", dtorCount, 1);
    total++;

    // Test 4: new local assigned to struct field - not freed early; freed when owner is destroyed
    dtorCount = 0;
    {
        Container* c = new Container();
        {
            Resource* r = new Resource();
            c->item = r;
            // r exits scope: refcount 2->1, no free
        }
        passed += Test("stack_to_field_no_early_free", dtorCount, 0);
        total++;
        // c exits scope: auto-freed, ~Container() frees c->item -> dtorCount = 1
    }
    passed += Test("stack_to_field_freed_with_owner", dtorCount, 1);
    total++;

    passed += testListStringMove();
    total += 10;

    // Test 5: move T* return - caller receives ownership, pointer freed at scope exit
    dtorCount = 0;
    {
        Resource* r = createResource(7);
    }
    passed += Test("move_return_new_freed", dtorCount, 1);
    total++;

    // Test 6: move T* return - forward through move param, freed once
    dtorCount = 0;
    {
        Resource* r = createResource(8);
        Resource* r2 = forwardResource(r);
    }
    passed += Test("move_return_forward_freed_once", dtorCount, 1);
    total++;

    // Test 6a: move-in-loop with reassign each iteration. The reassignment revives the
    // pointer across the back-edge, so this is NOT a loop-carried use-after-move and must
    // compile clean (guards the move-dataflow pass against a false positive).
    dtorCount = 0;
    {
        Resource* r = new Resource();
        int i = 0;
        while (i < 3)
        {
            consume(r);          // moves + frees r (dtor +1)
            r = new Resource();  // revive: fresh owner for the next iteration
            i = i + 1;
        }
        consume(r);              // free the last one
    }
    passed += Test("move_loop_reassign_revive", dtorCount, 4);
    total++;

    // Test 6b: fresh owning local declared inside the loop each iteration - the binding
    // dominates every use, so no loop-carried move; must compile clean.
    dtorCount = 0;
    {
        int i = 0;
        while (i < 3)
        {
            Resource* q = new Resource();
            consume(q);
            i = i + 1;
        }
    }
    passed += Test("move_loop_fresh_local", dtorCount, 3);
    total++;

    // Worker-style ownership transfer (mirrors repro_new_struct.cb without threads).
    // Caller 'new's a Slot, hands it to a function via 'move'; callee writes through
    // ->slot and returns. Expect exactly one destructor, observed value updated.
    dtorCount = 0;
    {
        int observed = 0;
        Slot* p = new Slot();
        p->slot  = &observed;
        p->value = 42;
        int got = workerMove(p);
        passed += Test("worker_move_return", got, 42);
        total++;
        passed += Test("worker_move_observed", observed, 42);
        total++;
        // p is nulled by 'move'; scope exit is a no-op. Exactly one free inside workerMove.
    }
    passed += Test("worker_move_freed_once", dtorCount, 1);
    total++;

    // Same shape, but the callee calls 'delete' explicitly. ParseDeleteExpression
    // nulls the parameter's alloca so scope-exit cleanup skips - still one free.
    dtorCount = 0;
    {
        int observed = 0;
        Slot* p = new Slot();
        p->slot  = &observed;
        p->value = 7;
        int got = workerMoveDelete(p);
        passed += Test("worker_move_delete_return", got, 7);
        total++;
        passed += Test("worker_move_delete_observed", observed, 7);
        total++;
    }
    passed += Test("worker_move_delete_freed_once", dtorCount, 1);
    total++;

    // Test 7: list<unique T*> OWNS its elements - removeAt frees one in place, the
    // destructor frees the rest. take() went away with the borrow-by-default list:
    // extraction from an owning container is deliberately undesigned (plan item 5).
    dtorCount = 0;
    {
        list<unique Resource*> items;
        Resource* a = new Resource();
        Resource* b = new Resource();
        items.add(a);
        items.add(b);
        items.removeAt(0);
        passed += Test("list_removeAt_owned_freed", dtorCount, 1);
        total++;
        // list goes out of scope; remaining element (b) freed by list destructor
    }
    passed += Test("list_dtor_remaining_freed", dtorCount, 2);
    total++;

    // Test 8: move-vs-borrow overload selection via a second, unrelated function
    // (delegateProbe). probe()'s own plain/move overload pair is covered by
    // testPtrMoveOverloadIdentity() below (ptr_ovl_plain_picks_borrow /
    // ptr_ovl_explicit_move_picks_move), which also asserts the borrowed pointer stays
    // usable after the call - removed the redundant probe() duplicate that used to sit here.
    // Borrowed pointer (non-move param) -> picks 'borrow' overload (returns 200+id, no free).
    dtorCount = 0;
    {
        Resource* b = new Resource();
        b->id = 9;
        int v = delegateProbe(b);
        passed += Test("probe_picks_borrow_for_non_owning", v, 209);
        total++;
        // b still owned here; freed at scope exit.
    }
    passed += Test("probe_borrow_freed_at_scope_exit", dtorCount, 1);
    total++;

    // Test 9: composite-ownership cleanup. Bag owns 'item' (Resource*) and
    // 'entries' (RouteEntry[3]). Each layer's destructor frees only its own
    // fields; ~Bag's 'delete[3] entries' invokes ~RouteEntry on every slot,
    // which frees its own 'name'. No layer reaches into another's fields.
    dtorCount = 0;
    {
        Bag bag;
        bag.item = new Resource();
        bag.item->id = 1;
        bag.entries = new RouteEntry[3];
        int i = 0;
        while (i < 3)
        {
            bag.entries[i].name = new Resource();
            bag.entries[i].name->id = i + 10;
            i = i + 1;
        }
        // 4 Resources alive: bag.item plus three entry names.
        // Scope exit -> ~Bag frees item, delete[3] entries -> ~RouteEntry per slot
        // frees each name. dtorCount should reach 4.
    }
    passed += Test("composite_dtor_chain_frees_all", dtorCount, 4);
    total++;

    passed += testRecursiveTreeFree();
    total += 1;

    passed += testDeleteNullCascade();
    total += 1;

    passed += testRecursiveContainerFree();
    total += 1;

    passed += testSelfRefContainerRelease();
    total += 6;

    passed += testFieldOwnership();
    total += 7;

    passed += testUniqueField();
    total += 68;

    passed += testParamStringToField();
    total += 1;

    passed += testStructWithStringFieldIntoList();
    total += 2;

    passed += testBorrowStringFieldIntoLocal();
    total += 3;

    passed += testCopyOnAssignFlip();
    total += 12;

    passed += testUniqueLocalAndParam();
    total += 24;

    passed += testUniqueLocalReassignMove();
    total += 95;

    passed += testValueMoveArgDeferred();
    total += 5;

    passed += testPtrMoveOverloadIdentity();
    total += 13;

    passed += testRValuePrefersMoveOverload();
    total += 6;

    passed += testTernaryArmsShortCircuit();
    total += 68;

    passed += testUniqueInterfaceReassign();
    total += 8;

    passed += testUniqueInterfaceTernary();
    total += 181;

    passed += testTernaryInterfaceInheritanceRebox();
    total += 22;

    passed += testIfaceTernaryByValueCallArg();
    total += 11;

    passed += testUniqueInterfaceMoveExtra();
    total += 22;

    passed += testOwningStructTernaryJoin();
    total += 105;

    passed += testDiscardMoveReturningCall();
    total += 6;

    passed += testUniqueFieldStoreRemedies();
    total += 29;

    passed += testTempUniqueFieldBorrowAccepts();
    total += 127;

    passed += testUniqueArrayElementFieldStore();
    total += 24;

    passed += testUniqueFieldImplicitMove();
    total += 68;

    passed += testUninitializedUniqueLocalDecl();
    total += 20;

    passed += testUninitializedUniqueIfaceLocalDecl();
    total += 20;

    passed += testUniqueGlobalReceiverFieldStore();
    total += 15;

    passed += testCopyFactPropagationAccepts();
    total += 87;

    passed += testBorrowedPointerMoveNoAdopt();
    total += 23;

    passed += testOwningAssignFromIndirectSource();
    total += 75;

    passed += testOwningAssignIntoFixedArrayElement();
    total += 92;

    passed += testOwningAssignIntoArrayViewElement();
    total += 77;

    passed += testOwningBraceInitFixedArray();
    total += 63;

    passed += testBraceInitConsumesParameter();
    total += 28;

    passed += testLambdaParamOwningSink();
    total += 60;
    passed += testDeclaredMoveFuncPtrParam();
    total += 44;

    passed += testConsumeOfBorrowedByValueParamField();
    total += 34;

    passed += testParenConsumeSourceSink();
    total += 35;

    passed += testWrapperConsumeProvenance();
    total += 83;

    passed += testReturnOfOwningField();
    total += 92;
    passed += testForInOverFixedArrayElement();
    total += 41;

    passed += testAssignBorrowTaint();
    total += 9;

    printf("\n%d / %d tests passed.\n", passed, total);
    return passed == total ? 0 : 1;
}

// Deliberately defined BELOW main, i.e. below its call site: cflat emits IR as it walks, so its
// body is not readable when the call is emitted and the alias proof cannot be built. The
// accepted unknown-accepts caveat - the temp keeps leaking instead of being freed twice.
Resource* identityResourceDefinedBelow(Resource* p) { return p; }

// The two callees the DEFERRED return-half accept legs call. Both are written here, BELOW every
// call site, so ParameterMayReachReturn is unanswerable during the walk and the answer can only
// come from the end-of-module resolve. `lateRetGlobalResource` answers NO there (it returns a
// global, not its parameter) and `latePassthruResource` answers YES but is only ever called with
// no destination, or with a pointer that is not a temporary's field.
Resource* lateRetGlobalResource(Resource* r) { return gKeptResource2; }
Resource* latePassthruResource(Resource* r) { return r; }
