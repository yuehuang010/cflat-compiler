}

bool strcastTestReturnedCallPositions()
{
    bool result = true;
    string plainLocal = strcastIdentityCallValue();
    string castLocal = (string)strcastIdentityCallValue();
    result &= Test("strcast returned call local declaration cast value and ownership",
                   strcastSameStringResult(&plainLocal, &castLocal), true);
    string plainFunctionalLocal = strcastIdentityCallValue();
    string functionalLocal = string(strcastIdentityCallValue());
    result &= Test("strcast returned call local declaration functional value and ownership",
                   strcastSameStringResult(&plainFunctionalLocal, &functionalLocal), true);

    string plainAssigned = "old"; plainAssigned = strcastIdentityCallValue();
    string castAssigned = "old"; castAssigned = (string)strcastIdentityCallValue();
    result &= Test("strcast returned call assignment cast value and ownership",
                   strcastSameStringResult(&plainAssigned, &castAssigned), true);
    string plainFunctionalAssigned = "old";
    plainFunctionalAssigned = strcastIdentityCallValue();
    string functionalAssigned = "old";
    functionalAssigned = string(strcastIdentityCallValue());
    result &= Test("strcast returned call assignment functional value and ownership",
                   strcastSameStringResult(&plainFunctionalAssigned, &functionalAssigned), true);

    result &= Test("strcast returned call argument cast overload",
                   strcastIdentityRoute((string)strcastIdentityCallValue()) == 101
                       && strcastIdentityRoute(strcastIdentityCallValue()) == 101, true);
    result &= Test("strcast returned call argument functional overload",
                   strcastIdentityRoute(string(strcastIdentityCallValue())) == 101
                       && strcastIdentityRoute(strcastIdentityCallValue()) == 101, true);
    return result;
}

bool strcastTestTemporaryCastAllocationCounts()
{
    bool result = true;
    strcastFieldAllocCount = 0;
    strcastFieldFreeCount = 0;
    __alloc_audit_hook = strcastCountAlloc;
    __free_audit_hook = strcastCountFree;
    {
        string callCast = (string)(strcastIdentityCallValue());
    }
    bool callCastBalanced = strcastFieldAllocCount == 1 && strcastFieldFreeCount == 1;
    strcastFieldAllocCount = 0;
    strcastFieldFreeCount = 0;
    {
        string callFunctional = string(strcastIdentityCallValue());
    }
    bool callFunctionalBalanced = strcastFieldAllocCount == 1 && strcastFieldFreeCount == 1;
    strcastFieldAllocCount = 0;
    strcastFieldFreeCount = 0;
    {
        string tempFieldCast = (string)(strcastOwningTempBoxValue().name);
    }
    bool tempFieldBalanced = strcastFieldAllocCount == 1 && strcastFieldFreeCount == 1;
    __alloc_audit_hook = nullptr;
    __free_audit_hook = nullptr;
    result &= Test("strcast parenthesized call cast adopts one owned buffer",
                   callCastBalanced, true);
    result &= Test("strcast functional call cast adopts one owned buffer",
                   callFunctionalBalanced, true);
    result &= Test("strcast owning-temp field cast moves one owned buffer",
                   tempFieldBalanced, true);
    return result;
}

bool strcastTestLiteralPositions()
{
    bool result = true;
    string plainLocal = "cat";
    string castLocal = (string)"cat";
    result &= Test("strcast literal local declaration cast value and ownership",
                   strcastSameStringResult(&plainLocal, &castLocal), true);
    string plainFunctionalLocal = "cat";
    string functionalLocal = string("cat");
    result &= Test("strcast literal local declaration functional value and ownership",
                   strcastSameStringResult(&plainFunctionalLocal, &functionalLocal), true);

    string plainAssigned = "old"; plainAssigned = "cat";
    string castAssigned = "old"; castAssigned = (string)"cat";
    result &= Test("strcast literal assignment cast value and ownership",
                   strcastSameStringResult(&plainAssigned, &castAssigned), true);
    string plainFunctionalAssigned = "old"; plainFunctionalAssigned = "cat";
    string functionalAssigned = "old"; functionalAssigned = string("cat");
    result &= Test("strcast literal assignment functional value and ownership",
                   strcastSameStringResult(&plainFunctionalAssigned, &functionalAssigned), true);

    result &= Test("strcast literal call argument cast overload",
                   strcastIdentityRoute((string)"cat") == 101
                       && strcastIdentityRoute("cat") == 101, true);
    result &= Test("strcast literal call argument functional overload",
                   strcastIdentityRoute(string("cat")) == 101
                       && strcastIdentityRoute("cat") == 101, true);
    return result;
}

bool strcastTestBorrowPositions()
{
    bool result = true;
    char[4] bytes = {'c', 'a', 't', 0};
    string plainSource = string(bytes);
    string castSource = string(bytes);
    string plainLocal = plainSource;
    string castLocal = (string)castSource;
    result &= Test("strcast borrowed local declaration cast value and ownership",
                   strcastSameStringResult(&plainLocal, &castLocal), true);
    result &= Test("strcast borrowed local declaration cast source state",
                   strcastSameStringSource(&plainSource, &castSource), true);
    result &= Test("strcast borrowed cast preserves pointer and borrow",
                   ((string)castSource).data() == castSource.data()
                       && !(((string)castSource)._len < 0), true);

    string plainFunctionalSource = string(bytes);
    string functionalSource = string(bytes);
    string plainFunctionalLocal = plainFunctionalSource;
    string functionalLocal = string(functionalSource);
    result &= Test("strcast borrowed local declaration functional value and ownership",
                   strcastSameStringResult(&plainFunctionalLocal, &functionalLocal), true);
    result &= Test("strcast borrowed local declaration functional source state",
                   strcastSameStringSource(&plainFunctionalSource, &functionalSource), true);
    result &= Test("strcast borrowed functional preserves pointer and borrow",
                   string(functionalSource).data() == functionalSource.data()
                       && !(string(functionalSource)._len < 0), true);

    string plainAssignSource = string(bytes);
    string castAssignSource = string(bytes);
    string plainAssigned = "old"; plainAssigned = plainAssignSource;
    string castAssigned = "old"; castAssigned = (string)castAssignSource;
    result &= Test("strcast borrowed assignment cast value and ownership",
                   strcastSameStringResult(&plainAssigned, &castAssigned), true);
    string plainFunctionalAssignSource = string(bytes);
    string functionalAssignSource = string(bytes);
    string plainFunctionalAssigned = "old";
    plainFunctionalAssigned = plainFunctionalAssignSource;
    string functionalAssigned = "old";
    functionalAssigned = string(functionalAssignSource);
    result &= Test("strcast borrowed assignment functional value and ownership",
                   strcastSameStringResult(&plainFunctionalAssigned, &functionalAssigned), true);

    string plainCallSource = string(bytes);
    string castCallSource = string(bytes);
    result &= Test("strcast borrowed call argument cast overload",
                   strcastIdentityRoute((string)castCallSource) == 101
                       && strcastIdentityRoute(plainCallSource) == 101, true);
    string plainFunctionalCallSource = string(bytes);
    string functionalCallSource = string(bytes);
    result &= Test("strcast borrowed call argument functional overload",
                   strcastIdentityRoute(string(functionalCallSource)) == 101
                       && strcastIdentityRoute(plainFunctionalCallSource) == 101, true);
    return result;
}

bool strcastTestReturnPositions()
{
    bool result = true;
    string localPlain = strcastReturnLocal(0);
    string localCast = strcastReturnLocal(1);
    string localFunctional = strcastReturnLocal(2);
    result &= Test("strcast local return cast value and ownership",
                   strcastSameStringResult(&localPlain, &localCast), true);
    result &= Test("strcast local return functional value and ownership",
                   strcastSameStringResult(&localPlain, &localFunctional), true);

    string paramPlain = strcastReturnParam(string("cat").copy(), 0);
    string paramCast = strcastReturnParam(string("cat").copy(), 1);
    string paramFunctional = strcastReturnParam(string("cat").copy(), 2);
    result &= Test("strcast param return cast value and ownership",
                   strcastSameStringResult(&paramPlain, &paramCast), true);
    result &= Test("strcast param return functional value and ownership",
                   strcastSameStringResult(&paramPlain, &paramFunctional), true);

    string fieldPlain = strcastReturnField(0);
    string fieldCast = strcastReturnField(1);
    string fieldFunctional = strcastReturnField(2);
    result &= Test("strcast field return cast value and ownership",
                   strcastSameStringResult(&fieldPlain, &fieldCast), true);
    result &= Test("strcast field return functional value and ownership",
                   strcastSameStringResult(&fieldPlain, &fieldFunctional), true);

    string callPlain = strcastReturnCall(0);
    string callCast = strcastReturnCall(1);
    string callFunctional = strcastReturnCall(2);
    result &= Test("strcast returned call return cast value and ownership",
                   strcastSameStringResult(&callPlain, &callCast), true);
    result &= Test("strcast returned call return functional value and ownership",
                   strcastSameStringResult(&callPlain, &callFunctional), true);

    string literalPlain = strcastReturnLiteral(0);
    string literalCast = strcastReturnLiteral(1);
    string literalFunctional = strcastReturnLiteral(2);
    result &= Test("strcast literal return cast value and ownership",
                   strcastSameStringResult(&literalPlain, &literalCast), true);
    result &= Test("strcast literal return functional value and ownership",
                   strcastSameStringResult(&literalPlain, &literalFunctional), true);
    return result;
}

bool testStringType()
{
    bool result = true;

    string s = "hello";

    result &= Test("string_length", s.length(), 5);
    result &= Test("string_data", s.data(), "hello");

    string s2 = "world!!";
    result &= Test("string2_length", s2.length(), 7);
    result &= Test("string2_data", s2.data(), "world!!");

    // STRCTOR accept-set: functional construction must preserve these cast/view forms.
    char[5] strctorBytes = {'c', 'a', 't', 0, 0};
    char* strctorPtr = &strctorBytes[0];
    string strctorCastPointer = (string)strctorPtr;
    result &= Test("strctor cast pointer value and length",
                   strctorCastPointer == "cat" && strctorCastPointer.length() == 3, true);
    result &= Test("strctor cast pointer keeps borrow identity",
                   strctorCastPointer.data() == strctorPtr, true);
    result &= Test("strctor cast pointer stays borrowed",
                   (strctorCastPointer._len & (i32)0x80000000) == 0, true);

    string strctorCastArray = (string)strctorBytes;
    result &= Test("strctor cast fixed array value and length",
                   strctorCastArray == "cat" && strctorCastArray.length() == 3, true);
    result &= Test("strctor cast fixed array keeps borrow identity",
                   strctorCastArray.data() == strctorPtr, true);

    char[] strctorCharView = (char[])strctorPtr;
    string strctorCastView = (string)strctorCharView;
    result &= Test("strctor cast array view value and length",
                   strctorCastView == "cat" && strctorCastView.length() == 3, true);
    result &= Test("strctor cast array view keeps borrow identity",
                   strctorCastView.data() == strctorPtr, true);

    string_view strctorView = string_view(strctorPtr, 2);
    result &= Test("strctor string_view i32 value and length",
                   strctorView.length() == 2 && strctorView.data() == strctorPtr, true);

    // STRCAST accept-set: these identity casts already worked before the string fix.
    int strcastIntSource = 17;
    result &= Test("strcast identity int value", (int)strcastIntSource, 17);
    StrcastIdentityBox strcastBoxSource = { value = 31 };
    StrcastIdentityBox strcastBoxCopy = (StrcastIdentityBox)strcastBoxSource;
    result &= Test("strcast identity struct value", strcastBoxCopy.value, 31);
    string_view strcastViewSource = string_view(strctorPtr, 3);
    string_view strcastViewCopy = (string_view)strcastViewSource;
    result &= Test("strcast identity view value and borrow",
                   strcastViewCopy.length() == 3 && strcastViewCopy.data() == strctorPtr, true);

    string strcastConcatSource = string("ab").copy();
    string strcastConcatPlain = strcastConcatSource + "c";
    string strcastConcatCast = (string)(strcastConcatSource + "c");
    string strcastConcatFunctional = string(strcastConcatSource + "c");
    result &= Test("strcast functional concat matches cast value and ownership",
                   strcastConcatPlain == strcastConcatCast
                       && strcastConcatPlain == strcastConcatFunctional
                       && strcastSameStringResult(&strcastConcatCast, &strcastConcatFunctional), true);

    int x = 3;
    string strcastInterpPlain = "a{x}";
    string strcastInterpCast = (string)"a{x}";
    string strcastInterpFunctional = string("a{x}");
    result &= Test("strcast local interpolated cast matches bare literal",
                   strcastInterpPlain == strcastInterpCast
                       && strcastInterpPlain.length() == 2, true);
    result &= Test("strcast local interpolated functional form matches bare literal",
                   strcastInterpPlain == strcastInterpFunctional
                       && strcastInterpPlain.length() == 2, true);

    result &= strcastTestLocalPositions();
    result &= strcastParamLocalCast(string("cat").copy(), string("cat").copy());
    result &= strcastParamLocalFunctional(string("cat").copy(), string("cat").copy());
    result &= strcastParamAssignCast(string("cat").copy(), string("cat").copy());
    result &= strcastParamAssignFunctional(string("cat").copy(), string("cat").copy());
    result &= strcastParamCallCast(string("cat").copy(), string("cat").copy());
    result &= strcastParamCallFunctional(string("cat").copy(), string("cat").copy());
    result &= strcastTestFieldPositions();
    strcastFieldAllocCount = 0;
    strcastFieldFreeCount = 0;
    __alloc_audit_hook = strcastCountAlloc;
    __free_audit_hook = strcastCountFree;
    {
        StrcastImplicitThisBox strcastImplicitCastBox = default;
        strcastImplicitCastBox.name = string("cat").copy();
        result &= Test("strcast implicit-this parenthesized identity cast value and destruction",
                       strcastImplicitCastBox.castCopyIndependent(), true);
        StrcastImplicitThisBox strcastImplicitFunctionalBox = default;
        strcastImplicitFunctionalBox.name = string("cat").copy();
        result &= Test("strcast implicit-this functional identity cast value and destruction",
                       strcastImplicitFunctionalBox.functionalCopyIndependent(), true);
    }
    __alloc_audit_hook = nullptr;
    __free_audit_hook = nullptr;
    result &= Test("strcast implicit-this identity casts allocate and free four buffers",
                   strcastFieldAllocCount == 4 && strcastFieldFreeCount == 4, true);
    result &= strcastTestTemporaryCastAllocationCounts();
    result &= strcastTestReturnedCallPositions();
    result &= strcastTestLiteralPositions();
    result &= strcastTestBorrowPositions();
    result &= strcastTestReturnPositions();
    result &= Test("strcast global literal cast folds like bare literal",
                   strcastGlobalCast == strcastGlobalBare
                       && strcastGlobalCast.length() == 3, true);
    result &= Test("strcast global literal functional form folds like bare literal",
                   strcastGlobalFunctional == strcastGlobalBare
                       && strcastGlobalFunctional.length() == 3, true);
    result &= Test("strcast const global literal cast folds like bare literal",
                   strcastConstGlobalCast == strcastConstGlobalBare
                       && strcastConstGlobalCast.length() == 3, true);
    result &= Test("strcast const global literal functional form folds like bare literal",
                   strcastConstGlobalFunctional == strcastConstGlobalBare
                       && strcastConstGlobalFunctional.length() == 3, true);

    string strctorOne = string(strctorPtr);
    result &= Test("strctor one-arg equals cast form",
                   strctorOne == strctorCastPointer && strctorOne.length() == 3, true);
    result &= Test("strctor one-arg keeps pointer identity",
                   strctorOne.data() == strctorPtr, true);
    result &= Test("strctor one-arg remains borrowed",
                   (strctorOne._len & (i32)0x80000000) == 0, true);
    result &= Test("strctor one-arg sizeof matches cast",
                   sizeof(strctorOne) == sizeof(strctorCastPointer), true);

    string strctorOneArray = string(strctorBytes);
    result &= Test("strctor one-arg fixed array decays",
                   strctorOneArray == "cat" && strctorOneArray.data() == strctorPtr, true);
    string strctorOneView = string(strctorCharView);
    result &= Test("strctor one-arg array view keeps identity",
                   strctorOneView == "cat" && strctorOneView.data() == strctorPtr, true);
    const char* strctorConstPtr = strctorPtr;
    string strctorOneConst = string(strctorConstPtr);
    result &= Test("strctor one-arg const char pointer",
                   strctorOneConst == "cat" && strctorOneConst.data() == strctorConstPtr, true);
    string strctorOneLiteral = string("cat");
    result &= Test("strctor one-arg string literal stays borrowed",
                   strctorOneLiteral == "cat" && strctorOneLiteral.length() == 3
                       && strctorOneLiteral.data() == "cat"
                       && (strctorOneLiteral._len & (i32)0x80000000) == 0, true);
    // Suffixed one-arg and literal forms take a receiver; values match the cast twins.
    char[3] strctorSuffixBytes = {'a', 'b', 0};
    char* strctorSuffixPtr = &strctorSuffixBytes[0];
    result &= Test("strctor one-arg length suffix", string(strctorSuffixPtr).length(), 2);
    result &= Test("strctor one-arg length suffix matches cast twin",
                   ((string)strctorSuffixPtr).length(), 2);
    result &= Test("strctor one-arg data suffix keeps identity",
                   string(strctorSuffixPtr).data() == strctorSuffixPtr, true);
    result &= Test("strctor one-arg data suffix matches cast twin",
                   ((string)strctorSuffixPtr).data() == strctorSuffixPtr, true);
    result &= Test("strctor literal length suffix chain", string("cat").length(), 3);
    // Discarded suffixed value: the leg is that it compiles and runs.
    string(strctorSuffixPtr).length();

    string strctorReturned = strctorReturnBorrowedString(string(strctorPtr));
    result &= Test("strctor return preserves borrowed bytes",
                   strctorReturned == "cat" && strctorReturned.data() == strctorPtr, true);
    result &= Test("strctor return stays borrowed",
                   (strctorReturned._len & (i32)0x80000000) == 0, true);
    result &= Test("strctor pass observes length",
                   strctorObserveBorrowedString(string(strctorPtr)), 3);

    char[4] strctorBytesNoTerminator = {'a', 'b', 'c', 'd'};
    char* strctorNoTerminatorPtr = &strctorBytesNoTerminator[0];
    string strctorTwo = string(strctorNoTerminatorPtr, 3);
    result &= Test("strctor two-arg explicit length value",
                   strctorTwo == "abc" && strctorTwo.length() == 3, true);
    result &= Test("strctor two-arg keeps pointer identity",
                   strctorTwo.data() == strctorNoTerminatorPtr, true);
    result &= Test("strctor two-arg remains borrowed",
                   (strctorTwo._len & (i32)0x80000000) == 0, true);
    string strctorTwoArray = string(strctorBytesNoTerminator, 2);
    result &= Test("strctor two-arg fixed array decay",
                   strctorTwoArray == "ab" && strctorTwoArray.data() == strctorNoTerminatorPtr, true);
    char[] strctorNoTerminatorView = (char[])strctorNoTerminatorPtr;
    string strctorTwoView = string(strctorNoTerminatorView, 3);
    result &= Test("strctor two-arg array view",
                   strctorTwoView == "abc" && strctorTwoView.data() == strctorNoTerminatorPtr, true);
    i64 strctorWideLength = 2;
    string strctorTwoWide = string(strctorNoTerminatorPtr, strctorWideLength);
    result &= Test("strctor two-arg i64 length",
                   strctorTwoWide == "ab" && strctorTwoWide.length() == 2
                       && strctorTwoWide.data() == strctorNoTerminatorPtr, true);

    // Frozen STRRETGATE accept-set controls: caller, global, heap, literal, and same-frame
    // values must keep their borrowed pointer and bytes through cast and constructor lowering.
    char[4] strctorCallerBytes = {'c', 'a', 't', 0};
    char* strctorCallerPtr = &strctorCallerBytes[0];
    string fromParamCast = strctorParamCastReturn(strctorCallerPtr);
    result &= Test("strctor param bare cast return value and identity",
                   fromParamCast == "cat" && fromParamCast.data() == strctorCallerPtr, true);
    string fromParamParenCast = strctorParamParenCastReturn(strctorCallerPtr);
    result &= Test("strctor param parenthesized cast return value and identity",
                   fromParamParenCast == "cat" && fromParamParenCast.data() == strctorCallerPtr, true);
    string fromParamFunctional = strctorParamFunctionalReturn(strctorCallerPtr);
    result &= Test("strctor param functional return value and identity",
                   fromParamFunctional == "cat" && fromParamFunctional.data() == strctorCallerPtr, true);
    string fromParamLength = strctorParamLengthReturn(strctorCallerPtr);
    result &= Test("strctor param two-arg return value and identity",
                   fromParamLength == "cat" && fromParamLength.data() == strctorCallerPtr, true);
    string_view fromParamView = strctorParamViewReturn(strctorCallerPtr);
    result &= Test("strctor param string_view return value and identity",
                   fromParamView.length() == 3 && fromParamView.data() == strctorCallerPtr, true);
    string_view fromUserFnPointer = strctorUserFnViewPointerProbe();
    result &= Test("strctor user function string_view pointer arg keeps global result",
                   fromUserFnPointer.length() == 3
                       && fromUserFnPointer.data() == &strctorGlobalBorrowBytes[0]
                       && fromUserFnPointer.data()[0] == 'c', true);
    string_view fromUserFnArray = strctorUserFnViewArrayProbe();
    result &= Test("strctor user function string_view array arg keeps global result",
                   fromUserFnArray.length() == 3
                       && fromUserFnArray.data() == &strctorGlobalBorrowBytes[0]
                       && fromUserFnArray.data()[0] == 'c', true);
    string_view fromUserMethod = strctorUserMethodViewProbe();
    result &= Test("strctor user method string_view array arg keeps global result",
                   fromUserMethod.length() == 3
                       && fromUserMethod.data() == &strctorGlobalBorrowBytes[0]
                       && fromUserMethod.data()[0] == 'c', true);
    string_view fromGlobalJoinTrue = strctorGlobalViewJoin(true);
    string_view fromGlobalJoinFalse = strctorGlobalViewJoin(false);
    result &= Test("strretgate string_view global join values and branch selection",
                   fromGlobalJoinTrue.length() * 10 + fromGlobalJoinFalse.length() == 32
                       && fromGlobalJoinTrue.data() == &strctorGlobalBorrowBytes[0]
                       && fromGlobalJoinFalse.data() == &strctorGlobalBorrowBytes[0], true);
    result &= Test("strretgate string_view local join stays within frame",
                   strctorLocalViewJoinUse(), 399);
    string fromParamAddress = strctorParamAddressReturn(strctorCallerPtr);
    result &= Test("strctor param address cast return value and identity",
                   fromParamAddress == "cat" && fromParamAddress.data() == strctorCallerPtr, true);
    string fromParamTernary = strctorParamTernaryReturn(strctorCallerPtr);
    result &= Test("strctor param ternary return value",
                   fromParamTernary == "cat" && fromParamTernary.length() == 3, true);

    strctorGlobalBorrowSlot = string(strctorGlobalBorrowBytes, 3);
    result &= Test("strctor global two-arg store value and identity",
                   strctorGlobalBorrowSlot == "cat"
                       && strctorGlobalBorrowSlot.data() == &strctorGlobalBorrowBytes[0], true);
    strctorGlobalBorrowSlot = default;

    StrctorStackByteMember strctorMember = default;
    strctorMember.bytes[0] = 'c'; strctorMember.bytes[1] = 'a';
    strctorMember.bytes[2] = 't'; strctorMember.bytes[3] = 0;
    string strctorMemberString = (string)strctorMember.bytes;
    result &= Test("strctor local struct field stays usable in frame",
                   strctorMemberString == "cat" && strctorMemberString.length() == 3, true);
    string_view strctorMemberView = string_view(strctorMember.bytes, 3);
    result &= Test("strctor local struct view stays usable in frame",
                   strctorMemberView.length() == 3
                       && strctorMemberView.data() == &strctorMember.bytes[0], true);

    string_view fromAssignmentParam = strctorAssignmentParamView(strctorCallerPtr);
    result &= Test("strctor assignment param root value and identity",
                   fromAssignmentParam.length() == 3
                       && fromAssignmentParam.data() == strctorCallerPtr
                       && fromAssignmentParam.data()[0] == 'c', true);
    string_view fromAssignmentGlobal = strctorAssignmentGlobalView();
    result &= Test("strctor assignment global root value and identity",
                   fromAssignmentGlobal.length() == 3
                       && fromAssignmentGlobal.data() == &strctorGlobalBorrowBytes[0], true);
    string_view fromAssignmentHeap = strctorAssignmentHeapView();
    result &= Test("strctor assignment heap root value and identity",
                   fromAssignmentHeap.length() == 3
                       && fromAssignmentHeap.data() == strctorAssignHeapPointer
                       && fromAssignmentHeap.data()[2] == 't', true);
    delete[] strctorAssignHeapPointer;
    strctorAssignHeapPointer = nullptr;
    string_view fromAssignmentLiteral = strctorAssignmentLiteralView();
    result &= Test("strctor assignment literal root value",
                   fromAssignmentLiteral.length() == 3
                       && fromAssignmentLiteral.data()[0] == 'l'
                       && fromAssignmentLiteral.data()[2] == 't', true);
    string assignmentRebindLiteral = strctorAssignmentRebindLiteralReturn();
    result &= Test("strctor assignment literal clears prior stack borrow",
                   assignmentRebindLiteral == "ok"
                       && assignmentRebindLiteral.length() == 2, true);
    result &= Test("strctor assignment same-frame result value",
                   strctorAssignmentSameFrameView(), 415);
    int assignmentCompoundLeft = strctorAssignmentCompoundStackLeft();
    result &= Test("strctor string compound assignment over stack value owns result",
                   assignmentCompoundLeft, 599);
    string assignmentCompoundReturn = strctorAssignmentCompoundStackReturn();
    result &= Test("strctor string compound assignment return owns result",
                   assignmentCompoundReturn == "base"
                       && (assignmentCompoundReturn._len & (i32)0x80000000) != 0, true);
    string assignmentCompoundRight = strctorAssignmentCompoundStackRight();
    result &= Test("strctor string compound assignment with stack RHS owns result",
                   assignmentCompoundRight == "xhi"
                       && (assignmentCompoundRight._len & (i32)0x80000000) != 0, true);

    string borrowFlowStraight = strctorBorrowFlowReturnStraight();
    result &= Test("strctor borrowflow += straight return value and owner",
                   borrowFlowStraight == "bx" && borrowFlowStraight.length() == 2
                       && (borrowFlowStraight._len & (i32)0x80000000) != 0, true);
    string borrowFlowIfThen = strctorBorrowFlowReturnIfElse(1);
    string borrowFlowIfElse = strctorBorrowFlowReturnIfElse(0);
    result &= Test("strctor borrowflow += if else return values and owners",
                   borrowFlowIfThen == "bx" && borrowFlowIfElse == "by"
                       && (borrowFlowIfThen._len & (i32)0x80000000) != 0
                       && (borrowFlowIfElse._len & (i32)0x80000000) != 0, true);
    string borrowFlowElseIf0 = strctorBorrowFlowReturnElseIf(0);
    string borrowFlowElseIf1 = strctorBorrowFlowReturnElseIf(1);
    string borrowFlowElseIf2 = strctorBorrowFlowReturnElseIf(2);
    result &= Test("strctor borrowflow += else if return values and owners",
                   borrowFlowElseIf0 == "ba" && borrowFlowElseIf1 == "bb"
                       && borrowFlowElseIf2 == "bc"
                       && (borrowFlowElseIf0._len & (i32)0x80000000) != 0
                       && (borrowFlowElseIf1._len & (i32)0x80000000) != 0
                       && (borrowFlowElseIf2._len & (i32)0x80000000) != 0, true);
    string borrowFlowSwitch0 = strctorBorrowFlowReturnSwitch(0);
    string borrowFlowSwitch1 = strctorBorrowFlowReturnSwitch(1);
    string borrowFlowSwitch2 = strctorBorrowFlowReturnSwitch(2);
    result &= Test("strctor borrowflow += switch fallthrough return values and owners",
                   borrowFlowSwitch0 == "bxxx" && borrowFlowSwitch1 == "bxx"
                       && borrowFlowSwitch2 == "bx"
                       && (borrowFlowSwitch0._len & (i32)0x80000000) != 0
                       && (borrowFlowSwitch1._len & (i32)0x80000000) != 0
                       && (borrowFlowSwitch2._len & (i32)0x80000000) != 0, true);
    string borrowFlowDo2 = strctorBorrowFlowReturnDoWhile(2);
    string borrowFlowDo3 = strctorBorrowFlowReturnDoWhile(3);
    result &= Test("strctor borrowflow += do while return values and owners",
                   borrowFlowDo2 == "bx" && borrowFlowDo3 == "bxx"
                       && (borrowFlowDo2._len & (i32)0x80000000) != 0
                       && (borrowFlowDo3._len & (i32)0x80000000) != 0, true);
    string borrowFlowEarly0 = strctorBorrowFlowReturnEarly(0);
    string borrowFlowEarly1 = strctorBorrowFlowReturnEarly(1);
    result &= Test("strctor borrowflow += early return paths preserve values",
                   borrowFlowEarly0 == "bx" && borrowFlowEarly1 == "early"
                       && (borrowFlowEarly0._len & (i32)0x80000000) != 0, true);

    strctorBorrowFlowGlobalStraight();
    bool borrowFlowGlobalStraightOk = strctorBorrowFlowGlobal == "bx"
        && strctorBorrowFlowGlobal.length() == 2
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalIfElse(1);
    bool borrowFlowGlobalIfThenOk = strctorBorrowFlowGlobal == "bx"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalIfElse(0);
    bool borrowFlowGlobalIfElseOk = strctorBorrowFlowGlobal == "by"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    result &= Test("strctor borrowflow += global store values and owners",
                   borrowFlowGlobalStraightOk && borrowFlowGlobalIfThenOk
                       && borrowFlowGlobalIfElseOk, true);
    strctorBorrowFlowGlobalElseIf(0);
    bool borrowFlowGlobalElseIf0Ok = strctorBorrowFlowGlobal == "ba"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalElseIf(1);
    bool borrowFlowGlobalElseIf1Ok = strctorBorrowFlowGlobal == "bb"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalElseIf(2);
    bool borrowFlowGlobalElseIf2Ok = strctorBorrowFlowGlobal == "bc"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    result &= Test("strctor borrowflow += else if global values and owners",
                   borrowFlowGlobalElseIf0Ok && borrowFlowGlobalElseIf1Ok
                       && borrowFlowGlobalElseIf2Ok, true);
    strctorBorrowFlowGlobalSwitch(0);
    bool borrowFlowGlobalSwitch0Ok = strctorBorrowFlowGlobal == "bxxx"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalSwitch(1);
    bool borrowFlowGlobalSwitch1Ok = strctorBorrowFlowGlobal == "bxx"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalSwitch(2);
    bool borrowFlowGlobalSwitch2Ok = strctorBorrowFlowGlobal == "bx"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    result &= Test("strctor borrowflow += switch global values and owners",
                   borrowFlowGlobalSwitch0Ok && borrowFlowGlobalSwitch1Ok
                       && borrowFlowGlobalSwitch2Ok, true);
    strctorBorrowFlowGlobalDoWhile(2);
    bool borrowFlowGlobalDo2Ok = strctorBorrowFlowGlobal == "bx"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalDoWhile(3);
    bool borrowFlowGlobalDo3Ok = strctorBorrowFlowGlobal == "bxx"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    result &= Test("strctor borrowflow += do while global values and owners",
                   borrowFlowGlobalDo2Ok && borrowFlowGlobalDo3Ok, true);
    strctorBorrowFlowGlobalEarly(0);
    bool borrowFlowGlobalEarly0Ok = strctorBorrowFlowGlobal == "bx"
        && (strctorBorrowFlowGlobal._len & (i32)0x80000000) != 0;
    strctorBorrowFlowGlobal = default;
    strctorBorrowFlowGlobalEarly(1);
    bool borrowFlowGlobalEarly1Ok = strctorBorrowFlowGlobal == "early";
    strctorBorrowFlowGlobal = default;
    result &= Test("strctor borrowflow += early return global values and owners",
                   borrowFlowGlobalEarly0Ok && borrowFlowGlobalEarly1Ok, true);

    StrctorBorrowFlowHolder borrowFlowHolder = default;
    strctorBorrowFlowFieldStraight(&borrowFlowHolder);
    bool borrowFlowFieldStraightOk = borrowFlowHolder.s == "bx"
        && borrowFlowHolder.s.length() == 2
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldIfElse(&borrowFlowHolder, 1);
    bool borrowFlowFieldIfThenOk = borrowFlowHolder.s == "bx"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldIfElse(&borrowFlowHolder, 0);
    bool borrowFlowFieldIfElseOk = borrowFlowHolder.s == "by"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    result &= Test("strctor borrowflow += field store values and owners",
                   borrowFlowFieldStraightOk && borrowFlowFieldIfThenOk
                       && borrowFlowFieldIfElseOk, true);
    strctorBorrowFlowFieldElseIf(&borrowFlowHolder, 0);
    bool borrowFlowFieldElseIf0Ok = borrowFlowHolder.s == "ba"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldElseIf(&borrowFlowHolder, 1);
    bool borrowFlowFieldElseIf1Ok = borrowFlowHolder.s == "bb"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldElseIf(&borrowFlowHolder, 2);
    bool borrowFlowFieldElseIf2Ok = borrowFlowHolder.s == "bc"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    result &= Test("strctor borrowflow += else if field values and owners",
                   borrowFlowFieldElseIf0Ok && borrowFlowFieldElseIf1Ok
                       && borrowFlowFieldElseIf2Ok, true);
    strctorBorrowFlowFieldSwitch(&borrowFlowHolder, 0);
    bool borrowFlowFieldSwitch0Ok = borrowFlowHolder.s == "bxxx"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldSwitch(&borrowFlowHolder, 1);
    bool borrowFlowFieldSwitch1Ok = borrowFlowHolder.s == "bxx"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldSwitch(&borrowFlowHolder, 2);
    bool borrowFlowFieldSwitch2Ok = borrowFlowHolder.s == "bx"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    result &= Test("strctor borrowflow += switch field values and owners",
                   borrowFlowFieldSwitch0Ok && borrowFlowFieldSwitch1Ok
                       && borrowFlowFieldSwitch2Ok, true);
    strctorBorrowFlowFieldDoWhile(&borrowFlowHolder, 2);
    bool borrowFlowFieldDo2Ok = borrowFlowHolder.s == "bx"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldDoWhile(&borrowFlowHolder, 3);
    bool borrowFlowFieldDo3Ok = borrowFlowHolder.s == "bxx"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    result &= Test("strctor borrowflow += do while field values and owners",
                   borrowFlowFieldDo2Ok && borrowFlowFieldDo3Ok, true);
    strctorBorrowFlowFieldEarly(&borrowFlowHolder, 0);
    bool borrowFlowFieldEarly0Ok = borrowFlowHolder.s == "bx"
        && (borrowFlowHolder.s._len & (i32)0x80000000) != 0;
    borrowFlowHolder.s = default;
    strctorBorrowFlowFieldEarly(&borrowFlowHolder, 1);
    bool borrowFlowFieldEarly1Ok = borrowFlowHolder.s == "early";
    borrowFlowHolder.s = default;
    result &= Test("strctor borrowflow += early return field values and owners",
                   borrowFlowFieldEarly0Ok && borrowFlowFieldEarly1Ok, true);

    // The assignment value is the destination after the store, for every owner consumer.
    result &= Test("chainstruct string chained declaration allocation/free", chainStructStringDecl(), 3322);
    result &= Test("chainstruct owning struct call declaration", chainStructOwnerCase(0, 0), 3322);
    result &= Test("chainstruct owning struct call assignment", chainStructOwnerCase(0, 1), 3322);
    result &= Test("chainstruct owning struct named declaration", chainStructOwnerCase(1, 0), 3333);
    result &= Test("chainstruct owning struct named assignment", chainStructOwnerCase(1, 1), 3333);
    result &= Test("chainstruct string call return allocation/free", chainStructStringReturnCase(0), 311);
    result &= Test("chainstruct string move return allocation/free", chainStructStringReturnCase(1), 311);
    result &= Test("chainstruct string named return allocation/free", chainStructStringReturnCase(2), 322);
    result &= Test("chainstruct dtor call declaration count", chainStructDtorCase(0, 0), 554);
    result &= Test("chainstruct dtor call assignment count", chainStructDtorCase(0, 1), 555);
    result &= Test("chainstruct dtor named declaration count", chainStructDtorCase(1, 0), 555);
    result &= Test("chainstruct dtor named assignment count", chainStructDtorCase(1, 1), 556);
    result &= Test("chainstruct dtor literal declaration count", chainStructDtorCase(2, 0), 3);
    result &= Test("chainstruct dtor literal assignment count", chainStructDtorCase(2, 1), 4);
    result &= Test("chainstruct unique move return dtor count", chainStructUniqueReturnCase(0), 51);
    result &= Test("chainstruct unique named return dtor count", chainStructUniqueReturnCase(1), 51);
    bool parenStringAssignMatches = true;
    for (int destination = 0; destination < 5; destination++)
        for (int spelling = 0; spelling < 3; spelling++)
            parenStringAssignMatches = parenStringAssignMatches
                && chainStructParenStringAssign(destination, spelling) == 301010;
    result &= Test("parenthesized owned string assignment across destinations",
                   parenStringAssignMatches, true);
    bool parenOwnerAssignMatches = true;
    for (int source = 0; source < 4; source++)
        for (int spelling = 0; spelling < 3; spelling++)
            parenOwnerAssignMatches = parenOwnerAssignMatches
                && chainStructParenOwnerAssign(source, spelling)
                    == (source == 2 ? 302020 : 301010);
    result &= Test("parenthesized owning struct assignment source values",
                   parenOwnerAssignMatches, true);
    result &= Test("parenthesized unique result assignment destructor count",
                   chainStructParenUniqueAssign(0) == 51
                       && chainStructParenUniqueAssign(1) == 51
                       && chainStructParenUniqueAssign(2) == 51, true);
    result &= Test("parenthesized value-dtor result assignment count",
                   chainStructParenDtorAssign(0) == 53
                       && chainStructParenDtorAssign(1) == 53
                       && chainStructParenDtorAssign(2) == 53, true);
    result &= Test("parenthesized compound assignment operands stay transparent",
                   chainStructParenStringCompound(0) == 403030
                       && chainStructParenStringCompound(1) == 403030
                       && chainStructParenStringCompound(2) == 403030, true);

    char* strctorHeapBorrowBytes = new char[4];
    strctorHeapBorrowBytes[0] = 'c'; strctorHeapBorrowBytes[1] = 'a';
    strctorHeapBorrowBytes[2] = 't'; strctorHeapBorrowBytes[3] = 0;
    string strctorHeapBorrow = (string)strctorHeapBorrowBytes;
    string_view strctorHeapView = string_view(strctorHeapBorrowBytes, 3);
    result &= Test("strctor heap source cast and view values",
                   strctorHeapBorrow == "cat" && strctorHeapView.length() == 3
                       && strctorHeapBorrow.data() == strctorHeapBorrowBytes
                       && strctorHeapView.data() == strctorHeapBorrowBytes, true);
    strctorHeapBorrow = default;
    delete[] strctorHeapBorrowBytes;

    string strctorLiteralTernary = true ? (string)"cat" : "x";
    result &= Test("strctor literal ternary value",
                   strctorLiteralTernary == "cat" && strctorLiteralTernary.length() == 3, true);

    string strctorLocalTernaryReturn = strctorLocalArrayTernaryReturn();
    result &= Test("strctor local stack ternary return owns its value",
                   strctorLocalTernaryReturn == "cat"
                       && (strctorLocalTernaryReturn._len & (i32)0x80000000) != 0, true);
    string strctorMemberTernaryReturn = strctorLocalMemberTernaryReturn();
    result &= Test("strctor local member ternary return owns its value",
                   strctorMemberTernaryReturn == "cat"
                       && (strctorMemberTernaryReturn._len & (i32)0x80000000) != 0, true);
    strctorLocalArrayTernaryStoreGlobal();
    result &= Test("strctor local stack ternary global store owns its value",
                   strctorGlobalBorrowSlot == "cat"
                       && (strctorGlobalBorrowSlot._len & (i32)0x80000000) != 0, true);
    strctorGlobalBorrowSlot = default;
    StrctorStringHolder strctorTernaryHolder = default;
    strctorLocalArrayTernaryStoreField(&strctorTernaryHolder);
    result &= Test("strctor local stack ternary field store owns its value",
                   strctorTernaryHolder.s == "cat"
                       && (strctorTernaryHolder.s._len & (i32)0x80000000) != 0, true);
    string strctorTernaryOut = default;
    strctorLocalArrayTernaryOut(&strctorTernaryOut);
    result &= Test("strctor local stack ternary out parameter owns its value",
                   strctorTernaryOut == "cat"
                       && (strctorTernaryOut._len & (i32)0x80000000) != 0, true);
    string dynamicCastTernary = strctorDynamicLocalArrayTernaryReturn(true);
    result &= Test("strctor dynamic cast ternary return copies stack value",
                   dynamicCastTernary == "cat" && dynamicCastTernary.length() == 3
                       && (dynamicCastTernary._len & (i32)0x80000000) != 0, true);
    string dynamicFunctionalTernary = strctorDynamicLocalArrayFunctionalTernaryReturn(true);
    result &= Test("strctor dynamic functional ternary return copies stack value",
                   dynamicFunctionalTernary == "cat" && dynamicFunctionalTernary.length() == 3
                       && (dynamicFunctionalTernary._len & (i32)0x80000000) != 0, true);
    string dynamicNamedTernary = strctorDynamicLocalArrayNamedTernaryReturn(true);
    result &= Test("strctor dynamic named ternary return copies stack value",
                   dynamicNamedTernary == "cat" && dynamicNamedTernary.length() == 3
                       && (dynamicNamedTernary._len & (i32)0x80000000) != 0, true);
    string dynamicAssignmentTernary = strctorDynamicLocalArrayAssignmentTernaryReturn(true);
    result &= Test("strctor dynamic assignment ternary return copies stack value",
                   dynamicAssignmentTernary == "cat" && dynamicAssignmentTernary.length() == 3
                       && (dynamicAssignmentTernary._len & (i32)0x80000000) != 0, true);
    string dynamicNestedTernary = strctorDynamicLocalArrayNestedTernaryReturn(true);
    result &= Test("strctor dynamic nested ternary return copies stack value",
                   dynamicNestedTernary == "cat" && dynamicNestedTernary.length() == 3
                       && (dynamicNestedTernary._len & (i32)0x80000000) != 0, true);
    result &= Test("strctor moved stack borrow stays borrowed in same frame",
                   strctorMovedBorrowTernarySameFrame(true), 4150);
    result &= Test("strctor moved heap value stays owned in same frame",
                   strctorMovedBorrowTernarySameFrame(false), 3111);

    return result;
}

// Regression: a chained access `structValue.field.method()` where `field` is a primitive
// must bind the FIELD VALUE as the method receiver, not the parent struct. Covers a struct
// local base and a `this` base inside a member method.
struct ChainPoint
{
    int x = 0;
    int y = 0;
    string xStr() { return this.x.toString(); }
};

bool testChainedFieldUFCS()
{
    bool result = true;

    ChainPoint p = default;
    p.x = 5;
    p.y = 42;

    // Local struct base: p.x.toString() must operate on x (int), not p (ChainPoint).
    string sx = p.x.toString();
    result &= Test("chain_field_local_x", sx.data(), "5");
    string sy = p.y.toString();
    result &= Test("chain_field_local_y", sy.data(), "42");

    // `this` base inside a method: this.x.toString().
    string sthis = p.xStr();
    result &= Test("chain_field_this", sthis.data(), "5");

    return result;
}

// Tests the built-in string literal syntax: string s = "...";
// A string literal is automatically wrapped in a string struct { _ptr, _len }.
bool testStringLiteral()
{
    bool result = true;

    // Basic assignment from a string literal
    string s = "hello";
    result &= Test("str_lit_length",      s.length(), 5);
    result &= Test("str_lit_data",     s.data(),  "hello");

    // Longer literal - the canonical use case: string s = "My test string";
    string s2 = "My test string";
    result &= Test("str_lit_long_length", s2.length(), 14);
    result &= Test("str_lit_long_data", s2.data(), "My test string");

    // Empty string literal
    string s3 = "";
    result &= Test("str_lit_empty_length", s3.length(), 0);
    result &= Test("str_lit_empty_data", s3.data(), "");

    // String with escape sequences - \n counts as one character
    string s4 = "line1\nline2";
    result &= Test("str_lit_escape_length", s4.length(), 11);

    // Raw strings preserve escapes and braces, including quotes under a matching hash delimiter.
    const char* rawText = r"line\n{n}";
    result &= Test("raw_string_verbatim", strcmp(rawText, "line\\n\{n\}"), 0);
    const char* rawQuoted = r##"say "hi" and "# still"##;
    result &= Test("raw_string_hash_quote", strcmp(rawQuoted, "say \"hi\" and \"# still"), 0);
    const char* rawTriple = r###"a "## b "## c"###;
    result &= Test("raw_string_three_hashes", strcmp(rawTriple, "a \"## b \"## c"), 0);
    const char* rawMultiline = r#"first
second"#;
    result &= Test("raw_string_multiline", strcmp(rawMultiline, "first\nsecond"), 0);
    result &= Test("raw_string_call_argument", strcmp(r"\n", "\\n"), 0);
    string rawString = r"{raw}";
    result &= Test("raw_string_string_initializer", rawString.data(), "\{raw\}");

    // A raw token next to an ordinary token keeps interpolation local to the ordinary token.
    int rawValue = 7;
    string rawAdjacent = r"a{" "b{rawValue}";
    result &= Test("raw_string_adjacent_interpolation", rawAdjacent.data(), "a\{b7");
    result &= Test("raw_string_adjacent_method", r"a{" "b{rawValue}".length(), 4);
    string r = "pre";
    string rExpression = r + "x";
    result &= Test("raw_prefix_keeps_identifier_r", rExpression.data(), "prex");

    // Multiple string variables can coexist with independent values
    string sa = "alpha";
    string sb = "beta!";
    result &= Test("str_lit_multi_a_length",  sa.length(), 5);
    result &= Test("str_lit_multi_b_length",  sb.length(), 5);
    result &= Test("str_lit_multi_a_data", sa.data(), "alpha");
    result &= Test("str_lit_multi_b_data", sb.data(), "beta!");

    // X6: a ternary whose branches are a `string` value and a char* literal must
    // coerce the literal to `string` (instead of asserting in LLVM's select on
    // mismatched operands). Verify both branch orders and the selected value.
    string base = "abc";
    string t1 = base.length() == 0 ? "lit" : base;       // selects the string branch
    result &= Test("ternary_str_pick_value",   t1.data(), "abc");
    string t2 = base.length() == 3 ? "lit" : base;       // selects the char* literal
    result &= Test("ternary_str_pick_literal", t2.data(), "lit");
    string t3 = base.length() == 0 ? base : "fallback";  // reversed: string then char*
    result &= Test("ternary_str_reversed",     t3.data(), "fallback");

    // Encoding prefixes retain their element type and terminate the encoded array.
    (const wchar)* wide = L"abcd";
    (const wchar)* wideBraceFold = L"{{L}}";
    (const c16)* utf16BraceFold = u"{{u}}";
    (const c32)* utf32BraceFold = U"{{U}}";
    int wideLength = 0;
    while (wide[wideLength] != 0) wideLength++;
    result &= Test("wide_literal_size", sizeof(wchar), sizeof(wide[0]));
    result &= Test("wide_literal_element", wide[1], (wchar)'b');
    result &= Test("wide_literal_length", wideLength, 4);
    result &= Test("wide_literal_bracefold",
        wideBraceFold[0] == '{' && wideBraceFold[1] == 'L'
            && wideBraceFold[2] == '}' && wideBraceFold[3] == 0, true);
    result &= Test("utf16_literal_bracefold",
        utf16BraceFold[0] == '{' && utf16BraceFold[1] == 'u'
            && utf16BraceFold[2] == '}' && utf16BraceFold[3] == 0, true);
    result &= Test("utf32_literal_bracefold",
        utf32BraceFold[0] == '{' && utf32BraceFold[1] == 'U'
            && utf32BraceFold[2] == '}' && utf32BraceFold[3] == 0, true);
    if const (__WINDOWS__)
        result &= Test("wide_literal_width", sizeof(wchar), 2);
    else
        result &= Test("wide_literal_width", sizeof(wchar), 4);
    (const c16)* utf16 = u"A\u263a";
    (const c32)* utf32 = U"A\U0001f600";
    (const c16)* utf16Pair = u"\U0001f600";
    string narrowUcn = "\u263a";
    (const c8)* utf8Ucn = u8"\u263a";
    result &= Test("utf16_literal_smile", utf16[1], (c16)0x263a);
    result &= Test("utf32_literal_non_bmp", utf32[1], (c32)0x1f600);
    result &= Test("utf16_literal_surrogate_high", utf16Pair[0], (c16)0xd83d);
    result &= Test("utf16_literal_surrogate_low", utf16Pair[1], (c16)0xde00);
    result &= Test("narrow_ucn_utf8_length", narrowUcn.length(), 3);
    result &= (u8)narrowUcn.data()[0] == (u8)0xe2;
    result &= (u8)utf8Ucn[0] == (u8)0xe2;
    (const c8)* utf8Literal = u8"xyz";
    result &= utf8Literal[0] == (c8)'x';
    result &= Test("wide_character_literal", (wchar)L'b', (wchar)'b');
    result &= Test("utf16_character_literal", (c16)u'\u263a', (c16)0x263a);
    result &= Test("utf32_character_literal", (c32)U'\U0001f600', (c32)0x1f600);

    return result;
}

