int t462LocalEnumConstPointerBox() { enum K : int { A = 13 }; K value = K.A; const(K)* p = &value; T120Box<const(K)*> b = default; b.value = p; return (int)sizeof(b) * 1000 + (int)*b.value; }
int t462FileEnumPointerBox() { T462PointerFileEnum value = T462PointerFileEnum.Value; T462PointerFileEnum* p = &value; T120Box<T462PointerFileEnum*> b = default; b.value = p; return (int)sizeof(b) * 1000 + (int)*b.value; }
int t462StructPointerBox() { T462PointerStruct value = default; value.value = 13; T462PointerStruct* p = &value; T120Box<T462PointerStruct*> b = default; b.value = p; return (int)sizeof(b) * 1000 + b.value[0].value; }

