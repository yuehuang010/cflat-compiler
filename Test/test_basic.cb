                   strcastSameStringResult(&plainLocal, &castLocal), true);

    StrctorStringHolder plainFunctionalHolder = default;
    StrctorStringHolder functionalHolder = default;
    plainFunctionalHolder.s = string("cat").copy();
    functionalHolder.s = string("cat").copy();
    string plainFunctionalLocal = plainFunctionalHolder.s;
    string functionalLocal = string(functionalHolder.s);
    result &= Test("strcast field local declaration functional value and ownership",
                   strcastSameStringResult(&plainFunctionalLocal, &functionalLocal), true);

    StrctorStringHolder plainAssignHolder = default;
    StrctorStringHolder castAssignHolder = default;
    plainAssignHolder.s = string("cat").copy();
    castAssignHolder.s = string("cat").copy();
    string plainAssigned = "old"; plainAssigned = plainAssignHolder.s;
    string castAssigned = "old"; castAssigned = (string)castAssignHolder.s;
    result &= Test("strcast field assignment cast value and ownership",
                   strcastSameStringResult(&plainAssigned, &castAssigned), true);

    StrctorStringHolder plainFunctionalAssignHolder = default;
    StrctorStringHolder functionalAssignHolder = default;
    plainFunctionalAssignHolder.s = string("cat").copy();
    functionalAssignHolder.s = string("cat").copy();
    string plainFunctionalAssigned = "old";
    plainFunctionalAssigned = plainFunctionalAssignHolder.s;
    string functionalAssigned = "old";
    functionalAssigned = string(functionalAssignHolder.s);
    result &= Test("strcast field assignment functional value and ownership",
                   strcastSameStringResult(&plainFunctionalAssigned, &functionalAssigned), true);

    StrctorStringHolder plainCallHolder = default;
    StrctorStringHolder castCallHolder = default;
    plainCallHolder.s = string("cat").copy();
    castCallHolder.s = string("cat").copy();
    result &= Test("strcast field call argument cast overload",
                   strcastIdentityRoute((string)castCallHolder.s) == 101
                       && strcastIdentityRoute(plainCallHolder.s) == 101, true);

    StrctorStringHolder plainFunctionalCallHolder = default;
    StrctorStringHolder functionalCallHolder = default;
    plainFunctionalCallHolder.s = string("cat").copy();
    functionalCallHolder.s = string("cat").copy();
    result &= Test("strcast field call argument functional overload",
                   strcastIdentityRoute(string(functionalCallHolder.s)) == 101
                       && strcastIdentityRoute(plainFunctionalCallHolder.s) == 101, true);
