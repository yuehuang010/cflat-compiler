int localEnumFeatures()
{
    enum LocalFeatures : int { Value = 6, Other = 7 };
    LocalFeatures e = LocalFeatures.Value;
    int result = 0;
    switch (e)
    {
        case LocalFeatures.Value: result = (int)sizeof(LocalFeatures) + (int)LocalFeatures.Other; break;
        default: result = -1; break;
    }
    function<int(LocalFeatures)> apply = (LocalFeatures x) => { return (int)x; };
    return result + apply(e);
}

