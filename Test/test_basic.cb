                + NestValGenericBefore<T>.pick(1) + local.hit(1);
        }
    };
    T marker = default;
    int value = 7;
    static int pick(int value) { return 20 + value; }
    static int pick(double value) { return 99; }
    int hit(int value) { return 30 + value; }
    int hit(double value) { return 199; }
};
struct NestValClassOuter
{
    int value = 7;
    static int pick(int x) { return 20 + x; }
    int hit(int x) { return 30 + x; }
    class I
    {
        NestValClassOuter make() { return { value = 41 }; }
        int read(NestValClassOuter value) { return value.value; }
        int run()
        {
            NestValClassOuter local = default;
            NestValClassOuter returned = make();
            return local.value + returned.value + read(local) + (int)sizeof(NestValClassOuter)
                + NestValClassOuter.pick(1) + local.hit(1);
        }
    };
};
union NestValUnionOuter
{
    int value = 7;
    static int pick(int x) { return 20 + x; }
    int hit(int x) { return 30 + x; }
    struct I
    {
        NestValUnionOuter make() { NestValUnionOuter result = default; result.value = 41; return result; }
        int read(NestValUnionOuter value) { return value.value; }
        int run()
        {
            NestValUnionOuter local = default;
            NestValUnionOuter returned = make();
            return local.value + returned.value + read(local) + (int)sizeof(NestValUnionOuter)
                + NestValUnionOuter.pick(1) + local.hit(1);
        }
    };
};
struct Nest5PlainMemberTemplate
{
    static int get<T>(T value) { return 30 + (int)sizeof(T); }
};
struct Nest5SiblingGeneric<U>
{
    struct I { static int go() { return (int)sizeof(U) * 10; } };
    struct M
    {
        static int callStatic() { return I.go() + 1; }
        int callInstance() { return I.go() + 2; }
    };
    static int callInstance() { M m = default; return m.callInstance(); }
};
struct Nest5SiblingPlain
{
    struct I { static int go() { return 30; } };
    struct M
    {
        static int callStatic() { return I.go() + 1; }
        int callInstance() { return I.go() + 2; }
    };
    static int callInstance() { M m = default; return m.callInstance(); }
};
namespace Nest5QualifiedNS
{
    struct O<U> { static int run() { return 40 + (int)sizeof(U); } };
    struct Plain { static int run() { return 30; } };
    struct wrap<U> { static int run() { return 50 + (int)sizeof(U); } };
};
struct wrap<U> { static int run() { return 90; } };
struct Nest5Round2Receiver
{
    int wrap<T>(T value) { return (int)sizeof(T) * 10 + 3; }
    int pick<T>(T value) { return (int)sizeof(T) * 10 + 3; }
    int implicitCall() { return wrap<double>(1.0); }
    int explicitCall() { return this.wrap<double>(1.0); }
};
struct Nest5Round2Envelope { Nest5Round2Receiver field = default; };
Nest5Round2Receiver nest5Round2MakeReceiver() { return default; }
int nest5Round2Parameter(Nest5Round2Receiver value)
{
    return value.wrap<double>(1.0);
}
struct Nest5Round2GenericReceiver<U>
{
    int wrap<T>(T value)
    {
        return (int)sizeof(U) * 100 + (int)sizeof(T) * 10 + 5;
    }
    int pick<T>(T value)
    {
        return (int)sizeof(U) * 100 + (int)sizeof(T) * 10 + 5;
    }
};
struct Nest5Round2NestedOwner<U>
{
    struct B<V>
    {
        static int get<T>(T value)
        {
            return (int)sizeof(U) * 100 + (int)sizeof(V) * 10 + (int)sizeof(T);
        }
    };
    static int call() { return B<char>.get<int>(1); }
};
struct MtplGenericMemberOverload
{
    int gv(double value) { return 2; }
    int gv<T>(T value) { return 1; }
    int bareCall() { return gv(3); }
    int thisCall() { return this.gv(3); }
};
struct MtplDoubleOnlyMember
{
    int gv(double value) { return 2; }
};
bool mtplDoubleOnlyCallRemainsRejected()
{
    MtplDoubleOnlyMember h = default;
    expect_error("no overload of 'gv' matches the given arguments") { h.gv(2); }
    return true;
}

