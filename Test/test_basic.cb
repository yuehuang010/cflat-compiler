        struct L { int pick() { return 10; } };
        interface I { int local(); };
        struct Box<T> { T item = default; };
        int r3p<T>(T value) { return 10; }
        int qualifiedLookupFunction() { return 10; }
        int qualifiedLookupGlobal = 10;
        enum Tone : int { Shade = 10 };
    }
