bool testEnum()
{
    bool result = true;
    result &= Test("enum_member_comparison", MyEnum.E_ONE < MyEnum.E_TWO, true);
    int tEnumMemberSwitch = 0;
    switch (MyEnum.E_TWO)
    {
        case MyEnum.E_TWO: tEnumMemberSwitch = 23; break;
        default: tEnumMemberSwitch = -1; break;
    }
    result &= Test("enum_member_case_label", tEnumMemberSwitch, 23);
    result &= Test("enum_member_array_size", (int)sizeof(tEnumAcceptArray), 8);
    result &= Test("enum_member_int_cast", (int)MyEnum.E_THREE, 5);
    result &= Test("enum_member_by_value", tEnumAcceptByValue(MyEnum.E_TWO), 12);
    result &= Test("enum_member_generic_argument", tEnumAcceptGeneric<MyEnum>(MyEnum.E_THREE), 5);
    result &= Test("enum_member_if_const", tEnumAcceptIfConst(), 17);
    result &= Test("enum_member_const_like_global", tEnumAcceptConst, 29);
    MyEnum tEnumMutable = MyEnum.E_ONE;
    tEnumMutable = MyEnum.E_THREE;
    tEnumMutable++;
    result &= Test("enum_variable_assign_increment_neighbor", (int)tEnumMutable, 6);
    tEnumAcceptGlobal = MyEnum.E_TWO;
    result &= Test("enum_global_assign_neighbor", (int)tEnumAcceptGlobal, 2);
    TEnumMemberDefault tEnumDefault = default;
    result &= Test("enum_member_field_default", (int)tEnumDefault.value, 5);
    tEnumDefault.value = MyEnum.E_ONE;
    result &= Test("enum_field_assign_neighbor", (int)tEnumDefault.value, 1);
    result &= Test("enum_E_ONE", MyEnum.E_ONE, 1);
    result &= Test("enum_E_TWO", MyEnum.E_TWO, 2);
    result &= Test("enum_E_THREE", MyEnum.E_THREE, 5);

    // Parameter / return type.
    result &= Test("enum_param_type", enumAsParameter(MyEnum.E_TWO), 102);
    result &= Test("enum_return_type", (int)enumAsReturn(), 5);

    // Local enum type names belong to their function, method, and lexical block scopes.
    result &= Test("local_enum_two_functions", localEnumFirst() + localEnumSecond(), 33);
    result &= Test("local_enum_shadows_file_scope", localEnumShadow(), 2);
    result &= Test("local_enum_file_scope_survives", (int)LocalShadow.Value, 1);
    LocalEnumMethods methods = default;
    result &= Test("local_enum_two_methods", methods.first() + methods.second(), 7);
    GenericLocalEnumMethods<int> genericMethodsInt = default;
    GenericLocalEnumMethods<i64> genericMethodsI64 = default;
    result &= Test("local_enum_generic_methods",
        genericMethodsInt.first() + genericMethodsInt.second()
            + genericMethodsI64.first() + genericMethodsI64.second(), 22);
    result &= Test("local_enum_lambda_parameter",
        localEnumLambda() + localEnumLambdaSecond(), 17);
    result &= Test("local_enum_switch_lambda_sizeof",
        localEnumFeatures() + localEnumFeaturesSecond(), 36);
    result &= Test("local_enum_sibling_blocks", localEnumSiblingBlocks(), 7);
    result &= Test("t371_qualified_enumerator", t371QualifiedEnumerator(), 3);
    result &= Test("t371_type_after_enum", t371TypeAfterEnum(), 3);
    result &= Test("t371_inner_value_wins", t371InnerValueWins(), 1);
    result &= Test("t371_sibling_block_does_not_shadow", t371SiblingBlockDoesNotShadow(), 10);
    result &= Test("t371_value_before_enum", t371ValueBeforeEnum(), 10);
    result &= Test("t371_sizeof_type", t371SizeofType(), 4);
    result &= Test("t371_cast_target", t371CastTarget(), 3);
    result &= Test("t371_for_init_value", t371ForInitValue(), 6);
    result &= Test("t371_range_for_value", t371RangeForValue(), 6);
    result &= Test("t371_lambda_parameter_value", t371LambdaParameterValue(), 4);
    result &= Test("t371_member_outer_value", t371MemberOuterValue(), 11);
    result &= Test("t371_struct_member_outer_value", t371StructMemberOuterValue(), 3);
    result &= Test("t371_case_arm_binding_value", t371CaseArmBindingValue(), 4);
    result &= Test("local_enum_scope_not_captured_by_generic",
        t115GenericEnumCaller(), 11);

    T120Box<Col> fileEnumBox;
    fileEnumBox.value = Col.A;
    result &= Test("t120_file_scope_enum_generic_struct",
        (int)sizeof(fileEnumBox) * 10 + (int)fileEnumBox.value, 14);
    result &= Test("t120_local_enum_generic_struct", t120LocalBox(), 15);
    result &= Test("t120_same_local_name_first_type", t120LocalBoxFirst(), 13);
    result &= Test("t120_same_local_name_second_type", t120LocalBoxSecond(), 87);
    result &= Test("t120_same_local_name_distinct_instantiations",
        t120LocalBoxFirst() + t120LocalBoxSecond(), 100);
    result &= Test("t120_block_enum_shadows_file_enum", t120BlockShadowBox(), 89);
    result &= Test("t120_namespaced_bare_and_qualified_enum", t120NamespaceBox(), 26);
    T120MethodHolder t120Holder;
    result &= Test("t120_method_local_enum_generic_struct", t120Holder.read(), 13);
    result &= Test("t120_nested_generic_local_enum", t120NestedBox(), 90);
    result &= Test("t120_lambda_local_enum_generic_struct", t120LambdaBox(), 16);
    result &= Test("t120_local_enum_sizeof_type_name", t120LocalEnumSizeofTypeName(), 8);
    result &= Test("t120_local_enum_using_alias", t120LocalEnumUsingAlias(), 83);
    result &= Test("t120_file_enum_sizeof_with_local_shadow", t120FileEnumSizeofWithLocalShadow(), 101);
    result &= Test("t120_file_enum_using_with_local_shadow", t120FileEnumUsingWithLocalShadow(), 114);
    result &= Test("t120_file_enum_static_call_with_local_shadow", t120FileEnumStaticCallWithLocalShadow(), 101);
    result &= Test("t120_local_enum_static_call", t120LocalEnumStaticCall(), 8);
    result &= Test("t120_local_enum_function_signature", t120LocalEnumFunctionSignature(), 3);
    result &= Test("t120_file_struct_with_local_enum_shadow", t120FileStructWithLocalEnumShadow(), 104);

    result &= Test("t462_local_enum_generic_pointer", t462LocalEnumPointerBox(), 8013);
    result &= Test("t462_local_enum_generic_view", t462LocalEnumViewBox(), 8013);
    result &= Test("t462_local_enum_generic_double_pointer", t462LocalEnumPointerPointerBox(), 8013);
    result &= Test("t462_local_enum_same_name_first_pointer", t462LocalEnumPointerFirst(), 8017);
    result &= Test("t462_local_enum_same_name_second_pointer", t462LocalEnumPointerSecond(), 8400);
    result &= Test("t462_local_enum_generic_function_pointer", t462LocalEnumGenericCall(), 13);
    result &= Test("t462_local_enum_const_pointer_control", t462LocalEnumConstPointerBox(), 8013);
    result &= Test("t462_file_enum_pointer_control", t462FileEnumPointerBox(), 8013);
    result &= Test("t462_struct_pointer_control", t462StructPointerBox(), 8013);

    // A narrow unsigned base must zero-extend, a narrow signed base must sign-extend.
    WideU8 big = WideU8.WU8_BIG;
    WideU8 max = WideU8.WU8_MAX;
    WideU16 wide = WideU16.WU16_BIG;
    NarrowI8 neg = NarrowI8.NI8_NEG;
    result &= Test("enum_u8_200_widens_unsigned", (int)big, 200);
    result &= Test("enum_u8_255_widens_unsigned", (int)max, 255);
    result &= Test("enum_u16_40000_widens_unsigned", (int)wide, 40000);
    result &= Test("enum_i8_neg_widens_signed", (int)neg, -1);
    result &= Test("enum_u8_compare_above_127", big > 100, true);

    int enumSwitchCast = 0;
    switch (big)
    {
        case (WideU8)200: enumSwitchCast = 1; break;
        default: enumSwitchCast = -1; break;
    }
    result &= Test("enum_u8_cast_case_label", enumSwitchCast, 1);
    int enumSwitchWrapped = 0;
    switch (max)
    {
        case (WideU8)-1: enumSwitchWrapped = 1; break;
        default: enumSwitchWrapped = -1; break;
    }
    result &= Test("enum_u8_wrapped_cast_case_label", enumSwitchWrapped, 1);
    int enumSwitchEnumerator = 0;
    switch (big)
    {
        case WideU8.WU8_BIG: enumSwitchEnumerator = 1; break;
        default: enumSwitchEnumerator = -1; break;
    }
    result &= Test("enum_u8_enumerator_case_label", enumSwitchEnumerator, 1);
    int enumSwitchCastOperand = 0;
    switch ((u8)big)
    {
        case (WideU8)200: enumSwitchCastOperand = 1; break;
        default: enumSwitchCastOperand = -1; break;
    }
    result &= Test("enum_u8_cast_operand_case_label", enumSwitchCastOperand, 1);
    int enumSwitchIntOperand = 0;
    switch ((int)big)
    {
        case (WideU8)200: enumSwitchIntOperand = 1; break;
        default: enumSwitchIntOperand = -1; break;
    }
    result &= Test("enum_u8_int_operand_case_label", enumSwitchIntOperand, 1);
    // A cast result zero-extends like an enum variable (C semantics), outside case labels too.
    int castWidened = (WideU8)200;
    long castWidenedLong = (WideU16)40000;
    int negOne = -1;
    result &= Test("enum_u8_cast_widens_unsigned", castWidened, 200);
    result &= Test("enum_u16_cast_widens_long", castWidenedLong, 40000);
    result &= Test("enum_u8_cast_div", (WideU8)200 / 3, 66);
    result &= Test("enum_u8_cast_compare_signed", (WideU8)200 > negOne, true);

    // Initializers outside the int32 range.
    WideI64 low = WideI64.WI64_LOW;
    WideI64 high = WideI64.WI64_HIGH;
    WideU64 huge = WideU64.WU64_HIGH;
    result &= Test("enum_i64_below_int32_min", (i64)low, (i64)-3000000000);
    result &= Test("enum_i64_above_int32_max", (i64)high, (i64)4000000000);
    result &= Test("enum_u64_two_to_the_63", (u64)huge, (u64)9223372036854775808);
    result &= Test("enum_u64_dynamic_max", (u64)DynU64.DU64_MAX, (u64)18446744073709551615);
    result &= Test("enum_aliased_backing_unsigned", (int)AliasBacked.AB_HI, 200);

    // Namespaced enum, qualified from outside; and an alias of an enum used as a type.
    result &= Test("enum_namespaced_qualified", (int)EnumNs.Facing.Back, -7);
    FacingAlias aliased = EnumNs.Facing.Fwd;
    result &= Test("enum_alias_as_type", (int)aliased, 7);

    // Enum as a struct field and as a generic type argument.
    EnumHolder holder;
    holder.band = WideU8.WU8_BIG;
    holder.amount = 3;
    result &= Test("enum_struct_field_unsigned", (int)holder.band, 200);
    EnumBox<WideU8> boxed;
    boxed.value = WideU8.WU8_MAX;
    result &= Test("enum_generic_argument", (int)boxed.value, 255);

    // Forward reference to an enum declared later in the file.
    result &= Test("enum_forward_reference", enumUsedBeforeDeclaration(), 99);
    return result;
}

struct MyStruct
{
    int num1 = 1;
    int num2 = 2;
    int num3 = 3;
};

int TotalByValue(MyStruct mystruct)
{
    return mystruct.num1 + mystruct.num2 + mystruct.num2;
}

int TotalByPointer(MyStruct* mystruct)
{
    return mystruct->num1 + mystruct->num2 + mystruct->num2;
}

struct MyStruct1
{
    int num = 1;
    int Read() { return num; }
};

struct MyStruct2
{
    int num = 2;
    int Read() { return num; }
};

// Overloaded Extension function
int ReadExt(MyStruct1 my) { return my.num; }
int ReadExt(MyStruct2 my) { return my.num; }

// Destructor tests

int destructorCallCount = 0;

struct Tracked
{
    int id = 0;
    ~Tracked()
    {
        destructorCallCount = destructorCallCount + 1;
    }
};

bool testDestructor()
{
    bool result = true;
    destructorCallCount = 0;

    {
        Tracked t = Tracked();
    }
    result &= Test("destructor_called_once", destructorCallCount, 1);

    {
        Tracked a = Tracked();
        Tracked b = Tracked();
    }
    result &= Test("destructor_called_twice", destructorCallCount, 3);

    return result;
}


// Default parameter tests

int addWithDefault(int x, int y = 5)
{
    return x + y;
}

bool testDefaultSingleParam()
{
    bool result = true;
    result &= Test("add_both_args", addWithDefault(3, 4), 7);  // 3+4=7
    result &= Test("add_default_y", addWithDefault(3), 8);  // 3+5=8
    return result;
}

int sumWithDefaults(int x, int y = 10, int z = 20)
{
    return x + y + z;
}

bool testDefaultMultipleParams()
{
    bool result = true;
    result &= Test("sum_all_args", sumWithDefaults(1, 2, 3), 6);   // 1+2+3=6
    result &= Test("sum_default_z", sumWithDefaults(1, 2), 23);  // 1+2+20=23
    result &= Test("sum_defaults_yz", sumWithDefaults(1), 31);  // 1+10+20=31
    return result;
}

// Integer -> bool at a CALL ARGUMENT (ruling 2026-09-04): legal for constants and
// non-constants alike, positional and default, and lowered through CoerceToBoolCondition.
// Before the fix a positional integer was rejected as "no overload" while a default was
// pushed unconverted into the i1 slot and failed module verification with no diagnostic.
int boolPick(bool b) { return b ? 7 : 3; }
int boolDefaultTwo(bool b = 2) { return b ? 7 : 3; }
int boolDefaultZero(bool b = 0) { return b ? 7 : 3; }
int boolVariadic(bool b, ...) { return b ? 7 : 3; }

class BoolDefaultHolder { int pick(bool b = 2) { return b ? 7 : 3; } };

// Declaration order matters here: the 'bool' overload is LAST, the position that used to win
// the implicit tie and made 'sb.append(42)' print 'true'.
int boolOverloadPick(int v) { return v; }
int boolOverloadPick(bool b) { return -1; }

bool testIntToBoolCallArgument()
{
    bool result = true;
    result &= Test("i2b_literal_two", boolPick(2), 7);
    result &= Test("i2b_literal_one", boolPick(1), 7);
    result &= Test("i2b_literal_zero", boolPick(0), 3);

    int n = 5;
    result &= Test("i2b_int_variable", boolPick(n), 7);
    int z = 0;
    result &= Test("i2b_int_variable_zero", boolPick(z), 3);
    u8 u = 200;
    result &= Test("i2b_u8_variable", boolPick(u), 7);

    result &= Test("i2b_default_two", boolDefaultTwo(), 7);
    result &= Test("i2b_default_zero", boolDefaultZero(), 3);

    BoolDefaultHolder h = default;
    result &= Test("i2b_method_default", h.pick(), 7);

    result &= Test("i2b_variadic_declared_param", boolVariadic(2, 1), 7);

    function<int(bool)> fp = boolPick;
    result &= Test("i2b_function_value", fp(2), 7);

    // The coercion must stay the LAST resort: an exactly-typed overload still wins.
    result &= Test("i2b_prefers_int_overload", boolOverloadPick(42), 42);
    result &= Test("i2b_bool_overload_still_reached", boolOverloadPick(true), -1);
    return result;
}

int multiplyWithDefault(int x, int factor = 2)
{
    return x * factor;
}

bool testDefaultExpression()
{
    bool result = true;
    result &= Test("multiply_explicit", multiplyWithDefault(5, 3), 15);  // 5*3=15
    result &= Test("multiply_default", multiplyWithDefault(5), 10);  // 5*2=10
    return result;
}

// Regression: a method default parameter whose bare name collides with a
// same-named method on an UNRELATED type used to abort the compile with
// "named argument '<Type>__' does not match any parameter". The default-param
// forwarding wrapper leaked the leading `this` (named "<Type>__") as a NAMED
// argument; when that forwarding call was resolved against the sibling type's
// method it hard-errored instead of rejecting the candidate. The wrapper now
// forwards positionally. (Repro: two types both with a method `mix`, one with a
// default param.)
struct DefaultParamOther {
    int mix(int a, int b) { return a + b; }
};
struct DefaultParamSelf {
    int mix(int a, int scale = 10) { return a * scale; }
};

bool testDefaultParamNameCollision()
{
    bool result = true;
    DefaultParamOther o;
    DefaultParamSelf s;
    result &= Test("collide_other_type", o.mix(3, 4), 7);    // 3+4
    result &= Test("collide_explicit",   s.mix(3, 2), 6);    // 3*2
    result &= Test("collide_default",    s.mix(3), 30);      // 3*10
    return result;
}

/*
 * Regression: a constructor whose parameters are ALL defaulted IS the type's no-arg
 * constructor - its cutoff-0 default-param wrapper mangles to the same symbol as the
 * synthesized one. Emitting both made the wrapper re-enter an already-defined function
 * with no scope frame pushed, so its scope-exit popped the CALLER's frame: the compiler
 * died nondeterministically (SIGABRT / SIGSEGV / "declared with no enclosing scope") on
 * the DECLARATION alone, before any construction. The synthetic ctor is now suppressed
 * and the all-defaulted ctor seeds fields itself instead of self-delegating.
 */
class AllDefaultedCtor
{
    int a;
    int b = 7;
    AllDefaultedCtor(int x = 3, int y = 4) { a = x; b = b + y; }
};

struct AllDefaultedStruct
{
    int a;
    AllDefaultedStruct(int x = 5) { a = x; }
};

int ctorPreludePlainDefault = 0;
int ctorPreludePlainArg = 0;
struct CtorPreludePlain
{
    CtorPreludePlain() { ctorPreludePlainDefault++; }
    CtorPreludePlain(int value) { ctorPreludePlainArg++; }
};

int ctorPreludeClassDefault = 0;
int ctorPreludeClassArg = 0;
class CtorPreludeClass
{
    CtorPreludeClass() { ctorPreludeClassDefault++; }
    CtorPreludeClass(int value) { ctorPreludeClassArg++; }
};

int ctorPreludeGenericDefault = 0;
int ctorPreludeGenericArg = 0;
struct CtorPreludeGeneric<T>
{
    CtorPreludeGeneric() { ctorPreludeGenericDefault++; }
    CtorPreludeGeneric(int value) { ctorPreludeGenericArg++; }
};

bool testParameterizedConstructorPrelude()
{
    bool result = true;

    ctorPreludePlainDefault = 0;
    ctorPreludePlainArg = 0;
    CtorPreludePlain plain = CtorPreludePlain(9);
    result &= Test("ctor_prelude_plain_arg_body", ctorPreludePlainArg, 1);
    result &= Test("ctor_prelude_plain_default_body", ctorPreludePlainDefault, 0);

    ctorPreludePlainDefault = 0;
    ctorPreludePlainArg = 0;
    CtorPreludePlain* plainHeap = new CtorPreludePlain(10);
    result &= Test("ctor_prelude_new_arg_body", ctorPreludePlainArg, 1);
    result &= Test("ctor_prelude_new_default_body", ctorPreludePlainDefault, 0);
    delete plainHeap;

    ctorPreludeClassDefault = 0;
    ctorPreludeClassArg = 0;
    CtorPreludeClass klass = CtorPreludeClass(11);
    result &= Test("ctor_prelude_class_arg_body", ctorPreludeClassArg, 1);
    result &= Test("ctor_prelude_class_default_body", ctorPreludeClassDefault, 0);

    ctorPreludeGenericDefault = 0;
    ctorPreludeGenericArg = 0;
    CtorPreludeGeneric<int> generic = CtorPreludeGeneric<int>(12);
    result &= Test("ctor_prelude_generic_arg_body", ctorPreludeGenericArg, 1);
    result &= Test("ctor_prelude_generic_default_body", ctorPreludeGenericDefault, 0);
    return result;
}

bool testAllDefaultedConstructor()
{
    bool result = true;
    AllDefaultedCtor d;
    // Field initializer (b = 7) seeds first, then the ctor body runs with the defaults.
    result &= Test("alldef_ctor_bare_a", d.a, 3);
    result &= Test("alldef_ctor_bare_b", d.b, 11);
    AllDefaultedCtor e = AllDefaultedCtor(20);
    result &= Test("alldef_ctor_one_arg_a", e.a, 20);
    result &= Test("alldef_ctor_one_arg_b", e.b, 11);
    AllDefaultedCtor f = AllDefaultedCtor(20, 30);
    result &= Test("alldef_ctor_two_arg_a", f.a, 20);
    result &= Test("alldef_ctor_two_arg_b", f.b, 37);
    AllDefaultedStruct s;
    result &= Test("alldef_struct_bare", s.a, 5);
    AllDefaultedStruct s2 = AllDefaultedStruct(9);
    result &= Test("alldef_struct_arg", s2.a, 9);
    AllDefaultedCtor* h = new AllDefaultedCtor();
    result &= Test("alldef_ctor_new", h->a, 3);
    delete h;
    return result;
}

/*
 * Regression: a user-written no-arg constructor seeds its own fields in line instead of
 * delegating, and that in-line seeding used to honour only brace-list and '= expr' field
 * defaults. A struct-typed field with NO initializer, and a '= default' field, were left
 * zeroed - a SILENT WRONG VALUE against the synthesized default constructor, which
 * default-constructs both. Covers the all-defaulted ctor (the shape widened onto this path)
 * and the bare T() ctor (where the divergence was pre-existing).
 */
struct SeedDeep { int w = 42; };
struct SeedInner { int v = 7; SeedDeep d; };

class SeededAllDefaulted
{
    SeedInner nested;
    SeedInner dn = default;
    int plain = 5;
    SeededAllDefaulted(int x = 3) { plain = plain + x; nested.v = nested.v + 100; }
};

class SeededBareCtor
{
    SeedInner nested;
    SeedInner dn = default;
    int plain = 5;
    SeededBareCtor() { }
};

struct SeedBox<T>
{
    SeedInner nested;
    T val = default;
    SeedBox(int x = 3) { }
};

/*
 * Regression: the in-line seeding branch stored a field default only when Upconvert already
 * landed on the destination's LLVM type, so any default needing a CONVERSION was silently
 * dropped and the field kept the seeding zero. The synthesized default constructor
 * (ParseStructDefinition:342-369) instead CreateCasts a scalar and default-constructs a
 * struct-typed destination. The *NoCtor twins below are the oracle: they take that synthetic
 * path, and every expected value here is what they produce.
 */
struct SeedCastNoCtor
{
    u8 r = 200;      // truncates: i32 200 -> i8, reads back 200 through u8
    i16 s = 40000;   // truncates and wraps: 40000 -> -25536
    int i = (int)3.7;     // fptosi: 3.7 -> 3
};

struct SeedCastBare
{
    u8 r = 200;
    i16 s = 40000;
    int i = (int)3.7;
    SeedCastBare() { }
};

struct SeedCastAllDefaulted
{
    u8 r = 200;
    i16 s = 40000;
    int i = (int)3.7;
    SeedCastAllDefaulted(int x = 3) { }
};

struct SeedZeroInner { int v = 7; };

// `T val = 0` at a struct T: the integer literal never matches the aggregate destination, so
// the mismatch arm has to call T's own default constructor rather than drop the store.
struct SeedZeroNoCtor<T> { T val = 0; int p = 1; };
struct SeedZeroBare<T> { T val = 0; int p = 1; SeedZeroBare() { } };
struct SeedZeroAllDefaulted<T> { T val = 0; int p = 1; SeedZeroAllDefaulted(int x = 3) { } };

/*
 * Regression: ParseClassDefinition's synthesized default ctor gated its type-mismatch handling
 * on `destType->isStructTy()`, so a mismatched SCALAR field default reached CreateInsertValue
 * unconverted and the ctor returned a struct constant whose element types did not match the
 * struct type (`%C = type { i8, i32 }` with `ret %C { i16 200, i32 1 }` - rejected by llvm-as,
 * accepted by verifyModule). The struct twins above are the oracle.
 * Discriminators: only the three float-to-integer cells below change value across the fix
 * (pre-fix i=-1717986918, r8=154, (int)g=-1717986918). The u8/i16 cells are oracle PINS,
 * not discriminators - the malformed constant's low bits happened to be the truncation, so
 * they read the same value on both binaries. What discriminates them is the emitted IR and the
 * narrowing warning, neither of which this suite can observe.
 */
class SeedCastClassNoCtor
{
    u8 r = 200;
    i16 s = 40000;
    int i = (int)3.7;
    u8 r8 = (u8)3.7;
    i64 g = (i64)3.7;
};

// A parameterized user ctor does NOT suppress the synthetic no-arg ctor - it DELEGATES to it,
// so this shape reaches the same emitter as the ctor-less class above.
class SeedCastClassUserCtor
{
    int i = (int)3.7;
    u8 r8 = (u8)3.7;
    int p = 1;
    SeedCastClassUserCtor(int q) { p = q; }
};

// T84: float -> 32-bit unsigned is fptoui. The field, union, bitfield and simd structs below
// give the brace-init, bitfield and union doors a 'u32' destination.
// Sources are globals seeded at run time: a literal double folds the out-of-range fptosi to poison,
// and the compare then passes on the broken compiler too.
double t84Big;
double t84Mid;
double t84Small;
void t84Seed() { t84Big = 3000000000.5; t84Mid = 2147483648.5; t84Small = 200.5; }
u32 t84Global = (u32)3000000000.5;
union T84UnionDefault { u32 f = (u32)3000000000.5; double d; };
struct T84Field { u32 f; };
struct T151Fit { u8 a = 0; int b = 0; };
struct T151Bool { bool x : 1; };
struct T151Byte { u8 a : 8; };
struct T84Bits { u32 a : 12; u32 b : 20; };
union T84Union { u32 f; double d; };
u32 floatFoldFBits(float x) { return *(u32*)&x; }
u64 floatFoldDBits(double x) { return *(u64*)&x; }
float ffGlobalF_p24 = 16777217;
double ffGlobalD_p24 = 16777217;
const float ffConstF_p24 = 16777217;
const double ffConstD_p24 = 16777217;
float ffRetF_p24() { return 16777217; }
double ffRetD_p24() { return 16777217; }
union FFUnionF_p24 { float f = 16777217; u32 raw; };
union FFUnionD_p24 { double d = 16777217; u64 raw; };
float ffGlobalF_p53 = 9007199254740993;
double ffGlobalD_p53 = 9007199254740993;
const float ffConstF_p53 = 9007199254740993;
const double ffConstD_p53 = 9007199254740993;
float ffRetF_p53() { return 9007199254740993; }
double ffRetD_p53() { return 9007199254740993; }
union FFUnionF_p53 { float f = 9007199254740993; u32 raw; };
union FFUnionD_p53 { double d = 9007199254740993; u64 raw; };
float ffGlobalF_round = 0x1000001000000001;
double ffGlobalD_round = 0x1000001000000001;
const float ffConstF_round = 0x1000001000000001;
const double ffConstD_round = 0x1000001000000001;
float ffRetF_round() { return 0x1000001000000001; }
double ffRetD_round() { return 0x1000001000000001; }
union FFUnionF_round { float f = 0x1000001000000001; u32 raw; };
union FFUnionD_round { double d = 0x1000001000000001; u64 raw; };
float ffGlobalF_neg = -0x1000001000000001;
double ffGlobalD_neg = -0x1000001000000001;
const float ffConstF_neg = -0x1000001000000001;
const double ffConstD_neg = -0x1000001000000001;
float ffRetF_neg() { return -0x1000001000000001; }
double ffRetD_neg() { return -0x1000001000000001; }
union FFUnionF_neg { float f = -0x1000001000000001; u32 raw; };
union FFUnionD_neg { double d = -0x1000001000000001; u64 raw; };
float ffGlobalF_umax = 0xFFFFFFFFFFFFFFFF;
double ffGlobalD_umax = 0xFFFFFFFFFFFFFFFF;
const float ffConstF_umax = 0xFFFFFFFFFFFFFFFF;
const double ffConstD_umax = 0xFFFFFFFFFFFFFFFF;
float ffRetF_umax() { return 0xFFFFFFFFFFFFFFFF; }
double ffRetD_umax() { return 0xFFFFFFFFFFFFFFFF; }
union FFUnionF_umax { float f = 0xFFFFFFFFFFFFFFFF; u32 raw; };
union FFUnionD_umax { double d = 0xFFFFFFFFFFFFFFFF; u64 raw; };
float ffGlobalF_imin = -0x7FFFFFFFFFFFFFFF - 1;
double ffGlobalD_imin = -0x7FFFFFFFFFFFFFFF - 1;
const float ffConstF_imin = -0x7FFFFFFFFFFFFFFF - 1;
const double ffConstD_imin = -0x7FFFFFFFFFFFFFFF - 1;
float ffRetF_imin() { return -0x7FFFFFFFFFFFFFFF - 1; }
double ffRetD_imin() { return -0x7FFFFFFFFFFFFFFF - 1; }
union FFUnionF_imin { float f = -0x7FFFFFFFFFFFFFFF - 1; u32 raw; };
union FFUnionD_imin { double d = -0x7FFFFFFFFFFFFFFF - 1; u64 raw; };
float ffGlobalF_uhi = 0x8000008000000001;
double ffGlobalD_uhi = 0x8000008000000001;
const float ffConstF_uhi = 0x8000008000000001;
const double ffConstD_uhi = 0x8000008000000001;
float ffRetF_uhi() { return 0x8000008000000001; }
double ffRetD_uhi() { return 0x8000008000000001; }
union FFUnionF_uhi { float f = 0x8000008000000001; u32 raw; };
union FFUnionD_uhi { double d = 0x8000008000000001; u64 raw; };
struct FFFoldFieldDefaults {
    float f_p24 = 16777217;
    double d_p24 = 16777217;
    float f_p53 = 9007199254740993;
    double d_p53 = 9007199254740993;
    float f_round = 0x1000001000000001;
    double d_round = 0x1000001000000001;
    float f_neg = -0x1000001000000001;
    double d_neg = -0x1000001000000001;
    float f_umax = 0xFFFFFFFFFFFFFFFF;
    double d_umax = 0xFFFFFFFFFFFFFFFF;
    float f_imin = -0x7FFFFFFFFFFFFFFF - 1;
    double d_imin = -0x7FFFFFFFFFFFFFFF - 1;
    float f_uhi = 0x8000008000000001;
    double d_uhi = 0x8000008000000001;
};
float[6] ffArrayF = { 16777217, 9007199254740993, 0x1000001000000001, -0x1000001000000001, 0xFFFFFFFFFFFFFFFF, -0x7FFFFFFFFFFFFFFF - 1 };
double[6] ffArrayD = { 16777217, 9007199254740993, 0x1000001000000001, -0x1000001000000001, 0xFFFFFFFFFFFFFFFF, -0x7FFFFFFFFFFFFFFF - 1 };

// Brace-init into a 'bool' field is the third door onto the truth test (after '=' and the
// explicit cast); 'g' pins that the neighbouring field is not clobbered by a wide store.
struct BoolBraceInit
{
    bool f = default;
    int g = 7;
};

bool testNoArgCtorFieldSeedingCasts()
{
    bool result = true;
    // Oracle: the synthetic default ctor. These pin the values the ctor cases must match, and
    // go red if that path's conversions ever change.
    SeedCastNoCtor o;
    result &= Test("seedcast_oracle_u8", (int)o.r, 200);
    result &= Test("seedcast_oracle_i16", (int)o.s, -25536);
    result &= Test("seedcast_oracle_fptosi", o.i, 3);

    // Bare no-arg ctor - the pre-existing face. All three read 0 before the fix.
    SeedCastBare b;
    result &= Test("seedcast_bare_u8", (int)b.r, 200);
    result &= Test("seedcast_bare_i16", (int)b.s, -25536);
    result &= Test("seedcast_bare_fptosi", b.i, 3);

    // All-defaulted ctor - the face the all-defaulted-ctor fix routed onto this branch.
    SeedCastAllDefaulted d;
    result &= Test("seedcast_alldef_u8", (int)d.r, 200);
    result &= Test("seedcast_alldef_i16", (int)d.s, -25536);
    result &= Test("seedcast_alldef_fptosi", d.i, 3);

    // Struct-typed destination reached through a generic parameter.
    SeedZeroNoCtor<SeedZeroInner> go;
    result &= Test("seedzero_oracle_v", go.val.v, 7);
    SeedZeroBare<SeedZeroInner> gb;
    result &= Test("seedzero_bare_v", gb.val.v, 7);
    result &= Test("seedzero_bare_p", gb.p, 1);
    SeedZeroAllDefaulted<SeedZeroInner> gd;
    result &= Test("seedzero_alldef_v", gd.val.v, 7);
    result &= Test("seedzero_alldef_p", gd.p, 1);

    // Class twins. Same expected values as SeedCastNoCtor - the class emitter now runs the
    // struct emitter's scalar arm. See the block comment above SeedCastClassNoCtor.
    SeedCastClassNoCtor c;
    result &= Test("seedcast_class_u8", (int)c.r, 200);          // pin, not a discriminator
    result &= Test("seedcast_class_i16", (int)c.s, -25536);      // pin, not a discriminator
    result &= Test("seedcast_class_fptosi", c.i, 3);             // pre-fix: -1717986918
    result &= Test("seedcast_class_fptoui8", (int)c.r8, 3);      // pre-fix: 154
    result &= Test("seedcast_class_fptosi64", (int)c.g, 3);      // pre-fix: -1717986918
    SeedCastClassUserCtor u = SeedCastClassUserCtor(9);
    result &= Test("seedcast_class_userctor_fptosi", u.i, 3);    // pre-fix: -1717986918
    result &= Test("seedcast_class_userctor_fptoui8", (int)u.r8, 3);
    result &= Test("seedcast_class_userctor_p", u.p, 9);

    // A cast to bool is a truth test (value != 0), not a truncation to bit 0. Pre-fix every
    // even non-zero source read false, and a double source truncated through fptosi.
    int boolSrc = 2;
    int boolSrcWide = 256;
    double boolSrcF = 0.5;
    int* boolSrcNull = nullptr;
    bool boolImplicit = 2;
    bool boolImplicitWide = 256;
    bool boolImplicitF = 0.5;
    result &= Test("boolcast_literal_2", (bool)2 ? 1 : 0, 1);              // pre-fix: 0
    result &= Test("boolcast_literal_256", (bool)256 ? 1 : 0, 1);          // pre-fix: 0
    result &= Test("boolcast_runtime_2", (bool)boolSrc ? 1 : 0, 1);        // pre-fix: 0
    result &= Test("boolcast_runtime_256", (bool)boolSrcWide ? 1 : 0, 1);  // pre-fix: 0
    result &= Test("boolcast_double_half", (bool)0.5 ? 1 : 0, 1);          // pre-fix: 0
    result &= Test("boolcast_runtime_double_half", (bool)boolSrcF ? 1 : 0, 1);
    result &= Test("boolcast_null_pointer", (bool)boolSrcNull ? 1 : 0, 0);
    result &= Test("boolcast_implicit_2", boolImplicit ? 1 : 0, 1);        // pre-fix: 0
    result &= Test("boolcast_implicit_256", boolImplicitWide ? 1 : 0, 1);  // pre-fix: 0
    result &= Test("boolcast_implicit_double", boolImplicitF ? 1 : 0, 1);  // pre-fix: verifier error

    // T84: a double above INT_MAX into a 32-bit unsigned is fptoui; pre-fix fptosi gave garbage.
    t84Seed();
    u32 t84CastU32 = (u32)t84Big;
    result &= Test("t84_fptoui_cast_u32", (i64)t84CastU32 == (i64)3000000000, true);     // pre-fix: garbage
    result &= Test("t84_fptoui_cast_2gb", (i64)(u32)t84Mid == (i64)2147483648, true);    // pre-fix: garbage
    result &= Test("t84_fptoui_cast_literal", (i64)(u32)3000000000.0 == (i64)3000000000, true);  // literal fold: pre-fix poison, not detected here
    result &= Test("t84_fptoui_cast_u64", (i64)(u64)t84Big == (i64)3000000000, true);  // control: 64-bit already fptosi-correct
    result &= Test("t84_fptoui_cast_u8", (i64)(u8)t84Small == (i64)200, true);          // control: passes pre-fix
    result &= Test("t84_fptoui_cast_u16", (i64)(u16)60000.5 == (i64)60000, true);
    u32 t84Decl = (u32)t84Big;
    result &= Test("t84_fptoui_decl_init", (i64)t84Decl == (i64)3000000000, true);      // pre-fix: garbage
    u32 t84Assign = 0;
    t84Assign = (u32)t84Big;
    result &= Test("t84_fptoui_assign", (i64)t84Assign == (i64)3000000000, true);       // pre-fix: garbage
    u32 t84Compound = 0;
    // C compound semantics: the sum is formed in double, then truncated. Implicit `+=` is refused (err_implicit_float_to_int).
    t84Compound = (u32)(t84Compound + t84Big);
    result &= Test("t84_fptoui_compound", (i64)t84Compound == (i64)3000000000, true);
    T84Field t84F;
    t84F.f = (u32)t84Big;
    result &= Test("t84_fptoui_field_assign", (i64)t84F.f == (i64)3000000000, true);    // pre-fix: garbage
    T84Field t84B = { f = (u32)t84Big };
    result &= Test("t84_fptoui_brace_field", (i64)t84B.f == (i64)3000000000, true);     // pre-fix: garbage
    T84Bits t84Bits;
    t84Bits.b = (u32)t84Big;
    result &= Test("t84_fptoui_bitfield", (i64)t84Bits.b == (i64)24064, true);          // pre-fix: garbage
    T84Union t84U = { f = (u32)t84Big };
    result &= Test("t84_fptoui_union_field", (i64)t84U.f == (i64)3000000000, true);     // pre-fix: garbage
    unsigned[2] t84Arr;
    t84Arr[0] = (u32)t84Big;
    result &= Test("t84_fptoui_array_elem", (i64)t84Arr[0] == (i64)3000000000, true);   // pre-fix: garbage
    u32[2] t84ArrBrace = { (u32)t84Big, (u32)100.5 };
    result &= Test("t84_fptoui_array_brace", (i64)t84ArrBrace[0] == (i64)3000000000, true);
    u32[] t84ViewBrace = { (u32)t84Big, (u32)100.5 };
    result &= Test("t84_fptoui_array_view_brace", (i64)t84ViewBrace[0] == (i64)3000000000, true);
    T84UnionDefault t84UD;
    result &= Test("t84_fptoui_union_default", (i64)t84UD.f == (i64)3000000000, true);
    result &= Test("t84_fptoui_global_init", (i64)t84Global == (i64)3000000000, true);
    simd<u32,4> t84Vec = (u32)t84Big;
    result &= Test("t84_fptoui_simd_splat", (i64)t84Vec[0] == (i64)3000000000, true);   // pre-fix: garbage

    // Brace-init is its own door: it stored the source bytes raw over the i1 slot, so '2' read
    // back as 2 (a poisoned bool, neither true nor false) and a double stored four bytes.
    BoolBraceInit bb2 = { f = 2 };
    BoolBraceInit bb256 = { f = 256 };
    BoolBraceInit bbf = { f = 0.5 };
    BoolBraceInit bb0 = { f = 0 };
    result &= Test("boolbrace_2", bb2.f ? 1 : 0, 1);              // pre-fix: 2 (poisoned i1)
    result &= Test("boolbrace_256", bb256.f ? 1 : 0, 1);          // pre-fix: 0
    result &= Test("boolbrace_double", bbf.f ? 1 : 0, 1);         // pre-fix: 0
    result &= Test("boolbrace_zero", bb0.f ? 1 : 0, 0);
    result &= Test("boolbrace_neighbour_intact", bbf.g, 7);       // pin: padding absorbed the wide store

    // T151 accept-set (frozen before the guard): explicit casts, implicit int->float, any->bool,
    // and integer constants that fit their element type inside a native brace initializer.
    double t151D = 3.7;
    float t151F = 1.5;
    int t151I = -7;
    result &= Test("t151_cast_int_trunc", (int)t151D, 3);
    result &= Test("t151_cast_int_trunc_neg", (int)-3.7, -3);
    result &= Test("t151_cast_u8_fraction", (i64)(u8)255.9, (i64)255);
    result &= Test("t151_cast_u32_fraction", (i64)(u32)4294967295.5, (i64)4294967295);
    result &= Test("t151_cast_float_to_double", (double)t151F == 1.5, true);
    result &= Test("t151_cast_int_to_double", (double)t151I == -7.0, true);
    double t151Wide = t151I;
    result &= Test("t151_implicit_int_to_double", t151Wide == -7.0, true);
    float t151FromInt = 9;
    result &= Test("t151_implicit_int_to_float", t151FromInt == 9.0, true);
    bool t151B = t151D;
    result &= Test("t151_implicit_double_to_bool", t151B ? 1 : 0, 1);
    int [1] t151FitInt = { 2147483647 };
    int [1] t151FitNeg = { -1 };
    i8 [1] t151FitI8 = { -128 };
    u8 [1] t151FitU8 = { 255 };
    u32 [1] t151FitU32 = { 4294967295 };
    u64 [1] t151FitU64 = { 0xFFFFFFFFFFFFFFFF };
    double [1] t151FitDbl = { 3 };
    result &= Test("t151_brace_fit_int_max", (i64)t151FitInt[0], (i64)2147483647);
    result &= Test("t151_brace_fit_int_neg", (i64)t151FitNeg[0], (i64)-1);
    result &= Test("t151_brace_fit_i8_min", (i64)t151FitI8[0], (i64)-128);
    result &= Test("t151_brace_fit_u8_max", (i64)t151FitU8[0], (i64)255);
    result &= Test("t151_brace_fit_u32_max", (i64)t151FitU32[0], (i64)4294967295);
    result &= Test("t151_brace_fit_u64_max", (i64)t151FitU64[0], (i64)-1);
    result &= Test("t151_brace_fit_int_to_double", t151FitDbl[0] == 3.0, true);
    T151Fit t151Fit = { a = 255, b = -1 };
    result &= Test("t151_brace_fit_field_u8", (i64)t151Fit.a, (i64)255);
    result &= Test("t151_brace_fit_field_int", (i64)t151Fit.b, (i64)-1);
    T151Fit t151Sign = { b = (int)(u32)4294967295 };
    result &= Test("t151_brace_explicit_sign_cast", (i64)t151Sign.b, (i64)-1);
    T151Byte t151Byte = { a = (u8)300 };
    result &= Test("t151_bitfield_explicit_u8_cast", (i64)t151Byte.a, (i64)44);
    T151Bool t151BoolBits = default;
    t151BoolBits.x = t151D;
    result &= Test("t151_bool_bitfield_double_truth", t151BoolBits.x, true);
    T151Bool t151BoolZero = default;
    t151BoolZero.x = 0.0;
    result &= Test("t151_bool_bitfield_double_zero", t151BoolZero.x, false);
    T151Bool t151BoolBrace = { x = t151F };
    result &= Test("t151_bool_bitfield_brace_truth", t151BoolBrace.x, true);
    return result;
}

bool testNoArgCtorFieldSeeding()
{
    bool result = true;
    SeededAllDefaulted a;
    // Seeding runs BEFORE the body, so the body reads 7 and writes 107 (was 100: unseeded).
    result &= Test("seed_alldef_nested_v", a.nested.v, 107);
    result &= Test("seed_alldef_nested_deep_w", a.nested.d.w, 42);
    result &= Test("seed_alldef_default_v", a.dn.v, 7);
    result &= Test("seed_alldef_default_deep_w", a.dn.d.w, 42);
    result &= Test("seed_alldef_plain", a.plain, 8);
    SeededBareCtor b;
    result &= Test("seed_bare_nested_v", b.nested.v, 7);
    result &= Test("seed_bare_nested_deep_w", b.nested.d.w, 42);
    result &= Test("seed_bare_default_v", b.dn.v, 7);
    result &= Test("seed_bare_default_deep_w", b.dn.d.w, 42);
    result &= Test("seed_bare_plain", b.plain, 5);
    SeedBox<int> g;
    result &= Test("seed_generic_nested_v", g.nested.v, 7);
    result &= Test("seed_generic_nested_deep_w", g.nested.d.w, 42);
    return result;
}

/*
 * Regression: a GLOBAL of a struct/class type ignored its fields' own default expressions.
 * The local declarator calls the type's default constructor; the global path left the
 * initializer null and CreateGlobalVariable emitted a plain zeroinitializer, so every field
 * read 0 - a SILENT WRONG VALUE against the identical local spelling. A global now takes the
 * CONSTANT VALUE of that same construction. The three global spellings (no initializer,
 * '= default', '= {}') all went through the same zeroing hole and are all covered.
 * Every leg below pairs the global with its LOCAL twin, which is the oracle.
 */
struct GSeedPlain { int a = 91; int b = 92; };
struct GSeedTrunc { u8 r = 200; i16 s = 300; bool t = 5; };
class GSeedClass { int a = 93; SeedInner nested; };
namespace GSeedNS { struct GSeedNsType { int a = 94; }; }
struct GSeedUserCtor { int a = 95; GSeedUserCtor() { a = 96; } };

GSeedPlain gSeedPlain;
SeedInner gSeedNested;
SeedInner gSeedDefault = default;
SeedInner gSeedBrace = {};
GSeedTrunc gSeedTrunc;
GSeedClass gSeedClass;
GSeedNS.GSeedNsType gSeedNs;

// Global default-fold budget and source-order legs. Each global is paired with a local oracle.
struct GSeedFoldD0 { int v = 100; };
struct GSeedFoldD1 { GSeedFoldD0 inner; int w = 1; };
struct GSeedFoldD2 { GSeedFoldD1 inner; int w = 2; };
struct GSeedFoldD3 { GSeedFoldD2 inner; int w = 3; };
struct GSeedFoldD4 { GSeedFoldD3 inner; int w = 4; };
struct GSeedFoldD5 { GSeedFoldD4 inner; int w = 5; };
struct GSeedFoldD6 { GSeedFoldD5 inner; int w = 6; };
struct GSeedFoldLeaf { int v = 9; };
struct GSeedFoldWide
{
    GSeedFoldLeaf f0; GSeedFoldLeaf f1; GSeedFoldLeaf f2; GSeedFoldLeaf f3;
    GSeedFoldLeaf f4; GSeedFoldLeaf f5; GSeedFoldLeaf f6; GSeedFoldLeaf f7;
    GSeedFoldLeaf f8; GSeedFoldLeaf f9; GSeedFoldLeaf f10; GSeedFoldLeaf f11;
    GSeedFoldLeaf f12; GSeedFoldLeaf f13; int t = 5;
};
struct GSeedFoldOrder<T> { T item = default; int tag = 55; };

GSeedFoldD6 gSeedFoldDeep;
GSeedFoldWide gSeedFoldWide;
GSeedFoldForward gSeedFoldForward;
GSeedFoldOrder<int> gSeedFoldOrder;
struct GSeedFoldForward { int a = 17; };
int gSeedFoldWarm() { GSeedFoldOrder<int> warm; return warm.tag; }

bool testGlobalFoldOrderBudget()
{
    bool result = true;
    GSeedFoldD6 localDeep;
    result &= Test("gseed_fold_deep_global", gSeedFoldDeep.w, localDeep.w);
    result &= Test("gseed_fold_deep_leaf", gSeedFoldDeep.inner.inner.inner.inner.inner.inner.v, 100);
    GSeedFoldWide localWide;
    result &= Test("gseed_fold_wide_global", gSeedFoldWide.f13.v, localWide.f13.v);
    result &= Test("gseed_fold_wide_tail", gSeedFoldWide.t, localWide.t);
    GSeedFoldForward localForward;
    result &= Test("gseed_fold_forward_global", gSeedFoldForward.a, localForward.a);
    GSeedFoldOrder<int> localOrder;
    result &= Test("gseed_fold_order_global", gSeedFoldOrder.tag, localOrder.tag);
    return result;
}

bool testGlobalDefaultSeeding()
{
    bool result = true;
    // Scalar field defaults. Pre-fix: every global leg read 0, every local leg was correct.
    GSeedPlain lPlain;
    result &= Test("gseed_plain_local_a", lPlain.a, 91);
    result &= Test("gseed_plain_local_b", lPlain.b, 92);
    result &= Test("gseed_plain_global_a", gSeedPlain.a, 91);
    result &= Test("gseed_plain_global_b", gSeedPlain.b, 92);

    // A struct-typed field with no initializer, two levels deep - the nested default ctor
    // has to be folded through as well, not just the leaf constants.
    SeedInner lNested;
    result &= Test("gseed_nested_local_v", lNested.v, 7);
    result &= Test("gseed_nested_local_deep_w", lNested.d.w, 42);
    result &= Test("gseed_nested_global_v", gSeedNested.v, 7);
    result &= Test("gseed_nested_global_deep_w", gSeedNested.d.w, 42);

    // The other two global spellings of the same construction.
    result &= Test("gseed_default_global_v", gSeedDefault.v, 7);
    result &= Test("gseed_default_global_deep_w", gSeedDefault.d.w, 42);
    result &= Test("gseed_brace_global_v", gSeedBrace.v, 7);
    result &= Test("gseed_brace_global_deep_w", gSeedBrace.d.w, 42);

    // Defaults needing a CONVERSION - the value has to come through the ctor's cast arm.
    GSeedTrunc lTrunc;
    result &= Test("gseed_trunc_local_u8", (int)lTrunc.r, 200);
    result &= Test("gseed_trunc_global_u8", (int)gSeedTrunc.r, 200);
    result &= Test("gseed_trunc_local_i16", (int)lTrunc.s, 300);
    result &= Test("gseed_trunc_global_i16", (int)gSeedTrunc.s, 300);
    result &= Test("gseed_trunc_local_bool", lTrunc.t ? 1 : 0, 1);
    result &= Test("gseed_trunc_global_bool", gSeedTrunc.t ? 1 : 0, 1);

    // class, and a namespaced type.
    GSeedClass lClass;
    result &= Test("gseed_class_local_a", lClass.a, 93);
    result &= Test("gseed_class_local_nested_v", lClass.nested.v, 7);
    result &= Test("gseed_class_global_a", gSeedClass.a, 93);
    result &= Test("gseed_class_global_nested_v", gSeedClass.nested.v, 7);
    GSeedNS.GSeedNsType lNs;
    result &= Test("gseed_ns_local_a", lNs.a, 94);
    result &= Test("gseed_ns_global_a", gSeedNs.a, 94);

    /*
     * A user-written constructor body cannot initialize a native global unless it folds.
     */
    GSeedUserCtor lUser;
    result &= Test("gseed_userctor_local_a", lUser.a, 96);
    return result;
}

/*
 * Regression: a field whose declared type is a VALUE STRUCT with an implicit conversion from a
 * char pointer ('string') had its declared initializer silently dropped. The initializer's value
 * is an i8*, so the aggregate assembler's type-mismatch arm (MainListener_Aggregates.cpp, struct
 * :342-369 / class :3055-3070 / user no-arg ctor :3706-3720) saw destType->isStructTy() and
 * DEFAULT-CONSTRUCTED the field type instead of converting it - the field read empty in every
 * construction form, while the identical LOCAL declaration converted correctly. The conversion
 * now happens once in ParseFieldDefaultInitializer, the single path all those loops share.
 * Discriminator: each leg reads a field whose type is 'string' (not char*) and whose default is a
 * char pointer; the neighbouring 'sfdCharPtr' / 'sfdExpr' legs take the arms that already worked
 * and must not move. Every '_lit' leg reads "" on the pre-fix binary.
 */
struct SfdBox      { string s = "sfd_bare"; int n = 3; };
struct SfdUser     { string s = "sfd_user"; int n = 4; SfdUser() { } };
struct SfdOuter    { SfdBox inner; int k = 5; };
struct SfdGeneric<T> { T v = default; string tag = "sfd_generic"; int n = 6; };
class  SfdClass    { string s = "sfd_class"; int n = 7; };
struct SfdArrHolder { SfdBox[2] items; int n = 8; };
struct SfdCharPtr  { const char* s = "sfd_charptr"; int n = 9; };
struct SfdExpr     { string s = sfdMakeString(); int n = 10; };
struct SfdDefault  { string s = default; int n = 11; };
namespace SfdNS { struct SfdNsBox { string s = "sfd_ns"; int n = 12; }; }

string sfdMakeString() { return "sfd_expr"; }
const char* gSfdRawPtr = "sfd_runtime";
struct SfdRuntime  { string s = gSfdRawPtr; int n = 13; };

SfdBox gSfdBox = default;
SfdOuter gSfdOuter = default;
SfdNS.SfdNsBox gSfdNs = default;
SfdClass gSfdClass = default;

bool testStringFieldDefault()
{
    bool result = true;
    // Every construction form of the same struct: all of them read "" before the fix.
    SfdBox bare;                    result &= Test("sfd_bare_lit", bare.s.data(), "sfd_bare");
    result &= Test("sfd_bare_len", bare.s.length(), 8);
    SfdBox eq = default;            result &= Test("sfd_eqdefault_lit", eq.s.data(), "sfd_bare");
    SfdBox empty = { };             result &= Test("sfd_emptybrace_lit", empty.s.data(), "sfd_bare");
    SfdBox call = SfdBox();         result &= Test("sfd_ctorcall_lit", call.s.data(), "sfd_bare");
    SfdBox partial = { n = 99 };    result &= Test("sfd_partial_lit", partial.s.data(), "sfd_bare");
    result &= Test("sfd_partial_other", partial.n, 99);
    // Accept-set pin: an explicit override already worked and must keep winning.
    SfdBox over = { s = "sfd_over" }; result &= Test("sfd_override_pin", over.s.data(), "sfd_over");

    SfdUser user;                   result &= Test("sfd_userctor_lit", user.s.data(), "sfd_user");
    SfdOuter outer;                 result &= Test("sfd_nested_lit", outer.inner.s.data(), "sfd_bare");
    SfdGeneric<int> gen;            result &= Test("sfd_generic_lit", gen.tag.data(), "sfd_generic");
    SfdClass cls;                   result &= Test("sfd_class_lit", cls.s.data(), "sfd_class");
    SfdArrHolder arr;               result &= Test("sfd_arrayfield_lit", arr.items[1].s.data(), "sfd_bare");
    SfdBox[2] locals;               result &= Test("sfd_localarray_lit", locals[1].s.data(), "sfd_bare");
    // A RUNTIME char pointer takes the operator string(const char*) arm of the same conversion.
    SfdRuntime rt;                  result &= Test("sfd_runtimeptr_lit", rt.s.data(), "sfd_runtime");
    result &= Test("sfd_runtimeptr_len", rt.s.length(), 11);

    // Globals: the default construction folds to a real constant, literal included.
    result &= Test("sfd_global_lit", gSfdBox.s.data(), "sfd_bare");
    result &= Test("sfd_global_other", gSfdBox.n, 3);
    result &= Test("sfd_global_nested_lit", gSfdOuter.inner.s.data(), "sfd_bare");
    result &= Test("sfd_global_ns_lit", gSfdNs.s.data(), "sfd_ns");
    result &= Test("sfd_global_class_lit", gSfdClass.s.data(), "sfd_class");

    // Accept-set pins: the arms that already converted (or deliberately do not) must not move.
    SfdCharPtr cp;                  result &= Test("sfd_charptr_pin", cp.s, "sfd_charptr");
    SfdExpr expr;                   result &= Test("sfd_expr_pin", expr.s.data(), "sfd_expr");
    SfdDefault dflt;                result &= Test("sfd_default_pin", dflt.s.length(), 0);
    string local = "sfd_local";     result &= Test("sfd_local_oracle", local.data(), "sfd_local");
    return result;
}

extern int strcmp(const char* a, const char* b);

bool Test(const char* testName, const char* actual, const char* expected)
{
    if (strcmp(actual, expected) == 0)
    {
        printf("%s passed.\n", testName);
        return true;
    }
    printf("%s failed: expected '%s' but got '%s'.\n", testName, expected, actual);
    return false;
}

struct NamedThing
{
    int value = 42;
};


struct TypedThing
{
    int count = 0;
    bool flag = false;
};

bool testTypeof()
{
    bool result = true;
    int i = 0;
    bool b = false;
    TypedThing t = TypedThing();
    enum LocalTypeofEnum : int { Value = 1 };
    LocalTypeofEnum localEnum = LocalTypeofEnum.Value;

    result &= Test("typeof_int", typeof(i), "int");
    result &= Test("typeof_bool", typeof(b), "bool");
    result &= Test("typeof_struct", typeof(t), "TypedThing");
    result &= Test("typeof_field_int", typeof(t.count), "int");
    result &= Test("typeof_field_bool", typeof(t.flag), "bool");
    result &= Test("typeof_type_int", typeof(int), "int");
    result &= Test("typeof_type_name", typeof(TypedThing), "TypedThing");
    result &= Test("typeof_local_enum", typeof(localEnum), "LocalTypeofEnum");
    return result;
}

bool testNameof()
{
    bool result = true;
    int myVar = 0;
    NamedThing thing = NamedThing();

    result &= Test("nameof_var", nameof(myVar), "myVar");
    result &= Test("nameof_struct", nameof(thing), "thing");
    result &= Test("nameof_field", nameof(thing.value), "value");
    result &= Test("nameof_type", nameof(NamedThing), "NamedThing");
    return result;
}

// Namespace tests

int add(int a, int b) { return a + b + 100; }  // global add returns a different value

namespace MathUtils
{
    // Namespace globals register under their qualified name (MathUtils.nsCounter),
    // like namespace functions: qualified access works from outside, bare sibling
    // access works from inside, and the bare name does NOT leak outside.
    int nsCounter = 7;
    const int BASE = 120;

    int readCounter() { return nsCounter; }
    void bumpCounter() { nsCounter++; }

    int add(int a, int b) { return a + b; }
    int multiply(int a, int b) { return a * b; }

    // Unqualified sibling call: `add` must resolve to MathUtils.add (NOT the global
    // `add` that returns a+b+100), so addThenDouble(3,4) == (3+4)*2 == 14.
    int addThenDouble(int a, int b) { return multiply(add(a, b), 2); }

    // `global::add` escapes the namespace and reaches the GLOBAL add (a+b+100),
    // even though the sibling MathUtils.add (a+b) would shadow a bare `add`.
    int addViaGlobal(int a, int b) { return global::add(a, b); }

    // Bare `add` still resolves to the sibling MathUtils.add (a+b).
    int addViaSibling(int a, int b) { return add(a, b); }

    namespace Advanced
    {
        int square(int x) { return x * x; }
        int cube(int x) { return x * x * x; }

        // Unqualified sibling call inside a nested namespace resolves to
        // Advanced.square; sumOfSquares(3,4) == 9 + 16 == 25.
        int sumOfSquares(int a, int b) { return square(a) + square(b); }

        // `global::` with a dotted path resolves at the root: global::MathUtils.add
        // is the sibling-free root MathUtils.add (a+b), reached from this nested scope.
        int addViaGlobalDotted(int a, int b) { return global::MathUtils.add(a, b); }

        // A bare global reference inside a nested namespace walks outward through
        // parent namespaces: BASE resolves to MathUtils.BASE.
        int readOuterBase() { return BASE; }
    }
}

// Dotted namespace declaration: `namespace a.b { }` declares the nested chain in
// one line. An extern inside a namespace registers under the qualified lookup
// name (sysapi.libc.toupper) but keeps its bare linkage symbol, so it binds to
// the same imported C function. A namespace function signature may reference a
// sibling struct unqualified. Bind a ubiquitous libc/CRT function here, not a
// Win32 one, so this file stays portable.
namespace sysapi.libc
{
    extern int toupper(int c);

    struct Box2 {
        int w = default;
        int h = default;
    };

    int area(Box2* b) { return b->w * b->h; }
}

namespace nsx { extern int LaterNs(int x); }

using Math = MathUtils;          // global alias for top-level namespace
using MathAdv = MathUtils.Advanced;  // global alias for nested namespace

// A namespace variable spelled like a global function (and like a global variable): a bare name
// inside the namespace is the namespace variable. PRE-FIX: "module verification failed" or the
// global function / global value was read instead.
int t187Shadow(int a) { return a + 100; }
int t187Var = 3;
namespace T187Ns
{
    int t187Shadow = 8;
    int readVar() { return t187Shadow; }
    int tern(int k) { return k ? t187Shadow : 4; }
    void setVar() { t187Shadow = 9; }
    int readAfterSet() { setVar(); return t187Shadow; }
    int t187Var = 8;
    int readGlobalSpelling() { return t187Var; }
}
namespace T187Outer
{
    int t187Outer(int a) { return a + 100; }
    namespace Inner { int t187Outer = 5; int run() { return t187Outer; } }
}
namespace T187Outer2
{
    int t187Outer2 = 5;
    namespace Inner { int run() { return t187Outer2; } }
}
int t187Outer2(int a) { return a + 100; }
struct T187Field
{
    int t187Shadow = default;
    int get() { return t187Shadow; }
};

// T193: a namespace function beats a global variable or global function of the same name in value
// position, and a namespace const sizes an array in local, nested, field, global and generic-argument
// positions. PRE-FIX: the global was read, or the file-scope const (1) won.
int t193Lo = 7;
const int T193K = 1;
int t193Apply(function<int(int)> f) { return f(1); }
namespace T193Fn
{
    int t193Lo(int a) { return a + 1; }
    int decl() { function<int(int)> p = t193Lo; return p(1); }
    int assign() { function<int(int)> p = default; p = t193Lo; return p(1); }
    int arg() { return t193Apply(t193Lo); }
    function<int(int)> ret() { return t193Lo; }
    int retCall() { function<int(int)> p = ret(); return p(1); }
    namespace T193Deep { int nested() { function<int(int)> p = t193Lo; return p(1); } }
}
namespace T193Dim
{
    const int T193K = 3;
    int local() { int[T193K] a = default; return sizeof(a) / sizeof(int); }
    namespace T193Inner { int local() { int[T193K] a = default; return sizeof(a) / sizeof(int); } }
    struct T193Box
    {
        int[T193K] f;
    };
    int[T193K] garr;
    struct T193Buf<T, int CAP> { T[CAP] items; int cap() { return CAP; } };
    int gen() { T193Buf<int, T193K> b = default; return b.cap(); }
}
// T206 guard: a NON-const namespace int sizes a local array at run time (a VLA, sizeof 4 as in the
// t118_* legs), never the file-scope const of the same name (2 would give sizeof 8).
const int T206FileK = 2;
namespace T206Vla
{
    int T206FileK = 7;
    int local() { int[T206FileK] a = default; return (int)sizeof(a); }
}

namespace QoAcceptRoot { int fn() { return 90; } int value = 80; enum E : int { item = 70 }; }
namespace QoAcceptOuter
{
    namespace QoAcceptRoot { int fn() { return 10; } int value = 20; enum E : int { item = 30 }; }
    int call() { return QoAcceptRoot.fn(); }
    int globalValue() { return QoAcceptRoot.value; }
    int enumValue() { return (int)QoAcceptRoot.E.item; }
    int rootCall() { return global::QoAcceptRoot.fn(); }
    int rootValue() { return global::QoAcceptRoot.value; }
    int rootEnum() { return (int)global::QoAcceptRoot.E.item; }
}

namespace QoLateUse
{
    int callRoot() { return QoLateRoot.fn(); }
    int globalValue() { return QoLateRoot.value; }
    int enumValue() { return (int)QoLateRoot.E.item; }
    int enumArgument(QoLateRoot.E value) { return (int)value; }
    int arrayValue() { return QoLateRoot.values[1]; }
    int staticValue() { return QoLateRoot.hidden; }
    int pointerValue() { return *QoLateRoot.pointer; }
    int viewValue() { return QoLateRoot.view[0]; }
    int externValue() { return QoLateRoot.qoExternValue; }
    int externFunction() { return QoLateRoot.abs(-12); }
    int staticMethod() { return QoLateRoot.S.run(); }
    int overload() { return QoLateRoot.pick(2); }
    int generic() { return QoLateRoot.gen<int>(2); }
    int nested() { return QoLateParent.Child.fn(); }
    int rooted() { return global::QoLateRoot.fn(); }
    struct Caller { int method() { return QoLateRoot.fn(); } };
}
namespace QoLateSibling
{
    namespace Use { int call() { return Target.fn(); } }
    namespace Target { int fn() { return 22; } }
}
namespace QoLateRoot
{
    int fn() { return 20; }
    int value = 3;
    int[2] values = {4, 5};
    static int hidden = 13;
    int* pointer = &value;
    int[] view = values;
    extern int qoExternValue;
    extern int abs(int x);
    struct S { static int run() { return 23; } };
    enum E : int { item = 7 };
    int pick(int x) { return x + 10; }
    int pick(double x) { return 90; }
    int gen<T>(T x) { return x + 10; }
}
int qoExternValue = 19;
namespace QoLateParent.Child { int fn() { return 21; } }
