bool testPrimitiveTypeAlias()
{
    bool result = true;

    MyInt  i = 10;
    result &= Test("alias_int_decl",      i,                      10);
    result &= Test("alias_int_func",      primitiveAliasAdd(3, 4), 7);

    MyU32  u = 300000;
    result &= Test("alias_u32_decl",      u,                       300000);
    result &= Test("alias_u32_func",      primitiveAliasU32(10, 5), 15);

    MyI64  l = 1000000000;
    result &= Test("alias_i64_decl",      l,                       1000000000);
    result &= Test("alias_i64_func",      primitiveAliasI64(100, 200), 300);

    MyBool b = true;
    result &= Test("alias_bool_decl",     b,                       true);

    MyF32  f = 1.5f;
    result &= Test("alias_float_decl",    f,                       1.5f);

    // Local alias inside a function
    using LocalU8 = u8;
    LocalU8 byte = 255;
    result &= Test("local_alias_u8",      byte,                    255);

    return result;
}

bool testBlockScopeTypeAliases()
{
    bool result = true;
    int typedefResult = 0;
    {
        typedef double TDScopeTypedefAlias;
        TDScopeTypedefAlias value = 1.5;
        function<int(TDScopeTypedefAlias)> selected = tdscopePick;
        typedefResult = (int)(value * 10) + selected(1);
    }
    TDScopeTypedefAlias typedefRestored = 1;
    function<int(TDScopeTypedefAlias)> typedefAfter = tdscopePick;
    typedefResult += (int)(typedefRestored * 100) + typedefAfter(1);
    result &= Test("tdscope_typedef_block_restore", typedefResult, 118);

    int usingResult = 0;
    {
        using TDScopeUsingAlias = double;
        TDScopeUsingAlias value = 1.5;
        function<int(TDScopeUsingAlias)> selected = tdscopePick;
        usingResult = (int)(value * 10) + selected(1);
    }
    TDScopeUsingAlias usingRestored = 1;
    function<int(TDScopeUsingAlias)> usingAfter = tdscopePick;
    usingResult += (int)(usingRestored * 100) + usingAfter(1);
    result &= Test("tdscope_using_block_restore", usingResult, 118);

    int nestedResult = 0;
    {
        typedef double TDScopeNestedAlias;
        TDScopeNestedAlias outer = 1;
        function<int(TDScopeNestedAlias)> outerFn = tdscopePick;
        nestedResult += (int)(outer * 10) + outerFn(0);
        {
            typedef char TDScopeNestedAlias;
            TDScopeNestedAlias inner = 1;
            function<int(TDScopeNestedAlias)> innerFn = tdscopePick;
            nestedResult += (int)inner * 10 + innerFn(0);
        }
        TDScopeNestedAlias restored = 1;
        function<int(TDScopeNestedAlias)> restoredFn = tdscopePick;
        nestedResult += (int)(restored * 100) + restoredFn(0);
    }
    TDScopeNestedAlias global = 1;
    function<int(TDScopeNestedAlias)> globalFn = tdscopePick;
    nestedResult += (int)global + globalFn(0);
    result &= Test("tdscope_nested_block_restore", nestedResult, 129);

    result &= Test("tdscope_if_body_restore", tdscopeIfAliasLeg(), 118);
    result &= Test("tdscope_for_body_restore", tdscopeForAliasLeg(), 118);
    result &= Test("tdscope_for_init_restore", tdscopeForInitAliasLeg(), 119);
    result &= Test("tdscope_switch_body_restore", tdscopeSwitchAliasLeg(), 118);
    result &= Test("tdscope_function_type_alias_restore", tdscopeFunctionTypeAliasLeg(), 21);
    result &= Test("tdscope_generic_body_alias", tdscopeGenericBlock<int>(2), 19);
    result &= Test("tdscope_outer_alias_generic_arg", tdscopeOuterAliasGenericArgLeg(), 26);

    TDScopeBox<int> box = default;
    {
        using TDScopeIntBox = TDScopeBox<int>;
        TDScopeIntBox inside = default;
        inside.value = 7;
        box = inside;
    }
    result &= Test("tdscope_generic_specialization_alias_inside", box.value, 7);
    result &= Test("tdscope_struct_alias_unchanged", tdscopeStructAliasLeg(), 116);
    return result;
}

// =============================================================
// Pointer type alias tests (using Handle = void*) - Tier 2
// The trailing '*' is stored in the alias string and peeled back onto the
// Pointer / ElemPointer flags at the resolution site.
// =============================================================

struct AliasNode { int v = 0; };

using IntPtrAlias = int*;
using VoidPtrAlias = void*;
using NodePtrAlias = AliasNode*;

int derefIntPtrAlias(IntPtrAlias p) { return *p; }   // alias used in a parameter

bool testPointerTypeAlias()
{
    bool result = true;

    int x = 7;
    IntPtrAlias p = &x;
    result &= Test("ptr_alias_deref",  *p,                   7);
    result &= Test("ptr_alias_in_fn",  derefIntPtrAlias(p),  7);

    // void* alias holds any pointer and round-trips through a cast
    VoidPtrAlias h = (void*)p;
    result &= Test("ptr_alias_void_nonnull", h != nullptr,   true);
    IntPtrAlias back = (int*)h;
    result &= Test("ptr_alias_void_roundtrip", *back,        7);

    // alias star + use-site star => int**
    IntPtrAlias* pp = &p;
    result &= Test("ptr_alias_double", **pp,                 7);

    // struct pointer alias
    AliasNode n = default;
    n.v = 99;
    NodePtrAlias np = &n;
    result &= Test("ptr_alias_struct", np->v,                99);

    return result;
}

int pointerPositiveFn(int x) { return x + 1; }

struct T478Arg { int z = default; int y = default; };
struct T478Big { int a = default; int b = default; int c = default; int d = default; int e = default; };
int t478ApplySmall(T478Arg a, int k) { return a.z * 10 + k; }
int t478ApplyBig(T478Big a, int k) { return a.a * 10 + a.e + k; }
int t478Scalar(int x, int k) { return x + k; }
T478Arg t478MakeSmall(int z) { T478Arg a; a.z = z; a.y = 2; return a; }
T478Big t478MakeBig(int a) { T478Big b; b.a = a; b.e = 5; return b; }
int t478GlobalAddEleven(int x) { return x + 11; }
function<int(int)> t478GlobalFunction = t478GlobalAddEleven;
function<int(int)>* t478GlobalSlot = nullptr;
function<int(int)>* t478GetFp() { return &t478GlobalFunction; }
int t478RunGlobalSlot() { t478GlobalSlot = &t478GlobalFunction; return (*t478GlobalSlot)(6); }
int t478OwnerDtorCount = 0;
struct T478Resource { int id = default; ~T478Resource() { t478OwnerDtorCount++; } };
struct T478Owner { unique T478Resource* item = nullptr; };
T478Resource* t478MakeResource() { T478Resource* r = new T478Resource(); r->id = 7; return r; }
int t478ReadOwner(T478Owner owner) { return owner.item->id; }
int t478PointerOwnerBrace() { function<int(T478Owner)> fp = t478ReadOwner; return (*fp)({ item = t478MakeResource() }); }
int t478FunctionOwnerBrace() { function<int(T478Owner)> fn = t478ReadOwner; return fn({ item = t478MakeResource() }); }
int* pointerNullReturnZero() { return 0; }
int pointerNullArg(int* p) { return p == nullptr ? 1 : 0; }

struct T345CtorLambda
{
    int id = 0;
    Lambda<int()> stored = default;
    int get() { return id; }
    int methodBareField() { Lambda<int()> f = () => { return id + 1; }; return f(); }
    T345CtorLambda(int i)
    {
        Lambda<int()> init = () => { this.id = i; return this.id; };
        init();
        this.stored = () => { return id + this.get() + i; };
    }
};

struct T345GenericCtorLambda<T>
{
    T value = default;
    int id = 0;
    Lambda<int()> stored = default;
    int get() { return id + (int)value; }
    T345GenericCtorLambda(T value, int i)
    {
        this.value = value;
        this.id = i;
        this.stored = () => { return this.get() + i; };
    }
};

struct T345CtorLambdaValue
{
    int id = 0;
    Lambda<int()> f = default;
    T345CtorLambdaValue() { this.f = () => { return this.id; }; }
};
struct T345CtorLambdaExplicitParent
{
    T345CtorLambdaValue value = T345CtorLambdaValue();
    Lambda<int()> dummy = default;
    T345CtorLambdaExplicitParent() {}
};
struct T345CtorLambdaDefaultParent
{
    T345CtorLambdaValue value = default;
    Lambda<int()> dummy = default;
};

int t345DtorLambdaResult = 0;
int t345DtorExplicitLambdaResult = 0;
struct T345DtorLambda
{
    int id = 8;
    int get() { return id + 1; }
    ~T345DtorLambda()
    {
        Lambda<int()> f = () => { return id + this.get(); };
        Lambda<int()> explicitThis = () => { return this.id + this.get(); };
        t345DtorLambdaResult = f();
        t345DtorExplicitLambdaResult = explicitThis();
    }
};

// T407: a ctor lambda only called in the ctor is not kept, so copies stay legal; a kept one is
// reached through a local or a nested lambda and its object is built, moved or pointed to in place.
struct T407OnlyCalled
{
    int id = 0;
    int sum = 0;
    T407OnlyCalled(int i) { Lambda<int()> add = () => { sum = sum + id + i; return sum; }; id = 2; add(); add(); }
};
struct T407Kept
{
    int id = 0;
    Lambda<int()> f = default;
    Lambda<int()> g = default;
    T407Kept(int i)
    {
        this.id = i;
        Lambda<int()> h = () => { return id + 1; };
        this.f = h;
        Lambda<int()> init = () => { this.g = () => { return this.id * 2; }; return 0; };
        init();
    }
};
int t407KeptThroughPointer(T407Kept* k) { k.id = 20; return k.f() + k.g(); }
T407OnlyCalled t407MakeOnlyCalled(int i) { T407OnlyCalled s = T407OnlyCalled(i); return s; }

int t515HolderCtors = 0;
int t515HolderDtors = 0;
struct T515ClosureMember
{
    int id = 0;
    Lambda<int()> f = default;
    T515ClosureMember() { t515HolderCtors++; this.f = () => { return this.id; }; }
    T515ClosureMember(int i) { t515HolderCtors++; this.id = i; this.f = () => { return this.id; }; }
    ~T515ClosureMember() { t515HolderDtors++; }
};
struct T515ClosureHolder { T515ClosureMember s = default; };
struct T515ClosureAliasGetter
{
    T515ClosureMember* value = nullptr;
    alias T515ClosureMember get() { return *value; }
};

// A name bound in an enclosing ctor lambda (local, for-init) is not a member use, so no `this`
// capture and copies stay legal; a same-named binding out of scope leaves the member use.
int t407OuterId = 3;
struct T407OuterLocal { int id = 4; Lambda<int()> f = default; T407OuterLocal() { this.f = () => { int id = 7; Lambda<int()> g = () => { return id; }; return g(); }; } };
struct T407OuterFor { int id = 4; Lambda<int()> f = default; T407OuterFor() { this.f = () => { int r = 0; for (int id = 7; id < 8; id++) { Lambda<int()> g = () => { return id; }; r = g(); } return r; }; } };
struct T407OuterGlobal { int t407OuterId = 4; Lambda<int()> f = default; T407OuterGlobal() { this.f = () => { int t407OuterId = 7; Lambda<int()> g = () => { return t407OuterId; }; return g(); }; } };
struct T407OuterScope { int id = 4; Lambda<int()> f = default; T407OuterScope() { this.f = () => { for (int id = 7; id < 8; id++) {} Lambda<int()> g = () => { return id; }; return g(); }; } };

bool testT407ConstructorClosureCopies()
{
    bool result = true;
    T407OnlyCalled a = T407OnlyCalled(3);
    T407OnlyCalled b = a;
    T407OnlyCalled c = t407MakeOnlyCalled(1);
    result &= Test("t407_only_called_copy", b.sum, 10);
    result &= Test("t407_only_called_return", c.sum, 6);
    T407Kept k = T407Kept(4);
    k.id = 10;
    result &= Test("t407_kept_local_then_field", k.f(), 11);
    result &= Test("t407_kept_nested_lambda", k.g(), 20);
    result &= Test("t407_kept_through_pointer", t407KeptThroughPointer(&k), 61);
    T407Kept moved = move k;
    result &= Test("t407_kept_moved", moved.id, 20);
    T407Kept[2] arr = { T407Kept(1), T407Kept(2) };
    arr[1].id = 7;
    result &= Test("t407_kept_array_in_place", arr[1].f() + arr[1].g(), 22);
    T407Kept* heap = new T407Kept(5);
    heap.id = 6;
    result &= Test("t407_kept_new", heap.f(), 7);
    delete heap;
    T407OuterLocal ol = T407OuterLocal();
    T407OuterLocal olCopy = ol;
    result &= Test("t407_outer_lambda_local", olCopy.f(), 7);
    T407OuterFor of = T407OuterFor();
    T407OuterFor ofCopy = of;
    result &= Test("t407_outer_lambda_for", ofCopy.f(), 7);
    T407OuterGlobal og = T407OuterGlobal();
    T407OuterGlobal ogCopy = og;
    result &= Test("t407_outer_lambda_local_global", ogCopy.f(), 7);
    T407OuterScope os = T407OuterScope();
    result &= Test("t407_outer_lambda_out_of_scope_member", os.f(), 4);
    return result;
}

bool testT515NestedClosureHolder()
{
    bool result = true;
