};

bool testT471BareCalls()
{
    bool result = true;
    result &= Test("t504 valid call initializer", t504ValidCallInitializer(), 6);
    result &= Test("t504 struct call initializer", t504StructCallInitializer(), 7);
    TFieldInitEarlier fieldEarlier = default;
    result &= Test("field initializer reads earlier field", fieldEarlier.b, 2);
    TFieldInitClassEarlier classEarlier = default;
    result &= Test("class field initializer reads earlier field", classEarlier.get(), 2);
    void* selfAddress = &selfAddress;
    result &= Test("local self address initializer", selfAddress == &selfAddress ? 1 : 0, 1);
    TFieldInitSelfAddress selfAddressObject = { self = &selfAddressObject };
    result &= Test("typed local self address initializer",
        selfAddressObject.self == &selfAddressObject ? 1 : 0, 1);
    TFieldInitFieldAddress fieldAddress = default;
    result &= Test("field initializer takes later field address", *fieldAddress.p, 3);
    TFieldInitMemberAddress memberAddress = default;
    result &= Test("field initializer takes later by-value member address",
        *memberAddress.p, 6);
    TFieldInitMemberChain memberChain = default;
    result &= Test("field initializer takes nested later by-value member address",
        *memberChain.p, 7);
    TFieldInitMemberArray memberArray = default;
    result &= Test("field initializer takes later member array element address",
        *memberArray.p, 9);
    TFieldInitMemberArrayStruct memberArrayStruct = default;
    result &= Test("field initializer takes member array element field address",
        *memberArrayStruct.p, 10);
    TFieldInitArrayAddress arrayAddress = default;
    result &= Test("field initializer takes later fixed-array element address",
        *arrayAddress.p, 9);
    result &= Test("local initializer dereferences call result, not pending argument",
        tFieldInitCallArgument(), 8);
    TFieldInitExplicitCtor fieldExplicitCtor = default;
    result &= Test("explicit constructor seeds earlier-field default", fieldExplicitCtor.b, 2);
    TFieldInitMethod fieldMethod = default;
    result &= Test("field initializer calls member over free function", fieldMethod.value, 7);
    TFieldInitGeneric<int> fieldGeneric = default;
    result &= Test("generic field initializer reads earlier field", fieldGeneric.b, 4);
    TFieldInitNested fieldNested = default;
    result &= Test("nested field initializer reads earlier field", fieldNested.result, 5);
    TFieldInitGlobal fieldGlobalCollision = default;
    result &= Test("field initializer hides same-named global", fieldGlobalCollision.copied, 5);
    result &= Test("parameter remains visible in local initializer", tFieldInitParameter(17), 17);
    TFieldInitParenField parenField = default;
    result &= Test("field initializer calls function-typed field through parens", parenField.viaParen, 2);
    TFieldInitParenDeref parenDeref = default;
    result &= Test("field initializer calls dereferenced function pointer field", parenDeref.viaDeref, 2);
    TFieldInitParenArith parenArith = default;
    result &= Test("field initializer keeps parenthesized arithmetic", parenArith.b, 8);
    result &= Test("parenthesized free call outside a struct", (tFieldInitGv)(1), 2);
    result &= Test("t511 generic initializer stays accepted", t511GenericInitializerCall(), 4);
    result &= Test("t511 lambda parameter shadows pending local", t511LambdaParameterShadowCall(), 5);
    result &= Test("t511 lambda local shadows pending local", t511LambdaLocalCallableShadowCall(), 5);
    result &= Test("lambda parameter shadows pending value read",
        tFieldInitLambdaParameterShadow(), 7);
    result &= Test("lambda local shadows pending value read", tFieldInitLambdaLocalShadow(), 7);
    T504NamespaceMethod.M t504NamespaceValue = default;
    result &= Test("t504 namespace variable yields to member", t504NamespaceValue.call(), 23);
    T504StaticMethodNS.M t504StaticNamespaceValue = default;
    result &= Test("t504 namespace static member call", t504StaticNamespaceValue.call(), 33);
    T504GenericMemberUniqueNS.Holder t504GenericUnique = default;
    result &= Test("t504 inferred unique member template", t504GenericUnique.call(), 13);
    T504GenericMemberRootShadowNS.Holder t504GenericShadow = default;
    result &= Test("t504 member template beats outer gv", t504GenericShadow.call(), 13);
    T504GenericMemberPlainOverloadNS.Holder t504GenericPlain = default;
    result &= Test("t504 plain member overload beats template", t504GenericPlain.call(), 103);
    MtplStaticGenericNS.H mtplStatic = default;
    result &= Test("mtpl static generic bare member call", mtplStatic.call(), 13);
    result &= Test("mtpl static generic qualified member call",
        MtplStaticGenericNS.qualifiedCall(), 13);
    result &= Test("nest outer static template from nested static method",
        NestRound1NS.Outer.StaticCaller.call(), 4);
    result &= Test("nest explicit outer static template from nested method",
        NestRound1NS.Outer.ExplicitCaller.call(), 4);
    NestRound1NS.Outer.InstanceCaller nestInstance = default;
    result &= Test("nest outer static template from nested instance method",
        nestInstance.call(), 4);
    NestRound1NS.Outer.LambdaCaller nestLambda = default;
    result &= Test("nest outer static template from nested lambda",
        nestLambda.call(), 4);
    result &= Test("nest outer static template through two nested scopes",
        NestRound1NS.Outer.Middle.DeepCaller.call(), 4);
    result &= Test("nest generic outer static template",
        NestGenericOuter<int>.I.call(), 4);
    result &= Test("nest generic zero-arg sibling static method",
        NestR6ZeroArgStatic<i64>.tm(4), 5);
    NestR6ZeroArgInstance<i64> nestR6ZeroArgInstance = default;
    result &= Test("nest generic instance call to zero-arg sibling static method",
        nestR6ZeroArgInstance.tm(4), 5);
    result &= Test("nest generic zero-arg sibling declared after caller",
        NestR6ZeroArgLate<i64>.tm(4), 5);
    result &= Test("nest generic outer template uses current instantiation",
        NestGenericOuterUsesU<i64>.I.call() + NestGenericOuterUsesU<char>.I.call(), 96);
    result &= Test("nest generic outer template through lambda uses current instantiation",
        NestGenericOuterUsesULambda<i64>.I.call() + NestGenericOuterUsesULambda<char>.I.call(), 96);
    result &= Test("nest2 generic outer nested bare static call",
        Nest2GenericOuter<long>.I.call(), 102);
    result &= Test("nest2 generic outer nested field default",
        Nest2GenericOuter<long>.I.readField(), 104);
    result &= Test("nest2 generic outer static method lambda",
        Nest2GenericOuter<long>.ownerStaticLambda(), 104);
    Nest2GenericOuter<long> nest2GenericOuter = default;
    result &= Test("nest2 generic outer instance method lambda",
        nest2GenericOuter.ownerInstanceLambda(), 105);
    result &= Test("nest2 generic outer nested method lambda",
        Nest2GenericOuter<long>.I.lambdaCall(), 107);
    result &= Test("nest2 generic outer later static dependency",
        Nest2GenericLater<i64>.I.read() + Nest2GenericLater<char>.I.read() - 200, 17);
    result &= Test("nest2 generic outer field default with user constructor",
        Nest2GenericCtor<long>.I.read() + Nest2GenericCtor<long>.I.read() - 200, 8);
    result &= Test("nest2 generic outer zero argument method",
        Nest2ZeroArgOuter<long>.I.call(), 2);
    result &= Test("nest2 generic outer zero argument field default",
        Nest2ZeroArgOuter<long>.I.read(), 2);
    result &= Test("nest2 generic class nested field default",
        Nest2GenericClass<long>.I.readField(), 104);
    // The free helper returns 1; 42 proves both calls use the outer static for i64 and char.
    result &= Test("nest3 generic nested static defaults",
        Nest3GenericStaticDefaults<i64>.I.go() + Nest3GenericStaticDefaults<char>.I.go(), 42);
    // This is a forward call to a later static whose second parameter is omitted.
    result &= Test("nest3 generic owner later static default",
        Nest3GenericStaticDefaults<i64>.ownerCall(), 14);
    // An explicit receiver isolates default-wrapper registration from bare-call lookup.
    result &= Test("nest3 generic instance default with explicit receiver",
        Nest3GenericInstanceDefaults<i64>.go(), 14);
    // The concrete nested type has no scanner pass; its later instance wrapper must be declared.
    result &= Test("nest3 nested instance default in generic outer",
        Nest3GenericNestedInstance<i64>.I.go(), 14);
    // 33 is inner h(3) * 10 + field h(3); the free helper returns 1.
    result &= Test("nest3 generic inner member hides free function in field default",
        Nest3GenericInnerShadow<i64>.I.go(), 33);
    // A second nesting level exercises the same parent-chain predeclaration path.
    result &= Test("nest3 deeply nested member hides free function in field default",
        Nest3GenericDeepInnerShadow<i64>.I.K.go(), 33);
    // 47 combines the outer defaulted static (14) with the inner field shadow case (33).
    result &= Test("nest3 generic class default and inner shadow",
        Nest3GenericClassOuter<i64>.ownerCall() + Nest3GenericClassOuter<i64>.I.go(), 47);
    Nest4InstanceDefault nest4Instance = default;
    result &= Test("nest4 bare instance call keeps explicit argument", nest4Instance.bareCall(), 13);
    result &= Test("nest4 explicit this default call", nest4Instance.explicitThisCall(), 13);
    result &= Test("nest4 explicit object default call", nest4Instance.h(1), 13);
    result &= Test("nest4 bare static default call", Nest4InstanceDefault.staticCall(), 13);
    Nest4GenericInstanceDefault<int> nest4Generic = default;
    result &= Test("nest4 generic bare instance default call",
        nest4Generic.bareCall(), 13);
    Nest4TwoDefaults nest4TwoDefaults = default;
    result &= Test("nest4 bare call with two defaults", nest4TwoDefaults.bareCall(), 16);
    Nest4MemberWins nest4MemberWins = default;
    result &= Test("nest4 member default hides same-name free function", nest4MemberWins.bareCall(), 13);
    Nest4LambdaDefault nest4Lambda = default;
    result &= Test("nest4 lambda captures implicit this for default call", nest4Lambda.lambdaCall(), 13);
    Nest6DefaultImpl nest6Default = default;
    Nest6DefaultInterface nest6Iface = nest6Default;
    result &= Test("nest6 interface default on variable", nest6Iface.h(1), 113);
    result &= Test("nest6 interface default on parameter", nest6InterfaceParam(nest6Default), 113);
    result &= Test("nest6 implementation keeps its own direct default", nest6Default.h(1), 102);
    Nest6GenericDefaultImpl<int> nest6GenericDefault = default;
    Nest6GenericDefaultInterface<int> nest6GenericIface = nest6GenericDefault;
    result &= Test("nest6 generic interface default", nest6GenericIface.h(1), 113);
    Nest6TwoDefaultsImpl nest6TwoDefaults = default;
    Nest6TwoDefaultsInterface nest6TwoIface = nest6TwoDefaults;
    result &= Test("nest6 interface supplies two defaults", nest6TwoIface.h(1), 123);
    Nest6AllDefaultsImpl nest6AllDefaults = default;
    Nest6AllDefaultsInterface nest6AllIface = nest6AllDefaults;
    result &= Test("nest6 interface supplies all defaults", nest6AllIface.h(), 23);
    Nest6DerivedDefaultImpl nest6DerivedDefault = default;
    Nest6DerivedDefaultInterface nest6DerivedIface = nest6DerivedDefault;
    Nest6DerivedDefaultBaseInterface nest6BaseIface = nest6DerivedDefault;
    result &= Test("nest6 derived interface redeclaration supplies its own default",
        nest6DerivedIface.h(1), 177);
    result &= Test("nest6 base interface retains its declared default",
