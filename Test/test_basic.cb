import "test_helper.cb";

// =============================================================
// Union types
// =============================================================

union UnionIntFloat
{
    int i = default;
    float f = default;
};

union UnionByteView
{
    int value = default;
    i8 byte0 = default;
};

struct ContainerWithUnion
{
    UnionIntFloat data = default;
    int tag = default;
};

// Minimal integer range collection for range-based for tests.
struct IntRange
{
    int lo = default;
    int hi = default;

    int count() { return hi - lo; }
    int get(int i) { return lo + i; }
};

struct StructNamedMethod
{
    int StructNamedMethod() { return 7; }
};

int testStructNamedMethod()
{
    StructNamedMethod value;
    return value.StructNamedMethod();
}

bool testBuiltinIdentifiers()
{
    bool result = true;
    result &= Test("__FILE__", __FILE__, "test_basic.cb");
    result &= Test("__FUNCTION__", __FUNCTION__, "testBuiltinIdentifiers");
    result &= Test("__LINE__", __LINE__, 51); // Remember to adjust if shifted.
    return result;
}

// Raw-union lifetime policy: no hidden active-member tag means member destruction is explicit.
int unionDtorCount = 0;
int unionNodeDtors = 0;
int unionManualDtors = 0;
struct UnionDtorOwner { int tag = default; ~UnionDtorOwner() { unionDtorCount++; } };
class UnionDtorNode { int v = default; ~UnionDtorNode() { unionNodeDtors++; } };
struct UnionUniqueBox { unique UnionDtorNode* p = default; };
union UnionOwnerFirst { UnionDtorOwner o = default; int i; };
union UnionOwnerSecond { int i = default; UnionDtorOwner o; };
union UnionRawUnique { UnionUniqueBox b = default; int i; };
union UnionManualDtor { int i = default; ~UnionManualDtor() { unionManualDtors++; } };
union UnionManualUnique
{
    UnionUniqueBox b = default;
    int i;
    ~UnionManualUnique()
    {
        if (b.p != nullptr) delete b.p;
    }
};
struct UnionOwnerHolder { UnionOwnerFirst u = default; int n = default; };

UnionOwnerFirst makeUnionOwner() { UnionOwnerFirst u = default; u.o.tag = 4; return u; }

struct UnionPoint { int x = default; int y = default; };
struct UnionColor { int r = default; int g = default; int b = default; };

union UnionWithStructs
{
    UnionPoint pt = default;
    UnionColor col = default;
};

void writeUnionStructViaPtr(UnionWithStructs* s, int x, int y)
{
    s->pt.x = x;
    s->pt.y = y;
}

int testArray()
{
    int arraySize = 30;
    int[arraySize] array;

    int i = 0;
    while (i < arraySize)
    {
        array[i] = i;
        i++;
    }

    int sum = 0;
    i = 0;
    while (i < arraySize)
    {
        sum += array[i];
        i++;
    }

    return sum;
}

int myFunction(int x, int y, int z)
{
    // printf("x=%d,y=%d,z=%d: ", x, y, z);
    int pair_xy = (x + y) * (x + y + 1) / 2 + y;
    return (pair_xy + z) * (pair_xy + z + 1) / 2 + z;
}

bool testNamedParameters()
{
    bool result = true;
    int expected = myFunction(1, 2, 3);
    result &= Test("InOrder", myFunction(x:1, y : 2, z : 3), expected);
    result &= Test("OutOfOrderName", myFunction(y:2, z : 3, x : 1), expected);
    result &= Test("MixedInOrder", myFunction(x:1, y : 2, 3), expected);
    result &= Test("MixedOutOfOrder", myFunction(z:3, 1, 2), expected);

    return result;
}

// =============================================================
// Enum tests
// =============================================================

// Named enum - enumerators should be registered as globals.
enum MyEnum : u8 { E_ONE = 1, E_TWO, E_THREE = 5 };

bool testEnum()
{
    bool result = true;
    result &= Test("enum_E_ONE", MyEnum.E_ONE, 1);
    result &= Test("enum_E_TWO", MyEnum.E_TWO, 2);
    result &= Test("enum_E_THREE", MyEnum.E_THREE, 5);
    return result;
}

struct MyStruct
{
    int num1 = 1;
    int num2 = 2;
    int num3 = 3;
};

int TotalByValue(MyStruct mystruct)
{
    return mystruct.num1 + mystruct.num2 + mystruct.num2;
}

int TotalByPointer(MyStruct* mystruct)
{
    return mystruct->num1 + mystruct->num2 + mystruct->num2;
}

struct MyStruct1
{
    int num = 1;
    int Read() { return num; }
};

struct MyStruct2
{
    int num = 2;
    int Read() { return num; }
};

// Overloaded Extension function
int ReadExt(MyStruct1 my) { return my.num; }
int ReadExt(MyStruct2 my) { return my.num; }

// Destructor tests

int destructorCallCount = 0;

struct Tracked
{
    int id = 0;
    ~Tracked()
    {
        destructorCallCount = destructorCallCount + 1;
    }
};

bool testDestructor()
{
    bool result = true;
    destructorCallCount = 0;

    {
        Tracked t = Tracked();
    }
    result &= Test("destructor_called_once", destructorCallCount, 1);

    {
        Tracked a = Tracked();
        Tracked b = Tracked();
    }
    result &= Test("destructor_called_twice", destructorCallCount, 3);

    return result;
}


// Default parameter tests

int addWithDefault(int x, int y = 5)
{
    return x + y;
}

bool testDefaultSingleParam()
{
    bool result = true;
    result &= Test("add_both_args", addWithDefault(3, 4), 7);  // 3+4=7
    result &= Test("add_default_y", addWithDefault(3), 8);  // 3+5=8
    return result;
}

int sumWithDefaults(int x, int y = 10, int z = 20)
{
    return x + y + z;
}

bool testDefaultMultipleParams()
{
    bool result = true;
    result &= Test("sum_all_args", sumWithDefaults(1, 2, 3), 6);   // 1+2+3=6
    result &= Test("sum_default_z", sumWithDefaults(1, 2), 23);  // 1+2+20=23
    result &= Test("sum_defaults_yz", sumWithDefaults(1), 31);  // 1+10+20=31
    return result;
}

int multiplyWithDefault(int x, int factor = 2)
{
    return x * factor;
}

bool testDefaultExpression()
{
    bool result = true;
    result &= Test("multiply_explicit", multiplyWithDefault(5, 3), 15);  // 5*3=15
    result &= Test("multiply_default", multiplyWithDefault(5), 10);  // 5*2=10
    return result;
}

// Regression: a method default parameter whose bare name collides with a
// same-named method on an UNRELATED type used to abort the compile with
// "named argument '<Type>__' does not match any parameter". The default-param
// forwarding wrapper leaked the leading `this` (named "<Type>__") as a NAMED
// argument; when that forwarding call was resolved against the sibling type's
// method it hard-errored instead of rejecting the candidate. The wrapper now
// forwards positionally. (Repro: two types both with a method `mix`, one with a
// default param.)
struct DefaultParamOther {
    int mix(int a, int b) { return a + b; }
};
struct DefaultParamSelf {
    int mix(int a, int scale = 10) { return a * scale; }
};

bool testDefaultParamNameCollision()
{
    bool result = true;
    DefaultParamOther o;
    DefaultParamSelf s;
    result &= Test("collide_other_type", o.mix(3, 4), 7);    // 3+4
    result &= Test("collide_explicit",   s.mix(3, 2), 6);    // 3*2
    result &= Test("collide_default",    s.mix(3), 30);      // 3*10
    return result;
}

/*
 * Regression: a constructor whose parameters are ALL defaulted IS the type's no-arg
 * constructor - its cutoff-0 default-param wrapper mangles to the same symbol as the
 * synthesized one. Emitting both made the wrapper re-enter an already-defined function
 * with no scope frame pushed, so its scope-exit popped the CALLER's frame: the compiler
 * died nondeterministically (SIGABRT / SIGSEGV / "declared with no enclosing scope") on
 * the DECLARATION alone, before any construction. The synthetic ctor is now suppressed
 * and the all-defaulted ctor seeds fields itself instead of self-delegating.
 */
class AllDefaultedCtor
{
    int a;
    int b = 7;
    AllDefaultedCtor(int x = 3, int y = 4) { a = x; b = b + y; }
};

struct AllDefaultedStruct
{
    int a;
    AllDefaultedStruct(int x = 5) { a = x; }
};

bool testAllDefaultedConstructor()
{
    bool result = true;
    AllDefaultedCtor d;
    // Field initializer (b = 7) seeds first, then the ctor body runs with the defaults.
    result &= Test("alldef_ctor_bare_a", d.a, 3);
    result &= Test("alldef_ctor_bare_b", d.b, 11);
    AllDefaultedCtor e = AllDefaultedCtor(20);
    result &= Test("alldef_ctor_one_arg_a", e.a, 20);
    result &= Test("alldef_ctor_one_arg_b", e.b, 11);
    AllDefaultedCtor f = AllDefaultedCtor(20, 30);
    result &= Test("alldef_ctor_two_arg_a", f.a, 20);
    result &= Test("alldef_ctor_two_arg_b", f.b, 37);
    AllDefaultedStruct s;
    result &= Test("alldef_struct_bare", s.a, 5);
    AllDefaultedStruct s2 = AllDefaultedStruct(9);
    result &= Test("alldef_struct_arg", s2.a, 9);
    AllDefaultedCtor* h = new AllDefaultedCtor();
    result &= Test("alldef_ctor_new", h->a, 3);
    delete h;
    return result;
}

/*
 * Regression: a user-written no-arg constructor seeds its own fields in line instead of
 * delegating, and that in-line seeding used to honour only brace-list and '= expr' field
 * defaults. A struct-typed field with NO initializer, and a '= default' field, were left
 * zeroed - a SILENT WRONG VALUE against the synthesized default constructor, which
 * default-constructs both. Covers the all-defaulted ctor (the shape widened onto this path)
 * and the bare T() ctor (where the divergence was pre-existing).
 */
struct SeedDeep { int w = 42; };
struct SeedInner { int v = 7; SeedDeep d; };

class SeededAllDefaulted
{
    SeedInner nested;
    SeedInner dn = default;
    int plain = 5;
    SeededAllDefaulted(int x = 3) { plain = plain + x; nested.v = nested.v + 100; }
};

class SeededBareCtor
{
    SeedInner nested;
    SeedInner dn = default;
    int plain = 5;
    SeededBareCtor() { }
};

struct SeedBox<T>
{
    SeedInner nested;
    T val = default;
    SeedBox(int x = 3) { }
};

/*
 * Regression: the in-line seeding branch stored a field default only when Upconvert already
 * landed on the destination's LLVM type, so any default needing a CONVERSION was silently
 * dropped and the field kept the seeding zero. The synthesized default constructor
 * (ParseStructDefinition:342-369) instead CreateCasts a scalar and default-constructs a
 * struct-typed destination. The *NoCtor twins below are the oracle: they take that synthetic
 * path, and every expected value here is what they produce.
 */
struct SeedCastNoCtor
{
    u8 r = 200;      // truncates: i32 200 -> i8, reads back 200 through u8
    i16 s = 40000;   // truncates and wraps: 40000 -> -25536
    int i = 3.7;     // fptosi: 3.7 -> 3
};

struct SeedCastBare
{
    u8 r = 200;
    i16 s = 40000;
    int i = 3.7;
    SeedCastBare() { }
};

struct SeedCastAllDefaulted
{
    u8 r = 200;
    i16 s = 40000;
    int i = 3.7;
    SeedCastAllDefaulted(int x = 3) { }
};

struct SeedZeroInner { int v = 7; };

// `T val = 0` at a struct T: the integer literal never matches the aggregate destination, so
// the mismatch arm has to call T's own default constructor rather than drop the store.
struct SeedZeroNoCtor<T> { T val = 0; int p = 1; };
struct SeedZeroBare<T> { T val = 0; int p = 1; SeedZeroBare() { } };
struct SeedZeroAllDefaulted<T> { T val = 0; int p = 1; SeedZeroAllDefaulted(int x = 3) { } };

/*
 * Regression: ParseClassDefinition's synthesized default ctor gated its type-mismatch handling
 * on `destType->isStructTy()`, so a mismatched SCALAR field default reached CreateInsertValue
 * unconverted and the ctor returned a struct constant whose element types did not match the
 * struct type (`%C = type { i8, i32 }` with `ret %C { i16 200, i32 1 }` - rejected by llvm-as,
 * accepted by verifyModule). The struct twins above are the oracle.
 * Discriminators: only the three float-to-integer cells below change value across the fix
 * (pre-fix i=-1717986918, r8=154, (int)g=-1717986918). The u8/i16 cells are oracle PINS,
 * not discriminators - the malformed constant's low bits happened to be the truncation, so
 * they read the same value on both binaries. What discriminates them is the emitted IR and the
 * narrowing warning, neither of which this suite can observe.
 */
class SeedCastClassNoCtor
{
    u8 r = 200;
    i16 s = 40000;
    int i = 3.7;
    u8 r8 = 3.7;
    i64 g = 3.7;
};

// A parameterized user ctor does NOT suppress the synthetic no-arg ctor - it DELEGATES to it,
// so this shape reaches the same emitter as the ctor-less class above.
class SeedCastClassUserCtor
{
    int i = 3.7;
    u8 r8 = 3.7;
    int p = 1;
    SeedCastClassUserCtor(int q) { p = q; }
};

bool testNoArgCtorFieldSeedingCasts()
{
    bool result = true;
    // Oracle: the synthetic default ctor. These pin the values the ctor cases must match, and
    // go red if that path's conversions ever change.
    SeedCastNoCtor o;
    result &= Test("seedcast_oracle_u8", (int)o.r, 200);
    result &= Test("seedcast_oracle_i16", (int)o.s, -25536);
    result &= Test("seedcast_oracle_fptosi", o.i, 3);

    // Bare no-arg ctor - the pre-existing face. All three read 0 before the fix.
    SeedCastBare b;
    result &= Test("seedcast_bare_u8", (int)b.r, 200);
    result &= Test("seedcast_bare_i16", (int)b.s, -25536);
    result &= Test("seedcast_bare_fptosi", b.i, 3);

    // All-defaulted ctor - the face the all-defaulted-ctor fix routed onto this branch.
    SeedCastAllDefaulted d;
    result &= Test("seedcast_alldef_u8", (int)d.r, 200);
    result &= Test("seedcast_alldef_i16", (int)d.s, -25536);
    result &= Test("seedcast_alldef_fptosi", d.i, 3);

    // Struct-typed destination reached through a generic parameter.
    SeedZeroNoCtor<SeedZeroInner> go;
    result &= Test("seedzero_oracle_v", go.val.v, 7);
    SeedZeroBare<SeedZeroInner> gb;
    result &= Test("seedzero_bare_v", gb.val.v, 7);
    result &= Test("seedzero_bare_p", gb.p, 1);
    SeedZeroAllDefaulted<SeedZeroInner> gd;
    result &= Test("seedzero_alldef_v", gd.val.v, 7);
    result &= Test("seedzero_alldef_p", gd.p, 1);

    // Class twins. Same expected values as SeedCastNoCtor - the class emitter now runs the
    // struct emitter's scalar arm. See the block comment above SeedCastClassNoCtor.
    SeedCastClassNoCtor c;
    result &= Test("seedcast_class_u8", (int)c.r, 200);          // pin, not a discriminator
    result &= Test("seedcast_class_i16", (int)c.s, -25536);      // pin, not a discriminator
    result &= Test("seedcast_class_fptosi", c.i, 3);             // pre-fix: -1717986918
    result &= Test("seedcast_class_fptoui8", (int)c.r8, 3);      // pre-fix: 154
    result &= Test("seedcast_class_fptosi64", (int)c.g, 3);      // pre-fix: -1717986918
    SeedCastClassUserCtor u = SeedCastClassUserCtor(9);
    result &= Test("seedcast_class_userctor_fptosi", u.i, 3);    // pre-fix: -1717986918
    result &= Test("seedcast_class_userctor_fptoui8", (int)u.r8, 3);
    result &= Test("seedcast_class_userctor_p", u.p, 9);
    return result;
}

bool testNoArgCtorFieldSeeding()
{
    bool result = true;
    SeededAllDefaulted a;
    // Seeding runs BEFORE the body, so the body reads 7 and writes 107 (was 100: unseeded).
    result &= Test("seed_alldef_nested_v", a.nested.v, 107);
    result &= Test("seed_alldef_nested_deep_w", a.nested.d.w, 42);
    result &= Test("seed_alldef_default_v", a.dn.v, 7);
    result &= Test("seed_alldef_default_deep_w", a.dn.d.w, 42);
    result &= Test("seed_alldef_plain", a.plain, 8);
    SeededBareCtor b;
    result &= Test("seed_bare_nested_v", b.nested.v, 7);
    result &= Test("seed_bare_nested_deep_w", b.nested.d.w, 42);
    result &= Test("seed_bare_default_v", b.dn.v, 7);
    result &= Test("seed_bare_default_deep_w", b.dn.d.w, 42);
    result &= Test("seed_bare_plain", b.plain, 5);
    SeedBox<int> g;
    result &= Test("seed_generic_nested_v", g.nested.v, 7);
    result &= Test("seed_generic_nested_deep_w", g.nested.d.w, 42);
    return result;
}

/*
 * Regression: a GLOBAL of a struct/class type ignored its fields' own default expressions.
 * The local declarator calls the type's default constructor; the global path left the
 * initializer null and CreateGlobalVariable emitted a plain zeroinitializer, so every field
 * read 0 - a SILENT WRONG VALUE against the identical local spelling. A global now takes the
 * CONSTANT VALUE of that same construction. The three global spellings (no initializer,
 * '= default', '= {}') all went through the same zeroing hole and are all covered.
 * Every leg below pairs the global with its LOCAL twin, which is the oracle.
 */
struct GSeedPlain { int a = 91; int b = 92; };
struct GSeedTrunc { u8 r = 200; i16 s = 300; bool t = 5; };
class GSeedClass { int a = 93; SeedInner nested; };
namespace GSeedNS { struct GSeedNsType { int a = 94; }; }
struct GSeedUserCtor { int a = 95; GSeedUserCtor() { a = 96; } };

GSeedPlain gSeedPlain;
SeedInner gSeedNested;
SeedInner gSeedDefault = default;
SeedInner gSeedBrace = {};
GSeedTrunc gSeedTrunc;
GSeedClass gSeedClass;
GSeedNS.GSeedNsType gSeedNs;
GSeedUserCtor gSeedUserCtor;

// Global default-fold budget and source-order legs. Each global is paired with a local oracle.
struct GSeedFoldD0 { int v = 100; };
struct GSeedFoldD1 { GSeedFoldD0 inner; int w = 1; };
struct GSeedFoldD2 { GSeedFoldD1 inner; int w = 2; };
struct GSeedFoldD3 { GSeedFoldD2 inner; int w = 3; };
struct GSeedFoldD4 { GSeedFoldD3 inner; int w = 4; };
struct GSeedFoldD5 { GSeedFoldD4 inner; int w = 5; };
struct GSeedFoldD6 { GSeedFoldD5 inner; int w = 6; };
struct GSeedFoldLeaf { int v = 9; };
struct GSeedFoldWide
{
    GSeedFoldLeaf f0; GSeedFoldLeaf f1; GSeedFoldLeaf f2; GSeedFoldLeaf f3;
    GSeedFoldLeaf f4; GSeedFoldLeaf f5; GSeedFoldLeaf f6; GSeedFoldLeaf f7;
    GSeedFoldLeaf f8; GSeedFoldLeaf f9; GSeedFoldLeaf f10; GSeedFoldLeaf f11;
    GSeedFoldLeaf f12; GSeedFoldLeaf f13; int t = 5;
};
struct GSeedFoldOrder<T> { T item = default; int tag = 55; };

GSeedFoldD6 gSeedFoldDeep;
GSeedFoldWide gSeedFoldWide;
GSeedFoldForward gSeedFoldForward;
GSeedFoldOrder<int> gSeedFoldOrder;
struct GSeedFoldForward { int a = 17; };
int gSeedFoldWarm() { GSeedFoldOrder<int> warm; return warm.tag; }

bool testGlobalFoldOrderBudget()
{
    bool result = true;
    GSeedFoldD6 localDeep;
    result &= Test("gseed_fold_deep_global", gSeedFoldDeep.w, localDeep.w);
    result &= Test("gseed_fold_deep_leaf", gSeedFoldDeep.inner.inner.inner.inner.inner.inner.v, 100);
    GSeedFoldWide localWide;
    result &= Test("gseed_fold_wide_global", gSeedFoldWide.f13.v, localWide.f13.v);
    result &= Test("gseed_fold_wide_tail", gSeedFoldWide.t, localWide.t);
    GSeedFoldForward localForward;
    result &= Test("gseed_fold_forward_global", gSeedFoldForward.a, localForward.a);
    GSeedFoldOrder<int> localOrder;
    result &= Test("gseed_fold_order_global", gSeedFoldOrder.tag, localOrder.tag);
    return result;
}

bool testGlobalDefaultSeeding()
{
    bool result = true;
    // Scalar field defaults. Pre-fix: every global leg read 0, every local leg was correct.
    GSeedPlain lPlain;
    result &= Test("gseed_plain_local_a", lPlain.a, 91);
    result &= Test("gseed_plain_local_b", lPlain.b, 92);
    result &= Test("gseed_plain_global_a", gSeedPlain.a, 91);
    result &= Test("gseed_plain_global_b", gSeedPlain.b, 92);

    // A struct-typed field with no initializer, two levels deep - the nested default ctor
    // has to be folded through as well, not just the leaf constants.
    SeedInner lNested;
    result &= Test("gseed_nested_local_v", lNested.v, 7);
    result &= Test("gseed_nested_local_deep_w", lNested.d.w, 42);
    result &= Test("gseed_nested_global_v", gSeedNested.v, 7);
    result &= Test("gseed_nested_global_deep_w", gSeedNested.d.w, 42);

    // The other two global spellings of the same construction.
    result &= Test("gseed_default_global_v", gSeedDefault.v, 7);
    result &= Test("gseed_default_global_deep_w", gSeedDefault.d.w, 42);
    result &= Test("gseed_brace_global_v", gSeedBrace.v, 7);
    result &= Test("gseed_brace_global_deep_w", gSeedBrace.d.w, 42);

    // Defaults needing a CONVERSION - the value has to come through the ctor's cast arm.
    GSeedTrunc lTrunc;
    result &= Test("gseed_trunc_local_u8", (int)lTrunc.r, 200);
    result &= Test("gseed_trunc_global_u8", (int)gSeedTrunc.r, 200);
    result &= Test("gseed_trunc_local_i16", (int)lTrunc.s, 300);
    result &= Test("gseed_trunc_global_i16", (int)gSeedTrunc.s, 300);
    result &= Test("gseed_trunc_local_bool", lTrunc.t ? 1 : 0, 1);
    result &= Test("gseed_trunc_global_bool", gSeedTrunc.t ? 1 : 0, 1);

    // class, and a namespaced type.
    GSeedClass lClass;
    result &= Test("gseed_class_local_a", lClass.a, 93);
    result &= Test("gseed_class_local_nested_v", lClass.nested.v, 7);
    result &= Test("gseed_class_global_a", gSeedClass.a, 93);
    result &= Test("gseed_class_global_nested_v", gSeedClass.nested.v, 7);
    GSeedNS.GSeedNsType lNs;
    result &= Test("gseed_ns_local_a", lNs.a, 94);
    result &= Test("gseed_ns_global_a", gSeedNs.a, 94);

    /*
     * Policy pin, not a discriminator: a user-written constructor BODY runs statements, and a
     * global initializer has to be a compile-time constant, so that construction does not fold
     * and the global stays zeroed (with a located note saying so). The local twin below is the
     * value the global deliberately does NOT get.
     */
    GSeedUserCtor lUser;
    result &= Test("gseed_userctor_local_a", lUser.a, 96);
    result &= Test("gseed_userctor_global_a", gSeedUserCtor.a, 0);
    return result;
}

extern int strcmp(const char* a, const char* b);

bool Test(const char* testName, const char* actual, const char* expected)
{
    if (strcmp(actual, expected) == 0)
    {
        printf("%s passed.\n", testName);
        return true;
    }
    printf("%s failed: expected '%s' but got '%s'.\n", testName, expected, actual);
    return false;
}

struct NamedThing
{
    int value = 42;
};


struct TypedThing
{
    int count = 0;
    bool flag = false;
};

bool testTypeof()
{
    bool result = true;
    int i = 0;
    bool b = false;
    TypedThing t = TypedThing();

    result &= Test("typeof_int", typeof(i), "int");
    result &= Test("typeof_bool", typeof(b), "bool");
    result &= Test("typeof_struct", typeof(t), "TypedThing");
    result &= Test("typeof_field_int", typeof(t.count), "int");
    result &= Test("typeof_field_bool", typeof(t.flag), "bool");
    result &= Test("typeof_type_int", typeof(int), "int");
    result &= Test("typeof_type_name", typeof(TypedThing), "TypedThing");
    return result;
}

bool testNameof()
{
    bool result = true;
    int myVar = 0;
    NamedThing thing = NamedThing();

    result &= Test("nameof_var", nameof(myVar), "myVar");
    result &= Test("nameof_struct", nameof(thing), "thing");
    result &= Test("nameof_field", nameof(thing.value), "value");
    result &= Test("nameof_type", nameof(NamedThing), "NamedThing");
    return result;
}

// Namespace tests

int add(int a, int b) { return a + b + 100; }  // global add returns a different value

namespace MathUtils
{
    // Namespace globals register under their qualified name (MathUtils.nsCounter),
    // like namespace functions: qualified access works from outside, bare sibling
    // access works from inside, and the bare name does NOT leak outside.
    int nsCounter = 7;
    const int BASE = 120;

    int readCounter() { return nsCounter; }
    void bumpCounter() { nsCounter++; }

    int add(int a, int b) { return a + b; }
    int multiply(int a, int b) { return a * b; }

    // Unqualified sibling call: `add` must resolve to MathUtils.add (NOT the global
    // `add` that returns a+b+100), so addThenDouble(3,4) == (3+4)*2 == 14.
    int addThenDouble(int a, int b) { return multiply(add(a, b), 2); }

    // `global::add` escapes the namespace and reaches the GLOBAL add (a+b+100),
    // even though the sibling MathUtils.add (a+b) would shadow a bare `add`.
    int addViaGlobal(int a, int b) { return global::add(a, b); }

    // Bare `add` still resolves to the sibling MathUtils.add (a+b).
    int addViaSibling(int a, int b) { return add(a, b); }

    namespace Advanced
    {
        int square(int x) { return x * x; }
        int cube(int x) { return x * x * x; }

        // Unqualified sibling call inside a nested namespace resolves to
        // Advanced.square; sumOfSquares(3,4) == 9 + 16 == 25.
        int sumOfSquares(int a, int b) { return square(a) + square(b); }

        // `global::` with a dotted path resolves at the root: global::MathUtils.add
        // is the sibling-free root MathUtils.add (a+b), reached from this nested scope.
        int addViaGlobalDotted(int a, int b) { return global::MathUtils.add(a, b); }

        // A bare global reference inside a nested namespace walks outward through
        // parent namespaces: BASE resolves to MathUtils.BASE.
        int readOuterBase() { return BASE; }
    }
}

// Dotted namespace declaration: `namespace a.b { }` declares the nested chain in
// one line. An extern inside a namespace registers under the qualified lookup
// name (sysapi.libc.toupper) but keeps its bare linkage symbol, so it binds to
// the same imported C function. A namespace function signature may reference a
// sibling struct unqualified. Bind a ubiquitous libc/CRT function here, not a
// Win32 one, so this file stays portable.
namespace sysapi.libc
{
    extern int toupper(int c);

    struct Box2 {
        int w = default;
        int h = default;
    };

    int area(Box2* b) { return b->w * b->h; }
}

using Math = MathUtils;          // global alias for top-level namespace
using MathAdv = MathUtils.Advanced;  // global alias for nested namespace

bool testNamespace()
{
    bool result = true;
    result &= Test("namespace_add", MathUtils.add(3, 4), 7);            // 3+4=7
    result &= Test("namespace_multiply", MathUtils.multiply(3, 4), 12); // 3*4=12
    result &= Test("global_add", add(3, 4), 107);                       // 3+4+100=107
    result &= Test("no_collision", MathUtils.add(3, 4) != add(3, 4), 1);
    result &= Test("global_using_add", Math.add(3, 4), 7);              // global alias resolves to MathUtils.add
    result &= Test("global_using_multiply", Math.multiply(3, 4), 12);   // global alias resolves to MathUtils.multiply
    // Unqualified sibling call inside the namespace must resolve to the namespace
    // member (more-local wins over the global `add`): (3+4)*2 = 14, not (3+4+100)*2.
    result &= Test("sibling_call", MathUtils.addThenDouble(3, 4), 14);
    result &= Test("nested_sibling_call", MathUtils.Advanced.sumOfSquares(3, 4), 25); // 9+16=25
    // global:: escapes the sibling shadow: addViaGlobal reaches the global add (a+b+100),
    // while addViaSibling still resolves to the namespace member (a+b).
    result &= Test("global_scope_escape", MathUtils.addViaGlobal(3, 4), 107);          // 3+4+100
    result &= Test("global_scope_sibling_still_local", MathUtils.addViaSibling(3, 4), 7); // 3+4
    // global:: with a dotted path resolves at the root namespace.
    result &= Test("global_scope_dotted", MathUtils.Advanced.addViaGlobalDotted(3, 4), 7); // 3+4
    // Namespace globals: qualified read/write from outside, bare sibling access inside.
    result &= Test("namespace_global_const", MathUtils.BASE, 120);
    result &= Test("namespace_global_read", MathUtils.nsCounter, 7);
    result &= Test("namespace_global_sibling_read", MathUtils.readCounter(), 7);
    MathUtils.bumpCounter();                       // bare sibling write inside
    result &= Test("namespace_global_sibling_write", MathUtils.nsCounter, 8);
    MathUtils.nsCounter = 42;                      // qualified write from outside
    result &= Test("namespace_global_qualified_write", MathUtils.readCounter(), 42);
    result &= Test("namespace_global_alias", Math.BASE, 120);  // via `using Math = MathUtils`
    result &= Test("namespace_global_outer_from_nested", MathUtils.Advanced.readOuterBase(), 120);
    // Dotted namespace declaration + extern with bare linkage inside a namespace.
    result &= Test("dotted_ns_extern", sysapi.libc.toupper('a'), 'A');
    sysapi.libc.Box2 bx;
    bx.w = 3; bx.h = 5;
    result &= Test("dotted_ns_struct_sibling_sig", sysapi.libc.area(&bx), 15);
    return result;
}

bool testLocalUsing()
{
    using M = MathUtils;  // local alias, only visible in this function
    bool result = true;
    result &= Test("local_using_add", M.add(2, 3), 5);
    result &= Test("local_using_multiply", M.multiply(2, 3), 6);
    return result;
}

bool testNestedNamespace()
{
    bool result = true;
    result &= Test("nested_square", MathUtils.Advanced.square(4), 16);    // 4*4=16
    result &= Test("nested_cube", MathUtils.Advanced.cube(3), 27);        // 3*3*3=27

    using Adv = MathUtils.Advanced;  // local alias for nested namespace
    result &= Test("nested_using_square", Adv.square(5), 25);             // 5*5=25
    result &= Test("nested_using_cube", Adv.cube(2), 8);                  // 2*2*2=8
    return result;
}

bool testNestedUsing()
{
    bool result = true;

    // Global alias for nested namespace
    result &= Test("global_nested_using_square", MathAdv.square(4), 16);  // 4*4=16
    result &= Test("global_nested_using_cube", MathAdv.cube(3), 27);      // 3*3*3=27

    // Local alias for nested namespace shadows nothing; verify it works
    using Adv2 = MathUtils.Advanced;
    result &= Test("local_nested_using_square", Adv2.square(6), 36);      // 6*6=36
    result &= Test("local_nested_using_cube", Adv2.cube(4), 64);          // 4*4*4=64
    return result;
}

bool testLocalUsingScoped()
{
    // 'M' from testLocalUsing is not visible here; only 'Math' global alias is.
    bool result = true;
    result &= Test("local_alias_not_leaked", Math.add(1, 2), 3);
    return result;
}

// =============================================================
// Forward reference tests
// =============================================================

// Test 1: bar() calls foo() which is defined after bar().
int bar()
{
    return foo();
}

int foo()
{
    return 42;
}

bool testForwardFunction()
{
    bool result = true;
    result &= Test("bar calls foo (fwd ref)", bar(), 42);
    return result;
}

// Test 2: Mutual recursion - no explicit forward declaration needed.
bool isEven(int n)
{
    if (n == 0) return true;
    return isOdd(n - 1);
}

bool isOdd(int n)
{
    if (n == 0) return false;
    return isEven(n - 1);
}

bool testMutualRecursion()
{
    bool result = true;
    result &= Test("isEven(0)", isEven(0), 1);
    result &= Test("isEven(4)", isEven(4), 1);
    result &= Test("isOdd(1)",  isOdd(1),  1);
    result &= Test("isOdd(5)",  isOdd(5),  1);
    result &= Test("isEven(3) is false", isEven(3), 0);
    result &= Test("isOdd(4) is false",  isOdd(4),  0);
    return result;
}

// Test 3: runAccumulator() calls getTotal() which is defined after the struct.
int runAccumulator()
{
    return getTotal();
}

struct Accumulator
{
    int x = 10;
    int y = 20;
    int z = 30;

    int Total()
    {
        return x + y + z;
    }
};

int getTotal()
{
    Accumulator a = Accumulator();
    return a.Total();
}

bool testForwardFunctionWithStruct()
{
    bool result = true;
    result &= Test("runAccumulator (fwd ref to getTotal)", runAccumulator(), 60);
    return result;
}

// Test 4: Member function calls a member function defined later in the struct.
struct Calculator
{
    int value = 10;

    int ComputeDouble()
    {
        return doubleIt();
    }

    int ComputeSum()
    {
        return addThree(5, 3);
    }

    int doubleIt()
    {
        return value * 2;
    }

    int addThree(int b, int c)
    {
        return value + b + c;
    }
};

bool testForwardInStruct()
{
    bool result = true;
    Calculator c = Calculator();
    result &= Test("member calls fwd func (doubleIt)", c.ComputeDouble(), 20);
    result &= Test("member calls fwd func (addThree)", c.ComputeSum(), 18);
    return result;
}

// Return block: the function body is inlined at every call site.
// 'return' inside the block returns from the caller.
inline int doubleValue(int x)
{
    return { return x * 2; };
}

inline int addValues(int a, int b)
{
    return { return a + b; };
}

// Wrappers: the return-block is inlined here; its 'return' returns from these functions.
int getDoubled(int x)
{
    doubleValue(x);
}

int getSum(int a, int b)
{
    addValues(a, b);
}

bool testReturnBlock()
{
    bool result = true;
    result &= Test("returnBlock doubleValue(5)", getDoubled(5), 10);
    result &= Test("returnBlock addValues(3,4)", getSum(3, 4), 7);
    return result;
}

// Assert uses a return block: if the assertion fails, it returns false from the caller.
inline bool Assert(const char* testName, int actual, int expected)
{
    return {
        if (actual != expected)
        {
            printf("%s negative: expected '%d' but got '%d'.\n", testName, expected, actual);
            return false;
        }
    };
}

// When the failing Assert is hit, it exits this function early with false.
// The 'return true' at the end is only reached if all asserts pass.
bool testAssertPass()
{
    Assert("assert 42==42", 42, 42);
    Assert("assert 7==7", 7, 7);
    return true;
}

bool testAssertFail()
{
    Assert("assert 10==10", 10, 10);
    Assert("assert 10==99", 10, 99);  // fails - exits testAssertFail with false
    return true;
}

bool testAssertReturnBlock()
{
    bool result = true;
    result &= Test("assert_all_pass", testAssertPass(), true);
    result &= Test("assert_early_exit", testAssertFail(), false);
    return result;
}

// =============================================================
// Explicit-width integer type tests
// C equivalents: i8=int8_t, i16=int16_t, i32=int32_t, i64=int64_t
//                u8=uint8_t, u16=uint16_t, u32=uint32_t, u64=uint64_t
// =============================================================

int sumI32(i32 a, i32 b) { return a + b; }
int sumU32(u32 a, u32 b) { return a + b; }

// Regression: a negative integer literal in a file-scope initializer used to be
// sign-dropped (narrowed to the smallest unsigned width, e.g. -150 read back as
// 65386). CreateGlobalVariable now sign-extends when widening the narrowed
// constant back to the global's declared width.
const int GlobalNegConstSmall = -3;
const int GlobalNegConstI8    = -101;
const int GlobalNegConstI16   = -150;
const int GlobalNegConstI32   = -70000;
int GlobalNegPlainSmall = -3;
int GlobalNegPlainI8    = -101;
int GlobalNegPlainI16   = -150;
int GlobalNegPlainI32   = -70000;

bool testNegativeGlobalInit()
{
    bool result = true;
    result &= Test("const_global_neg_small", GlobalNegConstSmall, -3);
    result &= Test("const_global_neg_i8",     GlobalNegConstI8,    -101);
    result &= Test("const_global_neg_i16",    GlobalNegConstI16,   -150);
    result &= Test("const_global_neg_i32",    GlobalNegConstI32,   -70000);
    result &= Test("plain_global_neg_small",  GlobalNegPlainSmall, -3);
    result &= Test("plain_global_neg_i8",     GlobalNegPlainI8,    -101);
    result &= Test("plain_global_neg_i16",    GlobalNegPlainI16,   -150);
    result &= Test("plain_global_neg_i32",    GlobalNegPlainI32,   -70000);

    // Local initializer with the same magnitudes must keep working (was never broken).
    int localNeg = -150;
    result &= Test("local_neg_i16", localNeg, -150);

    return result;
}

bool testExplicitIntTypes()
{
    bool result = true;

    // Signed types: declaration and basic value
    i8  s8  = 100;
    i16 s16 = 1000;
    i32 s32 = 100000;
    i64 s64 = 200000;

    result &= Test("i8_value",  s8,  100);
    result &= Test("i16_value", s16, 1000);
    result &= Test("i32_value", s32, 100000);
    result &= Test("i64_value", s64, 200000);

    // Unsigned types: declaration and basic value
    u8  u8v  = 200;
    u16 u16v = 2000;
    u32 u32v = 300000;
    u64 u64v = 400000;

    result &= Test("u8_value",  u8v,  200);
    result &= Test("u16_value", u16v, 2000);
    result &= Test("u32_value", u32v, 300000);
    result &= Test("u64_value", u64v, 400000);

    // Arithmetic - values chosen to stay within each type's range
    i8  s8a  = 50;   // 50+50=100, within i8  (-128..127)
    u8  u8a  = 100;  // 100+100=200, within u8 (0..255)
    result &= Test("i8_add",  s8a  + s8a,   100);  // 50+50=100
    result &= Test("i16_add", s16  + s16,   2000); // 1000+1000=2000, within i16
    result &= Test("i32_add", s32  + s32,   200000); // 100000+100000=200000
    result &= Test("u8_add",  u8a  + u8a,   200);  // 100+100=200
    result &= Test("u16_add", u16v + u16v,  4000); // 2000+2000=4000, within u16

    // C-equivalent compatibility: int <-> i32 are the same type
    int ci = s32;
    result &= Test("i32_to_int", ci, 100000);

    i32 ia = ci;
    result &= Test("int_to_i32", ia, 100000);

    // Passing i32/u32 to functions expecting i32/u32
    result &= Test("func_i32", sumI32(40, 2), 42);
    result &= Test("func_u32", sumU32(40, 2), 42);

    // Passing int to function expecting i32 (compatible types)
    int x = 10;
    result &= Test("int_to_i32_param", sumI32(x, 5), 15);

    // Hex literals with high bit set (contain hex digit 'E' - must not be parsed as float)
    // C++ rule: hex literals that exceed i32 positive range type as unsigned int (same 32-bit pattern).
    u32 magic = 0xBA63E001;             // contains 'E' - previously mistaken as float exponent
    u32 magic2 = (u32)0xBA63E001;
    result &= Test("hex_high_bit_direct", magic,  (u32)0xBA63E001);
    result &= Test("hex_high_bit_cast",   magic2, (u32)0xBA63E001);
    result &= Test("hex_with_E_digit",    (u32)0xDEADBEEF, (u32)0xDEADBEEF);
    result &= Test("hex_all_ones",        (u32)0xFFFFFFFF, (u32)0xFFFFFFFF);
    result &= Test("hex_int_min",         (u32)0x80000000, (u32)0x80000000);

    return result;
}

// =============================================================
// Null-conditional (?.) and null-coalescing (??) tests
// =============================================================

struct NullableNode
{
    int value = 99;
    int Read() { return value; }
};

// Helper: returns the node's value if non-null, -1 otherwise
int readNodeValueNC(NullableNode* node)
{
    return node?.value ?? -1;
}

// Helper: calls Read() if non-null, returns -1 otherwise
int callNodeRead(NullableNode* node)
{
    return node?.Read() ?? -1;
}

bool testNullConditional()
{
    bool result = true;

    NullableNode n = NullableNode();
    NullableNode* p = &n;
    NullableNode* np = nullptr;

    // null-conditional field access + coalescing via helper
    result &= Test("nc_coalesce_nonnull", readNodeValueNC(p),  99);
    result &= Test("nc_coalesce_null",    readNodeValueNC(np), -1);

    // null-conditional method call via helper
    result &= Test("nc_method_nonnull",   callNodeRead(p),  99);
    result &= Test("nc_method_null",      callNodeRead(np), -1);

    // null-conditional method call directly on a local pointer (no helper)
    result &= Test("nc_direct_nonnull", p?.Read()  ?? -1, 99);
    result &= Test("nc_direct_null",    np?.Read() ?? -1, -1);

    // null-conditional field access directly on a local pointer (no helper)
    result &= Test("nc_direct_field_nonnull", p?.value  ?? -1, 99);
    result &= Test("nc_direct_field_null",    np?.value ?? -1, -1);

    return result;
}

const char* tryGetName(bool found)
{
    if (found) return "Alice";
    return nullptr;
}

bool testNullCoalescing()
{
    bool result = true;

    // pointer coalescing: null -> fallback string
    const char* name1 = tryGetName(true)  ?? "Unknown";
    const char* name2 = tryGetName(false) ?? "Unknown";
    result &= Test("nullcoal_nonnull_ptr", name1, "Alice");
    result &= Test("nullcoal_null_ptr",    name2, "Unknown");

    // integer coalescing: 0 -> default, nonzero -> self
    int zero = 0;
    int five = 5;
    result &= Test("nullcoal_zero",    zero ?? 42, 42);
    result &= Test("nullcoal_nonzero", five ?? 42, 5);

    return result;
}

// =============================================================
// Null-coalescing assignment (??=) tests
// =============================================================

int nullCoalSideEffects = 0;
int nullCoalBump() { nullCoalSideEffects = nullCoalSideEffects + 1; return 7; }

bool testNullCoalescingAssignment()
{
    bool result = true;

    // zero int: should be assigned the rhs value
    int x = 0;
    x ??= 42;
    result &= Test("nullcoalasgn_zero_becomes_rhs", x, 42);

    // nonzero int: should keep its original value
    int y = 7;
    y ??= 99;
    result &= Test("nullcoalasgn_nonzero_unchanged", y, 7);

    // repeated application: once set, a second ??= should not overwrite
    int z = 0;
    z ??= 10;
    z ??= 20;
    result &= Test("nullcoalasgn_already_set", z, 10);

    // Accept-set guard for the store-tail routing: '??=' short-circuits, so the RHS must not be
    // evaluated at all when the LHS is already set. Identical on both binaries by design - this
    // is the property a fall-through restructure could silently drop.
    nullCoalSideEffects = 0;
    int keep = 4;
    keep ??= nullCoalBump();
    result &= Test("nullcoalasgn_rhs_not_evaluated", nullCoalSideEffects, 0);
    int take = 0;
    take ??= nullCoalBump();
    result &= Test("nullcoalasgn_rhs_evaluated_once", nullCoalSideEffects, 1);
    result &= Test("nullcoalasgn_rhs_value", take, 7);

    // null pointer: should be assigned the rhs
    const char* p = nullptr;
    p ??= "hello";
    result &= Test("nullcoalasgn_null_ptr", p, "hello");

    // non-null pointer: should keep its original value
    const char* q = "world";
    q ??= "other";
    result &= Test("nullcoalasgn_nonnull_ptr", q, "world");

    // null struct pointer: should be assigned the rhs
    NullableNode* node = nullptr;
    node ??= new NullableNode();
    result &= Test("nullcoalasgn_null_struct_ptr", node?.Read() ?? -1, 99);
    delete node;

    // non-null struct pointer: should keep its original value and not be replaced
    NullableNode* nonNullNode = new NullableNode();
    NullableNode* replacementNode = new NullableNode();
    NullableNode* before = nonNullNode;
    nonNullNode ??= replacementNode;
    result &= Test("nullcoalasgn_nonnull_struct_ptr", nonNullNode == before, true);
    delete nonNullNode;
    delete replacementNode;

    return result;
}

// =============================================================
// Default keyword tests
// =============================================================

// Regression (nested-struct-field-default): a struct field declared `= default`
// must run the nested struct type's own field initializers, not zero-fill. Uses
// non-zero defaults so a zero-fill bug is distinguishable from correct behaviour.
struct DefInner { int a = -1; int b = -2; };
struct DefOuter { int x = -3; DefInner inner = default; };
struct DefDeep  { int m = -7; DefOuter outer = default; };

bool testDefault()
{
    bool result = true;

    // Primitive types: default -> zero value
    int  di = default;
    bool db = default;
    i32  di32 = default;
    i64  di64 = default;

    result &= Test("default_int",  di,   0);
    result &= Test("default_bool", db,   0);
    result &= Test("default_i32",  di32, 0);
    result &= Test("default_i64",  di64, 0);

    // Struct type: default -> calls default constructor, fields get their declared defaults
    MyStruct ds = default;
    result &= Test("default_struct_num1", ds.num1, 1);
    result &= Test("default_struct_num2", ds.num2, 2);
    result &= Test("default_struct_num3", ds.num3, 3);

    // Nested struct field `= default` must recurse into the field's own default
    // ctor (running its initializers), not zero-fill the aggregate.
    DefOuter dno = default;
    result &= Test("default_nested_field_x", dno.x,       -3);
    result &= Test("default_nested_field_a", dno.inner.a, -1);
    result &= Test("default_nested_field_b", dno.inner.b, -2);

    // Deeper nesting and the heap `new T` path share the same default-ctor path.
    DefDeep ddeep = default;
    result &= Test("default_deep_field_m", ddeep.m,             -7);
    result &= Test("default_deep_field_x", ddeep.outer.x,       -3);
    result &= Test("default_deep_field_a", ddeep.outer.inner.a, -1);
    DefOuter* dheap = new DefOuter;
    result &= Test("default_heap_field_b", dheap->inner.b, -2);
    delete dheap;

    return result;
}

// =============================================================
// return default; tests
// =============================================================

struct RdPoint
{
    int x = 10;
    int y = 20;
};

class RdNode
{
    int val = 99;
};

int rdInt()       { return default; }
float rdFloat()   { return default; }
bool rdBool()     { return default; }
i64 rdI64()       { return default; }
int* rdIntPtr()   { return default; }
RdNode* rdClassPtr() { return default; }
RdPoint rdStruct() { return default; }
string rdString() { return default; }

int rdCondInt(bool flag)
{
    if (flag)
        return 99;
    return default;
}

RdPoint rdCondStruct(bool flag)
{
    if (flag)
    {
        RdPoint p;
        p.x = 7;
        p.y = 8;
        return p;
    }
    return default;
}

bool testReturnDefaultPrimitives()
{
    bool result = true;
    result &= Test("rd_int",   rdInt(),   0);
    result &= Test("rd_float", rdFloat(), 0.0f);
    result &= Test("rd_bool",  rdBool(),  false);
    result &= Test("rd_i64",   rdI64(),   0);
    return result;
}

bool testReturnDefaultPointers()
{
    bool result = true;
    result &= Test("rd_int_ptr",   rdIntPtr()   == nullptr ? 1 : 0, 1);
    result &= Test("rd_class_ptr", rdClassPtr() == nullptr ? 1 : 0, 1);
    return result;
}

bool testReturnDefaultStruct()
{
    bool result = true;
    RdPoint pt = rdStruct();
    // return default; is the same VALUE as `RdPoint p = default;` - the declared field
    // initializers run (10, 20). It used to zero-fill the return type instead.
    result &= Test("rd_struct_x", pt.x, 10);
    result &= Test("rd_struct_y", pt.y, 20);
    return result;
}

bool testReturnDefaultString()
{
    bool result = true;
    string s = rdString();
    result &= Test("rd_string_len", s.length(), 0);
    return result;
}

bool testReturnDefaultConditional()
{
    bool result = true;
    result &= Test("rd_cond_taken",   rdCondInt(true),  99);
    result &= Test("rd_cond_default", rdCondInt(false), 0);

    RdPoint p1 = rdCondStruct(true);
    result &= Test("rd_cond_struct_x", p1.x, 7);
    result &= Test("rd_cond_struct_y", p1.y, 8);

    RdPoint p2 = rdCondStruct(false);
    result &= Test("rd_cond_struct_zero_x", p2.x, 10);
    result &= Test("rd_cond_struct_zero_y", p2.y, 20);
    return result;
}

// =============================================================
// string type tests
// string is a built-in value type: { i8* _ptr, i32 _len }
// with data() -> i8* and length() -> i32 member functions.
// =============================================================

// operator string(char*) and operator string(i32) are now provided by core/string.cb.

bool testStringType()
{
    bool result = true;

    string s = "hello";

    result &= Test("string_length", s.length(), 5);
    result &= Test("string_data", s.data(), "hello");

    string s2 = "world!!";
    result &= Test("string2_length", s2.length(), 7);
    result &= Test("string2_data", s2.data(), "world!!");

    return result;
}

// Regression: a chained access `structValue.field.method()` where `field` is a primitive
// must bind the FIELD VALUE as the method receiver, not the parent struct. Covers a struct
// local base and a `this` base inside a member method.
struct ChainPoint
{
    int x = 0;
    int y = 0;
    string xStr() { return this.x.toString(); }
};

bool testChainedFieldUFCS()
{
    bool result = true;

    ChainPoint p = default;
    p.x = 5;
    p.y = 42;

    // Local struct base: p.x.toString() must operate on x (int), not p (ChainPoint).
    string sx = p.x.toString();
    result &= Test("chain_field_local_x", sx.data(), "5");
    string sy = p.y.toString();
    result &= Test("chain_field_local_y", sy.data(), "42");

    // `this` base inside a method: this.x.toString().
    string sthis = p.xStr();
    result &= Test("chain_field_this", sthis.data(), "5");

    return result;
}

// Tests the built-in string literal syntax: string s = "...";
// A string literal is automatically wrapped in a string struct { _ptr, _len }.
bool testStringLiteral()
{
    bool result = true;

    // Basic assignment from a string literal
    string s = "hello";
    result &= Test("str_lit_length",      s.length(), 5);
    result &= Test("str_lit_data",     s.data(),  "hello");

    // Longer literal - the canonical use case: string s = "My test string";
    string s2 = "My test string";
    result &= Test("str_lit_long_length", s2.length(), 14);
    result &= Test("str_lit_long_data", s2.data(), "My test string");

    // Empty string literal
    string s3 = "";
    result &= Test("str_lit_empty_length", s3.length(), 0);
    result &= Test("str_lit_empty_data", s3.data(), "");

    // String with escape sequences - \n counts as one character
    string s4 = "line1\nline2";
    result &= Test("str_lit_escape_length", s4.length(), 11);

    // Multiple string variables can coexist with independent values
    string sa = "alpha";
    string sb = "beta!";
    result &= Test("str_lit_multi_a_length",  sa.length(), 5);
    result &= Test("str_lit_multi_b_length",  sb.length(), 5);
    result &= Test("str_lit_multi_a_data", sa.data(), "alpha");
    result &= Test("str_lit_multi_b_data", sb.data(), "beta!");

    // X6: a ternary whose branches are a `string` value and a char* literal must
    // coerce the literal to `string` (instead of asserting in LLVM's select on
    // mismatched operands). Verify both branch orders and the selected value.
    string base = "abc";
    string t1 = base.length() == 0 ? "lit" : base;       // selects the string branch
    result &= Test("ternary_str_pick_value",   t1.data(), "abc");
    string t2 = base.length() == 3 ? "lit" : base;       // selects the char* literal
    result &= Test("ternary_str_pick_literal", t2.data(), "lit");
    string t3 = base.length() == 0 ? base : "fallback";  // reversed: string then char*
    result &= Test("ternary_str_reversed",     t3.data(), "fallback");

    return result;
}

class Node
{
    int value = 0;
};

int testNewDelete()
{
    Node* n = new Node();
    delete n;
    return 42;
}

int testNewArray()
{
    int* arr = new int[5];
    for (int i = 0; i < 5; i++)
    {
        arr[i] = i;
	}

    for (int i = 0; i < 5; i++)
    {
        if (arr[i] != i)
        {
            printf("testNewArray failed: arr[%d] expected %d but got %d.\n", i, i, arr[i]);
            delete[] arr;
            return 1;
        }
	}

    delete[] arr;
    return 99;
}

class Counter
{
    int count = 0;
};

int testNewWithConstructor()
{
    Counter* c = new Counter();
    delete c;
    return 123;
}

bool testNewArrayConstructor()
{
    bool result = true;

    // new T[n] must call the default constructor for each element
    MyStruct* arr = new MyStruct[3];
    result &= Test("new_arr_ctor_0_num1", arr[0].num1, 1);
    result &= Test("new_arr_ctor_0_num2", arr[0].num2, 2);
    result &= Test("new_arr_ctor_1_num1", arr[1].num1, 1);
    result &= Test("new_arr_ctor_2_num3", arr[2].num3, 3);
    delete[3] arr;

    return result;
}

// Regression: when 'p = new T' is an assignment statement (not a declaration),
// lastOwningResult must not leak into the next declaration in scope.
// Previously the next declared pointer variable was incorrectly marked owning
// and freed at scope exit, causing a double-free with the allocator.
bool testNewAssignNoOwnershipLeak()
{
    bool result = true;

    // p declared before loop (assignment, not declaration, inside loop)
    int* p = nullptr;
    int sum = 0;
    int i = 0;
    while (i < 3)
    {
        p = new int;   // assignment - must NOT set lastOwningResult for next decl
        *p = i + 1;
        sum += *p;
        delete p;
        p = nullptr;
        i++;
    }
    result &= Test("new_assign_sum", sum, 6);

    // q declared AFTER the loop that used 'p = new int'.
    // If lastOwningResult leaked, q would be marked owning and freed at scope
    // exit even though it holds a stack address - causing heap corruption.
    int local = 99;
    int* q = &local;   // NOT a heap allocation; must not be freed at scope exit
    result &= Test("new_assign_no_leak", *q, 99);

    return result;
}

class Point : IString
{
    i32 x = 0;
    i32 y = 0;

    string ToString()
    {
        return "{x}, {y}";
    }
};

bool testFormatString()
{
    bool result = true;

    string name = "World";
    string greeting = "Hello {name}!";
    result &= Test("fmt_simple", greeting.data(), "Hello World!");

    string a = "foo";
    string b = "bar";
    string combined = "{a} and {b}";
    result &= Test("fmt_two", combined.data(), "foo and bar");

    string prefix = "pre";
    string suffix = "suf";
    string three = "{prefix}-mid-{suffix}";
    result &= Test("fmt_three", three.data(), "pre-mid-suf");

    Point p = Point();
	p.x = 10;
	p.y = 20;
	string pointStr = "Point is {p}.";
	result &= Test("fmt_object", pointStr.data(), "Point is 10, 20.");

    // Numeric interpolation: int goes through operator string(i32); float must
    // promote to operator string(double) (regression for float -> double overload
    // resolution). The owned conversion temp is freed at end of statement (no leak).
    int n = 7;
    string intStr = "n={n}";
    result &= Test("fmt_int", intStr.data(), "n=7");

    float f = 1.5;
    string floatStr = "f={f}";
    result &= Test("fmt_float", floatStr.data(), "f=1.5");

    return result;
}

// =============================================================
// if const compile-time conditional tests
// =============================================================

// Constant-folding inputs for `if const`: a const global scalar, a const bool, and an
// enum member. These are true compile-time constants and must be usable in a condition.
const int IF_CONST_SEVEN = 7;
const bool IF_CONST_FEATURE = true;
const int IF_CONST_NEG = -5;
const u32 IF_CONST_BIG = 0xFFFFFFFF;
const int IF_CONST_NEG8 = -8;
enum IfConstFlags : int { IFC_OFF = 0, IFC_ON = 1 };

bool testIfConst()
{
    bool result = true;

    // Test 1: if const with true literal - should enter true branch
    if const (true)
    {
        result &= Test("if_const_true", 1, 1);
    }
    else
    {
        result &= Test("if_const_true", 0, 1);  // should not execute
    }

    // Test 2: if const with false literal - should skip body entirely
    if const (false)
    {
        result &= Test("if_const_false", 0, 1);  // should not execute
    }

    // Test 3: if const with comparison (1 == 1) - should enter true branch
    if const (1 == 1)
    {
        result &= Test("if_const_eq_true", 1, 1);
    }
    else
    {
        result &= Test("if_const_eq_true", 0, 1);  // should not execute
    }

    // Test 4: if const with false comparison (1 == 2) - should enter else branch
    if const (1 == 2)
    {
        result &= Test("if_const_eq_false", 0, 1);  // should not execute
    }
    else
    {
        result &= Test("if_const_eq_false", 1, 1);
    }

    // Test 5: if const with inequality (5 != 3) - should enter true branch
    if const (5 != 3)
    {
        result &= Test("if_const_neq_true", 1, 1);
    }
    else
    {
        result &= Test("if_const_neq_true", 0, 1);  // should not execute
    }

    // Test 6: if const folds a const global scalar - enters true branch
    if const (IF_CONST_SEVEN == 7)
    {
        result &= Test("if_const_global_const", 1, 1);
    }
    else
    {
        result &= Test("if_const_global_const", 0, 1);  // should not execute
    }

    // Test 7: if const folds a const bool global - enters true branch
    if const (IF_CONST_FEATURE)
    {
        result &= Test("if_const_global_bool", 1, 1);
    }
    else
    {
        result &= Test("if_const_global_bool", 0, 1);  // should not execute
    }

    // Test 8: if const folds an enum member comparison - enters else branch
    if const (IfConstFlags.IFC_ON == 0)
    {
        result &= Test("if_const_enum_member", 0, 1);  // should not execute
    }
    else
    {
        result &= Test("if_const_enum_member", 1, 1);
    }

    // Test 9: short-circuit || over constant operands (one platform macro is always set)
    if const (__WINDOWS__ || __MACOS__ || __LINUX__)
    {
        result &= Test("if_const_short_circuit_or", 1, 1);
    }
    else
    {
        result &= Test("if_const_short_circuit_or", 0, 1);  // should not execute
    }

    // Test 10: short-circuit && mixing a const global and an enum member
    if const (IF_CONST_SEVEN > 3 && IfConstFlags.IFC_ON == 1)
    {
        result &= Test("if_const_short_circuit_and", 1, 1);
    }
    else
    {
        result &= Test("if_const_short_circuit_and", 0, 1);  // should not execute
    }

    // Test 11: signed comparison of a NEGATIVE const (-5 < 5) - enters true branch.
    // Guards against zero-extending the sign away and reversing the ordered compare.
    if const (IF_CONST_NEG < 5)
    {
        result &= Test("if_const_neg_lt", 1, 1);
    }
    else
    {
        result &= Test("if_const_neg_lt", 0, 1);  // should not execute
    }

    // Test 12: signed comparison of a NEGATIVE const (-5 > 0) - enters else branch.
    if const (IF_CONST_NEG > 0)
    {
        result &= Test("if_const_neg_gt", 0, 1);  // should not execute
    }
    else
    {
        result &= Test("if_const_neg_gt", 1, 1);
    }

    // Test 13: UNSIGNED right shift (LShr) folds at the operand width, not 64 bits.
    // 0xFFFFFFFF >> 1 must be 0x7FFFFFFF (zero-fill), not a sign-filled value.
    if const ((IF_CONST_BIG >> 1) == 0x7FFFFFFF)
    {
        result &= Test("if_const_ushr", 1, 1);
    }
    else
    {
        result &= Test("if_const_ushr", 0, 1);  // should not execute
    }

    // Test 14: SIGNED right shift (AShr) of a negative const: -8 >> 1 must be -4.
    if const ((IF_CONST_NEG8 >> 1) == -4)
    {
        result &= Test("if_const_sshr", 1, 1);
    }
    else
    {
        result &= Test("if_const_sshr", 0, 1);  // should not execute
    }

    return result;
}

// =============================================================
// Platform constant tests (__PLATFORM__)
// =============================================================

bool testPlatformConstant()
{
    bool result = true;

    // The __PLATFORM__ constant is set at compile-time based on -p flag:
    // 64 for win64 (default), 32 for win32
    // This test verifies that if const works with __PLATFORM__

    if const (__PLATFORM__ == 64)
    {
        result &= Test("__PLATFORM__==64", 1, 1);
    }
    else if const (__PLATFORM__ == 32)
    {
        result &= Test("__PLATFORM__==32", 1, 1);
    }

    // Verify that exactly one of the above branches executed
    // (the other branch should be completely eliminated from IR)
    return result;
}

// =============================================================
// Statements following a return/break/continue that lives in a nested scope
// (a plain compound block or an `if const` arm - both inline into the enclosing
// block). The dead remainder must still compile into valid IR.
// =============================================================

int unreachableAfterIfConstReturn()
{
    if const (__PLATFORM__ == 64)
    {
        return 64;
    }

    int dead = 1;
    return dead;
}

int unreachableAfterNestedReturn()
{
    {
        return 65;
    }
    int dead = 2;
    return dead;
}

int unreachableAfterTopLevelReturn()
{
    return 66;
    int dead = 3;
}

// The nested return must still run the owning string's scope-exit destructor.
int unreachableAfterOwningReturn(int n)
{
    string s = "abc" + "def";
    if (n > 0)
    {
        {
            return s.length();
        }
        s = "leaked";
    }
    return 0;
}

int unreachableAfterNestedBreakContinue()
{
    int total = 0;
    for (int i = 0; i < 5; i++)
    {
        if (i == 3)
        {
            { break; }
            total += 100;
        }
        {
            if (i == 1) { continue; }
            total += 1;
        }
        total += 10;
    }
    return total;
}

bool testUnreachableAfterReturn()
{
    bool result = true;

    result &= Test("unreachable_if_const_return", unreachableAfterIfConstReturn(), 64);
    result &= Test("unreachable_nested_return", unreachableAfterNestedReturn(), 65);
    result &= Test("unreachable_top_level_return", unreachableAfterTopLevelReturn(), 66);
    result &= Test("unreachable_owning_return", unreachableAfterOwningReturn(1), 6);
    result &= Test("unreachable_owning_return_0", unreachableAfterOwningReturn(0), 0);
    result &= Test("unreachable_nested_break", unreachableAfterNestedBreakContinue(), 22);

    return result;
}

// =============================================================
// Global-scope if const tests (compile-time conditional declarations)
// =============================================================

// Test 1: Simple true/false branches at global scope
if const (true)
{
    class GlobalTrueClass
    {
        int value = 42;
    };
}
else
{
    class GlobalFalseClass
    {
        int value = 0;
    };
}

// Test 2: Platform-specific declarations
if const (__PLATFORM__ >= 32)
{
    class PlatformSpecificClass
    {
        int platformValue = 64;
    };

    void platformSpecificFunc()
    {
        printf("Compiled for win64\n");
    }
}
else
{
    class PlatformSpecificClass
    {
        int platformValue = 32;
    };

    void platformSpecificFunc()
    {
        printf("Compiled for other platform\n");
    }
}

// Test 3: Nested if const at global scope
if const (false)
{
    class NeverDeclared
    {
        int x = 99;
    };
}

if const (true)
{
    class AlwaysDeclared
    {
        int y = 123;
    };
}

// Test 4: Chained else-if-const at global scope - only the first true arm is compiled.
// Untaken arms are not type-checked, hence the undefined calls below.
if const (false)
{
    int chainedIfConstValue() { return neverDefinedA(); }
}
else if const (1 == 2)
{
    int chainedIfConstValue() { return neverDefinedB(); }
}
else if const (2 + 2 == 4)
{
    int chainedIfConstValue() { return 314; }
}
else
{
    int chainedIfConstValue() { return neverDefinedC(); }
}

// Test 5: Chained else-if-const with no trailing else - the platform arm wins.
if const (__PLATFORM__ == 64)
{
    int chainedNoElseValue() { return 64; }
}
else if const (__PLATFORM__ == 32)
{
    int chainedNoElseValue() { return 32; }
}

// Test 6: declaration-scope `if const` whose condition EMITS (a const-global load, an enum
// member). The literal/macro conditions above fold without emitting anything, so they never
// exercised the insert point. At file / member / interface scope the builder still points at the
// last, already-terminated block of the previously emitted function; a non-null (rather than
// live) insert-block check appended the load past that terminator and broke module verification
// of an unrelated function. Untaken arms are not type-checked, hence the undefined calls.
const int GLOBAL_IFC_OFF = 0;
const int GLOBAL_IFC_ON = 1;
const bool GLOBAL_IFC_BOOL_OFF = false;
enum GlobalIfcEnum : int { GIFC_A = 0, GIFC_B = 1 };

if const (GLOBAL_IFC_OFF)
{
    int globalConstGlobalValue() { return neverDefinedD(); }
}
else
{
    int globalConstGlobalValue() { return 271; }
}

if const (GLOBAL_IFC_ON)
{
    class GlobalConstGlobalBox<T> { T item = default; };
    int globalConstGlobalTaken() { return 618; }
}

if const (GlobalIfcEnum.GIFC_B == 1)
{
    int globalIfcEnumValue() { return 141; }
}
else
{
    int globalIfcEnumValue() { return neverDefinedE(); }
}

// Nested: an emitting condition inside a taken emitting-condition arm.
if const (GLOBAL_IFC_ON)
{
    if const (GLOBAL_IFC_BOOL_OFF)
    {
        int globalIfcNestedValue() { return neverDefinedF(); }
    }
    else
    {
        int globalIfcNestedValue() { return 355; }
    }
}

namespace GlobalIfcNS
{
    if const (GLOBAL_IFC_OFF)
    {
        int nsValue() { return neverDefinedG(); }
    }
    else
    {
        int nsValue() { return 433; }
    }
}

// Member scope and interface scope reach the same evaluator.
class GlobalIfcMember
{
    int base = 5;
    if const (GLOBAL_IFC_ON) { int extra = 6; }
    if const (GLOBAL_IFC_OFF) { int absent = 7; }
};

interface IGlobalIfc
{
    int gv();
    if const (GLOBAL_IFC_OFF) { int neverInContract(); }
};

class GlobalIfcImpl : IGlobalIfc
{
    int gv() { return 808; }
};

bool testGlobalIfConst()
{
    bool result = true;

    // Test that GlobalTrueClass from true branch is available
    GlobalTrueClass gtc = GlobalTrueClass();
    result &= Test("global_if_const_true_branch", gtc.value, 42);

    // Chained else-if-const: the third arm (2 + 2 == 4) is the first true one
    result &= Test("global_else_if_const_chain", chainedIfConstValue(), 314);
    result &= Test("global_else_if_const_no_else", chainedNoElseValue(), __PLATFORM__);

    // Test that PlatformSpecificClass is declared correctly
    PlatformSpecificClass psc = PlatformSpecificClass();
    if const (__PLATFORM__ >= 32)
    {
        result &= Test("global_if_const_platform_win64", psc.platformValue, 64);
    }
    else
    {
        result &= Test("global_if_const_platform_other", psc.platformValue, 32);
    }

    // Test that AlwaysDeclared from always-true branch is available
    AlwaysDeclared ad = AlwaysDeclared();
    result &= Test("global_if_const_always_declared", ad.y, 123);

    // Call platform-specific function
    platformSpecificFunc();

    // Emitting (const-global / enum-member) conditions at declaration scope
    result &= Test("global_if_const_const_global_else", globalConstGlobalValue(), 271);
    result &= Test("global_if_const_const_global_taken", globalConstGlobalTaken(), 618);
    GlobalConstGlobalBox<int> gcgb = default;
    gcgb.item = 99;
    result &= Test("global_if_const_const_global_generic", gcgb.item, 99);
    result &= Test("global_if_const_enum_member", globalIfcEnumValue(), 141);
    result &= Test("global_if_const_nested_emitting", globalIfcNestedValue(), 355);
    result &= Test("global_if_const_namespace", GlobalIfcNS.nsValue(), 433);

    GlobalIfcMember gim = default;
    result &= Test("global_if_const_member_base", gim.base, 5);
    result &= Test("global_if_const_member_extra", gim.extra, 6);
    // Discriminator for the UNTAKEN member arm: `absent` is never referenced, so a wrongly
    // taken arm would just add a field and every other assertion would still pass. Size sees it.
    result &= Test("global_if_const_member_absent_size", (int)sizeof(GlobalIfcMember), 8);

    GlobalIfcImpl gii = default;
    IGlobalIfc giface = gii;
    result &= Test("global_if_const_interface_member", giface.gv(), 808);

    return result;
}

// =============================================================
// Struct with string field
// =============================================================

struct Employee
{
    string name = default;
    int id = 0;
};

bool testStructWithString()
{
    bool result = true;
    Employee e;
    e.name = "Alice";
    e.id = 42;
    result &= Test("employee_name", e.name.data(), "Alice");
    result &= Test("employee_id",   e.id, 42);
    return result;
}

// =============================================================
// Brace escape sequences in string literals
// \{ \} produce literal braces; {{ }} fold to single braces
// =============================================================

bool testBraceEscapes()
{
    bool result = true;

    // Both \{ and {{ should produce a literal '{' - compare the two forms against each other
    const char* slash = "\{hello\}";
    const char* dbl   = "{{hello}}";
    result &= Test("brace_forms_equal", strcmp(slash, dbl), 0);

    // In a format string, {{ folds to literal '{' and {x} interpolates - check resulting length
    // "value is {x} = 42" => 18 chars
    int x = 42;
    string s = "value is {{x}} = {x}";
    result &= Test("mixed_brace_length", s.length(), 17);

    return result;
}

// =============================================================
// Global struct pointer method dispatch
// Verifies that TypeAndValue is preserved for global variables so
// direct method calls on globals resolve correctly.
// =============================================================

struct GlobalCounter
{
    int count = 0;
    int increment() { count = count + 1; return count; }
    int get() { return count; }
};

GlobalCounter* g_counter = nullptr;

bool testGlobalStructPtrMethod()
{
    bool result = true;

    GlobalCounter c = GlobalCounter();
    g_counter = &c;

    result &= Test("global_ptr_method_get",      g_counter.get(),       0);
    result &= Test("global_ptr_method_increment", g_counter.increment(), 1);
    result &= Test("global_ptr_method_after_inc", g_counter.get(),       1);

    g_counter = nullptr;
    return result;
}

// =============================================================
// Overload resolution tests (float, string types)
// =============================================================

// Regression: a struct method must not win overload resolution for a free call
// whose argument is a primitive pointer. With opaque pointers, readBack(&boolVar)
// once resolved to ReadBackBox.readBack() with the bool* bound as 'this' (the
// fsh shell's readLine(&eof) silently called File.readLine on a stack bool).
struct ReadBackBox
{
    void* _handle = nullptr;
    int readBack() { return -1; }
};

int readBack(bool* flag)
{
    *flag = true;
    return 7;
}

// Regression: a POINTER argument must not bind a by-value parameter of the same type. The scorer
// compared TypeName only, so 'Circle*' scored a PERFECT match on 'PabTake(PabCircle)' and lowered
// a raw address into the struct slot - a module-verifier dump with no source location.
// The by-value overload is declared FIRST on purpose: it is the one that used to win.
class PabCircle { int r = 0; };

int PabTake(PabCircle c)  { return 1000 + c.r; }
int PabTake(PabCircle* c) { return 2000 + c->r; }

int PabByPtrOnly(PabCircle* c) { return 3000 + c->r; }

interface IPabShape { int area(); };
class PabSquare : IPabShape { int s = 0; int area() { return this.s; } };
int PabTakeIface(IPabShape s) { return 4000 + s.area(); }

// Virtual dispatch picks its slot by ARITY, so it carries its own copy of the pointer-vs-value
// proof - one for a by-value class slot, one for a by-value PRIMITIVE slot. These pin its accept
// set: a pointer PARAMETER and a null argument at one must both keep binding.
interface IPabTaker { int bump(int n); };
class PabCounter : IPabTaker { int bump(int n) { return 5000 + n; } };
interface IPabPtrTaker { int peek(int* p); };
class PabPeeker : IPabPtrTaker { int peek(int* p) { if (p == nullptr) { return 6001; } return 6000 + *p; } };

// Pointer DEPTH gate: the scorer compared the boolean Pointer, so a 'T**' argument scored a
// perfect match on a 'T*' parameter. The overload pair is the discriminating shape - both
// candidates have the same arity, so the depth is the only thing that can separate them.
class PdCircle { int r = 0; };
int pdPick(PdCircle* c)  { return 1; }
int pdPick(PdCircle** c) { return 2; }
int pdByPtrPtr(PdCircle** c) { return 1000 + (*c)->r; }
interface PdIface { int take(PdCircle* c); int take(PdCircle** c); };
class PdIfaceImpl : PdIface
{
    int take(PdCircle* c) { return 100 + c->r; }
    int take(PdCircle** c) { return 200 + (*c)->r; }
};
int pdByVoid(void* p) { return p == nullptr ? 0 : 1; }
int pdNullOk(PdCircle** c) { return c == nullptr ? 9 : 8; }
void pdFill(PdCircle** c, int v) { (*c)->r = v; }
// Doors the SCORER is not the judge of, plus the PRIMITIVE cell it judges through a different
// branch (an 'int**' argument carries no CFlat TypeName, so the numeric fallback ranked it).
int pdPrimDeref(int* p) { return 100 + *p; }
int pdPrimDerefPP(int** p) { return 200 + **p; }
int pdSumArr(int* p) { return p[0] + p[1]; }
int pdFirstR(PdCircle* c) { return 90 + c->r; }
// An OVERLOAD SET holding both depths: a 'T*[N]' argument decays to 'T**' and must select the
// 'T**' body, not merely be refused by the 'T*' one.
int pdPickR(PdCircle* c) { return 90 + c->r; }
int pdPickR(PdCircle** c) { return 190 + (*c)->r; }
// The same array against a set holding the 'T*' mistake and the 'void*' SINK: refusing the
// 'T*' one leaves the sink, which every pointer legitimately converts to.
int pdPickV(PdCircle* c) { return 90 + c->r; }
int pdPickV(void* p) { return 55; }
class PdHold { PdCircle* p = nullptr; };
class PdVec { int k = 0;
              int operator+(PdCircle* o) { return 100 + o->r; }
              int operator+(PdCircle** o) { return 200 + (*o)->r; } };

bool testOverloadResolution()
{
    bool result = true;

    bool flag = false;
    result &= Test("free fn beats method this", readBack(&flag), 7);
    result &= Test("free fn wrote through ptr", flag, true);
    result &= Test("int overload",        42,    42);
    result &= Test("bool overload",       true,  true);
    result &= Test("char* overload",      "hello", "hello");

    float f = 1.5f;
    result &= Test("float overload exact",   f,      1.5f);
    result &= Test("float overload literal", 3.14f,  3.14f);
    // Verify a known mismatch is caught (Test returns 0 on mismatch)
    result &= Test("float mismatch detected",   Test("_float_mm",  1.0f,   2.0f)  == 0, true);

    // Subnormal double literal must survive the parser. strtod reports ERANGE on underflow
    // to a subnormal even though it returns the correctly-rounded value; treating that as a
    // parse failure silently folded 1e-320 to 0.0.
    result &= Test("subnormal_double_literal", 1e-320 != 0.0, true);

    string s1 = "hello";
    string s2 = "hello";
    string s3 = "world";
    result &= Test("string overload equal",      s1, s2);
    result &= Test("string mismatch detected",   Test("_str_mm",   s1, s3)        == 0, true);
    result &= Test("string vs literal",          s1, "hello");
    result &= Test("str/literal mismatch detect",Test("_str_lit_mm", s1, "world") == 0, true);

    // FIX LEG: pre-fix this whole file failed module verification (the by-value overload,
    // declared first, took the pointer). 2003 proves the POINTER overload won.
    PabCircle* pc = new PabCircle();
    pc->r = 3;
    result &= Test("pab_ptr_arg_picks_ptr_overload", PabTake(pc), 2003);

    // ACCEPT LEGS: these pass on the pre-fix binary too - the frozen accept set. Each names the
    // widening of the new pointer gate that would flip it.
    PabCircle vc = default;
    vc.r = 5;
    // Fails if the gate became symmetric (value into 'T*' is a working implicit address-of).
    result &= Test("pab_value_into_ptr_param", PabByPtrOnly(vc), 3005);
    // Fails if a value argument started preferring the pointer overload.
    result &= Test("pab_value_arg_picks_value_overload", PabTake(vc), 1005);
    // Fails if an explicit dereference stopped reaching the by-value overload.
    result &= Test("pab_deref_arg_picks_value_overload", PabTake(*pc), 1003);
    // Fails if the gate had ignored IsInterface: 'PabSquare*' upcasts to a by-value interface.
    PabSquare* ps = new PabSquare();
    ps->s = 7;
    result &= Test("pab_class_ptr_into_iface_param", PabTakeIface(ps), 4007);

    // Virtual-path accept set. Fails if the by-value PRIMITIVE gate stopped requiring a
    // NON-pointer parameter, or started judging a plain value as a pointer.
    PabCounter* pcn = new PabCounter();
    IPabTaker ict = pcn;
    result &= Test("pab_virtual_int_value_arg", ict.bump(4), 5004);
    PabPeeker* ppk = new PabPeeker();
    IPabPtrTaker ipt = ppk;
    int px = 9;
    result &= Test("pab_virtual_ptr_param_binds", ipt.peek(&px), 6009);
    result &= Test("pab_virtual_nullptr_into_ptr_param", ipt.peek(nullptr), 6001);

    // Indirect-call accept set. Fails if the argument-shape check at the indirect call site
    // widened past "a pointer left in a non-pointer slot".
    function<int(PabCircle*)> fptr = (PabCircle* c) => { return 7000 + c->r; };
    result &= Test("pab_indirect_ptr_param", fptr(pc), 7003);
    function<int(PabCircle)> fval = (PabCircle c) => { return 8000 + c.r; };
    result &= Test("pab_indirect_deref_arg", fval(*pc), 8003);
    function<int(int*)> fip = (int* p) => { return 9000 + *p; };
    result &= Test("pab_indirect_intptr_param", fip(&px), 9009);

    // ---- Pointer DEPTH gate (a 'T**' argument must not bind a 'T*' parameter) ----
    // FIX LEG: pre-fix both `pdPick` overloads scored a PERFECT match for a 'PdCircle**'
    // (IsTypeMatch compared the boolean Pointer only), so the 'T*' one won by declaration
    // order and read the low bytes of the heap address. 2 proves the 'T**' overload wins.
    PdCircle* pdA = new PdCircle();
    pdA->r = 3;
    PdCircle** pdPP = &pdA;
    result &= Test("pd_ptrptr_arg_picks_ptrptr_overload", pdPick(pdPP), 2);
    result &= Test("pd_ptr_arg_still_picks_ptr_overload", pdPick(pdA), 1);
    // The remedy the new diagnostic names: an explicit '*' reaches the 'T*' overload.
    result &= Test("pd_deref_ptrptr_arg_picks_ptr_overload", pdPick(*pdPP), 1);
    // Fails if the gate stopped being one-sided: a lone 'T**' parameter still takes a 'T**'.
    result &= Test("pd_ptrptr_arg_into_ptrptr_param", pdByPtrPtr(pdPP), 1003);
    // REVERSE direction through a FIXED ARRAY: Pointer/ElemPointer/PointerDepth on a 'T*[N]'
    // describe its ELEMENT, so the array proves nothing about its own depth and still binds.
    // Measured: this leg goes red when the fixed-array exclusion is dropped from the gate.
    PdCircle*[2] pdArr = default;
    pdArr[0] = new PdCircle();
    pdArr[0]->r = 4;
    result &= Test("pd_ptr_array_slot_into_ptrptr_param", pdByPtrPtr(pdArr), 1004);
    // A 'T**' still converts to 'void*'. Measured: these two survive both mutations, because the
    // "any pointer -> void*" rule downstream re-accepts what the gate refuses; the void exclusion
    // exists for the DIAGNOSTIC, which without it falsely blamed a 'void*' parameter.
    result &= Test("pd_ptrptr_arg_into_voidptr_param", pdByVoid(pdPP), 1);
    result &= Test("pd_ptr_arg_into_voidptr_param", pdByVoid(pdA), 1);
    result &= Test("pd_ptrptr_from_array_elem_addr", pdByPtrPtr(&pdArr[0]), 1004);

    // Interface dispatch has its own slot resolver and implementation lookup. Both must keep
    // pointer depth in the signature, so the same-arity T** overload receives the T** argument.
    PdIfaceImpl pdIfaceImpl = default;
    PdIface pdIface = pdIfaceImpl;
    result &= Test("pd_iface_ptrptr_overload", pdIface.take(pdPP), 203);
    result &= Test("pd_iface_ptr_overload", pdIface.take(pdA), 103);

    // ---- The MIRROR gate (a 'T*' argument must not bind a 'T**' parameter) ----
    // FIX LEG: pre-fix '&pdA' recorded no depth, so it scored a PERFECT match on the 'T*'
    // overload and won by declaration order, reading the low bytes of the stack slot. 2 proves
    // the '&' now carries depth 2 and the 'T**' overload wins.
    result &= Test("pd_addrof_ptr_arg_picks_ptrptr_overload", pdPick(&pdA), 2);
    // The '&' remedy the new diagnostic names, compiled and run: this is how a 'T*' reaches a
    // 'T**' parameter. Goes red if '&' stopped adding a level to a recorded depth.
    result &= Test("pd_addrof_into_ptrptr_param", pdByPtrPtr(&pdA), 1003);
    // Out-parameter WRITE-BACK through the same spelling: the callee stores through the pointer
    // and the caller's object sees it. Asserts the write, not just that the call bound.
    pdFill(&pdA, 42);
    result &= Test("pd_outparam_writeback_through_addrof", pdA->r, 42);
    pdA->r = 3;
    // nullptr records no depth, so it keeps binding a 'T**' parameter. Goes red if the mirror
    // started reading an UNRECORDED depth as a claim of depth 1.
    result &= Test("pd_nullptr_into_ptrptr_param", pdNullOk(nullptr), 9);
    // AT THE CAP: 'T**' is the deepest type the model can spell, and a '&' over one is no longer
    // reachable - a 'T***' declarator is now REJECTED outright (this leg used to read '*pdPPP'
    // through one). The rejection is frozen in err_double_pointer_arg_single_pointer_param.cb.
    result &= Test("pd_ptrptr_local_at_cap_reads_through", (*pdPP)->r, 3);

    // ---- PRIMITIVE pointers (accept side) ----
    // A primitive pointer argument carries an EMPTY CFlat TypeName, so it never reached
    // IsTypeMatch's depth gate and the numeric fallback scored 'int**' against 'int*' as one
    // 32-bit "int". These legs are the accept set that fallback must keep granting.
    int pdX = 3;
    int* pdIP = &pdX;
    int** pdIPP = &pdIP;
    result &= Test("pd_prim_ptr_into_ptr_param", pdPrimDeref(pdIP), 103);
    result &= Test("pd_prim_addrof_into_ptr_param", pdPrimDeref(&pdX), 103);
    result &= Test("pd_prim_ptrptr_into_ptrptr_param", pdPrimDerefPP(pdIPP), 203);
    result &= Test("pd_prim_addrof_ptr_into_ptrptr_param", pdPrimDerefPP(&pdIP), 203);
    result &= Test("pd_prim_ptrptr_into_voidptr_param", pdByVoid(pdIPP), 1);

    // ---- ARRAY DECAY is a sanctioned spelling ----
    // 'T[N]' decays to 'T*', so 'T*[N]' decays to 'T**' - only binding that decayed 'T**' to a
    // 'T*' parameter is the depth mistake (frozen in err_double_pointer_arg_single_pointer_param).
    int[2] pdIArr = default;
    pdIArr[0] = 3;
    pdIArr[1] = 4;
    result &= Test("pd_plain_array_decays_to_ptr_param", pdSumArr(pdIArr), 7);
    PdCircle[2] pdSArr = default;
    pdSArr[0].r = 7;
    result &= Test("pd_struct_array_decays_to_ptr_param", pdFirstR(pdSArr), 97);
    result &= Test("pd_ptr_array_element_into_ptr_param", pdFirstR(pdArr[0]), 94);
    // Selection, not just refusal: with both depths declared the decayed 'T**' takes the 'T**'
    // body. This read 94 (the wrong body) before the decay was judged.
    result &= Test("pd_ptr_array_picks_ptrptr_overload", pdPickR(pdArr), 194);
    // Second selection cell: with only the 'T*' mistake and a 'void*' sink declared, the array
    // now takes the sink. Measured from the IR - '@_f_i32_CPtr_' pre, '@_f_i32_U8Ptr_' post.
    result &= Test("pd_ptr_array_picks_voidptr_over_ptr", pdPickV(pdArr), 55);

    // ---- INDIRECT 'function<>' call ----
    // This door lowers its own argument list and enters neither the scorer nor the interface
    // slot resolver, so it needed its own depth gate; both correct depths still call through.
    function<int(PdCircle*)> pdF = pdFirstR;
    result &= Test("pd_fnptr_ptr_param_correct_depth", pdF(pdA), 93);
    function<int(PdCircle**)> pdFP = pdByPtrPtr;
    result &= Test("pd_fnptr_ptrptr_param_correct_depth", pdFP(pdPP), 1003);
    result &= Test("pd_fnptr_addrof_into_ptrptr_param", pdFP(&pdA), 1003);
    function<int(PdCircle**)> pdFN = pdNullOk;
    result &= Test("pd_fnptr_nullptr_arg_still_binds", pdFN(nullptr), 9);

    // ---- OPERATOR OPERAND ----
    // Only the RECEIVER reaches the scorer; the operand was reduced to a raw llvm::Value, so
    // under opaque pointers 'pdV + pdPP' took the 'T*' body. With BOTH overloads declared the
    // operand's depth is the only thing that can separate them - this pair goes red together if
    // the depth stops being carried to the scorer.
    PdVec pdV = default;
    result &= Test("pd_op_operand_ptr_picks_ptr_overload", pdV + pdA, 103);
    result &= Test("pd_op_operand_ptrptr_picks_ptrptr_overload", pdV + pdPP, 203);

    // '&' over a 'T*' FIELD is depth 2, the deepest a value can be; it still binds a 'T**'.
    PdHold pdH = default;
    pdH.p = pdA;
    result &= Test("pd_addrof_ptr_field_into_ptrptr_param", pdByPtrPtr(&pdH.p), 1003);

    delete pc;
    delete ps;

    return result;
}

// =============================================================
// Static method tests
// =============================================================

struct StaticMathUtils
{
    static int add(int a, int b) { return a + b; }
    static int mul(int a, int b) { return a * b; }
    static int square(int x)     { return x * x; }
};

class StaticCounter
{
    int _count = 0;
    static int zero()       { return 0; }
    static int maxValue()   { return 2147483647; }
    void increment()        { _count = _count + 1; }
    int  value()            { return _count; }
};

struct StaticPoint
{
    int x = 0;
    int y = 0;
    static int origin_x() { return 0; }
    static int origin_y() { return 0; }
};

bool testStatic()
{
    bool result = true;
    result &= Test("StaticMath.add",    StaticMathUtils.add(3, 4),    7);
    result &= Test("StaticMath.mul",    StaticMathUtils.mul(3, 4),    12);
    result &= Test("StaticMath.square", StaticMathUtils.square(5),    25);
    result &= Test("Counter.zero",      StaticCounter.zero(),         0);
    result &= Test("Counter.maxValue",  StaticCounter.maxValue(),     2147483647);
    StaticCounter sc = StaticCounter();
    sc.increment();
    sc.increment();
    result &= Test("Counter.value",     sc.value(),                   2);
    result &= Test("Point.origin_x",    StaticPoint.origin_x(),       0);
    result &= Test("Point.origin_y",    StaticPoint.origin_y(),       0);
    return result;
}

// =============================================================
// Cast tests (C-style casts, float UFCS, integer conversions)
// =============================================================

bool testCast()
{
    bool result = true;

    i32 five = 5;
    i32 neg3 = -3;
    float fpos = 3.9f;
    float fneg = -3.9f;

    result &= Test("(float)5",    (float)five,   5.0f);
    result &= Test("(float)-3",   (float)neg3,  -3.0f);
    result &= Test("(int)3.9f",   (int)fpos,     3);
    result &= Test("(int)-3.9f",  (int)fneg,    -3);
    result &= Test("(int)3.0f",   (int)3.0f,     3);

    i64 big64 = 0x200000000;
    big64 = big64 + 5;
    i32 neg32 = -1;
    result &= Test("(i32)(i64) truncate", (i32)big64,   5);
    result &= Test("(i64)(i32) sign-ext", (i64)neg32,   -1);

    result &= Test("(0.5f).round()",    (0.5f).round(),    1.0f);
    result &= Test("(-0.5f).round()",   (-0.5f).round(),  -1.0f);
    result &= Test("(0.4f).round()",    (0.4f).round(),    0.0f);
    result &= Test("(-0.4f).round()",   (-0.4f).round(),   0.0f);
    result &= Test("(-3.7f).floor()",   (-3.7f).floor(),  -4.0f);
    result &= Test("(-3.7f).ceil()",    (-3.7f).ceil(),   -3.0f);
    result &= Test("(-3.0f).floor()",   (-3.0f).floor(),  -3.0f);
    result &= Test("(-3.0f).ceil()",    (-3.0f).ceil(),   -3.0f);
    result &= Test("(0.0f).abs()",      (0.0f).abs(),      0.0f);
    result &= Test("(3.5f).abs()",      (3.5f).abs(),      3.5f);
    result &= Test("(9.0f).sqrt()",     (9.0f).sqrt(),     3.0f);
    result &= Test("(1.0f).sqrt()",     (1.0f).sqrt(),     1.0f);
    result &= Test("(0.0f).sqrt()",     (0.0f).sqrt(),     0.0f);

    float v = -5.5f;
    result &= Test("var(-5.5f).floor()", v.floor(), -6.0f);
    result &= Test("var(-5.5f).ceil()",  v.ceil(),  -5.0f);
    result &= Test("var(-5.5f).round()", v.round(), -6.0f);
    result &= Test("var(-5.5f).abs()",   v.abs(),    5.5f);

    i32 v127   = 127;
    i32 v128   = 128;
    i32 v32767 = 32767;
    i32 v32768 = 32768;
    result &= Test("127.to_i8()",          v127.to_i8(),    127);
    result &= Test("128.to_i8() wrap",     v128.to_i8(),   -128);
    result &= Test("32767.to_i16()",       v32767.to_i16(), 32767);
    result &= Test("32768.to_i16() wrap",  v32768.to_i16(),-32768);

    i32 neg_src  = -100;
    i8  byte_neg = neg_src.to_i8();
    result &= Test("i8(-100).to_i16()", byte_neg.to_i16(), -100);
    result &= Test("i8(-100).to_i32()", byte_neg.to_i32(), -100);
    result &= Test("i8(-100).to_i64()",  byte_neg.to_i64(),      -100);

    i16 short_neg = neg_src.to_i16();
    result &= Test("i16(-100).to_i32()", short_neg.to_i32(), -100);
    result &= Test("i16(-100).to_i64()",  short_neg.to_i64(),     -100);

    i32 xi = 42;
    result &= Test("i32(42).to_i32()",  xi.to_i32(),  42);
    i64 yi = 999;
    result &= Test("i64(999).to_i64()", yi.to_i64(),  999);

    return result;
}

// =============================================================
// Nullable pointer (?.) tests
// =============================================================

struct NullablePoint
{
    int x = 0;
    int y = 0;
};

struct NullableContainer
{
    NullablePoint* inner = nullptr;
};

// Interface receiver fixture for '?.' on a fat {vtable,data} value (not a thin pointer).
interface INcCounter { int get(); };
class NcCounterImpl : INcCounter
{
    int v = 0;
    NcCounterImpl(int val) { v = val; }
    int get() { return v; }
};

// Chained '?.' fixture: a factory interface whose method returns ANOTHER interface, so
// `factory?.mk().get()` must short-circuit the WHOLE chain (not just `mk()`) when the
// receiver is null - a null intermediate must never reach the unguarded `.get()`.
interface INcFactory { INcCounter mk(); };
class NcFactoryImpl : INcFactory
{
    NcCounterImpl* inner = nullptr;
    NcFactoryImpl(int val) { inner = new NcCounterImpl(val); }
    INcCounter mk() { return inner; }
};

// Extension (UFCS) function on the interface type, for the '?.' + extension-function gap:
// `recv?.doubled()` binds to this free function (not a vtable method) and must still short-
// circuit on a null receiver instead of passing it straight into the callee.
int ncDoubled(INcCounter c) { return c.get() * 2; }

// Fixture for a VOID-returning '?.' call (struct receiver): a void CallInst is a non-null
// value of void type, so the chain-end merge must not mistake it for "has a result".
struct NcBumper
{
    int hits = 0;
    void bump() { hits = hits + 1; }
};

// Fixture for a '?.' chain ending on an array element: the merge must handle a Storage-only
// final link (no Primary yet) instead of silently producing undef.
struct NcBag
{
    int arr[4] = default;
};

// '?.' ARGUMENT EVALUATION ORDER fixtures. A '?.' promises to short-circuit, so a null
// receiver must skip the argument expressions too - they used to run before the guard
// branch was even emitted. ncSeCount counts every argument evaluation and ncSeOrder
// records the ORDER (left-to-right => 12, not 21), so a leaked or reordered side effect
// is observable as a value, not merely as "it compiled".
int ncSeCount = 0;
int ncSeOrder = 0;
int ncSe(int x) { ncSeCount = ncSeCount + 1; return x; }
int ncSeq(int x) { ncSeCount = ncSeCount + 1; ncSeOrder = ncSeOrder * 10 + x; return x; }

struct NcArg
{
    int v = default;
    int arr[3] = default;
    int add(int a) { return v + a; }
    int add2(int a, int b) { return v + a + b; }
    void bump(int a) { v = v + a; }
};
// UFCS extension function on a struct pointer receiver (the '?.' extension-call arm).
int ncArgExt(NcArg* self, int a) { return self->v + a; }

struct NcArgHolder
{
    NcArg* p = default;
};

// Interface receiver whose contract method TAKES an argument, plus an extension (UFCS)
// function on the same interface - the two interface '?.' dispatch arms.
interface INcArgIface { int getv(int a); };
class NcArgImpl : INcArgIface
{
    int v = 0;
    NcArgImpl(int val) { v = val; }
    int getv(int a) { return v + a; }
};
int ncIfaceExt(INcArgIface c, int a) { return c.getv(0) + a; }

int ncPair(int a, int b) { return a * 100 + b; }

// Fixture pinning CURRENT correct thin-pointer chain behavior: `a?.nxt().get()` must dispatch
// the SECOND link on nxt()'s result, not on the original receiver `a`.
struct NcNode
{
    int v = 0;
    NcNode* next = nullptr;
    NcNode* nxt() { return next; }
    int get() { return v; }
};

bool testNullableTypes()
{
    bool result = true;

    NullablePoint? p;
    result &= Test("nullable default is nullptr", (int)(p == nullptr), 1);

    NullablePoint pt = NullablePoint();
    pt.x = 10;
    pt.y = 20;
    p = &pt;
    result &= Test("nullable after assign not nullptr", (int)(p != nullptr), 1);
    result &= Test("nullable ?.x access",               p?.x, 10);
    p = nullptr;
    result &= Test("nullable reset to nullptr", (int)(p == nullptr), 1);

    NullablePoint pt2;
    pt2.x = 42;
    NullablePoint* rp = &pt2;
    result &= Test("?. on local ptr",           rp?.x,  42);
    NullablePoint* np = nullptr;
    result &= Test("?. on null local ptr",       np?.x,  0);

    NullablePoint pt3;
    pt3.x = 99;
    NullableContainer nc;
    nc.inner = &pt3;
    result &= Test("?. on member ptr",           nc.inner?.x, 99);
    NullableContainer nc2;
    result &= Test("?. on null member ptr",      nc2.inner?.x, 0);

    // '?.' on an INTERFACE receiver: the receiver is a fat {vtable,data} struct value, not a
    // thin pointer, so the null-conditional lowering must branch on the DATA slot instead of
    // treating the struct itself as the null test (used to segfault - see git history).
    INcCounter nullIface = nullptr;
    result &= Test("?. on null interface receiver",     nullIface?.get(), 0);
    INcCounter realIface = new NcCounterImpl(77);
    result &= Test("?. on non-null interface receiver", realIface?.get(), 77);

    // Chained '?.' on an interface receiver: `factory?.mk().get()` must guard the WHOLE
    // chain, not just the first link - a null factory must short-circuit before `.get()`
    // ever dispatches on the (otherwise null) intermediate `mk()` result.
    INcFactory nullFactory = nullptr;
    result &= Test("?. chained call on null interface receiver",     nullFactory?.mk().get(), 0);
    INcFactory realFactory = new NcFactoryImpl(88);
    result &= Test("?. chained call on non-null interface receiver", realFactory?.mk().get(), 88);

    // '?.' resolving to an extension (UFCS) function rather than a vtable method: must also
    // short-circuit on a null receiver instead of passing it straight into the callee.
    result &= Test("?. extension call on null interface receiver",     nullIface?.ncDoubled(), 0);
    result &= Test("?. extension call on non-null interface receiver", realIface?.ncDoubled(), 154);

    // A VOID-returning '?.' call statement must not crash the compiler (a void CallInst is a
    // non-null value of void type - the chain-end merge must treat it as "no result").
    NcBumper* nullBumper = nullptr;
    nullBumper?.bump();
    NcBumper bumperVal = NcBumper();
    result &= Test("void ?. call on null receiver does not crash", bumperVal.hits, 0);
    NcBumper* realBumper = &bumperVal;
    realBumper?.bump();
    result &= Test("void ?. call on non-null receiver runs",       bumperVal.hits, 1);

    // A '?.' chain ending on an array element: the merge must load the Storage-only final
    // link instead of producing undef.
    NcBag bagVal = NcBag();
    bagVal.arr[1] = 7;
    NcBag* realBag = &bagVal;
    NcBag* nullBag = nullptr;
    result &= Test("?. chain to array element on non-null receiver", realBag?.arr[1], 7);
    result &= Test("?. chain to array element on null receiver",     nullBag?.arr[1], 0);

    // Thin-pointer chained '?.': `a?.nxt().get()` must dispatch '.get()' on nxt()'s RESULT,
    // not on the original receiver 'a' (pinning current, correct behavior).
    NcNode nodeB = NcNode();
    nodeB.v = 42;
    NcNode nodeA = NcNode();
    nodeA.v = 1;
    nodeA.next = &nodeB;
    NcNode* pa = &nodeA;
    NcNode* pz = nullptr;
    result &= Test("thin ?. chained call on non-null receiver", pa?.nxt().get(), 42);
    result &= Test("thin ?. chained call on null receiver",     pz?.nxt().get(), 0);

    // A '?.' chain whose FINAL link is a whole ARRAY (not a loaded scalar): the merge must
    // produce a real address on both paths (a live GEP, or a fresh zeroed array), not blank
    // the NamedVariable - a for-in over `p?.arr` must sum the real elements when non-null and
    // iterate a zeroed array when null.
    NcBag bagArr = NcBag();
    bagArr.arr[0] = 1; bagArr.arr[1] = 2; bagArr.arr[2] = 3;
    NcBag* pBag = &bagArr;
    NcBag* zBag = nullptr;
    int arrTotal = 0;
    for (int v in pBag?.arr) arrTotal = arrTotal + v;
    result &= Test("?. chain to whole array on non-null receiver", arrTotal, 6);
    int arrTotalNull = 0;
    for (int v in zBag?.arr) arrTotalNull = arrTotalNull + v;
    result &= Test("?. chain to whole array on null receiver", arrTotalNull, 0);

    result &= testNullConditionalArgOrder();

    return result;
}

// '?.' short-circuits its ARGUMENTS as well as its dispatch: on a null receiver the
// argument expressions must not run at all, and on a live receiver they must run exactly
// once, left to right. Every leg asserts the call's VALUE and the side-effect COUNT, so a
// leaked argument evaluation fails even though the returned value is right either way.
bool testNullConditionalArgOrder()
{
    bool result = true;

    NcArg argVal = NcArg();
    argVal.v = 10;
    argVal.arr[1] = 7;
    NcArg* liveArg = &argVal;
    NcArg* zArg = nullptr;

    // 1. Struct method through a thin pointer.
    ncSeCount = 0;
    result &= Test("nc_argord_method_null_value", zArg?.add(ncSe(5)), 0);
    result &= Test("nc_argord_method_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_method_live_value", liveArg?.add(ncSe(5)), 15);
    result &= Test("nc_argord_method_live_arg_once", ncSeCount, 1);

    // 2. Two arguments: left-to-right order on the live path, nothing on the null path.
    ncSeCount = 0; ncSeOrder = 0;
    result &= Test("nc_argord_two_null_value", zArg?.add2(ncSeq(1), ncSeq(2)), 0);
    result &= Test("nc_argord_two_null_skips_args", ncSeCount, 0);
    result &= Test("nc_argord_two_null_no_order", ncSeOrder, 0);
    result &= Test("nc_argord_two_live_value", liveArg?.add2(ncSeq(1), ncSeq(2)), 13);
    result &= Test("nc_argord_two_live_args_twice", ncSeCount, 2);
    result &= Test("nc_argord_two_live_left_to_right", ncSeOrder, 12);

    // 3. Extension (UFCS) function on a struct pointer receiver.
    ncSeCount = 0;
    result &= Test("nc_argord_structext_null_value", zArg?.ncArgExt(ncSe(3)), 0);
    result &= Test("nc_argord_structext_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_structext_live_value", liveArg?.ncArgExt(ncSe(3)), 13);
    result &= Test("nc_argord_structext_live_arg_once", ncSeCount, 1);

    // 4. Interface contract method (fat {vtable,data} receiver, vtable dispatch).
    INcArgIface zIface = nullptr;
    INcArgIface liveIface = new NcArgImpl(50);
    ncSeCount = 0;
    result &= Test("nc_argord_iface_null_value", zIface?.getv(ncSe(4)), 0);
    result &= Test("nc_argord_iface_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_iface_live_value", liveIface?.getv(ncSe(4)), 54);
    result &= Test("nc_argord_iface_live_arg_once", ncSeCount, 1);

    // 5. Extension (UFCS) function on an interface receiver.
    ncSeCount = 0;
    result &= Test("nc_argord_ifaceext_null_value", zIface?.ncIfaceExt(ncSe(6)), 0);
    result &= Test("nc_argord_ifaceext_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_ifaceext_live_value", liveIface?.ncIfaceExt(ncSe(6)), 56);
    result &= Test("nc_argord_ifaceext_live_arg_once", ncSeCount, 1);

    // 6. A VOID '?.' call used as a STATEMENT, not assigned.
    NcArg stmtVal = NcArg();
    stmtVal.v = 1;
    NcArg* liveStmt = &stmtVal;
    NcArg* zStmt = nullptr;
    ncSeCount = 0;
    zStmt?.bump(ncSe(2));
    result &= Test("nc_argord_void_stmt_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_void_stmt_null_no_effect", stmtVal.v, 1);
    liveStmt?.bump(ncSe(2));
    result &= Test("nc_argord_void_stmt_live_arg_once", ncSeCount, 1);
    result &= Test("nc_argord_void_stmt_live_runs", stmtVal.v, 3);

    // 7. A field receiver and an array-element receiver reach the same guard.
    NcArgHolder zHold = NcArgHolder();
    NcArgHolder liveHold = NcArgHolder();
    liveHold.p = liveArg;
    ncSeCount = 0;
    result &= Test("nc_argord_field_recv_null_value", zHold.p?.add(ncSe(8)), 0);
    result &= Test("nc_argord_field_recv_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_field_recv_live_value", liveHold.p?.add(ncSe(8)), 18);
    result &= Test("nc_argord_field_recv_live_arg_once", ncSeCount, 1);

    NcArg* elems[2] = default;
    elems[0] = nullptr;
    elems[1] = liveArg;
    ncSeCount = 0;
    result &= Test("nc_argord_elem_recv_null_value", elems[0]?.add(ncSe(9)), 0);
    result &= Test("nc_argord_elem_recv_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_elem_recv_live_value", elems[1]?.add(ncSe(9)), 19);
    result &= Test("nc_argord_elem_recv_live_arg_once", ncSeCount, 1);

    // 8. The argument is itself a '?.' call - each receiver gates only its own arguments.
    ncSeCount = 0;
    result &= Test("nc_argord_nested_outer_null_value", zArg?.add(liveArg?.add(ncSe(11))), 0);
    result &= Test("nc_argord_nested_outer_null_skips_all", ncSeCount, 0);
    result &= Test("nc_argord_nested_inner_null_value", liveArg?.add(zArg?.add(ncSe(12))), 10);
    result &= Test("nc_argord_nested_inner_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_nested_live_value", liveArg?.add(liveArg?.add(ncSe(1))), 21);
    result &= Test("nc_argord_nested_live_arg_once", ncSeCount, 1);

    // 9. A '?.' call in ARGUMENT position of an ordinary call, and with '??' on the same line.
    ncSeCount = 0;
    result &= Test("nc_argord_as_arg_null_value", ncPair(zArg?.add(ncSe(14)), 1), 1);
    result &= Test("nc_argord_as_arg_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_as_arg_live_value", ncPair(liveArg?.add(ncSe(14)), 1), 2401);
    result &= Test("nc_argord_as_arg_live_arg_once", ncSeCount, 1);

    ncSeCount = 0;
    result &= Test("nc_argord_coalesce_null_value", zArg?.add(ncSe(15)) ?? -1, -1);
    result &= Test("nc_argord_coalesce_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_coalesce_live_value", liveArg?.add(ncSe(15)) ?? -1, 25);
    result &= Test("nc_argord_coalesce_live_arg_once", ncSeCount, 1);

    // 10. An argument value that is READ AGAIN after the guarded call: the guarded block
    // must not be where that value is defined, or the IR fails dominance verification.
    ncSeCount = 0;
    int kept = ncSe(16);
    result &= Test("nc_argord_reuse_null_value", zArg?.add(kept), 0);
    result &= Test("nc_argord_reuse_live_value", liveArg?.add(kept), 26);
    result &= Test("nc_argord_reuse_kept_intact", kept, 16);
    result &= Test("nc_argord_reuse_arg_once", ncSeCount, 1);

    // 11. A '?.' chain whose LATER link takes arguments: the first link's guard already
    // covers the rest of the chain, so the later link's arguments are skipped too.
    ncSeCount = 0;
    result &= Test("nc_argord_chain_field_null_value", zArg?.arr[1], 0);
    result &= Test("nc_argord_chain_field_live_value", liveArg?.arr[1], 7);
    result &= Test("nc_argord_chain_no_stray_args", ncSeCount, 0);

    // 12. Everything above uses a receiver the optimizer can prove null or non-null, so it
    // constant-folds and no guard branch survives into the emitted IR. These legs make the
    // null-ness OPAQUE (`ncSeCount > 999` is false at runtime but unknowable at compile
    // time), so each one emits a real `br i1` and exercises the guard that was actually
    // added, once per call-site kind.
    NcArg* zOpaque = ncSeCount > 999 ? liveArg : nullptr;
    NcArg* liveOpaque = ncSeCount > 999 ? nullptr : liveArg;
    INcArgIface zIfOpaque = ncSeCount > 999 ? liveIface : nullptr;
    INcArgIface liveIfOpaque = ncSeCount > 999 ? nullptr : liveIface;

    ncSeCount = 0;
    result &= Test("nc_argord_opaque_method_null_value", zOpaque?.add(ncSe(5)), 0);
    result &= Test("nc_argord_opaque_method_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_opaque_method_live_value", liveOpaque?.add(ncSe(5)), 15);
    result &= Test("nc_argord_opaque_method_live_arg_once", ncSeCount, 1);

    ncSeCount = 0;
    result &= Test("nc_argord_opaque_structext_null_value", zOpaque?.ncArgExt(ncSe(3)), 0);
    result &= Test("nc_argord_opaque_structext_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_opaque_structext_live_value", liveOpaque?.ncArgExt(ncSe(3)), 13);
    result &= Test("nc_argord_opaque_structext_live_arg_once", ncSeCount, 1);

    ncSeCount = 0;
    result &= Test("nc_argord_opaque_iface_null_value", zIfOpaque?.getv(ncSe(4)), 0);
    result &= Test("nc_argord_opaque_iface_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_opaque_iface_live_value", liveIfOpaque?.getv(ncSe(4)), 54);
    result &= Test("nc_argord_opaque_iface_live_arg_once", ncSeCount, 1);

    ncSeCount = 0;
    result &= Test("nc_argord_opaque_ifaceext_null_value", zIfOpaque?.ncIfaceExt(ncSe(6)), 0);
    result &= Test("nc_argord_opaque_ifaceext_null_skips_arg", ncSeCount, 0);
    result &= Test("nc_argord_opaque_ifaceext_live_value", liveIfOpaque?.ncIfaceExt(ncSe(6)), 56);
    result &= Test("nc_argord_opaque_ifaceext_live_arg_once", ncSeCount, 1);

    return result;
}

// =============================================================
// Nested struct / class tests
// =============================================================

struct OuterStruct {
    struct InnerStruct {
        int x = 0;
        int y = 0;
    };
    InnerStruct inner;
    int value = 0;

    int sum()
    {
        return inner.x + inner.y + value;
    }
};

class OuterClass {
    class InnerClass {
        int a = 0;
        int b = 0;

        int product()
        {
            return a * b;
        }
    };
    InnerClass data;
};

class ClassWithInnerStruct {
    struct Point {
        int x = 0;
        int y = 0;
    };
    Point origin;
    Point corner;
};

struct StructWithInnerClass {
    class Color {
        int r = 0;
        int g = 0;
        int b = 0;

        int brightness()
        {
            return r + g + b;
        }
    };
    Color tint;
};

bool testNestedStructClass()
{
    bool result = true;

    OuterStruct o;
    o.inner.x = 3;
    o.inner.y = 7;
    o.value = 10;
    result &= Test("nested struct field access", o.inner.x, 3);
    result &= Test("nested struct method", o.sum(), 20);

    OuterStruct.InnerStruct standalone;
    standalone.x = 100;
    standalone.y = 200;
    result &= Test("nested type qualified x", standalone.x, 100);
    result &= Test("nested type qualified y", standalone.y, 200);

    OuterClass oc;
    oc.data.a = 4;
    oc.data.b = 5;
    result &= Test("nested class field a", oc.data.a, 4);
    result &= Test("nested class method product", oc.data.product(), 20);

    ClassWithInnerStruct cws;
    cws.origin.x = 0;
    cws.origin.y = 0;
    cws.corner.x = 10;
    cws.corner.y = 20;
    result &= Test("class with inner struct origin x", cws.origin.x, 0);
    result &= Test("class with inner struct corner x", cws.corner.x, 10);
    result &= Test("class with inner struct corner y", cws.corner.y, 20);

    StructWithInnerClass swc;
    swc.tint.r = 100;
    swc.tint.g = 150;
    swc.tint.b = 200;
    result &= Test("struct with inner class field r", swc.tint.r, 100);
    result &= Test("struct with inner class brightness", swc.tint.brightness(), 450);

    return result;
}

// =============================================================
// Variadic function tests
// =============================================================

bool testVariadic()
{
    bool result = true;
    char* buf = (char*)malloc(64);

    // Positional: all args by position - regression for the original call path.
    snprintf(buf, 64, "%d + %d = %d", 3, 4, 7);
    result &= Test("variadic_positional", (const char*)buf, "3 + 4 = 7");

    // Named fixed parameter with variadic tail: fmt: names the third param of snprintf
    // while buf and 64 remain positional and 6, 7, 42 are variadic.
    snprintf(buf, 64, fmt: "%d * %d = %d", 6, 7, 42);
    result &= Test("variadic_named_fmt", (const char*)buf, "6 * 7 = 42");

    // C default argument promotions for a variadic slot. A sub-int value must be
    // widened to int: a bool VARIABLE used to reach the slot as a raw i1, so "%d"
    // printed the stack garbage in the upper bits (true printed e.g. -804465151).
    // The true case is the one that regressed - false hid the bug behind a zero.
    int n = 5;
    bool bTrue  = (n == 5);
    bool bFalse = (n == 6);
    snprintf(buf, 64, "%d %d", bTrue, bFalse);
    result &= Test("variadic_promote_bool_var", (const char*)buf, "1 0");

    // The same value written INLINE (an i1 straight out of the compare) and via an
    // explicit cast always worked - pin both so the three forms cannot diverge again.
    snprintf(buf, 64, "%d %d", n == 5, n == 6);
    result &= Test("variadic_promote_bool_expr", (const char*)buf, "1 0");
    snprintf(buf, 64, "%d %d", (int)bTrue, (int)bFalse);
    result &= Test("variadic_promote_bool_cast", (const char*)buf, "1 0");

    // Narrower-than-int integers promote by signedness: u8 255 -> 255, not -1.
    char cVal = 'A';
    u8   uVal = 200;
    i16  sVal = -300;
    u16  wVal = 60000;
    snprintf(buf, 64, "%d %d %d %d", cVal, uVal, sVal, wVal);
    result &= Test("variadic_promote_narrow_ints", (const char*)buf, "65 200 -300 60000");

    // A 'string' has no implicit char* decay (a typed char* param rejects it), and a
    // variadic slot is untyped - so '.data()' is the only way to feed one to "%s".
    // Passing the bare string is a compile error (Test/errors/err_string_vararg.cb);
    // it used to pass the raw {ptr,len} struct, which fed the LENGTH to the next slot.
    // These are the two shapes that broke: an argument AFTER a %s, and two %s in one call.
    string sHello = "hello";
    string sWorld = "world";
    snprintf(buf, 64, "[%s] %d", sHello.data(), 42);
    result &= Test("variadic_string_then_int", (const char*)buf, "[hello] 42");

    snprintf(buf, 64, "%s %s!", sHello.data(), sWorld.data());
    result &= Test("variadic_two_strings", (const char*)buf, "hello world!");

    // The string must survive being read through .data() - the buffer is borrowed by the
    // callee, never transferred, so the value is still usable (and still owned) afterwards.
    result &= Test("variadic_string_intact", sHello, "hello");

    free(buf);
    return result;
}

// =============================================================
// Primitive type alias tests (using Alias = primitiveType)
// =============================================================

using MyInt  = int;
using MyU32  = u32;
using MyI64  = i64;
using MyBool = bool;
using MyF32  = float;

MyInt  primitiveAliasAdd(MyInt a, MyInt b) { return a + b; }
MyU32  primitiveAliasU32(MyU32 a, MyU32 b) { return a + b; }
MyI64  primitiveAliasI64(MyI64 a, MyI64 b) { return a + b; }

bool testPrimitiveTypeAlias()
{
    bool result = true;

    MyInt  i = 10;
    result &= Test("alias_int_decl",      i,                      10);
    result &= Test("alias_int_func",      primitiveAliasAdd(3, 4), 7);

    MyU32  u = 300000;
    result &= Test("alias_u32_decl",      u,                       300000);
    result &= Test("alias_u32_func",      primitiveAliasU32(10, 5), 15);

    MyI64  l = 1000000000;
    result &= Test("alias_i64_decl",      l,                       1000000000);
    result &= Test("alias_i64_func",      primitiveAliasI64(100, 200), 300);

    MyBool b = true;
    result &= Test("alias_bool_decl",     b,                       true);

    MyF32  f = 1.5f;
    result &= Test("alias_float_decl",    f,                       1.5f);

    // Local alias inside a function
    using LocalU8 = u8;
    LocalU8 byte = 255;
    result &= Test("local_alias_u8",      byte,                    255);

    return result;
}

// =============================================================
// Pointer type alias tests (using Handle = void*) - Tier 2
// The trailing '*' is stored in the alias string and peeled back onto the
// Pointer / ElemPointer flags at the resolution site.
// =============================================================

struct AliasNode { int v = 0; };

using IntPtrAlias = int*;
using VoidPtrAlias = void*;
using NodePtrAlias = AliasNode*;

int derefIntPtrAlias(IntPtrAlias p) { return *p; }   // alias used in a parameter

bool testPointerTypeAlias()
{
    bool result = true;

    int x = 7;
    IntPtrAlias p = &x;
    result &= Test("ptr_alias_deref",  *p,                   7);
    result &= Test("ptr_alias_in_fn",  derefIntPtrAlias(p),  7);

    // void* alias holds any pointer and round-trips through a cast
    VoidPtrAlias h = (void*)p;
    result &= Test("ptr_alias_void_nonnull", h != nullptr,   true);
    IntPtrAlias back = (int*)h;
    result &= Test("ptr_alias_void_roundtrip", *back,        7);

    // alias star + use-site star => int**
    IntPtrAlias* pp = &p;
    result &= Test("ptr_alias_double", **pp,                 7);

    // struct pointer alias
    AliasNode n = default;
    n.v = 99;
    NodePtrAlias np = &n;
    result &= Test("ptr_alias_struct", np->v,                99);

    return result;
}

// =============================================================
// Array type alias tests (using Vec3 = float[3]) - Tier 3
// The folded sizes are baked into the alias string ("float[3]") and re-parsed
// onto ConstArraySize / ConstInnerDimensions at the resolution site.
// =============================================================

using Vec3Alias = i32[3];
using Mat2Alias = i32[2][3];

bool testArrayTypeAlias()
{
    bool result = true;

    // Single-dimension array alias, zero-initialized then written
    Vec3Alias v = default;
    v[0] = 10; v[1] = 20; v[2] = 12;
    result &= Test("arr_alias_elem0",  v[0],            10);
    result &= Test("arr_alias_elem2",  v[2],            12);
    result &= Test("arr_alias_sum",    v[0] + v[1] + v[2], 42);
    result &= Test("arr_alias_sizeof", sizeof(Vec3Alias), 12);  // 3 * 4 bytes

    // Two declarators share the aliased size (the size lives on the type)
    Vec3Alias a = default;
    Vec3Alias b = default;
    a[2] = 7;
    b[2] = 9;
    result &= Test("arr_alias_two_decls", a[2] + b[2], 16);

    // Multi-dimensional array alias
    Mat2Alias m = default;
    m[0][0] = 5; m[1][2] = 8;
    result &= Test("arr_alias_md_00",    m[0][0],          5);
    result &= Test("arr_alias_md_12",    m[1][2],          8);
    result &= Test("arr_alias_md_sizeof", sizeof(Mat2Alias), 24);  // 2 * 3 * 4 bytes

    return result;
}

// =============================================================
// Fixed-size inline array tests (local variables and struct fields)
// =============================================================

struct ArrayHolder
{
    i8 label[8] = default;
    i32 count = 0;
    i8 data[16] = default;
};

// Inline array field of a RETURNED TEMPORARY. The field read is an extractvalue (a register
// with no address), so the subscript spills it to a local before the element GEP - C's rule
// that the returned temp has automatic storage to the end of the full expression. Before the
// spill this shape crashed the compiler, then errored. The 'move' and store forms stay
// rejected (Test/errors/err_move_field_borrowed_param.cb): both act on the shallow spill.
struct TempPack
{
    int vals[4] = default;
    i8 tag[4] = default;
};

TempPack mkTempPack()
{
    TempPack p = default;
    p.vals[0] = 7; p.vals[1] = 11; p.vals[3] = 13;
    p.tag[0] = (i8)'Z';
    return p;
}

// Owning element type: each element of the temporary's array runs its destructor exactly
// once at end of full expression, whether the element is read whole or indexed.
int gTempElemDtors = 0;
struct TempElem { int v = 0; ~TempElem() { gTempElemDtors++; } };
struct TempElemBag { TempElem items[3] = default; };
struct TempElemOne { TempElem item = default; };
TempElemBag mkTempElemBag() { TempElemBag b = default; b.items[1].v = 42; return b; }
TempElemOne mkTempElemOne() { TempElemOne o = default; o.item.v = 7; return o; }

int sumFixedBuf(i8* buf, int len)
{
    int sum = 0;
    int i = 0;
    while (i < len) { sum = sum + buf[i]; i++; }
    return sum;
}

// Plain value struct used by the fixed-array copy legs below (declared here so it
// precedes its first use in testFixedArrays).
struct CopyCell { int x = 0; int y = 0; };

// Global (file-scope) fixed-size arrays. Regression: indexing a global array
// folded the all-zero element GEP (e.g. gFixedArr[0]) back onto the GlobalVariable
// symbol, so the read loaded the whole [N x T] aggregate and module verification
// failed ("return type does not match operand type" / "Invalid bitcast"). Globals
// must index to the element exactly like locals do.
int[81] gFixedArr = default;
int*[3] gPtrArr = default;
// Global brace/positional initializer: lowered to an LLVM constant array.
int[4] gInitArr = {10, 20, 30, 40};
// Partial positional init: trailing slots zero-fill (matches local semantics).
int[4] gPartialArr = {7, 8};
// Empty brace on a primitive element: zero-init, equivalent to = default.
int[3] gEmptyArr = {};
// Global array sized by a named const / const-expr: the size must be folded at
// compile time (a non-literal size used to leave the global malformed and crash).
const int kGRows = 9;
const int kGCols = 9;
int[kGRows * kGCols] gConstExprArr = default;
int[kGRows] gConstNameArr = default;
// '= nullptr' on GLOBAL fixed-array storage zero-fills it, exactly like '= default'.
// The pointer-initializer reject must not swallow a null constant.
int[4] gNullArr = nullptr;
char[8] gNullBuf = nullptr;
char[8] gLiteralBuf = "hello";
using GNullBuf = char[8];
GNullBuf gNullAlias = nullptr;

// '= 0' must zero aggregate storage too, not hit the scalar-into-aggregate reject.
struct ZeroInitPair { int a = default; int b = default; };
struct ZeroInitHolder { int[2] f = default; };

// Union with an ARRAY arm. Writing one ELEMENT of a union's array field targets that
// element's slot; the whole FIELD type must not be used as the store type or the write
// splats the array's full width (and, on an int arm, crashed the compiler).
union ByteInt { char[8] bytes; int[2] words; };
union RowUnion { char[2][8] rows; int tag; };

// An FP global from an INTEGER literal - legal for a local, but the global path asked a
// non-integer type for its bit width and emitted a mismatched initializer (module
// verification failure, no source location).
float gFloatFromInt = 1;
double gDoubleFromInt = 2;

// The two supported stand-ins for a by-value fixed-array return, named by the reject in
// Test/errors/err_fixed_array_byval_return.cb: wrap the array in a struct, or fill a
// caller-owned buffer through a 'T* out' parameter.
struct ArrayRetBox { int[3] v = default; };

ArrayRetBox makeArrayRetBox()
{
    ArrayRetBox b = default;
    b.v[0] = 5; b.v[1] = 6; b.v[2] = 10;
    return b;
}

void fillArrayOut(int* out)
{
    out[0] = 5; out[1] = 6; out[2] = 10;
}

// Element write into a union's array field THROUGH A POINTER: the receiver is still an
// indexed slot, not the whole field.
void pokeByteUnion(ByteInt* u)
{
    u->bytes[3] = (char)67;
}

bool testFixedArrays()
{
    bool result = true;

    // Local fixed-size array: write, read back
    i8[8] buf = default;
    buf[0] = (i8)10; buf[1] = (i8)20; buf[2] = (i8)30;
    result &= Test("fixed_local_elem0", buf[0], 10);
    result &= Test("fixed_local_elem1", buf[1], 20);
    result &= Test("fixed_local_elem2", buf[2], 30);

    // Array decays to pointer when passed to a function
    result &= Test("fixed_local_decay", sumFixedBuf(buf, 3), 60);

    // No ConstArraySize carryover to the next declarator
    int plain = 42;
    result &= Test("fixed_no_carryover", plain, 42);

    // Struct with multiple inline array fields
    ArrayHolder h = default;
    h.label[0] = (i8)'O'; h.label[1] = (i8)'K'; h.label[2] = (i8)0;
    h.count = 7;
    h.data[0] = (i8)1; h.data[1] = (i8)2; h.data[2] = (i8)3;
    result &= Test("fixed_struct_label0", h.label[0], 'O');
    result &= Test("fixed_struct_label1", h.label[1], 'K');
    result &= Test("fixed_struct_count",  h.count, 7);
    result &= Test("fixed_struct_data_sum", sumFixedBuf(h.data, 3), 6);

    // Struct pointer access
    ArrayHolder* ph = &h;
    result &= Test("fixed_struct_ptr_label0", ph->label[0], 'O');
    result &= Test("fixed_struct_ptr_count",  ph->count, 7);

    // Explicit cast of a fixed array decays to a pointer to its first element
    // (regression: the cast path loaded the whole [N x T] aggregate and emitted
    // an aggregate-to-pointer bitcast that failed module verification).
    u8* up = (u8*)buf;
    result &= Test("fixed_cast_decay_elem0", (int)up[0], 10);
    result &= Test("fixed_cast_decay_elem2", (int)up[2], 30);

    // Same decay from a struct's inline array field.
    u8* dp = (u8*)h.data;
    result &= Test("fixed_cast_decay_field", (int)dp[1], 2);

    // Decay also feeds non-pointer casts: the array's address as an integer.
    i64 addr = (i64)buf;
    result &= Test("fixed_cast_decay_to_int", addr != (i64)0, true);

    // sizeof(variable): a fixed array measures its full byte capacity, a scalar
    // measures its declared type (regression: any variable operand used to fail
    // with "unknown type").
    result &= Test("sizeof_fixed_array", (int)sizeof(buf), 8);
    result &= Test("sizeof_fixed_array_type", (int)sizeof(int[2][3]), 24);
    result &= Test("sizeof_scalar_var", (int)sizeof(plain), 4);
    result &= Test("sizeof_struct_var", (int)sizeof(h), (int)sizeof(ArrayHolder));

    // Global (file-scope) fixed array: write then read back a constant index
    // (the all-zero GEP that used to fold onto the GlobalVariable symbol).
    gFixedArr[0] = 11;
    gFixedArr[80] = 22;
    result &= Test("fixed_global_elem0", gFixedArr[0], 11);
    result &= Test("fixed_global_elemN", gFixedArr[80], 22);

    // Global brace/positional initializer: read back the constant elements.
    result &= Test("fixed_global_init0", gInitArr[0], 10);
    result &= Test("fixed_global_init3", gInitArr[3], 40);
    result &= Test("fixed_global_partial_set", gPartialArr[1], 8);
    result &= Test("fixed_global_partial_zerofill", gPartialArr[3], 0);
    result &= Test("fixed_global_empty_zero", gEmptyArr[0], 0);
    result &= Test("fixed_global_literal_first", gLiteralBuf[0], 'h');
    result &= Test("fixed_global_literal_terminator", (int)gLiteralBuf[5], 0);

    // Global array sized by a named const / const-expr: full extent is usable.
    gConstExprArr[80] = 5;   // index 80 only valid if size folded to 9*9 = 81
    gConstNameArr[8]  = 6;   // index 8 only valid if size folded to 9
    result &= Test("fixed_global_constexpr_size", gConstExprArr[80], 5);
    result &= Test("fixed_global_constname_size", gConstNameArr[8], 6);

    // A fixed array of pointer elements retains its element star when auto deduces an
    // array view. The view must read pointer slots, rather than treating them as int slots.
    int pointed = 42;
    int*[2] pointerSlots = default;
    pointerSlots[0] = &pointed;
    auto pointerView = pointerSlots;
    result &= Test("fixed_pointer_element_auto_view", *pointerView[0], 42);

    // Inline array field of a returned temporary: constant index, variable index, and a
    // non-int element type. Each call gets its own spill, so two reads do not alias.
    result &= Test("fixed_temp_field_const_idx", mkTempPack().vals[0], 7);
    result &= Test("fixed_temp_field_last_idx",  mkTempPack().vals[3], 13);
    int ti = 1;
    result &= Test("fixed_temp_field_var_idx",   mkTempPack().vals[ti], 11);
    result &= Test("fixed_temp_field_i8_elem",   (int)mkTempPack().tag[0], 'Z');
    result &= Test("fixed_temp_field_expr",      mkTempPack().vals[0] + mkTempPack().vals[1], 18);

    // Owning element type: the temporary's own destruction runs one dtor per element and is
    // NOT re-run against the spill. Parity with the whole-field read of a one-element struct.
    gTempElemDtors = 0;
    int oneVal = mkTempElemOne().item.v;
    result &= Test("fixed_temp_whole_field_val",  oneVal, 7);
    result &= Test("fixed_temp_whole_field_dtor", gTempElemDtors, 1);
    gTempElemDtors = 0;
    int bagVal = mkTempElemBag().items[1].v;
    result &= Test("fixed_temp_elem_val",  bagVal, 42);
    result &= Test("fixed_temp_elem_dtor", gTempElemDtors, 3);

    // Global fixed array: variable-index write and a loop sum.
    int gi = 0;
    while (gi < 81) { gFixedArr[gi] = gi; gi++; }
    int gsum = 0;
    gi = 0;
    while (gi < 81) { gsum += gFixedArr[gi]; gi++; }
    result &= Test("fixed_global_loop_sum", gsum, 3240);  // 0+1+...+80

    // Global fixed array decays to a pointer (its first element's address).
    // After the loop above, gFixedArr[i] == i.
    int* gp = (int*)gFixedArr;
    result &= Test("fixed_global_decay_elem0", gp[0], 0);
    result &= Test("fixed_global_decay_elem5", gp[5], 5);

    // Global array of pointers (int*[3]): store an address, read through it.
    int gpval = 99;
    gPtrArr[0] = &gpval;
    result &= Test("fixed_global_ptrarr", *gPtrArr[0], 99);

    // 'auto' bound to a fixed array deduces the array VIEW 'T[]' - a borrow, never a
    // copy (auto introduces no new storage). Regression: the binding used to carry no
    // shape at all, so the local was never materialised and 'av[i]' indexed nothing;
    // the array pointer itself was passed on as the value.
    int[3] adSrc = default;
    adSrc[0] = 5; adSrc[1] = 6; adSrc[2] = 7;
    auto av = adSrc;
    result &= Test("auto_fixed_array_index0", av[0], 5);
    result &= Test("auto_fixed_array_index2", av[2], 7);
    // A borrow, so a write through the view is visible in the source array...
    av[1] = 60;
    result &= Test("auto_fixed_array_is_borrow", adSrc[1], 60);
    // ...and a later write to the source is visible through the view.
    adSrc[0] = 50;
    result &= Test("auto_fixed_array_sees_source", av[0], 50);
    // The same deduction from a GLOBAL fixed array (different Storage kind).
    gInitArr[1] = 21;
    auto gav = gInitArr;
    result &= Test("auto_global_fixed_array_index", gav[1], 21);

    // 'T[N] b = a;' IS a copy - the declared type allocates its own storage, so it
    // cannot alias a. Regression: this used to cast the decayed source pointer to the
    // [N x T] aggregate and fail module verification with no source location.
    int[3] cpSrc = default;
    cpSrc[0] = 1; cpSrc[1] = 2; cpSrc[2] = 3;
    int[3] cpDst = cpSrc;
    result &= Test("fixed_copy_elem0", cpDst[0], 1);
    result &= Test("fixed_copy_elem2", cpDst[2], 3);
    // Independence: mutating the source must not disturb the copy.
    cpSrc[0] = 99;
    result &= Test("fixed_copy_is_independent", cpDst[0], 1);
    result &= Test("fixed_copy_source_moved", cpSrc[0], 99);
    // ...and mutating the copy must not disturb the source.
    cpDst[2] = 77;
    result &= Test("fixed_copy_source_untouched", cpSrc[2], 3);

    // Struct element type with no owned resource: the copy is a memcpy of the extent.
    CopyCell[2] scSrc = default;
    scSrc[1].x = 4; scSrc[1].y = 5;
    CopyCell[2] scDst = scSrc;
    scSrc[1].x = 40;
    result &= Test("fixed_copy_struct_elem", scDst[1].x, 4);
    result &= Test("fixed_copy_struct_elem_y", scDst[1].y, 5);

    // Pointer ELEMENT type (int*[2]): a memcpy of addresses. On a fixed array the
    // element's pointer-ness lives on Pointer, not ElemPointer, so reading the wrong
    // flag skipped this shape entirely and it kept failing module verification.
    int pcA = 4; int pcB = 5;
    int*[2] pcSrc = default;
    pcSrc[0] = &pcA; pcSrc[1] = &pcB;
    int*[2] pcDst = pcSrc;
    result &= Test("fixed_copy_ptr_elem0", *pcDst[0], 4);
    result &= Test("fixed_copy_ptr_elem1", *pcDst[1], 5);
    // The copied array holds its own slots: repointing a source slot leaves the copy alone,
    // while the pointee stays shared (a copy of addresses, not of what they address).
    pcSrc[0] = &pcB;
    result &= Test("fixed_copy_ptr_slot_independent", *pcDst[0], 4);
    pcA = 40;
    result &= Test("fixed_copy_ptr_pointee_shared", *pcDst[0], 40);

    // A pointer-element fixed array decays to the matching pointer-element view, not to an
    // `int[]` view that would index the pointer bytes as integers. `auto` has the same shape.
    int*[] pcView = pcSrc;
    auto pcAutoView = pcSrc;
    result &= Test("ptr_element_view_explicit", *pcView[1], 5);
    result &= Test("ptr_element_view_auto", *pcAutoView[0], 5);

    // Multi-dimensional copy: extents must match on every dimension.
    int[2][3] mdSrc = default;
    mdSrc[1][2] = 9;
    int[2][3] mdDst = mdSrc;
    mdSrc[1][2] = 90;
    result &= Test("fixed_copy_multidim", mdDst[1][2], 9);
    // A FULLY SIZED multi-dim declaration stays legal: the reject that bans an empty '[]' among
    // several dimensions ('int[][]', 'int[][3]', 'int[2][]' - see
    // Test/errors/err_multidim_array_view.cb) keys on the bracket count VERSUS the sized-
    // dimension count, so it must not fire here. The tripwire is the `int[2][3]` declarations
    // above, which predate that reject; this line only asserts both survived the copy.
    result &= Test("fixed_multidim_sized_decl", mdDst[1][2] + mdSrc[1][2], 99);
    // ...and the single empty pair, the one bracket form that IS a view, keeps working over a
    // multi-dimensional source. 'int[] v = a' is a FLAT view of the whole allocation (mdSrc is
    // [2][3], so v[4] is mdSrc[1][1]) - that is why 'int[][] v = a' had to be rejected rather
    // than silently kept: it produced this same flat addressing under a 2-D spelling.
    mdSrc[1][1] = 11;
    int[] mdFlat = mdSrc;
    result &= Test("fixed_multidim_flat_view", mdFlat[4], 11);
    // A ROW bind is the supported way to get a per-row view, and it writes through.
    int[] mdRow = mdSrc[1];
    mdRow[2] = 55;
    result &= Test("fixed_multidim_row_view_writes", mdSrc[1][2], 55);

    // The three remedies the fixed-array-storage rejects name. Each is asserted by VALUE
    // so a diagnostic can never recommend something that stopped working:
    //   Test/errors/err_fixed_array_row_assign.cb  -> "bind an array view and write through that"
    //   Test/errors/err_fixed_array_byval_return.cb -> "return a struct" / "take an out-parameter"

    // A view bound to a ROW of a 2-D array borrows that row's storage, so a write
    // through the view lands in the array (the remedy for `b[0] = <row>`).
    int[2][3] rvArr = default;
    rvArr[1][0] = 3;
    int[] rvRow = rvArr[1];
    result &= Test("fixed_row_view_reads", rvRow[0], 3);
    rvRow[2] = 77;
    result &= Test("fixed_row_view_writes_through", rvArr[1][2], 77);
    // Element-wise copy into a row - the other remedy that reject names.
    int[3] rvSrc = default;
    rvSrc[0] = 8; rvSrc[1] = 9; rvSrc[2] = 10;
    int rvI = 0;
    while (rvI < 3) { rvArr[0][rvI] = rvSrc[rvI]; rvI++; }
    result &= Test("fixed_row_elementwise_copy", rvArr[0][1] + rvArr[0][2], 19);

    // Returning a fixed array by value is rejected; a struct WRAPPING one works and
    // carries the elements back by value.
    ArrayRetBox arb = makeArrayRetBox();
    result &= Test("fixed_return_struct_wrapper", arb.v[0] + arb.v[2], 15);
    // ...as does filling a caller-owned buffer through a 'T* out' parameter.
    int[3] outBuf = default;
    fillArrayOut(outBuf);
    result &= Test("fixed_return_out_param", outBuf[0] + outBuf[2], 15);

    // '= nullptr' on fixed-array storage zero-fills it, local and global alike. The
    // pointer-initializer reject keys on a pointer VALUE and must exclude a null constant.
    char[8] nb = nullptr;
    result &= Test("fixed_null_init_local_zero", (int)nb[0], 0);
    nb[0] = (char)65;
    result &= Test("fixed_null_init_local_writable", (int)nb[0], 65);
    int[4] ni = nullptr;
    result &= Test("fixed_null_init_local_int", ni[3], 0);
    result &= Test("fixed_null_init_global_int", gNullArr[2], 0);
    result &= Test("fixed_null_init_global_char", (int)gNullBuf[7], 0);
    result &= Test("fixed_null_init_global_alias", (int)gNullAlias[0], 0);
    gNullArr[1] = 44;
    result &= Test("fixed_null_init_global_writable", gNullArr[1], 44);

    // '= 0' zeroes aggregate storage exactly as '= nullptr' does. The scalar-into-aggregate
    // backstop must carve out a null constant, or the two spellings disagree on one storage.
    char[8] zb = 0;
    result &= Test("fixed_zero_init_local_char", (int)zb[0] + (int)zb[7], 0);
    zb[2] = (char)77;
    result &= Test("fixed_zero_init_local_writable", (int)zb[2], 77);
    int[4] zi = 0;
    result &= Test("fixed_zero_init_local_int", zi[0] + zi[3], 0);
    double[3] zd = 0;
    result &= Test("fixed_zero_init_local_double", (int)zd[1], 0);
    ZeroInitPair zs = 0;
    result &= Test("fixed_zero_init_struct", zs.a + zs.b, 0);
    ZeroInitHolder zh = 0;
    result &= Test("fixed_zero_init_struct_array_field", zh.f[0] + zh.f[1], 0);

    // Element write into a UNION's array field. The whole field type must not be the store
    // type: it wrote the array's full width at the field's base and ignored the index,
    // overrunning the union on the char arm and crashing the compiler on the int arm.
    ByteInt bu = default;
    bu.bytes[0] = (char)65;
    bu.bytes[1] = (char)66;
    result &= Test("union_array_elem0", (int)bu.bytes[0], 65);
    result &= Test("union_array_elem1", (int)bu.bytes[1], 66);
    // The index must be honoured: element 2 was never written, so it stays zero.
    result &= Test("union_array_untouched_slot", (int)bu.bytes[2], 0);
    pokeByteUnion(&bu);
    result &= Test("union_array_elem_via_pointer", (int)bu.bytes[3], 67);
    // The other arm aliases the same bytes: 65 | (66 << 8) reads back as 16961.
    result &= Test("union_array_other_arm_aliases", bu.words[0] & 0xFFFF, 16961);
    // Non-char element arm: an int[N] union field element write (this was the SIGSEGV).
    ByteInt wu = default;
    wu.words[1] = 9;
    result &= Test("union_array_int_elem", wu.words[1], 9);
    result &= Test("union_array_int_slot0_zero", wu.words[0], 0);
    // A 2-D union arm: two subscripts still land on one element.
    RowUnion ru = default;
    ru.rows[1][2] = (char)88;
    result &= Test("union_array_2d_elem", (int)ru.rows[1][2], 88);
    result &= Test("union_array_2d_untouched", (int)ru.rows[0][0], 0);

    // FP global initialized from an integer literal: the value must survive, not just compile.
    result &= Test("global_float_from_int_literal", (int)(gFloatFromInt * 10.0), 10);
    result &= Test("global_double_from_int_literal", (int)(gDoubleFromInt * 10.0), 20);

    return result;
}

// =============================================================
// Multi-dimensional arrays: T[N][M] - covers char, int, float, struct
// =============================================================

struct Cell { int x = 0; int y = 0; };

bool testMultiDimArrays()
{
    bool result = true;

    // --- char[3][5]: 3 rows x 5 cols ---
    char[3][5] cg = default;
    int r = 0;
    while (r < 3)
    {
        int c = 0;
        while (c < 5)
        {
            cg[r][c] = (char)(r * 5 + c);
            c++;
        }
        r++;
    }
    result &= Test("char2d[0][0]", cg[0][0], 0);
    result &= Test("char2d[1][2]", cg[1][2], 7);
    result &= Test("char2d[2][4]", cg[2][4], 14);

    // --- int[4][3]: 4 rows x 3 cols ---
    int[4][3] ig = default;
    r = 0;
    while (r < 4)
    {
        int c = 0;
        while (c < 3)
        {
            ig[r][c] = r * 10 + c;
            c++;
        }
        r++;
    }
    result &= Test("int2d[0][0]",  ig[0][0], 0);
    result &= Test("int2d[3][2]",  ig[3][2], 32);
    // Sum all elements: sum = 0+1+2 + 10+11+12 + 20+21+22 + 30+31+32 = 192
    int sum = 0;
    r = 0;
    while (r < 4)
    {
        int c = 0;
        while (c < 3) { sum += ig[r][c]; c++; }
        r++;
    }
    result &= Test("int2d_sum", sum, 192);

    // --- float[2][2] ---
    float[2][2] fg = default;
    r = 0;
    while (r < 2)
    {
        int c = 0;
        while (c < 2)
        {
            fg[r][c] = (float)(r * 2 + c) + 0.5f;
            c++;
        }
        r++;
    }
    // fg[0][0]=0.5  fg[0][1]=1.5  fg[1][0]=2.5  fg[1][1]=3.5
    result &= Test("float2d[1][1]", (int)(fg[1][1] * 2.0f), 7);  // 3.5 * 2 = 7

    // --- Cell[2][3]: struct element type ---
    Cell[2][3] sg = default;
    r = 0;
    while (r < 2)
    {
        int c = 0;
        while (c < 3)
        {
            sg[r][c].x = r * 3 + c;
            sg[r][c].y = (r * 3 + c) * 2;
            c++;
        }
        r++;
    }
    result &= Test("struct2d[0][0].x", sg[0][0].x, 0);
    result &= Test("struct2d[1][2].x", sg[1][2].x, 5);
    result &= Test("struct2d[1][2].y", sg[1][2].y, 10);

    return result;
}

// =============================================================
// Regression: Bug 1 - cast result chained with -> member access
// CFlat previously required a named variable to hold the cast
// result before accessing a field (e.g. ((Struct*)ptr)->field).
// =============================================================

struct CastMemberPoint { int x = 0; int y = 0; };
interface CastMemberIface { int value(); };
class CastMemberImpl : CastMemberIface { int value() { return 7; } };

bool testCastMemberAccess()
{
    bool result = true;

    CastMemberPoint pt = CastMemberPoint();
    pt.x = 7;
    pt.y = 13;

    void* vp = (void*)&pt;

    // Direct cast-then-arrow without a named intermediate
    int x = ((CastMemberPoint*)vp)->x;
    result &= Test("cast->field x", x, 7);

    // Outer cast applied to a cast->arrow expression
    int y = (int)((CastMemberPoint*)vp)->y;
    result &= Test("(int)(cast->field y)", y, 13);

    CastMemberImpl impl = CastMemberImpl();
    result &= Test("parenthesized as method call", (impl as CastMemberIface).value(), 7);

    return result;
}

// =============================================================
// Regression: Bug 2 - returning int from a bool function
// The compiler previously emitted ret i32 inside an i1 function,
// which fails LLVM module verification. The fix emits ICmpNE to
// convert any nonzero int to true (matching bool assignment semantics).
// =============================================================

int intTwo() { return 2; }

bool boolFromIntReturn()
{
    return intTwo() != 0;
}

bool testReturnBoolFromInt()
{
    bool result = true;

    // intTwo() returns 2; value 2 truncated to i1 is 0 (wrong), ICmpNE gives 1 (right).
    result &= Test("bool from int=2", (int)boolFromIntReturn(), 1);

    return result;
}

// bool is i1 and converts to an integer as exactly 0/1 (zext i1), both
// implicitly in arithmetic and via an explicit cast - and the comparison
// operators yield a normalized 0/1. Branchless code (e.g. counting how many
// sorted keys are <= a probe) relies on this, so lock it down. See the
// "bool in arithmetic" section of doc/LANGUAGE.md.
bool testBoolArithmetic()
{
    bool result = true;

    int a = 5;
    int b = 3;

    // Comparison result used directly in arithmetic - no cast.
    int j = 0;
    j = j + (a >= b);          // true  -> +1
    j = j + (a <  b);          // false -> +0
    result &= Test("bool implicit add 0/1", j, 1);

    // Explicit (int) cast must produce the same 0/1.
    result &= Test("bool cast true ==1",  (int)(a >= b), 1);
    result &= Test("bool cast false==0",  (int)(a <  b), 0);

    // Assigning a bool to an int widens to 0/1.
    bool flag = (a >= b);
    int x = flag;
    result &= Test("int = bool true",  x, 1);
    flag = (a < b);
    x = flag;
    result &= Test("int = bool false", x, 0);

    // Logical operators also yield a normalized 0/1.
    result &= Test("logical && ->1", (int)(true && true),   1);
    result &= Test("logical || ->0", (int)(false || false), 0);
    result &= Test("logical !  ->1", (int)(!false),         1);

    // The branchless-rank idiom: count keys <= probe over a sorted run.
    i64[5] keys = default;
    keys[0] = 10; keys[1] = 20; keys[2] = 30; keys[3] = 40; keys[4] = 50;
    i64 probe = 35;
    int rank = 0;
    int k = 0;
    while (k < 5)
    {
        rank = rank + (probe >= keys[k]);   // +1 for 10,20,30; +0 for 40,50
        k = k + 1;
    }
    result &= Test("branchless rank of 35", rank, 3);

    return result;
}

// `= default`, `= {}`, a bare declaration, and the `new` (heap) forms must all run the default
// constructor, which zero-fills any field that has no declared initializer (no stack/heap garbage)
// while preserving fields that do. Regression for the default-ctor undef-seed bug.
struct DefInitMixed  { int a = 7; int b; int c = 9; int d; };
struct DefInitAllBare { int x; int y; i64 z; void* p; };

bool testStructDefaultZeroFill()
{
    bool result = true;

    DefInitMixed m = default;
    result &= Test("default mixed a", m.a, 7);
    result &= Test("default mixed b", m.b, 0);   // bare field zeroed
    result &= Test("default mixed c", m.c, 9);
    result &= Test("default mixed d", m.d, 0);   // bare field zeroed

    DefInitMixed m2 = {};                         // empty-brace value-init
    result &= Test("brace mixed a", m2.a, 7);
    result &= Test("brace mixed b", m2.b, 0);
    result &= Test("brace mixed c", m2.c, 9);
    result &= Test("brace mixed d", m2.d, 0);

    DefInitAllBare z = default;                   // all fields bare -> fully zeroed
    result &= Test("default allbare x", z.x, 0);
    result &= Test("default allbare y", z.y, 0);
    result &= Test("default allbare z", z.z, (i64)0);
    result &= Test("default allbare p null", z.p == nullptr, true);

    DefInitAllBare bare;                          // bare declaration runs the same ctor
    result &= Test("bare-decl allbare x", bare.x, 0);
    result &= Test("bare-decl allbare p null", bare.p == nullptr, true);

    // `new` (heap): malloc does not zero, so this proves the constructor initializes the fields.
    DefInitAllBare* hz = new DefInitAllBare;
    result &= Test("new allbare x", hz.x, 0);
    result &= Test("new allbare z", hz.z, (i64)0);
    result &= Test("new allbare p null", hz.p == nullptr, true);
    delete hz;

    DefInitMixed* hm = new DefInitMixed();
    result &= Test("new mixed a", hm.a, 7);
    result &= Test("new mixed b", hm.b, 0);
    delete hm;

    DefInitMixed* ha = new DefInitMixed[3];
    bool arrOk = true;
    int i = 0;
    while (i < 3)
    {
        if (ha[i].a != 7 || ha[i].b != 0 || ha[i].c != 9 || ha[i].d != 0) arrOk = false;
        i = i + 1;
    }
    result &= Test("new mixed[3] value-init", arrOk, true);
    delete ha;

    return result;
}

namespace NamespaceStaticChecks
{
    struct Utility { static int add(int x) { return x + 1; } int value = 8; };
    using LocalInt = int;
    using LocalUtility = Utility;

    int run()
    {
        LocalInt x = 2;
        LocalUtility u = default;
        return Utility.add(x) + u.value;
    }
}

using PointerAlias = int*;
using PointerAliasChain = PointerAlias;
using PointerAliasDepth = PointerAlias*;

bool testAliasAndStaticResolution()
{
    PointerAliasChain p = nullptr;
    PointerAliasDepth pp = nullptr;
    NamespaceStaticChecks.LocalInt q = 4;
    bool result = NamespaceStaticChecks.run() == 11;
    result &= Test("qualified_namespace_alias", q, 4);
    result &= Test("namespace_static_qualified", NamespaceStaticChecks.Utility.add(10), 11);
    result &= Test("pointer_alias_chain", (p == nullptr && pp == nullptr) ? 1 : 0, 1);
    return result;
}

