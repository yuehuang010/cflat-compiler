struct R3GlobalTypeBox<T> { T value = default; };
struct R3InnerGlobalValue { int X = 10; };
struct R3RootGlobalValue { int X = 90; };
R3RootGlobalValue R3RootHead;
namespace R3Holder { R3InnerGlobalValue B; int r3InnerGlobalVariableVsNamespacePick() { return B.X; } }
namespace A
{
    class R3InterfaceImpl : B.I { int local() { return 10; } };
    int r3QualifiedInterfacePick() { unique B.I value = new R3InterfaceImpl(); return value.local(); }
    int r3QualifiedGenericFunctionPick() { return B.r3p<int>(1) + B.r3p(2); }
    int r3GlobalTypePositions()
    {
        global::B.L direct = default;
        R3GlobalTypeBox<global::B.L> boxed = default;
        boxed.value = global::B.L();
        return direct.pick() + boxed.value.pick() + global::B.L().pick();
    }
    int r4GlobalNew()
    {
        global::B.L* p = new global::B.L();
        int value = p->pick();
        delete p;
        return value;
    }
    int r4GlobalNewAuto()
    {
        auto p = new global::B.L();
        return p.pick();
    }
    int r4GlobalCast()
    {
        global::B.L value = default;
        void* erased = &value;
        global::B.L* p = (global::B.L*)erased;
        return p->pick();
    }
    int r4GlobalSizeof() { return (int)sizeof(global::B.L); }
    int r4GlobalArraySizeof() { return (int)sizeof(global::B.L[3]); }
    int r4GlobalAlignof() { return (int)alignof(global::B.L); }
    namespace R3RootHead { int X = 70; }
    int r3RootGlobalVariableVsNamespacePick() { return R3RootHead.X; }
    namespace R3ImportAlias { int Test(const char* name, int actual, int expected) { return 100; } }
    int r3ImportAliasVsNamespacePick() { return R3ImportAlias.Test("r3", 1, 1); }
}
namespace QualifiedSibling { int qualifiedFallbackPick() { B.Late value; return value.pick(); } }
int qualifiedTuplePick() {
    (A.B.Late, int) value = A.qualifiedTupleValue();
    return value.item_0.pick() + value.item_1;
}

namespace QualifiedFallback
{
    namespace Local
    {
        struct Late { int pick() { return 8; } };
        enum Tone : int { High = 3 };
        struct Box<T> { T item = default; };
        int read() { return 2; }
    }
    (Local.Late, int) pair() { Local.Late value; return (value, 1); }
    int run() {
        Local.Late direct;
        Local.Box<Local.Late> boxed;
        (Local.Late, int) value = pair();
        return direct.pick() + boxed.item.pick() + value.item_0.pick() + value.item_1
            + Local.Tone.High + Local.read();
    }
}

bool testNamespaceTypeShadowing()
{
    bool result = true;
    result &= Test("ns_type_inner_shadows_outer", ScopeOuter.Inner.innerShadow(), 3);
    result &= Test("ns_type_qualified_bypasses_shadow", ScopeOuter.Inner.qualifiedBypass(), 34);
    result &= Test("ns_type_funcptr_pointee_visible", ScopeOuter.Inner.runShadow(ScopeOuter.Inner.fillShadow), 13);
    result &= Test("ns_alias_from_nested_namespace", ScopeOuter.Inner.Deep.aliasFromNested(), 11);
    result &= Test("ns_type_bare_from_nested", ScopeOuter.Inner.Deep.bareFromNested(), 10);
    result &= Test("ns_alias_reaches_generic_base", ShadowOther2.aliasedGenericBase(), 9);
    result &= Test("ns_alias_reaches_plain_struct", ShadowOther2.aliasedPlainStruct(), 7);
    result &= Test("ns_real_namespace_outranks_alias", shadowRealNamespaceOutranksAlias(), 1);
    result &= Test("qualified_type_inner_scope_wins", A.qualifiedLocalPick(), 10);
    result &= Test("qualified_type_parameter_return_inner_scope_wins", A.qualifiedParameterReturnPick(), 10);
    result &= Test("qualified_type_tuple_inner_scope_wins", qualifiedTuplePick(), 14);
    result &= Test("qualified_type_generic_arg_inner_scope_wins", A.qualifiedGenericPick(), 10);
    result &= Test("qualified_type_field_inner_scope_wins", A.qualifiedFieldPick(), 10);
    result &= Test("qualified_type_nested_scope_innermost_wins", A.Inner.qualifiedNestedScopePick(), 5);
    result &= Test("qualified_type_parent_scope_fallback", A.C.qualifiedParentScopePick(), 10);
    result &= Test("qualified_function_inner_scope_wins", A.qualifiedFunctionPick(), 10);
    result &= Test("qualified_global_inner_scope_wins", A.qualifiedGlobalPick(), 10);
    result &= Test("qualified_enum_inner_scope_wins", A.qualifiedEnumPick(), 10);
    result &= Test("qualified_enum_generic_arg_scanned_scope_wins", QualifiedLookupEnumA.enumGenericPick(), 10);
    result &= Test("qualified_global_escape_keeps_root", A.qualifiedRootPick(), 90);
    result &= Test("qualified_type_sibling_fallback_pick", QualifiedSibling.qualifiedFallbackPick(), 20);
    result &= Test("qualified_type_enclosing_fallbacks", QualifiedFallback.run(), 30);
    result &= Test("qualified_interface_inner_scope_wins", A.r3QualifiedInterfacePick(), 10);
    result &= Test("qualified_generic_function_inner_scope_wins",
        A.r3QualifiedGenericFunctionPick(), 20);
    result &= Test("qualified_global_type_positions_escape_shadow",
        A.r3GlobalTypePositions(), 60);
    result &= Test("qualified_global_new_type_escapes_shadow", A.r4GlobalNew(), 20);
    result &= Test("qualified_global_new_auto_type_escapes_shadow", A.r4GlobalNewAuto(), 20);
    result &= Test("qualified_global_cast_type_escapes_shadow", A.r4GlobalCast(), 20);
    result &= Test("qualified_global_sizeof_type_escapes_shadow", A.r4GlobalSizeof(), 8);
    result &= Test("qualified_global_sizeof_array_type_escapes_shadow",
        A.r4GlobalArraySizeof(), 24);
    result &= Test("qualified_global_alignof_type_escapes_shadow", A.r4GlobalAlignof(), 4);
    result &= Test("qualified_first_global_variable_scope_order",
        R3Holder.r3InnerGlobalVariableVsNamespacePick() * 100
            + A.r3RootGlobalVariableVsNamespacePick(), 1070);
    result &= Test("qualified_namespace_outranks_import_alias",
        A.r3ImportAliasVsNamespacePick(), 100);
    return result;
}

bool testLocalUsingScoped()
{
    // 'M' from testLocalUsing is not visible here; only 'Math' global alias is.
