    struct P {
        struct Mid { int value = 2; };
        struct G<T> { int read() { Mid value = default; return value.value; } };
        struct Q { struct G<T> { int read() { Mid value = default; return value.value; } }; };
    };
    struct S {
        int read() { P.G<int> value = default; return value.read(); }
        int generic<U>(U unused) { P.G<int> value = default; return value.read(); }
