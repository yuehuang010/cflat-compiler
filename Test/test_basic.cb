bool testT379LocalEnums()
{
    bool result = true;
    T379IssueCtor issueCtor = T379IssueCtor();
    { T379IssueDtor issueDtor = default; }
    result &= Test("t379_ctor_dtor_enum_scope", issueCtor.r + t379IssueDtorValue, 7);

    T379CtorA ctorA = T379CtorA();
    T379CtorB ctorB = T379CtorB();
    result &= Test("t379_ctor_ctor_enum_scope", ctorA.value + ctorB.value, 7);

    {
        T379DtorA dtorA = default;
        T379DtorB dtorB = default;
    }
    result &= Test("t379_dtor_dtor_enum_scope", t379DtorSum, 7);

    T379CtorFunction ctorFunction = T379CtorFunction();
    result &= Test("t379_ctor_function_enum_scope", ctorFunction.value + t379OrdinaryEnum(), 7);

    T379Box<int> boxInt = T379Box<int>();
    T379Box<long> boxLong = T379Box<long>();
    result &= Test("t379_generic_ctor_enum_scope", boxInt.value + boxLong.value,
        6 + (int)sizeof(int) + (int)sizeof(long));

    T379LambdaCtor lambdaCtor = T379LambdaCtor();
    result &= Test("t379_ctor_lambda_enum_scope", lambdaCtor.value, 7);

    T379MethodCtor methodCtor = T379MethodCtor();
    result &= Test("t379_ctor_method_enum_scope", methodCtor.value + methodCtor.f(), 7);

    T379FileShadowCtor fileShadowCtor = T379FileShadowCtor();
    result &= Test("t379_ctor_shadows_file_enum", fileShadowCtor.value + (int)T379FileEnum.A, 8);

    {
        T379ProgramDtorCtor programDtorCtor = T379ProgramDtorCtor();
        T379EnumProgram programDtor = default;
    }
    result &= Test("t379_program_dtor_enum_scope", t379ProgramDtorValue, 7);

    return result;
}

