    string actual = "old"; actual = (string)castSource;
    return Test("strcast param assignment cast value and ownership",
                strcastSameStringResult(&plain, &actual), true) != 0;
}
bool strcastParamAssignFunctional(string plainSource, string castSource)
{
    string plain = "old"; plain = plainSource;
    string actual = "old"; actual = string(castSource);
    return Test("strcast param assignment functional value and ownership",
                strcastSameStringResult(&plain, &actual), true) != 0;
}
bool strcastParamCallCast(string plainSource, string castSource)
{
    int plain = strcastIdentityRoute(plainSource);
    int actual = strcastIdentityRoute((string)castSource);
    return (Test("strcast param plain call overload", plain, 101) != 0)
        && (Test("strcast param call cast overload", actual, 101) != 0);
}
bool strcastParamCallFunctional(string plainSource, string castSource)
{
    int plain = strcastIdentityRoute(plainSource);
    int actual = strcastIdentityRoute(string(castSource));
    return (Test("strcast param plain functional overload", plain, 101) != 0)
        && (Test("strcast param call functional overload", actual, 101) != 0);
}

