{
    union U
    {
        int i = 9;
        int get() { return i + 10; }
        int get(int add) { return i + add; }
    } u = default;
};

int unionAnonPick(int value) { return 10; }
int unionAnonPick(float value) { return 20; }

bool testUnion()
{
    bool result = true;

    UnionUserAnon0Before userAnonBefore;
    userAnonBefore.i = 3;
    result &= Test("union user __anon0 before anonymous member",
        userAnonBefore.__anon0 * 10 + userAnonBefore.i, 73);
    UnionUserAnon0After userAnonAfter;
    userAnonAfter.i = 5;
    result &= Test("union user __anon0 after anonymous member",
        userAnonAfter.__anon0 * 10 + userAnonAfter.i, 95);
    UnionUserInline0Type userInlineType;
    userInlineType.i = 3;
    result &= Test("union user __inline0 nested type remains distinct",
        userInlineType.n.q * 100 + userInlineType.i, 103);
    UnionInlineNestedScope inlineScope;
    inlineScope.inn.d.x = 4;
    result &= Test("union named inline aggregate nested type scope",
        inlineScope.inn.d.x, 4);

    UnionAcceptDirectDefault acceptDirect;
    result &= Test("union accept one direct DMI", acceptDirect.a, 9);
    UnionAcceptInlineManyDefaults acceptInlineMany;
    result &= Test("union accept multiple defaults in one inline member",
        acceptInlineMany.a * 100 + acceptInlineMany.b, 506);
    UnionAcceptInlineAndDefaulted acceptInlineDefaulted;
    result &= Test("union accept inline DMI beside default keyword",
        acceptInlineDefaulted.a, 5);
    UnionAcceptDefaultKeywords acceptDefaultKeywords;
    result &= Test("union accept default keywords in inline members",
        acceptDefaultKeywords.a, 0);
    UnionAcceptDirectAndPlainInline acceptDirectPlainInline;
    result &= Test("union accept direct DMI beside plain inline member",
        acceptDirectPlainInline.a, 9);
    UnionAcceptInlineAndPlainDirect acceptInlinePlainDirect;
    result &= Test("union accept inline DMI beside plain direct member",
        acceptInlinePlainDirect.a, 5);
    UnionAcceptNamedInlineNestedDmi acceptNamedInlineNested;
    result &= Test("union accept named inline type with nested DMI",
        acceptNamedInlineNested.b, 2);
    UnionSelectNestedDefault selectNestedDefault;
    result &= Test("union selects inline arm with nested DMI", selectNestedDefault.b, 5);
    result &= Test("global union selects inline arm with nested DMI",
        unionSelectNestedDefaultGlobal.b, 5);
    result &= Test("global union double DMI active value", unionResDoubleGlobal.d == 1.5, true);
    result &= Test("global union double DMI preserves union bits", unionResDoubleGlobal.q,
        (i64)0x3ff8000000000000);
    result &= Test("global union float DMI active value", unionResFloatGlobal.f, 1.5f);
    result &= Test("global union float DMI preserves union bits", unionResFloatGlobal.q,
        (i64)0x3fc00000);
    result &= Test("global union integer DMI double value",
        unionResIntDoubleGlobal.d == 1.0, true);
    result &= Test("global union integer DMI double bits", unionResIntDoubleGlobal.q,
        (i64)0x3ff0000000000000);
    result &= Test("global union integer DMI float value", unionResIntFloatGlobal.f, 2.0f);
    result &= Test("global union float DMI widens to double",
        unionResFloatDoubleGlobal.d == 1.5, true);
    result &= Test("global union float DMI widened bits", unionResFloatDoubleGlobal.q,
        (i64)0x3ff8000000000000);
    result &= Test("global union double DMI narrows to float", unionResDoubleFloatGlobal.f, 2.5f);
    result &= Test("global named union field double DMI",
        unionResNamedDoubleGlobal.inner.d == 1.5, true);
    result &= Test("global named union field preserves bits", unionResNamedDoubleGlobal.inner.q,
        (i64)0x3ff8000000000000);
    result &= Test("global anonymous union field double DMI", unionResAnonDoubleGlobal.d == 1.5, true);
    result &= Test("global anonymous union field preserves bits", unionResAnonDoubleGlobal.q,
        (i64)0x3ff8000000000000);
    result &= Test("global nested union double DMI",
        unionResNestedDoubleGlobal.inner.d == 1.5, true);
    result &= Test("global nested union preserves bits", unionResNestedDoubleGlobal.inner.q,
        (i64)0x3ff8000000000000);
    result &= Test("global union nested struct DMI lo", unionResPairGlobal.pair.lo, 17);
    result &= Test("global union nested struct DMI hi", unionResPairGlobal.pair.hi, 29);
    result &= Test("global union nested struct DMI bytes", unionResPairGlobal.raw,
        (i64)0x0000001d00000011);

    UnionResIntArrayArm unionResR2AnonArray = default;
    unionResR2AnonArray.arr[0] = 41; unionResR2AnonArray.arr[1] = 42;
    result &= Test("union array arm dereference anonymous", *unionResR2AnonArray.arr, 41);
    result &= Test("union array arm neighbor anonymous", unionResR2AnonArray.arr[1], 42);
    UnionResNamedIntArrayArm unionResR2NamedArray = default;
    unionResR2NamedArray.arr[0] = 51; unionResR2NamedArray.arr[1] = 52;
    result &= Test("union array arm dereference named", *unionResR2NamedArray.arr, 51);
    result &= Test("union array arm neighbor named", unionResR2NamedArray.arr[1], 52);
    UnionResCharArrayArm unionResR2CharArray = default;
    unionResR2CharArray.bytes[0] = 'h'; unionResR2CharArray.bytes[1] = 'i';
    result &= Test("union char array arm dereference", *unionResR2CharArray.bytes, 'h');
    result &= Test("union char array arm neighbor", unionResR2CharArray.bytes[1], 'i');
    int[3] unionResR2PointerArrayValues = {13, 24, 35};
    UnionResIntPointerArrayArm unionResR2PointerArray = default;
    unionResR2PointerArray.ps[0] = &unionResR2PointerArrayValues[0];
    unionResR2PointerArray.ps[1] = &unionResR2PointerArrayValues[1];
    result &= Test("union pointer array arm double dereference", **unionResR2PointerArray.ps, 13);
    result &= Test("union pointer array arm second element", *unionResR2PointerArray.ps[1], 24);
    unionResGlobalIntArray.arr[0] = 61; unionResGlobalIntArray.arr[1] = 62;
    unionResGlobalNamedIntArray.arr[0] = 71; unionResGlobalNamedIntArray.arr[1] = 72;
    unionResGlobalIntArrayHolder.inner.arr[0] = 81;
    result &= Test("global union array arm dereference", *unionResGlobalIntArray.arr, 61);
    result &= Test("global union array arm neighbor", unionResGlobalIntArray.arr[1], 62);
    result &= Test("global named union array arm dereference", *unionResGlobalNamedIntArray.arr, 71);
    result &= Test("global field union array arm dereference",
        *unionResGlobalIntArrayHolder.inner.arr, 81);

    int[2] unionResLocalInts = {31, 42};
    UnionResIntPointer unionResLocalIntPointer = default;
    unionResLocalIntPointer.p = &unionResLocalInts[0];
    result &= Test("union selects inline arm pointer dereference local", *unionResLocalIntPointer.p, 31);
    (*unionResLocalIntPointer.p)++;
    result &= Test("union inline pointer pointee increment local", unionResLocalInts[0], 32);
    *unionResLocalIntPointer.p += 2;
    result &= Test("union inline pointer pointee compound local", unionResLocalInts[0], 34);
    result &= Test("union inline pointer index local", unionResLocalIntPointer.p[1], 42);

    int[3] unionResR2StoreValues = {10, 20, 30};
    UnionResIntPointer unionResR2StorePointer = default;
    unionResR2StorePointer.p = &unionResR2StoreValues[0];
    *unionResR2StorePointer.p = 5;
    result &= Test("union dereference store pointee", unionResR2StoreValues[0], 5);
    result &= Test("union dereference store neighbor", unionResR2StoreValues[1], 20);
    *unionResR2StorePointer.p *= 3;
    result &= Test("union dereference multiply compound", unionResR2StoreValues[0], 15);
    result &= Test("union dereference multiply neighbor", unionResR2StoreValues[1], 20);
    *unionResR2StorePointer.p /= 3;
    result &= Test("union dereference divide compound", unionResR2StoreValues[0], 5);
    result &= Test("union dereference divide neighbor", unionResR2StoreValues[1], 20);
    *unionResR2StorePointer.p %= 4;
    result &= Test("union dereference modulo compound", unionResR2StoreValues[0], 1);
    result &= Test("union dereference modulo neighbor", unionResR2StoreValues[1], 20);

    int[3] unionResR2IndexValues = {10, 20, 30};
    UnionResIntPointer unionResR2IndexPointer = default;
    unionResR2IndexPointer.p = &unionResR2IndexValues[0];
    unionResR2IndexPointer.p[1] = 5;
    result &= Test("union pointer index store neighbor zero", unionResR2IndexValues[0], 10);
    result &= Test("union pointer index store target", unionResR2IndexValues[1], 5);
    result &= Test("union pointer index store neighbor two", unionResR2IndexValues[2], 30);
    unionResR2IndexPointer.p[1] *= 2;
    result &= Test("union pointer index compound target", unionResR2IndexValues[1], 10);
    result &= Test("union pointer index compound neighbor", unionResR2IndexValues[2], 30);

    int[2] unionResGlobalInts = {51, 62};
    unionResGlobalIntPointer.p = &unionResGlobalInts[0];
    result &= Test("union inline pointer dereference global", *unionResGlobalIntPointer.p, 51);
    (*unionResGlobalIntPointer.p)++;
    *unionResGlobalIntPointer.p += 2;
    result &= Test("union inline pointer update global", unionResGlobalInts[0], 54);

    int[2] unionResFieldInts = {71, 82};
    unionResGlobalIntHolder.inner.p = &unionResFieldInts[0];
    result &= Test("union inline pointer dereference field of global", *unionResGlobalIntHolder.inner.p, 71);
    (*unionResGlobalIntHolder.inner.p)++;
    *unionResGlobalIntHolder.inner.p += 2;
    result &= Test("union inline pointer update field of global", unionResFieldInts[0], 74);

    char[3] unionResChars = "ab";
    unionResGlobalCharPointer.p = &unionResChars[0];
    result &= Test("union char pointer dereference global", *unionResGlobalCharPointer.p == 'a', true);
    (*unionResGlobalCharPointer.p)++;
    *unionResGlobalCharPointer.p += 1;
    result &= Test("union char pointer update global", unionResChars[0] == 'c', true);

    UnionResNode[2] unionResNodes = default;
    unionResNodes[0].v = 91;
    unionResNodes[1].v = 92;
    unionResGlobalNodePointer.p = &unionResNodes[0];
    result &= Test("union struct pointer dereference field of global", (*unionResGlobalNodePointer.p).v, 91);
    result &= Test("union struct pointer arrow field of global", unionResGlobalNodePointer.p->v, 91);
    (*unionResGlobalNodePointer.p).v++;
    (*unionResGlobalNodePointer.p).v += 2;
    result &= Test("union struct pointer pointee update field of global", unionResNodes[0].v, 94);
    result &= Test("union struct pointer index field of global", unionResGlobalNodePointer.p[1].v, 92);

    UnionAnonDefault unionAnonLocal;
    UnionAnonDefault unionAnonBraced = {};
    UnionAnonDefault unionAnonExplicitDefault = default;
    UnionAnonDefault* unionAnonHeap = new UnionAnonDefault();
    result &= Test("anonymous inline default global b", unionAnonGlobal.b, 5);
    result &= Test("anonymous inline default global c", unionAnonGlobal.c, 6);
    result &= Test("anonymous inline default local", unionAnonLocal.b, 5);
    result &= Test("anonymous inline default brace", unionAnonBraced.c, 6);
    result &= Test("anonymous inline default keyword", unionAnonExplicitDefault.b, 5);
    result &= Test("anonymous inline default new", unionAnonHeap.c, 6);
    delete unionAnonHeap;

    UnionR4ScopeK scopeK = default;
    result &= Test("owner nested type default in named aggregate field", scopeK.inn.x.m, 1);
    UnionR4ScopeM scopeM = default;
    result &= Test("owner nested type shadows global in named field", scopeM.inn.x.m, 1);
    UnionR4ShadowScope shadowScope = default;
    result &= Test("nested type wins inside named field", shadowScope.inn.d.z, 4);
    result &= Test("global type remains visible outside named field", shadowScope.e.z, 9);
    UnionR4NamedNestedDefault namedNestedDefault = default;
    result &= Test("named nested type default is not union arm default",
        (int)(namedNestedDefault.f * 10.0), 20);

    result &= Test("anonymous inline field of field global", unionAnonNestedGlobal.inner.b, 5);
    UnionAnonFieldOfField unionAnonNestedLocal = default;
    result &= Test("anonymous inline field of field local", unionAnonNestedLocal.inner.c, 6);
    UnionAnonNamedStructDefault unionAnonNamedStructLocal = default;
    UnionAnonNamedStructDefault* unionAnonNamedStructHeap = new UnionAnonNamedStructDefault();
    result &= Test("anonymous inline named struct global", unionAnonNamedStructGlobal.value.b, 17);
    result &= Test("anonymous inline named struct local", unionAnonNamedStructLocal.value.c, 18);
    result &= Test("anonymous inline named struct new", unionAnonNamedStructHeap.value.b, 17);
    delete unionAnonNamedStructHeap;
    UnionAnonTaggedStructDefault unionAnonTaggedStructLocal = default;
    result &= Test("anonymous inline tagged struct global", unionAnonTaggedStructGlobal.value.b, 19);
    result &= Test("anonymous inline tagged struct local", unionAnonTaggedStructLocal.value.c, 20);
    UnionAnonNamedDefault unionAnonNamed;
    result &= Test("anonymous inline named field default", unionAnonNamed.u.i, 7);
    UnionAnonNamedDefault* unionAnonNamedHeap = new UnionAnonNamedDefault();
    result &= Test("anonymous inline named field global", unionAnonNamedGlobal.u.i, 7);
    result &= Test("anonymous inline named field new", unionAnonNamedHeap.u.i, 7);
    delete unionAnonNamedHeap;
    UnionAnonTaggedDefault unionAnonTagged;
    result &= Test("anonymous inline tagged field default", unionAnonTagged.u.i, 9);
    UnionAnonTaggedDefault* unionAnonTaggedHeap = new UnionAnonTaggedDefault();
    result &= Test("anonymous inline tagged field global", unionAnonTaggedGlobal.u.i, 9);
    result &= Test("anonymous inline tagged field new", unionAnonTaggedHeap.u.i, 9);
    delete unionAnonTaggedHeap;
    UnionAnonFirstDefault unionAnonFirst = default;
    result &= Test("anonymous inline union first member global", unionAnonFirstGlobal.first, 13);
    result &= Test("anonymous inline union first member default", unionAnonFirst.first, 13);
    UnionTaggedMethodField unionTaggedMethod = default;
    result &= Test("tagged inline aggregate method zero arg overload",
        unionTaggedMethod.u.get(), 19);
    result &= Test("tagged inline aggregate method one arg overload",
        unionTaggedMethod.u.get(2), 11);
    UnionAnonReservedName unionAnonReserved = default;
    result &= Test("user __anonx field stays directly named",
        unionAnonReserved.__anonx.z, 3);
    expect_error("Unknown identifier 'z'") {
        int unionAnonReservedPromoted = unionAnonReserved.z;
    }

    UnionIntFloat u;
    u.i = 42;
    result &= Test("union write/read int", u.i, 42);

    u.i = 0;
    result &= Test("union zero int", u.i, 0);

    u.f = 1.5f;
    result &= Test("union write/read float", u.f, 1.5f);

    result &= Test("sizeof union == sizeof largest", (int)sizeof(UnionIntFloat), 4);

    ContainerWithUnion c;
    c.data.i = 99;
    c.tag = 1;
    result &= Test("union as struct field", c.data.i, 99);
    result &= Test("struct field tag intact", c.tag, 1);

    UnionByteView bv;
    bv.value = 0x000000FF;
    result &= Test("union aliasing low byte", bv.byte0, -1);

    // Union with struct members: write and read sub-fields
    UnionWithStructs s;
    s.pt.x = 10;
    s.pt.y = 20;
    result &= Test("union struct member write/read x", s.pt.x, 10);
    result &= Test("union struct member write/read y", s.pt.y, 20);

    s.col.r = 255;
    s.col.g = 128;
    result &= Test("union struct member aliasing", s.col.r, 255);

    // Write via pointer
    UnionWithStructs s2;
    writeUnionStructViaPtr(&s2, 42, 99);
    result &= Test("union struct member write via ptr x", s2.pt.x, 42);
    result &= Test("union struct member write via ptr y", s2.pt.y, 99);

    // No arm is implicitly destroyed, regardless of its index or the union's containment.
    unionDtorCount = 0;
    { UnionOwnerFirst u = default; u.o.tag = 7; }
    result &= Test("union raw first arm not destroyed", unionDtorCount, 0);
    unionDtorCount = 0;
    { UnionOwnerSecond u = default; u.o.tag = 7; }
    result &= Test("union raw second arm not destroyed", unionDtorCount, 0);
    unionDtorCount = 0;
    { UnionOwnerHolder h = default; h.u.o.tag = 3; }
    result &= Test("union raw nested arm not destroyed", unionDtorCount, 0);
    unionDtorCount = 0;
    { UnionOwnerFirst[3] a = default; a[0].o.tag = 1; }
    result &= Test("union raw array arms not destroyed", unionDtorCount, 0);
    unionDtorCount = 0;
    { UnionOwnerFirst u = makeUnionOwner(); u.o.tag = 5; }
    result &= Test("union raw returned arm not destroyed", unionDtorCount, 0);
    unionNodeDtors = 0;
    { UnionRawUnique u = default; u.b.p = new UnionDtorNode(); }
    result &= Test("union raw unique not destroyed", unionNodeDtors, 0);
    unionManualDtors = 0;
    { UnionManualDtor u = default; u.i = 1; }
    result &= Test("union explicit destructor runs", unionManualDtors, 1);
    unionNodeDtors = 0;
    { UnionManualUnique u = default; u.b.p = new UnionDtorNode(); }
    result &= Test("union explicit destructor releases unique", unionNodeDtors, 1);

    UnionAnonV av = { .tag = 1, .i = 42 };
    UnionAnonV* avp = &av;
    result &= Test("anon union designated tag", av.tag, 1);
    result &= Test("anon union designated i", av.i, 42);
    result &= Test("anon union pointer arrow", avp->i, 42);
    result &= Test("anon union int overload", unionAnonPick(av.i), 10);
    UnionAnonLookup lookup;
    lookup.unionAnonPick = 17;
    result &= Test("anonymous field before same-named function", unionAnonPick(lookup.unionAnonPick), 10);
    av.f = 1.5f;
    result &= Test("anon union float overload", unionAnonPick(av.f), 20);
    result &= Test("anon union V size", sizeof(UnionAnonV), (u64)8);
    result &= Test("anon union V align", alignof(UnionAnonV), (u64)4);
    result &= Test("anon union V offset tag", offsetof(UnionAnonV, tag), (u64)0);
    result &= Test("anon union V offset i", offsetof(UnionAnonV, i), (u64)4);
    result &= Test("anon union V offset f", offsetof(UnionAnonV, f), (u64)4);

    UnionAnonNestedStruct ans;
    ans.lo = 3;
    ans.hi = 7;
    result &= Test("nested anon struct lo", ans.lo, 3);
    result &= Test("nested anon struct hi", ans.hi, 7);
    result &= Test("nested anon struct overload", unionAnonPick(ans.hi), 10);
    result &= Test("nested anon struct size", sizeof(UnionAnonNestedStruct), (u64)8);
    result &= Test("nested anon struct align", alignof(UnionAnonNestedStruct), (u64)8);
    result &= Test("nested anon struct offset lo", offsetof(UnionAnonNestedStruct, lo), (u64)0);
    result &= Test("nested anon struct offset hi", offsetof(UnionAnonNestedStruct, hi), (u64)4);
    result &= Test("nested anon struct offset d", offsetof(UnionAnonNestedStruct, d), (u64)0);

    UnionAnonNestedUnion anu;
    anu.i = 8;
    anu.tail = 9;
    result &= Test("nested anon union i", anu.i, 8);
    result &= Test("nested anon union tail", anu.tail, 9);
    result &= Test("nested anon union size", sizeof(UnionAnonNestedUnion), (u64)8);
    result &= Test("nested anon union align", alignof(UnionAnonNestedUnion), (u64)4);
    result &= Test("nested anon union offset i", offsetof(UnionAnonNestedUnion, i), (u64)0);
    result &= Test("nested anon union offset f", offsetof(UnionAnonNestedUnion, f), (u64)0);
    result &= Test("nested anon union offset tail", offsetof(UnionAnonNestedUnion, tail), (u64)4);

    UnionAnonW aw;
    aw.lo = 3;
    aw.hi = 4;
    result &= Test("anon struct in union lo", aw.lo, 3);
    result &= Test("anon struct in union hi", aw.hi, 4);
    result &= Test("anon struct in union overload", unionAnonPick(aw.hi), 10);
    result &= Test("anon struct union size", sizeof(UnionAnonW), (u64)8);
    result &= Test("anon struct union align", alignof(UnionAnonW), (u64)8);
    result &= Test("anon struct union offset lo", offsetof(UnionAnonW, lo), (u64)0);
    result &= Test("anon struct union offset hi", offsetof(UnionAnonW, hi), (u64)4);
    result &= Test("anon struct union offset all", offsetof(UnionAnonW, all), (u64)0);

    UnionAnonNamedField anf;
    anf.u.i = 11;
    result &= Test("anonymous type named field", anf.u.i, 11);
    result &= Test("anonymous named field size", sizeof(UnionAnonNamedField), (u64)4);
    result &= Test("anonymous named field align", alignof(UnionAnonNamedField), (u64)4);
    result &= Test("anonymous named field offset u", offsetof(UnionAnonNamedField, u), (u64)0);
    result &= Test("anonymous named field offset u.i", offsetof(UnionAnonNamedField, u.i), (u64)0);
    result &= Test("anonymous named field offset u.f", offsetof(UnionAnonNamedField, u.f), (u64)0);

    UnionAnonNamedTypeField ant;
    ant.u.f = 1.5f;
    result &= Test("nested union type named field", ant.u.f, 1.5f);
    result &= Test("nested union type size", sizeof(UnionAnonNamedTypeField), (u64)4);
    result &= Test("nested union type align", alignof(UnionAnonNamedTypeField), (u64)4);
    result &= Test("nested union type offset u", offsetof(UnionAnonNamedTypeField, u), (u64)0);
    result &= Test("nested union type offset u.i", offsetof(UnionAnonNamedTypeField, u.i), (u64)0);
    result &= Test("nested union type offset u.f", offsetof(UnionAnonNamedTypeField, u.f), (u64)0);

    UnionAnonO ao;
    ao.i = 12;
    result &= Test("anonymous union inside union", ao.i, 12);
    result &= Test("anonymous union outer size", sizeof(UnionAnonO), (u64)8);
    result &= Test("anonymous union outer align", alignof(UnionAnonO), (u64)8);
    result &= Test("anonymous union outer offset i", offsetof(UnionAnonO, i), (u64)0);
    result &= Test("anonymous union outer offset f", offsetof(UnionAnonO, f), (u64)0);
    result &= Test("anonymous union outer offset all", offsetof(UnionAnonO, all), (u64)0);

    UnionAnonClass akc;
    akc.i = 13;
    result &= Test("class anonymous union member", akc.i, 13);
    result &= Test("class anonymous union size", sizeof(UnionAnonClass), (u64)8);
    result &= Test("class anonymous union align", alignof(UnionAnonClass), (u64)4);
    result &= Test("class anonymous union offset tag", offsetof(UnionAnonClass, tag), (u64)0);
    result &= Test("class anonymous union offset i", offsetof(UnionAnonClass, i), (u64)4);
    result &= Test("class anonymous union offset f", offsetof(UnionAnonClass, f), (u64)4);

    UnionAnonForward af;
    af.value = 6;
    result &= Test("forward method sees anonymous field", af.read(), 6);

    return result;
}

// =============================================================
// break / continue tests
// =============================================================

bool testBreakContinue()
{
    bool result = true;

    // --- while: break exits on sentinel ---
    int i = 0;
    while (i < 100)
    {
        if (i == 5) break;
        i++;
    }
    result &= Test("while break at 5", i, 5);

    // --- while: continue skips iterations ---
    int sum = 0;
    int k = 0;
    while (k < 6)
    {
        k++;
        if (k % 2 == 0) continue;
        sum += k;   // sum odd numbers 1+3+5 = 9
    }
    result &= Test("while continue odd sum", sum, 9);

    // --- for: break exits early ---
    int found = -1;
    for (int j = 0; j < 10; j++)
    {
        if (j == 7) { found = j; break; }
    }
    result &= Test("for break at 7", found, 7);

    // --- for: continue skips body ---
    int evenSum = 0;
    for (int n = 0; n < 10; n++)
    {
        if (n % 2 != 0) continue;
        evenSum += n;   // 0+2+4+6+8 = 20
    }
    result &= Test("for continue even sum", evenSum, 20);

    // --- for-in (range-based): break and continue ---
    // IntRange is a minimal collection supporting for (int v in r) syntax.
    IntRange r;
    r.lo = 0; r.hi = 10;   // values 0..9

    int firstOver5 = -1;
    for (int v in r)
    {
        if (v > 5) { firstOver5 = v; break; }
    }
    result &= Test("for-in break first>5", firstOver5, 6);

    int oddSum = 0;
    for (int v in r)
    {
        if (v % 2 == 0) continue;
        oddSum += v;    // 1+3+5+7+9 = 25
    }
    result &= Test("for-in continue odd sum", oddSum, 25);

    return result;
}

// =============================================================
// do-while loop tests
// Regression: do-while was compiled as while (condition first),
// so the body never executed when the condition was initially false.
// =============================================================

bool testDoWhile()
{
    bool result = true;

    // Body must execute once even when condition is false from the start.
    int counter = 0;
    do {
        counter++;
    } while (false);
    result &= Test("dowhile_runs_once_cond_false", counter, 1);

    // Body must execute once when condition is true, then exit.
    int count2 = 0;
    do {
        count2++;
    } while (count2 < 1);
    result &= Test("dowhile_exits_after_first_true", count2, 1);

    // Standard multi-iteration pattern: count to 5.
    int n = 0;
    do {
        n++;
    } while (n < 5);
    result &= Test("dowhile_multi_iter", n, 5);

    // Body executes at least once even when counter starts at limit.
    int m = 10;
    do {
        m++;
    } while (m < 10);
    result &= Test("dowhile_body_before_cond", m, 11);

    // Accumulate inside the body; condition references accumulated value.
    int sum = 0;
    int idx = 1;
    do {
        sum += idx;
        idx++;
    } while (idx <= 5);
    result &= Test("dowhile_sum_1_to_5", sum, 15);

    return result;
}

// =============================================================
// while(true) fall-through tests
// Regression: a `while (true)` loop with no `break` can only be left
// via a `return` inside the body, so the function never falls through.
// Control-flow analysis used to only check whether the final insert
// block was terminated; the loop's (dead) resume block was the insert
// point with no terminator, so the compiler wrongly reported a missing
// return and the code only compiled with a dead trailing `return`.
// These functions intentionally have NO return after the loop - if they
// compile and run, the fix holds.
// =============================================================

// No trailing return - the body always returns once i reaches n.
int wtrPick(int n)
{
    int i = 0;
    while (true)
    {
        if (i >= n)
            return i;
        i = i + 1;
    }
}

// while(1) (constant non-zero, not just the literal `true`) behaves the same.
int wtrFirstHit(int start)
{
    int x = start;
    while (1)
    {
        if (x % 7 == 0)
            return x;
        x = x + 1;
    }
}

// A `break` keeps the exit reachable, so a real return after the loop is
// still required (and used) - this must compile and run normally.
int wtrCountUpTo(int n)
{
    int i = 0;
    while (true)
    {
        if (i >= n)
            break;
        i = i + 1;
    }
    return i;
}

bool testWhileTrueReturn()
{
    bool result = true;
    result &= Test("wtr_pick_returns_from_body", wtrPick(3), 3);
    result &= Test("wtr_while1_first_multiple_of_7", wtrFirstHit(10), 14);  // 10..14 -> 14
    result &= Test("wtr_break_then_return", wtrCountUpTo(5), 5);
    return result;
}

// =============================================================
// && short-circuit in loop body tests
// Regression: when the left operand of && was false inside a while
// loop body, the IR branched to the loop-exit block instead of
// continuing the current iteration.
// =============================================================

bool testAndShortCircuit()
{
    bool result = true;

    // Loop must run all 5 iterations; match_count accumulates only when
    // both operands of && are true (n == 2 and n == 4).
    int n = 0;
    int iters = 0;
    int matches = 0;
    while (n < 5)
    {
        bool a = (n == 2 || n == 4);
        bool match = a && true;
        if (match) matches++;
        iters++;
        n++;
    }
    result &= Test("and_loop_all_iters",    iters,   5);
    result &= Test("and_loop_match_count",  matches, 2);

    // && with a false constant: short-circuit must not exit the loop.
    int count = 0;
    int i = 0;
    while (i < 4)
    {
        bool always_false = false && true;
        if (always_false) count = -1;  // must never execute
        i++;
    }
    result &= Test("and_false_const_iters",    i,     4);
    result &= Test("and_false_const_no_match", count, 0);

    // && result used in an if: false branch continues normally.
    int trueBranches = 0;
    int totalIters = 0;
    int j = 0;
    while (j < 6)
    {
        bool flag = (j % 2 == 0) && (j > 0);  // true only for 2, 4
        if (flag) trueBranches++;
        totalIters++;
        j++;
    }
    result &= Test("and_if_result_total_iters", totalIters,   6);
    result &= Test("and_if_result_true_count",  trueBranches, 2);

    // Chained &&: a && b && c - false on first two operands must not exit loop.
    int hits = 0;
    int k = 0;
    while (k < 5)
    {
        bool val = (k == 3) && true && true;
        if (val) hits++;
        k++;
    }
    result &= Test("and_chain_iters",  k,    5);
    result &= Test("and_chain_hits",   hits, 1);

    return result;
}

// =============================================================
// sizeof / alignof intrinsics
// =============================================================

struct SizeofPoint      { int x = default; int y = default; };
struct SizeofComplex    { char a = default; int b = default; double c = default; SizeofPoint p = default; };
struct SizeofEmpty      { };
struct SizeofSingle     { i64 value = default; };
struct SizeofPtrFields  { int* ptr = nullptr; char* str_ptr = nullptr; };
struct SizeofNested     { SizeofPoint outer = default; SizeofComplex inner = default; };
struct SizeofUnder      { int x = default; int y = default; };
struct SizeofDunder     { void* a = nullptr; void* b = nullptr; };
struct SizeofFuncField  { function<int(void*)> fn = nullptr; void* ctx = nullptr; };

bool testSizeof()
{
    bool r = true;

    // Primitive sizes
    if (sizeof(int)    != 4) r = false;
    if (sizeof(char)   != 1) r = false;
    if (sizeof(double) != 8) r = false;
    if (sizeof(bool)   != 1) r = false;
    if (sizeof(i8)     != 1) r = false;
    if (sizeof(i16)    != 2) r = false;
    if (sizeof(i32)    != 4) r = false;
    if (sizeof(i64)    != 8) r = false;
    if (sizeof(u8)     != 1) r = false;
    if (sizeof(u16)    != 2) r = false;
    if (sizeof(u32)    != 4) r = false;
    if (sizeof(u64)    != 8) r = false;
    if (sizeof(float)  != 4) r = false;

    // Pointer sizes
    if const (__PLATFORM__ == 64) {
        if (sizeof(int*)    != 8) r = false;
        if (sizeof(char*)   != 8) r = false;
        if (sizeof(double*) != 8) r = false;
    } else {
        if (sizeof(int*)    != 4) r = false;
        if (sizeof(char*)   != 4) r = false;
        if (sizeof(double*) != 4) r = false;
    }

    // Struct sizes
    if (sizeof(SizeofPoint)  != 8) r = false;
    if (sizeof(SizeofSingle) != 8) r = false;
    if const (__PLATFORM__ == 64) {
        if (sizeof(SizeofPtrFields) != 16) r = false;
    } else {
        if (sizeof(SizeofPtrFields) != 8)  r = false;
    }

    // alignof must return positive
    if (alignof(int)    <= 0) r = false;
    if (alignof(char)   <= 0) r = false;
    if (alignof(double) <= 0) r = false;
    if (alignof(i64)    <= 0) r = false;
    if (alignof(SizeofPoint) <= 0) r = false;

    // Pointer type sizeof/alignof
    if const (__PLATFORM__ == 64) {
        if (sizeof(SizeofPoint*)  != 8) r = false;
        if (alignof(SizeofPoint*) != 8) r = false;
    } else {
        if (sizeof(SizeofPoint*)  != 4) r = false;
        if (alignof(SizeofPoint*) != 4) r = false;
    }

    // Arithmetic on results
    i64 total3 = sizeof(int) + sizeof(char) + sizeof(double);
    if (total3 != (4 + 1 + 8)) r = false;
    if (sizeof(i64) < sizeof(int)) r = false;

    // Underscore struct names
    if (sizeof(SizeofUnder) != 8) r = false;
    if const (__PLATFORM__ == 64) {
        if (sizeof(SizeofDunder) != 16) r = false;
    } else {
        if (sizeof(SizeofDunder) != 8)  r = false;
    }

    // Struct with thin function<T> field: bare C fn ptr + void* = 16 on x64, 8 on x86
    if const (__PLATFORM__ == 64) {
        if (sizeof(SizeofFuncField) != 16) r = false;
    } else {
        if (sizeof(SizeofFuncField) != 8) r = false;
    }

    return r;
}

// =============================================================
// Field initializer syntax and struct-inline fixed arrays
// =============================================================

struct FieldInitPoint  { int x = 0; int y = 0; };
struct FieldInitPerson { int age = 0; int score = 0; };

int sumFieldInitPoint(FieldInitPoint p = { x=1, y=2 }) { return p.x + p.y; }

bool testFieldInit()
{
    bool result = true;

    FieldInitPoint p = { x=10, y=20 };
    result &= Test("field_init_xy",   p.x + p.y, 30);

    // Bare-brace spelling (no '=') is grammatically distinct - initDecl carries
    // its own LeftBrace/initializerList instead of routing through initializer()
    // - and used to silently discard the field overrides (both x and y stayed 0,
    // matching the '= default' value, on both PRE and an earlier round of this
    // fix that only handled the '=' spelling). Assert both fields to prove the
    // bare form now reaches the same field-init path as '= { x=.., y=.. }'.
    FieldInitPoint r { x=100, y=200 };
    result &= Test("field_init_bare_brace_x", r.x, 100);
    result &= Test("field_init_bare_brace_y", r.y, 200);

    FieldInitPoint q = { x=5 };
    result &= Test("field_init_partial", q.x, 5);
    result &= Test("field_init_default", q.y, 0);

    FieldInitPerson person = { age=30, score=100, };
    result &= Test("field_init_person_age",   person.age,   30);
    result &= Test("field_init_person_score", person.score, 100);

    FieldInitPoint* hp = new FieldInitPoint { x=7, y=8 };
    result &= Test("field_init_heap_x", hp->x, 7);
    result &= Test("field_init_heap_y", hp->y, 8);
    delete hp;

    result &= Test("field_init_default_param",  sumFieldInitPoint(), 3);
    result &= Test("field_init_positional_arg",  sumFieldInitPoint({ x=3, y=4 }), 7);
    result &= Test("field_init_named_arg",       sumFieldInitPoint(p: { x=5, y=6 }), 11);

    return result;
}

struct FieldInitPacket { char data[64]; int length = 0; };

// Type-first inline array field (u8[8]) - distinct from the C-style suffix form
// above. The size lives on the declaration specifier, not the declarator; the
// field-decl path used to drop it, collapsing the array and undersizing the
// struct (sizeof was 8 instead of 16, element writes past [0] hit garbage).
struct InlineArrField { u32 a = 0; u8[8] b = default; };
struct InlineArr2D     { int[2][3] grid = default; };

bool testStructInlineArrays()
{
    bool result = true;

    char[8] buf;
    buf[0] = (char)10; buf[1] = (char)20; buf[2] = (char)30;
    result &= Test("inline_arr_sum", buf[0] + buf[1] + buf[2], 60);

    FieldInitPacket pkt;
    pkt.data[0] = (char)'H';
    pkt.data[1] = (char)'i';
    pkt.data[2] = (char)0;
    pkt.length = 2;
    result &= Test("struct_arr_elem0", pkt.data[0], 'H');
    result &= Test("struct_arr_elem1", pkt.data[1], 'i');

    FieldInitPoint[3] pts;
    pts[0].x = 1; pts[1].x = 2; pts[2].x = 3;
    result &= Test("struct_arr_sum", pts[0].x + pts[1].x + pts[2].x, 6);

    // Type-first array field: full 8 bytes inline (u32 + 8*u8 = 12, align 4).
    result &= Test("typefirst_arr_sizeof", (int)sizeof(InlineArrField), 12);
    InlineArrField iaf = default;
    iaf.b[0] = (u8)11; iaf.b[7] = (u8)77;
    result &= Test("typefirst_arr_elem0", (int)iaf.b[0], 11);
    result &= Test("typefirst_arr_elem7", (int)iaf.b[7], 77);
    result &= Test("typefirst_arr_default_mid", (int)iaf.b[3], 0);

    // Multi-dimensional type-first array field.
    result &= Test("typefirst_2d_sizeof", (int)sizeof(InlineArr2D), 24);
    InlineArr2D g2 = default;
    g2.grid[0][0] = 5; g2.grid[1][2] = 9;
    result &= Test("typefirst_2d_elem00", g2.grid[0][0], 5);
    result &= Test("typefirst_2d_elem12", g2.grid[1][2], 9);

    return result;
}

bool testPointerArrays()
{
    bool result = true;

    function<win_usize((const char)*)> t449Strlen = strlen;
    result &= Test("t449 strlen size_t signature and value", (i64)t449Strlen("abc"), (i64)3);

    (const char)*[3] words;
    words[0] = "alpha";
    words[1] = "beta";
    words[2] = "gamma";

    result &= Test("ptr_arr_strlen0", strlen(words[0]), 5);
    result &= Test("ptr_arr_strlen1", strlen(words[1]), 4);
    result &= Test("ptr_arr_strlen2", strlen(words[2]), 5);

    int i = 0;
    int total_len = 0;
    while (i < 3) { total_len = total_len + strlen(words[i]); i++; }
    result &= Test("ptr_arr_total", total_len, 14);

    return result;
}

// =============================================================
// Array value-init: T[N] name {} and T[N] name {field=v,...}
// =============================================================

struct ArrayInitCounter {
    int count = 0;
    int step  = 1;

    ArrayInitCounter() {
        count = 100;
        step  = 5;
    }
};

bool testArrayDefaultInit()
{
    bool result = true;

    ArrayInitCounter[3] ctrs {};
    result &= Test("arr_init_0_count", ctrs[0].count, 100);
    result &= Test("arr_init_0_step",  ctrs[0].step,  5);
    result &= Test("arr_init_1_count", ctrs[1].count, 100);
    result &= Test("arr_init_2_count", ctrs[2].count, 100);

    return result;
}

bool testArrayFieldInit()
{
    bool result = true;

    ArrayInitCounter[2] seeded {count=42, step=7};
    result &= Test("arr_seed_0_count", seeded[0].count, 42);
    result &= Test("arr_seed_0_step",  seeded[0].step,  7);
    result &= Test("arr_seed_1_count", seeded[1].count, 42);
    result &= Test("arr_seed_1_step",  seeded[1].step,  7);

    return result;
}

// =============================================================
// Interface nullptr comparison tests
// =============================================================

interface ICounter
{
    int count();
};

class SimpleCounter : ICounter
{
    int n = default;
    int count() { return n; }
};

bool checkIfaceNull(ICounter c)
{
    return c == nullptr;
}

bool checkIfaceNotNull(ICounter c)
{
    return c != nullptr;
}

bool testInterfaceNullCheck()
{
    bool result = true;

    // Null fat-ptr compares equal to nullptr
    ICounter empty = nullptr;
    result &= Test("iface_null_eq",    empty == nullptr, true);
    result &= Test("iface_null_ne",    empty != nullptr, false);

    // Non-null fat-ptr compares not-equal to nullptr
    SimpleCounter* sc = new SimpleCounter();
    sc.n = 5;
    ICounter live = sc;
    result &= Test("iface_nonnull_ne", live != nullptr,  true);
    result &= Test("iface_nonnull_eq", live == nullptr,  false);

    // Reassign to nullptr clears the fat-ptr. 'live' now owns the boxed object (boxing a heap
    // pointer into an interface moves ownership; interface locals are not auto-destructed), so
    // delete through 'live' before clearing it - 'delete sc' after the move is a no-op and leaks.
    delete live;
    live = nullptr;
    result &= Test("iface_reassign_null", live == nullptr, true);

    // Pass interface variable as interface parameter
    ICounter nullIface = nullptr;
    result &= Test("iface_param_null",    checkIfaceNull(nullIface),    true);
    result &= Test("iface_param_nonnull", checkIfaceNotNull(nullIface), false);

    return result;
}

// =============================================================
// alignas tests
// =============================================================

struct alignas(64) AlignCL { int x = 0; };
class alignas(32) AlignPaddedPair { int a = 0; int b = 0; };
struct AlignPlain { int v = 0; };

alignas(64) i64 g_align_counter = 0;
alignas(64) AlignCL g_align_cl = default;

// Over-alignment carried by the TYPE is recoverable from the static type at every free
// site, so it survives escaping into a struct field - the destructor's `delete` routes to
// the aligned deallocator just as the `new` routed to the aligned allocator. This is the
// supported way to own an over-aligned buffer in a struct. (A per-site
// `new T[n] alignas(N)` cannot escape: see Test/errors/err_aligned_new_escape.cb.)
struct alignas(64) AlignChunk { double a = 0.0; double b = 0.0; };

struct ChunkHolder
{
    AlignChunk[] buf = default;
    ~ChunkHolder() { delete[_] buf; }   // aligned free, recovered from AlignChunk
};

struct PlainChunk { double a = 0.0; double b = 0.0; };

struct PlainHolder
{
    PlainChunk[] buf = default;
    ~PlainHolder() { delete[_] buf; }   // ordinary free
};

// A `move` param owns the block and frees it at scope exit; the alignment must be
// recovered from the element type there too, or an aligned block goes to plain free.
void consumeChunks(move AlignChunk* p) { }

// `alignas(slot, alloc)` arg2 (the allocation-alignment clause): a struct can OWN a flat,
// over-aligned raw `double[]`. arg2 records the BLOCK alignment on the field so the destructor's
// `delete[_]` recovers it and takes the aligned deallocator. A bare `new` on the RHS INHERITS the
// field's clause (inbound channel); an explicit `new ... alignas(0, N)` must agree (checked at the store).
struct FlatMatrix
{
    alignas(0, 64) double[] data = default;
    ~FlatMatrix() { delete[_] data; }
};

// The same clause on a `move` parameter: the callee owns the flat over-aligned block and
// frees it at scope exit via the aligned route, recovered from the parameter's clause.
void consumeFlat(move alignas(0, 64) double[] buf) { }

// The clause on a SCALAR pointer field: it records the block alignment so the synthesized `unique`
// free routes to __delete_aligned. Both inbound channels must reach it - a direct `new`, and an
// align-declared local stored indirectly. A plain-`new` local is rejected at the store
// (Test/errors/err_align_alloc_indirect_store.cb): its block has no aligned header.
struct AlignedRes { i64 v = 0; };
struct ResHolder  { alignas(0, 64) unique AlignedRes* p = nullptr; };
alignas(0, 64) unique AlignedRes* g_aligned_res = nullptr;

// Alignment carried by the pointee TYPE needs no field clause: `new` and `delete` both pick the
// aligned pair off the static type, so it escapes into a field freely, as in C++.
struct alignas(64) WideRes { i64 v = 0; };
struct WideHolder { unique WideRes* w = nullptr; };

// A clause WITHOUT `unique` on a scalar pointer field is now REJECTED at declaration: the clause
// selects the aligned deallocator for a hand-managed pointer whose block may be a plain `new`, which
// would corrupt the heap. See Test/errors/err_alignas_alloc_requires_unique.cb.

// RETURN escape: a function whose RETURN TYPE declares `alignas(0, 64)` hands back a 64-aligned
// heap block. A bare `new` in the return inherits the alignment (inbound channel); the caller's
// receiving local is stamped so `delete[_]` routes to __delete_aligned.
alignas(0, 64) move double[] makeAlignedFlat(int n)
{
    return new double[n];
}

// `alignas(N)` on a MEMBER: the member's slot is padded to its boundary and the containing
// type's alignment (and padded sizeof) rise to match - C/C++ semantics. The layout carries
// synthetic `__padN` slots that must stay invisible to field access, brace-init and dtors.
struct AlignMember  { int a = 0; alignas(64) int b = 0; };            // 4 + pad(60) + 4 + tail(60)
struct alignas(128) AlignBoth { int a = 0; alignas(64) int b = 0; };  // member 64, type 128
struct AlignFirst   { alignas(16) int a = 0; int b = 0; };            // no pad needed, align 16
class  AlignMemberCls { int a = 0; alignas(32) int b = 0; };

// A padded field list must not disturb a destructor or the memberwise copy: the string
// field still deep-copies and frees, and the pad slots are skipped by both.
struct AlignDtorHolder
{
    string tag = default;
    alignas(64) int hot = 0;
    int cold = 0;
    ~AlignDtorHolder() { }
};

// An over-aligned struct used BY VALUE as a field keeps its alignment (the alignment is a
// property of the type), so the field's slot is padded to 64 too.
struct AlignNested { int x = 0; AlignCL cl = default; };

// Union members all start at offset 0, so an `alignas` member cannot be padded - it just
// raises the union's own alignment (and its size, which stays a multiple of that).
union AlignUnionMember { int i = default; alignas(64) char c = default; };
union alignas(32) AlignUnionType { int i = default; short s = default; };
union PlainUnion { int i = default; double d = default; };

bool testAlignas()
{
    bool result = true;

    result &= Test("sizeof(AlignCL)==64",         (int)sizeof(AlignCL),         64);
    result &= Test("alignof(AlignCL)==64",        (int)alignof(AlignCL),        64);
    result &= Test("sizeof(AlignPaddedPair)==32",  (int)sizeof(AlignPaddedPair), 32);
    result &= Test("alignof(AlignPaddedPair)==32", (int)alignof(AlignPaddedPair),32);
    result &= Test("sizeof(AlignPlain)==4",        (int)sizeof(AlignPlain),      4);
    result &= Test("alignof(AlignPlain)==4",       (int)alignof(AlignPlain),     4);

    AlignCL local_cl;
    AlignPaddedPair local_pp;
    alignas(32) int local_int = 0;
    result &= Test("local AlignCL addr%64",    (int)(((i64)&local_cl)  & 63), 0);
    result &= Test("local AlignPaddedPair%32", (int)(((i64)&local_pp)  & 31), 0);
    result &= Test("local alignas(32) int%32", (int)(((i64)&local_int) & 31), 0);

    result &= Test("global alignas(64) i64%64", (int)(((i64)&g_align_counter) & 63), 0);
    result &= Test("global AlignCL%64",         (int)(((i64)&g_align_cl)      & 63), 0);

    AlignCL[4] arr;
    result &= Test("AlignCL[4] stride==64",   (int)(((i64)&arr[1]) - ((i64)&arr[0])), 64);
    result &= Test("AlignCL[4] base%64",      (int)(((i64)&arr[0]) & 63), 0);
    result &= Test("AlignCL[4] arr[2]%64",    (int)(((i64)&arr[2]) & 63), 0);

    AlignCL* p = new AlignCL;
    result &= Test("new AlignCL%64", (int)(((i64)p) & 63), 0);
    delete p;

    // Per-allocation alignment: `new T[n] alignas(N)`. Allocation property only -
    // does not change sizeof. Base address must honor the requested alignment.
    int an = 100;
    double[] abuf = new double[an] alignas(64);
    result &= Test("new double[n] alignas(64) base%64", (int)(((i64)&abuf[0]) & 63), 0);
    abuf[0]  = 1.5;
    abuf[99] = 2.5;
    result &= Test("aligned buf read lo", abuf[0]  == 1.5, true);
    result &= Test("aligned buf read hi", abuf[99] == 2.5, true);
    delete[_] abuf;   // explicit aligned free (delete path)

    // Page-aligned buffer, freed by scope-exit auto-free (aligned cleanup path).
    double[] pbuf = new double[an] alignas(4096);
    result &= Test("new double[n] alignas(4096) base%4096", (int)(((i64)&pbuf[0]) & 4095), 0);
    pbuf[0] = 3.5;
    result &= Test("page-aligned buf read", pbuf[0] == 3.5, true);

    // Type-level over-alignment ESCAPING into a struct field: `new AlignChunk[n]` takes the
    // aligned allocator, and the destructor's `delete` recovers alignof(AlignChunk) from the
    // static type and takes the aligned deallocator. Interleaved with an ordinary-element
    // holder so BOTH free routes churn the same heap - a mis-routed free corrupts it within
    // a few rounds. (Before the fix, the `move` param below took the ordinary free path.)
    int    fieldMisaligned = 0;
    double fieldSum        = 0.0;
    for (int i = 0; i < 64; i = i + 1)
    {
        ChunkHolder ch;
        ch.buf = new AlignChunk[8];
        if ((((i64)&ch.buf[0]) & 63) != 0) fieldMisaligned = fieldMisaligned + 1;
        ch.buf[7].a = 7.5;
        fieldSum = fieldSum + ch.buf[7].a;

        PlainHolder ph;
        ph.buf = new PlainChunk[8];
        ph.buf[0].a = 0.5;
        fieldSum = fieldSum + ph.buf[0].a;

        consumeChunks(new AlignChunk[4]);   // callee owns it; freed at ITS scope exit
    }
    result &= Test("alignas(64) elem in field: base%64 over 64 rounds", fieldMisaligned, 0);
    result &= Test("aligned+plain field churn sum",                    fieldSum == 512.0, true);

    // `alignas(0, N)` clause: own a FLAT over-aligned `double[]` in a field, and hand one to a
    // `move` param. The block must be 64-aligned and freed through the aligned route (recovered
    // from the field/param clause, not the element type). Churned so a mis-routed free corrupts.
    int    flatMisaligned = 0;
    double flatSum        = 0.0;
    for (int i = 0; i < 64; i = i + 1)
    {
        FlatMatrix fm;
        fm.data = new double[16];   // bare new INHERITS the field's clause (inbound channel)
        if ((((i64)&fm.data[0]) & 63) != 0) flatMisaligned = flatMisaligned + 1;
        fm.data[15] = 3.5;
        flatSum = flatSum + fm.data[15];

        consumeFlat(new double[8] alignas(0, 64));  // call-arg is indirect: clause must be explicit

        // RETURN escape: a BARE caller local is auto-stamped from the return type's clause, so it
        // frees via the aligned route with no annotation of its own.
        double[] ret = makeAlignedFlat(4);
        if ((((i64)&ret[0]) & 63) != 0) flatMisaligned = flatMisaligned + 1;
        ret[3] = 1.0;
        flatSum = flatSum + ret[3];
        delete[_] ret;   // routes to __delete_aligned via the return-stamped alignment
    }
    result &= Test("alignas(0,64) flat double[] field base%64 over 64 rounds", flatMisaligned, 0);
    result &= Test("alignas(0,64) field churn sum",                            flatSum == 288.0, true);

    g_aligned_res = new AlignedRes();
    result &= Test("alignas(0,64) global unique base%64", (int)(((i64)g_aligned_res.get()) & 63), 0);
    g_aligned_res = nullptr;

    // The clause on a scalar `unique T*` field desugars to core `unique<T, 64>`, whose destructor
    // routes aligned blocks to __delete_aligned. Churned so a mis-routed free corrupts the heap.
    // Guards the store check against OVER-rejecting the three shapes that must stay legal: a
    // direct `new`, a null release, and an indirect store whose source agrees with the field.
    int scalarMisaligned = 0;
    for (int i = 0; i < 16; i = i + 1)
    {
        ResHolder rh = default;
        rh.p = new AlignedRes();            // direct: the bare `new` inherits the field's clause
        if ((((i64)rh.p.get()) & 63) != 0) scalarMisaligned = scalarMisaligned + 1;
        rh.p = nullptr;                     // sanctioned release: frees it, must stay legal
        alignas(0, 64) AlignedRes* src = new AlignedRes();
        rh.p = src;                         // indirect: the source carries the matching clause
        if ((((i64)rh.p.get()) & 63) != 0) scalarMisaligned = scalarMisaligned + 1;

        // Alignment from the TYPE alone: no clause anywhere, indirect store, still 64-aligned
        // and still freed through the aligned route (recovered from the static type).
        WideHolder wh = default;
        WideRes* wsrc = new WideRes();
        wh.w = wsrc;
        if ((((i64)wh.w.get()) & 63) != 0) scalarMisaligned = scalarMisaligned + 1;
    }
    result &= Test("alignas(0,64) scalar unique field base%64 over 16 rounds", scalarMisaligned, 0);

    // A clause on a NON-`unique` scalar pointer field is a compile error now
    // (Test/errors/err_alignas_alloc_requires_unique.cb), so there is no positive case here.

    // Per-site `new T[n] alignas(N)` stays owned by its local: move between locals keeps the
    // tag, so the extracted local still frees through the aligned route.
    double[] src = new double[32] alignas(64);
    double[] moved = move src;
    result &= Test("move of alignas(64) local base%64", (int)(((i64)&moved[0]) & 63), 0);
    moved[0] = 9.5;
    result &= Test("moved aligned buf read", moved[0] == 9.5, true);
    delete[_] moved;

    // Regression (sticky tag): an aligned allocation whose result is not consumed by a local
    // declaration must not leave its alignment behind on the compiler's pending-allocation
    // slot, or the NEXT owning declaration - an ordinary block - inherits it and is freed
    // through the aligned route. Here the aligned buffer is consumed by a call argument.
    ChunkHolder sc;
    sc.buf = new AlignChunk[4];            // aligned; must not leak the tag forward
    double[] plainSrc = new double[8];
    double[] ordinary = move plainSrc;     // ordinary block; must NOT inherit an aligned tag
    ordinary[0] = 4.5;
    result &= Test("ordinary move-out after aligned allocation", ordinary[0] == 4.5, true);
    delete[_] ordinary;

    // -- alignas on a MEMBER (was silently ignored: no pad, no raised alignment) --------
    result &= Test("sizeof(AlignMember)==128",  (int)sizeof(AlignMember),  128);
    result &= Test("alignof(AlignMember)==64",  (int)alignof(AlignMember), 64);

    AlignMember am;
    am.a = 1;
    am.b = 2;
    result &= Test("member alignas: offset b==64", (int)(((i64)&am.b) - ((i64)&am.a)), 64);
    result &= Test("member alignas: &am%64",       (int)(((i64)&am) & 63), 0);
    result &= Test("member alignas: a readback",   am.a, 1);
    result &= Test("member alignas: b readback",   am.b, 2);

    // Member alignas combined with a stricter TYPE-level alignas: the type wins for the
    // whole struct, the member clause still places the member.
    result &= Test("sizeof(AlignBoth)==128",  (int)sizeof(AlignBoth),  128);
    result &= Test("alignof(AlignBoth)==128", (int)alignof(AlignBoth), 128);
    AlignBoth ab;
    result &= Test("AlignBoth: offset b==64", (int)(((i64)&ab.b) - ((i64)&ab.a)), 64);
    result &= Test("AlignBoth: &ab%128",      (int)(((i64)&ab) & 127), 0);

    // alignas on the FIRST member: already on its boundary (no pad), but the struct's own
    // alignment and padded size still rise to it.
    result &= Test("sizeof(AlignFirst)==16",  (int)sizeof(AlignFirst),  16);
    result &= Test("alignof(AlignFirst)==16", (int)alignof(AlignFirst), 16);
    AlignFirst af;
    result &= Test("AlignFirst: offset b==4", (int)(((i64)&af.b) - ((i64)&af.a)), 4);

    // Same on a class.
    result &= Test("sizeof(AlignMemberCls)==64",  (int)sizeof(AlignMemberCls),  64);
    result &= Test("alignof(AlignMemberCls)==32", (int)alignof(AlignMemberCls), 32);

    // Heap: `new` must route through the aligned allocator for a member-over-aligned type.
    AlignMember* hm = new AlignMember();
    result &= Test("new AlignMember%64", (int)(((i64)hm) & 63), 0);
    hm.b = 9;
    result &= Test("new AlignMember b readback", hm.b, 9);
    delete hm;

    // Padding must not break named brace-init, the memberwise copy, or a destructor: the
    // string field is still deep-copied/freed across the pad slots.
    AlignDtorHolder adh = { tag = "cache-line", hot = 7, cold = 8 };
    result &= Test("padded brace-init: hot",  adh.hot,  7);
    result &= Test("padded brace-init: cold", adh.cold, 8);
    result &= Test("padded brace-init: tag",  adh.tag == "cache-line", true);
    result &= Test("padded: offset hot==64",  (int)(((i64)&adh.hot) - ((i64)&adh.tag)), 64);
    AlignDtorHolder adhCopy = adh.copy();
    result &= Test("padded copy: tag",  adhCopy.tag == "cache-line", true);
    result &= Test("padded copy: hot",  adhCopy.hot, 7);

    // An over-aligned struct TYPE used as a by-value field keeps its alignment.
    result &= Test("alignof(AlignNested)==64", (int)alignof(AlignNested), 64);
    AlignNested an2;
    result &= Test("AlignNested: offset cl==64", (int)(((i64)&an2.cl) - ((i64)&an2.x)), 64);

    // Arrays of a member-over-aligned type stride by the padded size.
    AlignMember[3] amArr;
    result &= Test("AlignMember[3] stride==128", (int)(((i64)&amArr[1]) - ((i64)&amArr[0])), 128);
    result &= Test("AlignMember[3] arr[2]%64",   (int)(((i64)&amArr[2]) & 63), 0);

    // Unions: alignas on a member or on the union itself raises alignment and size; a plain
    // union is untouched.
    result &= Test("sizeof(AlignUnionMember)==64",  (int)sizeof(AlignUnionMember),  64);
    result &= Test("alignof(AlignUnionMember)==64", (int)alignof(AlignUnionMember), 64);
    AlignUnionMember aum;
    aum.i = 5;
    result &= Test("AlignUnionMember addr%64", (int)(((i64)&aum) & 63), 0);
    result &= Test("AlignUnionMember value",   aum.i, 5);
    result &= Test("sizeof(AlignUnionType)==32",  (int)sizeof(AlignUnionType),  32);
    result &= Test("alignof(AlignUnionType)==32", (int)alignof(AlignUnionType), 32);
    result &= Test("sizeof(PlainUnion)==8",       (int)sizeof(PlainUnion),      8);
    result &= Test("alignof(PlainUnion)==8",      (int)alignof(PlainUnion),     8);

    return result;
}

int nestedShiftU8Named(u8 v) { u8 s = v << 1; return (int)(s >> 4); }
int nestedShiftU8Inline(u8 v) { return (int)((v << 1) >> 4); }
int nestedShiftU16Named(u16 v) { u16 s = v << 1; return (int)(s >> 8); }
int nestedShiftU16Inline(u16 v) { return (int)((v << 1) >> 8); }
int nestedShiftU32Named(u32 v) { u32 s = v << 1; return (int)(s >> 24); }
int nestedShiftU32Inline(u32 v) { return (int)((v << 1) >> 24); }
int nestedShiftU64Named(u64 v) { u64 s = v << 32; return (int)(s >> 48); }
int nestedShiftU64Inline(u64 v) { return (int)((v << 32) >> 48); }
int nestedShiftI64Named(i64 v) { i64 s = v << 32; return (int)(s >> 48); }
int nestedShiftI64Inline(i64 v) { return (int)((v << 32) >> 48); }

// =============================================================
// Compile-time constant folding (C integer promotion)
// =============================================================
// Regression: small integer literals are stored at their minimal width (1 is i8),
// so binary folding used to overflow in that width - (i8)1 << 20 folded to 0 and
// (i8)100 << 1 to -56. C integer promotion now widens sub-int operands to i32
// before the fold. Runtime forms were always correct; only compile-time literal
// folding was affected.
bool testConstFold()
{
    bool result = true;

    // Shifts that overflow the i8 source width.
    result &= Test("1 << 8",    1 << 8,    256);
    result &= Test("1 << 20",   1 << 20,   1048576);
    result &= Test("100 << 1",  100 << 1,  200);

    // Chained multiply that overflows i16 (4*1024 fits i16, *1024 overflows it).
    result &= Test("4*1024*1024", 4 * 1024 * 1024, 4194304);
    result &= Test("2*1000*1000", 2 * 1000 * 1000, 2000000);

    // Add/subtract that exceed the narrow width.
    result &= Test("100 + 100",  100 + 100,  200);
    result &= Test("200 + 100",  200 + 100,  300);

    // Folded literal must match the runtime form computed from int variables.
    int one = 1;
    int sh  = 20;
    result &= Test("fold==runtime shift", 1 << 20, one << sh);

    result &= Test("chained left shift", 1 << 2 << 3, 32);
    result &= Test("chained right shift", 256 >> 2 >> 2, 16);
    int mixedShift = 8;
    result &= Test("mixed chained shift", (mixedShift << 1) >> 1, 8);
    result &= Test("chained u32 shift", (u32)1 << 4 << 4, (u32)256);
    result &= Test("chained u64 shift", (u64)1 << 32 << 16, (u64)281474976710656);
    result &= Test("chained i64 right shift", (i64)256 >> 2 >> 2, (i64)16);

    int a = 4;
    int k = 1024;
    result &= Test("fold==runtime mul", 4 * 1024 * 1024, a * k * k);

    // A nested shift keeps the signedness of its left operand. The folded legs exercise the
    // constant folder; the parameter legs force runtime codegen and compare named/inline forms.
    result &= Test("u8 folded nested right shift", (int)(((u8)0x80 << 24) >> 31), -1);
    result &= Test("u16 folded nested right shift", (int)(((u16)0x8000 << 16) >> 31), -1);
    result &= Test("u32 folded nested right shift", (int)(((u32)0x40000000 << 1) >> 31), 1);
    result &= Test("u64 folded nested right shift", (int)(((u64)0xFF880000 << 32) >> 48), 65416);
    u64 foldedU64 = (u64)0xFF880000;
    result &= Test("u64 folded named right shift", (int)((foldedU64 << 32) >> 48), 65416);
    result &= Test("u64 folded inline right shift", (int)(((u64)0xFF880000 << 32) >> 48), 65416);
    result &= Test("i64 folded nested right shift", (int)(((i64)0xFF880000 << 32) >> 48), -120);

    result &= Test("u8 runtime named nested right shift", nestedShiftU8Named((u8)0xF8), 15);
    result &= Test("u8 runtime inline nested right shift", nestedShiftU8Inline((u8)0xF8), 31);
    result &= Test("u16 runtime named nested right shift", nestedShiftU16Named((u16)0xFF80), 255);
    result &= Test("u16 runtime inline nested right shift", nestedShiftU16Inline((u16)0xFF80), 511);
    result &= Test("u32 runtime named nested right shift", nestedShiftU32Named((u32)0xFF800000), 255);
    result &= Test("u32 runtime inline nested right shift", nestedShiftU32Inline((u32)0xFF800000), 255);
    result &= Test("u64 runtime named nested right shift", nestedShiftU64Named((u64)0xFF880000), 65416);
    result &= Test("u64 runtime inline nested right shift", nestedShiftU64Inline((u64)0xFF880000), 65416);
    result &= Test("i64 runtime named nested right shift", nestedShiftI64Named((i64)0xFF880000), -120);
    result &= Test("i64 runtime inline nested right shift", nestedShiftI64Inline((i64)0xFF880000), -120);

    return result;
}

// =============================================================
// Floating-point literal default width
// =============================================================
// Like small integer literals (1 is i8), a no-suffix decimal literal is typed as
// the smallest float type that holds it exactly: float (f32) when it round-trips
// through float without loss, otherwise double (f64). An explicit 'f' suffix always
// forces float. These overloads let the literal pick the matching parameter type.
int whichFp(float x)  { return 1; }   // float  selected
int whichFp(double x) { return 2; }   // double selected

bool testFloatLiteralWidth()
{
    bool result = true;

    // Exact in float -> f32.
    result &= Test("1.5 is float",    whichFp(1.5),   1);
    result &= Test("100.0 is float",  whichFp(100.0), 1);
    result &= Test("0.5 is float",    whichFp(0.5),   1);

    // 'f' suffix forces float.
    result &= Test("1.5f is float",   whichFp(1.5f),  1);

    // Not representable exactly in float -> f64.
    result &= Test("0.1 is double",   whichFp(0.1),                 2);
    result &= Test("pi is double",    whichFp(3.141592653589793),   2);

    return result;
}

// =============================================================
// float -> double implicit widening at the literal site
// =============================================================
// A bare literal like 1.0 is typed `float` (smallest-type rule above), but
// float -> double is an implicit widening conversion, so it must widen when the
// destination is `double`. Two sites previously emitted invalid LLVM IR:
//   1. Ternary unification: `cond ? <double> : 1.0` produced a select with one
//      double and one float operand (verifier: "Invalid operands for select").
//   2. A `double` global seeded from a bare float literal mismatched its type
//      (verifier: "Global variable initializer type does not match").

// Case 2: double global seeded from a bare float literal.
double g_widenGlobal = 1.0;

bool testFloatDoubleWiden()
{
    bool result = true;

    // Global initialized from a bare float literal widened to double.
    result &= Test("widen_global_literal", g_widenGlobal == 1.0, true);

    // `c` is a loaded local, so the ternary lowers to a real `select` whose
    // operands must unify to a common type (double).
    bool c = true;

    // Case 1: ternary mixing a double expression with a bare float literal,
    // on each branch.
    double x = c ? (g_widenGlobal * 2.0) : 1.0;   // double expr on taken branch
    double y = c ? 0.0 : (g_widenGlobal * 2.0);   // bare literal on taken branch
    result &= Test("widen_ternary_double_branch", x == 2.0, true);
    result &= Test("widen_ternary_literal_branch", y == 0.0, true);

    return result;
}

// Regression: a fixed array of structs declared with no initializer was left as stack garbage,
// while the scalar declaration was default-constructed. Every element must now read exactly as
// the scalar does - field initializers included, not merely zeroed.
struct ArrDefZero    { int n = 0; int* p = nullptr; };
struct ArrDefNonZero { int n = 5; int m = 7; };
struct ArrDefString  { int n = 3; string s = default; };

// Fill the frame with a recognizable pattern so a later declaration that reads uninitialized
// stack sees garbage rather than incidental zeros.
void dirtyTheStack()
{
    i64[64] junk;
    int i = 0;
    while (i < 64) { junk[i] = 0x5A5A5A5A5A5A5A5A; i++; }
}

bool testFixedArrayDefaultInit()
{
    bool result = true;

    ArrDefZero[4] z;
    result &= Test("arrdef_zero_first", z[0].n == 0 && z[0].p == nullptr, true);
    result &= Test("arrdef_zero_last",  z[3].n == 0 && z[3].p == nullptr, true);

    // Field initializers must be applied to every element, matching the scalar path.
    ArrDefNonZero one;
    ArrDefNonZero[4] nz;
    result &= Test("arrdef_scalar_parity", nz[0].n == one.n && nz[0].m == one.m, true);
    result &= Test("arrdef_nonzero_last",  nz[3].n == 5 && nz[3].m == 7, true);

    // Multi-dimensional arrays are contiguous; the last slot proves the whole extent is covered.
    ArrDefNonZero[2][3] m;
    result &= Test("arrdef_multidim_first", m[0][0].n == 5 && m[0][0].m == 7, true);
    result &= Test("arrdef_multidim_last",  m[1][2].n == 5 && m[1][2].m == 7, true);

    // Above the unroll limit this fills via a runtime loop.
    ArrDefNonZero[64] big;
    result &= Test("arrdef_loop_first", big[0].n == 5, true);
    result &= Test("arrdef_loop_last",  big[63].n == 5, true);

    // A garbage _len would make the string destructor free a garbage _ptr at scope exit.
    ArrDefString[4] s;
    result &= Test("arrdef_string_len", s[0].s.length() == 0 && s[3].s.length() == 0, true);
    result &= Test("arrdef_string_field", s[0].n == 3 && s[3].n == 3, true);

    return result;
}

// Dirty the frame first, then re-check: the values must come from default construction,
// not from a stack that happened to be zero.
bool testFixedArrayDefaultInitDirtied()
{
    dirtyTheStack();
    return testFixedArrayDefaultInit();
}

// Destruction is the mirror of default-init above: `T[N] a;` default-constructs every element,
// so scope exit must destruct every element too. The scope-exit destructor used to be a single
// call on the array BASE pointer - i.e. element [0] only - leaking the other N-1.
int arrDtorCount = 0;
struct ArrDtor { int n = 0; ~ArrDtor() { arrDtorCount++; } };

bool testFixedArrayDestruction()
{
    bool result = true;

    arrDtorCount = 0;
    { ArrDtor[4] a; }
    result &= Test("arrdtor_all_elements", arrDtorCount, 4);

    // A scalar declaration is unchanged: exactly one destructor.
    arrDtorCount = 0;
    { ArrDtor one; }
    result &= Test("arrdtor_scalar_parity", arrDtorCount, 1);

    // Multi-dimensional arrays are contiguous, so the flat walk covers all N*M elements.
    arrDtorCount = 0;
    { ArrDtor[2][3] m; }
    result &= Test("arrdtor_multidim", arrDtorCount, 6);

    arrDtorCount = 0;
    { ArrDtor[2][3][4] deep; }
    result &= Test("arrdtor_multidim_deep", arrDtorCount, 24);

    // Above the unroll limit this destructs via a runtime loop rather than unrolled calls.
    arrDtorCount = 0;
    { ArrDtor[64] big; }
    result &= Test("arrdtor_loop", arrDtorCount, 64);

    return result;
}

// =============================================================
// static locals - storage is a module global with program lifetime, and the
// initializer runs at most once. Pre-fix `static` was ignored on a local: the
// variable was a plain alloca and its initializer re-ran on every call, so every
// accumulate-across-calls leg below returned the first call's value forever.
// =============================================================
int slCtorCalls = 0;
int slDtorCalls = 0;
int slComputeCalls = 0;
int slAllocs = 0;

int slCompute() { slComputeCalls = slComputeCalls + 1; return 100; }

struct SlSeed
{
    int n = default;
    SlSeed() { n = 7; slCtorCalls = slCtorCalls + 1; }
};

struct SlDtor
{
    int n = default;
    ~SlDtor() { slDtorCalls = slDtorCalls + 1; }
};

struct SlPlain { int n = default; };

struct SlHolder
{
    int base = default;
    int tick() { static int m = 100; m = m + 1; return m + base; }
};

int slConstInit()    { static int c = 5; c = c + 1; return c; }
int slRuntimeInit()  { static int c = slCompute(); c = c + 1; return c; }
int slNoInit()       { static int c; c = c + 1; return c; }
int slTwoDeclarators() { static int a = 1, b = 10; a = a + 1; b = b + 10; return a * 100 + b; }
int slTwoStatements()  { static int a = 1; static int b = 10; a = a + 1; b = b + 10; return a * 100 + b; }
int slCtorOnce()     { static SlSeed s = default; s.n = s.n + 1; return s.n; }
int slDtorNever()    { static SlDtor d = default; d.n = d.n + 1; return d.n; }
int slArrayDefault() { static SlPlain[2] a = default; a[0].n = a[0].n + 1; a[1].n = a[1].n + 2; return a[0].n * 10 + a[1].n; }
int slArrayValues()  { static int[3] a = {1, 2, 3}; a[0] = a[0] + 1; return a[0] * 100 + a[1] * 10 + a[2]; }
int slStringGrows()  { static string s = "a"; s = s + "b"; return (int)s.length(); }
int slCollide1()     { static int c = 0; c = c + 1; return c; }
int slCollide2()     { static int c = 100; c = c + 1; return c; }
int slGeneric<T>(T seed) { static int g = 0; g = g + (int)seed; return g; }

int slApply(Lambda<int()> f) { return f(); }

// Accept side of the static-dangle reject: a static may address a global, another static, or
// the heap. Values, not just compilation, so a wrong target would be visible.
int slGlobalInt = 41;
int[4] slGlobalArr = {10, 20, 30, 40};
int slAddrOfGlobal()    { static int* p = &slGlobalInt; return *p; }
int slAddrOfStatic()    { static int s = 77; static int* p = &s; p[0] = p[0] + 1; return *p; }
int slViewOfGlobalArr() { static int[] v = slGlobalArr; return v[1]; }
int slViewOfStaticArr() { static int[3] sa = {5, 6, 7}; static int[] v = sa; v[2] = v[2] + 1; return v[2]; }
int slFixedArrCopy()    { int[3] src = {4, 5, 6}; static int[3] c = src; c[0] = c[0] + 1; return c[0]; }
int slConstLenArith()   { static int[2 + 1] a = default; a[2] = a[2] + 1; return a[2]; }

// File-scope zero-to-view initializers are the null view (T254, the global twin of T200's local
// rule), and a view of a global array reads back. A fresh cache must verify the same as a warm one.
float[] tzGz = 0.0;
int[] tzGi = 0;
float[] tzGd;
int[4] tzGArr = {10, 20, 30, 40};
int[] tzGView = tzGArr;
int tzGlobalViewProbe()
{
    float[] fz = tzGz;
    if (fz != nullptr || tzGz != nullptr || tzGi != nullptr || tzGd != nullptr) return -1;
    int s = 0;
    for (int i = 0; i < 4; i++) s = s + tzGView[i];
    return s;
}

// The initializer emits a whole lambda body before the static's own storage is created. That
// body declares a local with the SAME name and type as the static: it must not claim the
// static's storage (which would leave the static a per-call alloca and make the lambda's local
// a module global).
int slNestedShadow()
{
    static int c = slApply(() => { int c = 5; return c; });
    c = c + 1;
    return c;
}

int slPointerOnce()
{
    static SlPlain* p = nullptr;
    if (p == nullptr) { p = new SlPlain(); slAllocs = slAllocs + 1; }
    p->n = p->n + 1;
    return p->n;
}

int slLoopBody(int n)
{
    int total = 0;
    for (int i = 0; i < n; i++) { static int k = 0; k = k + 1; total = total + k; }
    return total;
}

int slRecurse(int n)
{
    static int c = 0;
    c = c + 1;
    if (n > 0) slRecurse(n - 1);
    return c;
}

bool testStaticLocals()
{
    bool result = true;

    // Constant initializer: folded into the global's own initializer (no runtime store),
    // and the value ACCUMULATES. Pre-fix all three legs returned 6.
    result &= Test("static_const_init_1", slConstInit(), 6);
    result &= Test("static_const_init_2", slConstInit(), 7);
    result &= Test("static_const_init_3", slConstInit(), 8);

    // Non-constant initializer runs exactly once, under the once flag. Pre-fix the
    // call count was one per invocation.
    result &= Test("static_runtime_init_1", slRuntimeInit(), 101);
    result &= Test("static_runtime_init_2", slRuntimeInit(), 102);
    result &= Test("static_runtime_init_calls", slComputeCalls, 1);

    // No initializer: zero-initialized once. Pre-fix this read a fresh stack slot per call.
    result &= Test("static_no_init_1", slNoInit(), 1);
    result &= Test("static_no_init_2", slNoInit(), 2);

    // Both declarators of one statement, and two separate static statements, get their
    // own storage and their own guard.
    result &= Test("static_two_declarators_1", slTwoDeclarators(), 220);
    result &= Test("static_two_declarators_2", slTwoDeclarators(), 330);
    result &= Test("static_two_statements_1", slTwoStatements(), 220);
    result &= Test("static_two_statements_2", slTwoStatements(), 330);

    // A constructor with side effects runs ONCE (pre-fix: once per call).
    result &= Test("static_ctor_once_1", slCtorOnce(), 8);
    result &= Test("static_ctor_once_2", slCtorOnce(), 9);
    result &= Test("static_ctor_count", slCtorCalls, 1);

    // Destruction policy: a static local is destructed NEVER - it outlives every scope
    // exit. Pre-fix the destructor ran on each call (a live value destructed under it).
    result &= Test("static_dtor_never_1", slDtorNever(), 1);
    result &= Test("static_dtor_never_2", slDtorNever(), 2);
    result &= Test("static_dtor_count", slDtorCalls, 0);

    // Aggregate statics: '= default' seeding and a positional brace list both persist.
    result &= Test("static_array_default_1", slArrayDefault(), 12);
    result &= Test("static_array_default_2", slArrayDefault(), 24);
    result &= Test("static_array_values_1", slArrayValues(), 223);
    result &= Test("static_array_values_2", slArrayValues(), 323);

    // Lazily allocated static pointer: the 'new' happens once and the pointee survives
    // the scope exit that would otherwise free an owning local.
    result &= Test("static_pointer_1", slPointerOnce(), 1);
    result &= Test("static_pointer_2", slPointerOnce(), 2);
    result &= Test("static_pointer_allocs", slAllocs, 1);

    // An owning static (string) keeps its heap buffer across calls.
    result &= Test("static_string_1", slStringGrows(), 2);
    result &= Test("static_string_2", slStringGrows(), 3);

    // The guard is per VARIABLE, not per function entry: a static in a loop body
    // initializes on the first iteration of the first call only (pre-fix: every iteration).
    result &= Test("static_in_loop_1", slLoopBody(3), 6);
    result &= Test("static_in_loop_2", slLoopBody(3), 15);

    // Each generic instantiation gets its OWN static. The float leg is the collision
    // discriminator: if both instantiations shared one global it would read 4, not 2.
    result &= Test("static_generic_int_1", slGeneric<int>(1), 1);
    result &= Test("static_generic_int_2", slGeneric<int>(1), 2);
    result &= Test("static_generic_float", slGeneric<float>(2.0f), 2);

    // A same-named, same-typed local inside the initializer's lambda body does not steal the
    // static's storage: the static still accumulates (a steal reproduces the pre-fix 6, 6, 6).
    result &= Test("static_nested_shadow_1", slNestedShadow(), 6);
    result &= Test("static_nested_shadow_2", slNestedShadow(), 7);
    result &= Test("static_nested_shadow_3", slNestedShadow(), 8);

    // Same static name in two different functions: distinct storage.
    result &= Test("static_collide_a1", slCollide1(), 1);
    result &= Test("static_collide_b1", slCollide2(), 101);
    result &= Test("static_collide_a2", slCollide1(), 2);
    result &= Test("static_collide_b2", slCollide2(), 102);

    // Recursion: the flag is set BEFORE the initializer, so nested calls skip it and all
    // four levels increment the one variable.
    result &= Test("static_recursion", slRecurse(3), 4);

    // A static local in a method is per-method, not per-instance.
    SlHolder h1 = SlHolder();
    SlHolder h2 = SlHolder();
    h1.base = 1;
    h2.base = 2;
    result &= Test("static_method_1", h1.tick(), 102);
    result &= Test("static_method_2", h2.tick(), 104);

    // A static may hold the address of a global, of another static, or of the heap (the
    // rejected shape is the address of a NON-static local - see err_static_local_array_view.cb).
    result &= Test("static_addr_of_global", slAddrOfGlobal(), 41);
    result &= Test("static_addr_of_static_1", slAddrOfStatic(), 78);
    result &= Test("static_addr_of_static_2", slAddrOfStatic(), 79);
    result &= Test("static_view_of_global_arr", slViewOfGlobalArr(), 20);
    result &= Test("static_view_of_static_arr_1", slViewOfStaticArr(), 8);
    result &= Test("static_view_of_static_arr_2", slViewOfStaticArr(), 9);
    result &= Test("global_zero_view_null_and_sum", tzGlobalViewProbe(), 100);

    // A fixed-array static COPIES its source, so a local source is not an aliasing hazard
    // and stays accepted; the copy itself persists across calls.
    result &= Test("static_fixed_arr_copy_1", slFixedArrCopy(), 5);
    result &= Test("static_fixed_arr_copy_2", slFixedArrCopy(), 6);

    // A constant-expression length is accepted (only genuinely run-time lengths are rejected).
    result &= Test("static_const_len_arith_1", slConstLenArith(), 1);
    result &= Test("static_const_len_arith_2", slConstLenArith(), 2);

    // A static local in a lambda body.
    Lambda<int()> lam = () => { static int L = 0; L = L + 1; return L; };
    result &= Test("static_lambda_1", lam(), 1);
    result &= Test("static_lambda_2", lam(), 2);

    return result;
}

// =============================================================
// ACCEPT SET of the direct-void-call gate.
// Consuming a void call's result is now an error at the CALL (see
// Test/errors/err_direct_void_call_consumed.cb). These legs are the other polarity: every
// spelling below is a DISCARD (or a non-void result) that master compiled and ran, and must
// keep doing so. They are pins, not repro legs - each one goes red by failing to COMPILE if
// the gate over-fires, which is the failure mode that costs the most to find later.
// =============================================================

int dvaHits = 0;
void dvaBump() { dvaHits = dvaHits + 1; }
int  dvaTake(int v) { dvaHits = dvaHits + v; return v; }
void dvaVoidReturn() { return dvaBump(); }
void dvaCastReturn()  { return (void)dvaBump(); }
void dvaGeneric<T>(T v) { dvaHits = dvaHits + 1; }

using DvaVoid = void;
DvaVoid dvaAliased() { dvaHits = dvaHits + 1; }

void* dvaGivePtr() { return nullptr; }

class DvaCounter
{
    int n = default;
    void bump() { n = n + 1; }
};

interface IDvaBump { void bump(); };
class DvaImpl : IDvaBump
{
    int n = default;
    void bump() { n = n + 1; }
};

struct DvaOp
{
    int n = default;
    void operator!()      { dvaHits = dvaHits + 1; }
    void operator+(DvaOp o) { dvaHits = dvaHits + 2; }
};

// A bool method called for its VALUE inside an `alias V` method of a generic instantiated at a
// `unique` interface. The call's recorded return type reads 'void' there even though the result
// is a real i1, so a gate keyed on the type NAME alone rejects this - it is the exact shape that
// broke core/hpc/btree.cb. The leg proves the gate demands value-lessness, not just the name.
interface IDvaShape { int area(); };
class DvaCircle : IDvaShape { int r = 0; int area() { return r * r; } };
struct DvaIter<V>
{
    int slot = default;
    V missing = default;
    bool valid() { return slot >= 0; }
    alias V value() { if (!valid()) return missing; return missing; }
};

bool testDirectVoidCallDiscarded()
{
    bool result = true;

    dvaHits = 0;
    dvaBump();
    result &= Test("dva_bare_statement", dvaHits, 1);

    dvaHits = 0;
    (dvaBump());
    result &= Test("dva_paren_statement", dvaHits, 1);

    dvaHits = 0;
    ((dvaBump()));
    result &= Test("dva_double_paren_statement", dvaHits, 1);

    dvaHits = 0;
    for (int i = 0; i < 3; i++) { dvaBump(); }
    result &= Test("dva_loop_body", dvaHits, 3);

    dvaHits = 0;
    for (dvaBump(); dvaHits < 3; dvaBump()) { }
    result &= Test("dva_for_init_and_increment", dvaHits, 3);

    dvaHits = 0;
    while (dvaHits < 2) { dvaBump(); }
    result &= Test("dva_while_body", dvaHits, 2);

    dvaHits = 0;
    do { dvaBump(); } while (dvaHits < 2);
    result &= Test("dva_do_while_body", dvaHits, 2);

    dvaHits = 0;
    if (dvaHits == 0) dvaBump(); else dvaTake(9);
    result &= Test("dva_if_branch_statement", dvaHits, 1);

    // `return <void call>;` out of a VOID function stays legal - it is ResultUse::ReturnOperand,
    // which the gate defers to EmitReturnExpression.
    dvaHits = 0;
    dvaVoidReturn();
    result &= Test("dva_void_return_crossing", dvaHits, 1);

    // A '(void)' CAST discards its operand, so a void call under it is not a consumption.
    dvaHits = 0;
    dvaCastReturn();
    result &= Test("dva_void_cast_return_crossing", dvaHits, 1);

    dvaHits = 0;
    (void)dvaBump();
    result &= Test("dva_void_cast_statement", dvaHits, 1);

    dvaHits = 0;
    dvaGeneric<int>(1);
    dvaGeneric<bool>(true);
    result &= Test("dva_generic_statement", dvaHits, 2);

    dvaHits = 0;
    dvaAliased();
    result &= Test("dva_alias_void_statement", dvaHits, 1);

    {
        DvaCounter c;
        c.bump();
        c.bump();
        result &= Test("dva_method_statement", c.n, 2);
    }

    {
        DvaImpl d;
        IDvaBump i = d;
        i.bump();
        result &= Test("dva_iface_statement", d.n, 1);
    }

    // A void OPERATOR overload in discard position (unary and binary spellings).
    dvaHits = 0;
    {
        DvaOp a;
        DvaOp b;
        !a;
        a + b;
    }
    result &= Test("dva_void_operator_statements", dvaHits, 3);

    // Non-void results stay consumable, including the void* one the gate must not touch
    // (it is a POINTER, not a value-less result).
    dvaHits = 0;
    int taken = dvaTake(7);
    result &= Test("dva_nonvoid_value_consumable", taken, 7);
    void* p = dvaGivePtr();
    result &= Test("dva_voidptr_result_consumable", p == nullptr ? 1 : 0, 1);

    {
        DvaIter<unique IDvaShape> it;
        it.slot = 0;
        result &= Test("dva_bool_call_in_alias_generic", it.valid() ? 1 : 0, 1);
    }

    return result;
}

/*
 * A PARENTHESIZED LVALUE on the left of a store writes through to the same object the bare
 * spelling does. `(*p) = v` used to land in a temp copy and was a SILENT NO-OP (the write was
 * simply lost, no diagnostic); the parenthesized-lvalue restore in ParsePostfixExpressionInner
 * pairs the paren's Storage with its element type again, so the store reaches the pointee.
 * Pinned here because the failure mode is lost data rather than a crash, so nothing else catches it.
 */
void plvWriteThrough(int* p) { (*p) = 9; }

int plvStoreThroughParam()
{
    int v = 1;
    plvWriteThrough(&v);
    return v;
}

bool testParenLvalueStore()
{
    bool result = true;

    // DISCRIMINATORS. These three are the bug: on the merge base each write landed in a temp and
    // the variable kept its old value (all three reported `got 1`).
    int x = 1;
    int* p = &x;
    (*p) = 9;
    result &= Test("plv_paren_deref_store", x, 9);

    (*p) += 1;
    result &= Test("plv_paren_deref_compound_store", x, 10);

    ((*p)) = 20;
    result &= Test("plv_double_paren_deref_store", x, 20);

    // The same store through a pointer PARAMETER rather than a local - a different storage shape.
    // COVERAGE: this value is already correct on the merge base as a compiled exe, so the leg does
    // not discriminate here. It is kept because the merge base DID diverge on the same program
    // under `--run` (rc 139 in the JIT, where the bare `*p = 9` twin was rc 0;
    // `scratch/wp_lw_borrowparam_paren2.cb`, reproduced three times), and `test.sh` builds exes.
    result &= Test("plv_paren_deref_param_store", plvStoreThroughParam(), 9);

    // COVERAGE from here down, not discriminators: every leg below produces these same values on
    // the merge base. They are the accept set - the restore must not disturb the spellings that
    // already worked - and the bare oracle the three legs above are read against.
    *p = 3;
    result &= Test("plv_bare_deref_store_oracle", x, 3);

    (x) = 11;
    result &= Test("plv_paren_name_store", x, 11);

    int y = 2;
    int* q = &y;
    *(q) = 7;
    result &= Test("plv_paren_inside_deref_store", y, 7);

    MyStruct1 s;
    s.num = 1;
    MyStruct1* sp = &s;
    (*sp).num = 5;
    result &= Test("plv_paren_deref_field_store", s.num, 5);

    (sp)->num = 6;
    result &= Test("plv_paren_receiver_arrow_store", s.num, 6);

    int[3] arr;
    arr[0] = 0;
    (arr[0]) = 4;
    result &= Test("plv_paren_element_store", arr[0], 4);

    // Parenthesized dereference increments must write through the restored lvalue storage, just
    // like the compound assignment above. Keep the double-parenthesized form in the accept set too.
    int inc = 5;
    int* ip = &inc;
    (*ip)++;
    result &= Test("plv_paren_deref_increment", inc, 6);

    int doubleInc = 5;
    int* doubleIp = &doubleInc;
    ((*doubleIp))++;
    result &= Test("plv_double_paren_deref_increment", doubleInc, 6);

    int nm = 5;
    (nm)++;
    result &= Test("plv_paren_name_increment", nm, 6);

    int[2] ia;
    ia[0] = 5;
    (ia[0])++;
    result &= Test("plv_paren_element_increment", ia[0], 6);

    MyStruct1 t;
    t.num = 5;
    (t.num)++;
    result &= Test("plv_paren_field_increment", t.num, 6);

    // Accept-set for the void*-deref rejection: a 'void**' HAS a sized pointee (a pointer), so
    // one deref of it stays legal and yields the inner pointer. Deref of the 'void*' itself is
    // refused in Test/errors/err_void_pointer_deref.cb.
    int vdTarget = 71;
    void* vdInner = &vdTarget;
    void** vdOuter = &vdInner;
    void* vdBack = (*vdOuter);
    int* vdTyped = (int*)vdBack;
    result &= Test("plv_void_double_ptr_deref", (*vdTyped), 71);
    // Same accept-set for the index arm: a 'void**' element IS a sized pointer.
    void* vdIdxBack = vdOuter[0];
    int* vdIdxTyped = (int*)vdIdxBack;
    result &= Test("plv_void_double_ptr_index", (*vdIdxTyped), 71);

    return result;
}

/*
 * Postfix ++/-- side effects land at the end of their FULL EXPRESSION, as in C. Pre-fix a
 * declaration initializer never flushed them: `int r = f(c++); int d = c;` read d == 1 (the store
 * landed at the next expression statement or scope end), and `(c++)` flushed BEFORE its value was
 * read (yielded 2). Every leg reads the operand in a LATER declaration, the shape that discriminates.
 */
int pfaId(int x) { return x; }
T pfaGid<T>(T x) { return x; }
int pfaApply(int x, function<int(int)> f) { return f(x); }
struct PfaBox { int n = default; };
(int, int) pfaPair(int a) { return (a, a + 10); }
int pfaRetDecl(int c) { int r = pfaId(c++); return r * 100 + c; }

bool testPostfixInDeclaration()
{
    bool result = true;
    { int c = 1; int r = c++; int d = c; result &= Test("pfa_plain_decl", d * 10 + r, 21); }
    { int c = 1; int r = pfaId(c++); int d = c; result &= Test("pfa_call_arg_decl", d * 10 + r, 21); }
    { int c = 1; int r = pfaId(c--); int d = c; result &= Test("pfa_call_arg_dec", d * 10 + r, 1); }
    { int c = 1; int r = pfaId(pfaId(c++)); int d = c; result &= Test("pfa_nested_call", d * 10 + r, 21); }
    { int c = 1; auto r = pfaId(c++); int d = c; result &= Test("pfa_auto_decl", d * 10 + r, 21); }
    { int c = 1; int r = pfaGid<int>(c++); int d = c; result &= Test("pfa_generic_call", d * 10 + r, 21); }
    { PfaBox b; b.n = 3; int r = pfaId(b.n++); int d = b.n; result &= Test("pfa_field", d * 10 + r, 43); }
    { int[3] a = {7, 8, 9}; int* p = &a[0]; int r = *p++; int d = *p; result &= Test("pfa_ptr_star", d * 10 + r, 87); }
    { int c = 1; int a = pfaId(c++), b = c; result &= Test("pfa_multi_declarator", b * 10 + a, 21); }
    { int c = 1; int r = c < 0 ? 0 : c++; int d = c; result &= Test("pfa_ternary_false_arm", d * 10 + r, 21); }
    { int c = 1; int n = 0; for (int k = pfaId(c++); k < 2; k++) { n = c; } result &= Test("pfa_for_init", n, 2); }
    result &= Test("pfa_return_after_decl", pfaRetDecl(1), 102);
    { int c = 1; (int x, int y) = pfaPair(c++); int d = c; result &= Test("pfa_destructuring", d * 100 + y * 10 + x, 311); }
    // Parenthesized postfix yields the OLD value, also through a storage-re-reading consumer.
    { int c = 1; int r = (c++); int d = c; result &= Test("pfa_paren", d * 10 + r, 21); }
    { int c = 1; int r = (c++) + (c++); int d = c; result &= Test("pfa_paren_twice", d * 10 + r, 32); }
    { int[3] a = {7, 8, 9}; int* q = &a[0]; int r = *(q++); int d = *q; result &= Test("pfa_paren_deref", d * 10 + r, 87); }
    // Pre-fix the lambda body's statement flush emitted the outer `c++` into the invoker
    // (module verification failed: "Referring to an instruction in another function").
    { int c = 1; int r = pfaApply(c++, (int v) => { int w = v + 1; return w; }); int d = c; result &= Test("pfa_lambda_arg", d * 10 + r, 22); }
    return result;
}

/*
 * A CONDITIONALLY evaluated operand's postfix ++/-- lands inside its own branch, and a `&&` / `||`
 * / `?:` condition ends at a sequence point. np = bare `c++`, p = `(c++)`. Legs fail on 9bfb4641
 * (queued work flushed after the rejoin: an untaken branch still incremented) and/or c7d09afe.
 */
int* pfaPick(int* b, int k) { return b; }
struct PfaQ { int v = default; int get(int k) { return v + k; } };

bool testPostfixConditional()
{
    bool result = true;
    int x = 5;
    { int c = 1; bool b = false && (c++ > 0); int d = c; result &= Test("pfc_and_np", d, 1); }
    { int c = 1; bool b = false && ((c++) > 0); int d = c; result &= Test("pfc_and_p", d, 1); }
    { int c = 1; bool b = true || (c++ > 0); int d = c; result &= Test("pfc_or_np", d, 1); }
    { int c = 1; bool b = true || ((c++) > 0); int d = c; result &= Test("pfc_or_p", d, 1); }
    { int c = 1; bool b = true && false && (c++ > 0); int d = c; result &= Test("pfc_and_chain", d, 1); }
    { int c = 1; int k = 0; if (false && c++ > 0) { k = 1; } int d = c; result &= Test("pfc_if_and_np", d, 1); }
    { int c = 1; int k = 0; if (true || (c++) > 0) { k = 1; } int d = c; result &= Test("pfc_if_or_p", d, 1); }
    { int c = 1; bool b = c++ > 0 && c == 2; int d = c; result &= Test("pfc_and_seq_point", d * 10 + (b ? 1 : 0), 21); }
    { int c = 1; int r = x > 0 ? 0 : c++; int d = c; result &= Test("pfc_tern_false_np", d * 10 + r, 10); }
    { int c = 1; int r = x > 0 ? 0 : (c++); int d = c; result &= Test("pfc_tern_false_p", d * 10 + r, 10); }
    { int c = 1; int r = x > 0 ? (c++) : 0; int d = c; result &= Test("pfc_tern_taken_p", d * 10 + r, 21); }
    { int c = 1; int r = x > 0 ? (x > 9 ? c++ : 0) : c++; int d = c; result &= Test("pfc_tern_nested", d * 10 + r, 10); }
    { int c = 1; int r = (c++ > 5) ? 1 : 2; int d = c; result &= Test("pfc_tern_cond_p", d * 10 + r, 22); }
    { int c = 1; int r = c++ > 5 ? 1 : 2; int d = c; result &= Test("pfc_tern_cond_np", d * 10 + r, 22); }
    { int c = 1; int r = c++ > 0 ? c : 9; int d = c; result &= Test("pfc_tern_seq_point", d * 10 + r, 22); }
    { int c = 1; int* r = &x ?? pfaPick(&x, c++); int d = c; result &= Test("pfc_coalesce_np", d, 1); }
    { int c = 1; int* r = &x ?? pfaPick(&x, (c++)); int d = c; result &= Test("pfc_coalesce_p", d, 1); }
    { int c = 1; int* r = &x; r ??= pfaPick(&x, c++); int d = c; result &= Test("pfc_coalesce_assign_np", d, 1); }
    { int c = 1; int* r = &x; r ??= pfaPick(&x, (c++)); int d = c; result &= Test("pfc_coalesce_assign_p", d, 1); }
    { int c = 1; PfaQ* q = nullptr; q?.get(c++); int d = c; result &= Test("pfc_null_cond_np", d, 1); }
    { int c = 1; PfaQ* q = nullptr; q?.get((c++)); int d = c; result &= Test("pfc_null_cond_p", d, 1); }
    { int c = 1; PfaQ* q = nullptr; int r = q?.get(c++); int d = c; result &= Test("pfc_null_cond_decl", d * 10 + r, 10); }
    { int c = 1; PfaQ qq; qq.v = 10; PfaQ* q = &qq; int r = q?.get(c++); int d = c; result &= Test("pfc_null_cond_taken", d * 100 + r, 211); }
    return result;
}

string tBorrowflowShortCircuitOwnedAnd(int c)
{
    string s = "a";
    bool k = c > 0 && (s = "x").length() > 0;
    return s;
}

string tBorrowflowShortCircuitOwnedOr(int c)
{
    string s = "b";
    bool k = c > 0 || (s = "y").length() > 0;
    return s;
}

bool testBorrowflowShortCircuitOwned()
{
    bool result = true;
    string andSkip = tBorrowflowShortCircuitOwnedAnd(0);
    string andTake = tBorrowflowShortCircuitOwnedAnd(1);
    string orSkip = tBorrowflowShortCircuitOwnedOr(1);
    string orTake = tBorrowflowShortCircuitOwnedOr(0);
    result &= Test("borrowflow_sc_and_skip_owned", andSkip, "a");
    result &= Test("borrowflow_sc_and_take_owned", andTake, "x");
    result &= Test("borrowflow_sc_or_skip_owned", orSkip, "b");
    result &= Test("borrowflow_sc_or_take_owned", orTake, "y");
    return result;
}

/*
 * A function body compiled mid-expression (a generic's FIRST instantiation) must not flush the
 * enclosing expression's pending postfix ++/--. Pre-fix (24a56848) its statement flushes emitted
 * the outer `c++` into the instantiated body: a local failed module verification ("Referring to
 * an instruction in another function"); a global compiled but incremented on EVERY later call.
 * Each generic below is instantiated for the first time by its own leg - keep them single-use.
 */
T pfgGenDecl<T>(T x) { T k = x; return k; }
T pfgGenAssign<T>(T x) { T k = x; return k; }
T pfgGenInfer<T>(T x) { T k = x; return k; }
T pfgGenRet<T>(T x) { T k = x; return k; }
T pfgGenInner<T>(T x) { T k = x; return k; }
T pfgGenOuter<T>(T x) { T k = pfgGenInner<T>(x); return k; }
T pfgGenGlobal<T>(T x) { T k = x; return k; }
T pfgGenField<T>(T x) { T k = x; return k; }
int t115LocalEnumGeneric<T>(T x) { return sizeof(T) * 10 + (int)x; }
int t115LocalEnumChar() { enum Col : char { A = 1 }; return t115LocalEnumGeneric<Col>(Col.A); }
int t115LocalEnumLong() { enum Col : long { A = 2 }; return t115LocalEnumGeneric<Col>(Col.A); }
struct PfgS { int b = default; T add<T>(T x) { T k = x; return k; } };
struct PfgBox<T> { T v = default; U conv<U>() { U k = (U)v; return k; } };
struct PfgDef<T> { T v = pfgGenField<T>(3); T w = default; };
PfgDef<T> pfgMkDef<T>(T x) { PfgDef<T> d; d.w = x; return d; }
int gPfgCounter = 1;
int pfgRetUse(int c) { return c++ + pfgGenRet<int>(5); }

bool testPostfixGenericInstantiation()
{
    bool result = true;
    result &= Test("t115_explicit_local_enum_generic", t115LocalEnumChar() + t115LocalEnumLong(),
        sizeof(char) * 10 + 1 + sizeof(long) * 10 + 2);
    { int c = 1; int r = c++ + pfgGenDecl<int>(5); int d = c; result &= Test("pfg_fn_decl", r * 10 + d, 62); }
    { int c = 1; int r = 0; r = c++ + pfgGenAssign<int>(5); int d = c; result &= Test("pfg_fn_assign", r * 10 + d, 62); }
    { int c = 1; int r = c++ + pfgGenInfer(5); int d = c; result &= Test("pfg_fn_inferred", r * 10 + d, 62); }
    result &= Test("pfg_fn_return", pfgRetUse(1), 6);
    { int c = 3; int r = c-- + pfgGenOuter<int>(5); int d = c; result &= Test("pfg_fn_nested_dec", r * 10 + d, 82); }
    // Global destination: pre-fix compiled clean but the increment ran inside pfgGenGlobal<int>,
    // so the second call bumped it again (read 6273).
    { int r = gPfgCounter++ + pfgGenGlobal<int>(5); int d = gPfgCounter; int r2 = pfgGenGlobal<int>(7); int d2 = gPfgCounter;
      result &= Test("pfg_fn_global", r * 1000 + d * 100 + r2 * 10 + d2, 6272); }
    { PfgS s; int c = 1; int r = c++ + s.add<int>(5); int d = c; result &= Test("pfg_generic_method", r * 10 + d, 62); }
    { PfgBox<int> b; b.v = 5; int c = 1; long r = c++ + b.conv<long>(); int d = c; result &= Test("pfg_generic_struct_generic_method", (int)r * 10 + d, 62); }
    // The field default `pfgGenField<T>(3)` is itself instantiated inside the struct's instantiation.
    { int c = 1; int r = c++ + pfgMkDef<int>(5).v; int d = c; result &= Test("pfg_field_default_generic", r * 10 + d, 42); }
    return result;
}

T t428AddressId<T>(T value) { return value + 1; }
int t428AddressSelected = 0;
int t428AddressOverload(int value) { t428AddressSelected = 1; return value + 10; }
T t428AddressOverload<T>(T value) { t428AddressSelected = 2; return value + 20; }
struct T428AddressMethod { static T method<T>(T value) { return value + 1; } };

bool testGenericAddressValues()
{
    bool result = true;
    function<int(int)> explicitAddress = &t428AddressId<int>;
    result &= Test("t428_explicit_generic_address", explicitAddress(2), 3);
    function<int(int)> methodAddress = &T428AddressMethod.method<int>;
    result &= Test("t428_explicit_generic_method_address", methodAddress(2), 3);
    function<int(int)> overloadAddress = t428AddressOverload;
    t428AddressSelected = 0;
    int overloadValue = overloadAddress(3);
    result &= Test("t428_generic_overload_keeps_concrete", t428AddressSelected * 100 + overloadValue, 113);
    {
        int t428AddressId = 41;
        int* localAddress = &t428AddressId;
        result &= Test("t428_local_shadows_generic_function", *localAddress, 41);
    }
    return result;
}

struct T38Padded { char c = default; double d = default; };
struct T38Nested { char c = default; T38Padded inner = default; };
struct T38Box<T> { char c = default; T value = default; };
struct T38OffsetNameField { int offsetof = default; };
struct alignas(32) T38Aligned { char c = default; double d = default; };
namespace T38Ns { struct Record { char c = default; double d = default; }; }
namespace T38OffsetUser
{
    int offsetof(int a, int b) { return a * 10 + b; }
    int Invoke() { return offsetof(2, 3); }
}
int t38OffsetParamName(int offsetof) { return offsetof * 2; }
using T38PaddedAlias = T38Padded;

bool testOffsetofIntrinsic()
{
    bool result = true;
    const u64 padded = offsetof(T38Padded, d);
    int[offsetof(T38Padded, d)] arr;
    result &= Test("offsetof_cflat_padding", padded, (u64)8);
    result &= Test("offsetof_cflat_nested", offsetof(T38Nested, inner.d), (u64)16);
    result &= Test("offsetof_cflat_generic", offsetof(T38Box<double>, value), (u64)8);
    result &= Test("offsetof_cflat_union", offsetof(UnionIntFloat, f), (u64)0);
    result &= Test("offsetof_cflat_aligned", offsetof(T38Aligned, d), (u64)8);
    result &= Test("offsetof_cflat_namespace", offsetof(T38Ns.Record, d), (u64)8);
    result &= Test("offsetof_cflat_alias", offsetof(T38PaddedAlias, d), (u64)8);
    result &= Test("offsetof_builtin_spelling", __builtin_offsetof(T38Padded, d), (u64)8);
    result &= Test("offsetof_builtin_const_spelling", __builtin_offsetof(const T38Padded, d), (u64)8);
    {
        int offsetof = 3;
        result &= Test("offsetof_variable_name", offsetof, 3);
    }
    {
        T38OffsetNameField named;
        named.offsetof = 4;
        result &= Test("offsetof_field_name", named.offsetof, 4);
    }
    result &= Test("offsetof_parameter_name", t38OffsetParamName(5), 10);
    result &= Test("offsetof_user_function", T38OffsetUser.Invoke(), 23);
    if const (offsetof(T38Padded, d) == 8)
        result &= Test("offsetof_if_const", 1, 1);
    if const (offsetof(T38Box<double>, value) == 8)
        result &= Test("offsetof_generic_if_const", 1, 1);
    return result;
}

// T89: i8* / u8* <-> char* convert only through an explicit cast (char family stage 2).
bool testCharFamilyExplicitCasts()
{
    bool result = true;
    i8[4] raw = default;
    raw[0] = 65;
    i8* bytes = raw;
    char* text = (char*)bytes;
    Assert("char_family_i8_to_char_cast", (int)text[0], 65);
    i8* back = (i8*)text;
    Assert("char_family_char_to_i8_cast", (int)back[0], 65);
    u8* unsignedBytes = (u8*)text;
    char* fromUnsigned = (char*)unsignedBytes;
    Assert("char_family_u8_round_trip", (int)fromUnsigned[0], 65);
    char[4] chars = default;
    chars[1] = 'B';
    char* charView = chars;
    Assert("char_family_same_type_decay", (int)charView[1], 66);
    return result;
}

struct C00ConstCarryStruct
{
    int value = default;
};

struct C00ConstCarryFields
{
    const int whole = default;
    const(int)* wrapped = default;
    (const int)* parenthesized = default;
};

namespace ns
{
    struct S { int value = default; };
}

struct C00ConstCarryWrapperFields
{
    const(unsigned int)* multiword = default;
    (const list<int>)* generic = default;
    const(ns.S)* namespaced = default;
};

const(unsigned int)* c00ConstCarryMultiwordGlobal = default;
(const list<int>)* c00ConstCarryGenericGlobal = default;
const(ns.S)* c00ConstCarryNamespaceGlobal = default;

using C00ConstCarryPointer = int*;
using C00ConstCarryCharPointer = (const char)*;
using C00ConstCarryUIntAlias = unsigned int;
using C00ConstCarryListAlias = list<int>;

int c00ConstCarryParam(const int value, (const int)* p)
{
    return value + *p;
}

int c00ConstCarryMultiwordParam(const(unsigned int)* p) { return (int)*p; }
int c00ConstCarryGenericParam((const list<int>)* p) { return p.count(); }
int c00ConstCarryNamespaceParam(const(ns.S)* p) { return p.value; }
const(unsigned int)* c00ConstCarryMultiwordReturn(uint* p) { return p; }
(const list<int>)* c00ConstCarryGenericReturn(list<int>* p) { return p; }
const(ns.S)* c00ConstCarryNamespaceReturn(ns.S* p) { return p; }
int c00ConstCarryAliasUIntParam(const(C00ConstCarryUIntAlias)* p) { return (int)*p; }
int c00ConstCarryAliasListParam((const C00ConstCarryListAlias)* p) { return p.count(); }

T c00ConstGenericIdentity<T>(T value)
{
    const(T) local = value;
    return (T)local;
}

bool testConstSpellingsParse()
{
    bool result = true;
    const int whole = 7;
    const(int) callWrapped = 8;
    (const int) parenthesized = 9;
    result &= Test("const_whole_word", whole, 7);
    result &= Test("const_function_spelling", callWrapped, 8);
    result &= Test("const_parenthesized_spelling", parenthesized, 9);

    int mutableValue = 10;
    int* p = &mutableValue;
    int* plainCast = (int*)p;
    const int* prefixPointer = p;
    const(int)* wrappedPointer = p;
    (const int)* parenthesizedPointer = p;
    int** mutableDoublePointer = &p;
    const int** wholeConstDoublePointer = mutableDoublePointer;
    (const int*)* innerConstDoublePointer = mutableDoublePointer;
    const(int)** wrappedConstDoublePointer = (const(int)**)mutableDoublePointer;
    const(const(int)*)* nestedConstDoublePointer = mutableDoublePointer;
    (const int)* castParenthesized = ((const int)*)p;
    const(int)* castWrapped = (const(int)*)p;
    (const int)* castPrefix = (const int*)p;
    result &= Test("const_pointer_read", *prefixPointer, 10);
    result &= Test("const_accept_plain_pointer_cast", *plainCast, 10);
    result &= Test("const_accept_plain_pointer_sizeof", (int)sizeof(int*), 8);
    result &= Test("const_accept_prefix_pointer_sizeof", (int)sizeof(const int*), 8);
    result &= Test("const_accept_wrapped_pointer_sizeof", (int)sizeof(const(int)*), 8);
    result &= Test("const_wrapped_pointer_read", *wrappedPointer, 10);
    result &= Test("const_parenthesized_pointer_read", *parenthesizedPointer, 10);
    result &= Test("const_whole_double_pointer_read", **wholeConstDoublePointer, 10);
    result &= Test("const_inner_double_pointer_read", **innerConstDoublePointer, 10);
    result &= Test("const_wrapped_double_pointer_read", **wrappedConstDoublePointer, 10);
    result &= Test("const_nested_double_pointer_read", **nestedConstDoublePointer, 10);
    result &= Test("const_cast_parenthesized", *castParenthesized, 10);
    result &= Test("const_cast_wrapped", *castWrapped, 10);
    result &= Test("const_cast_prefix", *castPrefix, 10);
    result &= Test("const_sizeof_parenthesized", (int)sizeof((const int)*), 8);
    result &= Test("const_sizeof_wrapped", (int)sizeof(const(int)*), 8);

    int[3] values = { 1, 2, 3 };
    const int[3] constValues = values;
    result &= Test("const_array_element", constValues[2], 3);

    C00ConstCarryFields fields;
    fields.wrapped = &mutableValue;
    fields.parenthesized = &mutableValue;
    result &= Test("const_field_value", fields.whole, 0);
    result &= Test("const_pointer_field", *fields.wrapped, 10);
    result &= Test("const_parenthesized_field", *fields.parenthesized, 10);
    result &= Test("const_parameter", c00ConstCarryParam(2, &mutableValue), 12);

    uint wrappedUInt = 31;
    list<int> wrappedList = default;
    wrappedList.add(5);
    ns.S wrappedObject;
    wrappedObject.value = 7;
    C00ConstCarryWrapperFields wrapperFields;
    wrapperFields.multiword = &wrappedUInt;
    wrapperFields.generic = &wrappedList;
    wrapperFields.namespaced = &wrappedObject;
    c00ConstCarryMultiwordGlobal = &wrappedUInt;
    c00ConstCarryGenericGlobal = &wrappedList;
    c00ConstCarryNamespaceGlobal = &wrappedObject;
    result &= Test("const_wrapper_multiword_param", c00ConstCarryMultiwordParam(&wrappedUInt), 31);
    result &= Test("const_wrapper_multiword_return", (int)*c00ConstCarryMultiwordReturn(&wrappedUInt), 31);
    result &= Test("const_wrapper_multiword_field", (int)*wrapperFields.multiword, 31);
    result &= Test("const_wrapper_multiword_global", (int)*c00ConstCarryMultiwordGlobal, 31);
    result &= Test("const_wrapper_generic_param", c00ConstCarryGenericParam(&wrappedList), 1);
    result &= Test("const_wrapper_generic_return", c00ConstCarryGenericReturn(&wrappedList).count(), 1);
    result &= Test("const_wrapper_generic_field", wrapperFields.generic.count(), 1);
    result &= Test("const_wrapper_generic_global", c00ConstCarryGenericGlobal.count(), 1);
    result &= Test("const_wrapper_namespace_param", c00ConstCarryNamespaceParam(&wrappedObject), 7);
    result &= Test("const_wrapper_namespace_return", c00ConstCarryNamespaceReturn(&wrappedObject).value, 7);
    result &= Test("const_wrapper_namespace_field", wrapperFields.namespaced.value, 7);
    result &= Test("const_wrapper_namespace_global", c00ConstCarryNamespaceGlobal.value, 7);
    result &= Test("const_wrapper_alias_multiword_param", c00ConstCarryAliasUIntParam(&wrappedUInt), 31);
    result &= Test("const_wrapper_alias_generic_param", c00ConstCarryAliasListParam(&wrappedList), 1);

    const C00ConstCarryPointer wholeAlias = &mutableValue;
    result &= Test("const_alias_pointer", *wholeAlias, 10);
    result &= Test("const_generic_T_value", c00ConstGenericIdentity<int>(14), 14);
    int* genericPointer = c00ConstGenericIdentity<int*>(p);
    result &= Test("const_generic_T_pointer", *genericPointer, 10);

    list<(const char)*> pointerList;
    result &= Test("const_generic_argument", pointerList.count(), 0);
    list<int> listValue = default;
    list<int>* listPointer = &listValue;
    list<int>* listPointerCast = (list<int>*)listPointer;
    result &= Test("const_accept_generic_pointer_cast", listPointerCast == nullptr ? 0 : 1, 1);
    result &= Test("const_accept_generic_pointer_sizeof", (int)sizeof(list<int>*), 8);

    char[4] chars = default;
    chars[0] = 'A';
    chars[1] = 'B';
    C00ConstCarryCharPointer charAlias = chars;
    (const char)* scan = charAlias;
    int sum = 0;
    while (*scan != 0)
    {
        sum += *scan;
        scan++;
    }
    result &= Test("const_pointer_scan", sum, 131);

    C00ConstCarryStruct value;
    value.value = 13;
    const C00ConstCarryStruct wholeStruct = value;
    result &= Test("const_struct_value", wholeStruct.value, 13);
    (int,int) tupleValue = default;
    result &= Test("const_wrapper_tuple_parameter", c00ConstTupleParam(tupleValue), 0);
    result &= Test("const_wrapper_tuple_pointer_parameter",
        c00ConstTuplePointerParam(&tupleValue), 0);
    result &= Test("const_wrapper_tuple_pack_local", c00ConstTuplePackLocal(), 0);
    return result;
}

int c00ConstTupleParam(const((int,int)) p) { return (int)sizeof(p) - 8; }
int c00ConstTuplePointerParam(const((int,int))* p) { return (int)sizeof(p) - 8; }
int c00ConstTuplePackParam(const((int...)) p) { return 0; }
int c00ConstTuplePackLocal() { const((int...)) p = default; return 0; }

// Const phase 1 (plan cflat-const.md): const objects are read-only and fold like file-scope consts.
const int C01Limit = 4;
// Enumerators are scoped (c01LocalE.c01EnumV): a bare c01EnumV is this global, as with a C++ enum class.
const int c01EnumV = 9;
const int[3] C01Table = { 10, 20, 30 };
namespace c01ns { const int Depth = 6; }
struct C01Buf<T, int N> { T[N] data = default; int cap() { return N; } };
struct C01Pair { int a = 0; int[2] arr = default; };
string c01Consume(move string s) { return s; }
int c01ParamRead(const int v, const C01Pair p) { return v + p.a + p.arr[1]; }
int c01ViewSum((const int)* p, int n) { int s = 0; for (int i = 0; i < n; i++) { s += *p; p++; } return s; }

bool testConstObjects()
{
    bool result = true;
    const int localLimit = 3;
    int copy = C01Limit;
    copy++;
    result &= Test("const_obj_read", C01Limit + localLimit + c01ns.Depth, 13);
    result &= Test("const_obj_copy_out", copy, 5);
    result &= Test("const_obj_global_array", C01Table[2], 30);
    const int* globalAddr = &C01Limit;
    (const int)* localAddr = &localLimit;
    auto deduced = &localLimit;
    result &= Test("const_obj_address_global", *globalAddr, 4);
    result &= Test("const_obj_address_local", *localAddr + *deduced, 6);
    int[localLimit] dims = default;
    result &= Test("const_obj_local_dim", (int)sizeof(dims), 12);
    C01Buf<int, localLimit> buf = default;
    result &= Test("const_obj_local_generic_arg", buf.cap(), 3);
    int[3] data = { 1, 2, 3 };
    (const int)* walk = data;
    walk++;
    result &= Test("const_obj_view_reseat", *walk, 2);
    result &= Test("const_obj_view_param", c01ViewSum(data, 3), 6);
    C01Pair pair = default;
    pair.a = 2;
    pair.arr[1] = 5;
    result &= Test("const_obj_param_read", c01ParamRead(1, pair), 8);
    const C01Pair whole = pair;
    C01Pair copied = whole;
    copied.a = 9;
    result &= Test("const_obj_struct_copy_out", whole.a + copied.a, 11);
    const string owned = "const";
    result &= Test("const_obj_last_use_consume", (int)c01Consume(owned).length(), 5);
    const int c01a = 3;
    const int c01b = c01a + 1;
    C01Buf<int, c01b> chained = default;
    result &= Test("const_obj_fold_chain", chained.cap(), 4);
    const int c01Shadow = 2;
    const int c01Next = c01Shadow * 3;
    C01Buf<int, c01Next> shadowed = default;
    result &= Test("const_obj_fold_shadow", shadowed.cap(), 6);
    C01Pair mutablePair = default;
    int[2] mutableArr = { 1, 2 };
    int target = 0;
    int* sink = &target;
    Lambda<int()> writer = () => { mutablePair.a = 4; mutableArr[1] = 5; *sink = 6; return mutableArr[1]; };
    int wrote = writer();
    result &= Test("const_obj_capture_mutable", mutablePair.a + wrote + target, 15);
    Lambda<int()> reader = () => { return whole.a + localLimit; };
    result &= Test("const_obj_capture_read", reader(), 5);
    int forCap = 0;
    for (const int c01ForU = 3; forCap == 0;) { C01Buf<int, c01ForU> fb = default; forCap = fb.cap(); }
    result &= Test("const_obj_fold_for_init", forCap, 3);
    forCap = 0;
    for (const int c01ForN = 3; forCap == 0;) { C01Buf<int, c01ForN> fb = default; forCap = fb.cap(); }
    result &= Test("const_obj_fold_for_init_shadow", forCap, 3);
    forCap = 0;
    for (const int c01ForK = 2, c01ForN = c01ForK + 1; forCap == 0;) { C01Buf<int, c01ForN> fb = default; forCap = fb.cap(); }
    result &= Test("const_obj_fold_for_init_sibling", forCap, 3);
    const int c01SibU = 3, c01SibV = c01SibU + 1;
    C01Buf<int, c01SibV> sibU = default;
    result &= Test("const_obj_fold_sibling", sibU.cap(), 4);
    const int c01SibA = 3, c01SibB = c01SibA + 1;
    C01Buf<int, c01SibB> sibA = default;
    result &= Test("const_obj_fold_sibling_shadow", sibA.cap(), 4);
    const int c01CapU = 3;
    Lambda<int()> capU = () => { const int k = c01CapU + 1; C01Buf<int, k> cb = default; return cb.cap(); };
    result &= Test("const_obj_fold_capture", capU(), 4);
    const int c01CapN = 3;
    Lambda<int()> capN = () => { const int k = c01CapN + 2; C01Buf<int, k> cb = default; return cb.cap(); };
    result &= Test("const_obj_fold_capture_shadow", capN(), 5);
    enum c01LocalE : int { c01EnumV = 3 };
    c01LocalE localEnum = default;
    result &= Test("const_obj_local_enum_type", (int)sizeof(localEnum), 4);
    const int c01EnumK = c01EnumV + 1;
    C01Buf<int, c01EnumK> enumBuf = default;
    result &= Test("const_obj_fold_scoped_enumerator", enumBuf.cap(), 10);
    return result;
}

// Same name as a const local in testConstObjects: the local must win when folding.
const int c01Shadow = 9;
const int c01ForN = 9;
const int c01SibA = 9;
const int c01CapN = 9;

// Const phase 2 (plan cflat-const.md): a const field is set only during construction, a struct
// holding one is never whole-assigned, and const reaches through a const struct's pointers.
struct C02Stamp
{
    const int id = 0;
    int hits = 0;
    const int tag = 5;
    C02Stamp(int i) { id = i; this.hits = 1; }
    int Get() { return id + tag; }
};
struct C02Own { const int id = 0; C02Own() { id = 8; } };
struct C02Rec { const int id = 1; int n = 0; };
struct C02Wrap { C02Stamp s = C02Stamp(4); int k = 0; C02Wrap(int i) { k = i; } };
struct C02Box<T> { const T v = default; int n = 0; C02Box(T x) { v = x; } };
struct C02Self { const int id = 0; int peer = 0; C02Self(int i) { id = i; C02Self other = C02Self(); peer = other.id; } };
struct C02Ptrs { int n = 0; int* p = nullptr; };
struct C02Holder { (const C02Ptrs)* p = nullptr; };
struct C02Gen<T> { T value = default; };
struct C02Plain { int n = 0; };
using C02StampAlias = C02Stamp;
using C02GenAlias = C02Gen<C02Stamp>;
using C02PlainAlias = C02Plain;
namespace c02ns { struct Wrap<T> { T value = default; }; }
using c02n = c02ns;
namespace c02outer
{
    namespace ns { struct Wrap<T> { T value = default; }; }
    int relativeConst() { return is_assignable(ns.Wrap<C02Stamp>) ? 1 : 0; }
    int relativeConstGrouped() { return is_assignable((ns.Wrap<C02Stamp>)) ? 1 : 0; }
    int relativePlain() { return is_assignable(ns.Wrap<int>) ? 1 : 0; }
    int relativePlainGrouped() { return is_assignable((ns.Wrap<int>)) ? 1 : 0; }
}
int c02AliasNsConst() { return is_assignable(c02n.Wrap<C02Stamp>) ? 1 : 0; }
int c02AliasNsConstGrouped() { return is_assignable((c02n.Wrap<C02Stamp>)) ? 1 : 0; }
int c02AliasNsPlain() { return is_assignable(c02n.Wrap<int>) ? 1 : 0; }
int c02AliasNsPlainGrouped() { return is_assignable((c02n.Wrap<int>)) ? 1 : 0; }
C02Stamp c02Make(int i) { C02Stamp r = C02Stamp(i); return r; }
int c02Take(C02Stamp s) { return s.id; }
int c02Borrow(alias C02Stamp s) { return s.id + s.hits; }
int c02ReadThrough(const C02Ptrs* ps) { return ps->n + *ps->p; }
int c02ReadView((const C02Ptrs)* ps) { return ps->n; }

bool testConstFields()
{
    bool result = true;
    C02Stamp stamp = C02Stamp(7);
    stamp.hits++;
    result &= Test("const_field_ctor_set", stamp.id, 7);
    result &= Test("const_field_default", stamp.tag, 5);
    result &= Test("const_field_sibling_writable", stamp.hits, 2);
    result &= Test("const_field_method_read", stamp.Get(), 12);
    C02Own own = C02Own();
    result &= Test("const_field_noarg_ctor_body", own.id, 8);
    C02Rec rec = { id = 4, n = 2 };
    C02Rec recDefault = default;
    result &= Test("const_field_brace_init", rec.id + rec.n, 6);
    result &= Test("const_field_brace_default", recDefault.id, 1);
    C02Stamp copied = stamp;
    C02Stamp moved = move copied;
    result &= Test("const_field_copy_move_construct", moved.id, 7);
    result &= Test("const_field_return_by_value", c02Make(3).id, 3);
    result &= Test("const_field_by_value_arg", c02Take(stamp) + c02Borrow(stamp), 16);
    C02Wrap wrap = C02Wrap(2);
    wrap.s.hits = 3;
    result &= Test("const_field_embedded", wrap.s.id + wrap.s.hits + wrap.k, 9);
    C02Box<int> box = C02Box<int>(6);
    result &= Test("const_field_generic_ctor", box.v, 6);
    C02Self self = C02Self(9);
    result &= Test("const_field_ctor_local_peer", self.id + self.peer, 9);
    C02Stamp* ps = &stamp;
    ps->hits = 8;
    result &= Test("const_field_through_mutable_pointer", ps->id + stamp.hits, 15);
    // Transitive const: a copy out is writable; reads through the const object stay legal.
    int target = 1;
    const C02Ptrs cbox = { n = 5, p = &target };
    C02Ptrs boxCopy = cbox;
    boxCopy.n = 6;
    result &= Test("const_struct_read_through", cbox.n + *cbox.p, 6);
    result &= Test("const_struct_copy_writable", boxCopy.n, 6);
    result &= Test("const_struct_read_param", c02ReadThrough(&boxCopy) + c02ReadView(&boxCopy), 13);
    (const C02Ptrs)* view = &cbox;
    view = &boxCopy;
    result &= Test("const_struct_view_reseat", view->n, 6);
    // An explicit cast drops const (R7 A).
    const C02Ptrs* constPs = &boxCopy;
    ((C02Ptrs*)constPs)->n = 7;
    result &= Test("const_cast_drops_pointee", boxCopy.n, 7);
    C02Holder holder = { p = &boxCopy };
    ((C02Ptrs*)holder.p)->n = 8;
    result &= Test("const_cast_drops_field_pointee", boxCopy.n, 8);
    ((C02Ptrs*)((const C02Ptrs*)constPs))->n = 9;
    result &= Test("const_cast_outer_drop_wins", boxCopy.n, 9);
    result &= Test("const_field_containers", c02Containers(), 0);
    result &= Test("const_field_is_assignable", c02Assignable<int>() + c02Assignable<C02Ptrs>() + c02Assignable<C02Stamp*>(), 3);
    result &= Test("const_field_not_assignable", c02Assignable<C02Stamp>() + c02Assignable<C02Wrap>(), 0);
    int acceptedSpellings = (is_assignable(C02Plain) ? 1 : 0) + (is_assignable((C02Plain)) ? 1 : 0)
        + (is_assignable(C02PlainAlias) ? 1 : 0) + (is_assignable((C02PlainAlias)) ? 1 : 0)
        + (is_assignable(C02Gen<int>) ? 1 : 0) + (is_assignable((C02Gen<int>)) ? 1 : 0);
    result &= Test("const_field_is_assignable_accept_set", acceptedSpellings, 6);
    result &= Test("const_field_is_assignable_grouped_struct", is_assignable((C02Stamp)) ? 1 : 0, 0);
    result &= Test("const_field_is_assignable_grouped_alias", is_assignable((C02StampAlias)) ? 1 : 0, 0);
    result &= Test("const_field_is_assignable_grouped_generic", is_assignable((C02Gen<C02Stamp>)) ? 1 : 0, 0);
    result &= Test("const_field_is_assignable_grouped_generic_alias", is_assignable((C02GenAlias)) ? 1 : 0, 0);
    result &= Test("const_field_is_assignable_grouped_namespace_generic", is_assignable((c02ns.Wrap<C02Stamp>)) ? 1 : 0, 0);
    result &= Test("const_field_is_assignable_nested_grouping", is_assignable(((C02Stamp)) ) ? 1 : 0, 0);
    result &= Test("const_field_is_assignable_grouped_substitution", c02GroupedAssignable<C02Stamp>(), 0);
    result &= Test("const_field_is_assignable_grouped_substitution_plain", c02GroupedAssignable<int>(), 1);
    result &= Test("const_field_is_assignable_namespace_alias", c02AliasNsConst(), 0);
    result &= Test("const_field_is_assignable_namespace_alias_grouped", c02AliasNsConstGrouped(), 0);
    result &= Test("const_field_is_assignable_namespace_alias_plain", c02AliasNsPlain(), 1);
    result &= Test("const_field_is_assignable_namespace_alias_plain_grouped", c02AliasNsPlainGrouped(), 1);
    result &= Test("const_field_is_assignable_relative_namespace", c02outer.relativeConst(), 0);
    result &= Test("const_field_is_assignable_relative_namespace_grouped", c02outer.relativeConstGrouped(), 0);
    result &= Test("const_field_is_assignable_relative_namespace_plain", c02outer.relativePlain(), 1);
    result &= Test("const_field_is_assignable_relative_namespace_plain_grouped", c02outer.relativePlainGrouped(), 1);
    int direct = (is_assignable(C02Gen<C02Stamp>) ? 0 : 1) + (is_assignable(C02Gen<int>) ? 1 : 0) + (is_assignable(C02Box<int>) ? 0 : 1);
    result &= Test("const_field_is_assignable_generic_spelling", direct, 3);
    // An alias and a namespaced generic with no other instantiating use resolve like sizeof's operand.
    int spelled = (is_assignable(C02StampAlias) ? 0 : 1) + (is_assignable(C02GenAlias) ? 0 : 1)
        + (is_assignable(c02ns.Wrap<C02Stamp>) ? 0 : 1) + (is_assignable(c02ns.Wrap<int>) ? 1 : 0);
    result &= Test("const_field_is_assignable_alias_namespace", spelled, 4);
    return result;
}

import "hashset.cb";
import "queue.cb";
struct C02Key
{
    const int id = 0;
    C02Key(int i) { id = i; }
    int hash() { return id; }
    bool operator==(C02Key o) { return id == o.id; }
};
int c02Assignable<T>() { if const (is_assignable(T)) return 1; else return 0; }
int c02GroupedAssignable<T>() { if const (is_assignable((T))) return 1; else return 0; }
// Containers relocate by construction, so a const-field element type is storable.
int c02Containers()
{
    int bad = 0;
    list<C02Stamp> l = default;
    int i = 0;
    while (i < 12) { l.add(C02Stamp(i)); i++; }
    int sum = 0;
    for (C02Stamp s in l) sum += s.id;
    if (sum != 66 || l[5].id != 5) bad += 1;
    queue<C02Stamp> q = default;
    i = 0;
    while (i < 12) { q.enqueue(C02Stamp(i)); i++; }
    if (q.dequeue().id != 0 || q.count() != 11) bad += 2;
    hashset<C02Key> hs = default;
    i = 0;
    while (i < 30) { hs.add(C02Key(i)); i++; }
    if (!hs.contains(C02Key(21)) || hs.contains(C02Key(40)) || hs.count() != 30) bad += 4;
    return bad;
}

// Const phase 3 (plan cflat-const.md): pointee const. Writes through a pointer to const are
// refused at every level, and an implicit conversion may add const but never discard it.
const int[3] C03GlobalTable = { 10, 20, 30 };
struct C03Box { int n = 0; int* p = nullptr; };
using C03CStr = (const char)*;
using C03IntPtr = int*;
int c03Length((const char)* s) { int n = 0; while (*s) { s++; n++; } return n; }
int c03ParamValue(const int v) { return v * 2; }
int c03ParamWhole(const int* p) { return p[0] + p[1]; }
int c03ParamView((const int)* p) { int s = 0; for (int i = 0; i < 2; i++) { s += *p; p++; } return s; }
int c03ParamStruct(const C03Box b) { return b.n + *b.p; }
int c03ParamAlias(const C03IntPtr p) { return p[0]; }
int c03ParamDefault(const int scale = 3) { return scale; }
void c03ParamWriteThrough(int* p) { p[0] = 99; }
int c03ReadDouble((const int*)* pp) { return **pp; }
(const int)* c03Pass((const int)* p) { return p; }
int c03Pick(int* p) { return 1; }
int c03Pick(const(void)* p) { return 2; }
int c03ReadAlias(const alias int r) { return r; }
const(void)* c03Opaque((const int)* p) { return p; }
// Round 2: views carry element const, `alias T*` copies the pointer with its qualification, and
// `using` captures a whole-word const type.
using C03FixedInts = const int*;
using C03ConstIntPtr = const C03IntPtr;
int c03FixedParam(C03FixedInts p) { return p[1]; }
int c03ViewSum(const int[] v) { return v[0] + v[1]; }
void c03ViewFill(int[] v) { v[0] = 7; }
void c03AliasPtrWrite(alias int* r) { *r = 8; }
int c03AliasPtrRead(alias (const int)* r) { return *r; }
expect_error("it is reached through a pointer to const") {
    int c03BadFixedParam(C03FixedInts p) { p[0] = 1; return 0; }
}

bool testConstPointee()
{
    bool result = true;
    int[3] data = { 1, 2, 3 };
    int* raw = data;

    // `const int* p` = const(int*): neither p nor *p may change.
    const int* fixedView = raw;
    result &= Test("const_pointee_whole_read", fixedView[1], 2);
    expect_error("it is reached through a pointer to const") { *fixedView = 5; }
    expect_error("it is reached through a pointer to const") { fixedView[2] = 5; }

    // `(const int)*` and `const(int)*`: reseatable view, read-only target.
    (const int)* walk = raw;
    const(int)* walk2 = raw;
    int sum = 0;
    for (int i = 0; i < 3; i++) { sum += *walk; walk++; }
    walk2 = walk2 + 2;
    result &= Test("const_pointee_view_scan", sum, 6);
    result &= Test("const_pointee_view_reseat", *walk2, 3);
    expect_error("it is reached through a pointer to const") { *walk2 = 7; }
    expect_error("it is reached through a pointer to const") { walk2[0] += 1; }

    // Adding const is implicit, dropping it needs an explicit cast (R7 A).
    (const int)* view = raw;
    int* back = (int*)view;
    back[0] = 11;
    result &= Test("const_pointee_cast_drops", data[0], 11);
    result &= Test("const_pointee_view_sees_write", view[0], 11);
    expect_error("the conversion discards const") { int* bad = view; }
    expect_error("the conversion discards const") { int* bad2 = fixedView; }
    expect_error("the conversion discards const") { void* bad3 = view; }
    const(void)* opaque = view;
    result &= Test("const_pointee_void_view", opaque != nullptr, true);
    result &= Test("const_pointee_void_return", c03Opaque(view) == opaque, true);
    (const int)* passed = c03Pass(raw);
    result &= Test("const_pointee_return_adds", passed[2], 3);
    (const int)* arith = view + 1;
    result &= Test("const_pointee_arith_keeps_view", *arith, 2);
    bool pick = data[2] == 3;
    (const int)* joined = pick ? raw : view;
    result &= Test("const_pointee_ternary_join", *joined, 11);
    C03Box box = { n = 1, p = raw };
    const C03Box constBox = { n = 2, p = raw };
    (const int)* fromConstBox = constBox.p;
    int* fromConstBoxCast = (int*)constBox.p;
    *((int*)constBox.p) = 12;
    result &= Test("const_pointee_transitive_read", *fromConstBox, 12);
    result &= Test("const_pointee_transitive_cast", fromConstBoxCast == raw, true);
    expect_error("the conversion discards const") { int* bad4 = constBox.p; }

    // Multi-level. `(const int*)* pp`: pp reseatable, *pp fixed, **pp read-only.
    const int* slotA = raw;
    (const int*)* pp = &slotA;
    result &= Test("const_pointee_multi_read", **pp, 12);
    const(int)** pp2 = nullptr;
    (const int)* cursor = raw;
    pp2 = &cursor;
    *pp2 = *pp2 + 1;
    result &= Test("const_pointee_multi_inner_reseat", **pp2, 2);
    int** mutablePP = &raw;
    (const int*)* addedBoth = mutablePP;
    result &= Test("const_pointee_multi_add_both", c03ReadDouble(mutablePP) + **addedBoth, 24);
    expect_error("it is reached through a pointer to const") { *pp = raw; }
    expect_error("it is reached through a pointer to const") { **pp2 = 0; }
    expect_error("the conversion discards const") { int** ppBad = &raw; (const int)** ppView = ppBad; }

    // `using` captures the const word: the conversions behave as spelled out.
    C03CStr aliasView = "alias";
    const C03IntPtr aliasFixed = raw;
    const C03IntPtr aliasConstPtr = raw;
    using C03LocalView = const(int)*;
    C03LocalView localView = raw;
    localView++;
    result &= Test("const_pointee_using_view", c03Length(aliasView), 5);
    result &= Test("const_pointee_using_fixed", aliasFixed[1] + aliasConstPtr[0], 14);
    result &= Test("const_pointee_using_local_view", *localView, 2);
    expect_error("it is reached through a pointer to const") { aliasFixed[0] = 1; }
    expect_error("it is reached through a pointer to const") { *aliasConstPtr = 1; }
    expect_error("it is reached through a pointer to const") { *localView = 1; }
    expect_error("the conversion discards const") { C03IntPtr dropped = localView; }

    // Parameters mirror variables; top-level const is the callee's own.
    const int localLimit = 3;
    const int* argFixed = raw;
    (const int)* argView = raw;
    result &= Test("const_pointee_param_value", c03ParamValue(localLimit), 6);
    result &= Test("const_pointee_param_whole", c03ParamWhole(raw), 14);
    result &= Test("const_pointee_param_fixed_into_view", c03ParamView(argFixed), 14);
    result &= Test("const_pointee_param_view_into_whole", c03ParamWhole(argView), 14);
    result &= Test("const_pointee_param_struct", c03ParamStruct(box), 13);
    result &= Test("const_pointee_param_alias", c03ParamAlias(raw), 12);
    result &= Test("const_pointee_param_default", c03ParamDefault(), 3);
    result &= Test("const_pointee_param_global_table", c03ParamWhole(C03GlobalTable), 30);
    c03ParamWriteThrough(raw);
    result &= Test("const_pointee_param_mutable_arg", data[0], 99);
    expect_error("cannot pass argument 1 ('(const int)*') to parameter 'p' ('int*'): the conversion discards const")
    {
        c03ParamWriteThrough(argView);
    }
    expect_error("the conversion discards const") { c03ParamWriteThrough(argFixed); }
    expect_error("the conversion discards const") { c03ParamWriteThrough(C03GlobalTable); }

    // A candidate that would discard const is not viable: the read-only one is chosen (clang).
    result &= Test("const_pointee_overload_mutable", c03Pick(raw), 1);
    result &= Test("const_pointee_overload_const", c03Pick(argView), 2);
    const alias int constBound = localLimit;
    result &= Test("const_pointee_const_alias_binds", constBound + c03ReadAlias(localLimit), 6);

    // Views: the element qualification converts like a pointer's; a cast may drop it.
    int[] mutableElems = data;
    const int[] readElems = data;
    result &= Test("const_pointee_view_read", c03ViewSum(readElems) + c03ViewSum(mutableElems), 2 * (data[0] + data[1]));
    int[] castElems = (int[])readElems;
    castElems[1] = 5;
    result &= Test("const_pointee_view_cast_drops", data[1], 5);
    c03ViewFill(mutableElems);
    result &= Test("const_pointee_view_mutable_param", data[0], 7);
    expect_error("cannot convert 'const int[]' to 'int[]': the conversion discards const") { int[] dropped = readElems; }
    expect_error("cannot convert 'const int[]' to 'int[]'") { mutableElems = readElems; }
    expect_error("cannot pass argument 1 ('const int[]') to parameter 'v' ('int[]')") { c03ViewFill(readElems); }
    expect_error("it is reached through a pointer to const") { readElems[0] = 1; }

    // `alias T*` binds a copy of the pointer: the pointee qualification follows it.
    int* writable = raw;
    c03AliasPtrWrite(writable);
    alias (const int)* aliasRead = raw;
    result &= Test("const_pointee_alias_pointer", c03AliasPtrRead(argView) + *aliasRead, 16);
    expect_error("cannot convert '(const int)*' to 'int*'") { alias int* aliasDropped = argView; }
    expect_error("cannot pass argument 1 ('(const int)*') to parameter 'r' ('int*')") { c03AliasPtrWrite(argView); }
    expect_error("it is reached through a pointer to const") { *aliasRead = 1; }

    // `using` keeps a whole-word const: `const W` covers every level of W.
    C03FixedInts usingFixed = raw;
    C03ConstIntPtr usingWhole = raw;
    using C03LocalFixed = const int*;
    C03LocalFixed usingLocal = raw;
    result &= Test("const_pointee_using_fixed", usingFixed[1] + c03FixedParam(raw) + usingWhole[1] + usingLocal[1], 20);
    expect_error("cannot assign to 'usingFixed': it is declared const") { usingFixed = raw; }
    expect_error("it is reached through a pointer to const") { usingFixed[0] = 1; }
    expect_error("cannot increment 'usingWhole': it is declared const") { usingWhole++; }
    expect_error("it is reached through a pointer to const") { *usingWhole = 1; }
    expect_error("it is reached through a pointer to const") { *usingLocal = 1; }
    expect_error("the conversion discards const") { C03IntPtr dropped = usingFixed; }
    return result;
}

// Const receivers (phase 4): read-only-ness of a native method is inferred from its body.
struct C04Box
{
    int n = 0;
    int* p = nullptr;
    int Get() { return n; }             // read-only by inference: callable on a const box
    void Set(int v) { n = v; }          // writes this->n: not callable on a const box
    int Peek() { return *p; }           // reads through p only: read-only
    void Poke(int v) { *p = v; }        // writes through p: not read-only (transitive const)
    int Both() { return Get() + Peek(); }
    void Reset() { Set(0); }            // calls a mutating helper
    int Even(int k) { if (k == 0) return n; return Odd(k - 1); }
    int Odd(int k) { if (k == 0) return n + 1; return Even(k - 1); }
};
struct C04Cell<T>
{
    T v = default;
    T Read() { return v; }
    int Clear() { if const (is_pointer(T)) { v = nullptr; return 1; } else return 0; }
};
int c04ParamGet(const C04Box b) { return b.Get() + b.Peek(); }
expect_error("cannot call non-const member 'Set' on 'b': it is declared const")
{
    int c04BadParamMethod(const C04Box b) { b.Set(2); return 0; }
}

bool testConstReceivers()
{
    bool result = true;
    int target = 1;
    const C04Box box = { n = 5, p = &target };
    C04Box boxCopy = box;                               // copy out is fine and writable
    boxCopy.Set(6);
    result &= Test("const_receiver_readonly_method", box.Get(), 5);
    result &= Test("const_receiver_readonly_through_ptr", box.Peek(), 1);
    result &= Test("const_receiver_copy_writable", boxCopy.Get(), 6);
    result &= Test("const_receiver_calls_readonly", box.Both(), 6);
    result &= Test("const_receiver_mutual_recursion", box.Even(3) + box.Odd(2), 12);
    result &= Test("const_receiver_param", c04ParamGet(box), 6);
    (const C04Box)* view = &boxCopy;
    result &= Test("const_receiver_through_pointer", view->Get(), 6);
    expect_error("cannot call non-const member 'Set' on 'box': it is declared const") { box.Set(1); }
    expect_error("cannot call non-const member 'Poke' on 'box': it is declared const") { box.Poke(1); }
    expect_error("cannot call non-const member 'Reset' on 'box': it is declared const") { box.Reset(); }
    expect_error("cannot call non-const member 'Set' on 'view'") { view->Set(1); }

    // Generic methods are judged per instantiation: Clear writes only when T is a pointer.
    const C04Cell<int> cell = { v = 7 };
    const C04Cell<int*> ptrCell = { v = &target };
    result &= Test("const_receiver_generic", cell.Read() + cell.Clear() + *ptrCell.Read(), 8);
    expect_error("cannot call non-const member 'Clear' on 'ptrCell': it is declared const") { ptrCell.Clear(); }

    // Core containers on a const receiver: reads and iteration work, mutation is refused.
    list<int> raw;
    raw.add(3);
    raw.add(4);
    const list<int> numbers = raw.copy();
    int sum = 0;
    for (int x in numbers) sum += x;
    result &= Test("const_receiver_list", numbers.count() + numbers.get(0) + numbers[1] + sum, 16);
    expect_error("cannot call non-const member 'add' on 'numbers': it is declared const") { numbers.add(5); }
    string hello = "hello";
    const string word = hello.copy();
    result &= Test("const_receiver_string", word.length() + (word == "hello" ? 1 : 0) + (word.startsWith("he") ? 1 : 0), 7);
    return result;
}

// Const receivers, round 2: the overload codegen selects decides a dependency, a by-value `auto`
// copy is not the object, a dead `if const` arm writes nothing.
struct C04R2Inner { int n = 3; };
struct C04R2
{
    int n = 3;
    C04R2Inner inner;
    int F(int k) { return n + k; }
    int F(double k) { n = 99; return n; }
    int ReadOverload() { return F(4); }
    int ReadCopy() { auto t = this->inner; t.n = 7; return t.n; }
    int ReadDead() { if const (false) { n = 9; } return n; }
};

bool testConstReceiversRound2()
{
    bool result = true;
    const C04R2 s = default;
    result &= Test("const_receiver_overload", s.ReadOverload(), 7);
    result &= Test("const_receiver_auto_copy", s.ReadCopy() * 10 + s.inner.n, 73);
    result &= Test("const_receiver_dead_arm", s.ReadDead(), 3);
    return result;
}

// Const receivers, round 3: #8 is decided after every body is emitted, so a call that comes
// before its callee's body sees the live `if const` arm and codegen's chosen overloads; an
// `alias` result rooted in a global is not the receiver's storage.
struct C04R3Inner { int n = 3; };
C04R3Inner c04R3Global = {};
int c04R3Pick(const int* p, int k) { return *p + 4; }
int c04R3Pick(int* p, double k) { *p = 99; return *p; }
struct C04R3
{
    int n = 3;
    int InvokeEscape(const C04R3 s) { return s.ReadEscape(); }
    int InvokeOverload(const C04R3 s) { return s.ReadOverload(); }
    int InvokeDead(const C04R3 s) { return s.ReadDead(); }
    int ReadEscape() { return c04R3Pick(&n, 1); }
    int F(int k) { return n + k; }
    int F(double k) { n = 99; return n; }
    int ReadOverload() { return F(4); }
    int ReadDead() { if const (false) { n = 9; } return n; }
    int operator+(int k) { return n + k; }
    int operator+(double k) { n = 99; return n; }
    int ReadOperator() { return *this + 4; }
    alias C04R3Inner Shared() { return c04R3Global; }
    void WriteShared() { Shared().n = 9; }
};

bool testConstReceiversRound3()
{
    bool result = true;
    C04R3 m = default;
    const C04R3 s = default;
    result &= Test("const_receiver_late_escape", m.InvokeEscape(m), 7);
    result &= Test("const_receiver_late_overload", m.InvokeOverload(m), 7);
    result &= Test("const_receiver_late_dead_arm", m.InvokeDead(m), 3);
    result &= Test("const_receiver_binary_overload", s.ReadOperator(), 7);
    s.WriteShared();
    result &= Test("const_receiver_external_alias", c04R3Global.n * 10 + s.n, 93);
    return result;
}

// Const receivers, round 4: an `alias` result joins the provenance of both ternary arms, a deep
// chain of getters resolves as a fixed point, and a reassigned inner local does not taint a param.
struct C04R4Inner { int n = 3; };
C04R4Inner c04R4G = {};
C04R4Inner c04R4H = {};
C04R4Inner c04R4Deep = {};
int c04R4Int = 3;
struct C04R4
{
    int n = 0;
    alias C04R4Inner Pick(bool b) { return b ? c04R4G : c04R4H; }
    void WriteTernary() { Pick(true).n = 9; }
    alias C04R4Inner Get0() { return c04R4Deep; }
    alias C04R4Inner Get1() { return Get0(); }
    alias C04R4Inner Get2() { return Get1(); }
    alias C04R4Inner Get3() { return Get2(); }
    alias C04R4Inner Get4() { return Get3(); }
    alias C04R4Inner Get5() { return Get4(); }
    alias C04R4Inner Get6() { return Get5(); }
    alias C04R4Inner Get7() { return Get6(); }
    alias C04R4Inner Get8() { return Get7(); }
    alias C04R4Inner Get9() { return Get8(); }
    alias C04R4Inner Get10() { return Get9(); }
    alias C04R4Inner Get11() { return Get10(); }
    alias C04R4Inner Get12() { return Get11(); }
    alias C04R4Inner Get13() { return Get12(); }
    alias C04R4Inner Get14() { return Get13(); }
    alias C04R4Inner Get15() { return Get14(); }
    alias C04R4Inner Get16() { return Get15(); }
    alias C04R4Inner Get17() { return Get16(); }
    alias C04R4Inner Get18() { return Get17(); }
    void WriteDeep() { Get18().n = 9; }
    int* Through(int* p) { { int p = 0; p = 1; } return p; }
    void WriteShadow() { *Through(&c04R4Int) = 9; }
};

bool testConstReceiversRound4()
{
    bool result = true;
    const C04R4 s = default;
    s.WriteTernary();
    result &= Test("const_receiver_external_ternary", c04R4G.n * 10 + c04R4H.n, 93);
    s.WriteDeep();
    result &= Test("const_receiver_deep_external", c04R4Deep.n, 9);
    s.WriteShadow();
    result &= Test("const_receiver_param_shadow", c04R4Int, 9);
    return result;
}

// Const receivers, round 5: a local alias declared in one branch ends with its block, so the
// other branch returns the untouched parameter of the same name.
int c04R5Int = 3;
struct C04R5
{
    int n = 0;
    int* Get(int* p, bool b) { if (b) { auto p = &n; } else { return p; } return p; }
    void Write() { *Get(&c04R5Int, false) = 9; }
};

bool testConstReceiversRound5()
{
    const C04R5 s = default;
    s.Write();
    return Test("const_receiver_param_branch_alias", c04R5Int * 10 + s.n, 90) != 0;
}

// =============================================================
// Const phase 6: a string literal is a `(const char)*` (R2 A, R11)
// =============================================================

// A `(const char)*` param is a reseatable read-only view: the classic scanning loop.
int tcLength((const char)* s)
{
    int n = 0;
    while (*s) { s++; n++; }
    return n;
}

// The same view spelled const(char)*; both spellings are the same type.
int tcLengthCall(const(char)* s) { return tcLength(s); }

// `const char* s` param: s is fixed inside the body, the characters are read-only.
int tcFirst(const char* s) { return (int)s[0]; }

bool testConstStringLiterals()
{
    bool result = true;
    // Leg 6: string literals are `(const char)*` (R2 A).
    (const char)* lit = "const";
    const char* name = "fixed";
    auto deduced = "auto";                              // deduces (const char)*: reseatable
    deduced++;
    result &= Test("const_literal_length", tcLength(lit), 5);
    result &= Test("const_literal_fn_spelling", tcLengthCall("abc"), 3);
    result &= Test("const_literal_first", tcFirst(name), 102);
    result &= Test("const_literal_auto_reseat", (int)*deduced, 117);
    result &= Test("const_literal_typeof", typeof(lit), "(const char)*");
    result &= Test("const_literal_typeof_auto", typeof(deduced), "(const char)*");
    result &= Test("const_literal_typeof_literal", typeof("abc"), "(const char)*");
    char[4] buf = { 'x', 'y', 'z', 0 };
    result &= Test("const_mutable_into_view_param", tcLength(buf), 3);
    expect_error("the conversion discards const") { char* litBad = "nope"; }
    expect_error("it is reached through a pointer to const") { lit[0] = 'C'; }
    expect_error("cannot assign to 'name': it is declared const") { name = "other"; }

    // An array initialized from a literal copies it: the copy is writable.
    char[4] copy = "abc";
    copy[0] = 'X';
    result &= Test("const_literal_array_copy", (int)copy[0] * 1000 + (int)copy[2], 88099);
    // A literal into `string` (operator string) and an array of read-only views.
    string text = "hello";
    result &= Test("const_literal_to_string", text.length(), 5);
    (const char)*[2] names = { "ab", "cde" };
    result &= Test("const_literal_brace_views", tcLength(names[0]) * 10 + tcLength(names[1]), 23);
    expect_error("the conversion discards const") { char*[2] bad = { "a", "b" }; }
    // C variadic and `const char*` params take a literal as before.
    char[16] out = default;
    result &= Test("const_literal_into_variadic", snprintf(out, 16, "%s-%s", "ab", "cd"), 5);
    result &= Test("const_literal_printf_result", (int)out[2], 45);
    string rawConstJson = json_const(RawStringConstFold, { value = rawstrCompileTimeVersion });
    string rawLiteralJson = json_const(RawStringConstFold, { value = r"raw { text }" });
    string rawParenJson = json_const(RawStringConstFold, { value = ("paren text") });
    string rawAdjacentJson = json_const(RawStringConstFold, { value = "adj" "acent" });
    string rawMixedJson = json_const(RawStringConstFold, {
        value = r#"raw"# " " "ordinary" " " r##"end"## });
    string rawParenConstJson = json_const(RawStringConstFold, {
        value = rawstrParenCompileTimeVersion });
    string rawBraceParenJson = json_const(RawStringConstFold, { value = (r"{x}") });
    string rawBraceAdjacentJson = json_const(RawStringConstFold, { value = "a" r"{x}" });
    string rawParenBraceConstJson = json_const(RawStringConstFold, {
        value = rawstrParenBraceCompileTimeVersion });
    string rawRuntimeParenBrace = (r"{x}");
    string rawRuntimeAdjacentBrace = "a" r"{x}";
    string rawXmlParenNamespace = xml_const(RawstrXmlRoot, { node = { xmlns = (r"{x}") } });
    string rawXmlAdjacentNamespace = xml_const(RawstrXmlRoot, {
        node = { xmlns = "a" r"{x}" } });
    string rawRuntimeXmlParenNamespace = (r"{x}");
    string rawRuntimeXmlAdjacentNamespace = "a" r"{x}";
    string rawEncodingJson = json_const(RawStringEncodingFold, {
        a = u8"a", b = u"b", c = U"c", d = L"d" });
    string rawXmlNamespace = xml_const(RawstrXmlRoot, {
        node = { xmlns = ("urn:round3") } });
    string braceFoldJsonSingle = json_const(RawStringConstFold, { value = "a{{b}}" });
    string braceFoldJsonVerbatim = json_const(RawStringConstFold, { value = "{\"a\":1}" });
    string braceFoldJsonAdjacent = json_const(RawStringConstFold,
        { value = "a{{" r"b}}" });
    string braceFoldJsonParen = json_const(RawStringConstFold, { value = ("p{{x}}") });
    string braceFoldJsonEscaped = json_const(RawStringConstFold, { value = "{{x}}" });
    string braceFoldJsonRaw = json_const(RawStringConstFold, { value = r"raw {{x}}" });
    string braceFoldJsonConst = json_const(RawStringConstFold,
        { value = braceFoldCompileTimeVersion });
    string braceFoldJsonMixedConst = json_const(RawStringConstFold,
        { value = braceFoldMixedCompileTimeVersion });
    string braceFoldJsonParenConst = json_const(RawStringConstFold,
        { value = braceFoldParenCompileTimeVersion });
    string braceFoldXmlSingle = xml_const(RawstrXmlRoot,
        { node = { xmlns = "x{{y}}" } });
    string braceFoldXmlAdjacent = xml_const(RawstrXmlRoot,
        { node = { xmlns = "x{{" r"y}}" } });
    string braceFoldXmlParen = xml_const(RawstrXmlRoot,
        { node = { xmlns = ("x{{y}}") } });
    string braceFoldXmlRaw = xml_const(RawstrXmlRoot,
        { node = { xmlns = r"x{{y}}" } });
    string braceFoldWideEncodingJson = json_const(RawStringWideBraceFold, {
        utf16 = u"{{u}}", utf32 = U"{{U}}", wide = L"{{L}}" });
    int braceFoldInterpolation = 7;
    expect_error("json_const initializer must be a compile-time literal") {
        string rejected = json_const(RawStringConstFold,
            { value = "value {braceFoldInterpolation}" });
    }
    expect_error("xml_const initializer must be a compile-time literal") {
        string rejected = xml_const(RawstrXmlRoot,
            { node = { xmlns = "value {braceFoldInterpolation}" } });
    }
    result &= Test("raw_literal_compile_time_string_constant",
        rawConstJson == "{\"value\":\"0.1\\\\raw\"}", true);
    result &= Test("raw_literal_json_const", rawLiteralJson == "{\"value\":\"raw { text }\"}", true);
    result &= Test("raw_paren_json_const", rawParenJson, "{\"value\":\"paren text\"}");
    result &= Test("raw_adjacent_json_const", rawAdjacentJson, "{\"value\":\"adjacent\"}");
    result &= Test("raw_mixed_adjacent_json_const", rawMixedJson,
        "{\"value\":\"raw ordinary end\"}");
    result &= Test("raw_parenthesized_compile_time_string_constant", rawParenConstJson,
        "{\"value\":\"paren text\"}");
    result &= Test("raw_brace_parenthesized_json_const", rawBraceParenJson,
        "{\"value\":\"{x}\"}");
    result &= Test("raw_brace_adjacent_json_const", rawBraceAdjacentJson,
        "{\"value\":\"a{x}\"}");
    result &= Test("raw_brace_parenthesized_compile_time_constant", rawParenBraceConstJson,
        "{\"value\":\"{x}\"}");
    result &= Test("raw_brace_parenthesized_matches_runtime",
        rawBraceParenJson == "{\"value\":\"" + rawRuntimeParenBrace + "\"}", true);
    result &= Test("raw_brace_adjacent_matches_runtime",
        rawBraceAdjacentJson == "{\"value\":\"" + rawRuntimeAdjacentBrace + "\"}", true);
    result &= Test("raw_xml_parenthesized_namespace", rawXmlParenNamespace,
        r#"<node xmlns="{x}"/>"#);
    result &= Test("raw_xml_adjacent_namespace", rawXmlAdjacentNamespace,
        r#"<node xmlns="a{x}"/>"#);
    result &= Test("raw_xml_parenthesized_matches_runtime",
        rawXmlParenNamespace == "<node xmlns=\"" + rawRuntimeXmlParenNamespace + "\"/>", true);
    result &= Test("raw_xml_adjacent_matches_runtime",
        rawXmlAdjacentNamespace == "<node xmlns=\"" + rawRuntimeXmlAdjacentNamespace + "\"/>", true);
    result &= Test("rawstr_application_utf8_raw_name", Application.name(), "Utf8 App");
    result &= Test("json_const_encoding_prefixes", rawEncodingJson,
        "{\"a\":\"a\",\"b\":\"b\",\"c\":\"c\",\"d\":\"d\"}");
    result &= Test("xml_const_parenthesized_namespace", rawXmlNamespace,
        "<node xmlns=\"urn:round3\"/>");
    result &= Test("bracefold_json_single", braceFoldJsonSingle, r#"{"value":"a{b}"}"#);
    result &= Test("bracefold_json_verbatim", braceFoldJsonVerbatim,
        r#"{"value":"{\"a\":1}"}"#);
    result &= Test("bracefold_json_adjacent", braceFoldJsonAdjacent, r#"{"value":"a{b}}"}"#);
    result &= Test("bracefold_json_parenthesized", braceFoldJsonParen, r#"{"value":"p{x}"}"#);
    result &= Test("bracefold_json_escaped_braces", braceFoldJsonEscaped, r#"{"value":"{x}"}"#);
    result &= Test("bracefold_json_raw_braces", braceFoldJsonRaw, r#"{"value":"raw {{x}}"}"#);
    result &= Test("bracefold_json_const_string", braceFoldJsonConst, r#"{"value":"const{x}"}"#);
    result &= Test("bracefold_json_mixed_const_string", braceFoldJsonMixedConst,
        r#"{"value":"const{x}}"}"#);
    result &= Test("bracefold_json_parenthesized_const_string", braceFoldJsonParenConst,
        r#"{"value":"const{x}"}"#);
    result &= Test("bracefold_const_runtime_single", braceFoldCompileTimeVersion, r"const{x}");
    result &= Test("bracefold_const_runtime_mixed", braceFoldMixedCompileTimeVersion, r"const{x}}");
    result &= Test("bracefold_const_runtime_parenthesized", braceFoldParenCompileTimeVersion, r"const{x}");
    result &= Test("bracefold_xml_single", braceFoldXmlSingle, r#"<node xmlns="x{y}"/>"#);
    result &= Test("bracefold_xml_adjacent", braceFoldXmlAdjacent, r#"<node xmlns="x{y}}"/>"#);
    result &= Test("bracefold_xml_parenthesized", braceFoldXmlParen, r#"<node xmlns="x{y}"/>"#);
    result &= Test("bracefold_xml_raw", braceFoldXmlRaw, r#"<node xmlns="x{{y}}"/>"#);
    result &= Test("bracefold_wide_json_prefixes", braceFoldWideEncodingJson,
        r#"{"utf16":"{u}","utf32":"{U}","wide":"{L}"}"#);
    return result;
}

// Const phase 7: the review draft's last legs (scratch/const_iter1/const_section.cb leg 9 generics,
// leg 10 `using` typeof); its other legs landed with phases 1-6 (testConstObjects ... testConstStringLiterals).
using TcCStr = (const char)*;
using TcIntPtr = int*;
int tcGenericFirst<T>(const T p) { return p[0]; }   // T = int*: `const T` is `const int*`
T tcGenericBump<T>(T v) { v++; return v; }           // a const argument deduces T = int

int[2] t342GlobalViewA = { 1, 2 };
int[2] t342GlobalViewB = { 3, 4 };
(const int)[] t342GlobalView = t342GlobalViewA;
struct T342ConstViewField { (const int)[] v = default; };
int t342ConstViewParam((const int)[] v, int[] b) { v = b; return v[0] + v[1]; }
int t342ConstViewGeneric<T>(T v, int[] b) { v = b; return v[0] + v[1]; }
int t342IsConst<T>(T v) { if const (is_const(T)) return 1; else return 0; }
int t342IsAssignable<T>(T v) { if const (is_assignable(T)) return 1; else return 0; }
int t342ConstViewGlobalReseat()
{
    t342GlobalView = t342GlobalViewB;
    return t342GlobalView[0] + t342GlobalView[1];
}

bool testConstWholeWord()
{
    bool result = true;
    int[3] data = { 11, 2, 3 };
    int* raw = data;
    const int seed = 41;
    result &= Test("const_generic_whole", tcGenericFirst(raw), 11);
    result &= Test("const_generic_deduce_strips", tcGenericBump(seed), 42);
    list<(const char)*> names = default;
    names.add("a");
    names.add("bc");
    result &= Test("const_generic_view_arg", tcLength(names[1]), 2);
    expect_error("'const' is not allowed on a generic type argument") { list<const int> bad = default; }
    // typeof(type) takes no '*' or 'const' yet, so the draft's typeof((const char)*) is spelled
    // through variables of the two types.
    TcCStr aliasView = "alias";
    (const char)* spelledView = "spelled";
    const TcIntPtr aliasConstPtr = raw;
    const int* spelledConstPtr = raw;
    result &= Test("const_using_typeof", typeof(aliasView), typeof(spelledView));
    result &= Test("const_using_typeof_whole", typeof(aliasConstPtr), typeof(spelledConstPtr));
    result &= Test("const_using_typeof_text", typeof(aliasConstPtr), "const int*");

    int[2] t342A = { 1, 2 };
    int[2] t342B = { 3, 4 };
    (const int)[] t342View = t342A;
    t342View = t342B;
    result &= Test("const_view_local_reseat", t342View[0] + t342View[1], 7);
    const (int)[] t342ParenView = t342A;
    t342ParenView = t342B;
    result &= Test("const_paren_element_view_reseat", t342ParenView[0] + t342ParenView[1], 7);
    result &= Test("const_view_param_reseat", t342ConstViewParam(t342A, t342B), 7);
    T342ConstViewField t342Field = { v = t342A };
    t342Field.v = t342B;
    result &= Test("const_view_field_reseat", t342Field.v[0] + t342Field.v[1], 7);
    result &= Test("const_view_global_reseat", t342ConstViewGlobalReseat(), 7);
    // Start the generic legs on t342A so only a real reseat onto t342B yields 7.
    (const int)[] t342GenView = t342A;
    result &= Test("const_view_generic_explicit_reseat",
                   t342ConstViewGeneric<(const int)[]>(t342GenView, t342B), 7);
    result &= Test("const_view_generic_deduced_reseat", t342ConstViewGeneric(t342GenView, t342B), 7);
    result &= Test("const_view_is_const", t342IsConst<(const int)[]>(t342View), 1);
    result &= Test("const_view_is_assignable", t342IsAssignable<(const int)[]>(t342View), 1);
    return result;
}

