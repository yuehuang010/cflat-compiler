bool testNamespace()
{
    bool result = true;
    result &= Test("qualorder_accept_inner_function", QoAcceptOuter.call(), 10);
    result &= Test("qualorder_accept_inner_global", QoAcceptOuter.globalValue(), 20);
    result &= Test("qualorder_accept_inner_enum", QoAcceptOuter.enumValue(), 30);
    result &= Test("qualorder_accept_root_function", QoAcceptOuter.rootCall(), 90);
    result &= Test("qualorder_accept_root_global", QoAcceptOuter.rootValue(), 80);
    result &= Test("qualorder_root_enum", QoAcceptOuter.rootEnum(), 70);
    result &= Test("qualorder_late_function", QoLateUse.callRoot(), 20);
    result &= Test("qualorder_late_global", QoLateUse.globalValue(), 3);
    result &= Test("qualorder_late_enum", QoLateUse.enumValue(), 7);
    result &= Test("qualorder_late_enum_signature", QoLateUse.enumArgument(QoLateRoot.E.item), 7);
    result &= Test("qualorder_late_global_array", QoLateUse.arrayValue(), 5);
    result &= Test("qualorder_late_static_global", QoLateUse.staticValue(), 13);
    result &= Test("qualorder_late_pointer_global", QoLateUse.pointerValue(), 3);
    result &= Test("qualorder_late_view_global", QoLateUse.viewValue(), 4);
    result &= Test("qualorder_late_extern_global", QoLateUse.externValue(), 19);
    result &= Test("qualorder_late_extern_function", QoLateUse.externFunction(), 12);
    result &= Test("qualorder_late_static_method", QoLateUse.staticMethod(), 23);
    result &= Test("qualorder_late_overload", QoLateUse.overload(), 12);
    result &= Test("qualorder_late_generic", QoLateUse.generic(), 12);
    result &= Test("qualorder_late_nested", QoLateUse.nested(), 21);
    result &= Test("qualorder_late_rooted", QoLateUse.rooted(), 20);
    result &= Test("qualorder_late_sibling", QoLateSibling.Use.call(), 22);
    result &= Test("qualorder_late_alias_collision", QoLateAliasUse.call(), 10);
    result &= Test("qualorder_both_late_collision", QoLateCollisionUse.call(), 11);
    QoLateUse.Caller qoLateCaller = default;
    result &= Test("qualorder_late_method", qoLateCaller.method(), 20);
    // T187: bare namespace variable beats the same-named global function and global variable.
    result &= Test("ns_var_over_global_fn", T187Ns.readVar(), 8);
    result &= Test("ns_var_over_global_fn_ternary", T187Ns.tern(1) * 10 + T187Ns.tern(0), 84);
    result &= Test("ns_var_write_over_global_fn", T187Ns.readAfterSet(), 9);
    result &= Test("ns_var_over_global_var", T187Ns.readGlobalSpelling(), 8);
    result &= Test("ns_inner_var_over_outer_fn", T187Outer.Inner.run(), 5);
    result &= Test("ns_outer_var_over_global_fn", T187Outer2.Inner.run(), 5);
    // Control: a struct field spelled like a global function already wins through 'this'.
    T187Field t187f = default;
    t187f.t187Shadow = 7;
    result &= Test("field_over_global_fn", t187f.get(), 7);
    // T193: namespace function over the same-named global variable, in value positions.
    result &= Test("t193_ns_fn_decl", T193Fn.decl(), 2);
    result &= Test("t193_ns_fn_assign", T193Fn.assign(), 2);
    result &= Test("t193_ns_fn_argument", T193Fn.arg(), 2);
    result &= Test("t193_ns_fn_return", T193Fn.retCall(), 2);
    result &= Test("t193_ns_fn_nested", T193Fn.T193Deep.nested(), 2);
    // T193: a namespace const sizes an array in every position (the file-scope const is 1).
    result &= Test("t193_ns_const_local", T193Dim.local(), 3);
    result &= Test("t193_ns_const_nested", T193Dim.T193Inner.local(), 3);
    T193Dim.T193Box t193b = default;
    result &= Test("t193_ns_const_field", sizeof(t193b.f) / sizeof(int), 3);
    result &= Test("t193_ns_const_global", sizeof(T193Dim.garr) / sizeof(int), 3);
    result &= Test("t193_ns_const_generic", T193Dim.gen(), 3);
    result &= Test("t206_ns_nonconst_vla_not_file_const", T206Vla.local(), 4);
    result &= Test("namespace_add", MathUtils.add(3, 4), 7);            // 3+4=7
    result &= Test("namespace_multiply", MathUtils.multiply(3, 4), 12); // 3*4=12
    result &= Test("global_add", add(3, 4), 107);                       // 3+4+100=107
    result &= Test("no_collision", MathUtils.add(3, 4) != add(3, 4), 1);
    result &= Test("global_using_add", Math.add(3, 4), 7);              // global alias resolves to MathUtils.add
    result &= Test("global_using_multiply", Math.multiply(3, 4), 12);   // global alias resolves to MathUtils.multiply
    // Unqualified sibling call inside the namespace must resolve to the namespace
    // member (more-local wins over the global `add`): (3+4)*2 = 14, not (3+4+100)*2.
    result &= Test("sibling_call", MathUtils.addThenDouble(3, 4), 14);
    result &= Test("nested_sibling_call", MathUtils.Advanced.sumOfSquares(3, 4), 25); // 9+16=25
    // global:: escapes the sibling shadow: addViaGlobal reaches the global add (a+b+100),
    // while addViaSibling still resolves to the namespace member (a+b).
    result &= Test("global_scope_escape", MathUtils.addViaGlobal(3, 4), 107);          // 3+4+100
    result &= Test("global_scope_sibling_still_local", MathUtils.addViaSibling(3, 4), 7); // 3+4
    // global:: with a dotted path resolves at the root namespace.
    result &= Test("global_scope_dotted", MathUtils.Advanced.addViaGlobalDotted(3, 4), 7); // 3+4
    // Namespace globals: qualified read/write from outside, bare sibling access inside.
    result &= Test("namespace_global_const", MathUtils.BASE, 120);
    result &= Test("namespace_global_read", MathUtils.nsCounter, 7);
    result &= Test("namespace_global_sibling_read", MathUtils.readCounter(), 7);
    MathUtils.bumpCounter();                       // bare sibling write inside
    result &= Test("namespace_global_sibling_write", MathUtils.nsCounter, 8);
    MathUtils.nsCounter = 42;                      // qualified write from outside
    result &= Test("namespace_global_qualified_write", MathUtils.readCounter(), 42);
    result &= Test("namespace_global_alias", Math.BASE, 120);  // via `using Math = MathUtils`
    result &= Test("namespace_global_outer_from_nested", MathUtils.Advanced.readOuterBase(), 120);
    // Dotted namespace declaration + extern with bare linkage inside a namespace.
    result &= Test("dotted_ns_extern", sysapi.libc.toupper('a'), 'A');
    result &= Test("namespaced_extern_body", nsx.LaterNs(4), 10);
    sysapi.libc.Box2 bx;
    bx.w = 3; bx.h = 5;
    result &= Test("dotted_ns_struct_sibling_sig", sysapi.libc.area(&bx), 15);
    return result;
}

