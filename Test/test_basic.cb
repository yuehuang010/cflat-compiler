bool testT118ConstFloatingDims()
{
    bool result = true;
    int[(T118ConstFloat > 0.0f) ? 2 : 1] localFloat = default;
    int[(T118ConstDouble > 0.0) ? 2 : 1] localDouble = default;
    int[2][(int)T118ConstCastDouble] localDoubleCast = default;
    int[2][(u32)T118ConstCastDouble] localUnsignedDoubleCast = default;
    result &= Test("t118_local_float_size", (int)sizeof(localFloat), 8);
    result &= Test("t118_local_double_size", (int)sizeof(localDouble), 8);
    result &= Test("t118_local_double_cast_size", (int)sizeof(localDoubleCast), 16);
    result &= Test("t118_local_unsigned_double_cast_size", (int)sizeof(localUnsignedDoubleCast), 16);

    int[2][(T118ConstFloat > 0.0f) ? 2 : 1] innerFloat = default;
    int[2][(T118ConstDouble > 0.0) ? 2 : 1] innerDouble = default;
    result &= Test("t118_inner_float_size", (int)sizeof(innerFloat), 16);
    result &= Test("t118_inner_double_size", (int)sizeof(innerDouble), 16);

    result &= Test("t118_global_float_size", (int)sizeof(t118GlobalFloat), 8);
    result &= Test("t118_global_double_size", (int)sizeof(t118GlobalDouble), 8);
    result &= Test("t118_global_double_cast_size", (int)sizeof(t118GlobalCastDouble), 16);
    result &= Test("t118_global_unsigned_double_cast_size", (int)sizeof(t118GlobalCastUnsignedDouble), 16);
    T118DimFields fields = default;
    result &= Test("t118_field_float_size", (int)sizeof(fields.floatBound), 8);
    result &= Test("t118_field_double_size", (int)sizeof(fields.doubleBound), 8);

    static int[(T118ConstFloat > 0.0f) ? 2 : 1] staticFloat = default;
    static int[(T118ConstDouble > 0.0) ? 2 : 1] staticDouble = default;
    result &= Test("t118_static_float_size", (int)sizeof(staticFloat), 8);
    result &= Test("t118_static_double_size", (int)sizeof(staticDouble), 8);

    int* pointersFloat[(T118ConstFloat > 0.0f) ? 2 : 1] = default;
    int* pointersDouble[(T118ConstDouble > 0.0) ? 2 : 1] = default;
    result &= Test("t118_cstyle_pointer_float_size", (int)sizeof(pointersFloat), 16);
    result &= Test("t118_cstyle_pointer_double_size", (int)sizeof(pointersDouble), 16);

    T118FloatDimAlias aliasFloat = default;
    T118DoubleDimAlias aliasDouble = default;
    result &= Test("t118_alias_float_size", (int)sizeof(aliasFloat), 8);
    result &= Test("t118_alias_double_size", (int)sizeof(aliasDouble), 8);

    int[(T118DimNS.D > 0.0) ? 2 : 1] qualified = default;
    result &= Test("t118_qualified_global_size", (int)sizeof(qualified), 8);
    result &= Test("t118_shadow_local_size", t118ShadowLocalDim(), 4);
    result &= Test("t118_shadow_parameter_size", t118ShadowParameterDim(0.0), 4);
    T118ShadowField shadow = default;
    result &= Test("t118_shadow_this_field_size", shadow.Dim(), 4);

    result &= Test("t118_mutable_float_stays_vla", t118MutableFloatDim(), 4);
    result &= Test("t118_mutable_double_stays_vla", t118MutableDoubleDim(), 4);
    return result;
}

// T95: `*arr` on a fixed array decays to the element pointer, native and plain-struct alike.
// `*s` on a plain struct VALUE is refused (err_deref_plain_struct.cb).
struct T95Plain { int n = 7; };
bool testUnaryDerefDecay()
{
    int[2] ia = {5, 6};
    if ((*ia) != 5) return false;
    T95Plain[2] pa;
    pa[0].n = 9;
    if ((*pa).n != 9) return false;
    (*pa).n = 10;
    if (pa[0].n != 10) return false;
    int[2][3] matrix = default;
    matrix[0][1] = 17;
    if ((*matrix)[1] != 17) return false;
    int[2] pointees = {31, 37};
    int*[2] pointers = default;
    pointers[0] = &pointees[0]; pointers[1] = &pointees[1];
    if (*pointers[1] != 37) return false;
    return true;
}

bool testNdPointerArrayDerefWrite()
{
    int a = 1; int b = 2; int c = 3; int d = 4;
    int*[2][2] pointers = { { &a, &b }, { &c, &d } };
    *pointers[1][1] = 5;
    return Test("nd_pointer_array_deref_write_value", d, 5)
        && Test("nd_pointer_array_deref_write_index", pointers[1][1][0], 5);
}

bool testPointerToIntegerAccepts()
{
    int[2] values = {13, 29};
    int* first = &values[0];
    bool nonNull = first;
    auto inferred = first;
    long explicitValue = (long)first;
    long difference = &values[1] - first;
    return Test("pointer_to_bool_null_test", nonNull, true)
        && Test("pointer_to_integer_explicit_cast", explicitValue, (long)first)
        && Test("pointer_auto_remains_pointer", inferred == first, true)
        && Test("pointer_difference_is_integer", difference, 1);
}

// Raw-union lifetime policy: no hidden active-member tag means member destruction is explicit.
int unionDtorCount = 0;
int unionNodeDtors = 0;
int unionManualDtors = 0;
struct UnionDtorOwner { int tag = default; ~UnionDtorOwner() { unionDtorCount++; } };
class UnionDtorNode { int v = default; ~UnionDtorNode() { unionNodeDtors++; } };
struct UnionUniqueBox { unique UnionDtorNode* p = default; };
union UnionOwnerFirst { UnionDtorOwner o = default; int i; };
union UnionOwnerSecond { int i = default; UnionDtorOwner o; };
union UnionRawUnique { UnionUniqueBox b = default; int i; };
union UnionManualDtor { int i = default; ~UnionManualDtor() { unionManualDtors++; } };
union UnionManualUnique
{
    UnionUniqueBox b = default;
    int i;
    ~UnionManualUnique()
    {
        if (b.p != nullptr) b.p = nullptr;
    }
};
struct UnionOwnerHolder { UnionOwnerFirst u = default; int n = default; };

UnionOwnerFirst makeUnionOwner() { UnionOwnerFirst u = default; u.o.tag = 4; return u; }

