    result &= Test("nest6 overload defaults use distinct effective arities",
        nest6TwoDefaultOverloadsIface.h(1), 12);
    Nest6LiteralDefaultImpl nest6LiteralDefault = default;
    Nest6LiteralDefaultInterface nest6LiteralDefaultIface = nest6LiteralDefault;
    result &= Test("nest6 interface literal prefers defaulted int overload",
