        struct Mid { int value = 2; int extra = 0; };
        struct G<T> {
            T item = default;
            array<Mid> readArray() { array<Mid> values = new Mid[1]; return values; }
            Mid make() { Mid value = default; return value; }
            int read() { array<Mid> values = readArray(); return values[0].value * 10 + make().value; }
        };
    };
    struct S {
        struct Mid { int value = 3; int extra = 0; int other = 0; };
        int read() { P.G<int> value = default; return value.read(); }
    };
}

