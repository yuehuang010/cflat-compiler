// =============================================================
// Forward reference tests
// =============================================================

// Test 1: bar() calls foo() which is defined after bar().
int bar()
{
    return foo();
}

int foo()
{
    return 42;
}

bool testForwardFunction()
{
    bool result = true;
    result &= Test("bar calls foo (fwd ref)", bar(), 42);
    return result;
}

// Test 2: Mutual recursion - no explicit forward declaration needed.
bool isEven(int n)
{
    if (n == 0) return true;
    return isOdd(n - 1);
}

bool isOdd(int n)
{
    if (n == 0) return false;
    return isEven(n - 1);
}

bool testMutualRecursion()
{
    bool result = true;
    result &= Test("isEven(0)", isEven(0), 1);
    result &= Test("isEven(4)", isEven(4), 1);
    result &= Test("isOdd(1)",  isOdd(1),  1);
    result &= Test("isOdd(5)",  isOdd(5),  1);
    result &= Test("isEven(3) is false", isEven(3), 0);
    result &= Test("isOdd(4) is false",  isOdd(4),  0);
    return result;
}

// Test 3: runAccumulator() calls getTotal() which is defined after the struct.
int runAccumulator()
{
    return getTotal();
}

struct Accumulator
{
    int x = 10;
    int y = 20;
    int z = 30;

    int Total()
    {
        return x + y + z;
    }
};

int getTotal()
{
    Accumulator a = Accumulator();
    return a.Total();
}

bool testForwardFunctionWithStruct()
{
    bool result = true;
    result &= Test("runAccumulator (fwd ref to getTotal)", runAccumulator(), 60);
    return result;
}

// Test 4: Member function calls a member function defined later in the struct.
struct Calculator
{
    int value = 10;

    int ComputeDouble()
    {
        return doubleIt();
    }

    int ComputeSum()
    {
        return addThree(5, 3);
    }

    int doubleIt()
    {
        return value * 2;
    }

    int addThree(int b, int c)
    {
        return value + b + c;
    }
};

bool testForwardInStruct()
{
    bool result = true;
    Calculator c = Calculator();
    result &= Test("member calls fwd func (doubleIt)", c.ComputeDouble(), 20);
    result &= Test("member calls fwd func (addThree)", c.ComputeSum(), 18);
    return result;
}

// Return block: the function body is inlined at every call site.
// 'return' inside the block returns from the caller.
inline int doubleValue(int x)
{
    return { return x * 2; };
}

inline int addValues(int a, int b)
{
    return { return a + b; };
}

// Wrappers: the return-block is inlined here; its 'return' returns from these functions.
int getDoubled(int x)
{
    doubleValue(x);
}

int getSum(int a, int b)
{
    addValues(a, b);
}

bool testReturnBlock()
{
    bool result = true;
    result &= Test("returnBlock doubleValue(5)", getDoubled(5), 10);
    result &= Test("returnBlock addValues(3,4)", getSum(3, 4), 7);
    return result;
}

// Assert uses a return block: if the assertion fails, it returns false from the caller.
inline bool Assert(const char* testName, int actual, int expected)
{
    return {
        if (actual != expected)
        {
            printf("%s negative: expected '%d' but got '%d'.\n", testName, expected, actual);
            return false;
        }
    };
}

// When the failing Assert is hit, it exits this function early with false.
// The 'return true' at the end is only reached if all asserts pass.
bool testAssertPass()
{
    Assert("assert 42==42", 42, 42);
    Assert("assert 7==7", 7, 7);
    return true;
}

bool testAssertFail()
{
    Assert("assert 10==10", 10, 10);
    Assert("assert 10==99", 10, 99);  // fails - exits testAssertFail with false
    return true;
}

bool testAssertReturnBlock()
{
    bool result = true;
    result &= Test("assert_all_pass", testAssertPass(), true);
    result &= Test("assert_early_exit", testAssertFail(), false);
    return result;
}

// =============================================================
// Explicit-width integer type tests
// C equivalents: i8=int8_t, i16=int16_t, i32=int32_t, i64=int64_t
//                u8=uint8_t, u16=uint16_t, u32=uint32_t, u64=uint64_t
// =============================================================

int sumI32(i32 a, i32 b) { return a + b; }
int sumU32(u32 a, u32 b) { return a + b; }
// [lex.icon] ladder overload probe: an unsuffixed 32-bit binary literal is unsigned int (clang picks 2).
int pickBinaryLadder(int x) { return 1; }
int pickBinaryLadder(u32 x) { return 2; }
int pickBinaryLadder(long x) { return 3; }
// Unsuffixed 0x8000000000000000 is unsigned long on LP64 (clang picks 2), unsigned long long on LLP64.
int pickUnsignedLadder(long x) { return 1; }
int pickUnsignedLadder(ulong x) { return 2; }
int pickUnsignedLadder(u64 x) { return 3; }
// A trailing f in a hex literal is a digit: 0x7f is int (clang picks 1), not a float suffix.
int pickHexDigitF(int x) { return 1; }
int pickHexDigitF(u64 x) { return 2; }
// T86: a hex float is double unless f/F (float); a binary suffix takes the [lex.icon] ladder row (clang oracle).
int pickHexFloat(float x) { return 1; }
int pickHexFloat(double x) { return 2; }
// T100: an l/L floating literal is long double, a distinct overload from double (clang oracle).
int pickLongDouble(float x) { return 1; }
int pickLongDouble(double x) { return 2; }
int pickLongDouble(longdouble x) { return 3; }
int pickLongDoubleGeneric<T>(T x) { return pickLongDouble(x); }
// {double, longdouble} only: a float source promotes to double (clang), whatever the declaration order.
int pickLdOrD(longdouble x) { return 3; }
int pickLdOrD(double x) { return 2; }
int pickBinarySuffix(u32 x) { return 2; }
int pickBinarySuffix(long x) { return 3; }
int pickBinarySuffix(ulong x) { return 4; }
int pickBinarySuffix(i64 x) { return 5; }
int pickBinarySuffix(u64 x) { return 6; }

// Regression: a negative integer literal in a file-scope initializer used to be
// sign-dropped (narrowed to the smallest unsigned width, e.g. -150 read back as
// 65386). CreateGlobalVariable now sign-extends when widening the narrowed
// constant back to the global's declared width.
const int GlobalNegConstSmall = -3;
const int GlobalNegConstI8    = -101;
const int GlobalNegConstI16   = -150;
const int GlobalNegConstI32   = -70000;
int GlobalNegPlainSmall = -3;
int GlobalNegPlainI8    = -101;
int GlobalNegPlainI16   = -150;
int GlobalNegPlainI32   = -70000;

// A file-scope `const` integer global is seeded into the compile-time constant FOLDER so an
// `if const` / generic value argument can see it. It must stay an ordinary global everywhere
// else: seeding it as a compile-time macro instead made it shadow same-named locals and
// parameters, narrowed every width to i32, and broke address-of.
const int ConstFoldShadow = 8;
const i64 ConstFoldWide   = 3;

int constFoldShadowParam(int ConstFoldShadow)
{
    return ConstFoldShadow + 1;
}

bool testConstGlobalIsNotAMacro()
{
    bool result = true;
    int ConstFoldShadow = 3;
    result &= Test("const_global_local_shadows", ConstFoldShadow, 3);
    result &= Test("const_global_param_shadows", constFoldShadowParam(100), 101);
    ConstFoldShadow = 5;
    result &= Test("const_global_local_assignable", ConstFoldShadow, 5);

    // Narrowing the global to i32 made this shift lose the high bits. Declared i64 (not `long`,
    // which is only 32-bit on Windows LLP64) so this holds on every target.
    i64 wide = ConstFoldWide << 40;
    result &= Test("const_global_keeps_width", wide == 3298534883328, true);

    // A macro has no storage, so address-of stopped compiling.
    int* p = &ConstFoldShadow;
    result &= Test("const_global_addressable", *p, 5);
    return result;
}

bool testNegativeGlobalInit()
{
    bool result = true;
    result &= Test("const_global_neg_small", GlobalNegConstSmall, -3);
    result &= Test("const_global_neg_i8",     GlobalNegConstI8,    -101);
    result &= Test("const_global_neg_i16",    GlobalNegConstI16,   -150);
    result &= Test("const_global_neg_i32",    GlobalNegConstI32,   -70000);
    result &= Test("plain_global_neg_small",  GlobalNegPlainSmall, -3);
    result &= Test("plain_global_neg_i8",     GlobalNegPlainI8,    -101);
    result &= Test("plain_global_neg_i16",    GlobalNegPlainI16,   -150);
    result &= Test("plain_global_neg_i32",    GlobalNegPlainI32,   -70000);

    // Local initializer with the same magnitudes must keep working (was never broken).
    int localNeg = -150;
    result &= Test("local_neg_i16", localNeg, -150);

    return result;
}

bool testExplicitIntTypes()
{
    bool result = true;

    // Signed types: declaration and basic value
    i8  s8  = 100;
    i16 s16 = 1000;
    i32 s32 = 100000;
    i64 s64 = 200000;

    result &= Test("i8_value",  s8,  100);
    result &= Test("i16_value", s16, 1000);
    result &= Test("i32_value", s32, 100000);
    result &= Test("i64_value", s64, 200000);

    // Unsigned types: declaration and basic value
    u8  u8v  = 200;
    u16 u16v = 2000;
    u32 u32v = 300000;
    u64 u64v = 400000;

    result &= Test("u8_value",  u8v,  200);
    result &= Test("u16_value", u16v, 2000);
    result &= Test("u32_value", u32v, 300000);
    result &= Test("u64_value", u64v, 400000);

    // Arithmetic - values chosen to stay within each type's range
    i8  s8a  = 50;   // 50+50=100, within i8  (-128..127)
    u8  u8a  = 100;  // 100+100=200, within u8 (0..255)
    result &= Test("i8_add",  s8a  + s8a,   100);  // 50+50=100
    result &= Test("i16_add", s16  + s16,   2000); // 1000+1000=2000, within i16
    result &= Test("i32_add", s32  + s32,   200000); // 100000+100000=200000
    result &= Test("u8_add",  u8a  + u8a,   200);  // 100+100=200
    result &= Test("u16_add", u16v + u16v,  4000); // 2000+2000=4000, within u16

    // C-equivalent compatibility: int <-> i32 are the same type
    int ci = s32;
    result &= Test("i32_to_int", ci, 100000);

    i32 ia = ci;
    result &= Test("int_to_i32", ia, 100000);

    // Passing i32/u32 to functions expecting i32/u32
    result &= Test("func_i32", sumI32(40, 2), 42);
    result &= Test("func_u32", sumU32(40, 2), 42);

    // Passing int to function expecting i32 (compatible types)
    int x = 10;
    result &= Test("int_to_i32_param", sumI32(x, 5), 15);

    // Hex literals with high bit set (contain hex digit 'E' - must not be parsed as float)
    // C++ rule: hex literals that exceed i32 positive range type as unsigned int (same 32-bit pattern).
    u32 magic = 0xBA63E001;             // contains 'E' - previously mistaken as float exponent
    u32 magic2 = (u32)0xBA63E001;
    result &= Test("hex_high_bit_direct", magic,  (u32)0xBA63E001);
    result &= Test("hex_high_bit_cast",   magic2, (u32)0xBA63E001);
    result &= Test("hex_with_E_digit",    (u32)0xDEADBEEF, (u32)0xDEADBEEF);
    result &= Test("hex_all_ones",        (u32)0xFFFFFFFF, (u32)0xFFFFFFFF);
    result &= Test("hex_int_min",         (u32)0x80000000, (u32)0x80000000);

    // [lex.icon] ladder (ruling 2026-10-09): an unsuffixed hex/octal/binary literal past int range is
    // unsigned int, then the 64-bit types; decimal never takes an unsigned type. Oracle: clang++ -std=c++20.
    u64 hexLadderU64 = 0x80000000;
    result &= Test("hex_ladder_u64_high_bit", (i64)hexLadderU64, 2147483648);
    i64 hexLadderI64 = 0xFFFFFFFF;
    result &= Test("hex_ladder_i64_all_ones", hexLadderI64, 4294967295);
    auto hexLadderAuto = 0xFFFFFFFF;
    i64 hexLadderAutoWide = hexLadderAuto;
    result &= Test("hex_ladder_auto_is_u32", hexLadderAutoWide, 4294967295);
    u64 hexLadderMasked = 0x1FFFFFFFF;
    result &= Test("hex_ladder_mask_u32", (i64)(hexLadderMasked & 0xFFFFFFFF), 4294967295);
    u64 hexLadderShift = 0xFFFFFFFF << 4;
    result &= Test("hex_ladder_u32_shift_then_widen", (i64)hexLadderShift, 4294967280);
    result &= Test("hex_ladder_eq_minus_one", 0xFFFFFFFF == -1, true);
    int hexLadderInt = 0xFFFFFFFF;
    result &= Test("hex_ladder_int_wraps", hexLadderInt, -1);
    i8 hexLadderI8 = 0xFF;
    result &= Test("hex_ladder_i8_wraps", (int)hexLadderI8, -1);
    i64 hexLadderUSuffix = 0xFFFFFFFFu;
    result &= Test("hex_ladder_u_suffix_u32", hexLadderUSuffix, 4294967295);
    i64 hexLadderLSuffix = 0x80000000L;
    result &= Test("hex_ladder_l_suffix_long", hexLadderLSuffix, 2147483648);
    u64 hexLadderU64Max = 0xFFFFFFFFFFFFFFFF;
    result &= Test("hex_ladder_u64_max", (i64)(hexLadderU64Max >> 1), 9223372036854775807);
    i64 hexLadderPastU32 = 0x100000000;
    result &= Test("hex_ladder_past_u32_long", hexLadderPastU32, 4294967296);
    u64 hexLadderOctal = 020000000000;
    result &= Test("octal_ladder_u32_high", (i64)hexLadderOctal, 2147483648);
    u64 hexLadderBinary = 0b10000000000000000000000000000000;
    result &= Test("binary_ladder_u32_high", (i64)hexLadderBinary, 2147483648);
    result &= Test("hex_digit_f_is_int", pickHexDigitF(0x7f), 1);
    auto unsignedLadderAuto = 0x8000000000000000;
    if const (__WINDOWS__) { result &= Test("unsigned_ladder_auto_overload", pickUnsignedLadder(unsignedLadderAuto), 3); }
    else { result &= Test("unsigned_ladder_auto_overload", pickUnsignedLadder(unsignedLadderAuto), 2); }
    if const (__WINDOWS__) { result &= Test("unsigned_ladder_literal_overload", pickUnsignedLadder(0x8000000000000000), 3); }
    else { result &= Test("unsigned_ladder_literal_overload", pickUnsignedLadder(0x8000000000000000), 2); }
    auto binaryLadderAuto = 0b10000000000000000000000000000000;
    result &= Test("binary_ladder_auto_overload_u32", pickBinaryLadder(binaryLadderAuto), 2);
    result &= Test("binary_ladder_literal_overload_u32", pickBinaryLadder(0b10000000000000000000000000000000), 2);
    // T86 hex floats (clang oracle): binary exponent makes the literal floating; f/F float, else double.
    result &= Test("hex_float_neg_exp_f32", (int)(0x1p-2f * 1024), 256);
    result &= Test("hex_float_neg_exp_double", (int)(0x1p-2 * 1024), 256);
    result &= Test("hex_float_fraction", (int)(0x1.fp0 * 16), 31);
    result &= Test("hex_float_pos_exp_upper", (int)(0X1P+4), 16);
    result &= Test("hex_float_leading_dot", (int)(0x.8p1 * 8), 8);
    result &= Test("hex_float_sum_double", (int)((0x1p-2 + 1.0) * 4), 5);
    result &= Test("hex_float_denormal_nonzero", 0x1p-1074 > 0.0, true);
    result &= Test("hex_float_f_suffix_upper", (int)(0x1.8p3F * 2), 24);
    result &= Test("hex_float_overload_double", pickHexFloat(0x1p-2), 2);
    result &= Test("hex_float_overload_float", pickHexFloat(0x1p-2f), 1);
    result &= Test("hex_float_overload_float_upper", pickHexFloat(0x1.8p3F), 1);
    // T86 overflow: a hex float past the range is inf in its suffix-selected type (clang oracle: double inf, float inf).
    result &= Test("hex_float_overflow_double_inf", 0x1p2000 > 1.0e308, true);
    result &= Test("hex_float_overflow_float_inf", 0x1p200f > 3.0e38, true);
    result &= Test("hex_float_overflow_double_pick", pickHexFloat(0x1p2000), 2);
    result &= Test("hex_float_overflow_float_pick", pickHexFloat(0x1p200f), 1);
    // T96 decimal overflow: 1e400 is inf in its suffix type (clang: double inf, float inf), not 0.
    result &= Test("decimal_overflow_double_inf", 1e400 > 1.0e308, true);
    result &= Test("decimal_overflow_neg_inf", -1e400 < -1.0e308, true);
    result &= Test("decimal_overflow_float_inf", 1e400f > 3.0e38, true);
    result &= Test("decimal_overflow_double_pick", pickHexFloat(1e400), 2);
    result &= Test("decimal_overflow_float_pick", pickHexFloat(1e400f), 1);
    // T100 l/L floating literals are long double (clang oracle: sizeof 8; picks 3 3 3 3 1 2 3 3 3).
    result &= Test("long_double_literal_sizeof", (int)sizeof(0.25l), 8);
    result &= Test("long_double_literal_l_pick", pickLongDouble(0.25l), 3);
    result &= Test("long_double_literal_upper_l_pick", pickLongDouble(0.25L), 3);
    result &= Test("long_double_literal_hex_pick", pickLongDouble(0x1p-2l), 3);
    result &= Test("long_double_literal_neg_pick", pickLongDouble(-0.25l), 3);
    result &= Test("long_double_literal_f_pick", pickLongDouble(0.25f), 1);
    double t100Double = 0.5;
    result &= Test("long_double_literal_double_var_pick", pickLongDouble(t100Double), 2);
    longdouble t100Ld = 0.25;
    result &= Test("long_double_variable_pick", pickLongDouble(t100Ld), 3);
    result &= Test("long_double_mixed_literal_pick", pickLongDouble(0.25l + 1.0f), 3);
    result &= Test("long_double_mixed_variable_pick", pickLongDouble(t100Ld + 1.0f), 3);
    result &= Test("long_double_generic_ld_plus_float", pickLongDoubleGeneric(t100Ld + 1.0f), 3);
    result &= Test("long_double_generic_ld_plus_double", pickLongDoubleGeneric(t100Ld + t100Double), 3);
    result &= Test("long_double_generic_double_plus_ld", pickLongDoubleGeneric(t100Double + 0.25l), 3);
    result &= Test("long_double_generic_literal_times_int", pickLongDoubleGeneric(0.25l * 2), 3);
    bool t100Condition = true;
    result &= Test("long_double_generic_ternary_literal_arms",
        pickLongDoubleGeneric(t100Condition ? 0.25l : 1.0f), 3);
    result &= Test("long_double_generic_ternary_variable_arms",
        pickLongDoubleGeneric(t100Condition ? t100Ld : 1.0), 3);
    result &= Test("long_double_literal_value", (int)(0.25l * 1024), 256);
    float t100F = 0.5f;
    result &= Test("long_double_float_source_prefers_double", pickLdOrD(t100F) * 10 + pickLdOrD(0.25f), 22);
    // `l` is the target C long (ruling 2026-09-30): 4 bytes on Windows (LLP64), 8 on LP64.
    if const (__WINDOWS__)
        result &= Test("long_double_long_suffix_int_unchanged", sizeof(5l) == 4 && sizeof(5ll) == 8, true);
    else
        result &= Test("long_double_long_suffix_int_unchanged", sizeof(5l) == 8 && sizeof(5ll) == 8, true);
    // T86 member access stays on an adjacent hex integer: 0x1.to_i32() is int + member call (master prints 1).
    result &= Test("hex_int_adjacent_member_call", 0x1.to_i32(), 1);
    // T86 binary integer suffixes (clang oracle, overload pick on the six integer types).
    u64 binSuffixValue = 0b1010ULL;
    result &= Test("binary_suffix_ull_value", (int)binSuffixValue, 10);
    result &= Test("binary_suffix_u_pick", pickBinarySuffix(0b1u), 2);
    result &= Test("binary_suffix_U_pick", pickBinarySuffix(0b1U), 2);
    result &= Test("binary_suffix_L_pick", pickBinarySuffix(0b1L), 3);
    result &= Test("binary_suffix_UL_pick", pickBinarySuffix(0b1UL), 4);
    result &= Test("binary_suffix_ul_pick", pickBinarySuffix(0b1ul), 4);
    result &= Test("binary_suffix_LL_pick", pickBinarySuffix(0b1LL), 5);
    result &= Test("binary_suffix_ll_pick", pickBinarySuffix(0b1ll), 5);
    result &= Test("binary_suffix_ULL_pick", pickBinarySuffix(0b1ULL), 6);
    result &= Test("binary_suffix_uLL_pick", pickBinarySuffix(0b1uLL), 6);
    result &= Test("binary_suffix_LLu_pick", pickBinarySuffix(0b1LLu), 6);
    result &= Test("binary_suffix_u32_high_pick", pickBinarySuffix(0b10000000000000000000000000000000u), 2);
    if const (0xFFFFFFFF == -1) { result &= Test("hex_ladder_if_const_true", true, true); }
    else { result &= Test("hex_ladder_if_const_true", false, true); }

    return result;
}

// =============================================================
// Null-conditional (?.) and null-coalescing (??) tests
// =============================================================

struct NullableNode
{
    int value = 99;
    int Read() { return value; }
};

// Helper: returns the node's value if non-null, -1 otherwise
int readNodeValueNC(NullableNode* node)
{
    return node?.value ?? -1;
}

// Helper: calls Read() if non-null, returns -1 otherwise
int callNodeRead(NullableNode* node)
{
    return node?.Read() ?? -1;
}

bool testNullConditional()
{
    bool result = true;

    NullableNode n = NullableNode();
    NullableNode* p = &n;
    NullableNode* np = nullptr;

    // null-conditional field access + coalescing via helper
    result &= Test("nc_coalesce_nonnull", readNodeValueNC(p),  99);
    result &= Test("nc_coalesce_null",    readNodeValueNC(np), -1);

    // null-conditional method call via helper
    result &= Test("nc_method_nonnull",   callNodeRead(p),  99);
    result &= Test("nc_method_null",      callNodeRead(np), -1);

    // null-conditional method call directly on a local pointer (no helper)
    result &= Test("nc_direct_nonnull", p?.Read()  ?? -1, 99);
    result &= Test("nc_direct_null",    np?.Read() ?? -1, -1);

    // null-conditional field access directly on a local pointer (no helper)
    result &= Test("nc_direct_field_nonnull", p?.value  ?? -1, 99);
    result &= Test("nc_direct_field_null",    np?.value ?? -1, -1);

    return result;
}

const char* tryGetName(bool found)
{
    if (found) return "Alice";
    return nullptr;
}

bool testNullCoalescing()
{
    bool result = true;

    // pointer coalescing: null -> fallback string
    const char* name1 = tryGetName(true)  ?? "Unknown";
    const char* name2 = tryGetName(false) ?? "Unknown";
    result &= Test("nullcoal_nonnull_ptr", name1, "Alice");
    result &= Test("nullcoal_null_ptr",    name2, "Unknown");

    // integer coalescing: 0 -> default, nonzero -> self
    int zero = 0;
    int five = 5;
    result &= Test("nullcoal_zero",    zero ?? 42, 42);
    result &= Test("nullcoal_nonzero", five ?? 42, 5);

    return result;
}

// =============================================================
// Null-coalescing assignment (??=) tests
// =============================================================

int nullCoalSideEffects = 0;
int nullCoalBump() { nullCoalSideEffects = nullCoalSideEffects + 1; return 7; }

bool testNullCoalescingAssignment()
{
    bool result = true;

    // zero int: should be assigned the rhs value
    int x = 0;
    x ??= 42;
    result &= Test("nullcoalasgn_zero_becomes_rhs", x, 42);

    // nonzero int: should keep its original value
    int y = 7;
    y ??= 99;
    result &= Test("nullcoalasgn_nonzero_unchanged", y, 7);

    // repeated application: once set, a second ??= should not overwrite
    int z = 0;
    z ??= 10;
    z ??= 20;
    result &= Test("nullcoalasgn_already_set", z, 10);

    // Accept-set guard for the store-tail routing: '??=' short-circuits, so the RHS must not be
    // evaluated at all when the LHS is already set. Identical on both binaries by design - this
    // is the property a fall-through restructure could silently drop.
    nullCoalSideEffects = 0;
    int keep = 4;
    keep ??= nullCoalBump();
    result &= Test("nullcoalasgn_rhs_not_evaluated", nullCoalSideEffects, 0);
    int take = 0;
    take ??= nullCoalBump();
    result &= Test("nullcoalasgn_rhs_evaluated_once", nullCoalSideEffects, 1);
    result &= Test("nullcoalasgn_rhs_value", take, 7);

    // null pointer: should be assigned the rhs
    (const char)* p = nullptr;
    p ??= "hello";
    result &= Test("nullcoalasgn_null_ptr", p, "hello");

    // non-null pointer: should keep its original value
    (const char)* q = "world";
    q ??= "other";
    result &= Test("nullcoalasgn_nonnull_ptr", q, "world");

    // null struct pointer: should be assigned the rhs
    NullableNode* node = nullptr;
    node ??= new NullableNode();
    result &= Test("nullcoalasgn_null_struct_ptr", node?.Read() ?? -1, 99);
    delete node;

    // non-null struct pointer: should keep its original value and not be replaced
    NullableNode* nonNullNode = new NullableNode();
    NullableNode* replacementNode = new NullableNode();
    NullableNode* before = nonNullNode;
    nonNullNode ??= replacementNode;
    result &= Test("nullcoalasgn_nonnull_struct_ptr", nonNullNode == before, true);
    delete nonNullNode;
    delete replacementNode;

    return result;
}

// =============================================================
// Default keyword tests
// =============================================================

// Regression (nested-struct-field-default): a struct field declared `= default`
// must run the nested struct type's own field initializers, not zero-fill. Uses
// non-zero defaults so a zero-fill bug is distinguishable from correct behaviour.
struct DefInner { int a = -1; int b = -2; };
struct DefOuter { int x = -3; DefInner inner = default; };
struct DefDeep  { int m = -7; DefOuter outer = default; };

bool testDefault()
{
    bool result = true;

    // Primitive types: default -> zero value
    int  di = default;
    bool db = default;
    i32  di32 = default;
    i64  di64 = default;

    result &= Test("default_int",  di,   0);
    result &= Test("default_bool", db,   0);
    result &= Test("default_i32",  di32, 0);
    result &= Test("default_i64",  di64, 0);

    // Struct type: default -> calls default constructor, fields get their declared defaults
    MyStruct ds = default;
    result &= Test("default_struct_num1", ds.num1, 1);
    result &= Test("default_struct_num2", ds.num2, 2);
    result &= Test("default_struct_num3", ds.num3, 3);

    // Nested struct field `= default` must recurse into the field's own default
    // ctor (running its initializers), not zero-fill the aggregate.
    DefOuter dno = default;
    result &= Test("default_nested_field_x", dno.x,       -3);
    result &= Test("default_nested_field_a", dno.inner.a, -1);
    result &= Test("default_nested_field_b", dno.inner.b, -2);

    // Deeper nesting and the heap `new T` path share the same default-ctor path.
    DefDeep ddeep = default;
    result &= Test("default_deep_field_m", ddeep.m,             -7);
    result &= Test("default_deep_field_x", ddeep.outer.x,       -3);
    result &= Test("default_deep_field_a", ddeep.outer.inner.a, -1);
    DefOuter* dheap = new DefOuter;
    result &= Test("default_heap_field_b", dheap->inner.b, -2);
    delete dheap;

    return result;
}

// =============================================================
// return default; tests
// =============================================================

struct RdPoint
{
    int x = 10;
    int y = 20;
};

class RdNode
{
    int val = 99;
};

int rdInt()       { return default; }
float rdFloat()   { return default; }
bool rdBool()     { return default; }
i64 rdI64()       { return default; }
int* rdIntPtr()   { return default; }
RdNode* rdClassPtr() { return default; }
RdPoint rdStruct() { return default; }
string rdString() { return default; }

int rdCondInt(bool flag)
{
    if (flag)
        return 99;
    return default;
}

RdPoint rdCondStruct(bool flag)
{
    if (flag)
    {
        RdPoint p;
        p.x = 7;
        p.y = 8;
        return p;
    }
    return default;
}

bool testReturnDefaultPrimitives()
{
    bool result = true;
    result &= Test("rd_int",   rdInt(),   0);
    result &= Test("rd_float", rdFloat(), 0.0f);
    result &= Test("rd_bool",  rdBool(),  false);
    result &= Test("rd_i64",   rdI64(),   0);
    return result;
}

bool testReturnDefaultPointers()
{
    bool result = true;
    result &= Test("rd_int_ptr",   rdIntPtr()   == nullptr ? 1 : 0, 1);
    result &= Test("rd_class_ptr", rdClassPtr() == nullptr ? 1 : 0, 1);
    return result;
}

bool testReturnDefaultStruct()
{
    bool result = true;
    RdPoint pt = rdStruct();
    // return default; is the same VALUE as `RdPoint p = default;` - the declared field
    // initializers run (10, 20). It used to zero-fill the return type instead.
    result &= Test("rd_struct_x", pt.x, 10);
    result &= Test("rd_struct_y", pt.y, 20);
    return result;
}

bool testReturnDefaultString()
{
    bool result = true;
    string s = rdString();
    result &= Test("rd_string_len", s.length(), 0);
    return result;
}

bool testReturnDefaultConditional()
{
    bool result = true;
    result &= Test("rd_cond_taken",   rdCondInt(true),  99);
    result &= Test("rd_cond_default", rdCondInt(false), 0);

    RdPoint p1 = rdCondStruct(true);
    result &= Test("rd_cond_struct_x", p1.x, 7);
    result &= Test("rd_cond_struct_y", p1.y, 8);

    RdPoint p2 = rdCondStruct(false);
    result &= Test("rd_cond_struct_zero_x", p2.x, 10);
