    holder.s = string("cat").copy();
    if (form == 1) return (string)holder.s;
    if (form == 2) return string(holder.s);
    return holder.s;
}
string strcastReturnCall(int form)
{
    if (form == 1) return (string)strcastIdentityCallValue();
    if (form == 2) return string(strcastIdentityCallValue());
    return strcastIdentityCallValue();
}
string strcastReturnLiteral(int form)
{
    if (form == 1) return (string)"cat";
    if (form == 2) return string("cat");
    return "cat";
}

bool strcastTestLocalPositions()
{
    bool result = true;
    string plainSource = string("cat").copy();
    string castSource = string("cat").copy();
    string plainLocal = plainSource;
    string castLocal = (string)castSource;
    result &= Test("strcast local declaration cast value and ownership",
                   strcastSameStringResult(&plainLocal, &castLocal), true);
    result &= Test("strcast local declaration cast source state",
                   strcastSameStringSource(&plainSource, &castSource), true);

    string plainFunctionalSource = string("cat").copy();
    string functionalSource = string("cat").copy();
    string plainFunctionalLocal = plainFunctionalSource;
    string functionalLocal = string(functionalSource);
    result &= Test("strcast local declaration functional value and ownership",
                   strcastSameStringResult(&plainFunctionalLocal, &functionalLocal), true);
    result &= Test("strcast local declaration functional source state",
                   strcastSameStringSource(&plainFunctionalSource, &functionalSource), true);

    string plainAssignSource = string("cat").copy();
    string castAssignSource = string("cat").copy();
    string plainAssigned = "old"; plainAssigned = plainAssignSource;
    string castAssigned = "old"; castAssigned = (string)castAssignSource;
    result &= Test("strcast local assignment cast value and ownership",
                   strcastSameStringResult(&plainAssigned, &castAssigned), true);
    result &= Test("strcast local assignment cast source state",
                   strcastSameStringSource(&plainAssignSource, &castAssignSource), true);

    string plainFunctionalAssignSource = string("cat").copy();
    string functionalAssignSource = string("cat").copy();
    string plainFunctionalAssigned = "old"; plainFunctionalAssigned = plainFunctionalAssignSource;
    string functionalAssigned = "old"; functionalAssigned = string(functionalAssignSource);
    result &= Test("strcast local assignment functional value and ownership",
                   strcastSameStringResult(&plainFunctionalAssigned, &functionalAssigned), true);
    result &= Test("strcast local assignment functional source state",
                   strcastSameStringSource(&plainFunctionalAssignSource, &functionalAssignSource), true);

    string plainCallSource = string("cat").copy();
    string castCallSource = string("cat").copy();
    result &= Test("strcast local call argument cast overload",
                   strcastIdentityRoute((string)castCallSource) == 101
                       && strcastIdentityRoute(plainCallSource) == 101, true);
    result &= Test("strcast local call argument cast source state",
                   strcastSameStringSource(&plainCallSource, &castCallSource), true);

    string plainFunctionalCallSource = string("cat").copy();
    string functionalCallSource = string("cat").copy();
    result &= Test("strcast local call argument functional overload",
                   strcastIdentityRoute(string(functionalCallSource)) == 101
                       && strcastIdentityRoute(plainFunctionalCallSource) == 101, true);
    result &= Test("strcast local call argument functional source state",
                   strcastSameStringSource(&plainFunctionalCallSource, &functionalCallSource), true);
    return result;
}

bool strcastTestFieldPositions()
{
