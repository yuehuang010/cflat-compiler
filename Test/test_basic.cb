// =============================================================
// Pointer arithmetic tests
// =============================================================

void incThroughPtr(int* p) { (*p)++; }

// T36: native overloads rank void* against a typed pointer as a conversion, never exact, in
// either declaration order; pointer arithmetic keeps the pointee that ranking needs.
int t36PickVoidFirst(void* v) { return 1; }
int t36PickVoidFirst(int* v) { return 2; }
int t36PickIntFirst(int* v) { return 2; }
int t36PickIntFirst(void* v) { return 1; }
int t36PickChar(void* v) { return 1; }
int t36PickChar(char* v) { return 3; }
// T36 round 2: an unrelated primitive pointee is not viable in an overload set (int* into
// double*), and the ruled char-family conversion ranks below void*; values from clang.
int t36VoidOrDouble(void* v) { return 1; }
int t36VoidOrDouble(double* v) { return 2; }
int t36DoubleOrVoid(double* v) { return 2; }
int t36DoubleOrVoid(void* v) { return 1; }
int t36ThreeWay(void* v) { return 1; }
int t36ThreeWay(int* v) { return 2; }
int t36ThreeWay(double* v) { return 3; }
int t36VoidOrChar(void* v) { return 1; }
int t36VoidOrChar(char* v) { return 2; }
int t36CharOrVoid(char* v) { return 2; }
int t36CharOrVoid(void* v) { return 1; }
int t36Depth(int* v) { return 1; }
int t36Depth(int** v) { return 2; }
int t36TwoFloat(double* v) { return 2; }
int t36TwoFloat(float* v) { return 3; }
int t36TwoFloat<T>(T* v) { return 9; }

bool testPointerArithmetic()
{
    bool result = true;

    // Basic ptr + int
    int* arr = new int[4];
    arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;

    int* p1 = arr + 1;
    result &= Test("ptr+1 elem", p1[0], 20);

    int* p2 = arr + 2;
    result &= Test("ptr+2 elem", p2[0], 30);

    // ptr - int
    int* p3 = p2 - 1;
    result &= Test("ptr-1 elem", p3[0], 20);

    // Chained arithmetic
    int* p4 = arr + 1 + 1;
    result &= Test("ptr+1+1 elem", p4[0], 30);

    // p++ increments by sizeof(int)
    int* p = arr;
    p++;
    result &= Test("int* p++ elem", *p, 20);
    p++;
    result &= Test("int* p++ again", *p, 30);

    // p-- decrements by sizeof(int)
    p--;
    result &= Test("int* p-- elem", *p, 20);

    // Pointer-shaped expression results stay pointers at integer destinations.
    long ptrDiff = p2 - arr;
    result &= Test("pointer difference remains integer", ptrDiff, 2);
    int[8] t27Ints = default;
    int* t27IntPointer = &t27Ints[0];
    result &= Test("t27 int pointer difference parenthesized", (t27IntPointer + 4) - t27IntPointer, 4);
    result &= Test("t27 int pointer difference flat", t27IntPointer + 4 - t27IntPointer, 4);
    result &= Test("t27 nested pointer difference", ((t27IntPointer + 4)) - ((t27IntPointer + 1)), 3);
    result &= Test("t27 pointer range difference", (t27IntPointer + 6) - (t27IntPointer + 2), 4);
    double[8] t27Doubles = default;
    double* t27DoublePointer = &t27Doubles[0];
    result &= Test("t27 double pointer difference parenthesized", (t27DoublePointer + 3) - t27DoublePointer, 3);
    result &= Test("t27 double pointer difference flat", t27DoublePointer + 3 - t27DoublePointer, 3);
    AsaPt[8] t27Points = default;
    AsaPt* t27PointPointer = &t27Points[0];
    result &= Test("t27 struct pointer difference parenthesized", (t27PointPointer + 3) - t27PointPointer, 3);
    result &= Test("t27 struct pointer difference flat", t27PointPointer + 3 - t27PointPointer, 3);
    char[8] t27Chars = "abcdefg";
    char* t27CharPointer = t27Chars;
    result &= Test("t27 char pointer difference parenthesized", (t27CharPointer + 5) - t27CharPointer, 5);
    result &= Test("t27 char pointer difference flat", t27CharPointer + 5 - t27CharPointer, 5);
    i64[5] t27I64s = default;
    i64* t27I64Pointer = &t27I64s[0];
    result &= Test("t27 i64 pointer difference", (t27I64Pointer + 3) - t27I64Pointer, 3);
    u8[5] t27U8s = default;
    u8* t27U8Pointer = &t27U8s[0];
    result &= Test("t27 u8 pointer difference", (t27U8Pointer + 3) - t27U8Pointer, 3);
    int[4] t36Ints = {10, 20, 30, 40};
    int* t36P = &t36Ints[1];
    void* t36V = t36P;
    result &= Test("t36 native int* beats void*", t36PickVoidFirst(t36P), 2);
    result &= Test("t36 native p + n beats void*", t36PickVoidFirst(t36P + 1), 2);
    result &= Test("t36 native n + p beats void*", t36PickVoidFirst(1 + t36P), 2);
    result &= Test("t36 native array decay beats void*", t36PickVoidFirst(t36Ints + 1), 2);
    result &= Test("t36 native void* picks void*", t36PickIntFirst(t36V), 1);
    result &= Test("t36 native p - n order-independent", t36PickIntFirst(t36P - 1), 2);
    result &= Test("t36 native char* arithmetic beats void*", t36PickChar(t27CharPointer + 1), 3);
    result &= Test("t36 native element address arithmetic", t36PickVoidFirst(&t36Ints[1] + 1), 2);
    int* t36Walk = &t36Ints[0];
    t36Walk += 3;
    t36Walk -= 1;
    result &= Test("t36 compound then parenthesized difference", (t36Walk - 1) - &t36Ints[0], 1);
    double[4] t36Doubles = default;
    double* t36D = &t36Doubles[0];
    float t36F = 0;
    float* t36Fp = &t36F;
    result &= Test("t36 int* skips unrelated double*", t36VoidOrDouble(t36P), 1);
    result &= Test("t36 p + n skips unrelated double*", t36VoidOrDouble(t36P + 1), 1);
    result &= Test("t36 int* skips double* reversed", t36DoubleOrVoid(1 + t36P), 1);
    result &= Test("t36 double* exact reversed", t36DoubleOrVoid(t36D + 1), 2);
    result &= Test("t36 three-way int chain", t36ThreeWay(1 + t36P + 1), 2);
    result &= Test("t36 three-way double", t36ThreeWay(t36D), 3);
    result &= Test("t36 three-way float* takes void*", t36ThreeWay(t36Fp + 1), 1);
    u8* t36U8 = &t27U8s[0];
    i8* t36I8 = (i8*)t36U8;
    result &= Test("t36 u8* takes void* over char*", t36VoidOrChar(t36U8), 1);
    result &= Test("t36 u8* takes void* over char* reversed", t36CharOrVoid(t36U8 + 1), 1);
    result &= Test("t36 i8* takes void* over char* reversed", t36CharOrVoid(1 + t36I8), 1);
    int*[8] t36Rows = default;
    int** t36Rp = &t36Rows[0];
    result &= Test("t36 left-integer chain keeps T**", t36Depth(1 + t36Rp + 1), 2);
    result &= Test("t36 right-pointer chain keeps T*", t36Depth(t36P + 1 - 1), 1);
    result &= Test("t36 T** chain difference", (1 + t36Rp + 4) - t36Rp, 5);
    result &= Test("t36 T** four-term difference", (2 + t36Rp + 1 + 1) - t36Rp, 4);
    result &= Test("t36 int chain difference", (1 + t27IntPointer + 1 + 1) - t27IntPointer, 3);
    result &= Test("t36 double chain range difference", (1 + t36D + 2) - (t36D + 1), 2);
    void*[4] t36VoidSlots = default;
    void** t36VoidSlot = &t36VoidSlots[0];
    result &= Test("t36 void** arithmetic stays legal", (1 + t36VoidSlot + 2) - t36VoidSlot, 3);
    result &= Test("t36 float* exact in a float pair", t36TwoFloat(t36Fp + 0), 3);
    // T80: unrelated primitive pointees are refused; the accept-set rows stay accepted.
    // `long` is the target C long: 32-bit on Windows (LLP64), so its equal-width partner is i32.
    long t80Long = 9;
    if const (__WINDOWS__)
    {
        i32* t80WidePtr = &t80Long; long* t80LongPtr = t80WidePtr;
        result &= Test("t80 long* into equal-width i32* accepted", *t80LongPtr, 9);
    }
    else
    {
        i64* t80WidePtr = &t80Long; long* t80LongPtr = t80WidePtr;
        result &= Test("t80 long* into equal-width i64* accepted", *t80LongPtr, 9);
    }
    double t80Dbl = 2.5; void* t80Void = &t80Dbl; double* t80FromVoid = t80Void;
    result &= Test("t80 void* into double* accepted", *t80FromVoid == 2.5, true);
    double* t80Same = &t80Dbl; double* t80SameCopy = t80Same;
    result &= Test("t80 same double* accepted", *t80SameCopy == 2.5, true);
    i8 t80Byte = 65; i8* t80BytePtr = &t80Byte; char* t80Char = (char*)t80BytePtr;
    result &= Test("t80 i8* into char* explicit cast accepted", *t80Char == 'A', true);
    int t80Int = 7;
    result &= Test("t80 explicit int* to double* cast accepted", (double*)&t80Int != nullptr, true);
    // T36 round 5: a pointer never binds an integer `operator string` (round 4 picked i128).
    i8[4] t36Eu = default;
    t36Eu[0] = (i8)0x41; t36Eu[1] = (i8)0x42; t36Eu[2] = (i8)0x43; t36Eu[3] = (i8)0;
    string t36Euro = (string)(char*)&t36Eu[0];
    result &= Test("t36 i8 element address casts to string", (int)t36Euro.length(), 3);
    string t36EuroTail = (string)((char*)&t36Eu[0] + 1);
    result &= Test("t36 i8 pointer arithmetic casts to string", (int)t36EuroTail.length(), 2);
    string t36EuroU8 = (string)(char*)(u8*)&t36Eu[0];
    result &= Test("t36 u8 pointer casts to string", (int)t36EuroU8.length(), 3);
    char literalA = 'a';
    result &= Test("character literal remains character", literalA, 'a');
    bool boolFromArithmetic = arr + 1;
    bool boolFromString = "abc";
    int* nullPointer = nullptr;
    bool boolFromCoalesce = nullPointer ?? arr;
    bool boolFromTernary = true ? arr : nullptr;
    result &= Test("bool from pointer arithmetic", boolFromArithmetic, true);
    result &= Test("bool from string literal", boolFromString, true);
    result &= Test("bool from null coalesce", boolFromCoalesce, true);
    result &= Test("bool from nullptr ternary", boolFromTernary, true);
    int* postfixNeighbor = arr;
    postfixNeighbor++;
    result &= Test("pointer postfix increment remains pointer", *postfixNeighbor, 20);

    // Assignment to an existing plain pointer borrows the owning source.
    int* assigned = arr + 1;
    assigned = arr;
    assigned++;
    result &= Test("pointer assignment keeps source live", arr[0], 10);
    result &= Test("pointer assignment advances borrow", *assigned, 20);

    destructorCallCount = 0;
    {
        Tracked* owned = nullptr;
        owned = new Tracked();
        result &= Test("pointer assignment owns new value", owned != nullptr ? 1 : 0, 1);
    }
    result &= Test("pointer assignment new freed", destructorCallCount, 1);

    // (*p)++ / (*p)-- increment the POINTEE, not the pointer. Regression: the
    // parenthesized deref lost its storage, so the increment silently no-op'd
    // (fsh's edInsert (*len)++ never advanced and the line editor dropped keys).
    (*p)++;
    result &= Test("(*p)++ pointee", arr[1], 21);
    result &= Test("(*p)++ ptr unmoved", *p, 21);
    (*p)--;
    result &= Test("(*p)-- pointee", arr[1], 20);
    incThroughPtr(&arr[2]);
    result &= Test("(*param)++ writes back", arr[2], 31);

    // p += n
    int* q = arr;
    q += 3;
    result &= Test("int* p+=3 elem", *q, 40);

    // p -= n
    q -= 2;
    result &= Test("int* p-=2 elem", *q, 20);

    // ptr - ptr -> element count
    int* start = arr;
    int* end = arr + 4;
    int diff = (int)(end - start);
    result &= Test("ptr-ptr elem count", diff, 4);

    // i8* arithmetic (byte-sized: p++ still correct)
    i8* buf = (i8*)new i8[4];
    buf[0] = 65; buf[1] = 66; buf[2] = 67; buf[3] = 0;

    i8* b1 = buf + 1;
    result &= Test("i8*+1", b1[0], 66);

    i8* b2 = b1 + 1;
    result &= Test("i8*+1+1", b2[0], 67);

    i8* b3 = b2 - 2;
    result &= Test("i8*-2", b3[0], 65);

    // i8* cursor walk with ++
    i8* cursor = buf;
    cursor++;
    result &= Test("i8* cursor++", *cursor, 66);
    cursor++;
    result &= Test("i8* cursor++ again", *cursor, 67);

    // i8* ptr - ptr -> byte count
    i8* bstart = buf;
    i8* bend = buf + 4;
    int bdiff = (int)(bend - bstart);
    result &= Test("i8* ptr-ptr byte count", bdiff, 4);

    delete[] arr;
    delete[] buf;
    return result;
}

// =============================================================
// In-place destructor (.~()) tests
// =============================================================

int g_inplace_dtor_count = 0;

struct Destructible
{
    int value = 0;

    ~Destructible()
    {
        g_inplace_dtor_count++;
    }
};

bool testInPlaceDtor()
{
    bool result = true;

    // Allocate a raw buffer large enough for 3 Destructible elements.
    // Use .~() to destroy individual elements without freeing the buffer.
    Destructible* buf = new Destructible[3];
    buf[0].value = 10;
    buf[1].value = 20;
    buf[2].value = 30;

    g_inplace_dtor_count = 0;

    // Destroy element 1 in place - buffer must remain usable.
    buf[1].~();
    result &= Test(".~() dtor called once",  g_inplace_dtor_count, 1);
    result &= Test(".~() buf[0] intact",     buf[0].value, 10);
    result &= Test(".~() buf[2] intact",     buf[2].value, 30);

    // Destroy the remaining two elements in place before freeing.
    buf[0].~();
    buf[2].~();
    result &= Test(".~() all three called", g_inplace_dtor_count, 3);

    // Free only the backing buffer - destructors already ran.
    delete[_] buf;

    return result;
}

