}

bool testT515ClosureListMove()
{
    bool result = true;
    int constructorsBefore = t515HolderCtors;
    int destructorsBefore = t515HolderDtors;
    {
        list<T515ClosureMember> values = default;
        result &= Test("t515_list_default_count", values.count(), 0);
        T515ClosureMember source = T515ClosureMember(6);
        // Mirrors vector::push_back(move source): the stored closure observes the moved-from slot.
        values.add(move source);
        source.id = 12;
        result &= Test("t515_list_get_closure_tracks_moved_source", values.get(0).f(), 12);
        result &= Test("t515_list_index_closure_tracks_moved_source", values[0].f(), 12);
        int iterationValue = 0;
        for (T515ClosureMember item in values) iterationValue += item.f();
        result &= Test("t515_list_iteration_closure", iterationValue, 12);
        result &= Test("t515_list_count", values.count(), 1);
        result &= Test("t515_list_ctor_count", t515HolderCtors - constructorsBefore, 1);
    }
    result &= Test("t515_list_dtor_count", t515HolderDtors - destructorsBefore, 3);
    return result;
}

