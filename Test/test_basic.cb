T114MoveSink* t114MoveSinkKeep = nullptr;
int t114TakeMoveSink(move T114MoveSink* p)
{
    int value = p->value;
    t114MoveSinkKeep = move p;
    return value;
}
bool testT114MoveDimension()
{
    int size = 0;
    t114MoveSinkDtors = 0;
    {
        T114MoveSink* p = new T114MoveSink();
        p->value = 3;
        int[t114TakeMoveSink(move p)] values = default;
        size = (int)sizeof(values);
    }
    delete t114MoveSinkKeep;
    t114MoveSinkKeep = nullptr;
    return Test("array_dim_move_value", size, 4)
        && Test("array_dim_move_dtor_once", t114MoveSinkDtors, 1);
}
