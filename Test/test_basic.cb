namespace T503A {
    struct Mid { int value = 1; };
    struct S {
        struct Mid { int value = 2; int extra = 0; };
        struct Inner {
            Mid field = default;
            Mid make() { Mid value = default; return value; }
            int local() { Mid value = default; return value.value; }
            int take(Mid value) { return value.value; }
            int parameter() { Mid value = default; return take(value); }
            int size() { return sizeof(Mid); }
            struct Holder<T> { T value = default; int read() { return value.value; } };
            int genericArgument() { Holder<Mid> value = default; return value.read(); }
            int allocate() { auto value = new Mid(); int result = value->value; delete value; return result; }
            int cast() { return S.choose((Mid*)nullptr); }
        };
        static int choose(T503A.Mid* value) { return 1; }
        static int choose(Mid* value) { return 2; }
    };
}

namespace T503B {
    struct Mid { int value = 1; };
