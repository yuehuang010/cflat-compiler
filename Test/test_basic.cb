// Named enum - enumerators should be registered as globals.
enum MyEnum : u8 { E_ONE = 1, E_TWO, E_THREE = 5 };

// An enum is a first-class type. Pre-fix each of these failed for a different reason:
// the widening ones read a narrow UNSIGNED member back sign-extended (u8 200 -> -56),
// the i64/u64 ones terminated the compiler with std::out_of_range out of std::stoi,
// the namespaced one could not be reached as `EnumNs.Facing.Back` from outside, and
// `enumUsedBeforeDeclaration` could not see an enum declared further down the file.
enum WideU8   : u8  { WU8_BIG = 200, WU8_MAX = 255 };
enum WideU16  : u16 { WU16_BIG = 40000 };
enum NarrowI8 : i8  { NI8_NEG = -1 };
enum WideI64  : i64 { WI64_LOW = -3000000000, WI64_HIGH = 4000000000 };
enum WideU64  : u64 { WU64_HIGH = 9223372036854775808 };
// Backing spelled through a `using` alias: the resolved type drives width and signedness.
using EnumByte = u8;
enum AliasBacked : EnumByte { AB_HI = 200 };
// Initializer the pre-pass cannot fold statically, so the codegen folder supplies it: the u64
// maximum must widen unsigned, not sign-extend to -1.
enum DynU64 : u64 { DU64_MAX = 18446744073709551615 - 0 };

namespace EnumNs { enum Facing : int { Back = -7, Fwd = 7 }; }

using FacingAlias = EnumNs.Facing;

struct EnumHolder { WideU8 band = default; int amount = default; };
struct TEnumMemberDefault { MyEnum value = MyEnum.E_THREE; };
MyEnum tEnumAcceptGlobal = MyEnum.E_ONE;
const int tEnumAcceptConst = 29;
int[MyEnum.E_TWO] tEnumAcceptArray = default;
int tEnumAcceptByValue(MyEnum value) { return (int)value + 10; }
int tEnumAcceptGeneric<T>(T value) { return (int)value; }
int tEnumAcceptIfConst()
{
    if const (MyEnum.E_TWO == 2) { return 17; }
    else { return -1; }
}

