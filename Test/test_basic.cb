bool testNestedNamespace()
{
    bool result = true;
    result &= Test("nested_square", MathUtils.Advanced.square(4), 16);    // 4*4=16
    result &= Test("nested_cube", MathUtils.Advanced.cube(3), 27);        // 3*3*3=27

    using Adv = MathUtils.Advanced;  // local alias for nested namespace
    result &= Test("nested_using_square", Adv.square(5), 25);             // 5*5=25
    result &= Test("nested_using_cube", Adv.cube(2), 8);                  // 2*2*2=8
    return result;
}

bool testNestedUsing()
{
    bool result = true;

    // Global alias for nested namespace
    result &= Test("global_nested_using_square", MathAdv.square(4), 16);  // 4*4=16
    result &= Test("global_nested_using_cube", MathAdv.cube(3), 27);      // 3*3*3=27

    // Local alias for nested namespace shadows nothing; verify it works
    using Adv2 = MathUtils.Advanced;
    result &= Test("local_nested_using_square", Adv2.square(6), 36);      // 6*6=36
    result &= Test("local_nested_using_cube", Adv2.cube(4), 64);          // 4*4*4=64
    return result;
}

// Namespace-aware TYPE lookup, one shared shadowing policy for structs, aliases and
// function-pointer pointees. Three same-named structs on three rungs, told apart by how many
// fields they have: the root one has three, ScopeOuter.ShadowPt2 one, ScopeOuter.Inner one two.
struct ShadowPt2 { int a = default; int b = default; int c = default; };

namespace ScopeOuter
{
    struct ShadowPt2 { int a = default; };
    int outerOnly(ShadowPt2* p) { return p->a + 30; }

    namespace Inner
    {
        struct ShadowPt2 { int a = default; int b = default; };
        using ShadowAlias2 = ShadowPt2;   // alias DECLARED here, used from Inner.Deep below

        // Bare spelling inside Inner: the innermost declaration wins, so `b` exists.
        int innerShadow() { ShadowPt2 p; p.a = 1; p.b = 2; return p.a + p.b; }
        // A qualified spelling bypasses the inner shadow and names ScopeOuter.ShadowPt2 - if it
        // did not, outerOnly() would not accept the pointer and this would not compile.
        int qualifiedBypass() { ScopeOuter.ShadowPt2 p; p.a = 4; return outerOnly(&p); }
        // Function-pointer pointee spelled unqualified while a same-tail struct also exists at
        // the root: the visible (inner) struct is meant, and the crossing must bind.
        void fillShadow(ShadowPt2* p) { p->a = 6; p->b = 7; }
        int runShadow(function<void(ShadowPt2*)> f) { ShadowPt2 q; f(&q); return q.a + q.b; }

        namespace Deep
        {
            // An alias declared in the ENCLOSING namespace resolves from the nested one.
            int aliasFromNested() { ShadowAlias2 p; p.a = 5; p.b = 6; return p.a + p.b; }
            // Bare spelling from the nested namespace still walks out to Inner, not to the root.
            int bareFromNested() { ShadowPt2 p; p.a = 9; p.b = 1; return p.a + p.b; }
        }
    }
}

// A namespace alias must reach a GENERIC template base, not just a plain struct: the template
// key is registered as ScopeOuter.Inner.ShadowBox2 and the alias hop has to find it.
namespace ScopeOuter { namespace Inner { struct ShadowBox2<T> { T v = default; }; } }
using ShadowIN2 = ScopeOuter.Inner;
// A real namespace spelled like an alias outranks the alias hop (verbatim candidate first),
// the same order plain-struct lookup uses, so both pre-scans queue one canonical key.
namespace ShadowRealNs { struct ShadowBox3<T> { T v = default; int tag() { return 1; } }; }
namespace ScopeOuter { namespace Inner { struct ShadowBox3<T> { T v = default; int tag() { return 2; } }; } }
using ShadowRealNs = ScopeOuter.Inner;
int shadowRealNamespaceOutranksAlias() { ShadowRealNs.ShadowBox3<int> b; return b.tag(); }
namespace ShadowOther2
{
    int aliasedGenericBase() { ShadowIN2.ShadowBox2<int> b; b.v = 8; return b.v + 1; }
    int aliasedPlainStruct() { ShadowIN2.ShadowPt2 p; p.a = 4; p.b = 3; return p.a + p.b; }
}

