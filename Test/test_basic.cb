        mtplStaticLambda.call(), 4);
    MtplRound2NS.PlainArityBeforeTemplate mtplPlainArity = default;
    result &= Test("mtpl arity mismatch plain does not hide template",
        mtplPlainArity.call(), 12);
    MtplGenericMemberOverload mtplGeneric = default;
    result &= Test("mtpl generic beats nonviable plain overload bare",
        mtplGeneric.bareCall(), 1);
    result &= Test("mtpl generic beats nonviable plain overload this",
        mtplGeneric.thisCall(), 1);
    result &= Test("mtpl generic beats nonviable plain overload receiver",
        mtplGeneric.gv(3), 1);
    result &= Test("mtpl int to double call remains rejected",
        mtplDoubleOnlyCallRemainsRejected(), true);
    result &= Test("t484 generic no shadow", t484GenericNoShadow(3), 13);
    result &= Test("t484 non-generic no shadow", t484PlainNoShadow(3), 23);
    result &= Test("t484 qualified call with root name", T484CallNS.id(3), 33);
    T484GvMember gvMember = default;
    result &= Test("t484 root var vs namespace and member functions",
        T484GlobalGvNS.call() * 10 + gvMember.call(), 44);
    result &= Test("t484 root var vs generic namespace function", T484GenericGvNS.call(), 4);
    T484MethodReceiver t484Receiver = default;
    int id = 5;
    result &= Test("t484 explicit method with local name", t484Receiver.id(3), 43);
    T484MemberFirst t484MemberFirstValue = default;
    result &= Test("t484 T471 member before free", t484MemberFirstValue.call(), 15);
    T471BareCall value = default;
    result &= Test("t471_bare_free_after", value.callFree(), 15);
    result &= Test("t471_bare_const_free_after", value.callConstFree(), 25);
    result &= Test("t471_bare_local_self", value.callLocalFree(), 15);
    result &= Test("t471_bare_method_hides_free", value.callCollision(), 10);
    result &= Test("t471_bare_static_member_hides_free", T471BareCall.callStatic(), 15);
    result &= Test("t471_bare_static_lambda_hides_free", T471BareCall.callStaticLambda(), 13);
    T471BareGenericCallback callbacks = default;
    result &= Test("t471_bare_generic_callback_first", callbacks.callFirst(), 16);
    result &= Test("t471_bare_generic_callback_second", callbacks.callSecond(), 26);
    T471BareGlobalFpMethod globalFpMethod = default;
    result &= Test("t471_bare_global_fp_loses_to_method", globalFpMethod.call(), 15);
    result &= Test("t471_bare_global_fp_still_callable", t471BareGlobalFpVsMethod(5), 25);
    T471BareGenericStatic<int> genericStatic = default;
    result &= Test("t471_bare_generic_static_hides_free", genericStatic.fromInstance(), 15);
    result &= Test("t471_bare_generic_static_from_static", T471BareGenericStatic<int>.fromStatic(), 16);
    return result;
}

bool testConstTrailing()
{
    bool result = true;
    T343AliasInferred aliasInferred = default;
    alias int aliasValue = aliasInferred.Ref();
    aliasValue = 52;
    result &= Test("t343_inferred_alias_return", aliasInferred.value, 52);
    int target = 3;
    const C08TBox box = { n = 5, p = &target };
    C08TBox m = default;
    m.Set(8);
    result &= Test("const_trailing_marked", box.Get(), 5);
    result &= Test("const_trailing_marked_through_ptr", box.Peek(), 3);
    result &= Test("const_trailing_unmarked_inferred", box.Inferred(), 15);
    result &= Test("const_trailing_calls_inferred", box.Both(), 20);
    result &= Test("const_trailing_mutable_receiver", m.Get(), 8);
    result &= Test("const_trailing_const_result", *box.Addr(), 5);
    result &= Test("const_trailing_const_result_is_field", box.Addr() == &box.n ? 1 : 0, 1);
    (const C08TBox)* view = &m;
    result &= Test("const_trailing_pointer_to_const", view->Get(), 8);
    C08TBox sum = box + m;
    result &= Test("const_trailing_operator", sum.n, 13);
    const C08TCell<int> cell = { v = 4 };
    const C08TCell<double> realCell = { v = 2.5 };
    result &= Test("const_trailing_generic", cell.Read() + (int)(realCell.Read() * 2.0), 9);
    C08TMarked marked = default;
    C08TInferred inferred = default;
    IC08TRead viaMarked = &marked;
    IC08TRead viaInferred = &inferred;
    result &= Test("const_trailing_iface_param", c08TViaConst(viaMarked) + c08TViaConst(viaInferred), 84);
    result &= Test("const_trailing_iface_alias", c08TViaAlias(viaInferred), 14);
    C08TIfaceHolder holder = { r = viaMarked };
    result &= Test("const_trailing_iface_field", c08TViaHolder(holder), 70);
    return result;
}

// string data() is (const char)*; data_mut() copies a borrowed string into an owned buffer
// first, so a write never reaches a literal or a wrapped char* buffer.
struct C15StrHolder { string f = default; int n = 0; };

bool testStringDataMut()
{
    bool result = true;
    string s = "x";
    s.data_mut()[0] = 'y';
    result &= Test("data_mut_literal_written", (int)s.data()[0], (int)'y');
    string t = "x";
    result &= Test("data_mut_literal_untouched", (int)t.data()[0] + (int)"x"[0], 2 * (int)'x');
    result &= Test("data_mut_borrowed_now_owned", ((s._len & (i32)0x80000000) != 0 ? 1 : 0) + s.length(), 2);
    char[4] raw = "abc";
    string wrap = &raw[0];
    wrap.data_mut()[0] = 'Z';
    result &= Test("data_mut_wrap_copies", (int)wrap.data()[0] * 1000 + (int)raw[0], (int)'Z' * 1000 + (int)'a');
    string owned = "abc".copy();
    (const char)* before = owned.data();
    char* w = owned.data_mut();
    w[1] = 'X';
    result &= Test("data_mut_owned_in_place", (before == owned.data() ? 1 : 0) + (owned == "aXc" ? 2 : 0), 3);
    string empty = default;
    char* e = empty.data_mut();
    result &= Test("data_mut_default_empty", (int)e[0] + empty.length() + (e != nullptr ? 1 : 0), 1);
    C15StrHolder h = default;
    h.f = "lit";
    h.f.data_mut()[0] = 'F';
    result &= Test("data_mut_field", h.f == "Fit" ? 1 : 0, 1);
    string moved = move s;
    result &= Test("data_mut_then_move", (int)moved.data()[0], (int)'y');
    return result;
}

// Function types carry pointee const (ruled 2026-10-19): `(const T)*` params and returns resolve in
// function<> / Lambda<>, a function name binds with its declared consts, and the type is exact.
int c14TLen(const char* s) { int n = 0; while (s[n] != 0) n++; return n; }
int c14TPoke(char* s) { s[0] = 'X'; return 100; }
(const char)* c14TName() { return "name"; }
int c14TApply(function<int((const char)*)> f, (const char)* s) { return f(s) * 10; }
int c14TApplyT<T>(function<int(T)> f, T v) { return f(v) + 1000; }
int c14TPick(function<int(char*)> f) { return 10; }
int c14TPick(function<int((const char)*)> f) { return 20; }

bool testConstFunctionType()
{
    bool result = true;
    function<int((const char)*)> f = c14TLen;
    function<int(TcCStr)> viaAlias = c14TLen;
    function<int(const(char)*)> viaConstCall = c14TLen;
    function<int(char*)> g = c14TPoke;
    function<(const char)*()> h = c14TName;
    Lambda<int((const char)*)> lam = ((const char)* s) => c14TLen(s) + 1;
    Lambda<(const char)*()> lamName = () => "lit";
    result &= Test("const_fntype_param", f("abc"), 3);
    result &= Test("const_fntype_alias_param", viaAlias("ab"), 2);
    result &= Test("const_fntype_const_call_spelling", viaConstCall("abcd"), 4);
    char[4] buf = default;
    buf[0] = 'a';
    result &= Test("const_fntype_mutable_param", g(&buf[0]) + (int)buf[0], 188);
    (const char)* name = h();
    result &= Test("const_fntype_return", c14TLen(name) + (int)name[0], 114);
    result &= Test("const_fntype_lambda_param", lam("x"), 2);
    result &= Test("const_fntype_lambda_return", c14TLen(lamName()), 3);
    result &= Test("const_fntype_named_arg", c14TApply(c14TLen, "xy"), 20);
    result &= Test("const_fntype_value_arg", c14TApply(f, "xyz"), 30);
    result &= Test("const_fntype_generic_arg", c14TApplyT<(const char)*>(f, "four"), 1004);
    list<function<int((const char)*)>> fns = default;
    fns.add(f);
    fns.add(c14TLen);
    result &= Test("const_fntype_list_element", fns[0]("hello") + fns[1]("hi") * 10, 25);
    auto copied = f;
    result &= Test("const_fntype_auto_copy", copied("seven!!"), 7);
    // Overloads on a function-type parameter's pointee const pick the exact match (clang++ -std=c++20).
    result &= Test("const_fntype_overload_value", c14TPick(g) * 100 + c14TPick(f), 1020);
    result &= Test("const_fntype_overload_name", c14TPick(c14TPoke) * 100 + c14TPick(c14TLen), 1020);
    return result;
}

namespace CountofFunctions
{
    int countof(int value) { return value + 10; }
    int call() { return countof(32); }
}
int testCountofGlobalFunction() { return CountofFunctions.call(); }
namespace CountofGlobalVariable
{
    function<int(int)> countof = default;
    int call()
    {
        countof = (int value) => value + 10;
        return countof(32);
    }
}
int testCountofParameter(function<int(int)> countof, int value) { return countof(value); }

struct CountofFieldCaller
{
    function<int(int)> countof = default;
    int call() { return countof(5); }
};

bool testCountofNameResolution()
{
    bool result = true;
    result &= Test("countof user function wins", testCountofGlobalFunction(), 42);
    result &= Test("countof global variable wins", CountofGlobalVariable.call(), 42);
    function<int(int)> countof = (int value) => value + 20;
    result &= Test("countof local shadow wins", countof(22), 42);
    result &= Test("countof parameter wins", testCountofParameter((int value) => value + 39, 3), 42);
    CountofFieldCaller holder = default;
    holder.countof = (int value) => value + 37;
    result &= Test("countof implicit this field wins", holder.call(), 42);
    return result;
}

using CountofArrayAlias = int[5];

struct CountofBuffer<T, int N>
{
    T[N] items = default;
    int count() { return (int)countof(items); }
};

struct CountofValueBox<int Size>
{
    int value() { return Size; }
};

struct CountofLeaf
{
    int[3][4] data = default;
    int countThis() { return (int)countof(this.data); }
};

struct CountofBranch { CountofLeaf leaf = default; };
struct CountofRoot { CountofBranch branch = default; };

int[3][4] countofGlobalMatrix = default;
const int countofGlobalExtent = (int)countof(countofGlobalMatrix);
CountofBuffer<int, (int)countof(countofGlobalMatrix)> countofGlobalBuffer = default;
CountofBuffer<int, 3> countofLiteralBuffer = default;

struct SizeofRowCell { int first = default; int second = default; };
struct SizeofRowCollision { int one = default; int two = default; };
struct SizeofRowFixture
{
    int[2][3] ints = default;
    int[2][3][4] cube = default;
    double[2][3] doubles = default;
    SizeofRowCell[2][3] cells = default;
    char[2][3] chars = default;
};
int[2][3] sizeofRowGlobal2 = default;
int[2][3][4] sizeofRowGlobal3 = default;
double[2][3] sizeofRowGlobalDouble2 = default;
char[2][3] sizeofRowGlobalChar2 = default;
int sizeofRowSideCalls = 0;
int sizeofRowIndex()
{
    sizeofRowSideCalls++;
    return 1;
}
int sizeofRowParam2(SizeofRowFixture value) { return (int)sizeof(value.ints[1]); }
int sizeofRowParam2Element(SizeofRowFixture value) { return (int)sizeof(value.ints[1][2]); }
int sizeofRowParam3(SizeofRowFixture value) { return (int)sizeof(value.cube[1]); }
int sizeofRowParam3Middle(SizeofRowFixture value) { return (int)sizeof(value.cube[1][2]); }
int sizeofRowParam3Element(SizeofRowFixture value) { return (int)sizeof(value.cube[1][2][3]); }

int[11] countofNestedItems = default;
namespace CountofNestedOuter
{
    int[8] countofNestedItems = default;
    namespace Inner
    {
        int[3] countofNestedItems = default;
        int verify()
        {
            int[countof(countofNestedItems)] local = default;
            int branch = 0;
            if const (countof(countofNestedItems) == 3) { branch = 1; } else { branch = 2; }
            return (int)countof(local) * 100 + (int)countof(countofNestedItems) * 10 + branch;
        }
    }
}

int[11] countofFallbackItems = default;
namespace CountofFallbackOuter
{
    int[8] countofFallbackItems = default;
    namespace Inner
    {
        int verify()
        {
            int[countof(countofFallbackItems)] local = default;
            return (int)countof(local) * 100 + (int)countof(countofFallbackItems);
        }
    }
}

int[7] countofNItems = default;
namespace CountofQualifiedNs
{
    int[5] countofNItems = default;
    int verifyBare()
    {
        CountofValueBox<(int)countof(countofNItems)> box = default;
        return box.value() * 10 + (int)countof(countofNItems);
    }
    int verifyQualified()
    {
        CountofValueBox<(int)countof(CountofQualifiedNs.countofNItems)> box = default;
        return box.value() * 10 + (int)countof(CountofQualifiedNs.countofNItems);
    }
}

int[11] countofMethodItems = default;
namespace CountofMethodNamespace
{
    int[6] countofMethodItems = default;
    struct Counter
    {
        int verify()
        {
            int[countof(countofMethodItems)] local = default;
            return (int)countof(local) * 10 + (int)countof(countofMethodItems);
        }
    };
}

bool testCountofNamespaceResolution()
{
    bool result = true;
    result &= Test("countof nested namespace shadow", CountofNestedOuter.Inner.verify(), 331);
    result &= Test("countof parent namespace fallback", CountofFallbackOuter.Inner.verify(), 808);
    result &= Test("countof namespace generic value", CountofQualifiedNs.verifyBare(), 55);
    result &= Test("countof explicitly qualified generic value", CountofQualifiedNs.verifyQualified(), 55);
    CountofMethodNamespace.Counter counter = default;
    result &= Test("countof namespace struct method", counter.verify(), 66);
    return result;
}

bool testCountofSemantics()
{
    bool result = true;
    int[3][4] matrix = default;
    result &= Test("countof local outer dimension", (int)countof(matrix), 3);
    result &= Test("countof result type i64", countof(matrix), (i64)3);
    result &= Test("countof indexed inner dimension", (int)countof(matrix[0]), 4);
    result &= Test("countof parenthesized operand", (int)countof((matrix)), 3);
    int*[2] pointers = default;
    result &= Test("countof fixed array of pointers", (int)countof(pointers), 2);

    CountofArrayAlias alias = default;
    result &= Test("countof array alias", (int)countof(alias), 5);
    CountofLeaf leaf = default;
    result &= Test("countof direct field", (int)countof(leaf.data), 3);
    result &= Test("countof explicit this field", leaf.countThis(), 3);
    CountofRoot root = default;
    result &= Test("countof nested field path", (int)countof(root.branch.leaf.data), 3);
    result &= Test("countof global array", (int)countof(countofGlobalMatrix), 3);
    result &= Test("countof global initializer", countofGlobalExtent, 3);

    int index = 0;
    int innerCount = (int)countof(matrix[index++]);
    result &= Test("countof operand side effect omitted", innerCount * 10 + index, 40);

    int branch = 0;
    if const (countof(matrix) == 3) { branch = 17; } else { branch = 29; }
    result &= Test("countof if const", branch, 17);
    int[countof(matrix)] bounded = default;
    result &= Test("countof array dimension", (int)(sizeof(bounded) / sizeof(int)), 3);
    CountofBuffer<int, (int)countof(matrix)> localBuffer = default;
    result &= Test("countof local generic value argument", localBuffer.count(), 3);
    result &= Test("countof generic value argument", countofGlobalBuffer.count(), 3);
    result &= Test("countof generic body T[N]", countofLiteralBuffer.count(), 3);
    result &= Test("sizeof remains byte size", (int)sizeof(matrix), 48);

    // Packed dimensions make each row-size leg fail on master while checking scalar sizes too.
    result &= Test("sizeof global int2 syntax forms and element",
        (int)sizeof(sizeofRowGlobal2) * 1000
            + (int)sizeof sizeofRowGlobal2[1] * 100
            + (int)sizeof((sizeofRowGlobal2[1])) * 10
            + (int)sizeof(sizeofRowGlobal2[1][2]), 25324);
    result &= Test("sizeof global int3 row middle and element",
        (int)sizeof(sizeofRowGlobal3) * 10000 + (int)sizeof(sizeofRowGlobal3[1]) * 100
            + (int)sizeof(sizeofRowGlobal3[1][2]) * 10 + (int)sizeof(sizeofRowGlobal3[1][2][3]), 964964);
    result &= Test("sizeof global runtime index and no side effect",
        (int)sizeof(sizeofRowGlobal3[sizeofRowIndex()]) * 10 + sizeofRowSideCalls, 480);
    result &= Test("sizeof global double2 row", (int)sizeof(sizeofRowGlobalDouble2[1]), 24);
    result &= Test("sizeof global char2 row", (int)sizeof(sizeofRowGlobalChar2[1]), 3);

    int[2][3] sizeofRowLocal2 = default;
    int[2][3][4] sizeofRowLocal3 = default;
    double[2][3] sizeofRowLocalDouble2 = default;
    SizeofRowCell[2][3] sizeofRowLocalStruct2 = default;
    char[2][3] sizeofRowLocalChar2 = default;
    int sizeofRowLocalIndex = 0;
    result &= Test("sizeof local int2 row runtime index and element",
        (int)sizeof(sizeofRowLocal2[1]) * 100
            + (int)sizeof(sizeofRowLocal2[sizeofRowLocalIndex]) * 10
            + (int)sizeof(sizeofRowLocal2[1][2]), 1324);
    int[2][3] SizeofRowCollision = default;
    result &= Test("sizeof local type-name collision and unique row",
        (int)sizeof(SizeofRowCollision[1]) * 10 + (int)sizeof(sizeofRowLocal2[1]), 132);
    result &= Test("sizeof local int3 row middle and element",
        (int)sizeof(sizeofRowLocal3[1]) * 100 + (int)sizeof(sizeofRowLocal3[1][2]) * 10
            + (int)sizeof(sizeofRowLocal3[1][2][3]), 4964);
    result &= Test("sizeof local double2 row", (int)sizeof(sizeofRowLocalDouble2[1]), 24);
    result &= Test("sizeof local struct2 row and element",
        (int)sizeof(sizeofRowLocalStruct2[1]) * 10
            + (int)sizeof(sizeofRowLocalStruct2[1][2]), 248);
    result &= Test("sizeof local char2 row", (int)sizeof(sizeofRowLocalChar2[1]), 3);

    SizeofRowFixture sizeofRowFixture = default;
    SizeofRowFixture* sizeofRowPointer = &sizeofRowFixture;
    result &= Test("sizeof field and arrow int2 row and element",
        (int)sizeof(sizeofRowFixture.ints[1]) * 100
            + (int)sizeof(sizeofRowPointer->ints[1]) * 10
            + (int)sizeof(sizeofRowFixture.ints[1][2]), 1324);
    result &= Test("sizeof field int3 row middle and element",
        (int)sizeof(sizeofRowFixture.cube[1]) * 100
            + (int)sizeof(sizeofRowFixture.cube[1][2]) * 10
            + (int)sizeof(sizeofRowFixture.cube[1][2][3]), 4964);
    result &= Test("sizeof field double2 row", (int)sizeof(sizeofRowFixture.doubles[1]), 24);
    result &= Test("sizeof field struct2 row and element",
        (int)sizeof(sizeofRowFixture.cells[1]) * 10
            + (int)sizeof(sizeofRowFixture.cells[1][2]), 248);
    result &= Test("sizeof field char2 row", (int)sizeof(sizeofRowFixture.chars[1]), 3);
    result &= Test("sizeof struct parameter int2 row and element",
        sizeofRowParam2(sizeofRowFixture) * 10 + sizeofRowParam2Element(sizeofRowFixture), 124);
    result &= Test("sizeof struct parameter int3 row middle and element",
        sizeofRowParam3(sizeofRowFixture) * 100 + sizeofRowParam3Middle(sizeofRowFixture) * 10
            + sizeofRowParam3Element(sizeofRowFixture), 4964);
    result &= Test("sizeof arrow runtime index and no side effect",
        (int)sizeof(sizeofRowPointer->ints[sizeofRowIndex()]) * 10 + sizeofRowSideCalls, 120);
    int*[2][3] sizeofRowPointers2 = default;
    result &= Test("sizeof pointer-array row element and alignof row",
        (int)sizeof(sizeofRowPointers2[1]) * 100 + (int)sizeof(sizeofRowPointers2[1][2]) * 10
            + (int)alignof(sizeofRowPointers2[1]), 2488);
    return result;
}

import "test_helper.cb" as R3ImportAlias;
