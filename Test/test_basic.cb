    s->pt.y = y;
}

int testArray()
{
    int arraySize = 30;
    int[arraySize] array;

    int i = 0;
    while (i < arraySize)
    {
        array[i] = i;
        i++;
    }

    int sum = 0;
    i = 0;
    while (i < arraySize)
    {
        sum += array[i];
        i++;
    }

    int checks = 0;
    int[(2.0 > 1.0) ? 2 : 1] localDouble = default;
    localDouble[1] = 114;
    checks += Test("t114_local_double_ternary_size", (int)sizeof(localDouble), 8);
    checks += Test("t114_local_ternary_storage", localDouble[1], 114);
    int[(1 > 0) ? ((3 > 2) ? 3 : 1) : 1] localNested = default;
    checks += Test("t114_local_nested_ternary_size", (int)sizeof(localNested), 12);
    int[(2 > 1) ? 2 : 1] localIntCompare = default;
    checks += Test("t114_local_int_compare_size", (int)sizeof(localIntCompare), 8);
    int[(1 < 2.0) ? 2 : 1] localDoubleCompare = default;
    checks += Test("t114_local_double_compare_size", (int)sizeof(localDoubleCompare), 8);
    int[(1 && 1) ? 2 : 1] localAnd = default;
    checks += Test("t114_local_and_size", (int)sizeof(localAnd), 8);
    int[(1 || 0) ? 2 : 1] localOr = default;
    checks += Test("t114_local_or_size", (int)sizeof(localOr), 8);
    int[T114Bound.T114Two] localEnum = default;
    checks += Test("t114_local_enum_size", (int)sizeof(localEnum), 8);
    int[T114ConstBound] localConst = default;
    checks += Test("t114_local_const_size", (int)sizeof(localConst), 8);
    T114LogicalDimAlias aliasArray = default;
    checks += Test("t114_logical_alias_size", (int)sizeof(aliasArray), 8);
    int[(2 > 1) ? 2 : 1][3] localMulti = default;
    checks += Test("t114_local_multidim_size", (int)sizeof(localMulti), 24);
    int* cStylePointers[(2 > 1) ? 2 : 1] = default;
    checks += Test("t114_cstyle_pointer_array_size", (int)sizeof(cStylePointers), 16);
    static int[(2.0 > 1.0) ? 2 : 1] staticDouble = default;
    checks += Test("t114_static_local_size", (int)sizeof(staticDouble), 8);
    checks += Test("t114_global_double_size", (int)sizeof(t114GlobalDouble), 8);
    checks += Test("t114_global_nested_size", (int)sizeof(t114GlobalNested), 12);
    checks += Test("t114_global_int_compare_size", (int)sizeof(t114GlobalIntCompare), 8);
    checks += Test("t114_global_double_compare_size", (int)sizeof(t114GlobalDoubleCompare), 8);
    checks += Test("t114_global_and_size", (int)sizeof(t114GlobalAnd), 8);
    checks += Test("t114_global_or_size", (int)sizeof(t114GlobalOr), 8);
    checks += Test("t114_global_enum_size", (int)sizeof(t114GlobalEnum), 8);
    checks += Test("t114_global_const_size", (int)sizeof(t114GlobalConst), 8);
    T114DimFields fields = default;
    checks += Test("t114_field_double_size", (int)sizeof(fields.doubleCompare), 8);
    checks += Test("t114_field_nested_size", (int)sizeof(fields.nested), 12);
    checks += Test("t114_field_int_compare_size", (int)sizeof(fields.intCompare), 8);
    checks += Test("t114_field_and_size", (int)sizeof(fields.logicalAnd), 8);
    return sum + checks;
}

int myFunction(int x, int y, int z)
{
    // printf("x=%d,y=%d,z=%d: ", x, y, z);
    int pair_xy = (x + y) * (x + y + 1) / 2 + y;
    return (pair_xy + z) * (pair_xy + z + 1) / 2 + z;
}

struct AsaPt { int x = 0; int y = 0; };
int asaPtSum(AsaPt p) { return p.x * 10 + p.y; }
int asaApply(function<int(int)> fn, int v) { return fn(v); }
int t126GenericDerefCall<T>(T f) { return (*f)(4); }
int t126NamedAdd1(int n) { return n + 1; }
int t126PointerTarget = 43;
int* t126GetPointer() { return &t126PointerTarget; }

bool testNamedParameters()
{
    bool result = true;
    int expected = myFunction(1, 2, 3);
    result &= Test("InOrder", myFunction(x:1, y : 2, z : 3), expected);
    result &= Test("OutOfOrderName", myFunction(y:2, z : 3, x : 1), expected);
    result &= Test("MixedInOrder", myFunction(x:1, y : 2, 3), expected);
    result &= Test("MixedOutOfOrder", myFunction(z:3, 1, 2), expected);

    // Accept-set for ruling 2026-09-27 (an assignment used directly as a call argument is
    // refused): these neighbours hold no assignment in argument position and stay legal.
    int asaK = 3;
    result &= Test("asa_eq_compare_arg", myFunction(asaK == 3 ? 1 : 0, asaK != 3 ? 0 : 2, 3), expected);
    result &= Test("asa_le_ge_arg", myFunction(asaK <= 3 ? 1 : 0, asaK >= 4 ? 0 : 2, 3), expected);
    result &= Test("asa_named_arg_expr", myFunction(z: asaK, y: asaK - 1, x: asaK - 2), expected);
    result &= Test("asa_postinc_arg", myFunction(asaK++ - 2, 2, 3), expected);
    result &= Test("asa_postinc_arg_after", asaK, 4);
    result &= Test("asa_lambda_body_assign", asaApply((int v) => { int w = 0; w += v; return w * 2; }, 4), 8);
    result &= Test("asa_brace_field_init", asaPtSum({x = 4, y = 5}), 45);
    result &= Test("asa_named_brace_field_init", asaPtSum(p: {x = 6, y = 7}), 67);
    int asaSum = 0;
    for (int k = asaPtSum({x = 0, y = 1}); k < 3; k += 1) asaSum = asaSum + k;
    result &= Test("asa_for_header_call", asaSum, 3);

    return result;
}

// =============================================================
// Enum tests
// =============================================================

// Named enum - enumerators should be registered as globals.
enum MyEnum : u8 { E_ONE = 1, E_TWO, E_THREE = 5 };

// An enum is a first-class type. Pre-fix each of these failed for a different reason:
// the widening ones read a narrow UNSIGNED member back sign-extended (u8 200 -> -56),
// the i64/u64 ones terminated the compiler with std::out_of_range out of std::stoi,
// the namespaced one could not be reached as `EnumNs.Facing.Back` from outside, and
// `enumUsedBeforeDeclaration` could not see an enum declared further down the file.
enum WideU8   : u8  { WU8_BIG = 200, WU8_MAX = 255 };
enum WideU16  : u16 { WU16_BIG = 40000 };
enum NarrowI8 : i8  { NI8_NEG = -1 };
enum WideI64  : i64 { WI64_LOW = -3000000000, WI64_HIGH = 4000000000 };
enum WideU64  : u64 { WU64_HIGH = 9223372036854775808 };
// Backing spelled through a `using` alias: the resolved type drives width and signedness.
using EnumByte = u8;
enum AliasBacked : EnumByte { AB_HI = 200 };
// Initializer the pre-pass cannot fold statically, so the codegen folder supplies it: the u64
// maximum must widen unsigned, not sign-extend to -1.
enum DynU64 : u64 { DU64_MAX = 18446744073709551615 - 0 };

namespace EnumNs { enum Facing : int { Back = -7, Fwd = 7 }; }

using FacingAlias = EnumNs.Facing;

struct EnumHolder { WideU8 band = default; int amount = default; };

