    int destructorsBefore = t515HolderDtors;
    {
        T515ClosureHolder h = default;
        h.s.id = 8;
        result &= Test("t515_holder_closure_embedded", h.s.f(), 8);
        result &= Test("t515_holder_ctor_count", t515HolderCtors - constructorsBefore, 1);
    }
    result &= Test("t515_holder_dtor_count", t515HolderDtors - destructorsBefore, 1);
