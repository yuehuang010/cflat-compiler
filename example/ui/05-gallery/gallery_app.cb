// gallery_app.cb - the host-neutral widget-gallery IComponent + headless self-test.
//
// P12 split this out of gallery.cb so BOTH the Win32/Cocoa launcher (gallery.cb, via the
// native_host.cb shim) and the WinUI 3 launcher (winui/winui_gallery.cb, via winui_host.cb)
// can compile the SAME GalleryApp + gallerySelfTest against their own INativeHost backend.
// This file imports ONLY ui.cb (the element model + sugar); every host free function it
// calls (startHeadlessWindow, the native* drivers, activeApp/activeCtx, hostWidth/hostHeight/
// hostDark, setMenuHandler, nativeSetContextMenu/nativeFireContextMenu, nativeTeardownForTest)
// is resolved from whichever host its LAUNCHER also imports - a cflat compilation shares one
// global scope across the whole import closure of the root, so a sibling import supplies them.
// It has no main(): a launcher provides that. Excluded from example.bat's plain build sweep.
import "ui_native.cb";
import "ui_test.cb";

bool galleryHasBlack(int value) { return value == 16777216; }
bool galleryHasThemeListError(int value)
{
    return value == 0x1BE2D2D || value == 0x1FF7878;
}
int galleryThemePanelColor(Theme t)
{
    return resolveColor(resolveThemeRole(t, THEME_ROLE_PANEL_BG, false), t, false);
}

const int GALLERY_ROWS = 100000;

// Context-menu command ids (routed through the app menu handler, like the menu bar).
int CMD_CTX_A = 201;
int CMD_CTX_B = 202;

// A generated top-down BGRA32 gradient (caller frees). Demonstrates the setImageData
// seam end to end without any asset file: the host uploads these bytes to an HBITMAP.
u64 makeGradientPixels(int w, int h)
{
    u64 p = (u64)malloc((i64)(w * h * 4));
    char* b = (char*)p;
    int y = 0;
    while (y < h)
    {
        int x = 0;
        while (x < w)
        {
            int i = (y * w + x) * 4;
            b[i + 0] = (char)(x * 255 / w);   // Blue
            b[i + 1] = (char)(y * 255 / h);   // Green
            b[i + 2] = (char)200;             // Red
            b[i + 3] = (char)255;             // Alpha
            x++;
        }
        y++;
    }
    return p;
}

class GalleryApp : IComponent
{
    int pick          = 1;    // RadioGroup selection (0 Small / 1 Medium / 2 Large)
    int fontIdx       = 0;    // ComboBox selection
    int listSel       = -1;   // ListView selected row (controlled)
    int listActivated = -1;   // last double-clicked / Entered row
    int listHeader     = -1;   // last clicked zero-based column header
    int factoryProbe   = -1;   // interface factory callback self-test value
    int factoryActivate = -1;  // interface ListView activate callback self-test value
    int factoryHeader  = -1;   // interface ListView header callback self-test value
    int interfaceTextChanged = 0;
    bool interfaceCheckboxChanged = false;
    int interfaceAreaChanged = 0;
    int rowTextCalls  = 0;    // rowText callback invocations (virtualization oracle)
    int rowIconCalls  = 0;    // rowIcon callback invocations (identity/reuse oracle)
    int gridViewCalls = 0;  // makeCell calls; the bounded-pool oracle
    int gridCount = 10000; // model size used by the GridView card
    int gridScroll = 0;     // self-test controlled scroll offset
    int gridSelected = -1;  // forces the leaf replacement used by the self-test
    u64 iconRevision  = 1u;    // explicit content revision for same-identity replacement
    int page          = 0;    // gallery page selection
    int tab           = 0;    // TabControl selection (P9)
    int treeSel       = 0 - 1; // selected tree node id (P9)
    int treeExpands   = 0;    // onExpand invocations (P9)
    int splitRatio    = 30;   // SplitView first-pane percentage (P9)
    int ctxFired      = 0;    // last context-menu command routed (P9)
    bool _ctxReg      = false; // one-time context-menu registration guard

    move IElement _galleryGrid()
    {
        GridView* gv = new GridView();
        gv.cellW = 12; gv.cellH = 3; gv.count = this.gridCount;
        gv.makeCell = (int i) => {
            this.gridViewCalls = this.gridViewCalls + 1;
            IBox cell = box(makeStyle(0, 12, 3));
            cell.add(text("item " + i.toString()));
            return move cell;
        };
        gv.setKey("gv");
        gv.width = 60; gv.height = 12;
        gv.scrollY = this.gridScroll;
        gv.selectedIndex = this.gridSelected;
        return gv;
    }

    // P10 form-widget state (all controlled).
    bool   dark       = false;   // theme toggle (light/dark)
    int    btnClicks  = 0;       // push-button press count
    string inputText  = default; // TextInput value
    string passwordText = default;
    bool   checked    = false;   // Checkbox value
    int    progress   = 60;      // ProgressBar value (0..100)
    int    sliderVal  = 40;      // Slider value (0..100)
    int    spinnerVal = 25;      // Spinner value (0..100, step 5)
    int    linkClicks = 0;       // Link press count
    int    toolbarCmd = 0;       // Last toolbar command
    int    dialogAnswer = -1;    // Last message-box answer
    string folderPath = default; // Last selected folder
    string chosenFontFamily = "none";
    int    chosenFontSize = 0;
    bool   infoErrorClosed = false;
    bool   popoverOpen = false;
    int    popoverCmd = -1;
    string richTextMirror = "none";
    int    areaEdits  = 0;       // TextArea dirty-notify count
    string editableComboText = default;
    bool   toggleOn = false;
    int    segmentSel = 0;
    int    dateYear = 2025;
    int    dateMonth = 1;
    int    dateDay = 15;
    Color  colorValue = colorLiteral(rgb(32, 96, 160));
    string colorHex = "#2060A0";
    bool   expanderOpen = true;
    int    timerOnce  = 0;
    int    timerTicks = 0;
    bool   timerCallbackRan = false;
    u64    timerSelfCancelHandle = 0u;

    // Image pixel buffer (owned by the component; freed in the destructor). Borrowed by
    // the Image element each render - the element never owns pixel memory.
    u64 imgPixels = 0u;
    int imgW = 0;
    int imgH = 0;

    ListRowIcon iconForRow(int r)
    {
        this.rowIconCalls = this.rowIconCalls + 1;
        if (r == 60000) return listIconRevision("cache0", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60001) return listIconRevision("cache1", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60002) return listIconRevision("cache2", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60003) return listIconRevision("cache3", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60004) return listIconRevision("cache4", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60005) return listIconRevision("cache5", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60006) return listIconRevision("cache6", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60007) return listIconRevision("cache7", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r == 60008) return listIconRevision("cache8", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
        if (r % 3 == 2) return noListIcon();
        return r % 2 == 0
            ? listIconRevision("ok", this.imgPixels, this.imgW, this.imgH, this.iconRevision)
            : listIconRevision("warn", this.imgPixels, this.imgW, this.imgH, this.iconRevision);
    }

    void mutateIconForTest()
    {
        if (this.imgPixels != 0u) ((char*)this.imgPixels)[0] = (char)(((char*)this.imgPixels)[0] + 1);
        this.iconRevision = 2u;
    }

    // P13 reconcile stress-soak state. When `stress` is on, render() emits a churn box
    // whose active pool slots (a fixed kind per slot) and order are driven by a seeded LCG,
    // so the keyed reconciler must create/destroy/reorder controls by key identity.
    bool stress      = false;
    int  stressSeed  = 0;   // LCG state (seeded by the self-test before the first step)
    int  stressMask  = 0;   // bit i set => pool slot i is present this render
    int  stressOrder = 0;   // rotation applied to the child order (deterministic reorder)

    ~GalleryApp()
    {
        if (this.imgPixels != 0u) { free((void*)this.imgPixels); this.imgPixels = 0u; }
    }

    string _sizeName()
    {
        if (this.pick == 0) return "Small";
        if (this.pick == 1) return "Medium";
        return "Large";
    }

    // Route a context-menu command (invoked via setMenuHandler / nativeFireContextMenu).
    void onCommand(int id, IUiContext ctx) { this.ctxFired = id; ctx.invalidate(); }

    // Build one churn-pool element for `slot` (a fixed kind per slot). Its LOCAL key is
    // "s<slot>", so under the stress box its path is "root/stressbox/s<slot>". Kinds span
    // leaf, container, and data-control families to exercise reconcile across the set.
    move IElement _stressChild(int slot)
    {
        string k = "s" + slot.toString();
        if (slot == 0) { IButton b = button("b", () => {}); b.setKey(k); return move b; }
        if (slot == 1) { IText t = text("t"); t.setKey(k); return move t; }
        if (slot == 2) { ICheckbox c = checkbox("c", false, (bool v) => {}); c.setKey(k); return move c; }
        if (slot == 3) { ITextInput ti = textInput("", (string s) => {}); ti.width = 10; ti.setKey(k); return move ti; }
        if (slot == 4) { IProgressBar p = progressBar(50, 10); p.setKey(k); return move p; }
        if (slot == 5) { ISlider s = slider(50, 10, (int v) => {}); s.setKey(k); return move s; }
        if (slot == 6)
        {
            IGroupBox g = groupBox("g", makeStyle(0, 10, 2)); g.setKey(k);
            IText gc = text("gc"); gc.setKey("gc"); g.add(gc);
            return move g;
        }
        IComboBox cb = comboBox(0, (int i) => {}); cb.addItem("x"); cb.addItem("y");
        cb.width = 10; cb.setKey(k);
        return move cb;
    }

    // Human-readable label for a Combo Box font index (matches the item order added
    // to the "combo" ComboBox below).
    string _fontName(int idx)
    {
        if (idx == 0) return "Consolas";
        if (idx == 1) return "Cascadia Code";
        if (idx == 2) return "Segoe UI";
        return "Courier New";
    }

    string _colorHex(Color c)
    {
        int raw = colorRaw(c);
        char* hex = "0123456789ABCDEF";
        char[8] out = default;
        out[0] = '#';
        out[1] = hex[(raw >> 20) & 0xF]; out[2] = hex[(raw >> 16) & 0xF];
        out[3] = hex[(raw >> 12) & 0xF]; out[4] = hex[(raw >> 8) & 0xF];
        out[5] = hex[(raw >> 4) & 0xF]; out[6] = hex[raw & 0xF];
        out[7] = (char)0;
        string borrowed = (string)&out[0];
        return borrowed.copy();
    }

    // Build one reference card: a themed container with a "header" sub-column (title
    // Text "title" + one-line description Text "desc", gap 0 - adjacent rows read as
    // one caption block), then the caller adds the live demo with a gap of 1 above it
    // (the card's own gap). Every card shares the same inner padding idiom;
    // backgroundColor comes from the active theme (not hardcoded) so cards read
    // correctly in light and dark mode. Title uses FONT_TITLE, desc uses FONT_CAPTION
    // (secondary label color on Cocoa).
    move IView _card(IUiContext ctx, string key, string titleTxt, string desc)
    {
        // Cap the card at ~70 cols (View honors style.width) so cards do not
        // full-bleed a wide window; height stays content-driven.
        IView card = column(makeStyle(1, 70, 0));
        card.style.gap = 1;
        card.style.backgroundColor = colorRole(THEME_ROLE_PANEL_BG);
        card.setKey(key);

        IView header = column(makeStyle(0, 0, 0));
        header.style.gap = 0;
        header.setKey("header");
        IText t = text(titleTxt);
        t.setKey("title");
        t.font = FONT_TITLE;
        header.add(t);
        IText d = text(desc);
        d.setKey("desc");
        d.font = FONT_CAPTION;
        header.add(d);
        card.add(header);

        return card;
    }

    move IView _pageBody()
    {
        IView body = column(makeStyle(1, 0, 0));
        body.style.gap = 1;
        body.setKey("page");
        return move body;
    }

    move IView _pageBasics(IUiContext ctx)
    {
        IView body = this._pageBody();

        IView cardBtn = this._card(ctx, "cardbtn", "Buttons",
                "Fires onPress; supports accent style and disabled state.");
        IView btnRow = row(makeStyle(0, 0, 0));
        btnRow.style.gap = 1;
        btnRow.setKey("btnrow");
        IButton btn = <Button key="btn" title="Click me"
                onPress={() => { this.btnClicks = this.btnClicks + 1; ctx.invalidate(); }}/>
        ;
        btnRow.add(btn);
        IButton themeBtn = <Button key="themebtn" title="Toggle theme"
                onPress={() => { this.dark = !this.dark; ctx.invalidate(); }}/>
        ;
        btnRow.add(themeBtn);
        cardBtn.add(btnRow);
        body.add(cardBtn);

        IView cardText = this._card(ctx, "cardtext", "Text / Labels",
                "Text elements provide titles, captions, and form labels.");
        IView labels = column(makeStyle(0, 0, 0));
        labels.setKey("labels");
        labels.style.gap = 0;
        labels.add(<Text key="headline" text="A headline label"/>);
        labels.add(<Text key="caption" text="A secondary caption label"/>);
        cardText.add(labels);
        body.add(cardText);

        IView cardCheck = this._card(ctx, "cardcheck", "Checkbox",
                "Toggles a boolean; controlled through onChange.");
        ICheckbox chk = <Checkbox key="check" label="Enable feature" checked={this.checked}
                onChange={(bool v) => { this.checked = v; ctx.invalidate(); }}/>
        ;
        cardCheck.add(chk);
        body.add(cardCheck);

        IView cardRadio = this._card(ctx, "cardradio", "Radio Group",
                "Mutually exclusive selection; controlled through onChange.");
        IRadioGroup rg = <RadioGroup key="rg" value={this.pick}
                onChange={(int i) => { this.pick = i; ctx.invalidate(); }}>
            <RadioButton key="r0" label="Small"  index={0} checked={this.pick == 0}/>
            <RadioButton key="r1" label="Medium" index={1} checked={this.pick == 1}/>
            <RadioButton key="r2" label="Large"  index={2} checked={this.pick == 2}/>
        </RadioGroup>;
        cardRadio.add(rg);
        body.add(cardRadio);

        IView cardLink = this._card(ctx, "cardlink", "Link",
                "Clickable text link with a disabled link below it.");
        ILink demoLink = <Link key="link" text="Increment counter"
                onClick={() => { this.linkClicks = this.linkClicks + 1; ctx.invalidate(); }}/>
        ;
        cardLink.add(demoLink);
        ILink disabledLink = <Link key="disabled" text="Disabled link" disabled={true}
                onClick={() => {}}/>
        ;
        cardLink.add(disabledLink);
        IText linkCount = text("Clicks: " + this.linkClicks.toString());
        linkCount.setKey("count");
        cardLink.add(linkCount);
        body.add(cardLink);
        return move body;
    }

    move IView _pageInput(IUiContext ctx)
    {
        IView body = this._pageBody();

        IView cardInput = this._card(ctx, "cardinput", "Text Input",
                "Single-line editable field; controlled through onChangeText.");
        IView inputRow = row(makeStyle(0, 0, 0));
        inputRow.setKey("inputrow");
        IView inputLabel = view(makeStyle(0, 12, 0));
        inputLabel.setKey("inputlabel");
        inputLabel.add(text("Input:"));
        inputRow.add(inputLabel);
        IView inputField = view(flexStyle(1));
        inputField.setKey("inputfield");
        ITextInput input = <TextInput key="input" value={this.inputText} width={24}
                placeholder="type here"
                onChangeText={(string s) => { this.inputText = s; ctx.invalidate(); }}/>
        ;
        inputField.add(input);
        inputRow.add(inputField);
        cardInput.add(inputRow);

        IView passwordRow = row(makeStyle(0, 0, 0));
        passwordRow.setKey("passwordrow");
        IView passwordLabel = view(makeStyle(0, 12, 0));
        passwordLabel.setKey("passwordlabel");
        passwordLabel.add(text("Password:"));
        passwordRow.add(passwordLabel);
        IView passwordField = view(flexStyle(1));
        passwordField.setKey("passwordfield");
        ITextInput password = <TextInput key="password" value={this.passwordText} width={24}
                placeholder="enter secret" password={true}
                onChangeText={(string s) => { this.passwordText = s; ctx.invalidate(); }}/>
        ;
        passwordField.add(password);
        passwordRow.add(passwordField);
        cardInput.add(passwordRow);
        IText passwordMirror = text("Password mirror: " + this.passwordText);
        passwordMirror.setKey("passwordmirror");
        cardInput.add(passwordMirror);
        body.add(cardInput);

        IView cardArea = this._card(ctx, "cardarea", "Text Area",
                "Multiline editable text block; reports a dirty-notify count on change.");
        ITextArea area = <TextArea key="area" value="" width={40} height={4}
                onChange={() => { this.areaEdits = this.areaEdits + 1; }}/>
        ;
        cardArea.add(area);
        body.add(cardArea);

        IView cardRich = this._card(ctx, "cardrich", "Rich Text",
                "Attributed runs plus an editable rich-text field with a change mirror.");
        IRichText richDisplay = richText(false, (string s) => {});
        richDisplay.setKey("display"); richDisplay.style.width = 42; richDisplay.style.height = 3;
        richDisplay.addRun("Bold ", RICH_BOLD, rgb(32, 96, 160));
        richDisplay.addRun("italic ", RICH_ITALIC, rgb(160, 64, 32));
        richDisplay.addRun("underlined", RICH_UNDERLINE, rgb(32, 140, 72));
        cardRich.add(richDisplay);
        IRichText richEditor = richText(true, (string s) => {
            this.richTextMirror = s; ctx.invalidate();
        });
        richEditor.setKey("editor"); richEditor.style.width = 42; richEditor.style.height = 3;
        richEditor.addRun("Edit this text", 0, rgb(40, 40, 40));
        cardRich.add(richEditor);
        IText richMirror = text("Mirror: " + this.richTextMirror);
        richMirror.setKey("mirror"); cardRich.add(richMirror);
        body.add(cardRich);

        IView cardCombo = this._card(ctx, "cardcombo", "Combo Box",
                "Dropdown single-selection list; controlled through onChange.");
        IView comboRow = row(makeStyle(0, 0, 0));
        comboRow.setKey("comborow");
        IView comboLabel = view(makeStyle(0, 12, 0));
        comboLabel.setKey("combolabel");
        comboLabel.add(text("Font:"));
        comboRow.add(comboLabel);
        IView comboField = view(flexStyle(1));
        comboField.setKey("combofield");
        IComboBox cb = <ComboBox key="combo" selectedIndex={this.fontIdx} width={20}
                onChange={(int i) => { this.fontIdx = i; ctx.invalidate(); }}/>
        ;
        cb.addItem("Consolas"); cb.addItem("Cascadia Code");
        cb.addItem("Segoe UI"); cb.addItem("Courier New");
        comboField.add(cb);
        comboRow.add(comboField);
        cardCombo.add(comboRow);
        body.add(cardCombo);

        IView cardEditable = this._card(ctx, "cardeditable", "Editable Combo Box",
                "Text-entry combo; onEdit mirrors free-form text while items remain available.");
        IComboBox editable = <ComboBox key="editable" selectedIndex={0} width={24}
                editable={true} text={this.editableComboText}
                onEdit={(string s) => { this.editableComboText = s; ctx.invalidate(); }}/>
        ;
        editable.addItem("Custom"); editable.addItem("Preset");
        cardEditable.add(editable);
        IText editableMirror = text("Edited: " + this.editableComboText);
        editableMirror.setKey("editmirror");
        cardEditable.add(editableMirror);
        body.add(cardEditable);

        IView cardToggle = this._card(ctx, "cardtoggle", "Toggle Switch",
                "Boolean switch with a state label driven by onToggle.");
        IToggleSwitch toggle = toggleSwitch("Enable sync", this.toggleOn, (bool v) => {
            this.toggleOn = v; ctx.invalidate();
        });
        toggle.setKey("toggle");
        cardToggle.add(toggle);
        IText toggleState = text("State: " + (this.toggleOn ? "on" : "off"));
        toggleState.setKey("state");
        cardToggle.add(toggleState);
        body.add(cardToggle);

        IView cardSegmented = this._card(ctx, "cardsegmented", "Segmented Control",
                "Single selection across compact labeled segments.");
        ISegmented segments = segmented((int i) => {
            this.segmentSel = i; ctx.invalidate();
        });
        segments.setKey("segments");
        segments.selected = this.segmentSel;
        segments.addSegment("One"); segments.addSegment("Two"); segments.addSegment("Three");
        cardSegmented.add(segments);
        IText segmentState = text("Selected: " + this.segmentSel.toString());
        segmentState.setKey("selected");
        cardSegmented.add(segmentState);
        body.add(cardSegmented);

        IView cardDate = this._card(ctx, "carddate", "Date Picker",
                "Calendar date control with a controlled date label.");
        IDatePicker date = datePicker(this.dateYear, this.dateMonth, this.dateDay,
            (int y, int m, int d) => {
                this.dateYear = y; this.dateMonth = m; this.dateDay = d; ctx.invalidate();
            });
        date.setKey("date");
        cardDate.add(date);
        IText dateState = text("Date: " + this.dateYear.toString() + "-"
            + this.dateMonth.toString() + "-" + this.dateDay.toString());
        dateState.setKey("value");
        cardDate.add(dateState);
        body.add(cardDate);

        IView cardColor = this._card(ctx, "cardcolor", "Color Well",
                "Native color chooser with a controlled hexadecimal readout.");
        IColorWell color = colorWell(this.colorValue, (Color c) => {
            this.colorValue = c; this.colorHex = this._colorHex(c); ctx.invalidate();
        });
        color.setKey("color");
        cardColor.add(color);
        IText colorState = text("Hex: " + this.colorHex);
        colorState.setKey("hex");
        cardColor.add(colorState);
        body.add(cardColor);

        IView cardSlider = this._card(ctx, "cardslider", "Slider",
                "Draggable numeric control; controlled through onChange.");
        ISlider sld = <Slider key="slider" value={this.sliderVal} width={24}
                onChange={(int v) => { this.sliderVal = v; ctx.invalidate(); }}/>
        ;
        cardSlider.add(sld);
        body.add(cardSlider);

        IView cardSpinner = this._card(ctx, "cardspinner", "Spinner",
                "Bounded numeric stepper; demonstrates min, max, and step.");
        ISpinner spin = spinner(this.spinnerVal, 0, 100, (int v) => {
            this.spinnerVal = v; ctx.invalidate();
        });
        spin.setKey("spinner");
        spin.step = 5;
        cardSpinner.add(spin);
        IText spinnerMirror = text("Value: " + this.spinnerVal.toString());
        spinnerMirror.setKey("value");
        cardSpinner.add(spinnerMirror);
        body.add(cardSpinner);

        IView cardProg = this._card(ctx, "cardprog", "Progress Bar",
                "Presentational value indicator (0..100).");
        IProgressBar prog = <ProgressBar key="prog" value={this.progress} width={24}/>;
        prog.tooltip = "download progress";
        IProgressBar busyProg = <ProgressBar key="indeterminate" value={0} width={24}
                indeterminate={true}/>;
        IView progressRow = row(makeStyle(0, 0, 0));
        progressRow.setKey("progressrow");
        progressRow.style.gap = 1;
        progressRow.add(prog);
        progressRow.add(busyProg);
        cardProg.add(progressRow);
        body.add(cardProg);
        return move body;
    }

    move IView _pageData(IUiContext ctx)
    {
        IView body = this._pageBody();

        IView cardList = this._card(ctx, "cardlist", "List View",
                "Virtualized multi-column list; handles 100k rows with few rowText calls.");
        IListView lv = <ListView key="list" rowCount={GALLERY_ROWS}
                selectedIndex={this.listSel} width={40} height={6}
                onSelect={(int r) => { this.listSel = r; ctx.invalidate(); }}
                onActivate={(int r) => { this.listActivated = r; ctx.invalidate(); }}/>
        ;
        lv.addColumn("Index", 12); lv.addColumn("Square", 18);
        lv.rowText = (int r, int c) => {
            this.rowTextCalls = this.rowTextCalls + 1;
            if (c == 0) return "row " + r.toString();
            i64 sq = (i64)r * (i64)r;
            return sq.toString();
        };
        lv.rowIcon = (int r) => { return this.iconForRow(r); };
        lv.cellStyle = (int r, int c) => {
            if (r == 50000 && c == 1) return listCellRole(LIST_ROLE_ERROR);
            if (r == 50000 && c == 0) return listCellLiteral(0);
            return listCellInherit();
        };
        lv.onHeaderClick = (int c) => { this.listHeader = c; ctx.invalidate(); };
        cardList.add(lv);
        body.add(cardList);

        IView cardGridView = this._card(ctx, "cardgridview", "GridView",
                "Virtualized item grid - 10000 cells, bounded pool.");
        cardGridView.add(this._galleryGrid());
        body.add(cardGridView);

        IView cardTree = this._card(ctx, "cardtree", "Tree View",
                "Lazy-expanding hierarchical list; children are fetched on demand.");
        ITreeView tree = <TreeView key="tree" width={24} height={6} selectedNode={this.treeSel}
                onSelect={(int nid) => { this.treeSel = nid; ctx.invalidate(); }}
                onExpand={(int nid) => { this.treeExpands = this.treeExpands + 1; }}/>
        ;
        tree.childCount = (int nid) => {
            if (nid == TREE_ROOT) return 2;
            if (nid == 1) return 2;
            return 0;
        };
        tree.childId = (int nid, int i) => {
            if (nid == TREE_ROOT) return i == 0 ? 1 : 2;
            if (nid == 1) return i == 0 ? 10 : 11;
            return 0;
        };
        tree.label = (int nid) => {
            if (nid == 1) return "src";
            if (nid == 2) return "notes.txt";
            if (nid == 10) return "main.cb";
            if (nid == 11) return "ui.cb";
            return "?";
        };
        cardTree.add(tree);
        body.add(cardTree);
        return move body;
    }

    move IView _pageLayout(IUiContext ctx)
    {
        IView body = this._pageBody();

        IView cardGrid = this._card(ctx, "cardgrid", "Grid",
                "track layout: auto label column + star field column");
        IGrid formGrid = grid(2);
        formGrid.setKey("grid"); formGrid.style.gap = 1; formGrid.colStar(1, 1);
        IText nameLabel = text("Name"); nameLabel.setKey("namelabel"); formGrid.add(nameLabel);
        ITextInput nameInput = textInput("", (string s) => {}); nameInput.setKey("name"); formGrid.add(nameInput);
        IText emailLabel = text("Email address"); emailLabel.setKey("emaillabel"); formGrid.add(emailLabel);
        ITextInput emailInput = textInput("", (string s) => {}); emailInput.setKey("email"); formGrid.add(emailInput);
        IText noteLabel = text("Note"); noteLabel.setKey("notelabel"); formGrid.add(noteLabel);
        ITextInput noteInput = textInput("", (string s) => {}); noteInput.setKey("note"); formGrid.add(noteInput);
        cardGrid.add(formGrid); body.add(cardGrid);

        IView cardGrp = this._card(ctx, "cardgrp", "Group Box",
                "Frames related controls under a titled border.");
        IGroupBox grp = <GroupBox key="grp" title="Options"/>;
        grp.style.width = 30; grp.style.height = 4;
        grp.add(<Text key="gt0" text="grouped item A"/>);
        grp.add(<Text key="gt1" text="grouped item B"/>);
        cardGrp.add(grp); body.add(cardGrp);

        IView cardSplit = this._card(ctx, "cardsplit", "Split View",
                "Two resizable panes divided by a draggable splitter.");
        ISplitView split = <SplitView key="split" ratio={this.splitRatio} vertical={true}
                onRatioChange={(int r) => { this.splitRatio = r; ctx.invalidate(); }}>
            <Box key="lp" style={makeStyle(0, 0, 3)}><Text key="lpt" text="left"/></Box>
            <Box key="rp" style={makeStyle(0, 0, 3)}><Text key="rpt" text="right"/></Box>
        </SplitView>;
        split.style.width = 40; split.style.height = 3;
        cardSplit.add(split); body.add(cardSplit);

        IView cardFlex = this._card(ctx, "cardflex", "Flex Layout",
                "Flex-weight idiom: an aligned form-row field and a 2:1 weighted split.");
        IView flexRow = row(makeStyle(0, 0, 0)); flexRow.setKey("flexrow");
        IView flexLabel = view(makeStyle(0, 12, 0)); flexLabel.setKey("flexlabel");
        flexLabel.add(text("Name:")); flexRow.add(flexLabel);
        IView flexField = view(flexStyle(1)); flexField.setKey("flexfield");
        ITextInput flexInput = textInput("", (string s) => {}); flexInput.setKey("flexinput");
        flexField.add(flexInput); flexRow.add(flexField); cardFlex.add(flexRow);
        IBox flexDemo = box(makeStyle(0, 61, 3)); flexDemo.setKey("flexdemo");
        IView flexPair = row(makeStyle(0, 0, 0)); flexPair.style.gap = 1; flexPair.setKey("flexpair");
        IView flexTwo = view(flexStyle(2)); flexTwo.setKey("flextwo"); flexTwo.add(box(makeStyle(0, 0, 1)));
        IView flexOne = view(flexStyle(1)); flexOne.setKey("flexone"); flexOne.add(box(makeStyle(0, 0, 1)));
        flexPair.add(flexTwo); flexPair.add(flexOne); flexDemo.add(flexPair); cardFlex.add(flexDemo);

        IView cardExpander = this._card(ctx, "cardexpander", "Expander",
                "Collapse and expand controls to reflow the cards below.");
        IExpander advanced = expander("Advanced options", this.expanderOpen, (bool v) => {
            this.expanderOpen = v; ctx.invalidate();
        });
        advanced.setKey("expander");
        ITextInput expanderInput = textInput("", (string s) => {});
        expanderInput.setKey("childinput");
        advanced.add(expanderInput);
        ICheckbox expanderCheck = checkbox("Use compact spacing", false, (bool v) => {});
        expanderCheck.setKey("childcheck");
        advanced.add(expanderCheck);
        cardExpander.add(advanced);
        body.add(cardExpander);
        body.add(cardFlex);
        return move body;
    }

    move IView _pageMedia(IUiContext ctx)
    {
        IView body = this._pageBody();
        IView cardImg = this._card(ctx, "cardimg", "Image",
                "Displays a bitmap uploaded through the setImageData seam; no asset file needed.");
        IImage img = <Image key="img" width={12} height={4} altText="gradient"/>;
        img.pixels = this.imgPixels; img.pxW = this.imgW; img.pxH = this.imgH;
        cardImg.add(img); body.add(cardImg);
        IView cardCanvas = this._card(ctx, "cardcanvas", "ICanvas",
                "Escape hatch: draw directly with the ICanvas API into a native child surface.");
        ICanvasView canvas = <CanvasView key="canvas" width={24} height={6}/>;
        canvas.onPaint = (ICanvas c) => {
            int barCount = 5; int i = 0;
            while (i < barCount)
            {
                Rect bar = default;
                bar.x = 1 + i * 4; bar.w = 3; bar.h = 1 + i; bar.y = 5 - bar.h;
                c.drawRect(bar, true, rgb(60 + i * 30, 120, 220)); i++;
            }
            c.drawText(1, 5, "canvas", rgb(40, 40, 40));
        };
        cardCanvas.add(canvas); body.add(cardCanvas);
        if const (__MACOS__)
        {
            IView cardWeb = this._card(ctx, "cardweb", "WebView",
                    "Cocoa web content surface loaded from inline HTML.");
            IWebView web = webView("about:blank");
            web.setKey("web"); web.style.width = 42; web.style.height = 8;
            web.html = "<h1>CFlat</h1><p>WebView</p>";
            cardWeb.add(web); body.add(cardWeb);
        }
        return move body;
    }

    move IView _pageChrome(IUiContext ctx)
    {
        IView body = this._pageBody();
        IView cardTabs = this._card(ctx, "cardtabs", "Tab Control",
                "Switches between keyed panes; only the active pane maps to native.");
        ITabControl tabs = <TabControl key="tabs" selectedTab={this.tab} width={40} height={5}
                onSelectTab={(int i) => { this.tab = i; ctx.invalidate(); }}>
            <TabPane key="p0" title="Alpha"><Text key="t0" text="Alpha pane content"/></TabPane>
            <TabPane key="p1" title="Beta"><Text key="t1" text="Beta pane content"/></TabPane>
        </TabControl>;
        cardTabs.add(tabs); body.add(cardTabs);
        IView cardContext = this._card(ctx, "cardcontext", "Context Menu",
                "Right-click panel routes commands through the app menu handler.");
        IBox ctxbox = box(makeStyle(0, 40, 2)); ctxbox.setKey("ctxbox");
        ctxbox.add(text("right-click me (context menu)")); cardContext.add(ctxbox); body.add(cardContext);
        IView cardStatus = this._card(ctx, "cardstatus", "Status Bar",
                "Status text reflects the current gallery selections and commands.");
        string rowTxt = this.listSel < 0 ? "none" : this.listSel.toString();
        string openTxt = this.listActivated < 0 ? "none" : this.listActivated.toString();
        IText status = text("Size: " + this._sizeName() + "  Font: " + this._fontName(this.fontIdx)
            + "  Row: " + rowTxt + "  Opened: " + openTxt);
        status.setKey("status"); cardStatus.add(status);
        string tabTxt = this.tab == 0 ? "Alpha" : "Beta";
        string nodeTxt = this.treeSel < 0 ? "none" : this.treeSel.toString();
        string ctxTxt = this.ctxFired == 0 ? "none" : this.ctxFired.toString();
        IText status2 = text("Tab: " + tabTxt + "  Node: " + nodeTxt
            + "  Split: " + this.splitRatio.toString() + "%  Ctx: " + ctxTxt);
        status2.setKey("status2"); cardStatus.add(status2); body.add(cardStatus);

        IView cardToolbar = this._card(ctx, "cardtoolbar", "ToolBar",
                "Commands, separator, tips, and a disabled item.");
        IToolBar tb = toolbar((int cmd) => { this.toolbarCmd = cmd; ctx.invalidate(); });
        tb.setKey("toolbar");
        tb.addButton("New", 101);
        tb.addButton("Open", 102);
        tb.addSeparator();
        tb.addButton("Disabled", 103);
        tb.tips.set(0, "Create a document");
        tb.tips.set(1, "Open a document");
        tb.enabled.set(3, false);
        cardToolbar.add(tb);
        string command = this.toolbarCmd == 0 ? "none" : this.toolbarCmd.toString();
        IText toolbarStatus = text("Command: " + command);
        toolbarStatus.setKey("status");
        cardToolbar.add(toolbarStatus);
        body.add(cardToolbar);

        IView cardInfo = this._card(ctx, "cardinfobar", "InfoBar",
                "Severity-tinted messages; the error bar can be dismissed.");
        IInfoBar info = infoBar(INFOBAR_INFO, "Info", "Informational message", nullptr);
        info.setKey("info"); cardInfo.add(info);
        IInfoBar success = infoBar(INFOBAR_SUCCESS, "Success", "Operation completed", nullptr);
        success.setKey("success"); cardInfo.add(success);
        IInfoBar warning = infoBar(INFOBAR_WARNING, "Warning", "Check this setting", nullptr);
        warning.setKey("warning"); cardInfo.add(warning);
        if (!this.infoErrorClosed)
        {
            IInfoBar error = infoBar(INFOBAR_ERROR, "Error", "Something needs attention", () => {
                this.infoErrorClosed = true; ctx.invalidate();
            });
            error.setKey("error"); cardInfo.add(error);
        }
        IText errorState = text("Error bar: " + (this.infoErrorClosed ? "dismissed" : "shown"));
        errorState.setKey("state"); cardInfo.add(errorState); body.add(cardInfo);

        IView cardPopover = this._card(ctx, "cardpopover", "Popover",
                "A floating command surface anchored to its opening button.");
        IButton popOpen = button("Open popover", () => {
            this.popoverOpen = true; ctx.invalidate();
        });
        popOpen.setKey("open"); cardPopover.add(popOpen);
        string popAnchor = "root/content/pages/chrome/scroll/page/cardpopover/open";
        IPopover pop = popover(popAnchor, this.popoverOpen, () => {
            this.popoverOpen = false; ctx.invalidate();
        });
        pop.setKey("popover");
        pop.title = "Popover commands"; pop.body = "Choose an action";
        pop.onCommand = (int cmd) => {
            this.popoverCmd = cmd; this.popoverOpen = false; ctx.invalidate();
        };
        pop.addButton("Action A", 1); pop.addButton("Action B", 2);
        cardPopover.add(pop);
        string popReadout = this.popoverCmd < 0 ? "Command: none" : "Command: " + this.popoverCmd.toString();
        IText popState = text(popReadout); popState.setKey("readout"); cardPopover.add(popState);
        body.add(cardPopover);

        IView cardDialogs = this._card(ctx, "carddialogs", "Dialogs",
                "Message boxes and native folder selection with headless scripting.");
        IView dialogButtons = row(makeStyle(0, 0, 0));
        dialogButtons.setKey("buttons");
        dialogButtons.style.gap = 1;
        IButton messageButton = button("Message box...", () => {
            this.dialogAnswer = nativeMessageBox("Gallery", "Continue?", MSGBOX_YESNO);
            ctx.invalidate();
        });
        messageButton.setKey("message");
        dialogButtons.add(messageButton);
        IButton folderButton = button("Pick folder...", () => {
            this.folderPath = nativeSelectFolder(); ctx.invalidate();
        });
        folderButton.setKey("folder");
        dialogButtons.add(folderButton);
        IButton fontButton = button("Choose font...", () => {
            FontChoice choice = default;
            if (nativeChooseFont(&choice))
            {
                this.chosenFontFamily = choice.family; this.chosenFontSize = choice.size;
            }
            ctx.invalidate();
        });
        fontButton.setKey("font"); dialogButtons.add(fontButton);
        cardDialogs.add(dialogButtons);
        string answer = this.dialogAnswer < 0 ? "none" : (this.dialogAnswer == 1 ? "yes" : "no");
        IText answerText = text("Answer: " + answer);
        answerText.setKey("answer");
        cardDialogs.add(answerText);
        IText folderText = text("Folder: " + this.folderPath);
        folderText.setKey("path");
        cardDialogs.add(folderText);
        string fontText = this.chosenFontFamily == "none" ? "Font: none"
            : "Font: " + this.chosenFontFamily + " " + this.chosenFontSize.toString();
        IText fontReadout = text(fontText); fontReadout.setKey("fontreadout"); cardDialogs.add(fontReadout);
        body.add(cardDialogs);
        return move body;
    }

    move IView _pageStress(IUiContext ctx)
    {
        IView body = this._pageBody();
        IView cardStress = this._card(ctx, "cardstress", "Stress (self-test)",
                "Seeded churn pool exercising keyed create/destroy/reorder (P13 hardening).");
        if (this.stress)
        {
            IBox sbox = box(makeStyle(0, 40, 12)); sbox.setKey("stressbox");
            int n = 8; int step = 0;
            while (step < n)
            {
                int slot = (step + this.stressOrder) % n;
                if (((this.stressMask >> slot) & 1) != 0) sbox.add(this._stressChild(slot));
                step++;
            }
            cardStress.add(sbox);
        }
        IButton stressBtn = button("stress-step", () => {
            this.stress = true;
            u32 s = (u32)this.stressSeed * 1103515245u + 12345u;
            this.stressSeed = (int)s; this.stressMask = (int)((s >> 8) & 0xFFu);
            this.stressOrder = (int)((s >> 20) & 0x7u); ctx.invalidate();
        });
        stressBtn.setKey("stressbtn"); cardStress.add(stressBtn); body.add(cardStress);
        return move body;
    }

    IElement _newRender(IUiContext ctx)
    {
        ctx.theme = this.dark ? darkTheme() : lightTheme();
        if (this.imgPixels == 0u) { this.imgW = 96; this.imgH = 48; this.imgPixels = makeGradientPixels(96, 48); }
        // Root is a plain column: each page scrolls itself, and a root ScrollView
        // would put the docked StatusBar into document coords (clipping its text).
        IView root = column(makeStyle(0, hostWidth(), hostHeight())); root.setKey("root");
        IView content = column(makeStyle(1, 0, 0)); content.style.gap = 0; content.setKey("content"); root.add(content);
        IText title = text("Widget Gallery"); title.setKey("title"); title.font = FONT_TITLE; content.add(title);
        ITabControl pages = <TabControl key="pages" selectedTab={this.page} width={hostWidth()}
                height={hostHeight() - 3}
                onSelectTab={(int i) => { this.page = i; ctx.invalidate(); }}/>
        ;
        ITabPane basics = tabPane("Basics"); basics.setKey("basics");
        IScrollView basicsScroll = scrollView(makeStyle(0, 0, 0)); basicsScroll.setKey("scroll");
        basicsScroll.add(this._pageBasics(ctx)); basics.add(basicsScroll); pages.add(basics);
        ITabPane input = tabPane("Input"); input.setKey("input");
        IScrollView inputScroll = scrollView(makeStyle(0, 0, 0)); inputScroll.setKey("scroll");
        inputScroll.add(this._pageInput(ctx)); input.add(inputScroll); pages.add(input);
        ITabPane data = tabPane("Data"); data.setKey("data");
        IScrollView dataScroll = scrollView(makeStyle(0, 0, 0)); dataScroll.setKey("scroll");
        dataScroll.add(this._pageData(ctx)); data.add(dataScroll); pages.add(data);
        ITabPane layout = tabPane("Layout"); layout.setKey("layout");
        IScrollView layoutScroll = scrollView(makeStyle(0, 0, 0)); layoutScroll.setKey("scroll");
        layoutScroll.add(this._pageLayout(ctx)); layout.add(layoutScroll); pages.add(layout);
        ITabPane media = tabPane("Media"); media.setKey("media");
        IScrollView mediaScroll = scrollView(makeStyle(0, 0, 0)); mediaScroll.setKey("scroll");
        mediaScroll.add(this._pageMedia(ctx)); media.add(mediaScroll); pages.add(media);
        ITabPane chrome = tabPane("Chrome"); chrome.setKey("chrome");
        IScrollView chromeScroll = scrollView(makeStyle(0, 0, 0)); chromeScroll.setKey("scroll");
        chromeScroll.add(this._pageChrome(ctx)); chrome.add(chromeScroll); pages.add(chrome);
        ITabPane stress = tabPane("Stress"); stress.setKey("stress");
        IScrollView stressScroll = scrollView(makeStyle(0, 0, 0)); stressScroll.setKey("scroll");
        stressScroll.add(this._pageStress(ctx)); stress.add(stressScroll); pages.add(stress);
        content.add(pages);
        IStatusBar sbar = <StatusBar key="sbar"/>;
        sbar.parts.add("Ready"); sbar.parts.add("clicks=" + this.btnClicks.toString()); content.add(sbar);
        if (!this._ctxReg && this.page == 5)
        {
            nativeSetContextMenu("root/content/pages/chrome/scroll/page/cardcontext/ctxbox", (u64)buildCtxMenu());
            this._ctxReg = true;
        }
        return root;
    }

    IElement render(IUiContext ctx) { return this._newRender(ctx); }

};

// A context menu built with the <ContextMenu/> sugar (P9); returned as an owned pointer
// the caller inline-casts to u64 for nativeSetContextMenu (the host then owns + frees it).
ContextMenu* buildCtxMenu()
{
    ContextMenu* m = <ContextMenu/>;
    m.addItem("Action A", CMD_CTX_A);
    m.addItem("Action B", CMD_CTX_B);
    return m;
}

// Wire the app menu handler so a context-menu command reaches the model. A NAMED borrow
// is downcast (not activeApp() directly) - `as` on a call result yields an owning ptr.
void wireGallery()
{
    setMenuHandler((int id) =>
    {
        GalleryApp* g = activeApp() as GalleryApp;
        if (g != nullptr) g.onCommand(id, activeCtx());
    });
}

// -- Headless state-assert self-test ------------------------------------------
// Invisible window, real controls, driven through host-neutral native* test drivers
// exactly as the OS would on user input; control + model state is the oracle (no
// pixels). P11 removed every toolkit-typed SendMessage so this runs against any host.

// True if the control at keyPath has a live native handle.
bool _exists(string keyPath) { return activeCtx().nativeHandle(keyPath) != 0u; }

// A control's text equals `want` (owned read via the host-neutral driver).
bool _statusIs(string keyPath, const char* want)
{
    string s = nativeControlText(keyPath);
    return strcmp(s.data(), (char*)want) == 0;
}

// A control's text contains `sub`.
bool _statusHas(string keyPath, const char* sub)
{
    string s = nativeControlText(keyPath);
    return strstr(s.data(), (char*)sub) != nullptr;
}

// The gallery self-test, migrated onto the ui_test.cb runner (UiTestSuite/UiTest). Same
// coverage as the pre-T2 27-assert monolith: the full element set, then the theme-flip storm
// and the reconcile stress-soak via the library kits (themeStorm/reconcileStress). Called
// with no argv so both launchers keep invoking it as `gallerySelfTest()`: the Win32/Cocoa
// launcher (gallery.cb) and the WinUI launcher (winui_gallery.cb, inside setSelfTestBody).
//
// One case / one launch (not case-per-concern): the WinUI host does not support a second
// startHeadlessWindow after nativeTeardownForTest within a single Application.Start session,
// so a multi-case suite (each case a fresh launch) crashes on WinUI. gallery_app.cb is shared
// by both hosts, so the storm + soak stay in this launch. run(0, nullptr) runs the case.
int gallerySelfTest()
{
    wireGallery();
    UiTestSuite s = uiTestSuite("gallery");

    // The full element set: P8 forms, P9 nav (tabs/tree/split/context), P10 visuals, then the
    // P13 hardening kits. One launch drives it all through the host-neutral drivers; control +
    // model state is the oracle (no pixels).
    s.test("full element set + hardening", (IUiTest t) =>
    {
        t.launch(new GalleryApp(), 60, 60);
        GalleryApp* g = activeApp() as GalleryApp;
        string basics = "root/content/pages/basics/scroll/page/";
        string input = "root/content/pages/input/scroll/page/";
        string data = "root/content/pages/data/scroll/page/";
        string layout = "root/content/pages/layout/scroll/page/";
        string media = "root/content/pages/media/scroll/page/";
        string chrome = "root/content/pages/chrome/scroll/page/";
        string stress = "root/content/pages/stress/scroll/page/";
        string appStatus = "root/content/sbar";
        string listKey = data + "cardlist/list";
        string gridViewKey = data + "cardgridview/gv";
        string passwordKey = input + "cardinput/passwordrow/passwordfield/password";
        string spinnerKey = input + "cardspinner/spinner";
        string editableKey = input + "cardeditable/editable";
        string toggleKey = input + "cardtoggle/toggle";
        string segmentedKey = input + "cardsegmented/segments";
        string dateKey = input + "carddate/date";
        string colorKey = input + "cardcolor/color";
        string expanderKey = layout + "cardexpander/expander";
        string expanderChildKey = expanderKey + "/childinput";
        string linkKey = basics + "cardlink/link";
        string disabledLinkKey = basics + "cardlink/disabled";
        string toolbarKey = chrome + "cardtoolbar/toolbar";
        string messageKey = chrome + "carddialogs/buttons/message";
        string folderKey = chrome + "carddialogs/buttons/folder";
        string fontKey = chrome + "carddialogs/buttons/font";
        string answerKey = chrome + "carddialogs/answer";
        string folderPathKey = chrome + "carddialogs/path";
        string fontReadoutKey = chrome + "carddialogs/fontreadout";
        string infoErrorKey = chrome + "cardinfobar/error";
        string infoStateKey = chrome + "cardinfobar/state";
        string popOpenKey = chrome + "cardpopover/open";
        string popKey = chrome + "cardpopover/popover";
        string popReadoutKey = chrome + "cardpopover/readout";
        string richDisplayKey = input + "cardrich/display";
        string richEditorKey = input + "cardrich/editor";
        string richMirrorKey = input + "cardrich/mirror";
        string webKey = media + "cardweb/web";
        string tabsKey = chrome + "cardtabs/tabs";
        string statusKey = chrome + "cardstatus/";

        // AUTO chooses the semantic table from the supplied system preference;
        // forced appearance wins, and a direct literal override wins over roles.
        Theme autoTheme = systemTheme();
        Color panelRole = colorRole(THEME_ROLE_PANEL_BG);
        int autoLight = resolveColor(resolveThemeRole(autoTheme, panelRole.value, false), autoTheme, false);
        int autoDark = resolveColor(resolveThemeRole(autoTheme, panelRole.value, true), autoTheme, true);
        autoTheme.appearance = THEME_LIGHT;
        int forcedLight = resolveColor(resolveThemeRole(autoTheme, panelRole.value, true), autoTheme, true);
        autoTheme.appearance = THEME_DARK;
        int forcedDark = resolveColor(resolveThemeRole(autoTheme, panelRole.value, false), autoTheme, false);
        autoTheme.panelBg = colorLiteral(0);
        int directBlack = resolveColor(resolveThemeRole(autoTheme, panelRole.value, true), autoTheme, true);
        t.expectTrue("theme AUTO semantic matrix",
            autoLight != autoDark && autoLight == forcedLight && autoDark == forcedDark
            && directBlack == COLOR_SET_BIT);

        // Factory return is interface-typed: every app-settable ListView property
        // must remain writable and the fire wrapper must reach the assigned closure.
        IListView configured = listView(2, (int r, int c) => { return "x"; });
        configured.width = 18; configured.height = 4;
        configured.sortColumn = 1; configured.sortAscending = true;
        configured.onSelect = (int r) => { if (g != nullptr) g.factoryProbe = r; };
        configured.onActivate = (int r) => { if (g != nullptr) g.factoryActivate = r; };
        configured.onHeaderClick = (int c) => { if (g != nullptr) g.factoryHeader = c; };
        configured.cellStyle = (int r, int c) => listCellRole(LIST_ROLE_WARNING);
        LayoutConstraints lc = default; lc.availW = 100; lc.availH = 100;
        Size configuredSize = configured.layout(lc);
        configured.fireSelect(1);
        configured.fireActivate(2);
        configured.fireHeaderClick(1);
        ListCellStyle configuredStyle = configured.cellStyle(0, 0);
        t.expectTrue("factory IListView properties",
            configuredSize.w == 18 && configuredSize.h == 4 && g != nullptr && g.factoryProbe == 1
            && g.factoryActivate == 2 && g.factoryHeader == 1
            && configuredStyle.hasRole && configuredStyle.role == LIST_ROLE_WARNING
            && configured.sortColumn == 1 && configured.sortAscending);
        delete configured;

        ITextInput configuredInput = textInput("", (string s) =>
        { if (g != nullptr) g.interfaceTextChanged++; });
        configuredInput.width = 17; configuredInput.color = colorLiteral(rgb(1, 2, 3));
        configuredInput.backgroundColor = colorLiteral(rgb(4, 5, 6));
        Size inputSize = configuredInput.layout(lc); configuredInput.fireChangeText("typed");
        t.expectTrue("factory ITextInput properties", inputSize.w == 17
            && colorIsLiteral(configuredInput.color) && colorPacked(configuredInput.color) == rgb(1, 2, 3)
            && colorIsLiteral(configuredInput.backgroundColor) && colorPacked(configuredInput.backgroundColor) == rgb(4, 5, 6)
            && g != nullptr && g.interfaceTextChanged == 1);
        delete configuredInput;

        ICheckbox configuredCheck = checkbox("probe", false, (bool v) =>
        { if (g != nullptr) g.interfaceCheckboxChanged = v; });
        configuredCheck.color = colorLiteral(rgb(7, 8, 9)); configuredCheck.fireToggle();
        t.expectTrue("factory ICheckbox properties", colorIsLiteral(configuredCheck.color)
            && colorPacked(configuredCheck.color) == rgb(7, 8, 9)
            && g != nullptr && g.interfaceCheckboxChanged);
        delete configuredCheck;

        IProgressBar configuredProgress = progressBar(25, 19);
        configuredProgress.color = colorLiteral(rgb(10, 11, 12));
        Size progressSize = configuredProgress.layout(lc);
        t.expectTrue("factory IProgressBar properties", progressSize.w == 19
            && colorIsLiteral(configuredProgress.color)
            && colorPacked(configuredProgress.color) == rgb(10, 11, 12));
        delete configuredProgress;

        ITextArea configuredArea = textArea("", () =>
        { if (g != nullptr) g.interfaceAreaChanged++; });
        configuredArea.width = 21; configuredArea.height = 6;
        configuredArea.color = colorLiteral(rgb(13, 14, 15)); configuredArea.backgroundColor = colorLiteral(rgb(16, 17, 18));
        Size areaSize = configuredArea.layout(lc); configuredArea.fireChange();
        t.expectTrue("factory ITextArea properties", areaSize.w == 21 && areaSize.h == 6
            && colorIsLiteral(configuredArea.color) && colorPacked(configuredArea.color) == rgb(13, 14, 15)
            && colorIsLiteral(configuredArea.backgroundColor)
            && colorPacked(configuredArea.backgroundColor) == rgb(16, 17, 18)
            && g != nullptr && g.interfaceAreaChanged == 1);
        delete configuredArea;

        ITreeView configuredTree = treeView((int i) => 0, (int p, int i) => 0,
            (int i) => "probe");
        configuredTree.width = 23; configuredTree.height = 7;
        Size treeSize = configuredTree.layout(lc);
        t.expectTrue("factory ITreeView properties", treeSize.w == 23 && treeSize.h == 7);
        delete configuredTree;

        IImage configuredImage = image(0u, 1, 1);
        configuredImage.width = 11; configuredImage.height = 5; configuredImage.altText = "probe";
        Size imageSize = configuredImage.layout(lc);
        t.expectTrue("factory IImage properties", imageSize.w == 11 && imageSize.h == 5
            && configuredImage.altText == "probe");
        delete configuredImage;

        // 1. Every P8 control became a real control. Inactive panes are lazy, so visit
        // each page before reading its controls and retain one combined assertion.
        nativeTabSelect("root/content/pages", 0);
        bool createdBasics = _exists(basics + "cardradio/rg/r0") && _exists(basics + "cardradio/rg/r1")
            && _exists(basics + "cardradio/rg/r2");
        nativeTabSelect("root/content/pages", 1);
        bool createdInput = _exists(input + "cardcombo/comborow/combofield/combo");
        nativeTabSelect("root/content/pages", 2);
        bool createdData = _exists(data + "cardlist/list");
        nativeTabSelect("root/content/pages", 5);
        bool createdChrome = _exists(chrome + "cardstatus/status") && _exists(chrome + "cardstatus/status2");
        t.expectTrue("controls created", createdBasics && createdInput && createdData && createdChrome);

        // 2. Initial state: r1 checked (pick=1), combo at 0, 100k rows, status echoes model.
        nativeTabSelect("root/content/pages", 0);
        bool initialRadio = nativeIsChecked(basics + "cardradio/rg/r1")
            && !nativeIsChecked(basics + "cardradio/rg/r0") && !nativeIsChecked(basics + "cardradio/rg/r2");
        nativeTabSelect("root/content/pages", 1);
        bool initialCombo = nativeComboSelected(input + "cardcombo/comborow/combofield/combo") == 0;
        nativeTabSelect("root/content/pages", 2);
        bool initialList = nativeListRowCount(data + "cardlist/list") == GALLERY_ROWS;
        nativeTabSelect("root/content/pages", 5);
        bool initialStatus = _statusIs(chrome + "cardstatus/status",
            "Size: Medium  Font: Consolas  Row: none  Opened: none");
        t.expectTrue("initial state", initialRadio && initialCombo && initialList && initialStatus);

        // 3. Click radio "Large".
        nativeTabSelect("root/content/pages", 0);
        nativeClickButton(basics + "cardradio/rg/r2");
        bool radioSelected = nativeIsChecked(basics + "cardradio/rg/r2")
            && !nativeIsChecked(basics + "cardradio/rg/r1");
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("radio selection",
            radioSelected
            && _statusIs(chrome + "cardstatus/status", "Size: Large  Font: Consolas  Row: none  Opened: none"));

        // 4. Change the combo to index 2 (routes CBN_SELCHANGE).
        nativeTabSelect("root/content/pages", 1);
        nativeComboSelect(input + "cardcombo/comborow/combofield/combo", 2);
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("combo change routed",
            _statusIs(chrome + "cardstatus/status", "Size: Large  Font: Segoe UI  Row: none  Opened: none"));

        // 5. Virtualization + rowText wiring: query two cells of row 50000.
        nativeTabSelect("root/content/pages", 2);
        string cell0 = nativeListCellText(listKey, 50000, 0);
        string cell1 = nativeListCellText(listKey, 50000, 1);
        t.expectTrue("cell text", cell0 == "row 50000" && cell1 == "2500000000");

        // 6. Virtualization oracle: rowText fired only a handful of times for 100k rows.
        int calls = g != nullptr ? g.rowTextCalls : 999999;
        t.expectTrue("rowText small", calls > 0 && calls < 100);

        // GridView realization is bounded and keyed by item index.
        t.expectTrue("GridView bounded pool",
            g != nullptr && g.gridCount == 10000 && g.gridViewCalls > 0
            && g.gridViewCalls < 100);
        t.expectTrue("GridView initial native realization",
            _exists(gridViewKey + "/item-0")
            && !_exists(gridViewKey + "/item-9999"));
        if (g != nullptr)
        {
            g.gridSelected = 1;
            g.gridScroll = 150;
            activeCtx().invalidate();
            t.pump();
        }
        t.expectTrue("GridView evicts and realizes on scroll",
            !_exists(gridViewKey + "/item-0")
            && _exists(gridViewKey + "/item-250"));

        // Row icons use only a stable identity plus borrowed BGRA data. The same
        // callback is safe for virtualization/reuse, while empty identity is omission.
        ListRowIcon iconMissing = g != nullptr ? g.iconForRow(50000) : noListIcon();
        ListRowIcon iconOdd = g != nullptr ? g.iconForRow(50005) : noListIcon();
        ListRowIcon iconEven = g != nullptr ? g.iconForRow(50004) : noListIcon();
        t.expectTrue("row icon identity and missing", iconEven.identity != nullptr
            && iconOdd.identity != nullptr && strcmp((char*)iconEven.identity, "ok") == 0
            && strcmp((char*)iconOdd.identity, "warn") == 0 && iconMissing.identity == nullptr);
        int warnSlot = nativeListIconResolve(listKey, 50005);
        int okSlot = nativeListIconResolve(listKey, 50004);
        int warnAgain = nativeListIconResolve(listKey, 50005);
        t.expectTrue("row icon native cache identities", warnSlot >= 0 && okSlot >= 0
            && warnSlot != okSlot && warnAgain == warnSlot
            && nativeListIconCacheCount(listKey) == 2);
        u64 cachedBefore = nativeListIconRevision(listKey, 50004);
        bool winuiVisual = nativeListVisualExpected();
        u64 realizedRevisionBefore = 0u;
        if (winuiVisual)
        {
            t.expectTrue("WinUI ListView header is attached",
                nativeListHeaderAttached(listKey));
            t.expectInt("WinUI realizes a far ListView row", 50004,
                nativeListRealizeRow(listKey, 50004));
            realizedRevisionBefore = nativeListRealizedIconRevision(
                listKey, 50004);
            t.expectTrue("WinUI realized row icon source",
                nativeListRealizedIcon(listKey, 50004)
                && realizedRevisionBefore == 1u);
        }
        u64 oldRevision = iconEven.revision;
        if (g != nullptr) g.mutateIconForTest();
        ListRowIcon replaced = g != nullptr ? g.iconForRow(50004) : noListIcon();
        t.expectTrue("row icon in-place revision", replaced.revision != oldRevision
            && replaced.pixels == iconEven.pixels);
        int okReplaced = nativeListIconResolve(listKey, 50004);
        u64 cachedAfter = nativeListIconRevision(listKey, 50004);
        t.expectTrue("row icon native revision replacement", okReplaced == okSlot
            && cachedBefore == 1u && cachedAfter == 2u && cachedAfter != cachedBefore);
        if (winuiVisual)
        {
            nativeListReload(listKey);
            int replacedRow = nativeListRealizeRow(listKey, 50004);
            u64 realizedRevisionAfter = nativeListRealizedIconRevision(
                listKey, 50004);
            t.expectTrue("WinUI replaces a cached icon revision in place",
                replacedRow == 50004 && nativeListRealizedIcon(listKey, 50004)
                && realizedRevisionBefore == 1u && realizedRevisionAfter == 2u);
        }
        int invalidSlot = nativeListIconResolve(listKey, 50000);
        t.expectTrue("row icon native omission", invalidSlot < 0
            && nativeListIconCacheCount(listKey) == 2);
        if (winuiVisual)
        {
            int missingRow = nativeListRealizeRow(listKey, 50000);
            int backAtTop = nativeListRealizeRow(listKey, 0);
            int resources = nativeListVisualResourceCount(listKey);
            t.expectTrue("WinUI omits invalid realized row icons",
                missingRow == 50000 && !nativeListRealizedIcon(listKey, 50000));
            t.expectTrue("WinUI scrolls and reuses ListView containers",
                backAtTop == 0 && nativeListContainerReuseCount(listKey) > 0);
            t.expectTrue("WinUI ListView resources stay viewport-bounded",
                resources > 0 && resources < 64);
            int distinctIcons = 0;
            int iconProbeRow = 60000;
            while (iconProbeRow <= 60008)
            {
                if (nativeListIconResolve(listKey, iconProbeRow) >= 0)
                    distinctIcons++;
                iconProbeRow++;
            }
            t.expectTrue("WinUI icon cache has no fixed eight-identity ceiling",
                distinctIcons == 9 && nativeListIconCacheCount(listKey) == 11);
        }
        nativeListIconResetForTest(listKey);
        t.expectTrue("row icon teardown cache", nativeListIconCacheCount(listKey) == 0
            && nativeListIconResolve(listKey, 50004) < 0);

        // 7. Selection round-trip: select row 5 as the OS would.
        nativeListSelect(listKey, 5);
        bool listSelected = nativeListSelectedRow(listKey) == 5 && g != nullptr && g.listSel == 5;
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("list selection round-trip",
            listSelected
            && _statusIs(chrome + "cardstatus/status", "Size: Large  Font: Segoe UI  Row: 5  Opened: none"));

        // 8. Activation: Enter on the list (row 5 still selected).
        nativeTabSelect("root/content/pages", 2);
        nativeListActivate(listKey, 5);
        bool listActivated = g != nullptr && g.listActivated == 5;
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("list activation",
            listActivated
            && _statusIs(chrome + "cardstatus/status", "Size: Large  Font: Segoe UI  Row: 5  Opened: 5"));

        // Header input is distinct from row selection/activation, and style is virtual:
        // one row/cell can resolve a semantic role or explicit literal black on demand.
        nativeTabSelect("root/content/pages", 2);
        t.pump();
        if (winuiVisual) nativeListInvokeHeader(listKey, 1);
        else nativeListHeaderClick(listKey, 1);
        t.expectTrue("list header callback", g != nullptr && g.listHeader == 1 && g.listSel == 5);
        int listErrorColor = nativeListCellColor(listKey, 50000, 1);
        t.expectTrue("list cell styles", galleryHasThemeListError(listErrorColor));
        t.expectTrue("list literal black is present", galleryHasBlack(
            nativeListCellColor(listKey, 50000, 0)));
        if (winuiVisual)
        {
            int styledRow = nativeListRealizeRow(listKey, 50000);
            t.expectTrue("WinUI applies semantic cell foreground",
                styledRow == 50000
                && nativeListRealizedCellBrush(listKey, 50000, 1)
                && nativeListRealizedCellColor(listKey, 50000, 1) == listErrorColor);
            t.expectTrue("WinUI applies literal black foreground",
                nativeListRealizedCellBrush(listKey, 50000, 0)
                && galleryHasBlack(nativeListRealizedCellColor(listKey, 50000, 0)));
        }

        // 9. TabControl (P9): two tabs, initial selection 0, the active pane's Text is live.
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("tabs init",
            _exists(tabsKey) && nativeTabCount(tabsKey) == 2
            && nativeTabSelected(tabsKey) == 0
            && _exists(tabsKey + "/p0/t0") && !_exists(tabsKey + "/p1/t1"));

        // 10. Tab switch: select tab 1; model follows, pane p1 becomes live, p0 destroyed.
        nativeTabSelect(tabsKey, 1);
        t.expectTrue("tab switch",
            g != nullptr && g.tab == 1 && nativeTabSelected(tabsKey) == 1
            && _exists(tabsKey + "/p1/t1") && !_exists(tabsKey + "/p0/t0")
            && _statusHas(statusKey + "status2", "Tab: Beta"));

        // 10b. Tab layout: the active pane's content lays out BELOW the strip row (the
        //      TabControl node's own y), so the pane never overlaps the tab segments.
        Rect tabsB = nativeNodeBounds(tabsKey);
        Rect paneTxtB = nativeNodeBounds(tabsKey + "/p1/t1");
        t.expectTrue("tab pane content sits below the strip",
            tabsB.h > 0 && paneTxtB.y > tabsB.y);

        // 11. TreeView (P9): two top-level nodes; expanding "src" lazily makes 2 children (2->4).
        nativeTabSelect("root/content/pages", 2);
        string treeKey = data + "cardtree/tree";
        int cntBefore = nativeTreeItemCount(treeKey);
        u64 srcItem = nativeTreeRootItem(treeKey);
        int beforeExpands = g != nullptr ? g.treeExpands : 0;
        nativeTreeExpandItem(treeKey, srcItem);
        int cntAfter = nativeTreeItemCount(treeKey);
        t.expectTrue("tree expand",
            _exists(treeKey) && cntBefore == 2 && cntAfter == 4
            && g != nullptr && g.treeExpands > beforeExpands);

        // 12. Tree select: select the first child of "src" (main.cb, node 10) -> onSelect.
        u64 child0 = nativeTreeChildItem(treeKey, srcItem);
        int childNid = nativeTreeItemNodeId(treeKey, child0);
        nativeTreeSelectItem(treeKey, child0);
        bool treeSelected = g != nullptr && g.treeSel == 10 && childNid == 10;
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("tree select",
            treeSelected && _statusHas(statusKey + "status2", "Node: 10"));

        // 13. SplitView (P9): dragging the divider changes the ratio + the left pane's width.
        nativeTabSelect("root/content/pages", 3);
        string splitKey = layout + "cardsplit/split";
        Rect sbBefore = nativeNodeBounds(splitKey + "/lp");
        Rect splitB = nativeNodeBounds(splitKey);
        nativeSplitterDrag(splitKey, splitB.x + 30, splitB.y);
        Rect sbAfter = nativeNodeBounds(splitKey + "/lp");
        bool splitDragged = g != nullptr && g.splitRatio != 30 && sbAfter.w != sbBefore.w;
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("split drag",
            splitDragged && _statusHas(statusKey + "status2", "Split: "));

        // 14. ContextMenu (P9): firing item 0 routes CMD_CTX_A through the app menu handler.
        nativeFireContextMenu(chrome + "cardcontext/ctxbox", 0);
        t.expectTrue("context menu route",
            g != nullptr && g.ctxFired == CMD_CTX_A && _statusHas(statusKey + "status2", "Ctx: 201"));

        // 15. All the P10 controls were created.
        nativeTabSelect("root/content/pages", 0);
        bool p10Basics = _exists(basics + "cardbtn/btnrow/btn") && _exists(basics + "cardcheck/check");
        nativeTabSelect("root/content/pages", 1);
        bool p10Input = _exists(input + "cardinput/inputrow/inputfield/input")
            && _exists(input + "cardprog/progressrow/prog") && _exists(input + "cardslider/slider")
            && _exists(input + "cardarea/area") && _exists(editableKey)
            && _exists(toggleKey) && _exists(segmentedKey) && _exists(dateKey)
            && _exists(colorKey);
        nativeTabSelect("root/content/pages", 3);
        bool p10Layout = _exists(layout + "cardgrp/grp") && _exists(expanderKey);
        nativeTabSelect("root/content/pages", 4);
        bool p10Media = _exists(media + "cardimg/img") && _exists(media + "cardcanvas/canvas");
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("P10 controls created",
            p10Basics && p10Input && p10Layout && p10Media && _exists(appStatus));

        nativeTabSelect("root/content/pages", 1);
        t.expectTrue("password and indeterminate controls created",
            _exists(passwordKey) && _exists(input + "cardprog/progressrow/indeterminate"));
        t.expectTrue("spinner control created", _exists(spinnerKey));
        nativeTabSelect("root/content/pages", 0);
        t.expectTrue("link controls created", _exists(linkKey)
            && _exists(disabledLinkKey) && !nativeIsEnabled(disabledLinkKey));
        nativeTabSelect("root/content/pages", 5);
        t.expectTrue("toolbar and dialog controls created", _exists(toolbarKey)
            && _exists(messageKey) && _exists(folderKey) && _exists(fontKey)
            && _exists(chrome + "cardinfobar/info") && _exists(chrome + "cardinfobar/success")
            && _exists(chrome + "cardinfobar/warning") && _exists(infoErrorKey)
            && _exists(popOpenKey));

        // 16. Button click routes onPress.
        nativeTabSelect("root/content/pages", 0);
        nativeClickButton(basics + "cardbtn/btnrow/btn");
        t.expectTrue("button click", g != nullptr && g.btnClicks == 1);

        // 17. TextInput: type text (routes EN_CHANGE) -> controlled onChangeText updates model.
        nativeTabSelect("root/content/pages", 1);
        nativeTypeText(input + "cardinput/inputrow/inputfield/input", "hello");
        t.expectTrue("text input route",
            g != nullptr && g.inputText == "hello"
            && _statusIs(input + "cardinput/inputrow/inputfield/input", "hello"));

        t.type(passwordKey, "secret");
        t.expectTrue("password field mirrors text",
            g != nullptr && g.passwordText == "secret"
            && _statusIs(input + "cardinput/passwordmirror", "Password mirror: secret"));

        t.spinnerSet(spinnerKey, 35);
        bool spinnerRoundTrip = g != nullptr && g.spinnerVal == 35
            && _statusIs(input + "cardspinner/value", "Value: 35");
        t.spinnerSet(spinnerKey, 999);
        t.expectTrue("spinner round-trip and clamp", spinnerRoundTrip
            && g != nullptr && g.spinnerVal == 100
            && _statusIs(input + "cardspinner/value", "Value: 100"));

        t.comboTypeText(editableKey, "typed combo");
        t.expectTrue("editable combo onEdit mirror",
            g != nullptr && g.editableComboText == "typed combo"
            && _statusIs(input + "cardeditable/editmirror", "Edited: typed combo"));

        t.toggleSet(toggleKey, true);
        t.expectTrue("toggle switch state label",
            g != nullptr && g.toggleOn && _statusIs(input + "cardtoggle/state", "State: on"));

        t.segmentedSelect(segmentedKey, 2);
        t.expectTrue("segmented selection label",
            g != nullptr && g.segmentSel == 2
            && _statusIs(input + "cardsegmented/selected", "Selected: 2"));

        t.dateSet(dateKey, 2026, 8, 9);
        t.expectTrue("date picker label",
            g != nullptr && g.dateYear == 2026 && g.dateMonth == 8 && g.dateDay == 9
            && _statusIs(input + "carddate/value", "Date: 2026-8-9"));

        t.colorSet(colorKey, 12, 34, 56);
        t.expectTrue("color well hex label",
            g != nullptr && g.colorHex == "#0C2238"
            && _statusIs(input + "cardcolor/hex", "Hex: #0C2238"));

        nativeTabSelect("root/content/pages", 3);
        Rect expanderExpanded = nativeNodeBounds(expanderKey);
        bool expanderChildExpanded = _exists(expanderChildKey);
        t.expanderToggle(expanderKey);
        Rect expanderCollapsed = nativeNodeBounds(expanderKey);
        bool expanderChildCollapsed = !_exists(expanderChildKey);
        t.expanderToggle(expanderKey);
        bool expanderChildReexpanded = _exists(expanderChildKey);
        t.expectTrue("expander collapse reflows cards",
            expanderChildExpanded && expanderChildCollapsed && expanderChildReexpanded
            && expanderCollapsed.h < expanderExpanded.h);

        nativeTabSelect("root/content/pages", 0);
        t.linkClick(linkKey);
        t.expectTrue("link click counter", g != nullptr && g.linkClicks == 1
            && _statusIs(basics + "cardlink/count", "Clicks: 1"));

        nativeTabSelect("root/content/pages", 5);
        t.toolbarClick(toolbarKey, 102);
        t.expectTrue("toolbar command readout", g != nullptr && g.toolbarCmd == 102
            && _statusIs(chrome + "cardtoolbar/status", "Command: 102"));

        uiTestScriptMessageBox(1);
        t.click(messageKey);
        t.expectTrue("message box scripted answer",
            g != nullptr && g.dialogAnswer == 1 && _statusIs(answerKey, "Answer: yes"));
        uiTestScriptFolder("gallery-folder");
        t.click(folderKey);
        t.expectTrue("folder dialog scripted path",
            g != nullptr && g.folderPath == "gallery-folder"
            && _statusIs(folderPathKey, "Folder: gallery-folder"));

        uiTestScriptFont("Menlo", 15);
        t.click(fontKey);
        t.expectTrue("font dialog scripted choice",
            g != nullptr && g.chosenFontFamily == "Menlo" && g.chosenFontSize == 15
            && _statusIs(fontReadoutKey, "Font: Menlo 15"));

        t.infoBarClose(infoErrorKey);
        t.expectTrue("info bar close callback",
            g != nullptr && g.infoErrorClosed && !_exists(infoErrorKey)
            && _statusIs(infoStateKey, "Error bar: dismissed"));

        t.click(popOpenKey);
        u64 popHandle = activeCtx().nativeHandle(popKey);
        t.popoverCommand(popKey, 2);
        t.expectTrue("popover command and close",
            popHandle != 0u && g != nullptr && g.popoverCmd == 2
            && activeCtx().nativeHandle(popKey) == 0u
            && _statusIs(popReadoutKey, "Command: 2"));

        nativeTabSelect("root/content/pages", 1);
        t.expectTrue("rich text plain runs",
            t.richTextPlain(richDisplayKey) == "Bold italic underlined");
        t.richTextTypeText(richEditorKey, "typed rich text");
        t.expectTrue("rich text edit mirror",
            g != nullptr && g.richTextMirror == "typed rich text"
            && _statusIs(richMirrorKey, "Mirror: typed rich text"));

        if const (__MACOS__)
        {
            nativeTabSelect("root/content/pages", 4);
            t.expectTrue("webview handle exists", _exists(webKey));
        }

        // 18. Checkbox: click -> controlled onChange flips the model.
        nativeTabSelect("root/content/pages", 0);
        nativeClickButton(basics + "cardcheck/check");
        t.expectTrue("checkbox toggle", g != nullptr && g.checked);

        // 19. ProgressBar reflects the model value.
        nativeTabSelect("root/content/pages", 1);
        t.expectTrue("progress value", nativeProgressValue(input + "cardprog/progressrow/prog") == 60);

        // 20. Slider: drag to a new position -> controlled onChange.
        nativeSliderSet(input + "cardslider/slider", 80);
        t.expectTrue("slider", g != nullptr && g.sliderVal == 80);

        // 21. GroupBox carries its title.
        nativeTabSelect("root/content/pages", 3);
        t.expectTrue("groupbox title", _statusIs(layout + "cardgrp/grp", "Options"));

        // 22. Image: the setImageData seam uploaded a bitmap.
        nativeTabSelect("root/content/pages", 4);
        t.expectTrue("image has bitmap", nativeImageHasBitmap(media + "cardimg/img"));

        // 23. StatusBar strip carries the main pane text.
        string sbarTxt = nativeStatusText(appStatus);
        t.expectTrue("statusbar text", strstr(sbarTxt.data(), "Ready") != nullptr);

        // 24. Theme toggle: clicking flips dark mode and re-themes the window.
        nativeTabSelect("root/content/pages", 0);
        nativeClickButton(basics + "cardbtn/btnrow/themebtn");
        t.expectTrue("theme toggle", g != nullptr && g.dark && hostDark());

        // 24b. Card backdrop follows the theme flip: the committed View's fill re-colors to
        //      the dark panel. The reconcile bug kept the stale light fill (unreadable card).
        t.expectTrue("card backdrop re-colors on theme flip",
            nativeContainerBg(basics + "cardbtn") == galleryThemePanelColor(darkTheme()));

        // 25. Accent buttons (P10): dark-mode push button carries a stored accent AND the
        //     NM_CUSTOMDRAW path renders it - driving the custom draw fills the button rect
        //     with exactly the stored accent (PrintWindow cannot capture this; live-only).
        u32 abg = nativeAccentBg(basics + "cardbtn/btnrow/btn");
        bool stored = abg != 0u;
        u32 drawn = nativeTestCustomDrawFill(basics + "cardbtn/btnrow/btn");
        t.expectTrue("accent", stored && drawn == abg);

        // 26. Theme-flip storm (via themeStorm kit): flip light/dark K times; the host titlebar
        //     theme must stay in lockstep with the model after every reconcile.
        t.expectTrue("theme-flip storm keeps host in lockstep",
            themeStorm(26, basics + "cardbtn/btnrow/themebtn", () => g != nullptr && g.dark));

        // 27. Reconcile stress-soak (via reconcileStress kit): a seeded LCG drives create/
        //     destroy/reorder across the churn pool for 48 steps; after each step the native
        //     census must match the mask-decoded key set and any persisting key keeps its
        //     handle. mutate = click the stress-step button; expectedKeys = decode stressMask.
        g.stressSeed = 305419896;   // fixed seed (0x12345678); fully deterministic
        nativeTabSelect("root/content/pages", 6);
        string stressKey = stress + "cardstress";
        t.expectTrue("reconcile census + identity held across 48 steps",
            reconcileStress(48,
                () => { nativeClickButton(stressKey + "/stressbtn"); },
                () =>
                {
                    // Collect the keys the churn mask says should be live this step.
                    list<string> keys = default;
                    int slot = 0;
                    while (slot < 8)
                    {
                        if (((g.stressMask >> slot) & 1) != 0)
                            keys.add(stressKey + "/stressbox/s" + slot.toString());
                        slot++;
                    }
                    return keys;
                }));

        // 28. Flex form rows: the TextInput, ComboBox, and flex-card fields all use the same
        //     [label fixed 12][field flex 1] row idiom, so their flex-View slots share the same
        //     start x and width in a column - even though the leaf widgets they wrap differ.
        //     With the card now width-capped at 70 (padding 1*2=2 -> inner 68) and the row
        //     padding/gap 0, each field flexes to 68 - 12(label) = 56 cols; the assert checks
        //     the three fields are identical rather than hardcoding 56, so it stays host-robust.
        nativeTabSelect("root/content/pages", 1);
        Rect inputFieldB = nativeNodeBounds(input + "cardinput/inputrow/inputfield");
        Rect comboFieldB = nativeNodeBounds(input + "cardcombo/comborow/combofield");
        nativeTabSelect("root/content/pages", 3);
        Rect flexFieldB  = nativeNodeBounds(layout + "cardflex/flexrow/flexfield");
        t.expectTrue("flex form-row fields align",
            inputFieldB.w > 0 && comboFieldB.w > 0 && flexFieldB.w > 0
            && inputFieldB.x == comboFieldB.x && inputFieldB.w == comboFieldB.w
            && inputFieldB.x == flexFieldB.x && inputFieldB.w == flexFieldB.w);

        // 29. Flex 2:1 pair: a fixed-width (61) container makes the split deterministic
        //     regardless of host window size. leftover = 61 - 2*inset(1) - gap(1) = 58; the
        //     2:1 shares floor to 38/19 (allocated 57) and the 1-cell remainder goes to the
        //     higher-weight child left to right, giving an exact 39/19 split.
        Rect flexTwoB = nativeNodeBounds(layout + "cardflex/flexdemo/flexpair/flextwo");
        Rect flexOneB = nativeNodeBounds(layout + "cardflex/flexdemo/flexpair/flexone");
        t.expectTrue("flex 2:1 weighted split with exact remainder handling",
            flexTwoB.w == 39 && flexOneB.w == 19
            && flexOneB.x == flexTwoB.x + flexTwoB.w + 1);

        // 30. Flex layout card: every control in the new section exists / lays out with
        //     positive bounds (the label, the flex field's TextInput, and the demo container).
        Rect flexDemoB = nativeNodeBounds(layout + "cardflex/flexdemo");
        t.expectTrue("flex section controls laid out",
            _exists(layout + "cardflex/flexrow/flexfield/flexinput")
            && nativeNodeBounds(layout + "cardflex/flexrow/flexlabel").w > 0
            && flexFieldB.x > 0 && flexFieldB.w > 0
            && flexDemoB.w > 0 && flexDemoB.h > 0
            && flexTwoB.w > 0 && flexOneB.w > 0);

        // 30b. Per-axis clamps survive an exact zero flex share and cap an explicit size.
        IView clampRow = row(makeStyle(0, 4, 0));
        IText clampLabel = text("fixed");
        clampLabel.style.width = 12;
        IButton clampButton = button("keep", () => { });
        clampButton.style.flex = 1;
        clampButton.style.minWidth = 3;
        clampButton.style.minHeight = 2;
        clampRow.add(clampLabel);
        clampRow.add(clampButton);
        LayoutConstraints clampC = default;
        clampC.availW = 4; clampC.availH = 4;
        clampRow.layout(clampC);
        Rect clampedButtonB = clampButton.nodeBounds();
        t.expectTrue("min clamps keep a zero-share flex control alive",
            clampedButtonB.w == 3 && clampedButtonB.h == 2);
        deleteTree(clampRow);

        IText maxText = text("wide");
        maxText.style.width = 8; maxText.style.height = 5;
        maxText.style.maxWidth = 3; maxText.style.maxHeight = 2;
        maxText.layout(clampC);
        Rect maxTextB = maxText.nodeBounds();
        t.expectTrue("max clamps cap explicit dimensions",
            maxTextB.w == 3 && maxTextB.h == 2);
        delete maxText;
        // 31. The root container exists, sits at the origin, and covers the whole window
        //     viewport (per-page ScrollViews live inside the tabs). Height may exceed the
        // host by the clipped bottom-padding row: the tab strip is sized so its bottom
        // edge meets the docked StatusBar, which pushes the column's own bottom pad off
        // screen. A missing node yields an all-zero Rect, which the width check rejects.
        Rect scrollB = nativeNodeBounds("root");
        t.expectTrue("root container covers the window viewport",
            scrollB.x == 0 && scrollB.y == 0
            && scrollB.w == hostWidth() && scrollB.h >= hostHeight());

        // 32. Overflow proof: the Input page's 12 cards naturally push its last card
        //     below the page viewport, so per-page scrolling is genuinely exercised.
        nativeTabSelect("root/content/pages", 1);
        Rect inputPageB = nativeNodeBounds("root/content/pages/input/scroll");
        Rect lateCardB = nativeNodeBounds(input + "cardprog");
        t.expectTrue("a late card overflows the viewport (scrolling is required)",
            lateCardB.h > 0 && lateCardB.y + lateCardB.h > inputPageB.y + inputPageB.h);

        // 33. Every card's title Text exists, under the "header" sub-column added in the
        //     Phase C card restructure (one card per demoed control, all listed here).
        nativeTabSelect("root/content/pages", 0);
        bool titlesBasics = _exists(basics + "cardbtn/header/title") && _exists(basics + "cardtext/header/title")
            && _exists(basics + "cardcheck/header/title") && _exists(basics + "cardradio/header/title");
        nativeTabSelect("root/content/pages", 1);
        bool titlesInput = _exists(input + "cardinput/header/title") && _exists(input + "cardprog/header/title")
            && _exists(input + "cardslider/header/title") && _exists(input + "cardcombo/header/title")
            && _exists(input + "cardarea/header/title") && _exists(input + "cardeditable/header/title")
            && _exists(input + "cardtoggle/header/title") && _exists(input + "cardsegmented/header/title")
            && _exists(input + "carddate/header/title") && _exists(input + "cardcolor/header/title")
            && _exists(input + "cardrich/header/title");
        nativeTabSelect("root/content/pages", 2);
        bool titlesData = _exists(data + "cardlist/header/title") && _exists(data + "cardgridview/header/title")
            && _exists(data + "cardtree/header/title");
        nativeTabSelect("root/content/pages", 3);
        bool titlesLayout = _exists(layout + "cardgrid/header/title") && _exists(layout + "cardgrp/header/title")
            && _exists(layout + "cardsplit/header/title") && _exists(layout + "cardflex/header/title")
            && _exists(layout + "cardexpander/header/title");
        nativeTabSelect("root/content/pages", 4);
        bool titlesMedia = _exists(media + "cardimg/header/title") && _exists(media + "cardcanvas/header/title");
        if const (__MACOS__) titlesMedia = titlesMedia && _exists(media + "cardweb/header/title");
        nativeTabSelect("root/content/pages", 5);
        bool titlesChrome = _exists(chrome + "cardtabs/header/title") && _exists(chrome + "cardcontext/header/title")
            && _exists(chrome + "cardstatus/header/title") && _exists(chrome + "cardinfobar/header/title")
            && _exists(chrome + "cardpopover/header/title");
        nativeTabSelect("root/content/pages", 6);
        bool titlesStress = _exists(stress + "cardstress/header/title");
        t.expectTrue("every card title exists",
            titlesBasics && titlesInput && titlesData && titlesLayout && titlesMedia && titlesChrome && titlesStress);

        // 34. Every card's caption desc Text exists too (paired one-line description under
        //     the title, gap 0 - Phase C typography restructure).
        nativeTabSelect("root/content/pages", 0);
        bool descBtn = _exists(basics + "cardbtn/header/desc");
        nativeTabSelect("root/content/pages", 4);
        bool descMedia = _exists(media + "cardimg/header/desc");
        nativeTabSelect("root/content/pages", 5);
        bool descChrome = _exists(chrome + "cardstatus/header/desc");
        nativeTabSelect("root/content/pages", 6);
        bool descStress = _exists(stress + "cardstress/header/desc");
        t.expectTrue("every card desc exists", descBtn && descMedia && descChrome && descStress);

        // 35. A card's own path has a live native handle: Phase A's container-backdrop
        //     painting is keyed by the container's own path, so this doubles as the
        //     backdrop-existence oracle (host-neutral: it is the same nativeHandle check
        //     _exists always uses, just pointed at a card container instead of a leaf).
        nativeTabSelect("root/content/pages", 0);
        bool btnBackdrop = _exists(basics + "cardbtn");
        nativeTabSelect("root/content/pages", 5);
        bool statusBackdrop = _exists(chrome + "cardstatus");
        t.expectTrue("card backdrop handle exists", btnBackdrop && statusBackdrop);

        // 36. Regression (the original bug): a form-row label's Text renders IN its
        //     row, not one row below it. The label wrapper is a plain View (padding
        //     0) now instead of a Box - a Box inset its child by 1+padding, pushing
        //     "Font:" a full row below the combo row. The Text child is unkeyed, so
        //     it resolves at the synthesized positional segment "#0".
        nativeTabSelect("root/content/pages", 1);
        Rect comboRowB   = nativeNodeBounds(input + "cardcombo/comborow");
        Rect comboLabelB = nativeNodeBounds(input + "cardcombo/comborow/combolabel");
        Rect comboLabelTxtB = nativeNodeBounds(input + "cardcombo/comborow/combolabel/#0");
        t.expectTrue("form label text renders in-row (no Box border inset)",
            comboLabelB.y == comboRowB.y && comboLabelTxtB.y == comboLabelB.y
            && comboLabelB.h == 1);

        // 37. Cards cap at ~70 cols: View honors style.width (makeStyle(1, 70, 0)),
        //     so a card reports w = 70 regardless of the 60-col host window.
        nativeTabSelect("root/content/pages", 0);
        Rect btnCardB = nativeNodeBounds(basics + "cardbtn");
        nativeTabSelect("root/content/pages", 1);
        Rect comboCardB = nativeNodeBounds(input + "cardcombo");
        t.expectTrue("card capped at 70 cols (View honors style.width)",
            btnCardB.w == 70 && comboCardB.w == 70);

        // 38. Context window operations and UI-thread timers use the active window's seam.
        IUiContext timerCtx = activeCtx();
        UiContext headlessState = default;
        IUiContext headlessCtx = &headlessState;
        headlessCtx.setContentSize(17, 9);
        headlessCtx.setTopmost(true);
        t.expectTrue("headless context window state accessors",
            headlessCtx.requestedWidth() == 17 && headlessCtx.requestedHeight() == 9
            && headlessCtx.requestedTopmost());
        timerCtx.setContentSize(42, 24);
        timerCtx.setTopmost(true);
        nativeResizeClient(37, 21);
        bool liveSize = timerCtx.requestedWidth() == hostWidth()
            && timerCtx.requestedHeight() == hostHeight();
        bool requestedSize = timerCtx.requestedWidth() == 42
            && timerCtx.requestedHeight() == 24;
        t.expectTrue("live context window state accessors",
            (liveSize || requestedSize) && timerCtx.requestedTopmost());
        timerCtx.setContentSize(42, 24);
        timerCtx.setTopmost(false);
        bool appliedBeforePref = hostDark();
        bool pref = timerCtx.systemPrefersDark();
        bool prefAgain = timerCtx.systemPrefersDark();
        u64 onceHandle = timerCtx.after(20, () =>
        {
            if (g != nullptr) { g.timerOnce++; g.timerCallbackRan = true; }
        });
        u64 repeatHandle = timerCtx.every(10, () =>
        {
            if (g != nullptr)
            {
                g.timerTicks++; g.timerCallbackRan = true;
                if (g.timerTicks == 1) activeCtx().cancelTimer(g.timerSelfCancelHandle);
            }
        });
        if (g != nullptr) g.timerSelfCancelHandle = repeatHandle;
        bool oneShot = t.waitUntil(() => g != nullptr && g.timerOnce == 1, 500);
        int ticksBeforeCancel = g != nullptr ? g.timerTicks : 0;
        timerCtx.cancelTimer(repeatHandle);
        t.pump();
        os.sleep_ms(30);
        t.pump();
        t.expectTrue("context size + system preference query",
            hostWidth() == 42 && hostHeight() == 24 && hostDark() == appliedBeforePref
            && pref == prefAgain);
        t.expectTrue("one-shot and repeating UI timers",
            onceHandle != 0u && repeatHandle != 0u && oneShot
            && ticksBeforeCancel > 0 && g != nullptr && g.timerCallbackRan);
        t.expectTrue("cancelled repeating timer stays stopped",
            g != nullptr && g.timerTicks == ticksBeforeCancel);

        // 39. Grid labels share one auto-sized column across all rows and all inputs exist.
        nativeTabSelect("root/content/pages", 3);
        Rect gridB = nativeNodeBounds(layout + "cardgrid/grid");
        Rect nameLabelB = nativeNodeBounds(layout + "cardgrid/grid/namelabel");
        Rect emailLabelB = nativeNodeBounds(layout + "cardgrid/grid/emaillabel");
        Rect nameB = nativeNodeBounds(layout + "cardgrid/grid/name");
        Rect emailB = nativeNodeBounds(layout + "cardgrid/grid/email");
        Rect noteB = nativeNodeBounds(layout + "cardgrid/grid/note");
        t.expectTrue("grid labels align inputs",
            _exists(layout + "cardgrid/grid/name")
            && _exists(layout + "cardgrid/grid/email")
            && _exists(layout + "cardgrid/grid/note")
            && nameLabelB.w == 13 && emailLabelB.w == 13
            && nameB.x == emailB.x && emailB.x == noteB.x
            && nameB.x == gridB.x + 14);

        // 40. The star field column absorbs the remaining card width.
        t.expectTrue("grid star fields stretch",
            nameB.w > 20 && emailB.w > 20 && noteB.w > 20);
    });

    return s.run(0, nullptr);
}
