{
  "name": "cflat-language",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.13.0",
  "publisher": "cflat",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cflat",
    "onDebug",
    "onDebugResolve:cflat",
    "onDebugDynamicConfigurations:cflat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cflat",
        "aliases": [
          "CFlat",
          "cflat",
          "C-flat"
        ],
        "extensions": [
          ".cb"
        ],
        "filenames": [],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cflat",
        "scopeName": "source.cflat",
        "path": "./syntaxes/cflat.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "cflat"
      }
    ],
    "debuggers": [
      {
        "type": "cflat",
        "label": "cflat",
        "languages": [
          "cflat"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "%cflat.debug.program.description%",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "%cflat.debug.args.description%",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "%cflat.debug.cwd.description%",
                "default": "${fileDirname}"
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "%cflat.debug.stopAtEntry.description%",
                "default": false
              },
              "console": {
                "type": "string",
                "enum": [
                  "integratedTerminal",
                  "externalTerminal",
                  "internalConsole"
                ],
                "description": "%cflat.debug.console.description%",
                "default": "integratedTerminal"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cflat",
            "request": "launch",
            "name": "Run cflat file",
            "program": "${file}",
            "args": [],
            "stopAtEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "%cflat.debug.snippet.label%",
            "description": "%cflat.debug.snippet.description%",
            "body": {
              "type": "cflat",
              "request": "launch",
              "name": "Run cflat file",
              "program": "^\"\\${file}\"",
              "args": [],
              "stopAtEntry": false
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "cflat.runDiagnostics",
        "title": "%cflat.runDiagnostics.title%"
      },
      {
        "command": "cflat.showLlvmIr",
        "title": "%cflat.showLlvmIr.title%"
      },
      {
        "command": "cflat.showAssembly",
        "title": "%cflat.showAssembly.title%"
      },
      {
        "command": "cflat.showOptimizationInfo",
        "title": "%cflat.showOptimizationInfo.title%"
      },
      {
        "command": "cflat.toggleOptimizationInfo",
        "title": "%cflat.toggleOptimizationInfo.title%"
      },
      {
        "command": "cflat.showOutput",
        "title": "%cflat.showOutput.title%"
      },
      {
        "command": "cflat.restartServer",
        "title": "%cflat.restartServer.title%"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "cflat",
      "properties": {
        "cflat.executablePath": {
          "type": "string",
          "default": "",
          "description": "%cflat.executablePath.description%"
        },
        "cflat.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "%cflat.enableDiagnostics.description%"
        },
        "cflat.diagnosticDelay": {
          "type": "number",
          "default": 500,
          "description": "%cflat.diagnosticDelay.description%"
        },
        "cflat.optimizationInfo.enable": {
          "type": "boolean",
          "default": false,
          "description": "%cflat.optimizationInfo.enable.description%"
        },
        "cflat.optimizationInfo.inlineAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "%cflat.optimizationInfo.inlineAnnotations.description%"
        },
        "cflat.optimizationInfo.optLevel": {
          "type": "number",
          "enum": [
            0,
            1,
            2
          ],
          "default": 2,
          "description": "%cflat.optimizationInfo.optLevel.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run l10n && node esbuild.js --production",
    "compile": "npm run l10n && node esbuild.js",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "l10n:pseudo": "vscode-l10n-dev generate-pseudo --outDir ./l10n ./l10n/bundle.l10n.json ./package.nls.json",
    "l10n:xlf": "vscode-l10n-dev generate-xlf --outFile ./l10n/cflat.xlf ./l10n/bundle.l10n.json ./package.nls.json",
    "l10n": "npm run l10n:export && npm run l10n:pseudo"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.91.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "l10n": "./l10n"
}
