    u64 contextMenuFor(string keyPath)
    {
        int i = 0;
        while (i < this.ctxKeys.count())
        {
            if (this.ctxKeys.get(i) == keyPath) { u64 v = this.ctxMenus.get(i); return v; }
            i++;
        }
        return 0u;
    }

    // The registered context menu for `keyPath` or its nearest ancestor prefix (longest
    // match wins). Controls are flat sibling NSViews, so a right-click over a card's inner
    // control must resolve the container's menu - the prefix walk mirrors Win32's bubbling.
    u64 _ctxMenuForPathOrAncestor(string keyPath)
    {
        u64 best = 0u; int bestLen = 0 - 1;
        int i = 0;
        while (i < this.ctxKeys.count())
        {
            string k = this.ctxKeys.get(i);
            bool isSelf = keyPath == k;
            bool isDesc = !isSelf && keyPath.length() > k.length() && startsWith(keyPath, k + "/");
            if ((isSelf || isDesc) && (int)k.length() > bestLen)
            {
                best = this.ctxMenus.get(i); bestLen = (int)k.length();
            }
            i++;
        }
        return best;
    }

    // Build an NSMenu from a boxed ContextMenu and hang it on the control (setMenu:, which
    // NSView inherits). A live right-click pops it; the chosen item routes its command
    // through onMenu: -> routeMenu, the same path the menu bar + nativeFireContextMenu use.
    void _attachContextMenu(u64 h, u64 menuPtr)
    {
        void* ctrl = u2h(h);
        if (ctrl == nullptr) return;
        ContextMenu* cm = (ContextMenu*)menuPtr;
        if (cm == nullptr) return;
        void* menu = msg0(msg0(cls("NSMenu"), "alloc"), "init");
        msgBool(menu, "setAutoenablesItems:", false);
        int i = 0;
        while (i < cm.count())
        {
            string lbl = cm.labels.get(i);
            if (lbl.length() == 0)
            {
                msg1(menu, "addItem:", msg0(cls("NSMenuItem"), "separatorItem"));
            }
            else
            {
                void* item = msg3(msg0(cls("NSMenuItem"), "alloc"), "initWithTitle:action:keyEquivalent:",
                                  nsStr(lbl.data()), sel("onMenu:"), nsStr((char*)""));
                msg1(item, "setTarget:", this.target);
                msgInt(item, "setTag:", (i64)cm.cmds.get(i));
                msg1(menu, "addItem:", item);
            }
            i++;
        }
        msg1(ctrl, "setMenu:", menu);
    }

