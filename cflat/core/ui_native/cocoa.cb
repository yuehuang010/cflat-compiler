    // CfCanvasView: a flipped custom NSView whose drawRect: bridges to onPaint(ICanvas).
    void* cvv = newClass("CfCanvasView", "NSView");
    if (cvv != nullptr)
    {
        function<i8(void*, void*)> flip = _canvasIsFlippedImp;
        addMethodBool0(cvv, "isFlipped", flip);
        function<void(void*, void*, double, double, double, double)> dr = _canvasDrawRectImp;
        __classAddMethod(cvv, sel("drawRect:"), (void*)dr, "v@:{{CGRect={{CGPoint=dd}}{{CGSize=dd}}}}");
        // Input overrides (mouseDown:/Dragged:/Up:/scrollWheel:/magnifyWithEvent:): all
        // take (self, _cmd, NSEvent*), encoding "v@:@". They invoke the element handlers
        // (no-op by default), so an input-less canvas is unaffected.
        function<void(void*, void*, void*)> md = _canvasMouseDownImp;
        function<void(void*, void*, void*)> mg = _canvasMouseDraggedImp;
        function<void(void*, void*, void*)> mu = _canvasMouseUpImp;
        function<void(void*, void*, void*)> sw = _canvasScrollWheelImp;
        function<void(void*, void*, void*)> mag = _canvasMagnifyImp;
        addMethod0(cvv, "mouseDown:", md);
        addMethod0(cvv, "mouseDragged:", mg);
        addMethod0(cvv, "mouseUp:", mu);
        addMethod0(cvv, "scrollWheel:", sw);
        addMethod0(cvv, "magnifyWithEvent:", mag);
        finishClass(cvv);
    }

    void* ad = newClass("CfHostAppDelegate", "NSObject");
    if (ad != nullptr)
    {
        function<i8(void*, void*, void*)> t = _shouldTerminateImp;
        addMethodBool(ad, "applicationShouldTerminateAfterLastWindowClosed:", t);
        function<void(void*, void*, void*)> dfl = _didFinishLaunchingImp;
        addMethod0(ad, "applicationDidFinishLaunching:", dfl);
        finishClass(ad);
    }
}

// Create a new top-level window bound to `app`, register it in the owning list, give it
// its own content view + CfHostTarget, install the ctx.post marshaling hooks, and (if
// shown) make it key. Returns the window's registry INDEX and leaves it active (_cur).
// We return an int, not a CocoaHost*: an owning class pointer bound to a caller local
// would auto-free the window at scope exit and double-free with teardown.
// `show` controls visibility (the self-test creates it hidden and builds explicitly).
int createAppWindow(IComponent app, const char* title, bool show)
{
    if (!cocoaInit()) { printf("failed to load AppKit\n"); return 0 - 1; }
    void* nsapp = msg0(cls("NSApplication"), "sharedApplication");
    msgInt(nsapp, "setActivationPolicy:", 0);   // NSApplicationActivationPolicyRegular
    registerHostClasses();

    // Process-global app delegate, installed once (applicationDidFinishLaunching drives
    // activation; applicationShouldTerminateAfterLastWindowClosed: -> NO).
    if (_appDelegate == nullptr)
    {
        _appDelegate = msg0(msg0(cls("CfHostAppDelegate"), "alloc"), "init");
        msg1(nsapp, "setDelegate:", _appDelegate);
    }

    CocoaHost* fresh = new CocoaHost();
    fresh.app = app;
    _windows.add(fresh);            // moves the window into the owning registry
    _cur = _windows.count() - 1;

    // Content 760x560 pt -> w=95, h=21 DIP. styleMask 15 = Titled|Closable|
    // Miniaturizable|Resizable, backing 2 = Buffered.
    void* win = msgRect3i(msg0(cls("NSWindow"), "alloc"),
                          "initWithContentRect:styleMask:backing:defer:",
                          0.0, 0.0, 760.0, 560.0, 15u, 2u, false);
    msg1(win, "setTitle:", nsStr((char*)title));
    msgBool(win, "setReleasedWhenClosed:", false);
    curWin().window = win;
    curWin().w = 95; curWin().h = 21;

    void* cv = msgRect(msg0(cls("CfFlippedView"), "alloc"), "initWithFrame:", 0.0, 0.0, 760.0, 560.0);
    msg1(win, "setContentView:", cv);
    curWin().contentView = cv;

    // This window's own target: control action, window delegate, data sources.
    curWin().target = msg0(msg0(cls("CfHostTarget"), "alloc"), "init");
    msg1(win, "setDelegate:", curWin().target);

    void* center = msg0(cls("NSDistributedNotificationCenter"), "defaultCenter");
    function<void*(void*, void*, void*, void*, void*, void*)> observe =
        (function<void*(void*, void*, void*, void*, void*, void*)>)__objcMsgSendPtr;
    observe(center, sel("addObserver:selector:name:object:"), curWin().target,
            sel("onThemeChanged:"), nsStr("AppleInterfaceThemeChangedNotification"), nullptr);

    // ctx.post() marshaling: run a boxed closure on the main thread via THIS window's
    // target's runPostBox: (performSelectorOnMainThread). Same opaque-u64 contract as Win32.
    curWin().ctx.bindPost((u64)curWin().target, _cocoaPostEnqueue);
    curWin().ctx.bindThreadId(_cocoaCurTid(), _cocoaCurTid);
    curWin().ctx.bindWindowOps((u64)curWin().target, _cocoaSetContentSize, _cocoaSetTopmost,
                               _cocoaSystemPrefersDark, _cocoaStartTimer, _cocoaCancelTimer,
                               true, _cocoaLiveContentSize, _cocoaLiveTopmost);

    buildMenuBar();   // app-wide, built once

    if (show)
    {
        msg1(win, "center", nullptr);
        msg1(win, "makeKeyAndOrderFront:", nullptr);
        msgBool(nsapp, "activateIgnoringOtherApps:", true);
    }
    return _cur;
}

// Free the old tree (if any) and render + reconcile-to-native a fresh one at the
// current window's client size. Controls are reused by key path.
void buildNativeTree()
{
    if (!hasCurWin()) return;
    if (curWin().ready) { IElement t = curWin().tree; deleteTree(t); curWin().ready = false; }
    curWin().tree = curWin().app.render(&curWin().ctx);
    layoutRootBounded(curWin().tree, 0, 0, curWin().w, curWin().h);
    curWin().applyTree(curWin().tree, &curWin().ctx);
    curWin().ready = true;
}

// Register the classes, create + show the primary window, and run the AppKit event loop
// until every window closes (the last windowWillClose: -> [NSApp stop:]).
//
// The component MUST be heap-allocated (`new`): the window OWNS it and `delete`s it in
// dispose(), so it has to outlive this call and be a heap object.
int runAppGuiNative(IComponent app, const char* title)
{
    if (!cocoaInit()) { printf("failed to load AppKit\n"); return 1; }
    void* pool = poolPush();
    int wi = createAppWindow(app, title, true);
    if (wi < 0 || curWin().window == nullptr) { poolPop(pool); return 1; }
    if (!curWin().ready) buildNativeTree();

    void* nsapp = msg0(cls("NSApplication"), "sharedApplication");
    msg0(nsapp, "run");

    // Each window OWNS its app IComponent and frees it in dispose(); do not double-free.
    while (_windows.count() > 0) destroyWindowStateAt(0, true);
    poolPop(pool);
    return 0;
}

// Fully release all global host + context state - for the headless self-tests, so
// --heap-audit sees no cflat residue (globals are not destructed at process exit,
// and list/dictionary clear() keeps its capacity, so each backing is moved into a
// scoped local whose destructor frees it). ObjC objects live on the objc heap (not
// cflat malloc), so closing the window is enough for the audit.
void nativeTeardownForTest()
{
    // Destroy every window (each dispose() frees its tree/app/boxes/lists + ctx), then
    // release the app-wide menu declaration + closures. The per-window boxes/lists that
    // this function used to free inline now belong to dispose(); do not free them twice.
    while (_windows.count() > 0) destroyWindowStateAt(0, true);
    _cur = 0 - 1;
    { list<unique CocoaHost*> lw = move _windows; }
    _menuBuilt = false;
    { list<string> a3 = move _menuTop; }
    { list<int>    a4 = move _menuItemTopIdx; }
    { list<string> a5 = move _menuItemLabel; }
    { list<int>    a6 = move _menuItemCmd; }
    { list<string> a7 = move _menuAccel; }
    { Lambda<void(int)> a8 = move _menuHandler; }
    { Lambda<bool()>    a9 = move _closeQuery; }
    _hasCloseQuery = false;
}
