    // A framework color (0x1RRGGBB with the marker bit, 0 = default) as an NSColor,
    // or nullptr for a default/unset color (native look).
    void* colorFor(int color)
    {
        if (color == 0) return nullptr;
        double r = (double)((color >> 16) & 0xFF) / 255.0;
        double g = (double)((color >> 8) & 0xFF) / 255.0;
        double b = (double)(color & 0xFF) / 255.0;
        return nsColor(r, g, b, 1.0);
    }

    // The cached NSFont for a FONT_* id (Text.font). FONT_TITLE is bold at ~1.3x the
    // system size; FONT_CAPTION is 2pt smaller; everything else is the default UI font.
    void* _fontFor(int fontId)
    {
        if (fontId == FONT_TITLE)
        {
            if (this.fontTitle == nullptr)
            {
                double sz = msgGetDouble(cls("NSFont"), "systemFontSize");
                // systemFontOfSize:weight: - two CGFloat args, ABI-identical to msgSize.
                this.fontTitle = msgSize(cls("NSFont"), "systemFontOfSize:weight:", sz * 1.3, 0.4);
                msg0(this.fontTitle, "retain");
            }
            return this.fontTitle;
        }
        if (fontId == FONT_CAPTION)
        {
            if (this.fontCaption == nullptr)
            {
                double sz = msgGetDouble(cls("NSFont"), "systemFontSize");
                this.fontCaption = msgSetDouble(cls("NSFont"), "systemFontOfSize:", sz - 2.0);
                msg0(this.fontCaption, "retain");
            }
            return this.fontCaption;
        }
        if (this.fontUI == nullptr)
        {
            double sz = msgGetDouble(cls("NSFont"), "systemFontSize");
            this.fontUI = msgSetDouble(cls("NSFont"), "systemFontOfSize:", sz);
            msg0(this.fontUI, "retain");
        }
        return this.fontUI;
    }

    // Resolve the CoreText line-metrics symbols once via dlsym(RTLD_DEFAULT), mirroring
    // cocoaInit()'s objc runtime lookup. Left null (silently) if unavailable.
    void _ctInit()
    {
        void* rtld = (void*)(i64)(0 - 2);
        this.ctLineCreate = (function<void*(void*)>)dlsym(rtld, "CTLineCreateWithAttributedString");
        this.ctLineBounds = (function<double(void*, double*, double*, double*)>)dlsym(rtld, "CTLineGetTypographicBounds");
        this.cfRelease    = (function<void(void*)>)dlsym(rtld, "CFRelease");
    }

    // Real glyph width (points) of `s` set in NSFont `font`, via CoreText line metrics.
    // "NSFont" is NSFontAttributeName's actual runtime string value (same trick as
    // _nsForegroundColorKey below), so a literal works as the attributes dictionary key.
    double _measuredTextWidthPt(const char* s, void* font)
    {
        if (font == nullptr) return 0.0;
        if (this.ctLineCreate == nullptr) this._ctInit();
        if (this.ctLineCreate == nullptr || this.ctLineBounds == nullptr) return 0.0;
        void* attrs = msg0(msg0(cls("NSMutableDictionary"), "alloc"), "init");
        msg2(attrs, "setObject:forKey:", font, nsStr("NSFont"));
        void* astr = msg2(msg0(cls("NSAttributedString"), "alloc"),
                           "initWithString:attributes:", nsStr((char*)s), attrs);
        void* line = this.ctLineCreate(astr);
        if (line == nullptr) return 0.0;
        double ascent = 0.0; double descent = 0.0; double leading = 0.0;
        double w = this.ctLineBounds(line, &ascent, &descent, &leading);
        if (this.cfRelease != nullptr) this.cfRelease(line);
        return w;
    }

    // Apply a Text node's font + default ink to its NSTextField. FONT_CAPTION defaults
    // to the secondary label color unless the Text carries an explicit color; an explicit
    // color always wins. Always re-applied so a font/color change on re-sync is honored.
    void _applyTextFont(u64 h, IText t)
    {
        void* ctrl = u2h(h);
        void* f = this._fontFor(t.font);
        if (f != nullptr) msg1(ctrl, "setFont:", f);
        if (colorIsSet(t.color))
            msg1(ctrl, "setTextColor:", this.colorFor(resolveColor(t.color, this.ctx.theme,
                                                                    this.ctx.systemPrefersDark())));
        else if (t.font == FONT_CAPTION)
            msg1(ctrl, "setTextColor:", msg0(cls("NSColor"), "secondaryLabelColor"));
        else
            msg1(ctrl, "setTextColor:", msg0(cls("NSColor"), "labelColor"));
    }

    // Create a layer-backed plain NSView backdrop for a container with a fill. Inserted
    // BELOW its siblings so it paints behind the card's controls (also correct for a
    // late 0->color transition). Parents like a leaf control (docv inside a ScrollView).
    u64 _createBackdrop(u64 parentHandle)
    {
        void* v = msgRect(msg0(cls("NSView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
        msgBool(v, "setWantsLayer:", true);
        void* layer = msg0(v, "layer");
        if (layer != nullptr) msgSetDouble(layer, "setCornerRadius:", 8.0);
        void* parent = u2h(parentHandle);
        if (parent == nullptr) parent = this.contentView;
        if (parent != nullptr)
        {
            // addSubview:positioned:relativeTo: with NSWindowBelow (-1) + nil sends the
            // panel to the back of the sibling order.
            function<void*(void*, void*, void*, i64, void*)> f =
                (function<void*(void*, void*, void*, i64, void*)>)__objcMsgSendPtr;
            f(parent, sel("addSubview:positioned:relativeTo:"), v, (i64)(0 - 1), nullptr);
        }
        return (u64)v;
    }

    // Re-sync a backdrop's layer fill (and the optional theme border) to the current
    // container color. Called every reconcile so a color change re-syncs naturally.
    void _syncBackdrop(u64 h, int bg)
    {
        void* v = u2h(h);
        void* layer = msg0(v, "layer");
        if (layer == nullptr) return;
        void* col = this.colorFor(bg);
        void* cg = col != nullptr ? msg0(col, "CGColor") : nullptr;
        msg1(layer, "setBackgroundColor:", cg);
        int pb = resolveColor(resolveThemeRole(this.ctx.theme, THEME_ROLE_PANEL_BORDER,
                                               this.ctx.systemPrefersDark()), this.ctx.theme,
                              this.ctx.systemPrefersDark());
        if (pb != 0)
        {
            void* bc = this.colorFor(pb);
            void* bcg = bc != nullptr ? msg0(bc, "CGColor") : nullptr;
            msg1(layer, "setBorderColor:", bcg);
            msgSetDouble(layer, "setBorderWidth:", 1.0);
        }
    }

    // Accent a push button via bezelColor (documented-API accent, look policy). A 0 bg
    // clears the accent (native look); a set bg tints the bezel + the title (fg).
    void setAccent(u64 h, int fgColor, int bgColor)
    {
        void* ctrl = u2h(h);
        if (msgBool1(ctrl, "isKindOfClass:", cls("NSButton")) == (i8)0) return;
        void* bg = this.colorFor(bgColor);
        msg1(ctrl, "setBezelColor:", bg);   // nil clears the accent
        void* fg = fgColor != 0 ? this.colorFor(fgColor) : nullptr;
        if (fg != nullptr) msg1(ctrl, "setContentTintColor:", fg);
        this._storeAccent(h, bgColor);
    }

    // Stored accent, reported by nativeAccentBg/nativeTestCustomDrawFill (the accent is
    // real via bezelColor; no offscreen pixel readback on Cocoa - same as the WinUI host).
    void _storeAccent(u64 h, int bgColor)
    {
        int i = 0;
        while (i < this.accHandles.count())
        {
            if (this.accHandles.get(i) == h)
            {
                if (bgColor == 0) { this.accHandles.removeAt(i); this.accBgs.removeAt(i); }
                else this.accBgs.set(i, (u32)bgColor);
                return;
            }
            i++;
        }
        if (bgColor != 0) { this.accHandles.add(h); this.accBgs.add((u32)bgColor); }
    }

    u32 _accentFor(u64 h)
    {
        int i = 0;
        while (i < this.accHandles.count())
        {
            if (this.accHandles.get(i) == h) { u32 v = this.accBgs.get(i); return v; }
            i++;
        }
        return 0u;
    }

    // The setListOp seam (see ui_native.cb for the cross-toolkit protocol design).
    // Columns/rowCount/selection drive an NSTableView; the tab ops an NSSegmentedControl;
    // the tree ops an NSOutlineView. The rowText / node-source boxes are stored (not
    // freed immediately) so the dataSource can query them; freed on destroy + teardown.
    void setListOp(u64 h, int op, int arg0, int arg1, const char* text, u64 payload)
    {
        void* ctrl = u2h(h);
        if (op == LISTOP_RESET_COLUMNS)
        {
            void* table = this._tableOf(h);
            void* cols = msg0(table, "tableColumns");
            i64 n = msgGetI64(cols, "count");
            while (n > (i64)0)
            {
                void* c = msgIntArg(cols, "objectAtIndex:", (i64)0);
                msg1(table, "removeTableColumn:", c);
                cols = msg0(table, "tableColumns");
                n = msgGetI64(cols, "count");
            }
        }
        else if (op == LISTOP_ADD_COLUMN)
        {
            void* table = this._tableOf(h);
            void* col = msg1(msg0(cls("NSTableColumn"), "alloc"), "initWithIdentifier:", nsStr((char*)text));
            void* header = msg0(col, "headerCell");
            msg1(header, "setStringValue:", nsStr((char*)text));
            msgInt(header, "setAlignment:", (i64)_cocoaTextAlignment((int)(i64)payload));
            // Also stamp the column's dataCell prototype: the willDisplay copy alone
            // is not reliably honored for cell-based data cells.
            msgInt(msg0(col, "dataCell"), "setAlignment:", (i64)_cocoaTextAlignment((int)(i64)payload));
            msgSetDouble(col, "setWidth:", (double)(arg0 * BASE_X));
            msg1(table, "addTableColumn:", col);
        }
        else if (op == LISTOP_SET_ROWCOUNT)
        {
            // reloadData only on a count change - it re-tiles the whole table and
            // stutters an in-flight scroll. Same-count refreshes just redisplay,
            // which re-queries the dataSource for the visible cells.
            void* table = this._tableOf(h);
            int prev = this._listRowsForTable((u64)table);
            this._setListRows(h, arg0);
            if (prev != arg0) msg0(table, "reloadData");
            else msgBool(table, "setNeedsDisplay:", true);
        }
        else if (op == LISTOP_SET_ROWTEXT_CB)
        {
            this._setListBox(h, payload);
        }
        else if (op == LISTOP_SET_ROWICON_CB)
        {
            this._setListIconBox(h, payload);
        }
        else if (op == LISTOP_SET_CELLSTYLE_CB)
        {
            this._setListStyle(h, payload);
        }
        else if (op == LISTOP_SET_SELECT_MODE)
        {
            void* table = this._tableOf(h);
            msgBool(table, "setAllowsMultipleSelection:", arg0 != 0);
        }
        else if (op == LISTOP_SET_SELECTION)
        {
            void* table = this._tableOf(h);
            this._setListSel(h, arg0);
            if (arg0 < 0) { msg0(table, "deselectAll:"); }
            else
            {
                void* idx = msgIntArg(cls("NSIndexSet"), "indexSetWithIndex:", (i64)arg0);
                function<void*(void*, void*, void*, i8)> f = (function<void*(void*, void*, void*, i8)>)__objcMsgSendPtr;
                f(table, sel("selectRowIndexes:byExtendingSelection:"), idx, (i8)0);
            }
        }
        else if (op == LISTOP_INVALIDATE)
        {
            msg0(this._tableOf(h), "reloadData");
        }
        else if (op == LISTOP_TAB_RESET)
        {
            msgInt(ctrl, "setSegmentCount:", (i64)0);
        }
        else if (op == LISTOP_TAB_ADD)
        {
            int have = (int)msgGetI64(ctrl, "segmentCount");
            if (arg0 >= have) msgInt(ctrl, "setSegmentCount:", (i64)(arg0 + 1));
            function<void*(void*, void*, void*, i64)> f = (function<void*(void*, void*, void*, i64)>)__objcMsgSendPtr;
            f(ctrl, sel("setLabel:forSegment:"), nsStr((char*)text), (i64)arg0);
        }
        else if (op == LISTOP_TAB_SET_SEL)
        {
            msgInt(ctrl, "setSelectedSegment:", (i64)arg0);
        }
        else if (op == LISTOP_TREE_SET_SRC_CB)
        {
            this._setTreeBox(h, payload);
        }
        else if (op == LISTOP_TREE_REBUILD)
        {
            msg0(this._tableOf(h), "reloadData");
        }
    }

    void _syncListColumns(u64 h, IListView lv)
    {
        int n = lv.columns.count();
        if (n <= 0) return;
        void* table = this._tableOf(h);
        // The columns must fill the clip view exactly: measure the scroll view's
        // contentSize (excludes bezel + scroller) and subtract the intercell gaps.
        function<PointD(void*, void*)> fs = (function<PointD(void*, void*)>)__objcMsgSendPtr;
        double viewport = fs(u2h(h), sel("contentSize")).x;
        double gap = fs(table, sel("intercellSpacing")).x;
        // Before the first setFrame the scroll view still has its 10pt creation
        // frame; approximate from the layout bounds until a real frame exists.
        if (viewport < 16.0) viewport = (double)(lv.nodeBounds().w * BASE_X) - 2.0;
        // NSTableView tiles to sum(colWidths) + intercellSpacing.width * n.
        viewport = viewport - gap * (double)n;
        if (viewport < 1.0) viewport = 1.0;

        double others = 0.0;
        int i = 0;
        while (i < n - 1)
        {
            int cells = 12;
            if (i < lv.colWidths.count()) cells = lv.colWidths.get(i);
            others = others + (double)(cells * BASE_X);
            i++;
        }
        int lastCells = 12;
        if (n - 1 < lv.colWidths.count()) lastCells = lv.colWidths.get(n - 1);
        double lastWidth = viewport - others;
        double minLast = (double)(lastCells * BASE_X);
        if (lastWidth < minLast) lastWidth = minLast;

        i = 0;
        while (i < n)
        {
            void* col = msgIntArg(msg0(table, "tableColumns"), "objectAtIndex:", (i64)i);
            double want = i == n - 1 ? lastWidth : (double)(
                (i < lv.colWidths.count() ? lv.colWidths.get(i) : 12) * BASE_X);
            if (msgGetDouble(col, "width") != want) msgSetDouble(col, "setWidth:", want);
            i++;
        }

        // The tiled document width includes per-column padding beyond the declared
        // gap (style-dependent). Measure the actual excess and absorb it in the
        // last column so nothing scrolls or clips horizontally.
        function<RectD(void*, void*)> fr = (function<RectD(void*, void*)>)__objcMsgSendPtr;
        double clipW = fs(u2h(h), sel("contentSize")).x;
        double excess = fr(table, sel("frame")).w - clipW;
        if (clipW >= 16.0 && excess > 0.5 && lastWidth - excess >= 24.0)
        {
            void* last = msgIntArg(msg0(table, "tableColumns"), "objectAtIndex:", (i64)(n - 1));
            msgSetDouble(last, "setWidth:", lastWidth - excess);
        }
    }

    void _syncListSort(u64 h, IListView lv)
    {
        void* table = this._tableOf(h);
        int column = lv.sortColumn;
        if (column < 0 || column >= lv.columns.count()) column = -1;
        int asc = lv.sortAscending ? 1 : 0;
        int slot = -1;
        int i = 0;
        while (i < this.listSortHandles.count())
        {
            if (this.listSortHandles.get(i) == (u64)table) { slot = i; break; }
            i++;
        }
        if (slot >= 0 && this.listSortColumns.get(slot) == column
            && this.listSortAscending.get(slot) == asc) return;

        void* image = nullptr;
        if (column >= 0)
        {
            image = msg1(cls("NSImage"), "imageNamed:",
                         nsStr(asc != 0 ? "NSAscendingSortIndicator" : "NSDescendingSortIndicator"));
        }
        void* cols = msg0(table, "tableColumns");
        i = 0;
        while (i < lv.columns.count())
        {
            void* col = msgIntArg(cols, "objectAtIndex:", (i64)i);
            msg2(table, "setIndicatorImage:inTableColumn:", i == column ? image : nullptr, col);
            i++;
        }
        void* highlighted = column >= 0 ? msgIntArg(cols, "objectAtIndex:", (i64)column) : nullptr;
        msg1(table, "setHighlightedTableColumn:", highlighted);
        if (slot < 0)
        {
            this.listSortHandles.add((u64)table);
            this.listSortColumns.add(column);
            this.listSortAscending.add(asc);
        }
        else
        {
            this.listSortColumns.set(slot, column);
            this.listSortAscending.set(slot, asc);
        }
    }

    void _freeListSort(u64 h)
    {
        void* table = this._tableOf(h);
        int i = this.listSortHandles.count() - 1;
        while (i >= 0)
        {
            if (this.listSortHandles.get(i) == (u64)table)
            {
                this.listSortHandles.removeAt(i);
                this.listSortColumns.removeAt(i);
                this.listSortAscending.removeAt(i);
            }
            i--;
        }
    }

    // Upload a top-down BGRA32 buffer to an NSImageView as an NSImage. Builds an
    // NSBitmapImageRep (it copies the bytes), wraps it in an NSImage, and sets it.
    void setImageData(u64 h, u64 pixels, int w, int h2, int stride)
    {
        if (h == 0u || pixels == 0u || w <= 0 || h2 <= 0) return;
        void* ctrl = u2h(h);
        // NSBitmapImageRep with an explicit bytesPerRow copies row-by-row from the source.
        // colorSpaceName NSDeviceRGBColorSpace; 8 bits/sample, 4 samples, hasAlpha, 32bpp.
        void* rep = nsBitmapRep((void*)pixels, (i64)w, (i64)h2, (i64)8, (i64)4,
                                (i8)1, (i8)0, nsStr("NSDeviceRGBColorSpace"), (i64)stride, (i64)32);
        if (rep == nullptr) return;
        void* img = msg0(msg0(cls("NSImage"), "alloc"), "init");
        msg1(img, "addRepresentation:", rep);
        msg1(ctrl, "setImage:", img);
    }

    // Text metrics in cells. A length-based estimate is enough: the layout pass in
    // ui.cb never calls measureText today (the winui host uses the same stub).
    Size measureText(const char* s, int fontId, int wrapWidthCells)
    {
        Size sz = default;
        int n = (int)strlen((char*)s) + 1;
        // FONT_TITLE renders ~1.3x wider than the body font; widen the estimate so a
        // title's measured width still tracks its glyphs (a 1.3x line fits the 26pt row).
        if (fontId == FONT_TITLE) n = n + n / 3;
        sz.w = n;
        sz.h = 1;
        return sz;
    }

    void requestLayout()
    {
        if (!this.ready) return;
        layoutRootBounded(this.tree, 0, 0, this.w, this.h);
        this.applyTree(this.tree, &this.ctx);
    }

    // Reconcile the IElement tree to native controls: ensure a control per mappable
    // node (create on first sight, reuse by key path), sync its props, collect its
    // Cell frame, position everything, then destroy controls that left the tree.
    void applyTree(IElement tree, IUiContext ctx)
    {
        this.applying = true;

        function<RectD(void*, void*)> ff = (function<RectD(void*, void*)>)__objcMsgSendPtr;
        RectD cvFrame = ff(this.contentView, sel("frame"));
        this.contentWPt = cvFrame.w;
        this.contentHPt = cvFrame.h;
        this.edgeWPt = cvFrame.w - (double)(this.w * BASE_X);
        this.edgeHPt = cvFrame.h - (double)(this.h * BASE_Y);
        if (this.edgeWPt < 0.0) this.edgeWPt = 0.0;
        if (this.edgeHPt < 0.0) this.edgeHPt = 0.0;
        if (this.edgeWPt > (double)(BASE_X - 1)) this.edgeWPt = (double)(BASE_X - 1);
        if (this.edgeHPt > (double)(BASE_Y - 1)) this.edgeHPt = (double)(BASE_Y - 1);
        this.fillBottomCells = this._treeHasStatusBar(tree) ? this.h - 1 : this.h;

        list<string> newKeys    = default;
        list<u64>    newHandles = default;
        list<int> fx = default; list<int> fy = default;
        list<int> fw = default; list<int> fh = default;
        list<double> extraW = default; list<double> extraH = default;

        this._applyNode(tree, keySegment(tree, 0), ctx,
                        &newKeys, &newHandles, &fx, &fy, &fw, &fh, &extraW, &extraH,
                        (u64)this.contentView, 0, 0);

        // Destroy controls whose key path is no longer in the tree.
        int i = 0;
        while (i < this.liveKeys.count())
        {
            string k = this.liveKeys.get(i);
            if (!listHasStr(&newKeys, k))
            {
                u64 h = ctx.nativeHandle(k);
                this.destroyControl(h);
                ctx.removeNativeHandle(k);
            }
            i++;
        }

        // Position all live controls (no batch API needed; AppKit coalesces the
        // relayout on the next display cycle).
        int n = newHandles.count();
        int j = 0;
        while (j < n)
        {
            int rx = fx.get(j); int ry = fy.get(j);
            int rw = fw.get(j); int rh = fh.get(j);
            Rect r = default;
            r.x = rx; r.y = ry; r.w = rw; r.h = rh;
            this.applyExtraW = extraW.get(j);
            this.applyExtraH = extraH.get(j);
            this.setFrame(newHandles.get(j), r);
            j++;
        }

        // Column widths depend on the frames just applied (contentSize is live now).
        int q = 0;
        while (q < this._pendingColSyncH.count())
        {
            this._syncListColumns(this._pendingColSyncH.get(q), this._pendingColSyncLv.get(q));
            q++;
        }
        this._pendingColSyncH.clear();
        this._pendingColSyncLv.clear();

        // Replace the live sets with COPIES (clear + add, not a move-assign, which
        // repeated per frame corrupted the heap on Win32 - avoid container move-into-field).
        this.liveKeys.clear();
        this.liveHandles.clear();
        int m = 0;
        while (m < newKeys.count())
        {
            this.liveKeys.add("" + newKeys.get(m));
            this.liveHandles.add(newHandles.get(m));
            m++;
        }
        this.applyTheme(ctx);
        this.applying = false;
    }

    bool _treeHasStatusBar(IElement n)
    {
        if (n.kind() == ELEM_STATUSBAR) return true;
        list<IElement>* kids = n.childList();
        if (kids == nullptr) return false;
        int i = 0;
        while (i < kids.count())
        {
            if (this._treeHasStatusBar(kids.get(i))) return true;
            i++;
        }
        return false;
    }

    // Recursive worker: `path` is this node's key path. Mappable nodes get a control
    // + synced props + a collected cell frame; every node recurses into its children
    // (containers contribute only geometry). `parentView` is the NSView new controls
    // parent to (a ScrollView's document view inside one); (offX, offY) is the cell
    // origin subtracted to make frames parent-relative inside a scroll container.
    void _applyNode(IElement node, string path, IUiContext ctx,
                    list<string>* keys, list<u64>* handles,
                    list<int>* fx, list<int>* fy, list<int>* fw, list<int>* fh,
                    list<double>* extraW, list<double>* extraH,
                    u64 parentView, int offX, int offY)
    {
        if (nativeMappable(node.kind()))
        {
            u64 h = ctx.nativeHandle(path);
            if (node.kind() == ELEM_POPOVER)
            {
                IPopover pp = node as IPopover;
                if (pp == nullptr || !pp.open)
                {
                    if (h != 0u) { this.destroyControl(h); ctx.removeNativeHandle(path); }
                    return;
                }
            }
            // Reparent edge: a control whose key path moved across a scroll boundary
            // now has the wrong superview - drop it so it is recreated under parentView.
            if (h != 0u && parentView != 0u && msg0(u2h(h), "superview") != u2h(parentView))
            {
                this.destroyControl(h);
                ctx.removeNativeHandle(path);
                h = 0u;
            }
            if (h == 0u)
            {
                bool password = false;
                bool indeterminate = false;
                if (node.kind() == ELEM_TEXTINPUT)
                {
                    ITextInput ti = node as ITextInput;
                    password = ti.password;
                }
                else if (node.kind() == ELEM_PROGRESS)
                {
                    IProgressBar p = node as IProgressBar;
                    indeterminate = p.indeterminate;
                }
                bool comboEditable = false;
                if (node.kind() == ELEM_COMBO) { IComboBox cb = node as IComboBox; comboEditable = cb.editable; }
                h = this.createControl(node.kind(), parentView, path, password, indeterminate, comboEditable);
                ctx.setNativeHandle(path, h);
                // One-time seed of a TextArea's buffer (uncontrolled after; the
                // native view owns the text, further pushes are explicit).
                if (node.kind() == ELEM_TEXTAREA)
                {
                    ITextArea ta = node as ITextArea;
                    this.setText(h, ta.value.data());
                }
                else if (node.kind() == ELEM_LIST)
                {
                    // One-time ListView setup: columns, select mode, and the boxed rowText
                    // source (captures the component, so it reads live state across renders).
                    IListView lv = node as IListView;
                    this.setListOp(h, LISTOP_RESET_COLUMNS, 0, 0, "", 0u);
                    int ci = 0;
                    while (ci < lv.columns.count())
                    {
                        int wCells = 12;
                        if (ci < lv.colWidths.count()) wCells = lv.colWidths.get(ci);
                        int colAlign = 0;
                        if (ci < lv.colAligns.count()) colAlign = lv.colAligns.get(ci);
                        this.setListOp(h, LISTOP_ADD_COLUMN, wCells, ci, lv.columns.get(ci).data(),
                                       (u64)(i64)colAlign);
                        ci++;
                    }
                    this.setListOp(h, LISTOP_SET_SELECT_MODE, lv.multiSelect ? 1 : 0, 0, "", 0u);
                    this.setListOp(h, LISTOP_SET_ROWTEXT_CB, 0, 0, "", (u64)_boxListRow(lv.rowText));
                    this.setListOp(h, LISTOP_SET_ROWICON_CB, 0, 0, "", (u64)_boxListIcon(lv.rowIcon));
                    this.setListOp(h, LISTOP_SET_CELLSTYLE_CB, 0, 0, "", (u64)_boxListStyle(lv.cellStyle));
                }
                else if (node.kind() == ELEM_TREE)
                {
                    // One-time TreeView setup: box the node-source callbacks + build the root.
                    ITreeView tv = node as ITreeView;
                    this.setListOp(h, LISTOP_TREE_SET_SRC_CB, 0, 0, "",
                                   (u64)_boxTree(tv.childCount, tv.childId, tv.label));
                    this.setListOp(h, LISTOP_TREE_REBUILD, 0, 0, "", 0u);
                }
                else if (node.kind() == ELEM_CANVAS)
                {
                    // One-time CanvasView setup: box the onPaint closure so CfCanvasView's
                    // drawRect: (which resolves the view handle -> box) can invoke it.
                    ICanvasView cvw = node as ICanvasView;
                    this._setCanvasBox(h, (u64)_boxCanvas(cvw.onPaint));
                }
            }
            this._syncProps(node, h);
            // Live right-click menu: attach the NSMenu registered for this path or the
            // nearest ancestor (flat sibling views overlap, so descendants need it too).
            u64 cm = this._ctxMenuForPathOrAncestor(path);
            if (cm != 0u && msg0(u2h(h), "menu") == nullptr) this._attachContextMenu(h, cm);
            string tip = tooltipOf(node);
            if (tip.length() > 0) msg1(u2h(h), "setToolTip:", nsStr(tip.data()));
            Rect b = node.nodeBounds();
            if (node.kind() == ELEM_TABS)
            {
                // The NSSegmentedControl is only the tab strip; frame it at the top header
                // rows (TabControl.layout reserves hdr=2). Full-height framing stretched the
                // segments across the whole card so the active pane overlapped the strip.
                b.h = 2;
            }
            if (node.kind() == ELEM_TEXT)
            {
                // Widen the frame (not the layout node) to the REAL measured glyph width
                // when it exceeds the layout estimate, so no font/text combo ever clips.
                IText t = node as IText;
                double measured = this._measuredTextWidthPt(t.text.data(), this._fontFor(t.font));
                double needPts = measured + 2.0;
                double layoutPts = (double)(b.w * BASE_X);
                if (needPts > layoutPts)
                    b.w = b.w + (int)((needPts - layoutPts) / (double)BASE_X) + 1;
            }
            keys.add("" + path);
            handles.add(h);
            if (node.kind() == ELEM_STATUSBAR)
            {
                fx.add(0); fy.add(0); fw.add(-1); fh.add(b.h);
                extraW.add(0.0); extraH.add(0.0);
            }
            else
            {
                bool fill = _fillKind(node.kind());
                double ew = fill && b.x + b.w == this.w ? this.edgeWPt : 0.0;
                double eh = fill && b.y + b.h == this.fillBottomCells ? this.edgeHPt : 0.0;
                // Parent-relative frame: absolute cell frame minus the enclosing scroll origin.
                fx.add(b.x - offX); fy.add(b.y - offY); fw.add(b.w); fh.add(b.h);
                extraW.add(ew); extraH.add(eh);
            }
        }
        else if (_containerBg(node, ctx.theme, ctx.systemPrefersDark()) != 0)
        {
            // A plain container with a fill gets a painted backdrop panel (keyed by the
            // container's path) behind its children; it recurses into children below like
            // any container, and rides the same create/reuse/destroy/reposition reconcile.
            int bg = _containerBg(node, ctx.theme, ctx.systemPrefersDark());
            u64 h = ctx.nativeHandle(path);
            if (h != 0u && parentView != 0u && msg0(u2h(h), "superview") != u2h(parentView))
            {
                this.destroyControl(h);
                ctx.removeNativeHandle(path);
                h = 0u;
            }
            if (h == 0u)
            {
                h = this._createBackdrop(parentView);
                ctx.setNativeHandle(path, h);
            }
            this._syncBackdrop(h, bg);
            Rect b = node.nodeBounds();
            keys.add("" + path);
            handles.add(h);
            double ew = b.x + b.w == this.w ? this.edgeWPt : 0.0;
            bool reachesBottom = b.y + b.h == this.h || b.y + b.h == this.fillBottomCells;
            double eh = reachesBottom ? this.edgeHPt : 0.0;
            fx.add(b.x - offX); fy.add(b.y - offY); fw.add(b.w); fh.add(b.h);
            extraW.add(ew); extraH.add(eh);
        }

        // A TabControl walks ONLY its active pane into native controls (lazy inactive
        // tabs), mirroring the Win32 host.
        if (node.kind() == ELEM_TABS)
        {
            ITabControl tc = node as ITabControl;
            list<IElement>* panes = node.childList();
            int sel = tc.selectedTab;
            if (panes != nullptr && sel >= 0 && sel < panes.count())
            {
                IElement pane = panes.get(sel);
                string cp = joinKeyPath(path, keySegment(pane, sel));
                this._applyNode(pane, cp, ctx, keys, handles, fx, fy, fw, fh,
                                extraW, extraH, parentView, offX, offY);
            }
            return;
        }
        if (node.kind() == ELEM_EXPANDER)
        {
            IExpander ex = node as IExpander;
            if (!ex.expanded) return;
            list<IElement>* kids = node.childList();
            if (kids != nullptr)
            {
                int i = 0;
                while (i < kids.count())
                {
                    IElement c = kids.get(i);
                    this._applyNode(c, joinKeyPath(path, keySegment(c, i)), ctx, keys, handles,
                                    fx, fy, fw, fh, extraW, extraH, parentView, offX, offY);
                    i++;
                }
            }
            return;
        }

        // A ScrollView's children parent to its FLIPPED document view and are offset
        // by the scroll node's own origin (document-relative). After the walk the
        // document view is sized to hold the framework-computed content height.
        if (node.kind() == ELEM_SCROLL)
        {
            void* scroll = u2h(ctx.nativeHandle(path));
            void* docv = msg0(scroll, "documentView");
            Rect sb = node.nodeBounds();
            list<IElement>* skids = node.childList();
            if (skids != nullptr)
            {
                int i = 0;
                while (i < skids.count())
                {
                    IElement c = skids.get(i);
                    string cp = joinKeyPath(path, keySegment(c, i));
                    this._applyNode(c, cp, ctx, keys, handles, fx, fy, fw, fh,
                                    extraW, extraH, (u64)docv, sb.x, sb.y);
                    i++;
                }
            }
            IScrollView svn = node as IScrollView;
            int chDip = 0;
            if (svn != nullptr) chDip = svn.contentH;
            double docW = (double)(sb.w * BASE_X) - SCROLLER_ALLOW;
            if (docW < 1.0) docW = 1.0;
            double docH = (double)(chDip * BASE_Y);
            double vpH = (double)(sb.h * BASE_Y);
            if (docH < vpH) docH = vpH;   // never shorter than the viewport
            msgRect(docv, "setFrame:", 0.0, 0.0, docW, docH);
            return;
        }

        if (node.kind() == ELEM_GRIDVIEW)
        {
            IGridView gv = node as IGridView;
            Rect gb = node.nodeBounds();
            int i = 0;
            while (i < gv.realizedCount())
            {
                IElement cell = gv.getRealized(i);
                Rect cb = cell.nodeBounds();
                Rect visible = intersectRect(gb, cb);
                // Overscan keeps native controls bounded, at the cost of edge churn.
                if (visible.w > 0 && visible.h > 0)
                {
                    string cp = joinKeyPath(path, keySegment(cell, i));
                    this._applyNode(cell, cp, ctx, keys, handles, fx, fy, fw, fh,
                                    extraW, extraH, parentView, offX, offY);
                }
                i++;
            }
            return;
        }

        list<IElement>* kids = node.childList();
        if (kids != nullptr)
        {
            int i = 0;
            while (i < kids.count())
            {
                IElement c = kids.get(i);
                string cp = joinKeyPath(path, keySegment(c, i));
                this._applyNode(c, cp, ctx, keys, handles, fx, fy, fw, fh,
                                extraW, extraH, parentView, offX, offY);
                i++;
            }
        }
    }

    // Push a node's current props onto its control (one interface downcast per kind -
    // the same structured access the reconciler uses in propsEqual).
    void _syncProps(IElement node, u64 h)
    {
        int k = node.kind();
        if (k == ELEM_BUTTON)
        {
            IButton b = node as IButton;
            this.setText(h, b.title.data());
            this.setBoolProp(h, PROP_ENABLED, !b.disabled);
            this._syncButtonAccent(h, b);
        }
        else if (k == ELEM_TEXT)
        {
            IText t = node as IText;
            this.setText(h, t.text.data());
            this._applyTextFont(h, t);
        }
        else if (k == ELEM_TEXTINPUT)
        {
            ITextInput ti = node as ITextInput;
            this.setText(h, ti.value.data());
            msg1(u2h(h), "setPlaceholderString:", nsStr(ti.placeholder.data()));
            this.setBoolProp(h, PROP_ENABLED, !ti.disabled);
        }
        else if (k == ELEM_CHECKBOX)
        {
            ICheckbox c = node as ICheckbox;
            this.setText(h, c.label.data());
            this.setBoolProp(h, PROP_CHECKED, c.checked);
            this.setBoolProp(h, PROP_ENABLED, !c.disabled);
        }
        else if (k == ELEM_PROGRESS)
        {
            IProgressBar p = node as IProgressBar;
            this.setIntProp(h, PROP_MAX, 100);
            this.setIntProp(h, PROP_VALUE, p.value);
            this.setBoolProp(h, PROP_INDETERMINATE, p.indeterminate);
        }
        else if (k == ELEM_SLIDER)
        {
            ISlider s = node as ISlider;
            this.setIntProp(h, PROP_MAX, 100);
            this.setIntProp(h, PROP_VALUE, s.value);
            this.setBoolProp(h, PROP_ENABLED, !s.disabled);
        }
        else if (k == ELEM_SPINNER)
        {
            ISpinner s = node as ISpinner; void* kids = msg0(u2h(h), "subviews");
            if (kids != nullptr)
            {
                void* field = msgInt(kids, "objectAtIndex:", 0); void* stepper = msgInt(kids, "objectAtIndex:", 1);
                msg1(field, "setStringValue:", nsStr(s.value.toString().data()));
                msgSetDouble(stepper, "setMinValue:", (double)s.minValue); msgSetDouble(stepper, "setMaxValue:", (double)s.maxValue);
                msgSetDouble(stepper, "setIncrement:", (double)(s.step < 1 ? 1 : s.step)); msgSetDouble(stepper, "setDoubleValue:", (double)s.value);
                msgBool(field, "setEnabled:", !s.disabled); msgBool(stepper, "setEnabled:", !s.disabled);
            }
        }
        else if (k == ELEM_LINK)
        {
            ILink l = node as ILink; this._setLinkTitle(u2h(h), l.text); this.setBoolProp(h, PROP_ENABLED, !l.disabled);
        }
        else if (k == ELEM_TOOLBAR)
        {
            IToolBar t = node as IToolBar; this._syncToolbar(h, t);
        }
        else if (k == ELEM_TEXTAREA)
        {
            // Uncontrolled: never push text here (would clobber the buffer mid-edit);
            // only sync enabled. Text is seeded once at creation and pushed
            // explicitly via nativeSetControlText (file open).
            ITextArea ta = node as ITextArea;
            this.setBoolProp(h, PROP_ENABLED, !ta.disabled);
        }
        else if (k == ELEM_RICHTEXT)
        {
            IRichText rt = node as IRichText;
            this._syncRichText(h, rt); this.setBoolProp(h, PROP_ENABLED, !rt.disabled);
        }
        else if (k == ELEM_WEBVIEW)
        {
            this._syncWebView(h, node as IWebView);
        }
        else if (k == ELEM_STATUSBAR)
        {
            IStatusBar sb = node as IStatusBar;
            string joined = "";
            int i = 0;
            while (i < sb.parts.count())
            {
                if (i > 0) joined = joined + "   ";
                joined = joined + sb.parts.get(i);
                i++;
            }
            this.setText(h, joined.data());
        }
        else if (k == ELEM_RADIO)
        {
            IRadioButton rb = node as IRadioButton;
            this.setText(h, rb.label.data());
            this.setBoolProp(h, PROP_CHECKED, rb.checked);
            this.setBoolProp(h, PROP_ENABLED, !rb.disabled);
        }
        else if (k == ELEM_COMBO)
        {
            IComboBox cb = node as IComboBox;
            this._syncCombo(h, cb);
            this.setBoolProp(h, PROP_ENABLED, !cb.disabled);
        }
        else if (k == ELEM_TOGGLE)
        {
            IToggleSwitch ts = node as IToggleSwitch;
            void* kids = msg0(u2h(h), "subviews");
            if (kids != nullptr)
            {
                void* sw = msgInt(kids, "objectAtIndex:", 0); void* label = msgInt(kids, "objectAtIndex:", 1);
                msgInt(sw, "setState:", ts.on ? 1 : 0); msg1(label, "setStringValue:", nsStr(ts.label.data()));
                msgBool(sw, "setEnabled:", !ts.disabled); msgBool(label, "setEnabled:", !ts.disabled);
            }
        }
        else if (k == ELEM_SEGMENTED)
        {
            ISegmented sg = node as ISegmented; void* ctrl = u2h(h);
            int have = (int)msgGetI64(ctrl, "segmentCount");
            if (have != sg.labels.count())
            {
                msgInt(ctrl, "setSegmentCount:", (i64)sg.labels.count());
                function<void*(void*, void*, void*, i64)> f = (function<void*(void*, void*, void*, i64)>)__objcMsgSendPtr;
                int i = 0; while (i < sg.labels.count()) { f(ctrl, sel("setLabel:forSegment:"), nsStr(sg.labels.get(i).data()), (i64)i); i++; }
            }
            msgInt(ctrl, "setSelectedSegment:", (i64)sg.selected); msgBool(ctrl, "setEnabled:", !sg.disabled);
        }
        else if (k == ELEM_DATEPICKER)
        {
            IDatePicker dp = node as IDatePicker;
            void* comps = msg0(msg0(cls("NSDateComponents"), "alloc"), "init");
            msgInt(comps, "setYear:", (i64)dp.year); msgInt(comps, "setMonth:", (i64)dp.month); msgInt(comps, "setDay:", (i64)dp.day);
            void* cal = msg0(cls("NSCalendar"), "currentCalendar");
            msg1(u2h(h), "setDateValue:", msg1(cal, "dateFromComponents:", comps));
            msgBool(u2h(h), "setEnabled:", !dp.disabled);
        }
        else if (k == ELEM_EXPANDER)
        {
            IExpander ex = node as IExpander;
            string prefix = ex.expanded ? "v " : "> ";
            string title = prefix + ex.title;
            msg1(u2h(h), "setTitle:", nsStr(title.data()));
            msgInt(u2h(h), "setState:", ex.expanded ? 1 : 0); msgBool(u2h(h), "setEnabled:", !ex.disabled);
        }
        else if (k == ELEM_COLORWELL)
        {
            IColorWell cw = node as IColorWell;
            int raw = colorRaw(cw.value);
            if (msgBool1(u2h(h), "isHiddenOrHasHiddenAncestor", nullptr) == (i8)0)
                msg1(u2h(h), "setColor:", nsColor((double)((raw >> 16) & 0xFF) / 255.0,
                                                     (double)((raw >> 8) & 0xFF) / 255.0,
                                                     (double)(raw & 0xFF) / 255.0, 1.0));
            msgBool(u2h(h), "setEnabled:", !cw.disabled);
        }
        else if (k == ELEM_INFOBAR)
        {
            this._syncInfoBar(h, node as IInfoBar);
        }
        else if (k == ELEM_POPOVER)
        {
            this._syncPopover(h, node as IPopover);
        }
        else if (k == ELEM_LIST)
        {
            // Virtualized: push row count + controlled selection, then reload. Cell text
            // is pulled on demand via the boxed rowText (the table's dataSource).
            IListView lv = node as IListView;
            this.setListOp(h, LISTOP_SET_ROWCOUNT, lv.rowCount, 0, "", 0u);
            this.setListOp(h, LISTOP_SET_ROWICON_CB, 0, 0, "", (u64)_boxListIcon(lv.rowIcon));
            this.setListOp(h, LISTOP_SET_CELLSTYLE_CB, 0, 0, "", (u64)_boxListStyle(lv.cellStyle));
            this.setListOp(h, LISTOP_SET_SELECTION, lv.selectedIndex, 0, "", 0u);
            this._pendingColSyncH.add(h);
            this._pendingColSyncLv.add(lv);
            this._syncListSort(h, lv);
            this.setBoolProp(h, PROP_ENABLED, !lv.disabled);
        }
        else if (k == ELEM_TABS)
        {
            ITabControl tc = node as ITabControl;
            this._syncTabs(h, tc);
        }
        else if (k == ELEM_TREE)
        {
            // Expand-on-demand: the outline owns its tree state (built once at creation);
            // only the enabled flag is synced (selection round-trips through the delegate).
            ITreeView tv = node as ITreeView;
            this.setBoolProp(h, PROP_ENABLED, !tv.disabled);
        }
        else if (k == ELEM_IMAGE)
        {
            // Upload once per distinct pixel buffer (a re-render with the same pointer is
            // a no-op); the toolkit-neutral setImageData seam builds the NSImage.
            IImage im = node as IImage;
            if (im.pixels != 0u && im.pixels != this._imgLastPixels(h))
            {
                this.setImageData(h, im.pixels, im.pxW, im.pxH, im.pxW * 4);
                this._setImgLastPixels(h, im.pixels);
            }
        }
        else if (k == ELEM_GROUPBOX)
        {
            IGroupBox g = node as IGroupBox;
            msg1(u2h(h), "setTitle:", nsStr(g.title.data()));
        }
        else if (k == ELEM_CANVAS)
        {
            // The paint closure was boxed at creation; mark the view dirty so state
            // changes redraw (drawRect: re-invokes onPaint through the CG-backed ICanvas).
            msgBool(u2h(h), "setNeedsDisplay:", true);
        }
    }

    // Accent-fill for a themed button: the same buttonBg/buttonText the
    // Win32 host feeds NM_CUSTOMDRAW is applied here through bezelColor (look policy).
    void _syncButtonAccent(u64 h, IButton b)
    {
        int abg = pickColor(b.backgroundColor, colorRole(THEME_ROLE_BUTTON_BG), this.ctx.theme, this.ctx.systemPrefersDark());
        int afg = pickColor(b.color, colorRole(THEME_ROLE_BUTTON_TEXT), this.ctx.theme, this.ctx.systemPrefersDark());
        this.setAccent(h, afg, abg);
    }

    // Repopulate an NSPopUpButton only when its item set changed, then set the
    // controlled selection (refilling every frame would reset the popup mid-interaction).
    void _syncCombo(u64 h, IComboBox cb)
    {
        void* ctrl = u2h(h);
        bool editable = msgBool1(ctrl, "isKindOfClass:", cls("NSComboBox")) != (i8)0;
        int have = (int)msgGetI64(ctrl, "numberOfItems");
        if (have != cb.items.count())
        {
            msg0(ctrl, "removeAllItems");
            int i = 0;
            while (i < cb.items.count())
            {
                if (editable) msg1(ctrl, "addItemWithObjectValue:", nsStr(cb.items.get(i).data()));
                else msg1(ctrl, "addItemWithTitle:", nsStr(cb.items.get(i).data()));
                i++;
            }
        }
        int cur = (int)msgGetI64(ctrl, "indexOfSelectedItem");
        if (cur != cb.selectedIndex) msgInt(ctrl, "selectItemAtIndex:", (i64)cb.selectedIndex);
        if (editable) msg1(ctrl, "setStringValue:", nsStr(cb.text.data()));
    }

    // Rebuild the segmented tab strip on a pane-count change, then set the selection.
    void _syncTabs(u64 h, ITabControl tc)
    {
        void* ctrl = u2h(h);
        int have = (int)msgGetI64(ctrl, "segmentCount");
        if (have != tc.children.count())
        {
            this.setListOp(h, LISTOP_TAB_RESET, 0, 0, "", 0u);
            int i = 0;
            while (i < tc.children.count())
            {
                string t = tc._title(i);
                this.setListOp(h, LISTOP_TAB_ADD, i, 0, t.data(), 0u);
                i++;
            }
        }
        this.setListOp(h, LISTOP_TAB_SET_SEL, tc.selectedTab, 0, "", 0u);
    }

    // The key path bound to a control this frame, or "" if none (linear scan of the
    // small live set - controls per window are few).
    string keyForHandle(u64 h)
    {
        int i = 0;
        while (i < this.liveHandles.count())
        {
            if (this.liveHandles.get(i) == h) return "" + this.liveKeys.get(i);
            i++;
        }
        return "";
    }

    // Apply the app's Theme to the window chrome: dark vs aqua appearance. Called
    // every frame from applyTree; cheap and idempotent. Control accent colors are
    // left at the OS default (setAccent is a no-op), matching the Win32 host's
    // monochrome-default behavior.
    void applyTheme(IUiContext ctx)
    {
        bool isDark = themeIsDark(&ctx.theme, ctx.systemPrefersDark());
        this.dark = isDark;
        if (this.window != nullptr)
        {
            void* apName = isDark ? nsStr("NSAppearanceNameDarkAqua") : nsStr("NSAppearanceNameAqua");
            void* ap = msg1(cls("NSAppearance"), "appearanceNamed:", apName);
            msg1(this.window, "setAppearance:", ap);
        }
    }

    // Free this window's owned cflat + objc state (tree, component, boxes, lists) and
    // release the NSWindow. `sendClose` is false when called from windowWillClose:
    // (AppKit is already closing the window). Nil the delegate BEFORE close so -close
    // does not re-enter windowWillClose: and recurse into destroyWindowStateAt.
    void dispose(bool sendClose)
    {
        int ti0 = 0;
        while (ti0 < this.timerHandles.count())
        {
            void* timer = u2h(this.timerObjects.get(ti0));
            if (timer != nullptr) msg0(timer, "invalidate");
            __uiFreeTimerBox(this.timerBoxes.get(ti0));
            ti0++;
        }
        this.timerHandles.clear(); this.timerBoxes.clear(); this.timerObjects.clear();
        int wi = 0;
        while (wi < this.liveHandles.count())
        {
            void* ctrl = u2h(this.liveHandles.get(wi));
            if (msgBool1(ctrl, "isKindOfClass:", cls("WKWebView")) != (i8)0)
            {
                msg0(ctrl, "stopLoading"); msg1(ctrl, "setNavigationDelegate:", nullptr);
                msg0(ctrl, "removeFromSuperview"); msg0(ctrl, "release");
            }
            wi++;
        }
        if (this.ready) { IElement t = this.tree; deleteTree(t); this.ready = false; }
        if (this.app != nullptr) { IComponent a = this.app; this.app = nullptr; delete a; }
        // Free the host-owned boxes (the destroyControl path does not run for a window
        // closing wholesale). The parallel lists + ctx.nativeByKey are value fields freed
        // automatically when `delete owned` runs this window's destructor.
        { int i = 0; while (i < this.listBoxPtrs.count()) { u64 b = this.listBoxPtrs.get(i); if (b != 0u) __uiFreeListRowBox(b); i++; } }
        { int i = 0; while (i < this.listIconPtrs.count()) { u64 b = this.listIconPtrs.get(i); if (b != 0u) __uiFreeListIconBox(b); i++; } }
        { int i = 0; while (i < this.listIconCacheImgs.count()) { u64 img = this.listIconCacheImgs.get(i); if (img != 0u) msg0(u2h(img), "release"); i++; } }
        { int i = 0; while (i < this.listStylePtrs.count()) { u64 b = this.listStylePtrs.get(i); if (b != 0u) __uiFreeListStyleBox(b); i++; } }
        { int i = 0; while (i < this.treeBoxPtrs.count()) { u64 b = this.treeBoxPtrs.get(i); if (b != 0u) __uiFreeTreeBox(b); i++; } }
        { int i = 0; while (i < this.canvasBoxes.count()) { u64 b = this.canvasBoxes.get(i); if (b != 0u) __uiFreeCanvasBox(b); i++; } }
        { int i = 0; while (i < this.ctxMenus.count()) { u64 b = this.ctxMenus.get(i); if (b != 0u) __uiFreeContextMenu(b); i++; } }
        { int i = 0; while (i < this.popoverObjects.count()) { u64 p = this.popoverObjects.get(i); if (p != 0u) { msg0(u2h(p), "close"); msg0(u2h(p), "release"); } i++; } }
        this.listBoxHandles.clear(); this.listBoxPtrs.clear();
        this.listIconHandles.clear(); this.listIconPtrs.clear();
        this.listIconCacheH.clear(); this.listIconCacheIds.clear();
        this.listIconCachePixels.clear(); this.listIconCacheImgs.clear();
        this.listIconCacheRevisions.clear(); this.listIconCacheW.clear(); this.listIconCacheH2.clear();
        this.listStyleHandles.clear(); this.listStylePtrs.clear();
        this.treeBoxHandles.clear(); this.treeBoxPtrs.clear();
        this.canvasHandles.clear();  this.canvasBoxes.clear();
        this.ctxKeys.clear();        this.ctxMenus.clear();
        this.popoverHandles.clear(); this.popoverObjects.clear(); this.popoverKeys.clear();
        if (this.window != nullptr)
        {
            msg1(this.window, "setDelegate:", nullptr);   // do not re-enter windowWillClose:
            if (sendClose) msg0(this.window, "close");
            msg0(this.window, "release");                 // setReleasedWhenClosed: was false
            this.window = nullptr;
        }
        if (this.target != nullptr)
        {
            void* center = msg0(cls("NSDistributedNotificationCenter"), "defaultCenter");
            msg1(center, "removeObserver:", this.target);
            msg0(this.target, "release");
            this.target = nullptr;
        }
        if (this.fontUI != nullptr)      { msg0(this.fontUI, "release");      this.fontUI = nullptr; }
        if (this.fontTitle != nullptr)   { msg0(this.fontTitle, "release");   this.fontTitle = nullptr; }
        if (this.fontCaption != nullptr) { msg0(this.fontCaption, "release"); this.fontCaption = nullptr; }
        this.contentView = nullptr;
    }
};

// -- App-wide window registry + the "current" window --------------------------
// The list OWNS the windows; app code reaches the servicing one by index (_cur). We
// never bind a CocoaHost* to a long-lived variable (an owning class pointer auto-frees
// at scope exit and cannot be re-aliased), so curWin() returns a borrow via `alias`.
// _windows.add(fresh) MOVES ownership in; _windows.removeAt(idx) frees the element.
list<unique CocoaHost*> _windows = default;
int              _cur     = 0 - 1;   // index into _windows of the servicing window

alias CocoaHost* curWin() { return _windows.get(_cur); }
bool hasCurWin() { return _cur >= 0 && _cur < _windows.count(); }

// Index of the window owning `nsWindow` / `target`, or -1 (small list; scanned per event).
// A nil probe never matches: createAppWindow registers the entry before the NSWindow
// exists, so a nil keyWindow / detached view must not resolve to that half-built window.
int findWindowIdx(void* nsWindow)
{
    if (nsWindow == nullptr) return 0 - 1;
    int i = 0;
    while (i < _windows.count()) { if (_windows.get(i).window == nsWindow) return i; i++; }
    return 0 - 1;
}

int findWindowIdxByTarget(void* target)
{
    if (target == nullptr) return 0 - 1;
    int i = 0;
    while (i < _windows.count()) { if (_windows.get(i).target == target) return i; i++; }
    return 0 - 1;
}

// Point _cur at the window resolved from an NSView / NSWindow / CfHostTarget. Return
// false (leaving _cur untouched) if the object does not belong to a registered window.
bool _setCurFromView(void* v)
{
    void* w = msg0(v, "window");
    int i = findWindowIdx(w);
    if (i >= 0) { _cur = i; return true; }
    return false;
}

bool _setCurFromWindow(void* w)
{
    int i = findWindowIdx(w);
    if (i >= 0) { _cur = i; return true; }
    return false;
}

bool _setCurFromTarget(void* s)
{
    int i = findWindowIdxByTarget(s);
    if (i >= 0) { _cur = i; return true; }
    return false;
}

// Tear down the window at `idx`: free its state, drop it from the registry, delete it.
// `sendClose` is false when AppKit is already closing the window (windowWillClose:).
void destroyWindowStateAt(int idx, bool sendClose)
{
    if (idx < 0 || idx >= _windows.count()) return;
    _cur = idx;
    curWin().dispose(sendClose);
    _windows.removeAt(idx);   // the list owns its `unique` elements; this frees the host
    _cur = _windows.count() > 0 ? 0 : (0 - 1);
}

// A Theme is "dark" when its panel background is darker than mid-gray. A default
// (monochrome, all-zero) theme is treated as light.
bool themeIsDark(Theme* t, bool systemDark)
{
    int c = resolveColor(resolveThemeRole(*t, THEME_ROLE_PANEL_BG, systemDark), *t, systemDark);
    if (c == 0) return false;
    int r = (c >> 16) & 0xFF; int g = (c >> 8) & 0xFF; int b = c & 0xFF;
    return (r + g + b) < 384;
}

// -- CanvasView bridge: a CoreGraphics-backed ICanvas -----------------------------
// CocoaCanvas implements the ui.cb ICanvas interface using AppKit drawing primitives
// (NSBezierPath fill/stroke, NSString drawAtPoint - both CoreGraphics-backed), so the
// app's onPaint(ICanvas) closure paints into a CfCanvasView's drawRect:. Cell coords map
// to points via BASE_X/BASE_Y (like the Win32 NativeGdiCanvas). The view is flipped, so
// row 0 is at the top, matching the framework's top-left convention.
class CocoaCanvas : ICanvas
{
    void clear() { }   // drawRect: already erased to the view background

    void drawText(int col, int row, const char* s, int color)
    {
        void* str = nsStr((char*)s);
        void* attrs = msg0(msg0(cls("NSMutableDictionary"), "alloc"), "init");
        void* col2 = _nsColorFromFramework(color);
        if (col2 != nullptr) msg2(attrs, "setObject:forKey:", col2, _nsForegroundColorKey());
        function<void(void*, void*, double, double, void*)> f =
            (function<void(void*, void*, double, double, void*)>)__objcMsgSendPtr;
        f(str, sel("drawAtPoint:withAttributes:"), (double)(col * BASE_X), (double)(row * BASE_Y), attrs);
    }

    void drawRect(Rect r, bool filled, int color)
    {
        function<void*(void*, void*, double, double, double, double)> mk =
            (function<void*(void*, void*, double, double, double, double)>)__objcMsgSendPtr;
        void* path = mk(cls("NSBezierPath"), sel("bezierPathWithRect:"),
                        (double)(r.x * BASE_X), (double)(r.y * BASE_Y),
                        (double)(r.w * BASE_X), (double)(r.h * BASE_Y));
        void* col2 = _nsColorFromFramework(color);
        if (col2 != nullptr) msg0(col2, "set");
        if (filled) msg0(path, "fill"); else msg0(path, "stroke");
    }

    // Blit a canvas image (an NSImage* handle from canvasCreateImage) into a POINTS rect.
    // drawInRect:...:respectFlipped:YES makes AppKit draw the image UPRIGHT in this flipped
    // view (CG y-up vs the flipped y-down view is handled by AppKit), matching the
    // NSBezierPath/NSString primitives above. Called during CfCanvasView.drawRect:, so this
    // view is the focused graphics context. Source NSZeroRect = the whole image; op 2 =
    // NSCompositingOperationSourceOver; fraction 1.0 = opaque.
    void drawImage(u64 img, double dx, double dy, double dw, double dh)
    {
        if (img == 0u) return;
        function<void(void*, void*, double, double, double, double,
                      double, double, double, double, i64, double, i8, void*)> f =
            (function<void(void*, void*, double, double, double, double,
                           double, double, double, double, i64, double, i8, void*)>)__objcMsgSendPtr;
        f((void*)img, sel("drawInRect:fromRect:operation:fraction:respectFlipped:hints:"),
          dx, dy, dw, dh, 0.0, 0.0, 0.0, 0.0, (i64)2, 1.0, (i8)1, nullptr);
    }

    void pushClip(Rect r) { }   // per-region clipping not bridged (best-effort)
    void popClip() { }
};

// -- Canvas image handles (M2): NSImage wrappers over a copied BGRA buffer --------
// canvasCreateImage builds an NSBitmapImageRep (which COPIES the bytes, so the caller may
// free its buffer immediately), wraps it in a retained NSImage, and returns the NSImage*
// as a u64. This is fully separate from the Image ELEMENT's setImageData path (that sets a
// control's image; these are paint-time objects drawn via CocoaCanvas.drawImage). Distinct
// from the autoreleased nsStr/nsColor helpers, the NSImage is alloc/init (+1 retained) so
// it survives autorelease-pool drains between create and draw; canvasReleaseImage releases
// it. The alloc'd rep is released after addRepresentation: (the image retains it).
u64 canvasCreateImage(u64 bgraPixels, int w, int h)
{
    if (bgraPixels == 0u || w <= 0 || h <= 0) return 0u;
    if (!cocoaInit()) return 0u;
    void* rep = nsBitmapRep((void*)bgraPixels, (i64)w, (i64)h, (i64)8, (i64)4,
                            (i8)1, (i8)0, nsStr("NSDeviceRGBColorSpace"), (i64)(w * 4), (i64)32);
    if (rep == nullptr) return 0u;
    void* img = msg0(msg0(cls("NSImage"), "alloc"), "init");
    msg1(img, "addRepresentation:", rep);
    msg0(rep, "release");   // the NSImage now owns the rep
    return (u64)img;
}

void canvasReleaseImage(u64 img)
{
    if (img == 0u) return;
    msg0((void*)img, "release");
}

// The NSAttributedString foreground-color attribute key (a global NSString symbol);
// resolved via a small class method wrapper is overkill, so a literal name is used.
void* _nsForegroundColorKey() { return nsStr("NSColor"); }

// A framework color (0x1RRGGBB with the marker bit; 0 = default) as an NSColor, or a
// mid-gray fallback for a default color.
void* _nsColorFromFramework(int color)
{
    if (color == 0) return nsColor(0.2, 0.2, 0.2, 1.0);
    double r = (double)((color >> 16) & 0xFF) / 255.0;
    double g = (double)((color >> 8) & 0xFF) / 255.0;
    double b = (double)(color & 0xFF) / 255.0;
    return nsColor(r, g, b, 1.0);
}

// CfCanvasView.drawRect: - resolve the view's boxed onPaint and invoke it with a
// CocoaCanvas. NSRect arrives as 4 doubles (d0-d3) which we ignore (we paint the full
// content each time). isFlipped -> YES so row 0 is at the top.
void _canvasDrawRectImp(void* self, void* cmd, double x, double y, double w, double h)
{
    if (!_setCurFromView(self)) return;
    u64 box = curWin()._canvasBoxFor((u64)self);
    if (box == 0u) return;
    CocoaCanvas cv = default;
    __uiCanvasPaint(box, cv);
}

i8 _canvasIsFlippedImp(void* self, void* cmd) { return (i8)1; }

// -- CfCanvasView input IMPs (M1): mouse / wheel / pinch -> element handlers -------
// These fire during the run loop while the tree is stable, so they resolve the live
// CanvasView element per event (like _onListClickImp routes list clicks) rather than a
// boxed clone - the paint callback is boxed instead because drawRect: fires on OS-driven
// repaints outside the event pump. Every handler defaults to a no-op, so a canvas without
// handlers is safely a no-op. Drag capture is free: Cocoa keeps routing mouseDragged:/
// mouseUp: to the mouseDown: view.
ICanvasView _canvasViewFor(void* self)
{
    if (!_setCurFromView(self)) return nullptr;
    if (!curWin().ready) return nullptr;
    string key = curWin().keyForHandle((u64)self);
    if (key.length() == 0) return nullptr;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return nullptr;
    return e as ICanvasView;
}

// The event location in the flipped view's own POINTS (top-left, y down). locationInWindow
// (NSPoint, 2-double HFA return) then convertPoint:fromView:nil (NSPoint arg decomposed to
// two doubles, NSPoint return). See the PointD note on the ABI.
PointD _canvasPointFor(void* self, void* event)
{
    function<PointD(void*, void*)> loc = (function<PointD(void*, void*)>)__objcMsgSendPtr;
    PointD win = loc(event, sel("locationInWindow"));
    function<PointD(void*, void*, double, double, void*)> cvt =
        (function<PointD(void*, void*, double, double, void*)>)__objcMsgSendPtr;
    return cvt(self, sel("convertPoint:fromView:"), win.x, win.y, nullptr);
}

// Bitmask of currently-pressed mouse buttons (bit 0 = left, bit 1 = right), a class-method
// scalar read - no per-event struct.
int _canvasButtons() { return (int)msgGetI64(cls("NSEvent"), "pressedMouseButtons"); }

void _canvasMouseDownImp(void* self, void* cmd, void* event)
{
    ICanvasView cv = _canvasViewFor(self);
    if (cv == nullptr || !cv.hasPointerDown) return;
    PointD p = _canvasPointFor(self, event);
    cv.onPointerDown(p.x, p.y, _canvasButtons());
}

void _canvasMouseDraggedImp(void* self, void* cmd, void* event)
{
    ICanvasView cv = _canvasViewFor(self);
    if (cv == nullptr || !cv.hasPointerMove) return;
    PointD p = _canvasPointFor(self, event);
    cv.onPointerMove(p.x, p.y, _canvasButtons());
}

void _canvasMouseUpImp(void* self, void* cmd, void* event)
{
    ICanvasView cv = _canvasViewFor(self);
    if (cv == nullptr || !cv.hasPointerUp) return;
    PointD p = _canvasPointFor(self, event);
    cv.onPointerUp(p.x, p.y, _canvasButtons());
}

// scrollWheel: continuous (trackpad) vs line (mouse) deltas via scalar accessors;
// hasPreciseScrollingDeltas distinguishes a trackpad's precise scroll.
void _canvasScrollWheelImp(void* self, void* cmd, void* event)
{
    ICanvasView cv = _canvasViewFor(self);
    if (cv == nullptr || !cv.hasWheel) return;
    PointD p = _canvasPointFor(self, event);
    double dx = msgGetDouble(event, "scrollingDeltaX");
    double dy = msgGetDouble(event, "scrollingDeltaY");
    bool precise = msgGetI64(event, "hasPreciseScrollingDeltas") != (i64)0;
    cv.onWheel(p.x, p.y, dx, dy, precise);
}

IGridView _cocoaGridAtPoint(IElement node, int x, int y)
{
    if (node.kind() == ELEM_GRIDVIEW)
    {
        if (node.nodeBounds().contains(x, y)) return node as IGridView;
        return nullptr;
    }
    list<IElement>* kids = node.childList();
    if (kids != nullptr)
    {
        int i = kids.count() - 1;
        while (i >= 0)
        {
            IGridView hit = _cocoaGridAtPoint(kids.get(i), x, y);
            if (hit != nullptr) return hit;
            i--;
        }
    }
    return nullptr;
}

void _flippedScrollWheelImp(void* self, void* cmd, void* event)
{
    if (_setCurFromView(self) && curWin().ready)
    {
        PointD p = _canvasPointFor(curWin().contentView, event);
        double dx = msgGetDouble(event, "scrollingDeltaX");
        double dy = msgGetDouble(event, "scrollingDeltaY");
        double adx = dx < 0.0 ? 0.0 - dx : dx;
        double ady = dy < 0.0 ? 0.0 - dy : dy;
        if (ady > 0.0 && adx <= ady)
        {
            IGridView gv = _cocoaGridAtPoint(curWin().tree, (int)(p.x / BASE_X), (int)(p.y / BASE_Y));
            if (gv != nullptr)
            {
                int delta = (int)(dy * 3.0);
                int max = gv.maxScrollY();
                // Consume only when the grid can still move; at a boundary the
                // event falls through so an enclosing scroll view keeps scrolling.
                bool canMove = delta > 0 ? gv.scrollY > 0 : (delta < 0 && gv.scrollY < max);
                if (canMove)
                {
                    gv.scrollY = gv.scrollY - delta;
                    if (gv.scrollY < 0) gv.scrollY = 0;
                    if (gv.scrollY > max) gv.scrollY = max;
                    curWin().requestLayout();
                    return;
                }
            }
        }
    }
    // Not consumed by a GridView: forward to the next responder (the clip view),
    // so a plain NSScrollView documentView still wheel-scrolls normally.
    msg1(msg0(self, "nextResponder"), "scrollWheel:", event);
}

// magnifyWithEvent: -magnification is the incremental zoom delta; report scale = 1.0 + it.
void _canvasMagnifyImp(void* self, void* cmd, void* event)
{
    ICanvasView cv = _canvasViewFor(self);
    if (cv == nullptr || !cv.hasPinch) return;
    PointD p = _canvasPointFor(self, event);
    double mag = msgGetDouble(event, "magnification");
    cv.onPinch(p.x, p.y, 1.0 + mag);
}

// -- NSTableView dataSource IMPs (ListView; the boxed rowText is the item source) --
i64 _numberOfRowsImp(void* self, void* cmd, void* table)
{
    if (!_setCurFromTarget(self)) return (i64)0;
    return (i64)curWin()._listRowsForTable((u64)table);
}

void* _tableObjectValueImp(void* self, void* cmd, void* table, void* column, i64 row)
{
    if (!_setCurFromTarget(self)) return nsStr("");
    u64 box = curWin()._listBoxForTable((u64)table);
    if (box == 0u) return nsStr("");
    void* cols = msg0(table, "tableColumns");
    i64 ci = msgGetI64Arg(cols, "indexOfObject:", column);
    if (ci < (i64)0) ci = (i64)0;
    string cell = __uiListRowText(box, (int)row, (int)ci);
    if (ci != (i64)0) return nsStr(cell.data());

    // First column carries the portable row icon. A cell-based NSTextFieldCell
    // cannot show image + text (setImage: converts it to an image-type cell and
    // drops the text), so inline the icon as an attributed-string attachment.
    void* icon = curWin()._listIconImage((u64)table, (int)row);
    if (icon == nullptr) return nsStr(cell.data());
    void* att = msg0(msg0(cls("NSTextAttachment"), "alloc"), "init");
    msg1(att, "setImage:", icon);
    msgRect(att, "setBounds:", 0.0, -3.0, 16.0, 16.0);
    void* head = msg1(cls("NSAttributedString"), "attributedStringWithAttachment:", att);
    void* text = msg0(cls("NSMutableAttributedString"), "alloc");
    string label = " " + cell;
    text = msg1(text, "initWithString:", nsStr(label.data()));
    void* out = msg1(msg0(cls("NSMutableAttributedString"), "alloc"),
                     "initWithAttributedString:", head);
    msg1(out, "appendAttributedString:", text);
    msg0(att, "release");
    msg0(text, "release");
    return msg0(out, "autorelease");
}

// A table row clicked (single) / double-clicked -> onSelect / onActivate.
void _onListClickImp(void* self, void* cmd, void* table)
{
    if (!_setCurFromTarget(self)) return;
    if (!curWin().ready || curWin().applying) return;
    string key = curWin().keyForHandle((u64)msg0(table, "enclosingScrollView"));
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    IListView lv = e as IListView;
    if (lv == nullptr) return;
    int sel = (int)msgGetI64(table, "selectedRow");
    if (sel >= 0 && sel != lv.selectedIndex) { lv.fireSelect(sel); pumpNative(); }
}

void _onListDoubleClickImp(void* self, void* cmd, void* table)
{
    if (!_setCurFromTarget(self)) return;
    if (!curWin().ready) return;
    string key = curWin().keyForHandle((u64)msg0(table, "enclosingScrollView"));
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    IListView lv = e as IListView;
    if (lv == nullptr) return;
    int sel = (int)msgGetI64(table, "selectedRow");
    if (sel >= 0) { lv.fireActivate(sel); pumpNative(); }
}

void _onListHeaderClickImp(void* self, void* cmd, void* table, void* column)
{
    if (!_setCurFromTarget(self)) return;
    if (!curWin().ready || curWin().applying) return;
    string key = curWin().keyForHandle((u64)msg0(table, "enclosingScrollView"));
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    IListView lv = e as IListView;
    if (lv == nullptr) return;
    i64 ci = msgGetI64Arg(msg0(table, "tableColumns"), "indexOfObject:", column);
    if (ci >= (i64)0) { lv.fireHeaderClick((int)ci); pumpNative(); }
}

void _onListWillDisplayCellImp(void* self, void* cmd, void* table, void* cell,
                               void* column, i64 row)
{
    if (!_setCurFromTarget(self)) return;
    u64 scroll = (u64)msg0(table, "enclosingScrollView");
    string key = curWin().keyForHandle(scroll);
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    IListView lv = e as IListView;
    if (lv == nullptr) return;
    i64 ci = msgGetI64Arg(msg0(table, "tableColumns"), "indexOfObject:", column);
    if (ci < (i64)0) ci = 0;
    int align = 0;
    if (ci < lv.colAligns.count()) align = lv.colAligns.get((int)ci);
    msgInt(cell, "setAlignment:", (i64)_cocoaTextAlignment(align));
    int color = resolveListCellColor(__uiListCellStyle(curWin()._listStyleForTable((u64)table), (int)row, (int)ci), curWin().ctx.theme, curWin().ctx.systemPrefersDark());
    msg1(cell, "setTextColor:", curWin().colorFor(color));
    // Row icons ride the column-0 objectValue as attributed-string attachments
    // (see _tableObjectValueImp); never setImage: here - it converts the text
    // cell to an image-type cell and the row label disappears.
}

// The segmented tab strip changed -> onSelectTab.
void _onTabSegmentImp(void* self, void* cmd, void* seg)
{
    if (!_setCurFromTarget(self)) return;
    if (curWin().ready) routeTabChange(seg);
}

// -- NSOutlineView dataSource IMPs (TreeView; items are NSNumber(nodeId)) ------
i64 _outlineNumChildrenImp(void* self, void* cmd, void* outline, void* item)
{
    if (!_setCurFromTarget(self)) return (i64)0;
    u64 box = curWin()._treeBoxForOutline((u64)outline);
    if (box == 0u) return (i64)0;
    int nodeId = item != nullptr ? (int)msgGetI64(item, "integerValue") : TREE_ROOT;
    return (i64)__uiTreeChildCount(box, nodeId);
}

void* _outlineChildImp(void* self, void* cmd, void* outline, i64 index, void* item)
{
    if (!_setCurFromTarget(self)) return nullptr;
    u64 box = curWin()._treeBoxForOutline((u64)outline);
    if (box == 0u) return nullptr;
    int nodeId = item != nullptr ? (int)msgGetI64(item, "integerValue") : TREE_ROOT;
    int childNid = __uiTreeChildId(box, nodeId, (int)index);
    return msgIntArg(cls("NSNumber"), "numberWithInteger:", (i64)childNid);
}

i8 _outlineExpandableImp(void* self, void* cmd, void* outline, void* item)
{
    if (!_setCurFromTarget(self)) return (i8)0;
    u64 box = curWin()._treeBoxForOutline((u64)outline);
    if (box == 0u) return (i8)0;
    int nodeId = item != nullptr ? (int)msgGetI64(item, "integerValue") : TREE_ROOT;
    return __uiTreeChildCount(box, nodeId) > 0 ? (i8)1 : (i8)0;
}

void* _outlineObjectValueImp(void* self, void* cmd, void* outline, void* column, void* item)
{
    if (!_setCurFromTarget(self)) return nsStr("");
    u64 box = curWin()._treeBoxForOutline((u64)outline);
    if (box == 0u || item == nullptr) return nsStr("");
    int nodeId = (int)msgGetI64(item, "integerValue");
    string lbl = __uiTreeLabel(box, nodeId);
    return nsStr(lbl.data());
}

// The outline selection changed (via its target/action) -> onSelect.
void _onTreeClickImp(void* self, void* cmd, void* outline)
{
    if (!_setCurFromTarget(self)) return;
    if (!curWin().ready) return;
    i64 row = msgGetI64(outline, "selectedRow");
    if (row < (i64)0) return;
    void* item = msgIntArg(outline, "itemAtRow:", row);
    routeTreeSelectItem(outline, item);
}

// NSOutlineView expansion delegate (fires for user AND programmatic expandItem:).
// Mirror of the Win32 TVN_ITEMEXPANDING route: fire the TreeView's onExpand.
void _onTreeWillExpandImp(void* self, void* cmd, void* note)
{
    if (!_setCurFromTarget(self)) return;
    if (!curWin().ready || curWin().applying) return;
    void* outline = msg0(note, "object");
    void* item = msg1(msg0(note, "userInfo"), "objectForKey:", nsStr((char*)"NSObject"));
    string key = curWin().keyForHandle((u64)msg0(outline, "enclosingScrollView"));
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    ITreeView tv = e as ITreeView;
    if (tv == nullptr) return;
    int nid = item != nullptr ? (int)msgGetI64(item, "integerValue") : (0 - 1);
    if (nid >= 0) { tv.fireExpand(nid); pumpNative(); }
}

// -- ctx.post() marshaling (performSelectorOnMainThread with an NSNumber box) ---
// Scheduled in the COMMON run-loop modes (not just default): a worker completion
// must deliver while the main thread is in event-tracking mode (mouse drag / pinch),
// or live tile loads freeze mid-gesture. Common modes still service under the default
// mode too, so hostDrainPosted (default-mode drain) keeps working for the self-tests.
void _cocoaPostEnqueue(u64 target, u64 boxPtr)
{
    void* num = msgIntArg(cls("NSNumber"), "numberWithUnsignedLongLong:", (i64)boxPtr);
    // performSelector...modes: does NOT expand kCFRunLoopCommonModes, so list the
    // concrete modes: default (rest / hostDrainPosted) + event-tracking (drag/pinch).
    void* modes = msg0(cls("NSMutableArray"), "array");
    msg1(modes, "addObject:", nsStr((char*)"kCFRunLoopDefaultMode"));
    msg1(modes, "addObject:", nsStr((char*)"NSEventTrackingRunLoopMode"));
    function<void*(void*, void*, void*, void*, i8, void*)> f =
        (function<void*(void*, void*, void*, void*, i8, void*)>)__objcMsgSendPtr;
    f(u2h(target), sel("performSelectorOnMainThread:withObject:waitUntilDone:modes:"),
      sel("runPostBox:"), num, (i8)0, modes);
}

u64 _cocoaCurTid() { return (u64)msg0(cls("NSThread"), "currentThread"); }

// runPostBox: (main thread) - unwrap the NSNumber and run + free the boxed closure.
void _runPostBoxImp(void* self, void* cmd, void* num)
{
    _setCurFromTarget(self);   // point _cur at this window's ctx before the closure runs
    if (num == nullptr) return;
    u64 boxPtr = (u64)msgGetI64(num, "unsignedLongLongValue");
    __uiRunPostBox(boxPtr);
    // A posted closure is a UI-thread mutation like any native event handler: if it
    // called ctx.invalidate() it expects a repaint, so pump here (handlers do the same).
    pumpNative();
}

u64 _cocoaTimerSerial = 1u;

void _cocoaSetContentSize(u64 target, int w, int h)
{
    if (!_setCurFromTarget(u2h(target))) return;
    CocoaHost* wnd = curWin();
    msgSize(wnd.window, "setContentSize:", (double)(w * BASE_X), (double)(h * BASE_Y));
    wnd.w = w; wnd.h = h;
    if (wnd.ready) buildNativeTree();
}

Size _cocoaLiveContentSize(u64 target)
{
    Size result = default;
    if (!_setCurFromTarget(u2h(target))) return result;
    result.w = curWin().w;
    result.h = curWin().h;
    return result;
}

void _cocoaSetTopmost(u64 target, bool topmost)
{
    if (!_setCurFromTarget(u2h(target))) return;
    CocoaHost* wnd = curWin();
    // NSFloatingWindowLevel keeps utility windows above normal app windows.
    msgInt(wnd.window, "setLevel:", topmost ? 3 : 0);
    wnd.topmost = topmost;
}

bool _cocoaLiveTopmost(u64 target)
{
    if (!_setCurFromTarget(u2h(target))) return false;
    CocoaHost* wnd = curWin();
    if (wnd.topmost) return true;
    return wnd.window != nullptr && msgGetI64(wnd.window, "level") != (i64)0;
}

bool _cocoaSystemPrefersDark(u64 target)
{
    if (!_setCurFromTarget(u2h(target))) return false;
    void* defaults = msg0(cls("NSUserDefaults"), "standardUserDefaults");
    void* style = msg1(defaults, "objectForKey:", nsStr((char*)"AppleInterfaceStyle"));
    char* value = style != nullptr ? cStr(style) : nullptr;
    return value != nullptr && strcmp(value, (char*)"Dark") == 0;
}

u64 _cocoaStartTimer(u64 target, int ms, bool repeating, u64 boxPtr)
{
    if (!_setCurFromTarget(u2h(target))) return 0u;
    CocoaHost* wnd = curWin();
    u64 handle = _cocoaTimerSerial++;
    if (handle == 0u) handle = _cocoaTimerSerial++;
    void* info = msgIntArg(cls("NSNumber"), "numberWithUnsignedLongLong:", (i64)handle);
    function<void*(void*, void*, double, void*, void*, void*, i8)> f =
        (function<void*(void*, void*, double, void*, void*, void*, i8)>)__objcMsgSendPtr;
    void* timer = f(cls("NSTimer"), sel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),
                    (double)ms / 1000.0, wnd.target, sel("runTimer:"), info,
                    repeating ? (i8)1 : (i8)0);
    if (timer == nullptr) return 0u;
    wnd.timerHandles.add(handle); wnd.timerBoxes.add(boxPtr); wnd.timerObjects.add((u64)timer);
    return handle;
}

void _cocoaCancelTimer(u64 target, u64 handle)
{
    if (!_setCurFromTarget(u2h(target))) return;
    CocoaHost* wnd = curWin();
    int i = 0;
    while (i < wnd.timerHandles.count())
    {
        if (wnd.timerHandles.get(i) == handle)
        {
            void* timer = u2h(wnd.timerObjects.get(i));
            if (timer != nullptr) msg0(timer, "invalidate");
            __uiFreeTimerBox(wnd.timerBoxes.get(i));
            wnd.timerHandles.removeAt(i); wnd.timerBoxes.removeAt(i); wnd.timerObjects.removeAt(i);
            return;
        }
        i++;
    }
}

void _runTimerImp(void* self, void* cmd, void* timer)
{
    if (!_setCurFromTarget(self) || timer == nullptr) return;
    CocoaHost* wnd = curWin();
    void* info = msg0(timer, "userInfo");
    u64 handle = info != nullptr ? (u64)msgGetI64(info, "unsignedLongLongValue") : 0u;
    int i = 0;
    while (i < wnd.timerHandles.count())
    {
        if (wnd.timerHandles.get(i) == handle)
        {
            u64 box = wnd.timerBoxes.get(i);
            bool repeating = ((TimerBox*)box).repeating;
            if (!repeating)
            {
                msg0(timer, "invalidate");
                wnd.timerHandles.removeAt(i); wnd.timerBoxes.removeAt(i); wnd.timerObjects.removeAt(i);
            }
            __uiRunTimerBox(box);
            return;
        }
        i++;
    }
}

// -- Host-neutral accessors (mirror the Win32 host) ------------------------------
// This host is genuinely multi-window: each accessor resolves the servicing window
// through curWin() (_cur is re-established at every callback entry). ctx.post
// marshaling is real: performSelectorOnMainThread + hostDrainPosted.
IUiContext      activeCtx() { return &curWin().ctx; }
alias IComponent activeApp() { return curWin().app; }
bool            hostDark()  { if (!hasCurWin()) return false; return curWin().dark; }
int hostWidth()  { return curWin().w; }
int hostHeight() { return curWin().h; }
int hostWindowCount() { return _windows.count(); }

// Create a hidden window bound to `app` at cell size w x h and build its tree (mirror
// of the Win32 startHeadlessWindow; the headless self-tests use it).
void startHeadlessWindow(IComponent app, const char* title, int w, int h)
{
    int wi = createAppWindow(app, title, false);
    if (wi < 0) return;
    curWin().w = w; curWin().h = h;
    buildWindowTree(wi);
}

// Deliver pending performSelectorOnMainThread: posts (ctx.post marshaling). Mirror
// of the Win32 PeekMessage drain: non-blocking run-loop passes, no fixed wait.
void hostDrainPosted()
{
    void* loop = msg0(cls("NSRunLoop"), "currentRunLoop");
    void* mode = nsStr((char*)"kCFRunLoopDefaultMode");
    void* past = msgSetDouble(cls("NSDate"), "dateWithTimeIntervalSinceNow:", -1.0);
    function<i8(void*, void*, void*, void*)> run =
        (function<i8(void*, void*, void*, void*)>)__objcMsgSendPtr;
    // A past beforeDate never waits; a second pass picks up posts chained by the
    // first (runMode: returns YES on timeout too, so do NOT loop on its result).
    run(loop, sel("runMode:beforeDate:"), mode, past);
    run(loop, sel("runMode:beforeDate:"), mode, past);
}

// Open a second (or Nth) top-level application window running `app`, built + shown,
// sharing the one NSApplication run loop. Genuine multi-window ("New Window").
void openAppWindow(IComponent app, const char* title)
{
    createAppWindow(app, title, true);
    buildNativeTree();   // build the just-created (now active) window
}

// Build the tree of the window at registry index `wi` (points _cur at it first).
void buildWindowTree(int wi)
{
    if (wi < 0 || wi >= _windows.count()) return;
    _cur = wi;
    buildNativeTree();
}

// True if `want` is present in the key list.
bool listHasStr(list<string>* xs, string want)
{
    int i = 0;
    while (i < xs.count()) { if (xs.get(i) == want) return true; i++; }
    return false;
}

// Find the live node whose key path equals `want`. `path` is `node`'s own path.
IElement findByKey(IElement node, string path, string want)
{
    if (path == want) return node;
    list<IElement>* kids = node.childList();
    if (kids != nullptr)
    {
        int i = 0;
        while (i < kids.count())
        {
            IElement c = kids.get(i);
            string cp = joinKeyPath(path, keySegment(c, i));
            IElement r = findByKey(c, cp, want);
            if (r != nullptr) return r;
            i++;
        }
    }
    return nullptr;
}

// Drain the dirty flag after a native event: re-render + reconcile, relayout, and
// reconcile the tree to native controls. AppKit repaints the controls itself.
void pumpNative()
{
    if (!hasCurWin()) return;
    CocoaHost* wnd = curWin();
    if (wnd.ctx.consumeDirty())
    {
        IElement wip = wnd.app.render(&wnd.ctx);
        list<Patch> patches = default;
        wnd.tree = reconcile(wnd.tree, wip, &patches);
        layoutRootBounded(wnd.tree, 0, 0, wnd.w, wnd.h);
        wnd.applyTree(wnd.tree, &wnd.ctx);
    }
}

string _keyForView(void* view)
{
    void* v = view; int guard = 0;
    while (v != nullptr && guard < 16)
    {
        string key = curWin().keyForHandle((u64)v); if (key.length() > 0) return key;
        v = msg0(v, "superview"); guard++;
    }
    return "";
}

// -- Native event routing (target/action + delegate -> element handler) --------
void routeClick(void* ctrl)
{
    string key = curWin().keyForHandle((u64)ctrl);
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    IInfoBar ib = e as IInfoBar;
    if (ib != nullptr) { ib.fireClose(); pumpNative(); return; }
    IPopover pp = e as IPopover;
    if (pp != nullptr) { pp.fireCommand((int)msgGetI64(ctrl, "tag")); pumpNative(); return; }
    IButton b = e as IButton;
    if (b != nullptr) { b.fireClick(); pumpNative(); return; }
    ICheckbox c = e as ICheckbox;
    if (c != nullptr) { c.fireToggle(); pumpNative(); return; }
    ILink l = e as ILink;
    if (l != nullptr) { l.fireClick(); pumpNative(); return; }
    // A radio routes to its enclosing RadioGroup (one key-path segment up), which owns
    // the controlled value + onChange (mirror of the Win32 host).
    IRadioButton rb = e as IRadioButton;
    if (rb != nullptr)
    {
        string pp = _parentPath(key);
        IElement pe = findByKey(curWin().tree, keySegment(curWin().tree, 0), pp);
        if (pe != nullptr)
        {
            IRadioGroup g = pe as IRadioGroup;
            if (g != nullptr) { g.fireChange(rb.index); pumpNative(); }
        }
    }
}

void routeSpinner(void* ctrl)
{
    string key = _keyForView(ctrl); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key); if (e == nullptr) return;
    ISpinner s = e as ISpinner; if (s == nullptr) return;
    char* raw = cStr(msg0(ctrl, "stringValue"));
    int v = msgBool1(ctrl, "isKindOfClass:", cls("NSStepper")) != (i8)0
        ? (int)msgGetDouble(ctrl, "doubleValue") : (raw != nullptr ? ((string)raw).toInt() : 0);
    s.fireSet(v); pumpNative();
}

void routeToolbar(void* button)
{
    string key = _keyForView(button); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key); if (e == nullptr) return;
    IToolBar t = e as IToolBar; if (t == nullptr) return;
    t.fireCommand((int)msgGetI64(button, "tag")); pumpNative();
}

void routeToggle(void* sw)
{
    string key = _keyForView(sw); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key); if (e == nullptr) return;
    IToggleSwitch t = e as IToggleSwitch; if (t == nullptr) return;
    t.fireToggle(); pumpNative();
}

void routeSegmented(void* ctrl)
{
    string key = curWin().keyForHandle((u64)ctrl); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key); if (e == nullptr) return;
    ISegmented s = e as ISegmented; if (s == nullptr) return;
    int index = (int)msgGetI64(ctrl, "selectedSegment");
    if (index >= 0 && index != s.selected) { s.fireSelect(index); pumpNative(); }
}

void routeExpander(void* ctrl)
{
    if (curWin().applying) return;
    string key = curWin().keyForHandle((u64)ctrl); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key); if (e == nullptr) return;
    IExpander ex = e as IExpander; if (ex == nullptr) return;
    ex.fireToggle(); curWin().ctx.invalidate(); pumpNative();
}

void routeDatePicker(void* ctrl)
{
    if (curWin().applying) return;
    string key = curWin().keyForHandle((u64)ctrl); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key); if (e == nullptr) return;
    IDatePicker dp = e as IDatePicker; if (dp == nullptr) return;
    void* cal = msg0(cls("NSCalendar"), "currentCalendar");
    void* date = msg0(ctrl, "dateValue");
    function<void*(void*, void*, i64, void*)> f = (function<void*(void*, void*, i64, void*)>)__objcMsgSendPtr;
    void* comps = f(cal, sel("components:fromDate:"), (i64)28, date);
    dp.fireChangeDate((int)msgGetI64(comps, "year"), (int)msgGetI64(comps, "month"), (int)msgGetI64(comps, "day"));
    pumpNative();
}

void routeColorWell(void* ctrl)
{
    if (curWin().applying) return;
    string key = curWin().keyForHandle((u64)ctrl); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key); if (e == nullptr) return;
    IColorWell cw = e as IColorWell; if (cw == nullptr) return;
    int raw = 0;
    if (_uiTestColorValues.count() > 0)
    {
        raw = _uiTestColorValues.get(0); _uiTestColorValues.removeAt(0);
    }
    else
    {
        void* color = msg0(ctrl, "color");
        color = msg1(color, "colorUsingColorSpace:", msg0(cls("NSColorSpace"), "sRGBColorSpace"));
        int r = (int)(msgGetDouble(color, "redComponent") * 255.0 + 0.5);
        int g = (int)(msgGetDouble(color, "greenComponent") * 255.0 + 0.5);
        int b = (int)(msgGetDouble(color, "blueComponent") * 255.0 + 0.5);
        raw = (r << 16) | (g << 8) | b;
    }
    cw.fireChangeColor(colorLiteral(raw)); pumpNative();
}

// Strip the last "/segment" from a key path ("root/rg/r1" -> "root/rg"); "" if none.
string _parentPath(string key)
{
    int last = -1; int i = 0; int n = (int)key.length();
    while (i < n) { if (key.data()[i] == '/') last = i; i++; }
    if (last < 0) return "";
    return substring(key, 0, last);
}

// A combo selection change: read the new index, fire onChange.
void routeCombo(void* ctrl)
{
    string key = curWin().keyForHandle((u64)ctrl);
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    IComboBox cb = e as IComboBox;
    if (cb == nullptr) return;
    int sel = (int)msgGetI64(ctrl, "indexOfSelectedItem");
    if (sel >= 0 && sel != cb.selectedIndex) { cb.fireChange(sel); pumpNative(); }
}

// A tab strip selection change: read the segment, fire onSelectTab.
void routeTabChange(void* ctrl)
{
    if (curWin().applying) return;
    string key = curWin().keyForHandle((u64)ctrl);
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    ITabControl tc = e as ITabControl;
    if (tc == nullptr) return;
    int sel = (int)msgGetI64(ctrl, "selectedSegment");
    if (sel >= 0 && sel != tc.selectedTab) { tc.fireSelectTab(sel); pumpNative(); }
}

// A tree selection change: read the selected item's nodeId, fire onSelect + onExpand.
void routeTreeSelectItem(void* outline, void* item)
{
    if (curWin().applying) return;
    string key = curWin().keyForHandle((u64)msg0(outline, "enclosingScrollView"));
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    ITreeView tv = e as ITreeView;
    if (tv == nullptr) return;
    int nid = item != nullptr ? (int)msgGetI64(item, "integerValue") : (0 - 1);
    if (nid != tv.selectedNode) { tv.fireSelect(nid); pumpNative(); }
}

void routeEdit(void* ctrl)
{
    string key = _keyForView(ctrl);
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    IComboBox cb = e as IComboBox;
    if (cb != nullptr && cb.editable)
    {
        char* c = cStr(msg0(ctrl, "stringValue")); cb.fireEdit(c != nullptr ? (string)c : ""); pumpNative(); return;
    }
    ISpinner sp = e as ISpinner;
    if (sp != nullptr)
    {
        char* c = cStr(msg0(ctrl, "stringValue")); sp.fireSet(c != nullptr ? ((string)c).toInt() : 0); pumpNative(); return;
    }
    ITextInput ti = e as ITextInput;
    if (ti != nullptr)
    {
        char* c = cStr(msg0(ctrl, "stringValue"));
        string nv = c != nullptr ? (string)c : "";
        ti.fireChangeText(nv);
        pumpNative();
        return;
    }
    IRichText rt = e as IRichText;
    if (rt != nullptr)
    {
        void* tv = _isScroll(ctrl) ? msg0(ctrl, "documentView") : ctrl;
        char* c = cStr(msg0(tv, "string"));
        rt.fireChangeText(c != nullptr ? "" + c : ""); pumpNative(); return;
    }
    // A TextArea is uncontrolled: textDidChange is just a dirty NOTIFICATION; do
    // not read / push the (potentially large) buffer here.
    ITextArea ta = e as ITextArea;
    if (ta != nullptr)
    {
        ta.fireChange();
        pumpNative();
    }
}

void routeSlider(void* ctrl)
{
    string key = curWin().keyForHandle((u64)ctrl);
    if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    if (e == nullptr) return;
    ISlider s = e as ISlider;
    if (s == nullptr) return;
    int pos = (int)msgGetDouble(ctrl, "doubleValue");
    s.fireSet(pos);
    pumpNative();
}

// Read the current text of the control at `keyPath` (owned string). Used to PULL a
// TextArea's buffer on save. Returns "" if there is no such control.
string nativeControlText(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return "";
    void* ctrl = u2h(h);
    void* pool = poolPush();
    void* text = nullptr;
    if (_isScroll(ctrl))
    {
        void* tv = msg0(ctrl, "documentView");
        text = msg0(tv, "string");
    }
    else if (msgBool1(ctrl, "isKindOfClass:", cls("NSBox")) != (i8)0)
    {
        text = msg0(ctrl, "title");   // GroupBox text lives in the NSBox title
    }
    else if (msgBool1(ctrl, "isKindOfClass:", cls("NSControl")) != (i8)0)
    {
        text = msg0(ctrl, "stringValue");
    }
    char* c = text != nullptr ? cStr(text) : nullptr;
    // Deep-copy into an owned string BEFORE the pool pops ('(string)c' would alias the
    // autoreleased buffer, which poolPop then frees). "" + c allocates a fresh buffer.
    string s = c != nullptr ? "" + c : "";
    poolPop(pool);
    return s;
}

string nativeRichTextPlain(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath); if (h == 0u) return "";
    void* tv = msg0(u2h(h), "documentView");
    void* pool = poolPush(); char* c = cStr(msg0(tv, "string")); string s = c != nullptr ? "" + c : "";
    poolPop(pool); return s;
}

void nativeRichTextTypeText(string keyPath, string text)
{
    u64 h = curWin().ctx.nativeHandle(keyPath); if (h == 0u) return;
    void* tv = msg0(u2h(h), "documentView"); bool prev = curWin().applying; curWin().applying = true;
    msg1(tv, "setString:", _nsStrSafe(text)); curWin().applying = prev; routeEdit(u2h(h));
}

string nativeWebViewUrl(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath); if (h == 0u) return "";
    void* pool = poolPush(); void* url = msg0(u2h(h), "URL");
    char* c = url != nullptr ? cStr(msg0(url, "absoluteString")) : nullptr;
    string s = c != nullptr ? "" + c : ""; poolPop(pool); return s;
}

// Read a status bar pane's text (mirror of the Win32 nativeStatusText). The macOS
// status strip is an NSTextField, so its stringValue is the joined pane text.
string nativeStatusText(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return "";
    void* pool = poolPush();
    char* c = cStr(msg0(u2h(h), "stringValue"));
    string s = c != nullptr ? "" + c : "";
    poolPop(pool);
    return s;
}

// Push text into the control at `keyPath` (file open / clear). Guards the reentrant
// change notification so the push does not register as a user edit.
void nativeSetControlText(string keyPath, string s)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return;
    void* ctrl = u2h(h);
    void* ns = _nsStrSafe(s);   // avoid a null NSString arg for an empty push
    bool prev = curWin().applying;
    curWin().applying = true;
    if (_isScroll(ctrl))
    {
        void* tv = msg0(ctrl, "documentView");
        msg1(tv, "setString:", ns);
    }
    else if (msgBool1(ctrl, "isKindOfClass:", cls("NSBox")) != (i8)0)
    {
        msg1(ctrl, "setTitle:", ns);
    }
    else if (msgBool1(ctrl, "isKindOfClass:", cls("NSControl")) != (i8)0)
    {
        msg1(ctrl, "setStringValue:", ns);
    }
    curWin().applying = prev;
}

// -- Host-neutral driver API (selection / insertion / menu) -------------------
// Same surface as the Win32 host; fedit uses these to stay platform-portable.

// The NSTextView backing the control at `keyPath` (documentView of a scroll view),
// or the control itself for a plain field.
void* _textViewFor(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return nullptr;
    void* ctrl = u2h(h);
    if (_isScroll(ctrl)) return msg0(ctrl, "documentView");
    return ctrl;
}

// Select [start, end) in the control and scroll it into view + focus it (mirror of
// Win32 EM_SETSEL + EM_SCROLLCARET + SetFocus).
void nativeSelect(string keyPath, int start, int end)
{
    void* tv = _textViewFor(keyPath);
    if (tv == nullptr) return;
    u64 len = end >= start ? (u64)(end - start) : 0u;
    msgRange(tv, "setSelectedRange:", (u64)start, len);
    msgRange(tv, "scrollRangeToVisible:", (u64)start, len);
    void* win = msg0(tv, "window");
    if (win == nullptr) win = curWin().window;
    if (win != nullptr) msg1(win, "makeFirstResponder:", tv);
}

// The selection start (NSRange location) of the control (mirror of EM_GETSEL selA).
int nativeSelectionStart(string keyPath)
{
    void* tv = _textViewFor(keyPath);
    if (tv == nullptr) return 0;
    return (int)msgRangeLoc(tv, "selectedRange");
}

// Insert `s` at character `pos`, firing the change notification like a keystroke
// (insertText:replacementRange: FIRES textDidChange:, mirror of EM_SETSEL +
// EM_REPLACESEL).
void nativeInsertTextAt(string keyPath, int pos, string s)
{
    void* tv = _textViewFor(keyPath);
    if (tv == nullptr) return;
    msgIdRange(tv, "insertText:replacementRange:", nsStr(s.data()), (u64)pos, 0u);
}

// Fire a menu command as if the user selected it (used by fedit's self-test).
void nativeTestFireMenu(int cmd)
{
    routeMenu(cmd);
}

// Register (or replace) the context menu for a key path; the host takes ownership of
// the boxed ContextMenu* (freed on teardown). Right-click shows it via NSMenu.
void nativeSetContextMenu(string keyPath, u64 menuPtr)
{
    curWin().setContextMenu(keyPath, menuPtr);
}

// Simulate the user picking item `itemIndex` of the context menu on keyPath (headless:
// popUpMenuPositioningItem cannot run unattended). Routes the item's command.
void nativeFireContextMenu(string keyPath, int itemIndex)
{
    u64 mp = curWin().contextMenuFor(keyPath);
    if (mp == 0u) return;
    ContextMenu* cm = (ContextMenu*)mp;
    if (itemIndex < 0 || itemIndex >= cm.count()) return;
    int cmd = cm.cmds.get(itemIndex);
    if (cmd > 0) routeMenu(cmd);
}

// Drive a splitter to a cell position along its axis (headless drag). Fires onRatioChange
// (the SplitView is a layout container, like Win32 - the divider is a parent-tracked gap,
// not an NSSplitView, so the layout model stays single-source).
void nativeSplitterDrag(string keyPath, int cellX, int cellY)
{
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), keyPath);
    if (e == nullptr) return;
    ISplitView sv = e as ISplitView;
    if (sv == nullptr) return;
    sv.fireRatioChange(sv._ratioAt(cellX, cellY));
    pumpNative();
}

Rect nativeNodeBounds(string keyPath)
{
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), keyPath);
    if (e == nullptr) { Rect z = default; return z; }
    return e.nodeBounds();
}

// The committed View container's backgroundColor (its host backdrop fill), or 0. Reads
// the reconciled tree, so it verifies a theme flip actually re-colored the card.
int nativeContainerBg(string keyPath)
{
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), keyPath);
    if (e == nullptr) return 0;
    IView v = e as IView;
    if (v != nullptr) return resolveColor(v.style.backgroundColor, curWin().ctx.theme,
                                           curWin().ctx.systemPrefersDark());
    return 0;
}

