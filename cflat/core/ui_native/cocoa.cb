    void* _listIconImage(u64 tablePtr, int row)
    {
        u64 box = this._listIconBoxForTable(tablePtr);
        if (box == 0u) return nullptr;
        ListRowIcon icon = __uiListRowIcon(box, row);
        if (icon.identity == nullptr || strlen((char*)icon.identity) == 0
            || icon.pixels == 0u || icon.pxW <= 0 || icon.pxH <= 0) return nullptr;
        string id = "" + (char*)icon.identity;
        int i = this._listIconCacheSlot(tablePtr, id);
        if (i >= 0 && this.listIconCachePixels.get(i) == icon.pixels
            && this.listIconCacheRevisions.get(i) == icon.revision
            && this.listIconCacheW.get(i) == icon.pxW && this.listIconCacheH2.get(i) == icon.pxH)
            return u2h(this.listIconCacheImgs.get(i));
        void* rep = nsBitmapRep((void*)icon.pixels, (i64)icon.pxW, (i64)icon.pxH,
                                (i64)8, (i64)4, (i8)1, (i8)0,
                                nsStr("NSDeviceRGBColorSpace"), (i64)(icon.pxW * 4), (i64)32);
        if (rep == nullptr) return nullptr;
        void* img = msg0(msg0(cls("NSImage"), "alloc"), "init");
        msg1(img, "addRepresentation:", rep);
        if (i >= 0)
        {
            void* old = u2h(this.listIconCacheImgs.get(i));
            if (old != nullptr) msg0(old, "release");
            this.listIconCachePixels.set(i, icon.pixels); this.listIconCacheImgs.set(i, (u64)img);
            this.listIconCacheRevisions.set(i, icon.revision);
            this.listIconCacheW.set(i, icon.pxW); this.listIconCacheH2.set(i, icon.pxH);
        }
        else
        {
            this.listIconCacheH.add(tablePtr); this.listIconCacheIds.add(id);
            this.listIconCachePixels.add(icon.pixels); this.listIconCacheImgs.add((u64)img);
            this.listIconCacheRevisions.add(icon.revision);
            this.listIconCacheW.add(icon.pxW); this.listIconCacheH2.add(icon.pxH);
        }
        return img;
    }

    void _freeListIconState(u64 h)
    {
        void* table = this._tableOf(h);
        int i = 0;
        while (i < this.listIconHandles.count())
        {
            if (this.listIconHandles.get(i) == (u64)table)
            {
                u64 old = this.listIconPtrs.get(i); if (old != 0u) __uiFreeListIconBox(old);
                this.listIconHandles.removeAt(i); this.listIconPtrs.removeAt(i); break;
            }
            i++;
        }
        i = this.listIconCacheH.count() - 1;
        while (i >= 0)
        {
            if (this.listIconCacheH.get(i) == (u64)table)
            {
                void* img = u2h(this.listIconCacheImgs.get(i)); if (img != nullptr) msg0(img, "release");
                this.listIconCacheH.removeAt(i); this.listIconCacheIds.removeAt(i);
                this.listIconCachePixels.removeAt(i); this.listIconCacheImgs.removeAt(i);
                this.listIconCacheRevisions.removeAt(i); this.listIconCacheW.removeAt(i); this.listIconCacheH2.removeAt(i);
            }
            i--;
        }
    }

