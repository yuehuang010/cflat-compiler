// core/ui_native/cocoa.cb - a native macOS (AppKit) host that drives REAL OS controls.
//
// This is the macOS counterpart of ui_native/win32.cb: the INativeHost output
// stage of the CFlat UI framework (see ui_native.cb). The reconciled IElement tree's
// stable key paths map to real AppKit controls (NSButton / NSTextField / NSSlider /
// NSProgressIndicator / NSBox / NSTextView), and the host creates / updates /
// destroys those controls to match the tree. AppKit paints them, handles IME +
// accessibility, and owns focus / Tab. The app-facing model is UNCHANGED; an app
// that renders to the Win32 host renders here too - it just imports this host
// (via ui_native/host.cb) instead.
//
// It drives AppKit through the objc_msgSend bridge in cocoa.cb, which links AppKit +
// Foundation via `import framework` (no SDK, no Xcode). Coordinates use a FLIPPED content view so every
// frame is top-left like Win32; cells->points is x*BASE_X, y*BASE_Y with NO DPI
// scaling (Cocoa points are already density-independent, so the Win32 WM_DPICHANGED
// machinery is dropped here).
//
// This file has no main(); an app imports it and calls runAppGuiNative().
//
// "cocoa.cb" below is the objc bridge at core/cocoa.cb, NOT this file: the importing
// file's own directory is probed first, but the resolver rejects self-resolution.
import "ui_native.cb";
import "cocoa.cb";

extern void* dlopen(const char* path, int mode);
bool _webKitLoaded = false;
void _ensureWebKit()
{
    if (!_webKitLoaded) { dlopen("/System/Library/Frameworks/WebKit.framework/WebKit", 2); _webKitLoaded = true; }
}

// Per-cell base points. Layout math in ui.cb uses shared cells; the native host
// converts them to points. One layout column ~8pt, one row ~26pt so controls get
// sensible heights. Unlike Win32, there is no DPI multiplier (Cocoa points scale).
const int BASE_X = 8;
const int BASE_Y = 26;

// Points reserved for an NSScrollView's vertical scroller when sizing the document
// view narrower than the viewport (autohiding, so unused when content fits).
const double SCROLLER_ALLOW = 16.0;

// NSEventModifierFlag masks (accelerators). Ctrl maps to Cmd per mac convention.
const int MOD_CMD   = 0x100000;   // 1<<20  NSEventModifierFlagCommand
const int MOD_SHIFT = 0x20000;    // 1<<17  NSEventModifierFlagShift
const int MOD_ALT   = 0x80000;    // 1<<19  NSEventModifierFlagOption

// A 4-double aggregate matching NSRect. On arm64 an HFA of 4 doubles is returned in
// d0-d3; cocoa_probe --selftest confirmed the cflat function<> ABI matches, so
// -[NSView frame] is read this way for the resize path.
struct RectD
{
    double x = 0.0;
    double y = 0.0;
    double w = 0.0;
    double h = 0.0;
};

// A 2-double aggregate matching NSPoint. On arm64 an HFA of 2 doubles is returned in
// d0/d1 (the same class of return as RectD's 4-double d0-d3, which cocoa_probe validated
// through the function<> ABI), so -[NSEvent locationInWindow] / -[NSView convertPoint:...]
// are read this way. An NSPoint ARGUMENT is passed as two scalar doubles (see the location:
// arg in _postWakeEvent), so convertPoint: takes its point decomposed, not as a struct.
struct PointD
{
    double x = 0.0;
    double y = 0.0;
};

// -- App-wide host state (NOT per-window) -------------------------------------
// This host is genuinely multi-window: each top-level window is a CocoaHost in the
// owning registry `_windows`, and `_cur` is the window currently being serviced. The
// free-function IMPs (a plain objc callback cannot capture `this`) re-establish `_cur`
// at entry by resolving the event's window/target to its registry index, then reach
// the servicing window through curWin(). The NSApplication delegate is process-global.
void* _appDelegate = nullptr;

// -- Declarative menu bar -----------------------------------------------------
// Same surface + globals as the Win32 host. Parallel lists (not a struct with a
// closure) keep ownership simple; an item's app command id is carried on the
// NSMenuItem via setTag:. The app provides ONE dispatch closure (setMenuHandler).
list<string>          _menuTop        = default;   // top-level menu titles
list<int>             _menuItemTopIdx = default;   // per item: owning top index
list<string>          _menuItemLabel  = default;   // per item: label
list<int>             _menuItemCmd    = default;   // per item: app command id (0 = separator)
list<string>          _menuAccel      = default;   // per item: accel text (e.g. "Ctrl+S")
Lambda<void(int)>     _menuHandler    = default;   // app's command dispatcher
list<int>             _uiTestColorValues = default;
list<string>          _uiTestFontFamilies = default;
list<int>             _uiTestFontSizes = default;

// Optional close guard: the app returns true to allow the window to close, false to
// veto. Default (unset) always allows.
Lambda<bool()>        _closeQuery     = default;
bool                  _hasCloseQuery  = false;

// macOS has ONE app-wide main menu bar (unlike Win32's per-HWND HMENU), so buildMenuBar
// is idempotent: it realizes the declared menu once, then every window shares it.
bool                  _menuBuilt      = false;
void*                 _menuTarget     = nullptr;   // app-wide onMenu: target (see buildMenuBar)

void setMenuHandler(Lambda<void(int)> h) { _menuHandler = h; }
void setCloseQuery(Lambda<bool()> q) { _closeQuery = q; _hasCloseQuery = true; }

void* u2h(u64 u) { return (void*)u; }

// A node kind that maps to an OS control (vs a pure layout container). Same set as
// the Win32 host.
bool nativeMappable(int kind)
{
    return kind == ELEM_BUTTON || kind == ELEM_TEXT || kind == ELEM_TEXTINPUT
        || kind == ELEM_CHECKBOX || kind == ELEM_PROGRESS || kind == ELEM_SLIDER
        || kind == ELEM_SPINNER || kind == ELEM_LINK || kind == ELEM_TOOLBAR
        || kind == ELEM_TOGGLE || kind == ELEM_SEGMENTED
        || kind == ELEM_DATEPICKER || kind == ELEM_EXPANDER || kind == ELEM_COLORWELL
        || kind == ELEM_INFOBAR || kind == ELEM_POPOVER
        || kind == ELEM_RICHTEXT || kind == ELEM_WEBVIEW
        || kind == ELEM_BOX || kind == ELEM_TEXTAREA || kind == ELEM_STATUSBAR
        || kind == ELEM_RADIO || kind == ELEM_COMBO || kind == ELEM_LIST
        || kind == ELEM_TABS || kind == ELEM_TREE
        || kind == ELEM_IMAGE || kind == ELEM_GROUPBOX || kind == ELEM_CANVAS
        || kind == ELEM_SCROLL;
}

// The style.backgroundColor of a plain (non-mapped) container - a View from
// view/row/column - or 0 for anything else. A non-zero value opts the container into
// a painted backdrop panel (Box already maps to a native NSBox, so it is excluded).
int _containerBg(IElement node, Theme theme, bool systemDark)
{
    if (node.kind() == ELEM_VIEW) { IView v = node as IView; return resolveColor(v.style.backgroundColor, theme, systemDark); }
    if (node.kind() == ELEM_GRID) { IGrid g = node as IGrid; return resolveColor(g.style.backgroundColor, theme, systemDark); }
    return 0;
}

bool _fillKind(int kind)
{
    return kind == ELEM_TEXTAREA || kind == ELEM_LIST || kind == ELEM_TREE
        || kind == ELEM_TABS || kind == ELEM_CANVAS || kind == ELEM_GRIDVIEW
        || kind == ELEM_GROUPBOX || kind == ELEM_BOX || kind == ELEM_RICHTEXT
        || kind == ELEM_WEBVIEW;
}

// The concrete tooltip text a mappable node carries ("" = none), read through
// ITooltipped (mirror of the Win32 host); one downcast answers for all 15 classes.
string tooltipOf(IElement node)
{
    ITooltipped t = node as ITooltipped;
    if (t == nullptr) return "";
    return "" + t.tooltip;
}

// An NSString for `s`, safe for an empty cflat string (whose data() can be null):
// an empty value maps to [NSString string] (@"") rather than a nil arg.
void* _nsStrSafe(string s)
{
    if (s.length() == 0) return msg0(cls("NSString"), "string");
    return nsStr(s.data());
}

// True if `ctrl` is an NSScrollView (a TextArea's handle is its scroll view; text
// ops resolve the documentView first).
bool _isScroll(void* ctrl)
{
    return msgBool1(ctrl, "isKindOfClass:", cls("NSScrollView")) != (i8)0;
}

// Unified (TextKit) NSTextAlignment numbering: center=1, right=2 - macOS adopted
// the UIKit values; the legacy AppKit right=1/center=2 render swapped.
int _cocoaTextAlignment(int align)
{
    if (align == COL_ALIGN_RIGHT) return 2;
    if (align == COL_ALIGN_CENTER) return 1;
    return 0;
}

// -- CocoaHost: the INativeHost implementation ---------------------------------
// Owns the top-level window, the flipped content view, the one shared callback
// target (CfHostTarget), the reentrancy guard, and the per-frame live-control
// bookkeeping (parallel key/handle lists) used to route events and destroy controls
// that fell out of the tree.
class CocoaHost : INativeHost
{
    void* window      = nullptr;
    bool  topmost     = false;
    void* contentView = nullptr;   // the flipped CfFlippedView
    void* target      = nullptr;   // this window's CfHostTarget (control + delegate + dataSource)
    bool  applying    = false;     // guard: swallow self-inflicted change notifications
    bool  dark        = false;     // last applied theme was dark
    // Per-window app + tree + context (mirror of the Win32 Window). The registry owns
    // the window and it owns its app IComponent; freed in dispose().
    IComponent app   = default;
    IElement   tree  = default;
    UiContext ctx   = default;
    bool      ready = false;
    int       w     = 95;   // client size in cells (760pt / 8)
    int       h     = 21;   // 560pt / 26
    list<u64> timerHandles = default;
    list<u64> timerBoxes   = default;
    list<u64> timerObjects = default;
    list<string> liveKeys    = default;   // keys with a live control this frame
    list<u64>    liveHandles = default;   // parallel handles (NSView* as u64)
    list<u64>    spinnerHandles = default;
    list<u64>    toolbarHandles = default;
    list<u64>    toggleHandles = default;
    list<u64>    infoBarHandles = default;
    list<u64>    popoverHandles = default;
    list<u64>    popoverObjects = default;
    list<string> popoverKeys = default;
    list<u64>    richLastHandles = default;
    list<string> richLastSigs = default;
    list<u64>    webViewLastHandles = default;
    list<string> webViewLastSources = default;
    double edgeWPt = 0.0;
    double edgeHPt = 0.0;
    double contentWPt = 0.0;
    double contentHPt = 0.0;
    double applyExtraW = 0.0;
    double applyExtraH = 0.0;
    int fillBottomCells = 0;

    // -- Data/visual-control bookkeeping (mirror of the Win32 host lists) -----------
    // ListView rowText boxes: parallel table-view handle -> ListRowBox* (as u64), plus
    // the controlled selection (NSTableView owns no owner-data virtualization the way
    // Win32 LVS_OWNERDATA does, but the boxed rowText is still the single item source).
    list<u64>    listBoxHandles = default;
    list<u64>    listBoxPtrs    = default;
    list<u64>    listIconHandles = default;
    list<u64>    listIconPtrs    = default;
    list<u64>    listIconCacheH = default;
    list<string> listIconCacheIds = default;
    list<u64>    listIconCachePixels = default;
    list<u64>    listIconCacheImgs = default;
    list<u64>    listIconCacheRevisions = default;
    list<int>    listIconCacheW = default;
    list<int>    listIconCacheH2 = default;
    list<u64>    listStyleHandles = default;
    list<u64>    listStylePtrs    = default;
    list<u64>    listSelHandles = default;   // parallel handle -> selected row
    list<int>    listSelRows    = default;
    list<u64>    accHandles = default;       // parallel handle -> stored accent bg
    list<u32>    accBgs     = default;       // (reported by nativeAccentBg)
    list<u64>    listRowCounts  = default;   // parallel handle -> virtual row count
    list<int>    listRowCountV  = default;
    // Lists whose column widths must be re-synced AFTER the frame pass: the
    // last-column stretch reads the scroll view's contentSize, live only then.
    list<u64>       _pendingColSyncH  = default;
    list<IListView> _pendingColSyncLv = default;
    list<u64>    listSortHandles = default;
    list<int>    listSortColumns = default;
    list<int>    listSortAscending = default;
    // TreeView node-source boxes: parallel outline-view handle -> TreeBox* (as u64).
    list<u64>    treeBoxHandles = default;
    list<u64>    treeBoxPtrs    = default;
    // Per-key context menus: parallel key path -> ContextMenu* (as u64), host-owned.
    list<string> ctxKeys        = default;
    list<u64>    ctxMenus        = default;
    // CanvasView paint boxes: parallel view handle -> CanvasBox* (as u64).
    list<u64>    canvasHandles   = default;
    list<u64>    canvasBoxes     = default;
    // Image last-uploaded pixel pointer per handle (skip redundant NSImage rebuilds).
    list<u64>    imgHandles      = default;
    list<u64>    imgLastPixels   = default;
    // Cached NSFont instances for Text.font (lazily built, retained for window life).
    void*        fontUI      = nullptr;
    void*        fontTitle   = nullptr;
    void*        fontCaption = nullptr;
    // CoreText line-metrics symbols (lazily dlsym'd; CoreText is already loaded
    // transitively by AppKit). Scalar-return API, not the NSSize-returning
    // -sizeWithAttributes: (a struct return is not safe through this msgSend bridge).
    function<void*(void*)> ctLineCreate = nullptr;
    function<double(void*, double*, double*, double*)> ctLineBounds = nullptr;
    function<void(void*)> cfRelease = nullptr;

    // INativeHost: create a control of `elemKind` under the flipped content view.
    // `key` is the node's key path (kept by the caller in the shadow map). Returns
    // the control (NSView*) as a u64; a TextArea returns its enclosing scroll view.
    u64 createControl(int elemKind, u64 parentHandle, string key,
                      bool password, bool indeterminate, bool comboEditable)
    {
        void* ctrl = nullptr;
        if (elemKind == ELEM_BUTTON)
        {
            ctrl = msgRect(msg0(cls("NSButton"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setBezelStyle:", 1);            // NSBezelStyleRounded
            msg1(ctrl, "setTarget:", this.target);
            msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_CHECKBOX)
        {
            ctrl = msgRect(msg0(cls("NSButton"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setButtonType:", 3);            // NSButtonTypeSwitch
            msg1(ctrl, "setTarget:", this.target);
            msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_TEXTINPUT)
        {
            if (password)
                ctrl = msgRect(msg0(cls("NSSecureTextField"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            else
                ctrl = msgRect(msg0(cls("NSTextField"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msg1(ctrl, "setDelegate:", this.target);
        }
        else if (elemKind == ELEM_TEXT)
        {
            ctrl = msgRect(msg0(cls("NSTextField"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgBool(ctrl, "setBezeled:", false);
            msgBool(ctrl, "setDrawsBackground:", false);
            msgBool(ctrl, "setEditable:", false);
            msgBool(ctrl, "setSelectable:", false);
        }
        else if (elemKind == ELEM_BOX)
        {
            ctrl = msgRect(msg0(cls("NSBox"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setTitlePosition:", 0);         // NSNoTitle
        }
        else if (elemKind == ELEM_PROGRESS)
        {
            ctrl = msgRect(msg0(cls("NSProgressIndicator"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setStyle:", 0);                 // NSProgressIndicatorStyleBar
            msgBool(ctrl, "setIndeterminate:", indeterminate);
            if (indeterminate) msg1(ctrl, "startAnimation:", nullptr);
            msgSetDouble(ctrl, "setMinValue:", 0.0);
        }
        else if (elemKind == ELEM_SLIDER)
        {
            ctrl = msgRect(msg0(cls("NSSlider"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgBool(ctrl, "setContinuous:", true);
            msg1(ctrl, "setTarget:", this.target);
            msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_SPINNER)
        {
            ctrl = msgRect(msg0(cls("NSView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            void* field = msgRect(msg0(cls("NSTextField"), "alloc"), "initWithFrame:", 0.0, 0.0, 80.0, 26.0);
            msgBool(field, "setEditable:", true); msgBool(field, "setSelectable:", true);
            msg1(field, "setDelegate:", this.target);
            void* stepper = msgRect(msg0(cls("NSStepper"), "alloc"), "initWithFrame:", 80.0, 0.0, 24.0, 26.0);
            msg1(stepper, "setTarget:", this.target); msg1(stepper, "setAction:", sel("onAction:"));
            msg1(ctrl, "addSubview:", field); msg1(ctrl, "addSubview:", stepper);
            msg0(field, "release"); msg0(stepper, "release"); this.spinnerHandles.add((u64)ctrl);
        }
        else if (elemKind == ELEM_LINK)
        {
            ctrl = msgRect(msg0(cls("NSButton"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 26.0);
            msgBool(ctrl, "setBordered:", false); msg1(ctrl, "setTarget:", this.target); msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_TOOLBAR)
        {
            ctrl = msgRect(msg0(cls("NSView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 26.0);
            this.toolbarHandles.add((u64)ctrl);
        }
        else if (elemKind == ELEM_TEXTAREA)
        {
            // NSTextView inside an NSScrollView; the u64 handle IS the scroll view
            // (framing / destroy). Text/selection ops resolve documentView first.
            void* scroll = msgRect(msg0(cls("NSScrollView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgBool(scroll, "setHasVerticalScroller:", true);
            msgInt(scroll, "setBorderType:", 2);          // NSBezelBorder
            void* tv = msgRect(msg0(cls("NSTextView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgBool(tv, "setEditable:", true);
            msgBool(tv, "setSelectable:", true);
            msgBool(tv, "setRichText:", false);
            // Make the text view fill (and track) the scroll view's content width, and
            // grow vertically with the text. Without this, initWithFrame leaves a ~10pt
            // text container that never resizes, so only one character column is visible
            // even though the buffer holds the full text. This is Apple's canonical
            // NSScrollView + NSTextView setup. NSViewWidthSizable = 1<<1 = 2.
            double big = 10000000.0;
            msgSize(tv, "setMinSize:", 0.0, 0.0);
            msgSize(tv, "setMaxSize:", big, big);
            msgBool(tv, "setVerticallyResizable:", true);
            msgBool(tv, "setHorizontallyResizable:", false);
            msgInt(tv, "setAutoresizingMask:", 2);
            void* tc = msg0(tv, "textContainer");
            if (tc != nullptr)
            {
                msgBool(tc, "setWidthTracksTextView:", true);
                msgSize(tc, "setContainerSize:", big, big);
            }
            msg1(tv, "setDelegate:", this.target);
            msg1(scroll, "setDocumentView:", tv);
            ctrl = scroll;
        }
        else if (elemKind == ELEM_RICHTEXT)
        {
            // The scroll view is the handle; its documentView is the rich editor.
            void* scroll = msgRect(msg0(cls("NSScrollView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgBool(scroll, "setHasVerticalScroller:", true); msgInt(scroll, "setBorderType:", 2);
            void* tv = msgRect(msg0(cls("NSTextView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgBool(tv, "setEditable:", false); msgBool(tv, "setSelectable:", true); msgBool(tv, "setRichText:", true);
            double big = 10000000.0;
            msgSize(tv, "setMinSize:", 0.0, 0.0); msgSize(tv, "setMaxSize:", big, big);
            msgBool(tv, "setVerticallyResizable:", true); msgBool(tv, "setHorizontallyResizable:", false);
            msgInt(tv, "setAutoresizingMask:", 2);
            void* tc = msg0(tv, "textContainer");
            if (tc != nullptr) { msgBool(tc, "setWidthTracksTextView:", true); msgSize(tc, "setContainerSize:", big, big); }
            msg1(tv, "setDelegate:", this.target); msg1(scroll, "setDocumentView:", tv); ctrl = scroll;
        }
        else if (elemKind == ELEM_WEBVIEW)
        {
            _ensureWebKit();
            ctrl = msgRect(msg0(cls("WKWebView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msg1(ctrl, "setNavigationDelegate:", this.target);
            this.webViewLastHandles.add((u64)ctrl); this.webViewLastSources.add("");
        }
        else if (elemKind == ELEM_STATUSBAR)
        {
            // A read-only text strip stands in for the status bar; macOS has no
            // NSStatusBar equivalent for an in-window strip, so we use an NSTextField.
            ctrl = msgRect(msg0(cls("NSTextField"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgBool(ctrl, "setBezeled:", false);
            msgBool(ctrl, "setDrawsBackground:", false);
            msgBool(ctrl, "setEditable:", false);
            msgBool(ctrl, "setSelectable:", false);
        }
        else if (elemKind == ELEM_RADIO)
        {
            // NSButtonTypeRadio: AppKit auto-groups radios that share the same
            // target+action within a superview, matching the RadioGroup semantics.
            ctrl = msgRect(msg0(cls("NSButton"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setButtonType:", 4);            // NSButtonTypeRadio
            msg1(ctrl, "setTarget:", this.target);
            msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_COMBO)
        {
            if (comboEditable)
                ctrl = msgRect(msg0(cls("NSComboBox"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            else
                ctrl = msgRect(msg0(cls("NSPopUpButton"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            if (!comboEditable) msgBool(ctrl, "setPullsDown:", false);
            msg1(ctrl, "setTarget:", this.target);
            msg1(ctrl, "setAction:", sel("onAction:"));
            if (comboEditable) msg1(ctrl, "setDelegate:", this.target);
        }
        else if (elemKind == ELEM_TOGGLE)
        {
            ctrl = msgRect(msg0(cls("NSView"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            void* sw = msgRect(msg0(cls("NSSwitch"), "alloc"), "initWithFrame:", 0.0, 0.0, 38.0, 24.0);
            void* label = msgRect(msg0(cls("NSTextField"), "alloc"), "initWithFrame:", 42.0, 0.0, 80.0, 24.0);
            msgBool(label, "setBezeled:", false); msgBool(label, "setDrawsBackground:", false);
            msgBool(label, "setEditable:", false); msgBool(label, "setSelectable:", false);
            msg1(sw, "setTarget:", this.target); msg1(sw, "setAction:", sel("onAction:"));
            msg1(ctrl, "addSubview:", sw); msg1(ctrl, "addSubview:", label);
            msg0(sw, "release"); msg0(label, "release");
            this.toggleHandles.add((u64)ctrl);
        }
        else if (elemKind == ELEM_SEGMENTED)
        {
            ctrl = msgRect(msg0(cls("NSSegmentedControl"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setTrackingMode:", 0);
            msg1(ctrl, "setTarget:", this.target); msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_DATEPICKER)
        {
            ctrl = msgRect(msg0(cls("NSDatePicker"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setDatePickerStyle:", 0); msgInt(ctrl, "setDatePickerElements:", 0x00E0);
            msg1(ctrl, "setTarget:", this.target); msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_EXPANDER)
        {
            ctrl = msgRect(msg0(cls("NSButton"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msgInt(ctrl, "setButtonType:", 1); msgInt(ctrl, "setBezelStyle:", 5);
            msg1(ctrl, "setTarget:", this.target); msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_COLORWELL)
        {
            ctrl = msgRect(msg0(cls("NSColorWell"), "alloc"), "initWithFrame:", 0.0, 0.0, 10.0, 10.0);
            msg1(ctrl, "setTarget:", this.target); msg1(ctrl, "setAction:", sel("onAction:"));
        }
        else if (elemKind == ELEM_INFOBAR)
        {
