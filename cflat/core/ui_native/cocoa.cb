                (double)(frameCells.x * BASE_X), (double)(frameCells.y * BASE_Y),
                (double)(frameCells.w * BASE_X) + this.applyExtraW,
                (double)(frameCells.h * BASE_Y) + this.applyExtraH);
        if (this._hasComposite(&this.spinnerHandles, (u64)ctrl)) this._layoutSpinner(ctrl,
            (double)(frameCells.w * BASE_X) + this.applyExtraW,
            (double)(frameCells.h * BASE_Y) + this.applyExtraH);
        if (this._hasComposite(&this.toggleHandles, (u64)ctrl)) this._layoutToggle(ctrl,
            (double)(frameCells.w * BASE_X) + this.applyExtraW,
            (double)(frameCells.h * BASE_Y) + this.applyExtraH);
