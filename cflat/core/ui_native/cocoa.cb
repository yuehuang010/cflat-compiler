void nativeListSelect(string keyPath, int row)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return;
    curWin().setListOp(h, LISTOP_SET_SELECTION, row, 0, "", 0u);
    // Programmatic selectRowIndexes: fires no action; route onSelect like a click
    // would (Win32's LVM_SETITEMSTATE raises a real LVN_ITEMCHANGED notify).
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), keyPath);
    if (e == nullptr) return;
    IListView lv = e as IListView;
    if (lv == nullptr) return;
    if (row >= 0 && row != lv.selectedIndex) { lv.fireSelect(row); pumpNative(); }
}

int nativeListSelectedRow(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return 0 - 1;
