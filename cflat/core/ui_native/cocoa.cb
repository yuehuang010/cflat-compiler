void uiTestScriptColor(int r, int g, int b) { _uiTestColorValues.add((r << 16) | (g << 8) | b); }
void uiTestScriptFolder(string path) { _uiTestFolderAnswers.add("" + path); }
void uiTestScriptFont(string family, int size) { _uiTestFontFamilies.add("" + family); _uiTestFontSizes.add(size); }

string nativeOpenFile()
{
    void* panel = msg0(cls("NSOpenPanel"), "openPanel");
    msgBool(panel, "setCanChooseFiles:", true);
    msgBool(panel, "setCanChooseDirectories:", false);
    msgBool(panel, "setAllowsMultipleSelection:", false);
    i64 r = msgGetI64(panel, "runModal");
    if (r != (i64)1) return "";                 // NSModalResponseOK = 1
    void* url = msg0(panel, "URL");
    if (url == nullptr) return "";
    char* c = cStr(msg0(url, "path"));
    return c != nullptr ? "" + c : "";
}

string nativeSaveFile()
{
    void* panel = msg0(cls("NSSavePanel"), "savePanel");
