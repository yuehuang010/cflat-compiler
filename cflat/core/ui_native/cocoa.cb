    return c != nullptr ? "" + c : "";
}

int nativeMessageBox(string title, string text, int kind)
{
    if (_uiTestMessageBoxAnswers.count() > 0)
    {
        int answer = _uiTestMessageBoxAnswers.get(0);
        _uiTestMessageBoxAnswers.removeAt(0);
        return answer;
    }
    void* alert = msg0(msg0(cls("NSAlert"), "alloc"), "init");
    msg1(alert, "setMessageText:", nsStr(title.data()));
    msg1(alert, "setInformativeText:", nsStr(text.data()));
    if (kind == MSGBOX_YESNO)
    {
        msg1(alert, "addButtonWithTitle:", nsStr("Yes"));
        msg1(alert, "addButtonWithTitle:", nsStr("No"));
    }
    else
    {
        msg1(alert, "addButtonWithTitle:", nsStr("OK"));
        if (kind == MSGBOX_OKCANCEL) msg1(alert, "addButtonWithTitle:", nsStr("Cancel"));
    }
    i64 r = msgGetI64(alert, "runModal");
    msg0(alert, "release");
    return r == (i64)1000 ? 1 : 0;
}

bool nativeChooseFont(FontChoice* out)
{
    if (_uiTestFontFamilies.count() > 0)
    {
        out.family = "" + _uiTestFontFamilies.get(0); out.size = _uiTestFontSizes.get(0);
        _uiTestFontFamilies.removeAt(0); _uiTestFontSizes.removeAt(0); return true;
    }
    void* alert = msg0(msg0(cls("NSAlert"), "alloc"), "init");
    msg1(alert, "setMessageText:", nsStr("Choose Font"));
    void* accessory = msgRect(msg0(cls("NSView"), "alloc"), "initWithFrame:", 0.0, 0.0, 280.0, 58.0);
    void* combo = msgRect(msg0(cls("NSComboBox"), "alloc"), "initWithFrame:", 0.0, 30.0, 280.0, 24.0);
    void* families = msg0(msg0(cls("NSFontManager"), "sharedFontManager"), "availableFontFamilies");
    int i = 0; while (families != nullptr && i < (int)msgGetI64(families, "count"))
    { msg1(combo, "addItemWithObjectValue:", msgInt(families, "objectAtIndex:", i)); i++; }
    msg1(combo, "setStringValue:", nsStr("System"));
    void* size = msgRect(msg0(cls("NSTextField"), "alloc"), "initWithFrame:", 0.0, 0.0, 80.0, 24.0);
    msg1(size, "setStringValue:", nsStr("12")); msg1(accessory, "addSubview:", combo); msg1(accessory, "addSubview:", size);
    msg0(combo, "release"); msg0(size, "release");
    msg1(alert, "setAccessoryView:", accessory); msg0(accessory, "release");
    msg1(alert, "addButtonWithTitle:", nsStr("OK")); msg1(alert, "addButtonWithTitle:", nsStr("Cancel"));
    i64 r = msgGetI64(alert, "runModal");
    if (r != (i64)1000) { msg0(alert, "release"); return false; }
    char* fam = cStr(msg0(combo, "stringValue")); char* sz = cStr(msg0(size, "stringValue"));
    out.family = fam != nullptr ? "" + fam : "System"; out.size = sz != nullptr ? ((string)sz).toInt() : 12;
    msg0(alert, "release"); return true;
}

string nativeSelectFolder()
{
    if (_uiTestFolderAnswers.count() > 0)
    {
        string path = "" + _uiTestFolderAnswers.get(0);
        _uiTestFolderAnswers.removeAt(0);
