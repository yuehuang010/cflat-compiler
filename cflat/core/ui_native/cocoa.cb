int nativeListIconCacheCount(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return 0;
    void* table = curWin()._tableOf(h);
    int n = 0; int i = 0;
    while (i < curWin().listIconCacheH.count())
    {
        if (curWin().listIconCacheH.get(i) == (u64)table) n++;
        i++;
    }
    return n;
}

int nativeListIconResolve(string keyPath, int row)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return -1;
    void* table = curWin()._tableOf(h);
    void* img = curWin()._listIconImage((u64)table, row);
    if (img == nullptr) return -1;
    ListRowIcon icon = __uiListRowIcon(curWin()._listIconBoxForTable((u64)table), row);
    if (icon.identity == nullptr) return -1;
    string id = "" + (char*)icon.identity;
    return curWin()._listIconCacheSlot((u64)table, id);
}

u64 nativeListIconRevision(string keyPath, int row)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return 0u;
    void* table = curWin()._tableOf(h);
    void* img = curWin()._listIconImage((u64)table, row);
    if (img == nullptr) return 0u;
    u64 box = curWin()._listIconBoxForTable((u64)table);
    if (box == 0u) return 0u;
    ListRowIcon icon = __uiListRowIcon(box, row);
    if (icon.identity == nullptr) return 0u;
    int i = curWin()._listIconCacheSlot((u64)table, "" + (char*)icon.identity);
    return i >= 0 ? curWin().listIconCacheRevisions.get(i) : 0u;
}

void nativeListIconResetForTest(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return;
    curWin()._freeListIconState(h);
