// Accents on mac ride bezelColor/contentTintColor (no NM_CUSTOMDRAW). Report the
// stored accent: "reported == stored" is the same honest driver semantic the WinUI
// host uses - the accent is real via bezelColor, there is no offscreen pixel readback.
u32 nativeAccentBg(string keyPath)
{
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return 0u;
    return curWin()._accentFor(h);
}
u32 nativeTestCustomDrawFill(string keyPath) { return nativeAccentBg(keyPath); }

// -- Host-neutral hardening drivers (Cocoa bodies) ----------------------------
// Same contract as the Win32 bodies (win32.cb): a live client resize, the accessible
// Name of a control, and the logical Tab ring (focus first / next / read back).

// Drive a live client-area resize to w x h cells, so the host relayouts + reconciles.
// Cocoa peer of the Win32 WM_SIZE synthesis: set the window's content size and run the
// same relayout path windowDidResize: takes (buildNativeTree at the new cell size).
void nativeResizeClient(int wCells, int hCells)
{
    if (!hasCurWin()) return;
    CocoaHost* wnd = curWin();
    int w = wCells < 1 ? 1 : wCells;
    int h = hCells < 1 ? 1 : hCells;
    if (wnd.window != nullptr)
        msgSize(wnd.window, "setContentSize:", (double)(w * BASE_X), (double)(h * BASE_Y));
    wnd.w = w; wnd.h = h;
    buildNativeTree();
}

// The user-visible accessible Name of the control at keyPath. AppKit derives the label
// from the control's title / stringValue; a textless control (ProgressBar) has none, so
// fall back to the tooltip - which is exactly what the Win32 host mirrors into its text.
string nativeAccessibleName(string keyPath)
{
    if (!hasCurWin()) return "";
    u64 h = curWin().ctx.nativeHandle(keyPath);
    if (h == 0u) return "";
    void* ctrl = u2h(h);
    void* pool = poolPush();
    void* lbl = msg0(ctrl, "accessibilityLabel");
    char* c = lbl != nullptr ? cStr(lbl) : nullptr;
    string s = c != nullptr ? "" + c : "";
    poolPop(pool);
    if (s.length() > 0) return s;

    string t = nativeControlText(keyPath);
    if (t.length() > 0) return t;

    void* pool2 = poolPush();
    void* tip = msg0(ctrl, "toolTip");
    char* tc = tip != nullptr ? cStr(tip) : nullptr;
    string ts = tc != nullptr ? "" + tc : "";
    poolPop(pool2);
    return ts;
}

// The responder that takes focus for a live control: a TextArea's handle is its scroll
// view, but the NSTextView inside it is what becomes first responder.
void* _responderFor(void* ctrl)
{
    if (ctrl == nullptr) return nullptr;
    if (_isScroll(ctrl)) return msg0(ctrl, "documentView");
    return ctrl;
}

// The live control handle backing `resp` (walk up the view chain: a text view resolves
// to its scroll view, a field editor to the NSTextField it is editing). 0u if none.
u64 _liveHandleForResponder(void* resp)
{
    // The first responder can be the NSWindow itself (no focused control); only a view
    // has a superview chain to walk.
    if (resp == nullptr || msgBool1(resp, "isKindOfClass:", cls("NSView")) == (i8)0) return 0u;
    void* v = resp;
    int guard = 0;
    while (v != nullptr && guard < 32)
    {
        if (curWin().keyForHandle((u64)v).length() > 0) return (u64)v;
        v = msg0(v, "superview");
        guard++;
    }
    return 0u;
}

// Make `ctrl` the window's first responder; true if AppKit accepted it (a label or a
// disabled control refuses, which is what keeps the ring to real tabstops).
bool _tryFocus(void* ctrl)
{
    void* win = curWin().window;
    void* resp = _responderFor(ctrl);
    if (win == nullptr || resp == nullptr) return false;
    if (msgBool1(resp, "canBecomeKeyView", nullptr) == (i8)0) return false;
    return msgBool1(win, "makeFirstResponder:", resp) != (i8)0;
}

// Focus the first focusable live control at or after index `start` (wrapping once), and
// return its key path; "" if the window has no focusable control at all.
string _focusFrom(int start)
{
    if (!hasCurWin()) return "";
    int n = curWin().liveHandles.count();
    if (n == 0) return "";
    int i = 0;
    while (i < n)
    {
        int idx = (start + i) % n;
        u64 h = curWin().liveHandles.get(idx);
        if (_tryFocus(u2h(h))) return "" + curWin().liveKeys.get(idx);
        i++;
    }
    return "";
}

// The live control handle that currently holds focus (the window's first responder
// resolved back to a registered control), or 0u.
u64 _focusedHandle()
{
    if (!hasCurWin() || curWin().window == nullptr) return 0u;
    void* resp = msg0(curWin().window, "firstResponder");
    if (resp == nullptr) return 0u;
    return _liveHandleForResponder(resp);
}

// Focus the first control in the key ring; return its key path.
string nativeFocusFirst() { return _focusFrom(0); }

// Advance focus to the next control in the ring (Tab key equivalent); return its key.
string nativeFocusNext()
{
    if (!hasCurWin()) return "";
    u64 cur = _focusedHandle();
    int start = 0;
    if (cur != 0u)
    {
        int i = 0;
        while (i < curWin().liveHandles.count())
        {
            if (curWin().liveHandles.get(i) == cur) { start = i + 1; break; }
            i++;
        }
    }
    return _focusFrom(start);
}

// The key path of the control that currently holds focus ("" if none).
string nativeFocusedKey()
{
    if (!hasCurWin()) return "";
    return curWin().keyForHandle(_focusedHandle());
}

// Close the current window (bypasses the close guard - the caller already decided).
// -close fires windowWillClose: which tears the window down. A headless window (never
// ordered front) may not deliver windowWillClose:, so if the registry still holds this
// window after -close, tear it down directly. The findWindowIdx / this.window = nullptr
// guards make a double teardown impossible either way.
void nativeCloseWindow()
{
    if (!hasCurWin()) return;
    int idx = _cur;
    void* w = curWin().window;
    if (w != nullptr) msg0(w, "close");
    // If windowWillClose: already ran, the window at idx is gone or its .window is nil.
    if (idx >= 0 && idx < _windows.count() && _windows.get(idx).window == w && w != nullptr)
        destroyWindowStateAt(idx, true);
}

// -- Objective-C callback IMPs (one shared CfHostTarget carries them all) --
// Plain non-capturing cflat functions; state flows through the host globals - no
// Lambda crosses the C ABI.

// isFlipped -> YES: the content view's origin is top-left, like Win32.
i8 _isFlippedImp(void* self, void* cmd) { return (i8)1; }

// applicationShouldTerminateAfterLastWindowClosed: -> NO. The host controls exit
// itself (the main window's windowWillClose: stops the run loop) so runAppGuiNative
// can delete the heap component after [NSApp run] returns.
i8 _shouldTerminateImp(void* self, void* cmd, void* app) { return (i8)0; }

// The control to focus on show: prefer a TextArea (a scroll view's NSTextView),
// otherwise the first editable NSTextField. Returns nullptr if the tree has neither.
void* _firstEditableControl()
{
    if (!hasCurWin()) return nullptr;
    void* field = nullptr;
    int n = curWin().liveHandles.count();
    int i = 0;
    while (i < n)
    {
        void* ctrl = u2h(curWin().liveHandles.get(i));
        if (ctrl != nullptr)
        {
            if (_isScroll(ctrl)) return msg0(ctrl, "documentView");
            if (field == nullptr
                && msgBool1(ctrl, "isKindOfClass:", cls("NSTextField")) != (i8)0
                && msgBool1(ctrl, "isEditable", nullptr) != (i8)0)
                field = ctrl;
        }
        i++;
    }
    return field;
}

// applicationDidFinishLaunching: bring the app to the foreground and make the main
// window key. A CLI-launched (non-.app-bundle) binary does NOT reliably become the
// active app when activateIgnoringOtherApps: is called synchronously around window
// creation on modern macOS; the window comes up behind the launching terminal and
// keystrokes go there, so text controls look "not editable". Doing it here - after
// the run loop has started - is the point at which activation reliably sticks, and
// makeFirstResponder puts the caret in the first editable control right away.
void _didFinishLaunchingImp(void* self, void* cmd, void* note)
{
    if (!hasCurWin()) return;
    void* app = msg0(cls("NSApplication"), "sharedApplication");
    // activateIgnoringOtherApps: is deprecated and unreliable for a CLI-launched
    // binary on modern macOS (the launching terminal keeps focus). Go through
    // NSRunningApplication, which foregrounds a non-.app process reliably. Options
    // 3 = ActivateAllWindows | ActivateIgnoringOtherApps.
    void* self2 = msg0(cls("NSRunningApplication"), "currentApplication");
    if (self2 != nullptr) msgInt(self2, "activateWithOptions:", 3);
    msgBool(app, "activateIgnoringOtherApps:", true);
    if (curWin().window != nullptr)
    {
        msg1(curWin().window, "makeKeyAndOrderFront:", nullptr);
        void* fr = _firstEditableControl();
        if (fr != nullptr) msg1(curWin().window, "makeFirstResponder:", fr);
    }
}

// A control fired its action: a slider routes by value, everything else (button /
// checkbox) routes as a click.
void _onActionImp(void* self, void* cmd, void* sender)
{
    if (!_setCurFromTarget(self)) return;
    if (!curWin().ready) return;
    if (msgBool1(sender, "isKindOfClass:", cls("NSStepper")) != (i8)0) { routeSpinner(sender); return; }
    if (_keyForView(sender).length() > 0 && _keyForView(sender) != curWin().keyForHandle((u64)sender))
    {
        IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), _keyForView(sender));
        if (e != nullptr && (e as IToolBar) != nullptr) { routeToolbar(sender); return; }
    }
    if (msgBool1(sender, "isKindOfClass:", cls("NSSlider")) != (i8)0) { routeSlider(sender); return; }
    if (msgBool1(sender, "isKindOfClass:", cls("NSSwitch")) != (i8)0) { routeToggle(sender); return; }
    if (msgBool1(sender, "isKindOfClass:", cls("NSSegmentedControl")) != (i8)0) { routeSegmented(sender); return; }
    if (msgBool1(sender, "isKindOfClass:", cls("NSDatePicker")) != (i8)0) { routeDatePicker(sender); return; }
    if (msgBool1(sender, "isKindOfClass:", cls("NSColorWell")) != (i8)0) { routeColorWell(sender); return; }
    if (msgBool1(sender, "isKindOfClass:", cls("NSButton")) != (i8)0)
    {
        string key = curWin().keyForHandle((u64)sender);
        IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
        if (e != nullptr && (e as IExpander) != nullptr) { routeExpander(sender); return; }
    }
    routeClick(sender);
}

void _onPopoverCloseImp(void* self, void* cmd, void* popover)
{
    if (!_setCurFromTarget(self)) return;
    int i = 0;
    while (i < curWin().popoverObjects.count())
    {
        if (curWin().popoverObjects.get(i) == (u64)popover && i < curWin().popoverKeys.count())
        {
            IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), curWin().popoverKeys.get(i));
            IPopover p = e as IPopover;
            if (p != nullptr && p.open && !curWin().applying) { p.fireClose(); pumpNative(); }
            return;
        }
        i++;
    }
}

// A menu item fired: its command id rides on the tag. There is no view, so resolve the
// servicing window from the app's key window; if none is key (headless test), leave _cur
// as-is so nativeTestFireMenu still routes to the current window.
void _onMenuImp(void* self, void* cmd, void* sender)
{
    void* kw = msg0(msg0(cls("NSApplication"), "sharedApplication"), "keyWindow");
    _setCurFromWindow(kw);
    if (!hasCurWin()) return;
    i64 tag = msgGetI64(sender, "tag");
    if (curWin().ready) routeMenu((int)tag);
}

// controlTextDidChange: (NSTextField edit). The notification object is the field.
void _controlTextChangedImp(void* self, void* cmd, void* note)
{
    if (!_setCurFromTarget(self)) return;
    if (curWin().applying || !curWin().ready) return;
    void* field = msg0(note, "object");
    routeEdit(field);
}

// textDidChange: (NSTextView edit). The object is the text view; route through its
// enclosing scroll view (the live handle).
void _textDidChangeImp(void* self, void* cmd, void* note)
{
    if (!_setCurFromTarget(self)) return;
    if (curWin().applying || !curWin().ready) return;
    void* tv = msg0(note, "object");
    void* scroll = msg0(tv, "enclosingScrollView");
    if (scroll == nullptr) scroll = tv;
    routeEdit(scroll);
}

// WKWebView navigation callback; only committed navigations are reported.
void _webViewCommitImp(void* self, void* cmd, void* webView, void* navigation)
{
    if (!_setCurFromTarget(self) || !curWin().ready || curWin().applying) return;
    string key = curWin().keyForHandle((u64)webView); if (key.length() == 0) return;
    IElement e = findByKey(curWin().tree, keySegment(curWin().tree, 0), key);
    IWebView wv = e as IWebView; if (wv == nullptr) return;
    void* pool = poolPush(); void* url = msg0(webView, "URL");
    char* c = url != nullptr ? cStr(msg0(url, "absoluteString")) : nullptr;
    string s = c != nullptr ? "" + c : ""; poolPop(pool);
    wv.fireNavigate(s); pumpNative();
}

// windowDidResize: read the content view's size (struct return) and
// relayout at the new DIP client size.
void _windowResizeImp(void* self, void* cmd, void* note)
{
    void* win = msg0(note, "object");
    if (!_setCurFromWindow(win)) return;
    if (!curWin().ready) return;
    void* cv = msg0(win, "contentView");
    function<RectD(void*, void*)> ff = (function<RectD(void*, void*)>)__objcMsgSendPtr;
    RectD r = ff(cv, sel("frame"));
    int nw = (int)(r.w / (double)BASE_X);
    int nh = (int)(r.h / (double)BASE_Y);
    if (nw < 1) nw = 1;
    if (nh < 1) nh = 1;
    curWin().w = nw; curWin().h = nh;
    buildNativeTree();
}

void _cocoaThemeChangedImp(void* self, void* cmd, void* note)
{
    if (!_setCurFromTarget(self)) return;
    if (!curWin().ready || curWin().applying) return;
    buildNativeTree();
}

// windowShouldClose: the app's close guard vetoes (dirty-save prompt) before close.
i8 _windowShouldCloseImp(void* self, void* cmd, void* sender)
{
    _setCurFromWindow(sender);
    if (_hasCloseQuery) return _closeQuery() ? (i8)1 : (i8)0;
    return (i8)1;
}

// windowWillClose: tear down the closing window. When the LAST window closes, stop the
// run loop so [NSApp run] returns (stop: is deferred to the next event, so post a dummy
// application-defined event to wake the loop). AppKit is already closing the window, so
// dispose does not re-send -close.
void _windowWillCloseImp(void* self, void* cmd, void* note)
{
    void* w = msg0(note, "object");
    int i = findWindowIdx(w);
    if (i >= 0) destroyWindowStateAt(i, false);
    if (_windows.count() == 0)
    {
        void* app = msg0(cls("NSApplication"), "sharedApplication");
        msg1(app, "stop:", nullptr);
        _postWakeEvent(app);
    }
}

// Post a no-op NSApplicationDefined event so a pending stop: takes effect promptly
// (nextEventMatchingMask would otherwise block until real input arrives).
void _postWakeEvent(void* app)
{
    // otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:
    //   subtype:data1:data2: - type/flags/windowNumber/context/subtype/data1/data2
    // are integer/pointer args (x2..), location (NSPoint) is d0/d1, timestamp is d2.
    function<void*(void*, void*, u64, double, double, u64, double, i64, void*, i16, i64, i64)> f =
        (function<void*(void*, void*, u64, double, double, u64, double, i64, void*, i16, i64, i64)>)__objcMsgSendPtr;
    void* ev = f(cls("NSEvent"), sel("otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:data2:"),
                 15u, 0.0, 0.0, 0u, 0.0, (i64)0, nullptr, (i16)0, (i64)0, (i64)0);
    // postEvent:atStart: takes (id event, BOOL atStart).
    if (ev != nullptr)
    {
        function<void*(void*, void*, void*, i8)> p = (function<void*(void*, void*, void*, i8)>)__objcMsgSendPtr;
        p(app, sel("postEvent:atStart:"), ev, (i8)1);
    }
}

// -- Menu bar + accelerators --------------------------------------------------
bool strContains(string s, const char* sub)
{
    return strstr(s.data(), (char*)sub) != nullptr;
}

void menuReset()
{
    _menuBuilt = false;
    _menuTop.clear();
    _menuItemTopIdx.clear();
    _menuItemLabel.clear();
    _menuItemCmd.clear();
    _menuAccel.clear();
}

int menuAddTop(string title)
{
    _menuTop.add("" + title);
    return _menuTop.count() - 1;
}

void menuAddItem(int top, string label, string accel, int cmd)
{
    _menuItemTopIdx.add(top);
    _menuItemLabel.add("" + label);
    _menuItemCmd.add(cmd);
    _menuAccel.add("" + accel);
}

void menuAddSeparator(int top)
{
    _menuItemTopIdx.add(top);
    _menuItemLabel.add("");
    _menuItemCmd.add(0);
    _menuAccel.add("");
}

// The accel key token (after the last '+'), or the whole string if there is no '+'.
string _accelKeyToken(string a)
{
    int plus = -1; int i = 0; int n = (int)a.length();
    while (i < n) { if (a.data()[i] == '+') plus = i; i++; }
    if (plus >= 0) return substring(a, plus + 1, n - plus - 1);
    return "" + a;
}

// The NSMenuItem key equivalent NSString for an accel: a lowercase letter, or the
// Unicode function-key char for F1..F12 (NSF1FunctionKey = 0xF704) built directly
// from the unichar via stringWithCharacters:length: (a hand-encoded UTF-8 PUA byte
// sequence does not round-trip through stringWithUTF8String:), else [NSString string].
void* _accelKeyEquivObj(string a)
{
    string k = _accelKeyToken(a);
    int kn = (int)k.length();
    if (kn == 1)
    {
        char c = k.data()[0];
        char[2] b;
        b[0] = (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c;
        b[1] = '\0';
        return nsStr(b);
    }
    if (kn >= 2 && (k.data()[0] == 'F' || k.data()[0] == 'f'))
    {
        int num = atoi(k.data() + 1);
        if (num >= 1 && num <= 12)
        {
            u16 uc = (u16)(0xF704 + (num - 1));
            return msg2(cls("NSString"), "stringWithCharacters:length:", (void*)&uc, (void*)1);
        }
    }
    return msg0(cls("NSString"), "string");
}

// The key-equivalent modifier mask for an accel. F-keys carry no modifier of their
// own; Ctrl maps to Cmd.
int _accelMask(string a)
{
    string k = _accelKeyToken(a);
    if (k.length() >= 2 && (k.data()[0] == 'F' || k.data()[0] == 'f')) return 0;
    int m = 0;
    if (strContains(a, "Ctrl"))  m = m | MOD_CMD;
    if (strContains(a, "Shift")) m = m | MOD_SHIFT;
    if (strContains(a, "Alt"))   m = m | MOD_ALT;
    return m;
}

// Realize the declared menu into the application main menu. Slot 0 is a leading app
// menu with Quit (Cmd+Q) routed through the close guard via performClose: on the
// main window; the rest mirror the declared top-level menus + items.
void buildMenuBar()
{
    if (_menuBuilt) return;   // app-wide main menu; realize the declaration once
    _menuBuilt = true;
    if (_menuTarget == nullptr) _menuTarget = msg0(msg0(cls("CfHostTarget"), "alloc"), "init");
    void* app = msg0(cls("NSApplication"), "sharedApplication");
    void* mainMenu = msg0(msg0(cls("NSMenu"), "alloc"), "init");

    // App menu (slot 0): the system shows the process name; Quit -> performClose:.
    void* appItem = msg0(msg0(cls("NSMenuItem"), "alloc"), "init");
    msg1(mainMenu, "addItem:", appItem);
    void* appMenu = msg0(msg0(cls("NSMenu"), "alloc"), "init");
    msg1(appItem, "setSubmenu:", appMenu);
    void* quit = msg3(msg0(cls("NSMenuItem"), "alloc"), "initWithTitle:action:keyEquivalent:",
                      nsStr("Quit"), sel("performClose:"), nsStr("q"));
    msg1(quit, "setTarget:", nullptr);   // travel the responder chain -> the KEY window
    msgInt(quit, "setKeyEquivalentModifierMask:", (i64)MOD_CMD);
    msg1(appMenu, "addItem:", quit);

    int t = 0;
    while (t < _menuTop.count())
    {
        void* topItem = msg0(msg0(cls("NSMenuItem"), "alloc"), "init");
        msg1(topItem, "setTitle:", nsStr(_menuTop.get(t).data()));
        msg1(mainMenu, "addItem:", topItem);
        void* sub = msg1(msg0(cls("NSMenu"), "alloc"), "initWithTitle:", nsStr(_menuTop.get(t).data()));
        msg1(topItem, "setSubmenu:", sub);

        int i = 0;
        while (i < _menuItemTopIdx.count())
        {
            if (_menuItemTopIdx.get(i) == t)
            {
                if (_menuItemLabel.get(i).length() == 0)
                {
                    msg1(sub, "addItem:", msg0(cls("NSMenuItem"), "separatorItem"));
                }
                else
                {
                    string accel = _menuAccel.get(i);
                    void* keqObj = _accelKeyEquivObj(accel);
                    void* item = msg3(msg0(cls("NSMenuItem"), "alloc"), "initWithTitle:action:keyEquivalent:",
                                      _nsStrSafe(_menuItemLabel.get(i)), sel("onMenu:"), keqObj);
                    // App-wide menu target: _onMenuImp ignores `self` and resolves the
                    // servicing window from the key window, so one target serves every window.
                    msg1(item, "setTarget:", _menuTarget);
                    msgInt(item, "setTag:", (i64)_menuItemCmd.get(i));
                    if (accel.length() > 0)
                        msgInt(item, "setKeyEquivalentModifierMask:", (i64)_accelMask(accel));
                    msg1(sub, "addItem:", item);
                }
            }
            i++;
        }
        t++;
    }

    msg1(app, "setMainMenu:", mainMenu);
}

// A menu command / accelerator fired: dispatch it to the app's handler, then pump.
void routeMenu(int id)
{
    if (id <= 0) return;
    _menuHandler(id);
    pumpNative();
}

