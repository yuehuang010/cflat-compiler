// interp.cb - one-dimensional interpolation and regular-grid bilinear rules.
 //
 // Spline construction uses the Thomas tridiagonal algorithm. Spline lookup
 // uses binary search so repeated evaluations remain logarithmic in the grid size.
 import "math.cb";
 
 namespace Interp
 {
     int _interval(double[] xs, int n, double x)
     {
         if (x <= xs[0]) return 0;
         if (x >= xs[n - 1]) return n - 2;
         int low = 0;
         int high = n - 1;
         while (high - low > 1)
         {
             int middle = (low + high) / 2;
             if (xs[middle] <= x) low = middle;
             else high = middle;
         }
         return low;
     }
 
     double linear(double[] xs, double[] ys, int n, double x)
     {
         if (n <= 0) return 0.0;
         if (n == 1) return ys[0];
         int i = _interval(xs, n, x);
         return ys[i] + (ys[i + 1] - ys[i]) * (x - xs[i])
              / (xs[i + 1] - xs[i]);
     }
 
     double nearest(double[] xs, double[] ys, int n, double x)
     {
         if (n <= 0) return 0.0;
         if (n == 1) return ys[0];
         int i = _interval(xs, n, x);
         if (i == n - 2 && x > xs[i + 1]) return ys[i + 1];
         return Math.abs(x - xs[i]) <= Math.abs(x - xs[i + 1]) ? ys[i] : ys[i + 1];
     }
 
     double lagrange(double[] xs, double[] ys, int n, double x)
     {
         double sum = 0.0;
         for (int i = 0; i < n; i = i + 1)
         {
             double term = ys[i];
             for (int j = 0; 
j < n; j = j + 1)
                 if (i != j) term = term * (x - xs[j]) / (xs[i] - xs[j]);
             sum = sum + term;
         }
         return sum;
     }
 
     void _spline(double[] xs, double[] ys, int n, double d0, double dn,
                  bool clamped, double[] out)
     {
         if (n < 2) return;
         int intervals = n - 1;
         double[] lower = new double[n];
         double[] diagonal = new double[n];
         double[] upper = new double[n];
         double[] rhs = new double[n];
         double[] curvature = new double[n];
         for (int i = 0; i < n; i = i + 1)
         {
             lower[i] = 0.0;
             diagonal[i] = 1.0;
             upper[i] = 0.0;
             rhs[i] = 0.0;
         }
         for (int i = 1; i < n - 1; i = i + 1)
         {
             double left_h = xs[i] - xs[i - 1];
             double right_h = xs[i + 1] - xs[i];
             lower[i] = left_h;
             diagonal[i] = 2.0 * (left_h + right_h);
             upper[i] = right_h;
             rhs[i] = 6.0 * ((ys[i + 1] - ys[i]) / right_h
                           - (ys[i] - ys[i - 1]) / left_h);
         }
         if (clamped)
         {
             double first_h = xs[1] - xs[0];
             double last_h = xs[n - 1] - xs[n - 2];
             diagonal[0] = 2.0 * first_h;
             upper[0] = first_h;
             rhs[0] = 6.0 * ((ys[1] - ys[0]) / first_h - d0);
             lower[n - 1] = last_h;
             diagonal[n - 1] = 2.0 * last_h;
       
      rhs[n - 1] = 6.0 * (dn - (ys[n - 1] - ys[n - 2]) / last_h);
         }
         for (int i = 1; i < n; i = i + 1)
         {
             double factor = lower[i] / diagonal[i - 1];
             diagonal[i] = diagonal[i] - factor * upper[i - 1];
             rhs[i] = rhs[i] - factor * rhs[i - 1];
         }
         curvature[n - 1] = rhs[n - 1] / diagonal[n - 1];
         for (int i = n - 2; i >= 0; i = i - 1)
             curvature[i] = (rhs[i] - upper[i] * curvature[i + 1]) / diagonal[i];
         for (int i = 0; i < intervals; i = i + 1)
         {
             double width = xs[i + 1] - xs[i];
             out[4 * i] = ys[i];
             out[4 * i + 1] = (ys[i + 1] - ys[i]) / width
                            - width * (2.0 * curvature[i] + curvature[i + 1]) / 6.0;
             out[4 * i + 2] = curvature[i] * 0.5;
             out[4 * i + 3] = (curvature[i + 1] - curvature[i]) / (6.0 * width);
         }
         delete[_] lower;
         delete[_] diagonal;
         delete[_] upper;
         delete[_] rhs;
         delete[_] curvature;
     }
 
     void spline_build_natural(double[] xs, double[] ys, int n, double[] coefficients)
     {
         _spline(xs, ys, n, 0.0, 0.0, false, coefficients);
     }
 
     void spline_build_clamped(double[] xs, double[] ys, int n, double d0, double dn,
                               double[] coefficients)
     {
         _spline(xs, ys, n, d0, dn, true, coefficients);
     }
 
     double spline_eval(double[] xs, int n, double[] coefficients, double x)
     {
         if (n < 2) return n == 1 ? coefficients[0] : 0.0;
         int i = _interval(xs, n, x);
         double dx = x - xs[i];
         return ((coefficients[4 * i + 3] * dx + coefficients[4 * i + 2]) * dx
                + coefficients[4 * i + 1]) * dx + coefficients[4 * i];
     }
 
     double bilinear(double[] grid, int width, int height, double x, double y)
     {
         if (width <= 0 || height <= 0) return 0.0;
         if (width == 1 || height == 1) return grid[0];
         if (x < 0.0) x = 0.0;
         if (y < 0.0) y = 0.0;
         if (x > (double)(width - 1)) x = (double)(width - 1);
         if (y > (double)(height - 1)) y = (double)(height - 1);
         int ix = (int)x;
         int iy = (int)y;
         if (ix == width - 1) ix = width - 2;
         if (iy == height - 1) iy = height - 2;
         double tx = x - (double)ix;
         double ty = y - (double)iy;
         double a = grid[iy * width + ix];
         double b = grid[iy * width + ix + 1];
         double c = grid[(iy + 1) * width + ix];
         double d = grid[(iy + 1) * width + ix + 1];
         return (1.0 - ty) * ((1.0 - tx) * a + tx * b)
              + ty * ((1.0 - tx) * c + tx * d);
     }
 }
