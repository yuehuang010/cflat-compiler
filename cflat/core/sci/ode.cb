// ode.cb - allocation-free ODE steppers.
 //
 // rk4_step(vector) requires scratch[5*n]; rk45_step requires scratch[10*n]
 // (Runge-Kutta stages, one stage-state buffer, and the two solution vectors).
 // The derivative callback f must NOT assume y and dydt may alias - they never do.
 // The caller owns these arrays; both steppers use them for Runge-Kutta stages.
 // Verlet is symplectic and is preferable when long-run energy drift matters.
 import "math.cb";
 
 namespace Ode
 {
     double rk4_step(Lambda<double(double, double)> f, double t, double y, double h)
     {
         double k1 = f(t, y);
         double k2 = f(t + h * 0.5, y + h * k1 * 0.5);
         double k3 = f(t + h * 0.5, y + h * k2 * 0.5);
         double k4 = f(t + h, y + h * k3);
         return y + h * (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0;
     }
 
     void rk4_step(Lambda<void(double, double*, double*, int)> f, double t,
                   double[] y, int n, double h, double[] scratch)
     {
         double* k1 = (double*)scratch;
         double* k2 = k1 + n;
         double* k3 = k1 + 2 * n;
         double* k4 = k1 + 3 * n;
         double* tmp = k1 + 4 * n;
         // The stage state goes in tmp, never in the k buffer being written:
         // f may not alias its y and dydt arguments.
         f(t, y, k1, n);
         for (int i = 0; i < n; i = i + 1)
             tmp[i] = y[i] + h * k1[i] * 0.5;
         f(t + h * 0.5, tmp, k2, n);
         for (int i = 0; i < n; i = i + 1)
             tmp[i] = y[i] + h * k2[i] * 0.5;
         f(t + h * 0.5, tmp, k3, n);
         for (int i = 0; i < n; i = i + 1)
             tmp[i] = y[i] + h * k3[i];
         f(t + h, tmp, k4, n);
         for (int i = 0; i < n; i = i + 1)
             y[i] = y[i] + h * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]) / 6.0;
     }
 
     double _error(double* y5, double* y4, int n, double abstol, double reltol)
     {
         double maximum = 0.0;
         for (int i = 0; i < n; i = i + 1)
         {
             double scale = abstol + reltol * Math.abs(y5[i]);
             if (scale <= 0.0) scale = 0.000000000000001;
             double error = Math.abs(y5[i] - y4[i]) / scale;
             if (error > maximum) maximum = error;
         }
         return maximum;
     }
 
     double rk45_step(Lambda<void(double, double*, double*, int)> f, double* t,
                      double[] y, int n, double h_try, double abstol, double reltol,
                      double[] scratch)
     {
         double* k1 = (double*)scratch;
         double* k2 = k1 + n;
         double* k3 = k1 + 2 * n;
         double* k4 = k1 + 3 * n;
         double* k5 = k1 + 4 * n;
         double* k6 = k1 + 5 * n;
         double* k7 = k1 + 6 * n;
         double* tmp = k1 + 7 * n;
         double* y5 = k1 + 8 * n;
         double* y4 = k1 + 9 * n;
         double h = h_try;
         int tries = 0;
         while (tries < 64)
         {
             // Dormand-Prince 5(4). The stage state always goes in tmp: f may
             // not alias its y and dydt arguments.
             f(t[0], y, k1, n);
             for (int i = 0; i < n; i = i + 1)
                 tmp[i] = y[i] + h * (1.0 / 5.0) * k1[i];
             f(t[0] + h * (1.0 / 5.0), tmp, k2, n);
             for (int i = 0; i < n; i = i + 1)
                 tmp[i] = y[i] + h * (3.0 / 40.0 * k1[i] + 9.0 / 40.0 * k2[i]);
             f(t[0] + h * (3.0 / 10.0), tmp, k3, n);
             for (int i = 0; i < n; i = i + 1)
                 tmp[i] = y[i] + h * (44.0 / 45.0 * k1[i]
                                      - 56.0 / 15.0 * k2[i] + 32.0 / 9.0 * k3[i]);
             f(t[0] + h * (4.0 / 5.0), tmp, k4, n);
             for (int i = 0; i < n; i = i + 1)
                 tmp[i] = y[i] + h * (19372.0 / 6561.0 * k1[i]
                                      - 25360.0 / 2187.0 * k2[i]
                                      + 64448.0 / 6561.0 * k3[i]
                                      - 212.0 / 729.0 * k4[i]);
             f(t[0] + h * (8.0 / 9.0), tmp, k5, n);
             for (int i = 0; i < n; i = i + 1)
                 tmp[i] = y[i] + h * (9017.0 / 3168.0 * k1[i]
                                      - 355.0 / 33.0 * k2[i]
                                      + 46732.0 / 5247.0 * k3[i]
                                      + 49.0 / 176.0 * k4[i]
                                      - 5103.0 / 18656.0 * k5[i]);
             f(t[0] + h, tmp, k6, n);
             // 5th-order solution; also the 7th stage state (FSAL).
             for (int i = 0; i < n; i = i + 1)
                 y5[i] = y[i] + h * (35.0 / 384.0 * k1[i]
                                      + 500.0 / 1113.0 * k3[i]
                                      + 125.0 / 192.0 * k4[i]
                                      - 2187.0 / 6784.0 * k5[i]
                                      + 11.0 / 84.0 * k6[i]);
             f(t[0] + h, y5, k7, n);
             for (int i = 0; i < n; i = i + 1)
                 y4[i] = y[i] + h * (5179.0 / 57600.0 * k1[i]
                                      + 7571.0 / 16695.0 * k3[i]
                                      + 393.0 / 640.0 * k4[i]
                                      - 92097.0 / 339200.0 * k5[i]
                                      + 187.0 / 2100.0 * k6[i]
                                      + 1.0 / 40.0 * k7[i]);
             double error = _error(y5, y4, n, abstol, reltol);
             if (error <= 1.0 || Math.abs(h) < 0.000000000000001)
             {
                 for (int i = 0; i < n; i = i + 1) y[i] = y5[i];
                 t[0] = t[0] + h;
                 return h;
             }
             double factor = 0.9 * Math.pow(1.0 / error, 0.2);
             if (factor < 0.1) factor = 0.1;
             if (factor > 0.5) factor = 0.5;
             h = h * factor;
             tries = tries + 1;
         }
         return 0.0;
     }
 
     void verlet_step(Lambda<void(double*, double*, int)> accel, double[] pos,
                      double[] vel, double[] acc, int n, double h)
     {
         accel(pos, acc, n);
         for (int i = 0; i < n; i = i + 1) vel[i] = vel[i] + 0.5 * h * acc[i];
         for (int i = 0; i < n; i = i + 1) pos[i] = pos[i] + h * vel[i];
         accel(pos, acc, n);
         for (int i = 0; i < n; i = i + 1) vel[i] = vel[i] + 0.5 * h * acc[i];
     }
 }
