// special.cb - portable special functions and common distribution CDFs.
//
// erf/erfc forward to libm, which supplies them on all three targets (MSVC
// UCRT, glibc, macOS libm) at full double accuracy. lgamma is implemented
// here with Lanczos rather than forwarded: the libc lgamma writes the
// `signgam` global and is not thread-safe everywhere. The CDFs use
// regularized beta/gamma fractions.
//
// A polynomial approximation was deliberately NOT used for erf/erfc. The
// classic Abramowitz-Stegun 7.1.26 fit carries ~1.5e-7 absolute error, which
// is single-precision accuracy on a double API and leaves erfc - and so
// normal_cdf - meaningless in the tail (erfc(6) is ~2e-17, far below the
// error term). Do not reintroduce it.

import "math.cb";

// Error function and its complement, from libm.
extern double erf(double a);
extern double erfc(double a);

namespace Special
{
    double erf(double x) { return global::erf(x); }

    double erfc(double x) { return global::erfc(x); }

    double erfinv(double x)
    {
        if (x <= -1.0) return -1.0e308;
        if (x >= 1.0) return 1.0e308;
        double a = 0.147;
        double ln = Math.log(1.0 - x * x);
        double first = 2.0 / (Math.PI * a) + ln / 2.0;
        double guess = Math.copysign(Math.sqrt(Math.sqrt(first * first - ln / a) - first), x);
        int i = 0;
        while (i < 5)
        {
            double derivative = 1.1283791670955126 * Math.exp(-guess * guess);
            if (derivative == 0.0) break;
            guess = guess - (Special.erf(guess) - x) / derivative;
            i = i + 1;
        }
        return guess;
    }

    double lgamma(double x)
    {
        if (x < 0.5)
            return Math.log(Math.PI) - Math.log(Math.abs(Math.sin(Math.PI * x)))
                 - Special.lgamma(1.0 - x);
        double z = x - 1.0;
        double sum = 0.99999999999980993;
        sum = sum + 676.5203681218851 / (z + 1.0);
        sum = sum - 1259.1392167224028 / (z + 2.0);
        sum = sum + 771.32342877765313 / (z + 3.0);
        sum = sum - 176.61502916214059 / (z + 4.0);
        sum = sum + 12.507343278686905 / (z + 5.0);
        sum = sum - 0.13857109526572012 / (z + 6.0);
        sum = sum + 9.9843695780195716e-6 / (z + 7.0);
        sum = sum + 1.5056327351493116e-7 / (z + 8.0);
        double t = z + 7.5;
        return 0.9189385332046727 + (z + 0.5) * Math.log(t) - t + Math.log(sum);
    }

    double tgamma(double x)
    {
        if (x < 0.5)
            return Math.PI / (Math.sin(Math.PI * x) * Math.exp(Special.lgamma(1.0 - x)));
        return Math.exp(Special.lgamma(x));
    }

    double digamma(double x)
    {
        if (x <= 0.0)
            return Special.digamma(1.0 - x) - Math.PI / Math.tan(Math.PI * x);
        double result = 0.0;
        while (x < 8.0)
        {
            result = result - 1.0 / x;
            x = x + 1.0;
        }
        double inv = 1.0 / x;
        double inv2 = inv * inv;
        return result + Math.log(x) - 0.5 * inv - inv2 * (1.0 / 12.0
            - inv2 * (1.0 / 120.0 - inv2 / 252.0));
    }

    double beta(double a, double b)
    {
        return Math.exp(Special.lgamma(a) + Special.lgamma(b) - Special.lgamma(a + b));
    }

    double _beta_cf(double a, double b, double x)
    {
        double qab = a + b;
        double qap = a + 1.0;
        double qam = a - 1.0;
        double c = 1.0;
        double d = 1.0 - qab * x / qap;
        if (Math.abs(d) < 1.0e-300) d = 1.0e-300;
        d = 1.0 / d;
        double h = d;
        int m = 1;
        while (m <= 200)
        {
            double m2 = (double)(2 * m);
            double aa = (double)m * (b - (double)m) * x / ((qam + m2) * (a + m2));
            d = 1.0 + aa * d;
            if (Math.abs(d) < 1.0e-300) d = 1.0e-300;
            c = 1.0 + aa / c;
            if (Math.abs(c) < 1.0e-300) c = 1.0e-300;
            d = 1.0 / d;
            h = h * d * c;
            aa = -(a + (double)m) * (qab + (double)m) * x
               / ((a + m2) * (qap + m2));
            d = 1.0 + aa * d;
            if (Math.abs(d) < 1.0e-300) d = 1.0e-300;
            c = 1.0 + aa / c;
            if (Math.abs(c) < 1.0e-300) c = 1.0e-300;
            d = 1.0 / d;
            double delta = d * c;
            h = h * delta;
            if (Math.abs(delta - 1.0) < 3.0e-14) break;
            m = m + 1;
        }
        return h;
    }

    double _regularized_beta(double a, double b, double x)
    {
        if (x <= 0.0) return 0.0;
        if (x >= 1.0) return 1.0;
        double front = Math.exp(a * Math.log(x) + b * Math.log(1.0 - x)
            - Special.lgamma(a) - Special.lgamma(b) + Special.lgamma(a + b));
        if (x < (a + 1.0) / (a + b + 2.0))
            return front * Special._beta_cf(a, b, x) / a;
        return 1.0 - front * Special._beta_cf(b, a, 1.0 - x) / b;
    }

    double _regularized_gamma(double a, double x)
    {
        if (x <= 0.0) return 0.0;
        if (x < a + 1.0)
        {
            double sum = 1.0 / a;
            double term = sum;
            int n = 1;
            while (n <= 200)
            {
                term = term * x / (a + (double)n);
                sum = sum + term;
                if (Math.abs(term) < Math.abs(sum) * 3.0e-14) break;
                n = n + 1;
            }
            return sum * Math.exp(-x + a * Math.log(x) - Special.lgamma(a));
        }

        double b = x + 1.0 - a;
        double c = 1.0 / 1.0e-300;
        double d = 1.0 / b;
        double h = d;
        int i = 1;
        while (i <= 200)
        {
            double an = -(double)i * ((double)i - a);
            b = b + 2.0;
            d = an * d + b;
            if (Math.abs(d) < 1.0e-300) d = 1.0e-300;
            c = b + an / c;
            if (Math.abs(c) < 1.0e-300) c = 1.0e-300;
            d = 1.0 / d;
            double delta = d * c;
            h = h * delta;
            if (Math.abs(delta - 1.0) < 3.0e-14) break;
            i = i + 1;
        }
        return 1.0 - Math.exp(-x + a * Math.log(x) - Special.lgamma(a)) * h;
    }

    double normal_pdf(double x, double mean, double stddev)
    {
        double z = (x - mean) / stddev;
        return Math.exp(-0.5 * z * z) / (stddev * 2.5066282746310002);
    }

    double normal_cdf(double x, double mean, double stddev)
    {
        double z = (x - mean) / (stddev * 1.4142135623730951);
        if (z >= 0.0) return 1.0 - 0.5 * Special.erfc(z);
        return 0.5 * Special.erfc(-z);
    }

    double normal_quantile(double p)
    {
        double one = 1.0;
        double zero = 0.0;
        double infinity = one / zero;
        if (p <= 0.0) return -infinity;
        if (p >= 1.0) return infinity;
        if (p == 0.5) return 0.0;
        // Reflect the upper half onto the lower, so only p < 0.5 is bracketed
        // below and the quantile is always found on the accurate left tail.
        if (p > 0.5) return -Special.normal_quantile(1.0 - p);
        double lo = -1.0;
        double hi = 1.0;
        while (Special.normal_cdf(lo, 0.0, 1.0) > p) lo = lo * 2.0;
        int i = 0;
        while (i < 200)
        {
            double mid = (lo + hi) * 0.5;
            // Stop once the bracket is down to one ulp: further halving cannot
            // move mid, and each step costs an erfc evaluation.
            if (mid <= lo || mid >= hi) break;
            if (Special.normal_cdf(mid, 0.0, 1.0) >= p) hi = mid;
            else lo = mid;
            i = i + 1;
        }
        return (lo + hi) * 0.5;
    }

    double student_t_cdf(double t, double df)
    {
        if (t == 0.0) return 0.5;
        double z = df / (df + t * t);
        double tail = 0.5 * Special._regularized_beta(df / 2.0, 0.5, z);
        return t > 0.0 ? 1.0 - tail : tail;
    }

    double chi2_cdf(double x, double df)
    {
        return Special._regularized_gamma(df / 2.0, x / 2.0);
    }
}
