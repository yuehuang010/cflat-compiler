// core/ui_canvas/win32.cb - the Win32 GDI canvas host for the ui_native.cb framework.
//
// This is the Win32 instance of the host loop shape ui_canvas/term.cb implements
// for the terminal: input -> dispatch (handleClick) -> drain dirty -> render ->
// reconcile -> repaint only what changed. The framework (IElement tree, reconciler,
// model layer) is reused UNCHANGED; the only thing that differs from the TUI host
// is the draw target (GdiCanvas instead of SurfaceCanvas) and the message pump.
// Contrast with ui_native/win32.cb, which drives REAL Win32 controls through the
// separate INativeHost seam rather than painting an IElement tree via ICanvas.
//
// A size-aware component reads hostWidth()/hostHeight() in its render() - the
// model-layer equivalent of a "useWindowSize()" hook - so the same tree rescales
// when the window is resized. See example/ui/03-canvas-win32/win32_boxes.cb for a demo.
//
// This file has no main(); it is imported by an app file that calls runAppGui().
import "windows.h" lib { "user32.lib", "gdi32.lib" } cache;
import "ui_native.cb";

// Layout is in CHARACTER CELLS; GdiCanvas maps a cell to this many pixels. Hit
// testing divides mouse pixels by the same constants, so clicks land on the cell
// the layout drew.
const int CELL_W = 9;
const int CELL_H = 18;

// Current window size in CELLS. Size-aware components read these in render().
int _gTermW = 80;
int _gTermH = 25;

int hostWidth()  { return _gTermW; }
int hostHeight() { return _gTermH; }

// Convert a framework color to a Win32 COLORREF (0x00BBGGRR). The masks drop the
// rgb() marker bit; an unresolved 0 maps to black, matching the monochrome host.
u32 colorRef(int color)
{
    int r = (color >> 16) & 0xFF;
    int g = (color >> 8) & 0xFF;
    int b = color & 0xFF;
    return (u32)(r | (g << 8) | (b << 16));
}

// A crisp monospace UI font sized to the cell. Monospace is deliberate: the layout
// places text by CELL, so a fixed-pitch face keeps glyphs aligned to box borders
// and the TextInput caret (a proportional font would drift). The caller selects it
// into the DC for the duration of a paint and DeleteObject()s it after.
void* createUiFont()
{
    return CreateFontA(CELL_H - 3, 0, 0, 0, FW_NORMAL,
                       0u, 0u, 0u,
                       (u32)ANSI_CHARSET, (u32)OUT_DEFAULT_PRECIS,
                       (u32)CLIP_DEFAULT_PRECIS, (u32)CLEARTYPE_QUALITY,
                       (u32)(FIXED_PITCH | FF_MODERN), "Consolas");
}

// The running app, its committed tree, and the UiContext (dirty flag + focused
// node), reached from the free-function WndProc (a stdcall callback cannot
// capture `this`). Single window / single thread, so these host globals are the
// right tool here, and they live in the HOST file, not the framework library.
// _gReady guards the tree before the first build (WM_SIZE) and after teardown
// (WM_DESTROY).
IComponent _gApp   = default;
IElement   _gTree  = default;
UiContext _gCtx   = default;
bool      _gReady = false;
string    _gCanvasCaptureKey = default;
double    _gCanvasLastX = 0.0;
double    _gCanvasLastY = 0.0;
// The live window, so the canvas dispatch helpers (and the test seams, which have no hwnd in
// scope) repaint THIS window. InvalidateRect(NULL) would redraw every window on the desktop.
void*     _gCanvasHwnd = nullptr;

// Drain the dirty/repaint flags after an input event: re-render + reconcile when
// state changed, and repaint when the diff produced patches OR a node requested a
// repaint without a tree change (e.g. a ScrollView offset). Shared by the mouse
// and key paths.
void pumpAfterInput(void* hwnd)
{
    bool needPaint = false;
    if (_gCtx.consumeDirty())
    {
        IElement wip = _gApp.render(&_gCtx);
        list<Patch> patches = default;
        _gTree = reconcile(_gTree, wip, &patches);
        if (patches.count() > 0) needPaint = true;
    }
    if (_gCtx.consumeRepaint()) needPaint = true;
    if (needPaint)
    {
        layoutRoot(_gTree, 0, 0, _gTermW);
        // A headless seam drive has no window; InvalidateRect(NULL) would invalidate the
        // whole desktop, so skip the repaint instead.
        if (hwnd != nullptr) InvalidateRect(hwnd, nullptr, 1);
    }
}

// -- GdiCanvas: the GDI implementation of the ICanvas draw interface -------------
// Holds the device context for the current WM_PAINT plus the cell size. drawText
// uses DrawTextA (left-aligned, single line); drawRect frames or fills a cell
// rectangle with a stock black brush. Borrows the HDC - owns no GDI objects.
class GdiCanvas : ICanvas
{
    void* hdc = nullptr;
    int cellW = CELL_W;
    int cellH = CELL_H;

    void clear() { }   // the window background is erased by the default WM_ERASEBKGND

    void drawText(int col, int row, const char* s, int color)
    {
        RECT rc = default;
        rc.left   = col * this.cellW;
        rc.top    = row * this.cellH;
        rc.right  = rc.left + 4096;        // wide; single line is left-clipped to it
        rc.bottom = rc.top + this.cellH;
        SetBkMode(this.hdc, TRANSPARENT);
        SetTextColor(this.hdc, colorRef(color));   // -1 -> black
        DrawTextA(this.hdc, (char*)s, -1, &rc,
                  (u32)(DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX));
    }

    void drawRect(Rect r, bool filled, int color)
    {
        RECT rc = default;
        rc.left   = r.x * this.cellW;
        rc.top    = r.y * this.cellH;
        rc.right  = (r.x + r.w) * this.cellW;
        rc.bottom = (r.y + r.h) * this.cellH;

        // Default color (0) keeps the original stock-black-brush path byte for
        // byte, so the offscreen self-test pixels are unchanged. An explicit color
        // allocates a solid brush for the fill/frame and frees it.
        if (color == 0)
        {
            void* br = GetStockObject(BLACK_BRUSH);
            if (filled) { FillRect(this.hdc, &rc, br); return; }
            FrameRect(this.hdc, &rc, br);
            return;
        }
        void* br = CreateSolidBrush(colorRef(color));
        if (filled) FillRect(this.hdc, &rc, br);
        else        FrameRect(this.hdc, &rc, br);
        DeleteObject(br);
    }

    // Clip in GDI: SaveDC the current clip region, intersect with the cell rect
    // (in pixels); popClip restores the most recently saved state. Nesting is
    // handled by the DC save stack, so push/pop must stay balanced.
    void pushClip(Rect r)
    {
        SaveDC(this.hdc);
        IntersectClipRect(this.hdc, r.x * this.cellW, r.y * this.cellH,
                          (r.x + r.w) * this.cellW, (r.y + r.h) * this.cellH);
    }

    void popClip() { RestoreDC(this.hdc, -1); }

    // Blit a canvas image (an HBITMAP handle from canvasCreateImage) into a device-pixel
    // rect. This host has no dpi scale factor (unlike ui_native/win32.cb's NativeGdiCanvas)
    // - dx/dy/dw/dh are already device pixels, matching drawText/drawRect above. The source
    // extent is recovered from the bitmap itself (GetObjectA), so no side registry is kept.
    void drawImage(u64 img, double dx, double dy, double dw, double dh)
    {
        if (img == 0u || this.hdc == nullptr) return;
        BITMAP bm = default;
        if (GetObjectA((void*)img, (i32)sizeof(BITMAP), &bm) == 0) return;
        int srcW = bm.bmWidth;
        int srcH = bm.bmHeight;
        if (srcW <= 0 || srcH <= 0) return;
        int x0 = (int)dx;
        int y0 = (int)dy;
        int x1 = (int)(dx + dw);
        int y1 = (int)(dy + dh);
        if (x1 - x0 <= 0 || y1 - y0 <= 0) return;
        void* memDC = CreateCompatibleDC(this.hdc);
        if (memDC == nullptr) return;
        void* oldBmp = SelectObject(memDC, (void*)img);
        SetStretchBltMode(this.hdc, (int)COLORONCOLOR);
        StretchBlt(this.hdc, x0, y0, x1 - x0, y1 - y0,
                   memDC, 0, 0, srcW, srcH, (u32)SRCCOPY);
        SelectObject(memDC, oldBmp);
        DeleteDC(memDC);
    }
};

// GDI API used by canvasCreateImage that the windows.h binding may not surface;
// declared by hand to match the Win32 signature (mirrors ui_native/win32.cb).
extern stdcall void* CreateDIBSection(void* hdc, void* pbmi, u32 usage, void** bits, void* sect, u32 off);

// A 40-byte BITMAPINFOHEADER (no color table for 32bpp BI_RGB). A negative biHeight
// makes the DIB top-down, matching the caller's top-down BGRA32 buffer.
struct BmiHeader
{
    u32 biSize        = 40u;
    i32 biWidth       = 0;
    i32 biHeight      = 0;
    u16 biPlanes      = 1;
    u16 biBitCount    = 32;
    u32 biCompression = 0u;
    u32 biSizeImage   = 0u;
    i32 biXPelsPerM   = 0;
    i32 biYPelsPerM   = 0;
    u32 biClrUsed     = 0u;
    u32 biClrImportant = 0u;
};

// canvasCreateImage copies the caller's top-down BGRA32 buffer into a 32bpp DIB section
// (so the caller may free its buffer immediately) and returns the HBITMAP as the handle.
// drawImage recovers the source extent from the bitmap itself (GetObjectA), so no side
// registry is needed - a list<> registry would leak its backing buffer at exit and trip
// --heap-audit. canvasReleaseImage deletes the bitmap.
u64 canvasCreateImage(u64 bgraPixels, int w, int h)
{
    if (bgraPixels == 0u || w <= 0 || h <= 0) return 0u;
    void* dc = GetDC(nullptr);
    BmiHeader bi = default;
    bi.biSize = 40u; bi.biWidth = w; bi.biHeight = 0 - h;   // negative = top-down
    bi.biPlanes = 1; bi.biBitCount = 32; bi.biCompression = 0u;
    void* bits = nullptr;
    void* bmp = CreateDIBSection(dc, &bi, (u32)DIB_RGB_COLORS, &bits, nullptr, 0u);
    ReleaseDC(nullptr, dc);
    if (bmp == nullptr || bits == nullptr) return 0u;
    memcpy(bits, (void*)bgraPixels, (i64)(w * h * 4));
    return (u64)bmp;
}

void canvasReleaseImage(u64 img)
{
    if (img == 0u) return;
    DeleteObject((void*)img);
}

// Free the old tree (if any) and render a fresh one at the current cell size.
// A resize produces no reconcile patches (the size flows in through render()), so
// like boxes.cb we rebuild + full-repaint rather than diff.
void rebuildTree()
{
    if (_gReady) { deleteTree(_gTree); _gReady = false; }
    _gTree = _gApp.render(&_gCtx);
    layoutRoot(_gTree, 0, 0, _gTermW);
    _gReady = true;
}

IElement _gFindByKey(IElement node, string path, string want)
{
    if (node == nullptr) return nullptr;
    if (path == want) return node;
    list<IElement>* kids = node.childList();
    if (kids == nullptr) return nullptr;
    int i = 0;
    while (i < kids.count())
    {
        IElement c = kids.get(i);
        IElement found = _gFindByKey(c, joinKeyPath(path, keySegment(c, i)), want);
        if (found != nullptr) return found;
        i++;
    }
    return nullptr;
}

// Find the top-most CanvasView at a cell coordinate. ScrollView is the only container whose
// children may lie outside its visible bounds; prune it so an off-screen canvas cannot win.
string _gCanvasScan(IElement node, string path, int cx, int cy)
{
    if (node.kind() == ELEM_SCROLL && !node.nodeBounds().contains(cx, cy)) return "";
    if (node.kind() == ELEM_CANVAS && node.nodeBounds().contains(cx, cy)) return "" + path;
    list<IElement>* kids = node.childList();
    if (kids == nullptr) return "";
    int i = kids.count() - 1;
    while (i >= 0)
    {
        IElement c = kids.get(i);
        string found = _gCanvasScan(c, joinKeyPath(path, keySegment(c, i)), cx, cy);
        if (found.length() > 0) return found;
        i--;
    }
    return "";
}

ICanvasView _gCanvasForKey(string key)
{
    if (!_gReady || key.length() == 0) return nullptr;
    IElement e = _gFindByKey(_gTree, keySegment(_gTree, 0), key);
    if (e == nullptr) return nullptr;
    return e as ICanvasView;
}

int _gCanvasButtons(u64 wParam)
{
    int b = 0;
    if ((wParam & (u64)MK_LBUTTON) != 0u) b = b | 1;
    if ((wParam & (u64)MK_RBUTTON) != 0u) b = b | 2;
    return b;
}

// The GDI canvas host has no dpi/points scale: drawImage receives device pixels 1:1, and
// drawText/drawRect expand layout cells by CELL_W/CELL_H. Handler coordinates use those same
// device pixels relative to the CanvasView's top-left, y down.
bool _gDispatchCanvasPointer(string key, int phase, int px, int py, int buttons)
{
    ICanvasView cv = _gCanvasForKey(key);
    if (cv == nullptr) return false;
    Rect b = cv.nodeBounds();
    double x = (double)(px - b.x * CELL_W);
    double y = (double)(py - b.y * CELL_H);
    // Remember the CLIENT point, not the canvas-relative one: _gCanvasCaptureLost feeds it
    // back through this same helper, which subtracts the canvas origin again.
    _gCanvasLastX = (double)px; _gCanvasLastY = (double)py;
    if (phase == 0)
    {
        if (!cv.hasPointerDown) return false;
        cv.onPointerDown(x, y, buttons);
    }
    else if (phase == 1)
    {
        if (!cv.hasPointerMove) return false;
        cv.onPointerMove(x, y, buttons);
    }
    else
    {
        if (!cv.hasPointerUp) return false;
        cv.onPointerUp(x, y, buttons);
    }
    pumpAfterInput(_gCanvasHwnd);
    return true;
}

bool _gDispatchCanvasWheel(string key, int px, int py, double lines, bool horizontal, bool ctrl)
{
    ICanvasView cv = _gCanvasForKey(key);
    if (cv == nullptr) return false;
    Rect b = cv.nodeBounds();
    double x = (double)(px - b.x * CELL_W);
    double y = (double)(py - b.y * CELL_H);
    if (ctrl && !horizontal)
    {
        if (!cv.hasPinch) return false;
        double scale = pow(1.25, lines);
        cv.onPinch(x, y, scale);
    }
    else
    {
        if (!cv.hasWheel) return false;
        double dx = horizontal ? lines : 0.0;
        double dy = horizontal ? 0.0 : lines;
        cv.onWheel(x, y, dx, dy, false);
    }
    pumpAfterInput(_gCanvasHwnd);
    return true;
}

void nativeCanvasPointer(string keyPath, int phase, double x, double y)
{
    ICanvasView cv = _gCanvasForKey(keyPath);
    if (cv == nullptr) return;
    int buttons = phase == 2 ? 0 : 1;
    if (phase == 0) { if (cv.hasPointerDown) cv.onPointerDown(x, y, buttons); }
    else if (phase == 1) { if (cv.hasPointerMove) cv.onPointerMove(x, y, buttons); }
    else { if (cv.hasPointerUp) cv.onPointerUp(x, y, buttons); }
    pumpAfterInput(_gCanvasHwnd);
}

void nativeCanvasWheel(string keyPath, double x, double y, double dx, double dy)
{
    ICanvasView cv = _gCanvasForKey(keyPath);
    if (cv == nullptr || !cv.hasWheel) return;
    cv.onWheel(x, y, dx, dy, true);
    pumpAfterInput(_gCanvasHwnd);
}

void nativeCanvasPinch(string keyPath, double x, double y, double scale)
{
    ICanvasView cv = _gCanvasForKey(keyPath);
    if (cv == nullptr || !cv.hasPinch) return;
    cv.onPinch(x, y, scale);
    pumpAfterInput(_gCanvasHwnd);
}

void _gCanvasCaptureLost()
{
    string key = "" + _gCanvasCaptureKey;
    _gCanvasCaptureKey = "";
    if (key.length() > 0)
        _gDispatchCanvasPointer(key, 2, (int)_gCanvasLastX, (int)_gCanvasLastY, 0);
}

// LRESULT CALLBACK WndProc(HWND, UINT, WPARAM, LPARAM). stdcall keeps the ABI
// correct on 32-bit (no-op on x64).
stdcall i64 WndProc(void* hwnd, u32 msg, u64 wParam, i64 lParam)
{
    _gCanvasHwnd = hwnd;
    if (msg == WM_SIZE)
    {
        // LOWORD/HIWORD of lParam are the new client width/height in pixels.
        int pw = (int)(lParam & (i64)0xFFFF);
        int ph = (int)((lParam >> 16) & (i64)0xFFFF);
        int nw = pw / CELL_W;
        int nh = ph / CELL_H;
        if (nw < 1) nw = 1;
        if (nh < 1) nh = 1;
        _gTermW = nw;
        _gTermH = nh;
        rebuildTree();
        InvalidateRect(hwnd, nullptr, 1);
        return (i64)0;
    }

    // Suppress the default background erase; WM_PAINT repaints the whole client
    // through a back buffer, so erasing first would only cause flicker.
    if (msg == WM_ERASEBKGND)
        return (i64)1;

    if (msg == WM_PAINT)
    {
        PAINTSTRUCT ps = default;
        void* hdc = BeginPaint(hwnd, &ps);

        RECT rc = default;
        GetClientRect(hwnd, &rc);
        int w = rc.right - rc.left;
        int h = rc.bottom - rc.top;

        // Double buffer: draw into an offscreen bitmap, then blit it in one shot.
        void* memDC  = CreateCompatibleDC(hdc);
        void* bmp    = CreateCompatibleBitmap(hdc, w, h);
        void* oldBmp = SelectObject(memDC, bmp);

        FillRect(memDC, &rc, GetStockObject(WHITE_BRUSH));
        if (_gReady)
        {
            void* font = createUiFont();
            void* oldFont = SelectObject(memDC, font);
            GdiCanvas cv = default;
            cv.hdc = memDC;
            layoutRoot(_gTree, 0, 0, _gTermW);
            _gTree.paint(cv, &_gCtx);
            SelectObject(memDC, oldFont);
            DeleteObject(font);
        }
        BitBlt(hdc, 0, 0, w, h, memDC, 0, 0, (u32)SRCCOPY);

        SelectObject(memDC, oldBmp);
        DeleteObject(bmp);
        DeleteDC(memDC);
        EndPaint(hwnd, &ps);
        return (i64)0;
    }

    if (msg == WM_LBUTTONDOWN || msg == WM_RBUTTONDOWN)
    {
        int px = (int)((lParam << 48) >> 48);
        int py = (int)((lParam << 32) >> 48);
        if (_gReady)
        {
            string key = _gCanvasScan(_gTree, keySegment(_gTree, 0), px / CELL_W, py / CELL_H);
            bool consumed = _gDispatchCanvasPointer(key, 0, px, py, _gCanvasButtons(wParam));
            if (consumed) { _gCanvasCaptureKey = "" + key; SetCapture(hwnd); }
            else if (msg == WM_LBUTTONDOWN)
            {
                _gTree.dispatch(mouseDown(px / CELL_W, py / CELL_H), &_gCtx);
                pumpAfterInput(hwnd);
            }
        }
        return (i64)0;
    }

    if (msg == WM_MOUSEMOVE)
    {
        int px = (int)((lParam << 48) >> 48);
        int py = (int)((lParam << 32) >> 48);
        if (_gReady)
        {
            bool consumed = false;
            if (_gCanvasCaptureKey.length() > 0)
                consumed = _gDispatchCanvasPointer(_gCanvasCaptureKey, 1, px, py, _gCanvasButtons(wParam));
            else
            {
                string key = _gCanvasScan(_gTree, keySegment(_gTree, 0), px / CELL_W, py / CELL_H);
                consumed = _gDispatchCanvasPointer(key, 1, px, py, _gCanvasButtons(wParam));
            }
            if (!consumed)
            {
                if (!_gTree.dispatch(mouseMove(px / CELL_W, py / CELL_H), &_gCtx))
                    _gCtx.setHover("");
                pumpAfterInput(hwnd);
            }
        }
        return (i64)0;
    }

    if (msg == WM_LBUTTONUP || msg == WM_RBUTTONUP)
    {
        int px = (int)((lParam << 48) >> 48);
        int py = (int)((lParam << 32) >> 48);
        if (_gReady)
        {
            string key = "" + _gCanvasCaptureKey;
            _gCanvasCaptureKey = "";
            if (GetCapture() == hwnd) ReleaseCapture();
            bool consumed = _gDispatchCanvasPointer(key, 2, px, py, 0);
            if (!consumed && msg == WM_LBUTTONUP)
            {
                _gTree.dispatch(mouseUp(px / CELL_W, py / CELL_H), &_gCtx);
                _gCtx.clearPress();
                pumpAfterInput(hwnd);
            }
        }
        return (i64)0;
    }

    if (msg == WM_CAPTURECHANGED)
    {
        if (_gCanvasCaptureKey.length() > 0) _gCanvasCaptureLost();
        return (i64)0;
    }

    if (msg == WM_MOUSEWHEEL || msg == WM_MOUSEHWHEEL)
    {
        if (_gReady)
        {
            POINT pt = default;
            pt.x = (int)((lParam << 48) >> 48);
            pt.y = (int)((lParam << 32) >> 48);
            ScreenToClient(hwnd, &pt);
            string key = _gCanvasScan(_gTree, keySegment(_gTree, 0),
                                     pt.x / CELL_W, pt.y / CELL_H);
            // The wheel halves are signed 16-bit values; sign-extend the high half explicitly.
            double lines = (double)((int)((((i64)wParam) << 32) >> 48)) / 120.0;
            bool ctrl = (wParam & (u64)MK_CONTROL) != 0u;
            if (_gDispatchCanvasWheel(key, pt.x, pt.y, lines,
                                      msg == WM_MOUSEHWHEEL, ctrl)) return (i64)0;
        }
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }

    if (msg == WM_KEYDOWN)
    {
        // Tab / Shift-Tab move focus through the ring; every other key routes to
        // the focused node (Win32 VK codes match the KEY_* constants). Then drain
        // like the mouse path.
        if (_gReady)
        {
            int vk = (int)wParam;
            if (vk == KEY_TAB)
            {
                bool shift = (GetKeyState(VK_SHIFT) & 0x8000) != 0;
                moveFocus(_gTree, &_gCtx, shift);
                _gCtx.requestRepaint();
            }
            else
            {
                _gTree.dispatch(keyPress(vk), &_gCtx);
            }
            pumpAfterInput(hwnd);
        }
        return (i64)0;
    }

    if (msg == WM_DESTROY)
    {
        if (_gReady) { deleteTree(_gTree); _gReady = false; }
        _gCanvasHwnd = nullptr;
        PostQuitMessage(0);
        return (i64)0;
    }

    return DefWindowProcA(hwnd, msg, wParam, lParam);
}

// Register the window class, create the window, and run the message loop until
// WM_QUIT. The component is borrowed (the caller owns it and must outlive this
// call); we stash it in _gApp for the WndProc to render from.
int runAppGui(IComponent app, const char* title)
{
    _gApp = app;

    void* hInst = GetModuleHandleA(nullptr);

    WNDCLASSEXA wc = default;
    wc.cbSize        = (u32)sizeof(WNDCLASSEXA);
    wc.style         = (u32)(CS_HREDRAW | CS_VREDRAW);
    wc.lpfnWndProc   = (void*)WndProc;
    wc.hInstance     = hInst;
    wc.hCursor       = LoadCursorA(nullptr, (char*)IDC_ARROW);
    wc.hbrBackground = GetStockObject(WHITE_BRUSH);
    wc.lpszClassName = "CFlatUiWindow";

    RegisterClassExA(&wc);

    void* hwnd = CreateWindowExA(
        0u,
        "CFlatUiWindow",
        title,
        (u32)WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, CW_USEDEFAULT,
        640, 480,
        nullptr, nullptr, hInst, nullptr);

    if (hwnd == nullptr)
    {
        printf("CreateWindowExA failed\n");
        return 1;
    }

    ShowWindow(hwnd, SW_SHOW);
    UpdateWindow(hwnd);

    MSG msg = default;
    while (GetMessageA(&msg, nullptr, 0u, 0u) > 0)
    {
        TranslateMessage(&msg);
        DispatchMessageA(&msg);
    }

    return (int)msg.wParam;
}
