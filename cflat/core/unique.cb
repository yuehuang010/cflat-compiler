// unique<T>: single-owner smart pointer over a heap-allocated T, C++ unique_ptr style.
// T is the POINTEE type: unique<Resource> owns a Resource*.
annotation unique { };

// ALIGN carries the OVER-alignment of the owned block, so `alignas(0, N) unique T*` is
// `unique<T, N>`: the deallocator that matches the allocation is part of the type. 0 (and any
// value up to the default `new` alignment) means an ordinary block freed with plain `delete`.
[unique]
struct unique<T, int ALIGN = 0>
{
    if const (is_interface(T)) { using P = T; }
    else { using P = T*; }
    P _p = default;

    unique() { }

    // Takes ownership of either an interface value or a heap pointer.
    if const (ALIGN > 16)
    {
        unique(move alignas(0, ALIGN) P p)
        {
            _p = move p;
        }
    }
    else
    {
        unique(move P p)
        {
            _p = move p;
        }
    }

    // The poison remains on the destructor so unique<Foo*> is rejected at instantiation.
    ~unique()
    {
        if const (is_pointer(T) && !is_interface(T))
            compile_error("unique<T> takes the pointee type: write unique<Foo>, not unique<Foo*>");
        else if const (is_interface(T))
        {
            if (_p != nullptr) delete _p;
        }
        else if const (ALIGN > 16)
        {
            // The block came from the aligned allocator, so it must go back through the aligned
            // deallocator. The declared clause on `q` is what routes the free.
            if (_p != nullptr)
            {
                alignas(0, ALIGN) P q;
                q = _p;
                _p = nullptr;
                delete q;
            }
        }
        else
        {
            if (_p != nullptr) delete _p;
        }
    }

    // Borrowing observers: the caller does not take ownership.
    P get() { return _p; }

    if const (!is_interface(T))
    {
        T* operator->() { return _p; }
    }

    bool valid()
    {
        return _p != nullptr;
    }

    bool operator!()
    {
        return _p == nullptr;
    }

    // Hands ownership back out; this unique<T> becomes empty.
    if const (ALIGN > 16)
    {
        alignas(0, ALIGN) move P release()
        {
            P value = move _p;
            _p = nullptr;
            return move value;
        }

        // Frees the current value (if any) and takes ownership of the replacement.
        void reset(move alignas(0, ALIGN) P p)
        {
            P old = move _p;
            _p = move p;
            if (old != nullptr && old != _p)
            {
                alignas(0, ALIGN) P q;
                q = old;
                delete q;
            }
        }
    }
    else
    {
        move P release()
        {
            P value = move _p;
            _p = nullptr;
            return move value;
        }

        // Frees the current value (if any) and takes ownership of the replacement.
        void reset(move P p)
        {
            P old = move _p;
            _p = move p;
            if (old != nullptr && old != _p)
            {
                delete old;
            }
        }
    }
};
